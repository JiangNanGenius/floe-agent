# Guest-only environment fragment for the common floe-acceleration dispatcher.
# Source it from the resolved Linux environment entry; never from the macOS
# host.  It does not preload anything by itself.
#
# Per-environment persistent policy (written atomically by
# `floe-blas-run --set-mode`):
#   $XDG_CONFIG_HOME/floe-acceleration/blas.conf
#   $HOME/.config/floe-acceleration/blas.conf   (when XDG_CONFIG_HOME is unset)
# File content: one recognized line `mode=auto|on|off`.
#
# Precedence: FLOE_BLAS_MODE environment > per-environment config > auto.
# The provider itself reads the same file, so a direct LD_PRELOAD without the
# wrapper still observes the saved policy.

export FLOE_BLAS_MODE="${FLOE_BLAS_MODE:-auto}"
export FLOE_BLAS_MIN_FLOPS="${FLOE_BLAS_MIN_FLOPS:-268435456}"
export FLOE_BLAS_GEMV_MIN_FLOPS="${FLOE_BLAS_GEMV_MIN_FLOPS:-4194304}"
export FLOE_BLAS_MAX_GPU_BYTES="${FLOE_BLAS_MAX_GPU_BYTES:-268435456}"
export FLOE_BLAS_TIMEOUT_MS="${FLOE_BLAS_TIMEOUT_MS:-60000}"
# Set to 1 only for a bounded diagnostic; it still falls back to original BLAS.
export FLOE_BLAS_VERBOSE="${FLOE_BLAS_VERBOSE:-0}"
