+# Floe runtime-only profile. In external mode the clspv/LLVM toolchain is not
+# configured, built or linked; the genuine ICD still compiles and runs OpenCL C
+# by executing a separately supplied clspv process.
+option(CLVK_EXTERNAL_CLSPV "Use an externally supplied clspv process instead of building the clspv toolchain" OFF)
+if (CLVK_EXTERNAL_CLSPV)
+  if (NOT CLVK_COMPILER_AVAILABLE)
+    message(FATAL_ERROR "CLVK_EXTERNAL_CLSPV requires CLVK_COMPILER_AVAILABLE=ON")
+  endif()
+  if (CLVK_CLSPV_ONLINE_COMPILER)
+    message(FATAL_ERROR "CLVK_EXTERNAL_CLSPV requires the offline compiler path (CLVK_CLSPV_ONLINE_COMPILER=OFF)")
+  endif()
+endif()
+
+# SPIR-V IL is optional here because it needs an external llvm-spirv process.
+# The original full profile keeps its upstream default (ON).
+if (CLVK_EXTERNAL_CLSPV)
+  set(_clvk_spirv_il_default OFF)
+else()
+  set(_clvk_spirv_il_default ON)
+endif()
+option(CLVK_ENABLE_SPIRV_IL "Enable SPIR-V as an intermediate language" ${_clvk_spirv_il_default})
+unset(_clvk_spirv_il_default)
+
 # ccache
