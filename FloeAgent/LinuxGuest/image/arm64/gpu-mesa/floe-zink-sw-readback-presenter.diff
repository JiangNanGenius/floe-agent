+/**
+ * CPU presentation of non-swapchain frontbuffers for sw winsys (DRISW).
+ *
+ * zink renders with the hardware Vulkan backend, but when the screen was
+ * created through zink_create_screen(sw_winsys) the resources are plain
+ * textures: no swapchain exists and the kopper path cannot run. Read the
+ * rendered pixels back through the normal gallium transfer interface and
+ * hand them to the sw winsys displaytarget callbacks, which deliver them
+ * to the loader (putImage). A transient displaytarget is used per flush so
+ * resizes and drawable/resource lifetime need no persistent state.
+ */
 static void
+zink_sw_flush_frontbuffer(struct pipe_screen *pscreen,
+                          struct pipe_context *pctx,
+                          struct pipe_resource *pres,
+                          unsigned level, unsigned layer,
+                          void *winsys_drawable_handle,
+                          unsigned nboxes,
+                          struct pipe_box *sub_box)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct sw_winsys *winsys = screen->sw_winsys;
+   struct sw_displaytarget *dt;
+   struct pipe_transfer *transfer = NULL;
+   void *src, *dst;
+   unsigned width, height;
+   size_t row_bytes;
+
+   if (!winsys || !pctx || pres->target == PIPE_BUFFER)
+      return;
+
+   level = MIN2(level, pres->last_level);
+   width = u_minify(pres->width0, level);
+   height = u_minify(pres->height0, level);
+   if (!width || !height)
+      return;
+
+   simple_mtx_lock(&screen->sw_dt_lock);
+
+   unsigned dt_stride = 0;
+   dt = winsys->displaytarget_create(winsys, pres->bind, pres->format,
+                                     width, height, 64, NULL, &dt_stride);
+   if (!dt) {
+      mesa_loge("ZINK: sw present: failed to create displaytarget %ux%u\n",
+                width, height);
+      goto out;
+   }
+
+   src = pipe_texture_map(pctx, pres, level, layer, PIPE_MAP_READ,
+                          0, 0, width, height, &transfer);
+   if (!src) {
+      mesa_loge("ZINK: sw present: texture_map failed\n");
+      goto out_destroy_dt;
+   }
+
+   dst = winsys->displaytarget_map(winsys, dt, PIPE_MAP_WRITE);
+   if (!dst) {
+      mesa_loge("ZINK: sw present: displaytarget_map failed\n");
+      pctx->texture_unmap(pctx, transfer);
+      goto out_destroy_dt;
+   }
+
+   row_bytes = util_format_get_stride(pres->format, width);
+   if (row_bytes > (size_t)transfer->stride || row_bytes > (size_t)dt_stride) {
+      /* never claim successful output with a mismatched layout */
+      mesa_loge("ZINK: sw present: stride mismatch (row %zu map %d dt %u)\n",
+                row_bytes, transfer->stride, dt_stride);
+      winsys->displaytarget_unmap(winsys, dt);
+      pctx->texture_unmap(pctx, transfer);
+      goto out_destroy_dt;
+   }
+
+   if ((size_t)transfer->stride == (size_t)dt_stride &&
+       (size_t)transfer->stride == row_bytes) {
+      memcpy(dst, src, row_bytes * height);
+   } else {
+      for (unsigned y = 0; y < height; y++) {
+         memcpy((uint8_t *)dst + (size_t)y * dt_stride,
+                (const uint8_t *)src + (size_t)y * transfer->stride,
+                row_bytes);
+      }
+   }
+
+   winsys->displaytarget_unmap(winsys, dt);
+   pctx->texture_unmap(pctx, transfer);
+
+   winsys->displaytarget_display(winsys, dt, winsys_drawable_handle,
+                                 nboxes, sub_box);
+
+out_destroy_dt:
+   winsys->displaytarget_destroy(winsys, dt);
+out:
+   simple_mtx_unlock(&screen->sw_dt_lock);
+}
