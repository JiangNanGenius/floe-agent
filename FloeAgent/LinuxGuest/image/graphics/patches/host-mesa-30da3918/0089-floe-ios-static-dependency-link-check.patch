+    'floe-kk-link-check',
+    files('floe_kk_link_check.c'),
+    include_directories : [inc_include, inc_src],
+    dependencies : [kk_deps],
+    link_whole : [libkk],
+    link_language : 'cpp',
+    install : false,
+  )
+endif
diff --git a/src/kosmickrisp/vulkan/floe_kk_link_check.c b/src/kosmickrisp/vulkan/floe_kk_link_check.c
