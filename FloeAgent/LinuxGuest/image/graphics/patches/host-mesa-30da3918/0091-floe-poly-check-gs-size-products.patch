+/* The ABI stores primitive and raster counts in 32 bits. Check products
+ * before either CPU or GPU setup narrows them or uses them for allocation. */
+static inline bool
+poly_gs_draw_fits_u32(enum poly_gs_shape shape, uint32_t max_indices,
+                      enum mesa_prim prim, uint32_t vertices,
+                      uint32_t instances)
+{
+   const uint64_t prims = u_decomposed_prims_for_vertices(prim, vertices);
+   const uint64_t total = prims * instances;
+   if (total > 0xffffffffull || (uint64_t)vertices * instances > 0xffffffffull)
+      return false;
+
+   uint64_t raster = max_indices;
+   if (shape == POLY_GS_SHAPE_DYNAMIC_INDEXED)
+      raster *= total;
+   else if (shape == POLY_GS_SHAPE_STATIC_PER_INSTANCE)
+      raster *= prims;
+
+   return raster <= 0xffffffffull;
+}
