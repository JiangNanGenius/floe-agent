+poly_heap_alloc_offs(global struct poly_heap *heap, uint64_t size_B)
+{
+   /* Never narrow a size product or wrap the alignment before checking it.
+    * Exact fills are valid. A failed reservation must not advance/wrap bottom
+    * and let another invocation write an overlapping allocation. */
+   const uint64_t aligned = size_B <= heap->size
+                               ? (size_B + 15ull) & ~15ull : size_B;
+   volatile global atomic_uint *bottom =
+      (volatile global atomic_uint *)(&heap->bottom);
+   uint offs = atomic_load(bottom);
+
+   for (;;) {
+      if (aligned > heap->size || offs > heap->size - aligned) {
+         /* Explicit device failure remains until bounded GS batching exists;
+          * do not silently truncate a legal draw or write outside the heap. */
+         printf("FATAL: GPU heap exhausted before allocation, offset %u, heap size %u!",
+                offs, heap->size);
+         abort();
+         return 0;
+      }
+
+      const uint end = offs + (uint)aligned;
+      if (atomic_compare_exchange_strong(bottom, &offs, end))
+         return offs;
+   }
 }
 
