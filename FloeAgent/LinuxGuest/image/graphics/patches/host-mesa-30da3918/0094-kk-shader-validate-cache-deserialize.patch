+/* Stages whose MSL is appended to a serialized vertex shader.  The linked
+ * graphics pipeline always carries a fragment stage; a vertex cache entry with
+ * no fragment bit cannot come from this compiler and would make
+ * kk_compile_graphics_pipeline() underflow its pre-render count. */
+#define KK_SERIALIZED_VS_STAGES                                                \
+   (BITFIELD_BIT(MESA_SHADER_TESS_CTRL) | BITFIELD_BIT(MESA_SHADER_TESS_EVAL) | \
+    BITFIELD_BIT(MESA_SHADER_GEOMETRY) | BITFIELD_BIT(MESA_SHADER_FRAGMENT))
+
+static VkResult
+kk_validate_deserialized_shader_info(const struct kk_shader_info *info)
+{
+   if (info->stage < 0 || info->stage >= MESA_SHADER_STAGES)
+      return VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT;
+
+   /* Only variants 1..KK_FS_VARIANT_COUNT-1 own an fs_variants[] slot; the
+    * base fragment variant lives in msl_data[MESA_SHADER_FRAGMENT]. */
+   const uint8_t valid_variants =
+      (uint8_t)(BITFIELD_MASK(KK_FS_VARIANT_COUNT) & ~1u);
+   if (info->fs_variant_mask & (uint8_t)~valid_variants)
+      return VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT;
+
+   if (info->stage == MESA_SHADER_VERTEX) {
+      const uint32_t stages = info->vs.additional_stages_bits;
+      if ((stages & ~KK_SERIALIZED_VS_STAGES) ||
+          !(stages & BITFIELD_BIT(MESA_SHADER_FRAGMENT)))
+         return VK_ERROR_INCOMPATIBLE_SHADER_BINARY_EXT;
+   }
+
+   return VK_SUCCESS;
+}
