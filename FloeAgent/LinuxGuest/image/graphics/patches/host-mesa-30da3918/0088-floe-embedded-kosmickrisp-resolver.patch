diff --git a/src/kosmickrisp/vulkan/floe_kk_resolver.c b/src/kosmickrisp/vulkan/floe_kk_resolver.c
new file mode 100644
--- /dev/null
+++ b/src/kosmickrisp/vulkan/floe_kk_resolver.c
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "floe_kk_resolver.h"
+
+#if !defined(FLOE_KK_ONLY_STATIC_BACKEND) || !FLOE_KK_ONLY_STATIC_BACKEND
+#error "Compile this resolver only in the separately selected KK static component"
+#endif
+
+/* The pinned Mesa implementation exports this ICD entry point and uses its
+ * instance/physical-device/device trampolines to resolve the real dispatch. */
+extern VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
+
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+FloeKKGetInstanceProcAddr(VkInstance instance, const char *name)
+{
+    return name ? vk_icdGetInstanceProcAddr(instance, name) : NULL;
+}
+
+/* The existing statically built Venus renderer needs this one symbol.
+ * FVGPU identity queries must also use the paired dispatch-source delta. */
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+vkGetInstanceProcAddr(VkInstance instance, const char *name)
+{
+    return FloeKKGetInstanceProcAddr(instance, name);
+}
