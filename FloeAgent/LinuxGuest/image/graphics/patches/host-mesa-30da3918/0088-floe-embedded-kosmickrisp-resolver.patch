+#ifdef __cplusplus
+extern "C" {
+#endif
+/* A distinct, statically selected provider. Do not link a MoltenVK archive into
+ * this variant. Guest applications retain their ordinary Venus Vulkan API. */
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+FloeKKGetInstanceProcAddr(VkInstance instance, const char *name);
+#ifdef __cplusplus
+}
+#endif
