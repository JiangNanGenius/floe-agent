    "widget.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View active tasks and quickly start a new one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看进行中任务，快速发起新任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視進行中任務，快速發起新任務"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなタスクを表示し、すぐに新しいタスクを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 작업을 확인하고 새 작업을 빠르게 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez les tâches actives et commencez-en une nouvelle rapidement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie aktive Aufgaben an und starten Sie schnell eine neue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea las tareas activas y comience una nueva rápidamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize tarefas ativas e inicie rapidamente uma nova."
          }
        }
      }
    },
