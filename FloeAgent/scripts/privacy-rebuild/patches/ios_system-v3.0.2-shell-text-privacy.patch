+	/*
+	 * Floe patch (privacy): the iOS build omits the statfs/fstatfs
+	 * MNT_LOCAL probe. statfs/fstatfs are required-reason DiskSpace APIs;
+	 * this probe reads mount flags only, derives no disk-space value, and
+	 * has no approved reason. Follow mode uses the sleep fallback on every
+	 * volume, which is correct on local and remote filesystems alike, and
+	 * -F still re-stats names every iteration of the follow loop.
+	 */
+	(void)files;
+	action = USE_SLEEP;
 }
 
