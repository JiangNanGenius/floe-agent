  "patches": [
    {
      "name": "Immutable CRC32/CRC32C tables",
      "base": "A6",
      "scope": "Source/src/decode.c and Source/src/crc32_tables.h only; no A8 RO-data cache",
      "sourceArchiveSHA256": "e41d4c5687fc6e306f32892354f0eacb2293faf888cd1370abb757a53e6ed86a",
      "files": [
        {
          "path": "Core/Source/src/decode.c",
          "sha256": "17eb87d00a48215f51a632797a94309c0cc014c43a7ffd5266e3706cb434f7b9"
        },
        {
          "path": "Core/Source/src/crc32_tables.h",
          "sha256": "5cf6dbc67c924eb8e776d5c4448060d283de9c2385db3ceda2f81a359e5bf3ec"
        }
      ],
      "qualification": "Owner Mac A8b normal/TSan; selected A6+CRC Apple SDK object/link qualification recorded separately. No App or guest result implied."
    },
    {
      "name": "Preserve 9P symlink identity and translate Linux wire removal/error values",
      "scope": "Source/src/devices/virtio_9p.c and virtio_9p_port.h; final-link metadata, O_NOFOLLOW directory containment, Linux AT_REMOVEDIR and ELOOP wire conversion",
      "qualification": "19 actual parser/native-filesystem checks with ASan/UBSan passed. Original symlink failure and the later real-App EDA directory-removal failure retained. Integrated shared-tempfile preflight pending; complete data Skill qualification is not claimed."
    },
    {
