+
+// Opt-in qualification probe. No geometry, root or tolerance is changed.
+// Disabled unless the test host explicitly sets this environment variable.
+static bool OS3DContactProbeEnabled()
+{
+  static const bool enabled = [] {
+    const char* value = std::getenv("FLOE_OCCT_CONTACT_DIAGNOSTICS");
+    return value != nullptr && value[0] == '1' && value[1] == '\0';
+  }();
+  return enabled;
+}
+
+static bool OS3DContactProbeSlot(std::atomic<unsigned>& counter, unsigned cap)
+{
+  if (!OS3DContactProbeEnabled()) return false;
+  const unsigned index = counter.fetch_add(1, std::memory_order_relaxed);
+  if (index == cap)
+    std::fprintf(stderr, "OS3DContactProbe v=1 stage=cap cap=%u\n", cap);
+  return index < cap;
+}
+
+static Standard_Real OS3DContactEquationResidual(GeomFill_FunctionGuide& function,
+                                                const math_Vector& root)
+{
+  try {
+    math_Vector error(1, 3);
+    if (function.Value(root, error)) return error.Norm();
+  } catch (...) {
+    // Diagnostics must not replace the operation's actual outcome.
+  }
+  return std::numeric_limits<Standard_Real>::quiet_NaN();
+}
+
+static void OS3DContactProbeTable(const void* law, int index,
+                                Standard_Real parameter, Standard_Real spineZ, Standard_Real sectionParameter,
+                                Standard_Real guideParameter, Standard_Real angle,
+                                Standard_Real sectionV, Standard_Real previousAngle,
+                                Standard_Real residual, bool rescue)
+{
+  static std::atomic<unsigned> rows{0};
+  if (!OS3DContactProbeSlot(rows, 512)) return;
+  std::fprintf(stderr,
+    "OS3DContactProbe v=1 stage=table law=%p index=%d t=%.17g spine_z=%.17g section_u=%.17g "
+    "guide_w=%.17g angle=%.17g section_v=%.17g previous_angle=%.17g residual_mm=%.17g rescue=%d\n",
+    const_cast<void*>(law), index, parameter, spineZ, sectionParameter, guideParameter,
+    angle, sectionV, previousAngle, residual, rescue ? 1 : 0);
+}
+
+static void OS3DContactProbeRoot(const void* law, const char* overload,
+                               Standard_Real parameter, Standard_Real spineZ, Standard_Real sectionParameter,
+                               Standard_Real seedW, Standard_Real seedAngle, Standard_Real seedV,
+                               GeomFill_FunctionGuide& function, const math_Vector& root,
+                               const Handle(TColgp_HArray2OfPnt2d)& table)
+{
+  static std::atomic<unsigned> rows{0};
+  if (!OS3DContactProbeSlot(rows, 2048)) return;
+  math_Vector seed(1, 3);
+  seed(1) = seedW; seed(2) = seedAngle; seed(3) = seedV;
+  const Standard_Real seedResidual = OS3DContactEquationResidual(function, seed);
+  const Standard_Real rootResidual = OS3DContactEquationResidual(function, root);
+  Standard_Real tableAngle = std::numeric_limits<Standard_Real>::quiet_NaN();
+  Standard_Real tableV = tableAngle, lowT = tableAngle, highT = tableAngle;
+  if (!table.IsNull() && table->RowLength() >= 2) {
+    const int count = table->RowLength();
+    int high = count;
+    for (int i = 2; i <= count; ++i) {
+      if (parameter <= table->Value(1, i).X()) { high = i; break; }
+    }
+    const int low = high - 1;
+    lowT = table->Value(1, low).X(); highT = table->Value(1, high).X();
+    const Standard_Real span = highT - lowT;
+    const Standard_Real weight = span > 1.e-7 ? (parameter - lowT) / span : 0.5;
+    tableAngle = (1 - weight) * table->Value(2, low).X() + weight * table->Value(2, high).X();
+    tableV = (1 - weight) * table->Value(2, low).Y() + weight * table->Value(2, high).Y();
+  }
+  const Standard_Real branchDelta = std::remainder(root(2) - tableAngle, 2 * M_PI);
+  std::fprintf(stderr,
+    "OS3DContactProbe v=1 stage=root law=%p overload=%s t=%.17g spine_z=%.17g section_u=%.17g "
+    "table_lo=%.17g table_hi=%.17g table_angle=%.17g table_v=%.17g "
+    "seed_w=%.17g seed_angle=%.17g seed_v=%.17g root_w=%.17g root_angle=%.17g root_v=%.17g "
+    "branch_delta=%.17g seed_residual_mm=%.17g root_residual_mm=%.17g\n",
+    const_cast<void*>(law), overload, parameter, spineZ, sectionParameter, lowT, highT, tableAngle, tableV,
+    seedW, seedAngle, seedV, root(1), root(2), root(3), branchDelta, seedResidual, rootResidual);
+}
+
+static void OS3DContactProbeUnavailable(const void* law, const char* stage, Standard_Real parameter)
+{
+  static std::atomic<unsigned> rows{0};
+  if (!OS3DContactProbeSlot(rows, 64)) return;
+  std::fprintf(stderr, "OS3DContactProbe v=1 stage=%s law=%p t=%.17g\n",
+               stage, const_cast<void*>(law), parameter);
+}
 
