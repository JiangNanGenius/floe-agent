--- a/riscv_cpu_template.h
+++ b/riscv_cpu_template.h
@@ -1352,11 +1352,19 @@
             funct3 = (insn >> 12) & 7;
             switch(funct3) {
             case 0: /* fence */
-                if (insn & 0xf00fff80)
-                    goto illegal_insn;
+                /* FLOE-EMBED: FENCE/FENCE.TSO and every reserved fm encoding
+                   are ordering hints that must be ignored rather than
+                   trapped (the base ISA defines FENCE.TSO next to FENCE and
+                   requires ignoring the unused fm/rs1/rd/pred/succ fields);
+                   this single-hart interpreter has nothing to order.
+                   Upstream TinyEMU trapped FENCE.TSO (0x8330000f), which is
+                   what Debian 13's libapt-pkg executes -- apt's http and
+                   https methods died with SIGILL inside libapt-pkg. */
                 break;
             case 1: /* fence.i */
-                if (insn != 0x0000100f)
+                /* FLOE-EMBED: Zifencei requires ignoring the unused
+                   imm[11:0]/rs1/rd fields; only funct3/opcode select it. */
+                if ((insn & 0x0000707f) != 0x0000100f)
                     goto illegal_insn;
                 break;
 #if XLEN >= 128
