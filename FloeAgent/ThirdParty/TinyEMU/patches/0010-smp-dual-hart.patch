+                                         __ATOMIC_RELAXED);
+            __atomic_store_n((uint64_t *)dst, v, __ATOMIC_RELAXED);
+            dst += 8;
+            src += 8;
+            count -= 8;
+        }
+    }
+    while (count > 0) {
+        uint8_t v = __atomic_load_n(src, __ATOMIC_RELAXED);
+        __atomic_store_n(dst, v, __ATOMIC_RELAXED);
+        dst++;
+        src++;
+        count--;
