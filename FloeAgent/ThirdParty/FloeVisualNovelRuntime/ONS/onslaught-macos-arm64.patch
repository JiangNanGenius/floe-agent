diff --git a/trunk/src/floe_image_loader.cpp b/trunk/src/floe_image_loader.cpp
new file mode 100644
index 0000000..6f288dc
--- /dev/null
+++ b/trunk/src/floe_image_loader.cpp
@@ -0,0 +1,170 @@
+/*
+ * FloeONSRuntime minimal image loader implementation.
+ * Floe-authored (MPL-2.0). See floe_image_loader.h for the contract.
+ */
+#include "floe_image_loader.h"
+
+#include <vector>
+#include <cstring>
+
+#include <png.h>
+#include <jpeglib.h>
+#include <setjmp.h>
+
+namespace {
+
+bool read_all(SDL_RWops *src, std::vector<unsigned char> &out){
+    const int size = SDL_RWseek(src, 0, RW_SEEK_END);
+    if (size <= 0 || size > 64 * 1024 * 1024 || SDL_RWseek(src, 0, RW_SEEK_SET) < 0)
+        return false;
+    out.resize(static_cast<size_t>(size));
+    return SDL_RWread(src, out.data(), 1, size) == size;
+}
+
+SDL_Surface *surface_from_rgba(int w, int h, const unsigned char *rgba){
+#if SDL_BYTEORDER == SDL_BIG_ENDIAN
+	const Uint32 rmask = 0xFF000000, gmask = 0x00FF0000, bmask = 0x0000FF00, amask = 0x000000FF;
+#else
+	const Uint32 rmask = 0x000000FF, gmask = 0x0000FF00, bmask = 0x00FF0000, amask = 0xFF000000;
+#endif
+	SDL_Surface *s = SDL_CreateRGBSurface(SDL_SWSURFACE, w, h, 32, rmask, gmask, bmask, amask);
+	if (!s)
+		return 0;
+	SDL_LockSurface(s);
+	for (int y = 0; y < h; y++){
+		Uint32 *row = (Uint32 *)((char *)s->pixels + y * s->pitch);
+		const unsigned char *src = rgba + (size_t)y * (size_t)w * 4;
+		for (int x = 0; x < w; x++){
+			row[x] = SDL_MapRGBA(s->format, src[0], src[1], src[2], src[3]);
+			src += 4;
+		}
+	}
+	SDL_UnlockSurface(s);
+	return s;
+}
+
+struct mem_reader {
+	const unsigned char *data;
+	size_t size;
+	size_t pos;
+};
+
+void png_mem_read(png_structp png_ptr, png_bytep out, png_size_t count){
+	mem_reader *r = (mem_reader *)png_get_io_ptr(png_ptr);
+	if (!r || r->pos + count > r->size){
+		png_error(png_ptr, "read past end of memory");
+		return;
+	}
+	memcpy(out, r->data + r->pos, count);
+	r->pos += count;
+}
+
+SDL_Surface *load_png(const unsigned char *data, size_t size){
+	png_structp png = png_create_read_struct(PNG_LIBPNG_VER_STRING, 0, 0, 0);
+	if (!png)
+		return 0;
+	png_infop info = png_create_info_struct(png);
+	if (!info){
+		png_destroy_read_struct(&png, 0, 0);
+		return 0;
+	}
+	SDL_Surface *ret = 0;
+	std::vector<unsigned char> pixels;
+	if (setjmp(png_jmpbuf(png))){
+		png_destroy_read_struct(&png, &info, 0);
+		return 0;
+	}
+	mem_reader reader = { data, size, 0 };
+	png_set_read_fn(png, &reader, png_mem_read);
+	png_read_info(png, info);
+	png_uint_32 w = 0, h = 0;
+	int depth = 0, color_type = 0;
+	png_get_IHDR(png, info, &w, &h, &depth, &color_type, 0, 0, 0);
+	/* Normalize every input to 8-bit RGBA. */
+	if (color_type == PNG_COLOR_TYPE_PALETTE)
+		png_set_palette_to_rgb(png);
+	if (color_type == PNG_COLOR_TYPE_GRAY && depth < 8)
+		png_set_expand_gray_1_2_4_to_8(png);
+	if (png_get_valid(png, info, PNG_INFO_tRNS))
+		png_set_tRNS_to_alpha(png);
+	if (depth == 16)
+		png_set_strip_16(png);
+	if (color_type == PNG_COLOR_TYPE_GRAY || color_type == PNG_COLOR_TYPE_GRAY_ALPHA)
+		png_set_gray_to_rgb(png);
+	if (!(color_type & PNG_COLOR_MASK_ALPHA) && !png_get_valid(png, info, PNG_INFO_tRNS))
+		png_set_filler(png, 0xFF, PNG_FILLER_AFTER);
+	png_read_update_info(png, info);
+	pixels.resize((size_t)w * h * 4);
+	std::vector<png_bytep> rows(h);
+	for (png_uint_32 y = 0; y < h; y++)
+		rows[y] = &pixels[(size_t)y * w * 4];
+	png_read_image(png, &rows[0]);
+	png_read_end(png, 0);
+	png_destroy_read_struct(&png, &info, 0);
+	ret = surface_from_rgba((int)w, (int)h, &pixels[0]);
+	return ret;
+}
+
+struct jpeg_err_mgr {
+	jpeg_error_mgr base;
+	jmp_buf jump;
+};
+
+void jpeg_fail(j_common_ptr cinfo){
+	jpeg_err_mgr *err = (jpeg_err_mgr *)cinfo->err;
+	longjmp(err->jump, 1);
+}
+
+SDL_Surface *load_jpeg(const unsigned char *data, unsigned long size){
+	jpeg_decompress_struct cinfo;
+	jpeg_err_mgr jerr;
+	cinfo.err = jpeg_std_error(&jerr.base);
+	jerr.base.error_exit = jpeg_fail;
+	if (setjmp(jerr.jump)){
+		jpeg_destroy_decompress(&cinfo);
+		return 0;
+	}
+	jpeg_create_decompress(&cinfo);
+	jpeg_mem_src(&cinfo, (unsigned char *)data, size);
+	jpeg_read_header(&cinfo, TRUE);
+	cinfo.out_color_space = JCS_RGB;
+	jpeg_start_decompress(&cinfo);
+	const int w = (int)cinfo.output_width, h = (int)cinfo.output_height;
+	std::vector<unsigned char> rgb((size_t)w * h * 3);
+	while (cinfo.output_scanline < cinfo.output_height){
+		JSAMPROW row = &rgb[(size_t)cinfo.output_scanline * w * 3];
+		jpeg_read_scanlines(&cinfo, &row, 1);
+	}
+	jpeg_finish_decompress(&cinfo);
+	jpeg_destroy_decompress(&cinfo);
+	std::vector<unsigned char> rgba((size_t)w * h * 4);
+	for (size_t a = 0, n = (size_t)w * h; a < n; a++){
+		rgba[a * 4 + 0] = rgb[a * 3 + 0];
+		rgba[a * 4 + 1] = rgb[a * 3 + 1];
+		rgba[a * 4 + 2] = rgb[a * 3 + 2];
+		rgba[a * 4 + 3] = 255;
+	}
+	return surface_from_rgba(w, h, &rgba[0]);
+}
+
+} // namespace
+
+SDL_Surface *FLOEIMG_Load_RW(SDL_RWops *src, int freesrc){
+	SDL_Surface *ret = 0;
+	std::vector<unsigned char> bytes;
+	if (src && read_all(src, bytes) && bytes.size() >= 8){
+		const unsigned char *p = &bytes[0];
+		if (p[0] == 0x89 && p[1] == 'P' && p[2] == 'N' && p[3] == 'G')
+			ret = load_png(p, bytes.size());
+		else if (p[0] == 0xFF && p[1] == 0xD8 && p[2] == 0xFF)
+			ret = load_jpeg(p, (unsigned long)bytes.size());
+		else if (p[0] == 'B' && p[1] == 'M'){
+			/* BMP: delegate to the SDL core. */
+			if (SDL_RWseek(src, 0, RW_SEEK_SET) == 0)
+				ret = SDL_LoadBMP_RW(src, 0);
+		}
+	}
+	if (freesrc && src)
+		SDL_RWclose(src);
+	return ret;
+}
diff --git a/trunk/src/floe_image_loader.h b/trunk/src/floe_image_loader.h
new file mode 100644
index 0000000..90144ad
--- /dev/null
+++ b/trunk/src/floe_image_loader.h
@@ -0,0 +1,30 @@
+/*
+ * FloeONSRuntime minimal image loader.
+ * Floe-authored (MPL-2.0). Replaces the SDL_image 1.2 dependency
+ * (IMG_Load_RW) so the runtime links without SDL_image on modern
+ * macOS/iOS toolchains.
+ *
+ * Supported input formats (v1): PNG (libpng), JPEG (libjpeg-turbo),
+ * and any BMP variant handled by the SDL core (SDL_LoadBMP_RW).
+ * Unsupported formats fail closed and return 0, matching IMG_Load_RW
+ * semantics. Original copyright notices of libpng/libjpeg remain with
+ * their respective projects (permissive licenses, already linked).
+ */
+#ifndef FLOE_IMAGE_LOADER_H
+#define FLOE_IMAGE_LOADER_H
+
+#include <SDL/SDL.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Drop-in IMG_Load_RW replacement. If freesrc is non-zero, the RWops is
+   closed before this function returns. Returns 0 on failure. */
+SDL_Surface *FLOEIMG_Load_RW(SDL_RWops *src, int freesrc);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
