+ * integration layer, not part of upstream ONSlaught.
+ *
+ * License-driven feature switches for the minimal runtime:
+ * - MIDI (libtimidity) is LGPL; statically linking it into the Floe App
+ *   would impose relink/replacement obligations. Disabled by default.
+ * - Tracker module music (libmikmod) is an extra native dependency not
+ *   needed for ONS BGM/SE coverage; disabled by default.
+ * Both can be re-enabled by a future owner after a linking decision.
+ */
+#ifndef FLOEONS_BUILD_H
+#define FLOEONS_BUILD_H
+
+#ifndef FLOEONS_ENABLE_MIDI
+#define FLOEONS_ENABLE_MIDI 0
+#endif
+
+#ifndef FLOEONS_ENABLE_MODMUSIC
+#define FLOEONS_ENABLE_MODMUSIC 0
+#endif
+
+#endif
