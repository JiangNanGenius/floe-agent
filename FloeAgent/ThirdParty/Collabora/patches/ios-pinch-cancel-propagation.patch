 	public onTouchCancel (e: TouchEvent) {
+		// An interrupted two-finger gesture must reach the window sections
+		// before its target is dropped: ZoomControl keeps a live zoom-frame
+		// open during a pinch and closes it from the propagated end without
+		// committing any zoom (it distinguishes the cancel event type).
+		if (this.multiTouch) {
+			var cancelSection: CanvasSectionObject = this.getSectionWithName(this.sectionOnMouseDown);
+			if (cancelSection)
+				this.propagateOnMultiTouchEnd(cancelSection, e);
+		}
 		this.clearMousePositions();
 		this.multiTouch = false;
 		this.stopLongPress();
