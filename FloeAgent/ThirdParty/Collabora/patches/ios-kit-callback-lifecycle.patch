+    // thread. Running inline here would execute Document/Session code on a
+    // foreign thread concurrently with that teardown. Dropping matches the
+    // pinned handling of callbacks whose document or session is already gone
+    // (KitWebSocketHandler::handleMessage, Document::drainCallbacks).
+    LOG_DBG("Dropping COKit callback for a document whose poll is gone");
+    return true;
