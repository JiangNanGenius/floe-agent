 bool KitSocketPoll::pushToMainThread(COKitCallback callback, COKitCallbackType eType,
                                      const char* p, void* data) // static
 {
+#if DOCS_SHARE_PROCESS
+    // The kit servicing thread is one shared thread recorded where it
+    // actually services the polls, so this identity test is stable across
+    // poll creation, first-service re-threading and teardown. A per-poll
+    // owner cannot provide it: a never-serviced poll still carries its
+    // creator thread, and SocketPoll::_owner is re-written without
+    // synchronization. mainPoll cannot provide it either: it tracks only the
+    // last-built poll and ANY poll's destructor clears it unconditionally, so
+    // it can be null for the whole remaining lifetime of a document that
+    // outlives a closed sibling - for example the iOS preview->edit second
+    // open.
+    if (kitThreadId.load(std::memory_order_acquire) == ProcUtil::getThreadId())
+        return false;
+
+    // The callback addresses exactly one document; resolve which. The two
+    // registered entry points are the only producers of these events.
+    const Document* doc = nullptr;
+    if (callback == &Document::GlobalCallback)
+        doc = static_cast<const Document*>(data);
+    else if (callback == &Document::ViewCallback)
+        doc = static_cast<const CallbackDescriptor*>(data)->getDoc();
+    if (!doc)
+    {
+        LOG_ERR("Dropping COKit callback with unresolvable document");
+        return true;
+    }
+
+    // Queue to the document's OWN poll. That poll shares ownership of the
+    // Document (setDocument is called exactly once, at session creation), so
+    // the raw callback data stays valid until drained, and if the poll dies
+    // first its queue - and this callback - is destroyed with it instead of
+    // running against a torn-down document. Queueing to any other poll would
+    // let the pointer outlive the document it addresses.
+    std::shared_ptr<std::string> copy;
+    if (p)
+        copy = std::make_shared<std::string>(p, strlen(p));
+
+    std::vector<std::shared_ptr<KitSocketPoll>> live;
+    {
+        std::unique_lock<std::mutex> lock(KSPollsMutex);
+        live.reserve(KSPolls.size());
+        for (const auto& weak : KSPolls)
+            if (auto poll = weak.lock())
+                live.push_back(std::move(poll));
+    }
+
+    for (const auto& poll : live)
+    {
+        if (poll->getDocument().get() != doc)
+            continue;
+        if (poll->addCallback([callback, eType, data, copy = std::move(copy)] {
+                LOG_TRC("Unusual process callback in main thread");
+                callback(eType, copy ? copy->c_str() : nullptr, data);
+            }))
+            return true;
+        break;
+    }
