diff --git a/engine/sal/osl/unx/thread.cxx b/engine/sal/osl/unx/thread.cxx
--- a/engine/sal/osl/unx/thread.cxx
+++ b/engine/sal/osl/unx/thread.cxx
@@ -600,7 +600,22 @@
 static HashEntry* HashTable[31];
 const auto HashSize = std::ssize(HashTable);
 
+// Embedded iOS hosts keep the kit VCL execute loop on a detached thread that
+// outlives exit-time static destruction (runKitLoopInAThread never returns;
+// DeInitVCL skips Kit teardown). A live osl_getThreadIdentifier from that loop
+// after __cxa_finalize destroyed this mutex throws std::system_error (pthread
+// EINVAL) and aborts the process (observed first throw at XCTest exit:
+// std::mutex::lock <- osl_getThreadIdentifier <- AquaSalInstance::IsMainThread
+// <- SvpSalYieldMutex::doAcquire <- AquaSalInstance::ImplYield). Keep the
+// registry lock for the whole process on IOS instead of destroying it under a
+// live thread. The three lookup/insert/remove paths, the HashTable, the
+// identifier values and the thread cleanup are unchanged; non-IOS keeps the
+// original static storage and destruction.
+#if defined(IOS)
+static std::mutex& HashLock = *new std::mutex;
+#else
 static std::mutex HashLock;
+#endif
 
 #if ! ((defined LINUX && !defined __FreeBSD_kernel__) || defined MACOSX || defined IOS)
 static oslThreadIdentifier LastIdent = 0;
