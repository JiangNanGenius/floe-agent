+namespace {
+
+// Embedded iOS hosts (device and simulator) run the kit VCL execute loop on a
+// detached thread that outlives exit-time static destruction: kit
+// runKitLoopInAThread is documented never to return, and DeInitVCL skips Kit
+// teardown, so nothing orderly ends that loop before __cxa_finalize destroys
+// the rtl::Static roots below. A live Application::Execute/DoYield then reads
+// m_inExecuteCondtion, the yield mutex and mpWinData/mpHelpData of already
+// destroyed roots and throws std::system_error (pthread EINVAL) out of the
+// loop thread, aborting the process (observed at XCTest/NSApplication exit).
+// Keep the three typed roots alive for the whole process on IOS instead of
+// destroying them under a live thread. Every fallback reference shares the
+// same stable holder, per-view override semantics are untouched, and
+// desktop/unit-test teardown keeps the original rtl::Static behaviour.
+// Scope note: defined(IOS) covers every iOS engine build, including the
+// simulator and iOS standalone harnesses; an explicit DeInitVCL deinit-hook
+// teardown must not run while the detached loop lives (unchanged policy).
+#if defined(IOS)
+ImplSVData& floeSVRoot()
+{
+    static ImplSVData* p = new ImplSVData;
+    return *p;
+}
+ImplSVHelpData& floeSVHelpRoot()
+{
+    static ImplSVHelpData* p = new ImplSVHelpData;
+    return *p;
+}
+ImplSVWinData& floeSVWinRoot()
+{
+    static ImplSVWinData* p = new ImplSVWinData;
+    return *p;
+}
+#else
+ImplSVData& floeSVRoot() { return private_aImplSVData::get(); }
+ImplSVHelpData& floeSVHelpRoot() { return private_aImplSVHelpData::get(); }
+ImplSVWinData& floeSVWinRoot() { return private_aImplSVWinData::get(); }
+#endif
+
+} // namespace
+
 ImplSVData* ImplGetSVData() {
-    return &private_aImplSVData::get();
+    return &floeSVRoot();
 }
 
