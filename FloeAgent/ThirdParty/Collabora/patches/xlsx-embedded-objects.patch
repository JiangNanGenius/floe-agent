+
+void VmlDrawing::applyOleAnchors()
+{
+    // Styles are projected only after row/column metrics and VML templates are
+    // loaded, and before shape creation/rotation. No saved ZIP is rewritten.
+    for (const auto& xShape : getShapes().getAllShapes())
+    {
+        const auto it = maPreciseOleAnchors.find(xShape->getShapeId());
+        if (it == maPreciseOleAnchors.end() || !it->second.anchor
+            || !getOleObjectInfo(xShape->getShapeId()))
+            continue;
+        auto& rModel = xShape->getShapeModel();
+        if (!rModel.mxClientData)
+            continue;
+        const auto& rAnchor = it->second;
+        const Rectangle aRect = rAnchor.anchor->calcAnchorRectHmm(getDrawPageSize());
+        if (aRect.X < 0 || aRect.Y < 0 || aRect.Width <= 0 || aRect.Height <= 0
+            || sal_Int64(aRect.X) + aRect.Width > SAL_MAX_INT32
+            || sal_Int64(aRect.Y) + aRect.Height > SAL_MAX_INT32)
+            continue;
+        auto& rType = xShape->getTypeModel();
+        const auto measure = [](sal_Int32 n) { return OUString::number(double(n) / 100.0) + u"mm"_ustr; };
+        rType.maLeft = measure(aRect.X);
+        rType.maTop = measure(aRect.Y);
+        rType.maMarginLeft = u"0"_ustr;
+        rType.maMarginTop = u"0"_ustr;
+        rType.maWidth = measure(aRect.Width);
+        rType.maHeight = measure(aRect.Height);
+        rType.maWidthPercent.clear();
+        rType.maHeightPercent.clear();
+        rType.maPosition = u"absolute"_ustr;
+        auto& rClient = *rModel.mxClientData;
+        // The modern EMU coordinates are now represented by exact model units.
+        // Avoid reparsing the obsolete integer-pixel anchor during creation.
+        rClient.maAnchor.clear();
+        rClient.mnCol = rAnchor.column;
+        rClient.mnRow = rAnchor.row;
+        rClient.mbMoveWithCells = rAnchor.moveWithCells;
+        rClient.mbSizeWithCells = rAnchor.sizeWithCells;
+    }
+    maPreciseOleAnchors.clear();
+}
