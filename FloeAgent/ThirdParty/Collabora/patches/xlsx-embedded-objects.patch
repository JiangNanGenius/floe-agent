+bool UnitConverter::fontMetricTraceEnabled()
+{
+    const char* path = std::getenv("FLOE_OFFICE_FONT_METRICS_TRACE");
+    return path && path[0] == '/';
+}
+
+void UnitConverter::traceFontMetrics(const char* phase, OutputDevice* device,
+        const awt::FontDescriptor* requested, const Reference<awt::XFont>& font,
+        sal_Int64 measuredDigitWidth)
+{
+    if (!fontMetricTraceEnabled() || !device)
+        return;
+    // Explicitly enabled only by the independent synthetic-file probe. No
+    // document text, cell contents, file names, or credentials enter this log.
+    try
+    {
+        tools::JsonWriter json;
+        json.put("phase", phase);
+        json.put("measuredDigitWidth", measuredDigitWidth);
+        const auto descriptor = [&](const char* name, const awt::FontDescriptor& d)
+        {
+            auto node = json.startNode(name);
+            json.put("name", d.Name);
+            json.put("style", d.StyleName);
+            json.put("height", d.Height);
+            json.put("width", d.Width);
+            json.put("family", d.Family);
+            json.put("charset", d.CharSet);
+            json.put("pitch", d.Pitch);
+            json.put("characterWidth", d.CharacterWidth);
+            json.put("weight", d.Weight);
+            json.put("slant", static_cast<int>(d.Slant));
+            json.put("underline", d.Underline);
+            json.put("strikeout", d.Strikeout);
+            json.put("orientation", d.Orientation);
+            json.put("kerning", d.Kerning);
+            json.put("wordLineMode", d.WordLineMode);
+        };
+        if (requested)
+            descriptor("requested", *requested);
+        if (font.is())
+            descriptor("effective", font->getFontDescriptor());
+        descriptor("deviceFont", VCLUnoHelper::CreateFontDescriptor(device->GetFont()));
+        descriptor("deviceMetric", VCLUnoHelper::CreateFontDescriptor(device->GetFontMetric()));
+        json.put("dpiX", device->GetDPIX());
+        json.put("dpiY", device->GetDPIY());
+        json.put("layoutMode", static_cast<int>(device->GetLayoutMode()));
+        const auto& map = device->GetMapMode();
+        json.put("mapUnit", static_cast<int>(map.GetMapUnit()));
+        json.put("scaleX", map.GetScaleX());
+        json.put("scaleY", map.GetScaleY());
+        json.put("deviceDigitsWidth", device->GetTextWidth(u"0123456789"_ustr));
+        {
+            auto node = json.startArray("individualDigitWidths");
+            for (sal_Unicode c = '0'; c <= '9'; ++c)
+                json.putSimpleValue(font.is() ? font->getCharWidth(c)
+                    : device->GetTextWidth(OUString(c)));
+        }
+        const OString line = json.finishAndGetAsOString();
+        if (std::FILE* out = std::fopen(std::getenv("FLOE_OFFICE_FONT_METRICS_TRACE"), "a"))
+        {
+            std::fseek(out, 0, SEEK_END);
+            const auto length = std::ftell(out);
+            if (length >= 0 && length < 1024 * 1024)
+            {
+                std::fwrite(line.getStr(), 1, line.getLength(), out);
+                std::fputc('\n', out);
+            }
+            std::fclose(out);
+        }
+    }
+    catch (...)
+    {
+        // Diagnostics must never turn a successful open/save into a failure.
+    }
 }
 
