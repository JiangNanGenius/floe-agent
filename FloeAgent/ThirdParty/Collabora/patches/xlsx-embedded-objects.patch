+            mxState->containers |= 2U;
+            AttributeList aAttributes(rxAttributes);
+            mxState->record.anchor->importAnchor(XDR_TOKEN(twoCellAnchor), aAttributes);
+            mxState->record.moveWithCells = aAttributes.getBool(XML_moveWithCells, false);
+            mxState->record.sizeWithCells = aAttributes.getBool(XML_sizeWithCells, false);
+            return new OleObjectAnchorContext(*this, Part::Anchor);
+        }
+        if (mePart == Part::Anchor && (nElement == XLS_TOKEN(from) || nElement == XLS_TOKEN(to)))
+        {
+            const bool bFrom = nElement == XLS_TOKEN(from);
+            const unsigned nMask = bFrom ? 4U : 8U;
+            if (mxState->containers & nMask) mxState->invalid = true;
+            mxState->containers |= nMask;
+            return new OleObjectAnchorContext(*this, bFrom ? Part::From : Part::To);
+        }
+        if (mePart == Part::From || mePart == Part::To)
+        {
+            unsigned nField;
+            switch (nElement)
+            {
+                case XDR_TOKEN(col): nField = 0; break;
+                case XDR_TOKEN(colOff): nField = 1; break;
+                case XDR_TOKEN(row): nField = 2; break;
+                case XDR_TOKEN(rowOff): nField = 3; break;
+                default: return nullptr;
+            }
+            return new OleObjectAnchorContext(*this, Part::Value, nField + (mePart == Part::To ? 4 : 0));
+        }
+        return nullptr;
+    }
+
+    void characters(const OUString& rText) override
+    {
+        if (mePart != Part::Value) return;
+        if (rText.getLength() > 64 || maText.getLength() > 64 - rText.getLength())
+            mxState->invalid = true;
+        else
+            maText += rText;
+    }
+
+    void endFastElement(sal_Int32) override
+    {
+        if (mePart == Part::Value)
+        {
+            const unsigned nMask = 1U << mnField;
+            if (mxState->fields & nMask) mxState->invalid = true;
+            mxState->fields |= nMask;
+            OUString aValue = maText.trim();
+            sal_Int32 nIndex = 0;
+            bool bNegative = false;
+            if (!aValue.isEmpty() && (aValue[0] == '-' || aValue[0] == '+'))
+            {
+                bNegative = aValue[0] == '-';
+                ++nIndex;
+            }
+            if (nIndex == aValue.getLength()) { mxState->invalid = true; return; }
+            const unsigned nKind = mnField % 4;
+            const sal_Int64 nLimit = nKind == 0 ? 16383 : nKind == 2 ? 1048575 : sal_Int64(SAL_MAX_INT32) * 360;
+            sal_Int64 nValue = 0;
+            for (; nIndex < aValue.getLength(); ++nIndex)
+            {
+                const sal_Int32 nDigit = aValue[nIndex] - '0';
+                if (nDigit < 0 || nDigit > 9 || nValue > (nLimit - nDigit) / 10)
+                { mxState->invalid = true; return; }
+                nValue = nValue * 10 + nDigit;
+            }
+            if (bNegative) nValue = -nValue;
+            if ((nKind == 0 || nKind == 2) && nValue < 0)
+            { mxState->invalid = true; return; }
+            static constexpr sal_Int32 aTokens[] = {XDR_TOKEN(col), XDR_TOKEN(colOff), XDR_TOKEN(row), XDR_TOKEN(rowOff)};
+            mxState->record.anchor->setCellPos(aTokens[nKind], mnField < 4 ? XDR_TOKEN(from) : XDR_TOKEN(to), OUString::number(nValue));
+            if (mnField == 0) mxState->record.column = static_cast<sal_Int32>(nValue);
+            if (mnField == 2) mxState->record.row = static_cast<sal_Int32>(nValue);
+        }
+        else if (mePart == Part::Object && mxState->fields == 255U
+                 && mxState->containers == 15U && !mxState->invalid
+                 && mxState->record.anchor->isAnchorValid())
+            mrDrawing.registerOleAnchor(mxState->shapeId, mxState->record);
+    }
+};
