 /// The DocBrokers container; used from elsewhere as well.
-std::map<std::string, std::shared_ptr<DocumentBroker>> DocBrokers;
-std::mutex DocBrokersMutex; ///< Protects DocBrokers.
+// Embedded iOS hosts keep the kit VCL execute loop and the wsd server thread
+// alive across process exit (runKitLoopInAThread never returns, DeInitVCL
+// skips Kit teardown, the native server is deliberately process-wide). The
+// exit-time destruction of this map on another thread releases live
+// DocumentBrokers whose destructor asserts its socket-poll owner thread
+// (observed at XCTest exit: __assert_rtn ProcUtil::assertCorrectThread <-
+// SocketPoll::assertCorrectThread <- DocumentBroker::~DocumentBroker <-
+// ~map via static destruction). Keep the container and its protecting mutex
+// for the whole process on IOS instead of destroying them under live owner
+// threads. Value-object ABI, extern declarations, runtime dispose/owner-thread
+// erase/save paths and the thread assert itself are untouched; non-IOS keeps
+// ordinary static destruction.
+#if defined(IOS)
+#define FLOE_IOS_NO_DESTROY [[clang::no_destroy]]
+#else
+#define FLOE_IOS_NO_DESTROY
+#endif
+FLOE_IOS_NO_DESTROY std::map<std::string, std::shared_ptr<DocumentBroker>> DocBrokers;
+FLOE_IOS_NO_DESTROY std::mutex DocBrokersMutex; ///< Protects DocBrokers.
 
