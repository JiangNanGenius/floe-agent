+// Synchronously run |block| on the main queue when called off-main. This is
+// deadlock-free: every main -> background hop is asynchronous, so the main
+// queue never waits on background work and always drains.
+static void FLEOnMainSync(dispatch_block_t block) {
+    if ([NSThread isMainThread])
+        block();
+    else
+        dispatch_sync(dispatch_get_main_queue(), block);
+}
+
+// Largest single didReceiveData payload. Large message bodies are streamed
+// in chunks of at most this size, so no main-queue block performs unbounded
+// work and no per-message payload is duplicated in memory. The wire framing
+// (header, body bytes, terminating newline) is unchanged: WebKit concatenates
+// streamed data and the frame boundary is still the trailing newline.
+static const NSUInteger FLEMaxDataChunk = 256 * 1024;
+
+// Per-task lifecycle state (Floe overlay).
+@interface FLEMobileSocketTaskState : NSObject
+@property (nonatomic) BOOL stopped; // Main queue only.
+@end
+
+@implementation FLEMobileSocketTaskState
+@end
+
+// Outcome of one WebKit callback attempt (main queue only).
+//  - executed: the callback ran. A reentrant stop INSIDE that very callback
+//    still leaves executed == YES (the frame genuinely entered WebKit, so the
+//    message is consumed exactly as for any delivered frame).
+//  - active: the task was alive both before AND after the callback. It is NO
+//    when the callback was suppressed (already stopped) or when a stop landed
+//    reentrantly during it; callers use it to stop emitting further frames and
+//    to settle as cancelled.
+// Keeping the two apart is essential: conflating "executed" with "active"
+// skipped pop_front after a reentrant stop inside the trailing newline, so a
+// fully delivered message was requeued and duplicated on the replacement task.
+typedef struct FLEEmitResult {
+    BOOL executed;
+    BOOL active;
+} FLEEmitResult;
+
+// Read stopped via the main queue (the only owner of state).
+static BOOL FLEStateStopped(FLEMobileSocketTaskState *state) {
+    __block BOOL stopped = NO;
+    FLEOnMainSync(^{ stopped = state.stopped; });
+    return stopped;
+}
