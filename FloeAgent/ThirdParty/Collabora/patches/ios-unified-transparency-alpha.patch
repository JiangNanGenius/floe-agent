+// A device whose pixels can be transparent must be treated as an isolated
+// group. The iOS tile and slideshow targets carry real RGBA pixels but report
+// HasAlpha() == false (they are foreign-context devices created as
+// DeviceFormat::WITHOUT_ALPHA), so the explicit transparent background is the
+// reliable signal. For those targets the documented algorithm — blit the
+// backdrop into a buffer and alpha-composite the whole bounding rectangle
+// back — turns every transparent destination pixel into an opaque white
+// matte. An isolated group instead starts from a fully transparent buffer,
+// renders only the children and applies the group opacity once on top of the
+// untouched destination, which never attenuates destination pixels twice.
+// Non-iOS targets keep the historical behaviour.
+bool isIsolatedGroupTarget(const OutputDevice& rOutDev)
+{
+#if defined(IOS)
+    if (rOutDev.HasAlpha())
+        return true;
+    const Wallpaper& rBackground = rOutDev.GetBackground();
+    return rBackground.GetStyle() != WallpaperStyle::NONE
+        && rBackground.GetColor().IsTransparent();
+#else
+    (void)rOutDev;
+    return false;
+#endif
+}
