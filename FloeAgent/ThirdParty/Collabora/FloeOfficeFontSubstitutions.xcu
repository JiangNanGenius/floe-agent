<?xml version="1.0" encoding="UTF-8"?>
<!--
  Floe Office font substitutions (Build 233, R4).

  This file is an additive user-layer configuration merged into the app's
  `coolkitconfig.xcu` (the host's last CONFIGURATION_LAYERS entry) by
  scripts/build_office_native_host.py at native-host packaging time. The
  merge is deterministic and preserves every vendor item byte-for-byte; the
  shipped overlay is a candidate that needs a new immutable host pin.

  Rules enforced by scripts/office_font_config.py and its tests:

  * every item path follows the pinned VCL registry hierarchy exactly:
    `/org.openoffice.VCL/FontSubstitutions/` (set, node-type
    `LocalizedFontSubstitutions`) then the locale set member
    `org.openoffice.VCL:LocalizedFontSubstitutions['en']`, then the alias
    record `org.openoffice.VCL:LFonts['simsun']`. The pinned
    `fontcfg.cxx readLocaleSubst` reads a locale member and its alias
    records; a path that omits the locale would address a set member of the
    root set (a locale) or be rejected outright by configmgr;
  * an alias the pinned `share/registry/main.xcd` already declares under the
    locale has only its `SubstFonts` property replaced; the vendor
    `SubstFontsMS`/`FontWeight`/`FontWidth`/`FontType` stay intact;
  * an alias the pinned table lacks is added as an `oor:op="fuse"` node child
    of the existing locale member. The pinned `XcuParser::handleSetNode`
    creates the missing `LFonts` member (or merges into one) and never
    replaces the locale member, so every sibling alias and locale is retained;
  * alias keys are stored in the normalized form the pinned engine looks up
    (fontdefs.cxx GetEnglishSearchFontName: ASCII lowercase, whitespace and
    special characters removed except `;` `(` `)`, fullwidth ASCII folded,
    localized names translated), because fontcfg.cxx getSubstInfo lowercases
    the query and prefix-matches; `宋体` reaches the engine as `simsun` and
    `方正仿宋` as `fzfangsong`;
  * `SubstFonts` targets are real font *families* (name table IDs 1/16) of
    licensed fonts Floe stages (`FloeApp/Resources/Fonts/Bundled`, copied to
    the engine-scanned `program/resource/common/fonts`), never PostScript
    filenames and never proprietary fonts;
  * properties use only the shipped VCL schema names (SubstFonts,
    SubstFontsMS, FontWeight, FontWidth, FontType).

  The existing `share/registry/main.xcd` substitution entries list Chinese
  targets such as `fzsongti`/`msunglightsc`/`nsimsun` that are not installed;
  these overrides put the bundled families first so a document naming SimSun,
  SimHei, Microsoft YaHei, DengXian, KaiTi, FangSong or the Office Latin
  defaults resolves to a real glyph set instead of the engine's fallback.
-->
<oor:items xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <!-- Simplified Chinese families: serif body text keeps a serif face.
       These aliases exist as `LFonts` records of the `en` locale set in the
       pinned main.xcd, so an alias-path item replaces just SubstFonts. -->
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['simsun']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['nsimsun']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['simsong']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['song']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['shusong']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['msunglightsc']">
    <prop oor:name="SubstFonts" oor:op="replace" oor:type="xs:string"><value>Source Han Serif SC;Source Han Sans SC</value></prop>
  </item>
  <item oor:path="/org.openoffice.VCL/FontSubstitutions/org.openoffice.VCL:LocalizedFontSubstitutions['en']/org.openoffice.VCL:LFonts['fangsong']">
