+/* Floe: timeout is per no-progress phase, never a whole-clone deadline.
+ * Keep configured stream values; only SSH gets a bounded missing default. */
+static uint64_t ssh_idle_deadline(LIBSSH2_SESSION *session)
+{
+	long timeout = libssh2_session_get_timeout(session);
+	return git_time_monotonic() + (uint64_t)(timeout > 0 ? timeout : 30000);
+}
+
+static int ssh_check_budget(ssh_subtransport *transport, uint64_t deadline)
+{
+	if (git_atomic32_get(&transport->owner->cancelled)) {
+		git_error_set(GIT_ERROR_SSH, "SSH transfer cancelled");
+		return GIT_EUSER;
+	}
+	if (git_time_monotonic() >= deadline) {
+		git_error_set(GIT_ERROR_SSH, "SSH operation timed out without progress");
+		return GIT_TIMEOUT;
+	}
+	return 0;
+}
+
+static void ssh_retry_pause(void)
+{
+	struct timespec delay = { 0, 10000000 };
+	nanosleep(&delay, NULL);
+}
