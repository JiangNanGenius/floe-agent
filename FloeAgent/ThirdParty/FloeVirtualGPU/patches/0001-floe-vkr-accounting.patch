+/* Floe-only accounting metadata for exported/imported fd aliases. The caller
+ * retains once for its fd; each imported renderer resource retains separately. */
+uint64_t vkr_renderer_resource_accounting_key(uint32_t ctx_id,uint32_t res_id) {
+   struct vkr_context *ctx=vkr_renderer_lookup_context(ctx_id);
+   struct vkr_resource *res=ctx?vkr_context_get_resource(ctx,res_id):NULL;
+   return res?res->accounting_key:0;
+}
+bool vkr_renderer_resource_accounting_import(uint32_t ctx_id,uint32_t res_id,uint64_t key) {
+   struct vkr_context *ctx=vkr_renderer_lookup_context(ctx_id);
+   struct vkr_resource *res=ctx?vkr_context_get_resource(ctx,res_id):NULL;
+   if(!res||!key) return false;
+   if(res->accounting_key) return res->accounting_key==key;
+   if(!vkr_accounting_ref(key)) return false;
+   res->accounting_key=key;return true;
+}
diff --git a/src/venus/vkr_accounting.c b/src/venus/vkr_accounting.c
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_accounting.c
@@ -0,0 +1,96 @@
+/* Copyright 2026 Floe contributors; SPDX-License-Identifier: MIT */
+#include "vkr_accounting.h"
+#include <stdlib.h>
+#include <pthread.h>
+#include <assert.h>
+#define MAX_ENTRIES 16384u
+struct entry {
+   uint64_t key,size,refs,parent;
+   uint32_t type;
+   bool aliased,blob;
+   struct entry *next;
+};
+static pthread_mutex_t lock=PTHREAD_MUTEX_INITIALIZER;
+static vkr_accounting_cb memory_cb,blob_cb;
+static vkr_accounting_admit_cb admit_cb;
+static vkr_accounting_cancel_cb cancel_cb;
+static void *memory_user,*blob_user,*admit_user;
+static struct entry *table[1024];
+static uint64_t entry_count,pending_count,next_key;
+void vkr_accounting_set_callback(vkr_accounting_cb cb,void *user) {
+   pthread_mutex_lock(&lock);memory_cb=cb;memory_user=user;pthread_mutex_unlock(&lock);
+}
+void vkr_accounting_set_blob_callback(vkr_accounting_cb cb,void *user) {
+   pthread_mutex_lock(&lock);blob_cb=cb;blob_user=user;pthread_mutex_unlock(&lock);
+}
+void vkr_accounting_set_admission(vkr_accounting_admit_cb admit,vkr_accounting_cancel_cb cancel,void *user) {
+   pthread_mutex_lock(&lock);admit_cb=admit;cancel_cb=cancel;admit_user=user;pthread_mutex_unlock(&lock);
+}
+static struct entry **find(uint64_t key) {
+   struct entry **p=&table[key&1023];
+   while(*p&&(*p)->key!=key) p=&(*p)->next;
+   return p;
+}
+/* Iterative parent release: untrusted import chains cannot consume host stack.
+ * IDs never reuse pointer addresses, even when an exported fd outlives its
+ * original Vulkan object/context. Physical bytes release only at final ref. */
+static void release_locked(uint64_t key) {
+   while(key) {
+      struct entry **p=find(key);struct entry *e=*p;
+      if(!e) return;
+      assert(e->refs);
+      if(--e->refs) return;
+      *p=e->next;entry_count--;
+      vkr_accounting_cb cb=e->blob?blob_cb:memory_cb;
+      if(cb) cb(e->size,e->type,e->aliased,false,key,e->blob?blob_user:memory_user);
+      key=e->parent;free(e);
+   }
+}
+bool vkr_accounting_reserve(struct vkr_accounting_reservation *r,uint64_t size,bool aliased,bool blob) {
+   assert(r&&!r->entry);
+   struct entry *e=calloc(1,sizeof(*e));if(!e) return false;
+   e->size=size;e->aliased=aliased;e->blob=blob;e->refs=1;
+   pthread_mutex_lock(&lock);
+   bool allowed=entry_count+pending_count<MAX_ENTRIES&&next_key<UINT64_MAX;
+   if(allowed&&admit_cb) allowed=admit_cb(size,aliased,blob,admit_user);
+   if(allowed) {pending_count++;e->key=++next_key;}
+   pthread_mutex_unlock(&lock);
+   if(!allowed) {free(e);return false;}
+   r->entry=e;return true;
+}
+bool vkr_accounting_link_parent(struct vkr_accounting_reservation *r,uint64_t parent) {
+   struct entry *e=r->entry;assert(e&&!e->parent);
+   if(!parent) return true;
+   pthread_mutex_lock(&lock);struct entry *p=*find(parent);
+   bool ok=p&&p->refs<UINT64_MAX&&parent<e->key;
+   if(ok) {p->refs++;e->parent=parent;}
+   pthread_mutex_unlock(&lock);return ok;
+}
+void vkr_accounting_cancel(struct vkr_accounting_reservation *r) {
+   struct entry *e=r->entry;if(!e) return;r->entry=NULL;
+   pthread_mutex_lock(&lock);assert(pending_count);pending_count--;
+   if(cancel_cb) cancel_cb(e->size,e->aliased,e->blob,admit_user);
+   release_locked(e->parent);
+   pthread_mutex_unlock(&lock);free(e);
+}
+uint64_t vkr_accounting_commit(struct vkr_accounting_reservation *r,uint32_t type) {
+   struct entry *e=r->entry;assert(e);r->entry=NULL;e->type=type;
+   pthread_mutex_lock(&lock);assert(pending_count);pending_count--;
+   struct entry **head=find(e->key);assert(!*head);*head=e;entry_count++;
+   vkr_accounting_cb cb=e->blob?blob_cb:memory_cb;
+   if(cb) cb(e->size,e->type,e->aliased,true,e->key,e->blob?blob_user:memory_user);
+   pthread_mutex_unlock(&lock);return e->key;
+}
+bool vkr_accounting_ref(uint64_t key) {
+   pthread_mutex_lock(&lock);struct entry *e=*find(key);
+   bool ok=e&&e->refs<UINT64_MAX;if(ok) e->refs++;
+   pthread_mutex_unlock(&lock);return ok;
+}
+void vkr_accounting_unref(uint64_t key) {
+   pthread_mutex_lock(&lock);release_locked(key);pthread_mutex_unlock(&lock);
+}
+void vkr_accounting_report_free(uint64_t key) {vkr_accounting_unref(key);}
+void vkr_accounting_report_blob_free(uint64_t key) {vkr_accounting_unref(key);}
+uint64_t vkr_accounting_entry_count(void) {
+   pthread_mutex_lock(&lock);uint64_t n=entry_count+pending_count;pthread_mutex_unlock(&lock);return n;
+}
diff --git a/src/venus/vkr_accounting.h b/src/venus/vkr_accounting.h
new file mode 100644
--- /dev/null
+++ b/src/venus/vkr_accounting.h
@@ -0,0 +1,34 @@
+/* Copyright 2026 Floe contributors; SPDX-License-Identifier: MIT */
+#ifndef VKR_ACCOUNTING_H
+#define VKR_ACCOUNTING_H
+#include <stdbool.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Callbacks are serialized under the registry mutex; never re-enter this API.
+ * Unregister only after renderer workers have joined. */
+typedef void (*vkr_accounting_cb)(uint64_t size,uint32_t type,bool aliased,bool alloc,uint64_t key,void *user);
+typedef bool (*vkr_accounting_admit_cb)(uint64_t size,bool aliased,bool blob,void *user);
+typedef void (*vkr_accounting_cancel_cb)(uint64_t size,bool aliased,bool blob,void *user);
+void vkr_accounting_set_callback(vkr_accounting_cb cb,void *user);
+void vkr_accounting_set_blob_callback(vkr_accounting_cb cb,void *user);
+void vkr_accounting_set_admission(vkr_accounting_admit_cb admit,vkr_accounting_cancel_cb cancel,void *user);
+/* Reserve bookkeeping and quota BEFORE driver/shm allocation. The cleanup
+ * handler rolls back every early return; commit consumes the reservation. */
+struct vkr_accounting_reservation { void *entry; };
+bool vkr_accounting_reserve(struct vkr_accounting_reservation *r,uint64_t size,bool aliased,bool blob);
+uint64_t vkr_accounting_commit(struct vkr_accounting_reservation *r,uint32_t type);
+bool vkr_accounting_link_parent(struct vkr_accounting_reservation *r,uint64_t parent);
+bool vkr_accounting_ref(uint64_t key);
+void vkr_accounting_unref(uint64_t key);
+uint64_t vkr_renderer_resource_accounting_key(uint32_t ctx,uint32_t resource);
+bool vkr_renderer_resource_accounting_import(uint32_t ctx,uint32_t resource,uint64_t key);
+void vkr_accounting_cancel(struct vkr_accounting_reservation *r);
+void vkr_accounting_report_free(uint64_t key);
+void vkr_accounting_report_blob_free(uint64_t key);
+uint64_t vkr_accounting_entry_count(void);
+#ifdef __cplusplus
+}
+#endif
+#endif
