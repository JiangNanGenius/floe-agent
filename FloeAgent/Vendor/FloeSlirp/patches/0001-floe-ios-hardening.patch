+#else  /* !SLIRP_NO_HOST_EXEC */
     if (!check_guestfwd(slirp, guest_addr, guest_port)) {
         return -1;
     }
 
     add_exec(&slirp->guestfwd_list, cmdline, *guest_addr, htons(guest_port));
     return 0;
+#endif /* !SLIRP_NO_HOST_EXEC */
 }
 
