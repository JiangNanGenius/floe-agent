+ * fork() or exec() code paths can be linked into the final image.
+ * fork_exec() keeps the upstream failure convention (return 0 => the
+ * caller closes the connection) and never spawns anything.
+ */
+int fork_exec(struct socket *so, const char *ex)
+{
+    (void)so;
+    (void)ex;
+    return 0;
+}
