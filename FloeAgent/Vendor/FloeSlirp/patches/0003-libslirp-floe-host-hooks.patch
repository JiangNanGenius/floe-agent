# 0002-floe-host-hooks.patch
#
# Narrow, compile-guarded hooks against pinned libslirp 4.9.7
# (tag commit ce12dcddf710a71dc0de6450ec95edbadf8e9f66), on top of the vendor
# lane's 0001-floe-ios-hardening.patch. EVERY hunk is inside
# #ifdef SLIRP_FLOE_HOST_HOOKS, so a build without that macro is byte-for-byte
# upstream behaviour. The two new files are inert without the macro too.
#
# Why each hook exists is documented in src/floe_host_net.h.
#
# Apply inside the libslirp source root with:
#   git apply -p1 0002-floe-host-hooks.patch
#   (or: patch -p1 -i 0002-floe-host-hooks.patch)
#
