@@ -0,0 +1,160 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Implementation of the Floe embedder hooks. See floe_host_net.h for the
+ * rationale. Inert unless -DSLIRP_FLOE_HOST_HOOKS is set. */
+#include "slirp.h"
+
+#ifdef SLIRP_FLOE_HOST_HOOKS
+
+#include "floe_host_net.h"
+#include "socket.h"
+
+#include <string.h>
+
+void slirp_floe_set_hooks(Slirp *slirp, const FloeSlirpHooks *hooks)
+{
+    if (!slirp) {
+        return;
+    }
+    if (hooks && hooks->struct_size < sizeof(*hooks)) {
+        g_warning("slirp_floe_set_hooks: struct_size %u < %zu, ignoring",
+                  hooks->struct_size, sizeof(*hooks));
+        return;
+    }
+    if (hooks && hooks->abi != FLOE_SLIRP_HOOKS_ABI) {
+        g_warning("slirp_floe_set_hooks: unsupported abi %u, ignoring",
+                  hooks->abi);
+        return;
+    }
+    slirp->floe_hooks = hooks;
+}
+
+int floe_admit_socket(Slirp *slirp, FloeSlirpSockReason reason)
+{
+    const FloeSlirpHooks *h = slirp ? slirp->floe_hooks : NULL;
+
+    if (!h || !h->admit_socket) {
+        return 0;                       /* no hook: upstream behaviour */
+    }
+    int rc = h->admit_socket(reason, h->ctx);
+
+    return rc < 0 ? rc : 0;
+}
+
+/* Decide the family for an outbound host socket and record the host-side
+ * destination. The guest-visible so_fhost / so_ffamily are deliberately left
+ * untouched: they drive libslirp's packet demultiplexing, its receive-path
+ * header sizing and the source address the guest sees, so rewriting them would
+ * change protocol behaviour. Only the address actually passed to connect() or
+ * sendto() differs. */
+unsigned short floe_prepare_outbound(struct socket *so, unsigned short af)
+{
+    const FloeSlirpHooks *h = so->slirp ? so->slirp->floe_hooks : NULL;
+    struct sockaddr_storage host;
+
+    so->floe_hfamily = 0;
+    so->floe_translated = 0;
+
+    /* An IPv4 guest's virtual DNS endpoint can be served by an IPv6 resolver
+     * even when upstream's IPv4 resolver discovery still finds a stale or
+     * unrelated IPv4 address. Ask the per-instance embedder first; its callback
+     * returns 1 only when its honest resolver snapshot has no usable IPv4 and
+     * does have IPv6. Restrict this to the virtual nameserver/gateway DNS
+     * compatibility endpoints, never to an arbitrary public port-53 flow. */
+    if (h && h->dns4_via_nat64 && af == AF_INET &&
+        !so->slirp->disable_dns && so->so_fport == htons(53) &&
+        (so->so_faddr.s_addr == so->slirp->vnameserver_addr.s_addr ||
+         so->so_faddr.s_addr == so->slirp->vhost_addr.s_addr)) {
+        struct in6_addr a6;
+        uint16_t port = htons(53);
+        uint32_t scope = 0;
+        memset(&a6, 0, sizeof(a6));
+        if (h->dns4_via_nat64(&a6, &port, &scope, h->ctx) == 1) {
+            struct sockaddr_in6 *s6 = &so->floe_fhost_host.sin6;
+            memset(s6, 0, sizeof(*s6));
+            s6->sin6_family = AF_INET6;
+            s6->sin6_port = port;
+            s6->sin6_addr = a6;
+            s6->sin6_scope_id = scope;
+            so->floe_hfamily = AF_INET6;
+            so->floe_translated = 1;
+            return AF_INET6;
+        }
+    }
+
+    /* Start from upstream's own translation, which handles the virtual
+     * nameserver redirect, the gateway-as-DNS compatibility case and the
+     * host-loopback mapping. */
+    host = so->fhost.ss;
+    if (sotranslate_out(so, &host) < 0) {
+        return af;                      /* let upstream report the EPERM path */
+    }
+    so->floe_fhost_host.ss = host;
+    so->floe_translated = 1;
+
+    if (af != AF_INET || !h || !h->map_nat64 || host.ss_family != AF_INET) {
+        so->floe_hfamily = (unsigned short)host.ss_family;
+        return af;
+    }
+
+    struct in6_addr mapped;
+    memset(&mapped, 0, sizeof(mapped));
+    int rc = h->map_nat64(&((struct sockaddr_in *)&host)->sin_addr, &mapped,
+                          h->ctx);
+    if (rc != 1) {
+        so->floe_hfamily = AF_INET;
+        return AF_INET;
+    }
+
+    /* Keep the port; replace the address and switch the family. */
+    struct sockaddr_in6 *s6 = &so->floe_fhost_host.sin6;
+    memset(s6, 0, sizeof(*s6));
+    s6->sin6_family = AF_INET6;
+    s6->sin6_port = ((struct sockaddr_in *)&host)->sin_port;
+    s6->sin6_addr = mapped;
+    so->floe_hfamily = AF_INET6;
+    return AF_INET6;
+}
+
+const struct sockaddr *floe_host_dest(struct socket *so, socklen_t *len)
+{
+    /* When the hook path already resolved the host destination, use it
+     * verbatim; otherwise fall back to upstream's own translate-then-use. */
+    if (so->floe_translated) {
+        *len = sockaddr_size(&so->floe_fhost_host.ss);
+        return &so->floe_fhost_host.sa;
+    }
+    return NULL;
+}
+
+int floe_dns4_override(Slirp *slirp, struct in_addr *addr, uint16_t *port)
+{
+    const FloeSlirpHooks *h = slirp ? slirp->floe_hooks : NULL;
+
+    if (!h || !h->dns4_override) {
+        return 0;                       /* fall through to get_dns_addr() */
+    }
+    int rc = h->dns4_override(addr, port, h->ctx);
+
+    if (rc < 0) {
+        return -1;                      /* refuse DNS honestly */
+    }
+    return rc > 0 ? 1 : 0;
+}
+
+int floe_dns6_override(Slirp *slirp, struct in6_addr *addr, uint16_t *port,
+                       uint32_t *scope)
+{
+    const FloeSlirpHooks *h = slirp ? slirp->floe_hooks : NULL;
+
+    if (!h || !h->dns6_override) {
+        return 0;
+    }
+    int rc = h->dns6_override(addr, port, scope, h->ctx);
+
+    if (rc < 0) {
+        return -1;
+    }
+    return rc > 0 ? 1 : 0;
+}
+
+#endif /* SLIRP_FLOE_HOST_HOOKS */
