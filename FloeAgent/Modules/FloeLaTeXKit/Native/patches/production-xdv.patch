+// Copyright 2026 the Floe Project. Licensed under the MIT License.
+//! One bounded native preparation operation, shared with scoped prefetch workers.
+use std::{
+    collections::BTreeMap,
+    io,
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+use tectonic_errors::{prelude::*, Result};
+
+#[derive(Default, Debug)]
+struct Ledger {
+    completed_ms: u64,
+    received_bytes: u64,
+    requests: u64,
+    active: BTreeMap<u64, Instant>,
+}
+#[derive(Debug)]
+struct Budget {
+    request_ms: u64,
+    total_ms: u64,
+    cancelled: fn() -> bool,
+    started: fn(),
+    ledger: Mutex<Ledger>,
+}
+static CURRENT: OnceLock<Mutex<Option<Arc<Budget>>>> = OnceLock::new();
+fn current() -> &'static Mutex<Option<Arc<Budget>>> {
+    CURRENT.get_or_init(|| Mutex::new(None))
+}
+fn elapsed(start: Instant) -> u64 {
+    start.elapsed().as_millis().min(u128::from(u64::MAX)) as u64
+}
+fn spent(ledger: &Ledger) -> u64 {
+    ledger
+        .active
+        .values()
+        .fold(ledger.completed_ms, |sum, start| {
+            sum.saturating_add(elapsed(*start))
+        })
+}
+impl Budget {
+    fn check(&self) -> io::Result<u64> {
+        if (self.cancelled)() {
+            return Err(io::Error::new(
+                io::ErrorKind::ConnectionAborted,
+                "Native resource request cancelled",
+            ));
+        }
+        let ledger = self
+            .ledger
+            .lock()
+            .map_err(|_| io::Error::new(io::ErrorKind::Other, "Resource budget unavailable"))?;
+        let remaining = self.total_ms.saturating_sub(spent(&ledger));
+        if remaining == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::TimedOut,
+                "Native cumulative resource budget exhausted",
+            ));
+        }
+        Ok(remaining)
+    }
+}
+
+/// Observed resource-download counters for the current native operation.
+#[derive(Clone, Debug)]
+pub struct ResourceMetrics {
+    /// Maximum duration allowed for an individual HTTP resource request.
+    pub request_timeout_seconds: u64,
+    /// Cumulative duration allowed across all scoped HTTP resource requests.
+    pub total_timeout_seconds: u64,
+    /// Number of resource requests started by this operation.
+    pub request_count: u64,
+    /// Number of response-body bytes actually received by this operation.
+    pub received_bytes: u64,
+    /// Elapsed milliseconds charged to this operation's resource budget.
+    pub elapsed_milliseconds: u64,
+}
+/// The caller serializes native TeX jobs and keeps this guard alive until all
+/// scoped resource workers/response readers have joined. No environment policy.
+pub struct ResourceScope {
+    budget: Arc<Budget>,
+}
+impl ResourceScope {
+    /// Install the operation's bounded request budget and cancellation hooks.
+    ///
+    /// The caller must serialize native operations and retain the guard until
+    /// every scoped request and response reader has joined.
+    pub fn install(
+        request_seconds: u64,
+        total_seconds: u64,
+        cancelled: fn() -> bool,
+        started: fn(),
+    ) -> Result<Self> {
+        let request = request_seconds.clamp(1, 120);
+        let total = total_seconds.clamp(request, 1200);
+        let budget = Arc::new(Budget {
+            request_ms: request * 1000,
+            total_ms: total * 1000,
+            cancelled,
+            started,
+            ledger: Mutex::new(Ledger::default()),
+        });
+        let mut slot = current()
+            .lock()
+            .map_err(|_| tectonic_errors::Error::msg("Resource scope unavailable"))?;
+        if slot.is_some() {
+            bail!("Another native resource operation still owns the HTTP budget")
+        }
+        *slot = Some(budget.clone());
+        Ok(Self { budget })
+    }
+    /// Snapshot the actual counters charged to this resource scope.
+    pub fn metrics(&self) -> ResourceMetrics {
+        let ledger = self.budget.ledger.lock().unwrap_or_else(|e| e.into_inner());
+        ResourceMetrics {
+            request_timeout_seconds: self.budget.request_ms / 1000,
+            total_timeout_seconds: self.budget.total_ms / 1000,
+            request_count: ledger.requests,
+            received_bytes: ledger.received_bytes,
+            elapsed_milliseconds: spent(&ledger),
+        }
+    }
+}
+impl Drop for ResourceScope {
+    fn drop(&mut self) {
+        let mut slot = current().lock().unwrap_or_else(|e| e.into_inner());
+        if slot
+            .as_ref()
+            .map(|b| Arc::ptr_eq(b, &self.budget))
+            .unwrap_or(false)
+        {
+            *slot = None;
+        }
+    }
+}
+
+#[derive(Debug)]
+pub(super) struct Ticket {
+    budget: Option<Arc<Budget>>,
+    id: u64,
+    timeout: Duration,
+}
+impl Ticket {
+    pub fn begin() -> io::Result<Self> {
+        let budget = current()
+            .lock()
+            .map_err(|_| io::Error::new(io::ErrorKind::Other, "Resource scope unavailable"))?
+            .clone();
+        if let Some(budget) = budget {
+            let remaining = budget.check()?;
+            let mut ledger = budget
+                .ledger
+                .lock()
+                .map_err(|_| io::Error::new(io::ErrorKind::Other, "Resource ledger unavailable"))?;
+            ledger.requests = ledger.requests.checked_add(1).ok_or_else(|| {
+                io::Error::new(io::ErrorKind::Other, "Resource request counter overflow")
+            })?;
+            let id = ledger.requests;
+            ledger.active.insert(id, Instant::now());
+            drop(ledger);
+            let timeout = Duration::from_millis(remaining.min(budget.request_ms).max(1));
+            Ok(Self {
+                budget: Some(budget),
+                id,
+                timeout,
+            })
+        } else {
+            Ok(Self {
+                budget: None,
+                id: 0,
+                timeout: Duration::from_secs(60),
+            })
+        }
+    }
+    pub fn timeout(&self) -> Duration {
+        self.timeout
+    }
+    pub fn dispatch(&self) {
+        if let Some(budget) = &self.budget {
+            (budget.started)();
+        }
+    }
+    pub fn check(&self) -> io::Result<()> {
+        if let Some(budget) = &self.budget {
+            budget.check()?;
+        }
+        Ok(())
+    }
+    pub fn received(&self, count: usize) {
+        if let Some(budget) = &self.budget {
+            let mut ledger = budget.ledger.lock().unwrap_or_else(|e| e.into_inner());
+            ledger.received_bytes = ledger.received_bytes.saturating_add(count as u64);
+        }
+    }
+}
+impl Drop for Ticket {
+    fn drop(&mut self) {
+        if let Some(budget) = &self.budget {
+            let mut ledger = budget.ledger.lock().unwrap_or_else(|e| e.into_inner());
+            if let Some(start) = ledger.active.remove(&self.id) {
+                ledger.completed_ms = ledger.completed_ms.saturating_add(elapsed(start));
+            }
+        }
+    }
+}
