 impl Write for MemoryIoItem {
     fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+        let end = self.state.position().checked_add(buf.len() as u64)
+            .ok_or_else(|| io::Error::other("Document output limit reached"))?;
+        if end > 64 * 1024 * 1024 {
+            return Err(io::Error::other("Document output file limit reached"));
+        }
+        let stored: usize = self.files.borrow().values().map(|f| f.data.len()).sum();
+        if stored.saturating_add(end as usize) > 256 * 1024 * 1024 {
+            return Err(io::Error::other("Document output memory limit reached"));
+        }
