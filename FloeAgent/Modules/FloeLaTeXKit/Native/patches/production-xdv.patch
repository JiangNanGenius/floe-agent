+#[cfg(test)]
+mod demand_only_tests {
+    use super::*;
+    use crate::itar::{ItarFileIndex, ItarFileInfo};
+    use std::{
+        io::Cursor,
+        sync::{Arc, Mutex},
+        time::{SystemTime, UNIX_EPOCH},
+    };
+    use tectonic_status_base::NoopStatusBackend;
+
+    const LOCATION: &str = "mock://native-demand-only";
+    const INDEX: &[u8] = b"old.sty 0 3\ncurrent.sty 3 7\n";
+    type Calls = Arc<Mutex<Vec<String>>>;
+
+    struct MockBackend {
+        index: ItarFileIndex,
+        calls: Calls,
+    }
+
+    fn body(name: &str) -> Vec<u8> {
+        match name {
+            "old.sty" => b"old".to_vec(),
+            "current.sty" => b"current".to_vec(),
+            _ => panic!("The mock must never fetch an unindexed resource"),
+        }
+    }
+
+    impl IoProvider for MockBackend {}
+
+    impl Bundle for MockBackend {
+        fn get_digest(&mut self) -> Result<DigestData> {
+            Ok(DigestData::zeros())
+        }
+
+        fn all_files(&self) -> Vec<String> {
+            vec!["old.sty".into(), "current.sty".into()]
+        }
+    }
+
+    impl CachableBundle<'_, ItarFileIndex> for MockBackend {
+        fn supports_batch_open(&self) -> bool {
+            true
+        }
+
+        fn get_location(&mut self) -> String {
+            LOCATION.into()
+        }
+
+        fn initialize_index(&mut self, source: &mut dyn Read) -> Result<()> {
+            self.index.initialize(source)
+        }
+
+        fn get_index_reader(&mut self) -> Result<Box<dyn Read>> {
+            Ok(Box::new(Cursor::new(INDEX)))
+        }
+
+        fn index(&mut self) -> &mut ItarFileIndex {
+            &mut self.index
+        }
+
+        fn search(&mut self, name: &str) -> Option<ItarFileInfo> {
+            self.index.search(name)
+        }
+
+        fn open_fileinfo(
+            &mut self,
+            info: &ItarFileInfo,
+            _status: &mut dyn StatusBackend,
+        ) -> OpenResult<InputHandle> {
+            self.calls
+                .lock()
+                .unwrap()
+                .push(format!("single:{}", info.name()));
+            OpenResult::Ok(InputHandle::new_read_only(
+                info.name(),
+                Cursor::new(body(info.name())),
+                InputOrigin::Other,
+            ))
+        }
+
+        fn batch_open(
+            &mut self,
+            infos: &[ItarFileInfo],
+            _status: &mut dyn StatusBackend,
+        ) -> Vec<OpenResult<Vec<u8>>> {
+            infos
+                .iter()
+                .map(|info| {
+                    self.calls
+                        .lock()
+                        .unwrap()
+                        .push(format!("batch:{}", info.name()));
+                    OpenResult::Ok(body(info.name()))
+                })
+                .collect()
+        }
+    }
+
+    fn fixture() -> (
+        BundleCache<'static, ItarFileIndex>,
+        Calls,
+        PathBuf,
+        PathBuf,
+        PathBuf,
+    ) {
+        // Root may set TMPDIR to its private evidence directory. Retain this
+        // isolated fixture for inspection rather than deleting cache evidence.
+        let stamp = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let root = std::env::temp_dir().join(format!("floe-demand-only-{}-{stamp}", process::id()));
+        fs::create_dir_all(root.join("data")).unwrap();
+        let manifest = root.join(format!("data/{}.prefetch", app_dirs::sanitize(LOCATION)));
+        fs::write(&manifest, b"old.sty\n").unwrap();
+        let calls = Calls::default();
+        let mut index = ItarFileIndex::default();
+        index.initialize(&mut Cursor::new(INDEX)).unwrap();
+        let backend = MockBackend {
+            index,
+            calls: calls.clone(),
+        };
+        let mut cache = BundleCache::new(Box::new(backend), false, Some(root)).unwrap();
+        assert!(cache.prefetch_supported);
+        assert_eq!(cache.touched, HashSet::from(["old.sty".into()]));
+        let old_info = cache.bundle.search("old.sty").unwrap();
+        let current_info = cache.bundle.search("current.sty").unwrap();
+        let old = cache.get_file_path(&old_info);
+        let current = cache.get_file_path(&current_info);
+        assert!(!old.exists() && !current.exists());
+        (cache, calls, manifest, old, current)
+    }
+
+    fn read_current(bundle: &mut dyn Bundle) {
+        let mut status = NoopStatusBackend::default();
+        let mut handle = match bundle.input_open_name("current.sty", &mut status) {
+            OpenResult::Ok(handle) => handle,
+            _ => panic!("The current input must remain downloadable"),
+        };
+        let mut bytes = Vec::new();
+        handle.read_to_end(&mut bytes).unwrap();
+        assert_eq!(bytes, b"current");
+    }
+
+    #[test]
+    fn demand_only_native_miss_then_hit_never_replays_old_manifest() {
+        let (cache, calls, manifest, old, current) = fixture();
+        // Exercise Box<dyn Bundle> forwarding, exactly as native open_bundle.
+        let mut bundle: Box<dyn Bundle> = Box::new(cache);
+        bundle.disable_prefetch();
+        read_current(&mut bundle);
+        assert_eq!(*calls.lock().unwrap(), ["single:current.sty"]);
+        assert_eq!(fs::read(&current).unwrap(), b"current");
+        assert!(
+            !old.exists(),
+            "Another document's missing blob must remain absent"
+        );
+        read_current(&mut bundle);
+        assert_eq!(
+            *calls.lock().unwrap(),
+            ["single:current.sty"],
+            "A cache hit must not fetch again"
+        );
+        assert_eq!(
+            fs::read(&manifest).unwrap(),
+            b"old.sty\n",
+            "Disabling prefetch must preserve the existing disk manifest"
+        );
+        assert!(matches!(
+            bundle.input_open_name("missing.sty", &mut NoopStatusBackend::default()),
+            OpenResult::NotAvailable
+        ));
+        assert_eq!(*calls.lock().unwrap(), ["single:current.sty"]);
+    }
+
+    #[test]
+    fn demand_only_opt_in_preserves_default_learned_prefetch() {
+        let (mut cache, calls, manifest, old, current) = fixture();
+        read_current(&mut cache);
+        assert_eq!(
+            *calls.lock().unwrap(),
+            ["batch:old.sty", "single:current.sty"]
+        );
+        assert_eq!(fs::read(&old).unwrap(), b"old");
+        assert_eq!(fs::read(&current).unwrap(), b"current");
+        assert_eq!(fs::read(&manifest).unwrap(), b"old.sty\ncurrent.sty\n");
+    }
+}
