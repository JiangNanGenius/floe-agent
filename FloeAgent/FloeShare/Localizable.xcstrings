{
  "sourceLanguage": "en",
  "strings": {
    "share.extension.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中..."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 중..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauver..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahorrando..."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvando..."
          }
        }
      }
    },
    "share.extension.saving_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your items in Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存到 Floe。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在儲存到 Floe。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe にアイテムを保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 물품을 Floe에 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder vos articles à Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Artikel in Floe aufbewahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener sus artículos en Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantendo seus itens em Floe."
          }
        }
      }
    },
    "share.extension.saved_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Open Floe to continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，打开 Floe 继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存，開啟 Floe 繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存しました。 続行するには Floe を開いてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되었습니다. 계속하려면 Floe를 엽니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvé. Ouvrez Floe pour continuer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert. Öffnen Sie Floe, um fortzufahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado. Abra Floe para continuar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo. Abra Floe para continuar"
          }
        }
      }
    },
    "share.extension.saved_count": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d items saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %d 个项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存 %d 個專案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d アイテムが保存されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 항목이 저장되었습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Articles %d enregistrés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d Elemente gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artículos de %d guardados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens %d salvos"
          }
        }
      }
    },
    "share.extension.saved_count.one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 item saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 1 个项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存 1 個專案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 件の項目が保存されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1개의 항목이 저장되었습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 article enregistré"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 Artikel gespeichert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 artículo guardado"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 item salvo"
          }
        }
      }
    },
    "share.extension.saved_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and send it yourself in Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Floe 中检查并自行发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 Floe 中檢查並自行傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floeでご自身で確認し、送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe에서 직접 검토하고 보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révisez-le et envoyez-le vous-même en Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie es und senden Sie es selbst in Floe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa y envíalo tú mismo en Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise e envie você mesmo no Floe."
          }
        }
      }
    },
    "share.extension.done": {
      "localizations": {
