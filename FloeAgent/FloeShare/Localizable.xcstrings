          "stringUnit": {
            "state": "translated",
            "value": "Puedes compartir hasta artículos de %d a la vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode compartilhar até itens %d de cada vez."
          }
        }
      }
    },
    "share.error.text_too_large": {
      "localizations": {
