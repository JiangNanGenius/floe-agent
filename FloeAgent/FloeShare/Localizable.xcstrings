    "share.error.queue_full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe is holding too many shares. Open Floe to review or discard them first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 中待处理的分享过多，请先打开 Floe 处理后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 中待處理的分享過多，請先開啟 Floe 處理後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floeは株式を保有しすぎています。 まず、Floe を開いて、レビューするか、破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe는 너무 많은 주식을 보유하고 있습니다. Floe를 열어 먼저 검토하거나 폐기하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe détient trop d'actions. Ouvrez Floe pour les revoir ou les jeter en premier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe hält zu viele Aktien. Öffnen Sie Floe, um sie zuerst zu überprüfen oder zu verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe tiene demasiadas acciones. Abre Floe para revisarlos o descartarlos primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe está detendo muitas ações. Abra Floe para revisá-los ou descartá-los primeiro."
          }
        }
      }
    },
    "share.error.insufficient_space": {
