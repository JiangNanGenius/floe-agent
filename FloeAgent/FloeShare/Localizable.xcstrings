    "share.error.app_group_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe's shared storage is unavailable. Reinstall the app or try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 Floe 的共享存储，请重新安装应用或稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法訪問 Floe 的共享儲存，請重新安裝應用或稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe の共有ストレージは利用できません。 アプリを再インストールするか、後ほど再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe의 공유 스토리지를 사용할 수 없습니다. 앱을 다시 설치하거나 나중에 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage partagé de Floe n'est pas disponible. Réinstallez l'application ou réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gemeinsam genutzte Speicher von Floe ist nicht verfügbar. Installieren Sie die App erneut oder versuchen Sie es später erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento compartido de Floe no está disponible. Vuelve a instalar la aplicación o inténtalo de nuevo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento compartilhado do Floe não está disponível. Reinstale o aplicativo ou tente novamente mais tarde."
          }
        }
      }
    },
    "share.error.invalid_state": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share can't be saved anymore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享已无法保存。"
          }
        },
        "zh-Hant": {
