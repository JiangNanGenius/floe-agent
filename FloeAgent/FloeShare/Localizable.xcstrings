        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción ya no se puede guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este compartilhamento não pode mais ser salvo."
          }
        }
      }
    },
    "share.error.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可保存的内容。"
