          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada para salvar."
          }
        }
      }
    },
    "share.error.item_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share up to %d items at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多分享 %d 个项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多分享 %d 個專案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に最大%dアイテムを共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 최대 %d 항목을 공유할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez partager jusqu'à %d articles à la fois."
          }
