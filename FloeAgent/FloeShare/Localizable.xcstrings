{
  "sourceLanguage": "en",
  "strings": {
    "share.extension.saving": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存…"
          }
        }
      }
    },
    "share.extension.saving_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping your items in Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存到 Floe。"
          }
        }
      }
    },
    "share.extension.saved_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved. Open Floe to continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存，打开 Floe 继续"
          }
        }
      }
    },
    "share.extension.saved_count": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d items saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %d 个项目"
          }
        }
      }
    },
    "share.extension.saved_count.one": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 item saved"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 1 个项目"
          }
        }
      }
    },
    "share.extension.saved_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review and send it yourself in Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Floe 中检查并自行发送。"
          }
        }
      }
    },
    "share.extension.done": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "share.extension.failed_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存分享"
          }
        }
      }
    },
    "share.extension.failed_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Floe and try sharing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Floe 后重新分享。"
          }
        }
      }
    },
    "share.extension.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试"
          }
        }
      }
    },
    "share.extension.close": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "share.error.app_group_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe's shared storage is unavailable. Reinstall the app or try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问 Floe 的共享存储，请重新安装应用或稍后再试。"
          }
        }
      }
    },
    "share.error.invalid_state": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share can't be saved anymore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享已无法保存。"
          }
        }
      }
    },
    "share.error.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可保存的内容。"
          }
        }
      }
    },
    "share.error.item_limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can share up to %d items at a time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多分享 %d 个项目。"
          }
        }
      }
    },
    "share.error.text_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared text is too long."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的文本过长。"
          }
        }
      }
    },
    "share.error.item_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of the shared items is too large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一个分享项目过大。"
          }
        }
      }
    },
    "share.error.envelope_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share is too large."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享内容过大。"
          }
        }
      }
    },
    "share.error.queue_full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe is holding too many shares. Open Floe to review or discard them first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 中待处理的分享过多，请先打开 Floe 处理后再试。"
          }
        }
      }
    },
    "share.error.insufficient_space": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There isn't enough free space to save this share."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，无法保存此分享。"
          }
        }
      }
    },
    "share.error.unsupported_item": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item type isn't supported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此项目类型。"
          }
        }
      }
    },
    "share.error.invalid_envelope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share couldn't be read. The data was kept for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此分享，数据已保留以便恢复。"
          }
        }
      }
    },
    "share.error.not_found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share is no longer available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享已不存在。"
          }
        }
      }
    },
    "share.error.claim_busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share is being used in another window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此分享正在另一个窗口中处理。"
          }
        }
      }
    },
    "share.error.claim_token_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share changed before it could be saved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享内容已变更，无法保存。"
          }
        }
      }
    },
    "share.error.io_failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe couldn't save the share. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 无法保存分享，请重试。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
