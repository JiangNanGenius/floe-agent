    "share.extension.failed_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save this share"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存分享"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法儲存分享"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この共有を保存できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공유를 저장할 수 없습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer ce partage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Freigabe konnte nicht gespeichert werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar esta acción"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar este compartilhamento"
          }
        }
      }
    },
    "share.extension.failed_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Floe and try sharing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 Floe 后重新分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟 Floe 後重新分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe を開いて、もう一度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe를 열고 다시 공유해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Floe et essayez de partager à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Floe und versuchen Sie die Freigabe erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Floe e intenta compartir de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Floe e tente compartilhar novamente."
          }
        }
      }
    },
