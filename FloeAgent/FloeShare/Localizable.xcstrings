    "share.error.invalid_envelope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share couldn't be read. The data was kept for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此分享，数据已保留以便恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此分享，資料已保留以便恢復。"
