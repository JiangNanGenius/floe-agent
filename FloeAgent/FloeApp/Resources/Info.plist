<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.floeagent.ios.refresh</string>
		<string>org.floeagent.ios.processing</string>
		<string>org.floeagent.ios.media-refresh</string>
		<string>org.floeagent.ios.media-processing</string>
		<string>org.floeagent.ios.continued.*</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Floe Note</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.floeagent.note</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Floe Canvas</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.floeagent.canvas</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>PDF and Office documents</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.adobe.pdf</string>
				<string>org.openxmlformats.wordprocessingml.document</string>
				<string>org.openxmlformats.spreadsheetml.sheet</string>
				<string>org.openxmlformats.presentationml.presentation</string>
				<string>com.microsoft.word.doc</string>
				<string>com.microsoft.excel.xls</string>
				<string>com.microsoft.powerpoint.ppt</string>
				<string>org.oasis-open.opendocument.text</string>
				<string>org.oasis-open.opendocument.spreadsheet</string>
				<string>org.oasis-open.opendocument.presentation</string>
				<string>public.rtf</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.floeagent.ios.routes</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>floe</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>FLOEGitHubOAuthClientID</key>
	<string>$(FLOE_GITHUB_OAUTH_CLIENT_ID)</string>
	<key>FloeAPNsEnvironment</key>
	<string>$(FLOE_APNS_ENVIRONMENT)</string>
	<key>FloeIOSBridgeDownloadURL</key>
	<string>https://www.floe-agent.com/ios-bridge</string>
	<key>FloeMacBridgeDownloadURL</key>
	<string>https://www.floe-agent.com/bridge</string>
	<key>FloePushAppStoreURL</key>
	<string>https://apps.apple.com/app/id6801209053</string>
	<key>FloePushServiceBaseURL</key>
	<string>https://www.floe-agent.com/api/v1/push</string>
	<key>FloePushTestFlightURL</key>
	<string>https://testflight.apple.com/join/nz6qeT2J</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NFCReaderUsageDescription</key>
	<string>Floe reads a nearby NFC tag when you request a scan.</string>
	<key>NSAlarmKitUsageDescription</key>
	<string>Floe schedules the alarms and timers you create in the app.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSAppleMusicUsageDescription</key>
	<string>Floe finds and plays items from your media library when you request them.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Floe uses Bluetooth only when you ask it to connect to a nearby BLE serial device.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_airplay._tcp</string>
		<string>_afpovertcp._tcp</string>
		<string>_googlecast._tcp</string>
		<string>_hap._tcp</string>
		<string>_home-assistant._tcp</string>
		<string>_http._tcp</string>
		<string>_https._tcp</string>
		<string>_ipp._tcp</string>
		<string>_ipps._tcp</string>
		<string>_printer._tcp</string>
		<string>_raop._tcp</string>
		<string>_rfb._tcp</string>
		<string>_sftp-ssh._tcp</string>
		<string>_smb._tcp</string>
		<string>_uscan._tcp</string>
		<string>_workstation._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Floe accesses calendars only when you ask the agent to read or edit events.</string>
	<key>NSCameraUsageDescription</key>
	<string>Floe opens the camera when you capture an image or use measurement, magnifier, or scanning tools.</string>
	<key>NSContactsUsageDescription</key>
	<string>Floe reads the contacts you ask it to find.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Floe uses Face ID only to confirm when you enable unrestricted task access or unlock protected settings.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Floe reads the Health data you request after you authorize access.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Floe only reads the Health data you authorize; it does not save or modify Health data.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Floe accesses your Home only when you enable Home tools and request an automation action.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Floe discovers nearby devices only when you start a local-network check or ask the assistant to do so.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Floe uses your location when you open the location toolbox or request weather and nearby places. Wi-Fi diagnostics needs precise-location permission to show the connected network and access point. Running tasks may continue using approximate location in the background.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Floe uses the microphone when you dictate, record music or meetings, or start sound analysis.</string>
	<key>NSMotionUsageDescription</key>
	<string>Floe uses motion and pressure sensors when you open the corresponding instruments in the toolbox.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Floe saves generated or edited images only when you ask it to save them to Photos.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Floe accesses reminders only when you ask the agent to read or edit them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Floe converts your speech into text for the message composer.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
		<string>location</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Floe Note</string>
			<key>UTTypeIdentifier</key>
			<string>org.floeagent.note</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>floenote</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.floe.note</string>
			</dict>
		</dict>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Floe Canvas</string>
			<key>UTTypeIdentifier</key>
			<string>org.floeagent.canvas</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>floecanvas</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.floe.canvas</string>
			</dict>
		</dict>
	</array>
</dict>
</plist>
