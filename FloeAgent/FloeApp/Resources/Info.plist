<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>org.floeagent.ios.refresh</string>
		<string>org.floeagent.ios.processing</string>
		<string>org.floeagent.ios.continued.*</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Floe uses Bluetooth only when you ask it to connect to a nearby BLE serial device.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_home-assistant._tcp</string>
		<string>_http._tcp</string>
		<string>_printer._tcp</string>
		<string>_ipp._tcp</string>
		<string>_airplay._tcp</string>
		<string>_raop._tcp</string>
	</array>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Floe accesses calendars only when you ask the agent to read or edit events.</string>
	<key>NSCameraUsageDescription</key>
	<string>Floe opens the camera only when you choose to capture an image for a task.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Floe uses Face ID only to confirm when you enable unrestricted task access or unlock protected settings.</string>
	<key>NSHomeKitUsageDescription</key>
	<string>Floe accesses your Home only when you enable Home tools and request an automation action.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Floe scans your local network only when you ask the agent to discover nearby services and devices.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Floe uses your location only for a map or location task you request.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Floe uses the microphone only while you dictate a message.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Floe saves generated or edited images only when you ask it to save them to Photos.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Floe opens your photo library only when you choose an image for a task.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Floe accesses reminders only when you ask the agent to read or edit them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Floe converts your speech into text for the message composer.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
