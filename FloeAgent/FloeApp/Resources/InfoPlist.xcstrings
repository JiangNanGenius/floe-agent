{
  "sourceLanguage" : "en",
  "strings" : {
  "NSCameraUsageDescription": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe opens the camera when you capture an image or use measurement, magnifier, or scanning tools."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe 在你拍摄图片，或使用测量、放大镜与扫描工具时打开相机。"
        }
      }
    }
  },
  "NSMotionUsageDescription": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe uses motion and pressure sensors when you open the corresponding instruments in the toolbox."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe 在你打开工具箱中对应的仪表时使用运动与气压传感器。"
        }
      }
    }
  },
  "NSLocationWhenInUseUsageDescription": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe uses your location when you open the location toolbox or request weather and nearby places. Wi-Fi diagnostics needs precise-location permission to show the connected network and access point. Running tasks may continue using approximate location in the background."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe 在你打开定位工具或请求天气与附近地点时使用位置。Wi-Fi 诊断需要精确位置授权，才能显示当前网络与接入点。运行中的任务可能在后台继续使用大致位置。"
        }
      }
    }
  },
  "NSAlarmKitUsageDescription": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe schedules the alarms and timers you create in the app."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "Floe 为你创建系统闹钟和计时器。"
        }
      }
    }
  },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe reads the Health data you request after you authorize access."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 会在你授权后读取你请求的健康数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe only reads the Health data you authorize; it does not save or modify Health data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 仅会读取你授权的健康数据，不会写入或修改健康数据。"
          }
        }
      }
    },
    "NFCReaderUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe reads a nearby NFC tag when you request a scan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 会在你请求扫描时读取附近的 NFC 标签。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe reads the contacts you ask it to find."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 会读取你请求查找的联系人。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe finds and plays items from your media library when you request them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 会按你的要求查找和播放媒体库中的内容。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Floe uses the microphone when you dictate, record music or meetings, or start sound analysis." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Floe 在你进行语音输入、音乐或会议录音，以及启动声音分析时使用麦克风。" } }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Floe converts your speech into text for the message composer." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Floe 将你的语音转换为消息输入框中的文字。" } }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Floe uses Bluetooth only when you ask it to connect to a nearby BLE serial device." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Floe 仅在你请求连接附近的 BLE 串口设备时使用蓝牙。" } }
      }
    }
  },
  "version" : "1.0"
}
