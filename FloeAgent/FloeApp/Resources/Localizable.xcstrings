    "platform.background_run_coordinator.the_generation_result_was_saved_to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The generation result was saved to the asset library and will be restored on the canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成结果已保存到素材库，并会在画布中恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成結果已儲存到素材庫，並會在畫布中恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成結果はアセットライブラリに保存され、キャンバスに復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 결과가 자산 라이브러리에 저장되었으며 캔버스에 복원될 예정입니다."
          }
        },
        "fr": {
          "stringUnit": {
