    "app.bilingual.63b4df3bd2bc907e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置取样点后，涂抹需要修复的区域。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a sample point, then brush over the area to repair."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定取樣點後，塗抹需要修復的區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプルポイントを設定し、修復対象の領域をブラッシングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 포인트를 설정한 후, 해당 영역을 브러시로 칠하여 복구하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un point d'échantillon, puis brossez la zone à réparer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie einen Probenpunkt fest und streichen Sie dann zur Reparatur über den Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establezca un punto de muestra y, a continuación, repase el área para reparar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um ponto de amostra e, em seguida, passe a área para reparar."
          }
        }
      }
    },
    "app.bilingual.6bb42dec858ead1f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选中目标区域，再将它拖向合适的取样区域。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the target area, then drag it toward a suitable source area."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選中目標區域，再將它拖向合適的取樣區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象領域を選択し、適切なソース領域へドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 영역을 선택한 다음, 적절한 소스 영역으로 끌어다 놓으십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la zone cible, puis faites-la glisser vers une zone source appropriée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den Zielbereich aus, und ziehen Sie ihn dann in einen geeigneten Quellbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione el área de destino y luego arrástrela hacia un área de origen adecuada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione a área de destino e arraste-a para uma área de origem adequada."
          }
        }
      }
    },
