    "voice.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input stopped unexpectedly. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入意外停止，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音輸入意外停止，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力が予期せず停止しました。 もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력이 예기치 않게 중단되었습니다. 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée vocale s'est arrêtée de manière inattendue. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe wurde unerwartet gestoppt. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de voz se detuvo inesperadamente. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A entrada de voz parou inesperadamente. Tente novamente."
          }
        }
      }
    },
    "voice.file_speech_transcriber.apple_speech_recognition_timed_out_please": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple speech recognition timed out; please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 语音识别超时，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 語音識別超時，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleの音声認識がタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 음성 인식이 시간 초과되었습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale d'Apple a été dépassée ; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung von Apple ist abgezeigt. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz de Apple se acabaó; por favor, inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala da Apple tem tempo limite; tente novamente."
          }
        }
      }
    },
    "voice.file_speech_transcriber.could_not_read_the_asset_s": {
