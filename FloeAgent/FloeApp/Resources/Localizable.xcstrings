    "content.update.error.immutable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A published content version cannot change; publish a new version instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发布的内容版本不可更改；请发布新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已釋出的內容版本不可更改；請釋出新版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開されたコンテンツのバージョンは変更できません。代わりに新しいバージョンを公開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게시된 콘텐츠 버전은 변경할 수 없습니다; 대신 새 버전을 게시하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version de contenu publiée ne peut pas changer ; publiez une nouvelle version à la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine veröffentlichte Inhaltsversion kann nicht geändert werden; veröffentlichen Sie stattdessen eine neue Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión de contenido publicada no puede cambiar; publique una nueva versión en su lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão de conteúdo publicada não pode ser alterada; publique uma nova versão em vez disso."
          }
        }
      }
    },
    "content.update.error.incompatible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update Floe before activating this content version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
