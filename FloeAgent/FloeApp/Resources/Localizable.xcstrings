    "cad.mechanical.saveFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The part changed but could not be saved. Try saving again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零件已修改，但保存失败。请再次保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "零件已修改，但儲存失敗。請再次儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "部品が変更されましたが、保存できませんでした。 もう一度保存してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부품이 변경되었지만 저장할 수 없습니다. 다시 저장해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pièce a changé mais n'a pas pu être sauvegardée. Essayez à nouveau d'enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Teil hat sich geändert, konnte aber nicht gespeichert werden. Versuchen Sie erneut zu speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pieza cambió, pero no se pudo guardar. Intenta guardar de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A peça mudou, mas não pôde ser salva. Tente salvar novamente."
          }
        }
      }
    },
    "cad.mechanical.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One straight bend, square-cut stock or a 20° external spur gear. Multiple bends, miters and other gear types are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持单次直线折弯、直切型材或 20° 外啮合直齿轮。暂不支持多折弯、斜切和其他齿轮类型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援單次直線折彎、直切型材或 20° 外齧合直齒輪。暫不支援多折彎、斜切和其他齒輪型別。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一本の直線曲げ、四角形カットのストック、または20°の外部スパーギア。 複数のベンド、マイター、その他のギアタイプはご利用いただけません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직선 굽힘 하나, 사각형 절단 스톡 또는 20° 외부 스퍼 기어. 다중 굽힘, 마이터 및 기타 장비 유형은 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coude droit, une crosse de coupe carrée ou un engrenage droit externe à 20°. Plusieurs virages, onglets et autres types d'engrenages ne sont pas disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine gerade Biegung, ein quadratischer Schaft oder ein 20°-Außenspornrad. Mehrere Biegungen, Gehrungen und andere Ausrüstungstypen sind nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una curva recta, una culata de corte cuadrado o un engranaje de espuje externo de 20°. Múltiples curvas, ingletes y otros tipos de engranajes no están disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma curva reta, estoque de corte quadrado ou uma engrenagem de espora externa de 20°. Várias curvas, esquadrias e outros tipos de engrenagens não estão disponíveis."
          }
        }
      }
    },
