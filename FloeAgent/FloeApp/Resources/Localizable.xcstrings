    "skills.authoring.advisory.body": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议转为任务，稍后在任务中心查看进展。你也可以留在这里继续等待。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move it to a task and check progress later in Task Center, or stay here and keep waiting."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建議轉為任務，稍後在任務中心檢視進展。你也可以留在這裡繼續等待。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクに移動して、後でタスクセンターで進捗を確認するか、ここにとどまって待ち続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업으로 이동하고 작업 센터에서 진행 상황을 나중에 확인하거나, 여기 머무르며 계속 기다리세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez-le vers une tâche et vérifiez la progression plus tard dans le centre des tâches, ou restez ici et continuez à attendre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie es in eine Aufgabe und überprüfen Sie den Fortschritt später im Task Center, oder bleiben Sie hier und warten Sie weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muévalo a una tarea y compruebe el progreso más tarde en el Centro de tareas, o quédese aquí y siga esperando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova-o para uma tarefa e verifique o progresso mais tarde no Centro de Tarefas, ou fique aqui e continue esperando."
          }
        }
      }
    },
