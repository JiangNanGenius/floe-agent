        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你第一次說話時，Floe 才會請求麥克風許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floeは、最初に話すときにのみマイクへのアクセスを求めます。"
