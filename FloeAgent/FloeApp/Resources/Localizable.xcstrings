    "app.bilingual.c29742bcb28f8864": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处是 workflow_dispatch 摘要；仓库、分支、工作流与快照在上方确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the workflow_dispatch summary; confirm repository, branch, workflow and snapshot above."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處是 workflow_dispatch 摘要；倉庫、分支、工作流與快照在上方確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは workflow_dispatch のサマリーです。上記のリポジトリ、ブランチ、ワークフロー、およびスナップショットをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 workflow_dispatch 요약이며, 위의 저장소, 브랜치, 워크플로 및 스냅샷을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est le résumé de workflow_dispatch ; confirmez le référentiel, la branche, le flux de travail et l'instantané ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die Zusammenfassung von workflow_dispatch; bestätigen Sie das Repository, den Zweig, den Workflow und den Snapshot oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es el resumen de workflow_dispatch; confirme el repositorio, la rama, el flujo de trabajo y la instantánea arriba."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o resumo do workflow_dispatch; confirme o repositório, a ramificação, o fluxo de trabalho e o instantâneo acima."
          }
        }
      }
    },
    "app.bilingual.949f34c6db4fba2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个参数单独加引号，绝不拼接原始字符串。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every argument is quoted individually; raw strings are never concatenated."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個引數單獨加引號，絕不拼接原始字串。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての引数は個別に引用されます；生文字列は決して連結されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 인수는 개별적으로 인용되며, 원시 문자열은 절대 연결되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque argument est cité individuellement ; les chaînes brutes ne sont jamais concaténées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Argument wird einzeln zitiert; Rohzeichenfolgen werden niemals verkettet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada argumento se cita individualmente; las cadenas sin procesar nunca se concatenan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada argumento é citado individualmente; strings brutas nunca são concatenadas."
          }
        }
      }
    },
