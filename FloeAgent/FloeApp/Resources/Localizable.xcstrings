    "app.bilingual.badb80159870bcfa": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件已改变，请重新打开后准备打印。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed. Reopen it before preparing a print."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案已改變，請重新開啟後準備列印。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースが変更されました。 印刷を準備する前に、再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스가 변경되었습니다. 인쇄를 준비하기 전에 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source a changé. Rouvrez-le avant de préparer une impression."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle hat sich geändert. Öffnen Sie es erneut, bevor Sie einen Druck vorbereiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente cambió. Vuelve a abrirlo antes de preparar una impresión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte mudou. Reabra-o antes de preparar uma impressão."
          }
        }
      }
    },
