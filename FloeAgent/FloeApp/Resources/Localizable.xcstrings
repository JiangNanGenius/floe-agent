    "localmodels.apple_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Availability of the Apple system model depends on your device, system settings and model readiness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系统模型的可用性取决于设备、系统设置与模型准备状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系統模型的可用性取決於裝置、系統設定與模型準備狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple のシステムモデルの利用可能性は、お使いのデバイス、システム設定、およびモデルの準備状況に依存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 시스템 모델의 가용성은 귀하의 기기, 시스템 설정 및 모델 준비 상태에 따라 달라집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilité du modèle de système Apple dépend de votre appareil, des paramètres du système et de l'état de préparation du modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verfügbarkeit des Apple-Systemmodells hängt von Ihrem Gerät, den Systemeinstellungen und der Modellbereitschaft ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilidad del modelo de sistema Apple depende de su dispositivo, la configuración del sistema y la preparación del modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A disponibilidade do modelo do sistema Apple depende do seu dispositivo, das configurações do sistema e da prontidão do modelo."
          }
        }
      }
    },
    "localmodels.apple_foundation_model_runtime.could_not_read_image_choose_another": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read image %@; choose another file and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取第 %@ 张图片，请更换文件后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取第 %@ 張圖片，請更換檔案後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像 %@ を読み取ることができませんでした。別のファイルを選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 %@를 읽을 수 없습니다; 다른 파일을 선택하고 다시 시도하십시오"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l'image %@ ; choisissez un autre fichier et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild %@ konnte nicht gelesen werden; wählen Sie eine andere Datei und versuchen Sie es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la imagen %@; elija otro archivo e inténtelo de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a imagem %@; escolha outro arquivo e tente novamente"
          }
        }
      }
    },
    "localmodels.apple_foundation_model_runtime.image_exceeds_24_mb_compress_it": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
