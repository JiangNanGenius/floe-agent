    "app.bilingual.1be72af8382e70b8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除远端记录只清除本服务拥有的任务与结果存储，不承诺撤销已产生的费用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting removes only this service's own remote job and stored results. It does not claim to revoke charges already incurred."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除遠端記錄只清除本服務擁有的任務與結果儲存，不承諾撤銷已產生的費用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると、このサービスのリモートジョブと保存された結果のみが削除されます。 それは、すでに発生した料金を取り消すと主張していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 이 서비스 자체의 원격 작업과 저장된 결과만 제거됩니다. 이미 발생한 비용을 취소한다고 주장하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression ne supprime que le travail à distance de ce service et les résultats stockés. Il ne prétend pas révoquer les frais déjà encourus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen entfernt nur den eigenen Remote-Job und die gespeicherten Ergebnisse dieses Dienstes. Es erhebt keinen Anspruch, bereits angefallene Gebühren zu widerrufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación elimina solo el propio trabajo remoto de este servicio y los resultados almacenados. No pretende revocar los cargos ya incurridos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão remove apenas o próprio trabalho remoto deste serviço e os resultados armazenados. Não pretende revogar as cobranças já incorridas."
          }
        }
      }
    },
