        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업의 결과는 알 수 없습니다. 이 작업을 이동하기 전에 원래 환경을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat d'une opération est inconnu. Vérifiez l'environnement d'origine avant de déplacer cette tâche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis einer Operation ist unbekannt. Überprüfen Sie die ursprüngliche Umgebung, bevor Sie diese Aufgabe verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconoce el resultado de una operación. Comprueba el entorno original antes de mover esta tarea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado de uma operação é desconhecido. Verifique o ambiente original antes de mover esta tarefa."
          }
        }
      }
    },
    "app.bilingual.ee794d89e7d2946c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖准备未完成，请检查目标上的工具、网络和安装权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependencies are not ready. Check tools, connectivity and installation permissions on the target."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依賴準備未完成，請檢查目標上的工具、網路和安裝許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存関係はまだ準備ができていません。 対象でツール、接続性、インストール権限を確認してください。"
