      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次执行已中断，可从保留的进度继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execution was interrupted. Continue from the saved progress."
          }
        },
        "zh-Hant": {
