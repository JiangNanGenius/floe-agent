    "app.bilingual.c5df58ca47143483": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上选择元件、总线或导线以编辑属性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a component, bus or wire on the canvas to edit its properties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布上選擇元件、匯流排或導線以編輯屬性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス上のコンポーネント、バス、またはワイヤを選択して、そのプロパティを編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에서 구성 요소, 버스 또는 와이어를 선택하여 해당 속성을 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un composant, un bus ou un fil sur le canevas pour modifier ses propriétés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Komponente, einen Bus oder einen Draht auf der Leinwand aus, um ihre Eigenschaften zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un componente, bus o cable en el lienzo para editar sus propiedades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um componente, barramento ou fio na tela para editar suas propriedades."
          }
        }
      }
    },
