    "cad.overlay.footer.exchange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP, IGES, GLB, USDZ, OBJ, STL and 3MF store model geometry only; they don't include view cuts or guides."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP、IGES、GLB、USDZ 和 OBJ 仅保存模型几何，不包含视图剖切或引导线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP、IGES、GLB、USDZ 和 OBJ 僅儲存模型幾何，不包含檢視剖切或引導線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP、IGES、GLB、USDZ、OBJ、STL、および3MFはモデルジオメトリのみを保存します。ビューのカットやガイドは含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP, IGES, GLB, USDZ, OBJ, STL 및 3MF는 모델 기하학만 저장하며, 뷰 컷이나 가이드를 포함하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP, IGES, GLB, USDZ, OBJ, STL et 3MF stockent uniquement la géométrie du modèle ; ils n'incluent pas de coupes de vue ou de guides."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur STEP-, IGES-, GLB-, USDZ-, OBJ-, STL- und 3MF-Speichermodellgeometrie; sie enthalten keine Ansichtsschnitte oder -führungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP, IGES, GLB, USDZ, OBJ, STL y 3MF almacenan solo la geometría del modelo; no incluyen cortes de vista ni guías."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "STEP, IGES, GLB, USDZ, OBJ, STL e 3MF armazenam apenas geometria de modelos; eles não incluem cortes de visualização ou guias."
          }
        }
      }
    },
