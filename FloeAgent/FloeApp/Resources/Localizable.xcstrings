    "exec.notifications.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed, failed, cancelled and approval-waiting tasks are kept as events. They queue while notification permission is not ready and are never dropped. Tapping a notification opens the related task or environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成、失败、取消和等待审批都会保存为事件；通知未授权时排队，不会丢失。点击通知可打开对应任务或环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成、失敗、取消和等待審批都會儲存為事件；通知未授權時排隊，不會丟失。點選通知可開啟對應任務或環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了、失敗、キャンセル、承認待ちのタスクはイベントとして保持されます。 通知権限が準備されていない間はキューイングされ、決してドロップされません。 通知をタップすると、関連するタスクまたは環境が開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된, 실패한, 취소된 작업 및 승인 대기 중인 작업은 이벤트로 유지됩니다. 그들은 알림 권한이 준비되지 않은 동안 대기열에 서며 절대 삭제되지 않습니다. 알림을 탭하면 관련 작업 또는 환경이 열립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches terminées, échouées, annulées et en attente d'approbation sont conservées en tant qu'événements. Ils font la queue alors que l'autorisation de notification n'est pas prête et ne sont jamais abandonnés. Appuyez sur une notification pour ouvrir la tâche ou l'environnement associé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene, fehlgeschlagene, abgebrochene und auf Genehmigung wartende Aufgaben werden als Ereignisse gespeichert. Sie stellen sich in die Warteschlange, während die Benachrichtigungsberechtigung noch nicht bereit ist, und werden nie gelöscht. Das Tippen auf eine Benachrichtigung öffnet die entsprechende Aufgabe oder Umgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas completadas, fallidas, canceladas y pendientes de aprobación se mantienen como eventos. Hacen cola mientras el permiso de notificación no está listo y nunca se eliminan. Al tocar una notificación se abre la tarea o el entorno relacionado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarefas concluídas, com falha, canceladas e aguardando aprovação são mantidas como eventos. Eles fazem fila enquanto a permissão de notificação não está pronta e nunca são descartadas. Tocar em uma notificação abre a tarefa ou o ambiente relacionado."
          }
        }
      }
    },
