    "workspace.workspace_center.some_task_files_are_not_cleaned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some task files are not cleaned up yet; this will be retried on next launch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分任务文件尚未清理，将在下次启动时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分任務檔案尚未清理，將在下次啟動時重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のタスクファイルはまだクリーンアップされていません。次回の起動時に再実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 작업 파일이 아직 정리되지 않았으며, 다음 실행 시 다시 시도될 예정입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers de tâches ne sont pas encore nettoyés ; cela sera réessayé lors du prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Aufgabendateien sind noch nicht bereinigt; dies wird beim nächsten Start erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos de tareas aún no se han limpiado; esto se volverá a intentar en el próximo lanzamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos de tarefas ainda não foram limpos; isso será tentado novamente no próximo lançamento."
          }
        }
      }
    },
    "workspace.workspace_picker_view.only_the_workspace_record_in_floe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the workspace record in Floe is removed; the folder you chose and its files are not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会移除 Floe 中的工作区记录，不会删除您选择的文件夹或其中的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除 Floe 中的工作區記錄，不會刪除您選擇的資料夾或其中的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe のワークスペースレコードのみが削除されます。選択したフォルダーとそのファイルは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe의 작업 공간 레코드만 삭제되며, 선택한 폴더와 해당 파일은 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l'enregistrement de l'espace de travail dans Floe est supprimé ; le dossier que vous avez choisi et ses fichiers ne sont pas supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Arbeitsbereichsdatensatz in Floe wird entfernt; der Ordner, den Sie ausgewählt haben, und seine Dateien werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el registro del espacio de trabajo en Floe; la carpeta que eligió y sus archivos no se eliminan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o registro do espaço de trabalho no Floe é removido; a pasta que você escolheu e seus arquivos não são excluídos."
          }
        }
      }
    },
