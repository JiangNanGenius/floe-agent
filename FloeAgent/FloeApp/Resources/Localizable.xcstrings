        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사람이 이 디자인을 변경했습니다. 결정하기 전에 비교하기 위해 다시 로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un d'autre a changé ce design. Rechargez pour comparer avant de décider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand anderes hat dieses Design geändert. Neu laden, um zu vergleichen, bevor Sie sich entscheiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien más cambió este diseño. Vuelva a cargar para comparar antes de decidir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
