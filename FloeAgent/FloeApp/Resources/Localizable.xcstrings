    "app.bilingual.d22acc0c231ae16f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一个项目中整理序列、结构、图像、矩阵和模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep sequences, structures, images, matrices and models together in one project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同一個專案中整理序列、結構、影象、矩陣和模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シーケンス、構造、画像、マトリックス、モデルを1つのプロジェクトにまとめて保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시퀀스, 구조체, 이미지, 행렬 및 모델을 하나의 프로젝트에 함께 보관하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les séquences, les structures, les images, les matrices et les modèles ensemble dans un seul projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
