    "app.bilingual.6cbdd13cb58ca3d1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深度沿刀轴反向；U 与刀轴需单位正交，V 由叉积确定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depth is opposite the tool axis. U and the tool axis must be unit and perpendicular; V is their cross product."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深度沿刀軸反向；U 與刀軸需單位正交，V 由叉積確定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "深さはツール軸の反対側にあります。 U とツール軸は単位であり、垂直でなければなりません；V はそれらのクロス積です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊이는 도구 축과 반대쪽에 있습니다. U와 공구축은 단위이며 수직이어야 합니다; V는 그들의 십단곱입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La profondeur est opposée à l'axe de l'outil. U et l'axe de l'outil doivent être unitaires et perpendiculaires ; V est leur produit croisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tiefe ist gegenüber der Werkzeugachse. U und die Werkzeugachse müssen einheitlich und senkrecht sein; V ist ihr Querprodukt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La profundidad está opuesta al eje de la herramienta. La U y el eje de la herramienta deben ser unitarios y perpendiculares; V es su producto cruzado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A profundidade é oposta ao eixo da ferramenta. U e o eixo da ferramenta devem ser unitários e perpendiculares; V é seu produto cruzado."
          }
        }
      }
    },
