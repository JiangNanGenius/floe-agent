    "app.bilingual.f419256b1e202049": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算后可查看主轴、卡盘、工件和刀具的命令回放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculate to replay commanded spindle, chuck, workpiece and tool poses."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算後可檢視主軸、卡盤、工件和刀具的命令回放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドされたスピンドル、チャック、ワークピース、ツールのポーズを再実行するために計算してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령된 스핀들, 척, 작업물 및 공구 자세를 재생하도록 계산하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez pour rejouer les poses de broche, de mandrin, de pièce à usiner et d'outil commandées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnen Sie, um Befehlspindel-, Chuck-, Werkstück- und Werkzeugposen wiederzuspielen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule para reproducir las posturas de husillo, mandil, pieza de trabajo y herramienta comandadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule para reproduzir as poses comandadas de fuso, mandril, peça de trabalho e ferramenta."
          }
        }
      }
    },
    "app.bilingual.862ea37b41701fa0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "驱动估算使用显式惯量、转矩、功率和负载，与三维命令回放分别计算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drive estimates use explicit inertia, torque, power and load, separately from 3D commanded replay."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驅動估算使用顯式慣量、轉矩、功率和負載，與三維命令回放分別計算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駆動推定は、3Dコマンドリプレイとは別に、明示的な慣性、トルク、出力、負荷を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구동 추정은 3D 명령 재생과는 별도로 명시적인 관성, 토크, 전력 및 부하를 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les estimations d'entraînement utilisent l'inertie, le couple, la puissance et la charge explicites, séparément de la relecture commandée en 3D."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antriebsschätzungen verwenden explizite Trägheit, Drehmoment, Leistung und Last, getrennt von der 3D-Befehlswiederholung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las estimaciones de la unidad utilizan inercia, par, potencia y carga explícitas, por separado de la reproducción ordenada en 3D."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As estimativas de unidade usam inércia, torque, potência e carga explícitas, separadamente da repetição comandada em 3D."
          }
        }
      }
    },
