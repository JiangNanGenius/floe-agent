    "design.page.preview.decode_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image could not be decoded (unsupported format or source too large). No resized substitute is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像无法解码（格式不受支持或源过大）。不会用缩放替代图冒充预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影象無法解碼（格式不受支援或源過大）。不會用縮放替代圖冒充預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をデコードできませんでした（サポートされていない形式、またはソースが大きすぎます）。 サイズ変更された代替品は表示されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 디코딩할 수 없습니다(지원되지 않는 형식이거나 소스가 너무 큽니다). 크기가 조정된 대체품이 표시되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image n'a pas pu être décodée (format non pris en charge ou source trop grande). Aucun substitut redimensionné n'est affiché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild konnte nicht entschlüsselt werden (nicht unterstütztes Format oder Quelle zu groß). Es wird kein Ersatz in der Größe geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo decodificar la imagen (formato no compatible o fuente demasiado grande). No se muestra un sustituto de tamaño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem não pôde ser decodificada (formato não suportado ou fonte muito grande). Nenhum substituto redimensionado é mostrado."
          }
        }
      }
    },
