    "edit.conflict.manualHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the combined result if needed. Changing a conflict choice resets these manual edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可继续编辑合并结果；重新选择冲突项会重置这里的手动修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可繼續編輯合併結果；重新選擇衝突項會重置這裡的手動修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じて、結合結果を編集してください。 競合選択を変更すると、これらの手動編集がリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 경우 결합된 결과를 편집하십시오. 충돌 선택을 변경하면 이러한 수동 편집이 초기화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le résultat combiné si nécessaire. La modification d'un choix de conflit réinitialise ces modifications manuelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie bei Bedarf das kombinierte Ergebnis. Wenn Sie eine Konfliktauswahl ändern, werden diese manuellen Änderungen zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite el resultado combinado si es necesario. Cambiar una opción de conflicto restablece estas ediciones manuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite o resultado combinado, se necessário. Alterar uma escolha de conflito redefine essas edições manuais."
          }
        }
      }
    },
    "edit.conflict.mine": {
