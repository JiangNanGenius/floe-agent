    "app.bilingual.e977bf4cb585afd1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从周围画面匹配纹理。较大区域可分几次处理，原始内容可通过撤销恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match texture from the surrounding image. Fill larger areas in stages; undo restores the original content."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從周圍畫面匹配紋理。較大區域可分幾次處理，原始內容可透過撤銷恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の画像からテクスチャをマッチさせてください。 大きな領域を段階的に塗りつぶしてください。元に戻すと元の内容が復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 이미지의 텍스처를 일치시키십시오. 큰 영역을 단계별로 채우십시오; 되돌리면 원본 내용이 복원됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites correspondre la texture de l'image environnante. Remplissez de plus grandes zones par étapes ; annuler pour restaurer le contenu original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie die Textur des umgebenden Bildes zu. Füllen Sie größere Bereiche in Stufen aus; Rückgängig wird der ursprüngliche Inhalt wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincidir con la textura de la imagen circundante. Rellenar áreas más grandes en etapas; deshacer restaura el contenido original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combine a textura da imagem ao redor. Preencha áreas maiores em etapas; desfazer restaura o conteúdo original."
          }
        }
      }
    },
