    "providers.auxiliary_models_view.before_installing_a_python_package_floe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before installing a Python package, Floe confirms it is genuinely needed by the current task. Packages that need extra system permissions or are unsuitable to run locally are still blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装 Python 包前，会确认它确实用于当前任务。需要额外系统权限或不适合本机运行的包仍会被阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝 Python 包前，會確認它確實用於當前任務。需要額外系統許可權或不適合本機執行的包仍會被阻止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Python パッケージをインストールする前に、Floe は現在のタスクに本当に必要であることを確認します。 追加のシステム権限が必要なパッケージや、ローカルで実行できないパッケージは、依然としてブロックされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 패키지를 설치하기 전에, Floe는 현재 작업에 실제로 필요함을 확인합니다. 추가 시스템 권한이 필요하거나 로컬에서 실행하기에 부적합한 패키지는 여전히 차단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant d'installer un paquet Python, Floe confirme qu'il est vraiment nécessaire par la tâche actuelle. Les paquets qui ont besoin d'autorisations système supplémentaires ou qui ne sont pas adaptés à l'exécution locale sont toujours bloqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Installation eines Python-Pakets bestätigt Floe, dass es von der aktuellen Aufgabe wirklich benötigt wird. Pakete, die zusätzliche Systemberechtigungen benötigen oder nicht für die lokale Ausführung geeignet sind, sind weiterhin blockiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de instalar un paquete Python, Floe confirma que es realmente necesario para la tarea actual. Los paquetes que necesitan permisos adicionales del sistema o que no son adecuados para ejecutarse localmente todavía están bloqueados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de instalar um pacote Python, o Floe confirma que ele é realmente necessário para a tarefa atual. Pacotes que precisam de permissões de sistema adicionais ou não são adequados para execução local ainda estão bloqueados."
          }
        }
      }
    },
