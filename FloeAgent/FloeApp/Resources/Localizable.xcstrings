      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote run ended (exit code %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程运行已结束（退出码 %@）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端執行已結束（退出碼 %@）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート実行が終了しました（終了コード %@）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 실행이 종료되었습니다 (출고 코드 %@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution à distance s'est terminée (code de sortie %@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote-Lauf wurde beendet (Aus-Code %@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución remota terminó (código de salida %@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução remota terminou (código de saída %@)"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_remote_run_timed_out_and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote run timed out and the SSH connection was closed; the remote process exit and cleanup trap are not confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程运行超时，已断开 SSH 连接；无法确认远端进程是否退出或清理陷阱是否运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端執行超時，已斷開 SSH 連線；無法確認遠端程序是否退出或清理陷阱是否執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート実行がタイムアウトし、SSH 接続が閉じられました；リモートプロセスの終了およびクリーンアップトラップは確認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 실행이 시간 초과되었으며 SSH 연결이 종료되었습니다; 원격 프로세스 종료 및 정리 트랩이 확인되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution à distance a expiré et la connexion SSH a été fermée ; la sortie du processus à distance et le piège de nettoyage ne sont pas confirmés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Remote-Ausführung ist abgelaufen und die SSH-Verbindung wurde geschlossen; der Remote-Prozessausgang und die Bereinigungsfalle sind nicht bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución remota se acagó y la conexión SSH se cerró; la salida del proceso remoto y la trampa de limpieza no están confirmadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução remota expirou e a conexão SSH foi fechada; a saída do processo remoto e a armadilha de limpeza não estão confirmadas."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_remote_staging_directory_holds_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote staging directory holds data this run does not own; nothing was overwritten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远端暂存目录存在不属于本次运行的数据，已停止且未覆盖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端暫存目錄存在不屬於本次執行的資料，已停止且未覆蓋"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートステージングディレクトリには、この実行が所有していないデータが格納されています。何も上書きされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 스테이징 디렉터리는 이 실행이 소유하지 않은 데이터를 보유하고 있으며, 아무것도 덮어쓰지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire de mise en scène à distance contient les données que cette exécution ne possède pas ; rien n'a été écrasé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Remote-Staging-Verzeichnis enthält Daten, die dieser Lauf nicht besitzt; nichts wurde überschrieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio de ensayo remoto contiene datos que esta ejecución no posee; nada fue sobrescrito"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório de teste remoto contém dados que esta execução não possui; nada foi substituído"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_run_scheduling_path_does_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The run scheduling path does not yet accept guest-shape requests, so %@ cores cannot be handed to the launch flow; rejected before launch and never silently runs as 1 core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行调度路径尚未接入客户机形状请求，当前无法把 %@ 核交给启动流程；已在启动前拒绝，不会以 1 核静默运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行排程路徑尚未接入客戶機形狀請求，當前無法把 %@ 核交給啟動流程；已在啟動前拒絕，不會以 1 核靜默執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行スケジューリングパスはまだゲストシェイプのリクエストを受け付けておらず、そのため %@ コアは起動フローに渡すことができません。起動前に拒否され、1 コアとして静かに実行されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런 스케줄링 경로는 아직 게스트 쉐이프 요청을 수락하지 않으므로 %@ 코어는 런치 흐름에 전달될 수 없으며, 런치 전에 거부되고 1코어로 조용히 실행되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin de planification d'exécution n'accepte pas encore les demandes de forme d'invité, de sorte que les cœurs %@ ne peuvent pas être remis au flux de lancement ; rejetés avant le lancement et ne s'exécutent jamais silencieusement comme 1 cœur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Run-Planungspfad akzeptiert noch keine Gast-Shape-Anforderungen, so dass %@-Kerne nicht an den Startablauf übergeben werden können; vor dem Start abgelehnt und nie stillschweigend als 1 Kern ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta de programación de ejecución aún no acepta solicitudes de forma de invitado, por lo que los núcleos %@ no se pueden entregar al flujo de lanzamiento; rechazado antes del lanzamiento y nunca se ejecuta silenciosamente como 1 núcleo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho de agendamento de execução ainda não aceita solicitações de forma de convidado, portanto, os núcleos %@ não podem ser entregues ao fluxo de lançamento; rejeitado antes do lançamento e nunca é executado silenciosamente como 1 núcleo."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_runtime_is_not_installed_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ runtime is not installed on this device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机未安装 %@ 运行时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機未安裝 %@ 執行時"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ランタイムはこのデバイスにインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 런타임이 이 장치에 설치되어 있지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime %@ n'est pas installé sur cet appareil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %@-Laufzeit ist auf diesem Gerät nicht installiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de ejecución %@ no está instalado en este dispositivo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de execução do %@ não está instalado neste dispositivo"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_selected_guest_core_count_cannot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected guest core count cannot be delivered; the run was blocked before any guest start (an explicit dual-core request is never silently run on one hart)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选的客户机内核数无法交付，已在启动前阻止运行（不会以 1 核静默替代 2 核）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選的客戶機核心數無法交付，已在啟動前阻止執行（不會以 1 核靜默替代 2 核）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたゲストコア数は配信できません；実行はゲスト開始前にブロックされました（明示的なデュアルコアリクエストは1つのハートでサイレントに実行されることは決してありません）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 게스트 코어 수를 전달할 수 없습니다; 실행은 어떤 게스트 시작 전에 차단되었습니다(명시적인 듀얼 코어 요청은 하나의 하트에서 조용히 실행되지 않습니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de cœurs d'invités sélectionné ne peut pas être livré ; l'exécution a été bloquée avant tout début d'invité (une demande bicœur explicite n'est jamais exécutée silencieusement sur un cœur)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Anzahl der Gäste kann nicht geliefert werden; der Lauf wurde vor jedem Gaststart blockiert (eine explizite Dual-Core-Anfrage wird niemals stillschweigend auf einem Herz ausgeführt)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recuento de núcleos de invitados seleccionado no se puede entregar; la ejecución se bloqueó antes de que cualquier inicio de invitado (una solicitud explícita de doble núcleo nunca se ejecuta silenciosamente en un corazón)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem de núcleos do convidado selecionado não pode ser entregue; a execução foi bloqueada antes de qualquer início de convidado (uma solicitação explícita de núcleo duplo nunca é executada silenciosamente em um cervo)"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_staged_file_is_not_visible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The staged file is not visible at the host's default cloud-workspace root (the host may use a custom root); the run was not executed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂存文件在主机默认云工作区根目录不可见（主机可能自定义了根目录），未执行运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫存檔案在主機預設雲工作區根目錄不可見（主機可能自定義了根目錄），未執行執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステージされたファイルはホストのデフォルトの cloud-workspace ルートで表示されません（ホストはカスタムルートを使用する場合があります）；実行は実行されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이징된 파일이 호스트의 기본 클라우드 워크스페이스 루트에 표시되지 않으며(호스트는 사용자 지정 루트를 사용할 수 있습니다); 실행이 실행되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier mis en scène n'est pas visible à la racine de l'espace de travail cloud par défaut de l'hôte (l'hôte peut utiliser une racine personnalisée) ; l'exécution n'a pas été exécutée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die staged-Datei ist im Standard-Cloud-Workspace-Root des Hosts nicht sichtbar (der Host kann ein benutzerdefiniertes Root verwenden); der Lauf wurde nicht ausgeführt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo escenificado no es visible en la raíz predeterminada del espacio de trabajo en la nube del host (el host puede usar una raíz personalizada); la ejecución no se ejecutó"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo encenado não está visível na raiz padrão do espaço de trabalho em nuvem do host (o host pode usar uma raiz personalizada); a execução não foi executada"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_workflow_path_is_invalid_it": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workflow path is invalid; it must be a YAML file under .github/workflows"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流路径无效，必须位于 .github/workflows 下的 YAML 文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作流路徑無效，必須位於 .github/workflows 下的 YAML 檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローのパスが無効です。.github/workflows の下にある YAML ファイルである必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로 경로가 유효하지 않습니다; .github/workflows 아래의 YAML 파일이어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin du flux de travail n'est pas valide ; il doit s'agir d'un fichier YAML sous .github/workflows"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Workflow-Pfad ist ungültig; es muss eine YAML-Datei unter .github/workflows sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta del flujo de trabajo no es válida; debe ser un archivo YAML en .github/workflows"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho do fluxo de trabalho é inválido; deve ser um arquivo YAML em .github/workflows"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_workflow_was_dispatched_but_no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workflow was dispatched but no unique run is associated yet; Floe will not resubmit and keeps checking by snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已触发工作流，但尚未唯一关联到本次快照；不会重复提交，将按快照继续核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已觸發工作流，但尚未唯一關聯到本次快照；不會重複提交，將按快照繼續核對。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークフローはディスパッチされましたが、まだユニークな実行は関連付けられていません；Floe は再送信せず、スナップショットでチェックし続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크플로가 발송되었지만 아직 고유 실행이 연결되지 않았습니다; Floe는 재제출하지 않으며 스냅샷으로 계속 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de travail a été expédié, mais aucune exécution unique n'est encore associée ; Floe ne soumet pas à nouveau et continue de vérifier par instantané."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Workflow wurde gesendet, aber es ist noch kein eindeutiger Lauf zugeordnet; Floe wird nicht erneut gesendet und überprüft weiterhin per Snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de trabajo se envió, pero aún no se ha asociado ninguna ejecución única; Floe no vuelve a enviar y sigue comprobando por instantánea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo de trabalho foi despachado, mas nenhuma execução exclusiva está associada ainda; Floe não reenviará e continua verificando por instantâneo."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_workspace_changed_this_run_was": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace changed; this run was blocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作区已更改，已阻止本次运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作區已更改，已阻止本次執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースが変更されました。この実行はブロックされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간이 변경되었습니다; 이 실행이 차단되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de travail a changé ; cette exécution a été bloquée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich hat sich geändert; dieser Lauf wurde blockiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo cambió; esta ejecución fue bloqueada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho mudou; esta execução foi bloqueada"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.this_build_delivers_at_most_guest": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build delivers at most %@ guest cores; %@ cores are outside this build's core ladder. The request is rejected before selection and never silently runs as 1 core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本最多交付 %@ 个客户机内核，%@ 核不在此版本的内核阶梯内。选择前即被拒绝，不会以 1 核静默运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本最多交付 %@ 個客戶機核心，%@ 核不在此版本的核心階梯內。選擇前即被拒絕，不會以 1 核靜默執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドは最大で%@ゲストコアを提供します；%@コアはこのビルドのコアラダー外にあります。 リクエストは選択前に拒否され、決して1コアとして静かに実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드는 최대 %@ 게스트 코어만 제공하며, %@ 코어는 이 빌드의 코어 사다리를 벗어난다. 요청이 선택되기 전에 거부되며 1코어로 조용히 실행되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette construction fournit au plus des cœurs invités %@ ; les noyaux %@ sont en dehors de l'échelle de base de cette construction. La demande est rejetée avant la sélection et ne s'exécute jamais silencieusement comme 1 cœur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build liefert höchstens %@-Gastkerne; %@-Kerne liegen außerhalb der Kernleiter dieses Builds. Die Anforderung wird vor der Auswahl abgelehnt und wird nie stillschweigend als 1 Kern ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación ofrece como máximo núcleos invitados %@; los núcleos %@ están fuera de la escalera central de esta compilación. La solicitud se rechaza antes de la selección y nunca se ejecuta silenciosamente como 1 núcleo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação oferece no máximo núcleos de convidados %@; os núcleos %@ estão fora da escada do núcleo desta compilação. A solicitação é rejeitada antes da seleção e nunca é executada silenciosamente como 1 núcleo."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.this_run_could_not_confirm_cleanup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run could not confirm cleanup of the remote staging directory: %@. It may remain and can be deleted manually; data not belonging to this run is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次运行未确认已清理远端暂存目录：%@。该目录可能残留，可手动删除；不会删除不属于本次运行的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次執行未確認已清理遠端暫存目錄：%@。該目錄可能殘留，可手動刪除；不會刪除不屬於本次執行的資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行では、リモートステージングディレクトリ %@ のクリーンアップを確認できませんでした。 それは保持でき、手動で削除できます；この実行に属さないデータは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행으로는 원격 스테이징 디렉터리인 %@의 정리를 확인할 수 없습니다. 해당 항목은 남아 있을 수 있으며 수동으로 삭제할 수 있습니다; 이 실행에 속하지 않는 데이터는 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette exécution n'a pas pu confirmer le nettoyage du répertoire de mise en scène à distance : %@. Il peut rester et peut être supprimé manuellement ; les données qui n'appartiennent pas à cette exécution ne sont pas supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ausführung konnte die Bereinigung des Remote-Staging-Verzeichnisses nicht bestätigen: %@. Es kann beibehalten und manuell gelöscht werden; Daten, die nicht zu diesem Lauf gehören, werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ejecución no pudo confirmar la limpieza del directorio de ensayo remoto: %@. Puede permanecer y eliminarse manualmente; los datos que no pertenecen a esta ejecución no se eliminan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta execução não pôde confirmar a limpeza do diretório de teste remoto: %@. Pode permanecer e pode ser excluído manualmente; os dados que não pertencem a esta execução não são excluídos."
          }
        }
      }
    },
