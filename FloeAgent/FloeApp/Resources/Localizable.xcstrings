    "auxiliary.keychain.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image models reuse the provider's Keychain credential and stay separate from chat models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片模型复用服务商的钥匙串凭据，并与对话模型分开管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片模型複用服務商的鑰匙串憑據，並與對話模型分開管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージモデルはプロバイダーのキーチェーン認証情報を再利用し、チャットモデルとは分離されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 모델은 제공자의 키체인 자격 증명을 재사용하고 채팅 모델과 별도로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles d'image réutilisent les informations d'identification du trousseau du fournisseur et restent séparés des modèles de chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildmodelle verwenden die Schlüsselbund-Anmeldeinformationen des Anbieters wieder und bleiben von Chat-Modellen getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de imagen reutilizan la credencial del llavero del proveedor y se mantienen separados de los modelos de chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de imagem reutilizam a credencial Keychain do provedor e permanecem separados dos modelos de bate-papo."
          }
        }
      }
    },
    "auxiliary.model_kind_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation/editing produce images; vision lets the model read images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成/编辑用于产出图片；视觉输入让模型能看图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
