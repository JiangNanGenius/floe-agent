    "app.bilingual.410c28acaafcd86a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "workflow_dispatch 只能发现默认分支上的工作流；安装会把 Floe 模板提交到该仓库默认分支（仅快进，不覆盖内容不同的同名文件）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "workflow_dispatch only discovers workflows on the default branch; installing commits the Floe template there (fast-forward only, never overwriting a same-name file with different content)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "workflow_dispatch 只能發現預設分支上的工作流；安裝會把 Floe 模板提交到該倉庫預設分支（僅快進，不覆蓋內容不同的同名檔案）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch はデフォルトブランチのワークフローのみを検出し、そこに Floe テンプレートをコミットします（早送りのみで、異なる内容の同名ファイルを上書きしないでください）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch는 기본 브랜치의 워크플로우만 검색합니다; 설치하면 Floe 템플릿을 그곳에 커밋합니다(패스트 포워드만 허용되며, 다른 내용의 동일 이름 파일을 절대 덮어쓰지 않습니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch ne découvre que les flux de travail sur la branche par défaut ; l'installation y valide le modèle Floe (avance rapide uniquement, n'écrasez jamais un fichier du même nom avec un contenu différent)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch erkennt nur Workflows auf dem Standard-Zweig; die Installation committ die Floe-Vorlage dort (nur Fast Forward, niemals eine Datei mit demselben Namen mit unterschiedlichem Inhalt überschreiben)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch solo descubre los flujos de trabajo en la rama predeterminada; la instalación confirma la plantilla Floe allí (solo avance rápido, nunca sobrescriba un archivo del mismo nombre con contenido diferente)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Workflow_dispatch só descobre fluxos de trabalho na ramificação padrão; a instalação confirma o modelo Floe lá (apenas avanço rápido, nunca sobrescrevendo um arquivo com o mesmo nome com conteúdo diferente)."
          }
        }
      }
    },
