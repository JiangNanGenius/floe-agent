    "app.bilingual.7f4c9baa957a8dd3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理此环境的 Debian 主源，其它仓库保持可用。也可直接用命令增改软件源。选择“系统现有”可恢复此处的切换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes this environment’s Debian source and keeps other repositories available. You can also add or edit sources with commands. Choose System configuration to restore this change."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理此環境的 Debian 主源，其它倉庫保持可用。也可直接用命令增改軟體源。選擇“系統現有”可恢復此處的切換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境の Debian ソースを変更し、他のリポジトリを利用可能に保ちます。 コマンドを使用して、ソースを追加したり編集したりすることもできます。 この変更を復元するには、システム構成を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경의 Debian 소스를 변경하고 다른 저장소를 사용할 수 있게 유지합니다. 명령을 사용하여 소스를 추가하거나 편집할 수도 있습니다. 이 변경을 복원하려면 시스템 구성을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie la source Debian de cet environnement et maintient d'autres référentiels disponibles. Vous pouvez également ajouter ou modifier des sources avec des commandes. Choisissez Configuration système pour restaurer cette modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Debian-Quelle dieser Umgebung und hält andere Repositories verfügbar. Sie können auch Quellen mit Befehlen hinzufügen oder bearbeiten. Wählen Sie Systemkonfiguration, um diese Änderung wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la fuente Debian de este entorno y mantiene otros repositorios disponibles. También puede agregar o editar fuentes con comandos. Elija Configuración del sistema para restaurar este cambio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altera a fonte Debian deste ambiente e mantém outros repositórios disponíveis. Você também pode adicionar ou editar fontes com comandos. Escolha Configuração do sistema para restaurar essa alteração."
          }
        }
      }
    },
    "app.bilingual.b61b2987fa96446b": {
      "extractionState": "manual",
