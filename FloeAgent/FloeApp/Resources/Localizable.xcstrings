    "app.bilingual.ee098bc8712c6b42": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法应用型线，请检查点顺序、半径和毛坯范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the point order, radii and stock bounds before applying the profile."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法應用型線，請檢查點順序、半徑和毛坯範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを適用する前に、点順序、半径、在庫境界を確認してください。"
