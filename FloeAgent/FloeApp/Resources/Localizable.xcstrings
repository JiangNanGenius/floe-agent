    "cad.uv.projectionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some materials use a projection. Choose Mesh UVs in Material to use this UV set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分材质正在使用投影。请在材质中选择网格 UV，以使用当前 UV 集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分材質正在使用投影。請在材質中選擇網格 UV，以使用當前 UV 集。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の材料は投影を使用します。 このUVセットを使用するには、Material の Mesh UV を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 재료는 투영을 사용합니다. 이 UV 세트를 사용하려면 Material에서 Mesh UV를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains matériaux utilisent une projection. Choisissez Mesh UVs in Material pour utiliser cet ensemble UV."
          }
        },
