    "app.bilingual.c3963c6de45c8efc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保存的配置不会改变当前去料预览。未填写的切削速度、转速等不自动推荐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored configuration does not change the current stock preview. Unset cutting speeds and spindle speeds are not automatically recommended."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存的配置不會改變當前去料預覽。未填寫的切削速度、轉速等不自動推薦。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された構成は現在の在庫プレビューを変更しません。 未設定の切削速度およびスピンドル速度は自動的に推奨されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 구성은 현재 재고 미리보기를 변경하지 않습니다. 설정되지 않은 절단 속도와 스핀들 속도는 자동으로 권장되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration stockée ne modifie pas l'aperçu du stock actuel. Les vitesses de coupe non réglées et les vitesses de broche ne sont pas automatiquement recommandées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Konfiguration ändert die aktuelle Bestandsvorschau nicht. Nicht eingestellte Schnittgeschwindigkeiten und Spindelgeschwindigkeiten werden nicht automatisch empfohlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración almacenada no cambia la vista previa de las acciones actuales. Las velocidades de corte y las velocidades del husillo no se recomiendan automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração armazenada não altera a visualização do estoque atual. Velocidades de corte não definidas e velocidades de fuso não são recomendadas automaticamente."
          }
        }
      }
    },
