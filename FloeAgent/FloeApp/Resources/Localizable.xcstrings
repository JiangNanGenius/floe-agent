    },
    "app.bilingual.78be67fb173d5061": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纯噪声样本不应包含需要保留的人声或音乐。强度过高可能削弱声音细节。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A noise sample should contain no voice or music you want to keep. Strong reduction can remove audio detail."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "純噪聲樣本不應包含需要保留的人聲或音樂。強度過高可能削弱聲音細節。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノイズサンプルには、保持したい音声や音楽を含めないでください。 強いリダクションは音声の詳細を除去できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노이즈 샘플에는 유지하고 싶은 음성이나 음악이 포함되어서는 안 됩니다. 강한 감소는 오디오 디테일을 제거할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un échantillon de bruit ne doit pas contenir de voix ou de musique que vous voulez garder. Une forte réduction peut supprimer les détails audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Rauschprobe sollte keine Stimme oder Musik enthalten, die Sie behalten möchten. Starke Reduzierung kann Audiodetails entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una muestra de ruido no debe contener ninguna voz o música que quieras conservar. Una fuerte reducción puede eliminar detalles de audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma amostra de ruído não deve conter nenhuma voz ou música que você queira manter. A redução forte pode remover detalhes de áudio."
          }
        }
      }
    },
    "app.bilingual.a298e12639007e8b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始音频已变化，请重新选择后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source audio changed. Select it again and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始音訊已變化，請重新選擇後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソース音声が変更されました。 もう一度選択して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 오디오가 변경되었습니다. 다시 선택하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio source a changé. Sélectionnez-le à nouveau et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Quellaudio hat sich geändert. Wählen Sie es erneut aus und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de origen cambió. Selecciónelo de nuevo y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de origem mudou. Selecione-o novamente e tente novamente."
          }
        }
      }
    },
    "app.bilingual.41ef497708f2c65d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段音频较长，请先裁剪后处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio exceeds the processing limit. Trim it before processing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段音訊較長，請先裁剪後處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声は処理上限を超えています。 処理する前にトリミングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 오디오는 처리 한도를 초과했습니다. 처리하기 전에 다듬어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet audio dépasse la limite de traitement. Coupez-le avant de le traiter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audio überschreitet das Verarbeitungslimit. Schneiden Sie es vor der Verarbeitung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este audio supera el límite de procesamiento. Recortarlo antes de procesarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este áudio excede o limite de processamento. Corte-o antes do processamento."
          }
        }
      }
    },
    "app.bilingual.c47cc3abd0d0f979": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查音频和噪声样本的范围后重试。"
