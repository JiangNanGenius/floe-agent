    "settings.general.keyboard.send_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return sends a message. Shift–Return adds a new line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按回车发送消息，Shift＋回车换行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按回車傳送訊息，Shift＋回車換行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Return はメッセージを送信します。 Shift‐Return は新しい行を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Return이 메시지를 보냅니다. Shift–Return을 누르면 새 줄이 추가됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le retour envoie un message. Shift-Return ajoute une nouvelle ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Return sendet eine Nachricht. Shift-Return fügt eine neue Zeile hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El retorno envía un mensaje. Shift-Return añade una nueva línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O retorno envia uma mensagem. Shift-Return adiciona uma nova linha."
          }
        }
      }
    },
