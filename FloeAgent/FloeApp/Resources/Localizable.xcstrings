      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secrets sync only through your own iCloud Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥仅通过你自己的 iCloud 钥匙串同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰僅透過你自己的 iCloud 鑰匙串同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットはご自身の iCloud キーチェーンを通じてのみ同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀은 귀하의 iCloud 키체인을 통해서만 동기화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les secrets se synchronisent uniquement via votre propre trousseau iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse werden nur über Ihren eigenen iCloud-Schlüsselbund synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los secretos se sincronizan solo a través de tu propio llavero de iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segredos sincronizam apenas através do seu próprio Chaveiro do iCloud."
          }
        }
      }
    },
