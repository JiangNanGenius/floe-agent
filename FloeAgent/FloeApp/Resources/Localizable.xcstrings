    "execution.power.confirm_other": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will interrupt running work in %ld projects. Files and installed software are kept. Continue?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会中断 %ld 个项目的运行，保留文件和已安装内容。要继续吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會中斷 %ld 個專案的執行，保留檔案和已安裝內容。要繼續嗎？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、%ld プロジェクトの実行中の作業が中断されます。 ファイルとインストールされたソフトウェアは保管されています。 続行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 %ld 프로젝트에서 실행 중인 작업을 방해합니다. 파일과 설치된 소프트웨어는 보관됩니다. 계속하시겠습니까?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela interrompra le travail en cours d'exécution dans les projets %ld. Les fichiers et les logiciels installés sont conservés. Continuer ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die laufende Arbeit in %ld-Projekten unterbrochen. Dateien und installierte Software werden aufbewahrt. Weiter?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto interrumpirá el trabajo en ejecución en los proyectos %ld. Los archivos y el software instalado se guardan. ¿Continuar?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso interromperá a execução do trabalho em projetos %ld. Arquivos e softwares instalados são mantidos. Continuar?"
          }
        }
      }
    },
