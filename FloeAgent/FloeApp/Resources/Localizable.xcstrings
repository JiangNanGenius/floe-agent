        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a changé lors de la préparation de la restauration ; rechargé, veuillez choisir à nouveau la version historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung hat sich während der Vorbereitung der Wiederherstellung geändert; neu geladen, bitte wählen Sie erneut die historische Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo cambió mientras se preparaba la restauración; recargado, elija la versión histórica de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
