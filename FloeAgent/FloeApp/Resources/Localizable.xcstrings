    "execution.linux_guest.pending_writes_not_confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment stopped before all file changes were confirmed. Recent changes may be missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境已停止，但部分文件更改未能确认保存，最近的更改可能丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境已停止，但部分檔案更改未能確認儲存，最近的更改可能丟失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境はすべてのファイル変更が確認される前に停止しました。 最近の変更が欠けている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 파일 변경이 확인되기 전에 환경이 중단되었습니다. 최근 변경 사항이 누락될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement s'est arrêté avant que toutes les modifications de fichiers ne soient confirmées. Les changements récents peuvent être manquants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung wurde gestoppt, bevor alle Dateiänderungen bestätigt wurden. Möglicherweise fehlen aktuelle Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno se detuvo antes de que se confirmaran todos los cambios de archivo. Es posible que falten cambios recientes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente parou antes que todas as alterações de arquivo fossem confirmadas. Alterações recentes podem estar faltando."
          }
        }
      }
    },
    "execution.linux_guest.finish_saving_before_resource_change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files could not finish saving. Retry before changing the environment resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件尚未完成保存，请稍后重试调整运行资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案尚未完成儲存，請稍後重試調整執行資源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの保存を完了できませんでした。 環境リソースを変更する前に、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 저장을 완료할 수 없습니다. 환경 리소스를 변경하기 전에 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers n'ont pas pu terminer l'enregistrement. Réessayez avant de modifier les ressources de l'environnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern von Dateien konnte nicht abgeschlossen werden. Versuchen Sie es erneut, bevor Sie die Umgebungsressourcen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos no pudieron terminar de guardarse. Vuelva a intentarlo antes de cambiar los recursos del entorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos não puderam terminar de salvar. Tente novamente antes de alterar os recursos do ambiente."
          }
        }
      }
    },
