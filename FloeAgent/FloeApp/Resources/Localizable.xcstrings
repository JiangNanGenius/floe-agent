          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un sujet enfant sous la sélection et commencez à le nommer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein untergeordnetes Thema unter der Auswahl hinzu und beginnen Sie, es zu benennen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un tema secundario debajo de la selección y empieza a nombrarlo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um tópico filho na seleção e comece a nomeá-lo"
          }
        }
      }
    },
