    "background.pip_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While a task runs, the picture stays inside the task or canvas toolbar. When you leave Floe, the system opens Picture-in-Picture automatically; you can also start or close it from the toolbar. No separate floating card appears while Floe is in the foreground."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务运行时，画面只嵌在任务或画布工具栏内；离开 Floe 时系统会自动进入画中画，也可在工具栏手动启动或关闭。Floe 在前台时不会出现独立悬浮卡片。"
          }
        }
      }
    },
