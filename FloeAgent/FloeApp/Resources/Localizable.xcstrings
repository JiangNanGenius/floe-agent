    "app.bilingual.7c7aa33ca934e36e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备需要认证。请完成系统提示后重新连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device requires authentication. Complete the system prompt, then reconnect."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置需要認證。請完成系統提示後重新連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは認証が必要です。 システムのプロンプトを完了し、再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 인증이 필요합니다. 시스템 프롬프트를 완료한 후 다시 연결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil nécessite une authentification. Complétez l'invite système, puis reconnectez-vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät erfordert eine Authentifizierung. Schließen Sie die Systemaufforderung ab, und verbinden Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo requiere autenticación. Complete el mensaje del sistema y, a continuación, vuelva a conectar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo requer autenticação. Complete o prompt do sistema e reconecte-se."
          }
        }
