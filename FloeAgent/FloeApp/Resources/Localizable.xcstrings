    "app.bilingual.2deef8f2da5cf353": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。文档和已保存的修改仍保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again shortly. Your document and saved changes are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍後再試。文件和已儲存的修改仍保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐにもう一度お試しください。 お客様の文書と保存された変更は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 후 다시 시도해 주세요. 귀하의 문서와 저장된 변경 사항이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez sous peu. Votre document et les modifications enregistrées sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es in Kürze erneut. Ihr Dokument und gespeicherte Änderungen werden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo en breve. Su documento y los cambios guardados se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente em breve. Seu documento e alterações salvas são mantidos."
          }
        }
      }
    },
