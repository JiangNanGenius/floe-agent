    "design.owner.discard_missing_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded result cannot be read on this device, so it can never be bound. Discarding closes only the local record; generating a replacement is a new provider request that may be charged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的结果在本机无法读取，因此无法绑定。放弃只会关闭本机记录；重新生成是新的服务商请求，可能会计费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄的結果在本機無法讀取，因此無法繫結。放棄只會關閉本機記錄；重新生成是新的服務商請求，可能會計費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは記録された結果を読み取ることができないため、決してバインドできません。 破棄するとローカルレコードのみが閉じられます；代替レコードを生成すると、新しいプロバイダーのリクエストとなり、料金が発生する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서는 기록된 결과를 읽을 수 없으므로 절대로 바인딩될 수 없습니다. 폐기하면 로컬 레코드만 닫히며, 교체를 생성하는 것은 비용이 청구될 수 있는 새로운 공급자 요청입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat enregistré ne peut pas être lu sur cet appareil, il ne peut donc jamais être lié. La mise au rebut ne ferme que l'enregistrement local ; la génération d'un remplacement est une nouvelle demande de fournisseur qui peut être facturée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aufgezeichnete Ergebnis kann auf diesem Gerät nicht gelesen werden, daher kann es niemals gebunden werden. Das Verwerfen schließt nur den lokalen Datensatz; das Generieren eines Ersatzes ist eine neue Anbieteranfrage, die belastet werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado grabado no se puede leer en este dispositivo, por lo que nunca se puede encuadernar. Descartar solo cierra el registro local; generar un reemplazo es una nueva solicitud de proveedor que puede ser cargada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado gravado não pode ser lido neste dispositivo, portanto, nunca pode ser vinculado. Descartar fecha apenas o registro local; gerar uma substituição é uma nova solicitação do provedor que pode ser cobrada."
          }
        }
      }
    },
    "design.owner.discard_unknown_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard anyway; a new attempt may be charged twice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然放弃；再次生成可能重复计费"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍然放棄；再次生成可能重複計費"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "とにかく破棄してください；新しい試みは二重に課金される可能性があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어쨌든 폐기하십시오; 새로운 시도는 두 번 청구될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeter de toute façon ; une nouvelle tentative peut être facturée deux fois"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trotzdem verwerfen; ein neuer Versuch kann zweimal belastet werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desechar de todos modos; un nuevo intento puede cobrarse dos veces"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarte de qualquer maneira; uma nova tentativa pode ser cobrada duas vezes"
          }
        }
      }
    },
    "design.owner.discard_unknown_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard the unknown generation attempt?"
          }
        },
        "zh-Hans": {
