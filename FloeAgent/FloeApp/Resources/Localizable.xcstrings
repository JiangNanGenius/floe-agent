        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 재료는 %d 장소에서 사용됩니다. 라이브러리 항목을 삭제해도 해당 모델은 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce matériau est utilisé dans le(s) endroit(x) %d. La suppression de l'entrée de la bibliothèque ne modifie pas ces modèles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Material wird in %d Ort(en) verwendet. Das Löschen des Bibliothekseintrags ändert diese Modelle nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este material se utiliza en lugares %d. Eliminar la entrada de la biblioteca no cambia esos modelos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este material é usado em %d lugar(es). Excluir a entrada da biblioteca não altera esses modelos."
          }
        }
      }
    },
    "cad.material.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the library entry. Materials already applied keep their own copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会移除库中的记录。已应用的材质会保留自己的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會移除庫中的記錄。已應用的材質會保留自己的副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、ライブラリのエントリが削除されます。 既に適用された資料は、各自のコピーを保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 라이브러리 항목을 제거합니다. 이미 적용된 자료는 자체 사본을 보관하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'entrée de la bibliothèque. Les matériaux déjà appliqués conservent leur propre copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Bibliothekseintrag entfernt. Bereits angewendete Materialien behalten ihre eigene Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la entrada de la biblioteca. Los materiales ya aplicados guardan su propia copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove a entrada da biblioteca. Os materiais já aplicados mantêm sua própria cópia."
          }
        }
      }
    },
    "cad.material.delete.title": {
