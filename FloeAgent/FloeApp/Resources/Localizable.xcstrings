    },
    "settings.internal_prompts.fixed_rules.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rules below are compiled into the app. They are never editable here and can never be changed by remote content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下规则编译在应用内，无法在此编辑，也不会被远程内容更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下規則編譯在應用內，無法在此編輯，也不會被遠端內容更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の規則はアプリにまとめられています。 ここでは決して編集できず、リモートコンテンツによって変更されることもありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 규칙은 앱에 컴파일되었습니다. 여기서는 절대 편집할 수 없으며 원격 콘텐츠에 의해 절대 변경될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles ci-dessous sont compilées dans l'application. Ils ne sont jamais modifiables ici et ne peuvent jamais être modifiés par du contenu à distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Regeln werden in der App zusammengestellt. Sie sind hier nie bearbeitbar und können niemals durch Remote-Inhalte geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las siguientes reglas se compilan en la aplicación. Nunca son editables aquí y nunca pueden ser cambiados por el contenido remoto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras abaixo são compiladas no aplicativo. Eles nunca são editáveis aqui e nunca podem ser alterados por conteúdo remoto."
          }
        }
      }
    },
    "settings.internal_prompts.fixed_rules.permission": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool calls that need permission always require your explicit approval; content updates never widen permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要权限的工具调用始终需要你明确批准；内容更新绝不会扩大权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要許可權的工具呼叫始終需要你明確批准；內容更新絕不會擴大許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が必要なツール呼び出しは、常に明示的な承認が必要です；コンテンツの更新が権限を拡大することは決してありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한이 필요한 도구 호출은 항상 귀하의 명시적인 승인을 필요로 하며, 콘텐츠 업데이트는 절대 권한을 확대하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appels d'outils qui nécessitent une autorisation nécessitent toujours votre approbation explicite ; les mises à jour de contenu n'élargissent jamais les autorisations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolaufrufe, die eine Genehmigung benötigen, erfordern immer Ihre ausdrückliche Genehmigung; Inhaltsaktualisierungen erweitern niemals die Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las llamadas a las herramientas que necesitan permiso siempre requieren su aprobación explícita; las actualizaciones de contenido nunca amplían los permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chamadas de ferramentas que precisam de permissão sempre exigem sua aprovação explícita; as atualizações de conteúdo nunca ampliam as permissões."
          }
        }
      }
    },
    "settings.internal_prompts.fixed_rules.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery, rollback and data-preservation behavior is code-owned; installed content is retained and never silently discarded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复、回退与数据保全行为由代码掌控；已安装内容始终保留，不会被静默丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復、回退與資料保全行為由程式碼掌控；已安裝內容始終保留，不會被靜默丟棄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリ、ロールバック、データ保存の動作はコードが所有しており、インストールされたコンテンツは保持され、黙って破棄されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구, 롤백 및 데이터 보존 동작은 코드 소유이며, 설치된 콘텐츠는 보존되고 절대로 조용히 폐기되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le comportement de récupération, de restauration et de préservation des données est la propriété du code ; le contenu installé est conservé et jamais jeté silencieusement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verhalten von Wiederherstellung, Rollback und Datenerhaltung ist Code-Besitz; installierte Inhalte werden beibehalten und niemals stillschweigend verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El comportamiento de recuperación, reversión y preservación de datos es propiedad del código; el contenido instalado se conserva y nunca se descarta silenciosamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comportamento de recuperação, reversão e preservação de dados é de propriedade do código; o conteúdo instalado é retido e nunca descartado silenciosamente."
          }
        }
      }
    },
    "settings.internal_prompts.fixed_rules.tool_protocol": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tool request/result protocol is enforced by the runtime; content cannot redefine it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具请求/结果协议由运行时强制执行；内容无法重新定义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工具請求/結果協議由執行時強制執行；內容無法重新定義。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールのリクエスト/レゾルトプロトコルはランタイムによって強制されます；コンテンツはそれを再定義できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 요청/결과 프로토콜은 런타임에 의해 강제되며, 콘텐츠는 이를 재정의할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le protocole de demande/résultat de l'outil est appliqué par le runtime ; le contenu ne peut pas le redéfinir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Werkzeuganforderungs-/Ergebnisprotokoll wird von der Laufzeit durchgesetzt; der Inhalt kann es nicht neu definieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El protocolo de solicitud/resultado de la herramienta es aplicado por el tiempo de ejecución; el contenido no puede redefinirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O protocolo de solicitação/resultado da ferramenta é aplicado pelo tempo de execução; o conteúdo não pode redefini-lo."
          }
        }
      }
    },
    "settings.internal_prompts.fixed_rules.truthfulness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verification and honest-failure rules are code-owned and cannot be overridden by content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证与诚实失败规则由代码掌控，内容无法覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "驗證與誠實失敗規則由程式碼掌控，內容無法覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証および正直な失敗ルールはコードが所有しており、コンテンツによって上書きすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증 및 정직 실패 규칙은 코드 소유이며 콘텐츠에 의해 재정의될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles de vérification et d'échec d'honnêteté sont la propriété du code et ne peuvent pas être contournées par le contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfungs- und Ehrlichkeits-Versagen-Regeln sind Code-Besitz und können nicht durch Inhalte außer gehoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de verificación y de fracaso de honestidad son propiedad del código y no pueden ser anuladas por el contenido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras de verificação e falha honesta são de propriedade do código e não podem ser anuladas pelo conteúdo."
          }
        }
      }
    },
