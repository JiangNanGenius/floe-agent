    "app.bilingual.e1bcce1d0735d9b2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含明确直线移动与停留；未计未输出的连接、加减速、换刀或旋转轴时间。材料显示为工序快照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes explicit linear moves and dwell; excludes missing links, acceleration, tool changes and rotary-axis time. Stock uses operation snapshots."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含明確直線移動與停留；未計未輸出的連線、加減速、換刀或旋轉軸時間。材料顯示為工序快照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明示的な線形移動と滞留を含み、欠落リンク、加速度、工具交換、回転軸時間は除外されます。 在庫は操作スナップショットを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명시적인 선형 이동 및 체류를 포함하며, 누락된 링크, 가속도, 공구 교체 및 회전축 시간은 제외합니다. 주식은 운영 스냅샷을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprend les mouvements linéaires explicites et l'attente ; exclut les liens manquants, l'accélération, les changements d'outils et le temps de l'axe rotatif. Stock utilise des instantanés d'opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beinhaltet explizite lineare Bewegungen und Verweilen; schließt fehlende Glieder, Beschleunigung, Werkzeugwechsel und Rotationsachsenzeit aus. Stock verwendet Operations-Snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye movimientos y permanencia lineales explícitos; excluye los enlaces faltantes, la aceleración, los cambios de herramienta y el tiempo del eje giratorio. Stock utiliza instantáneas de operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui movimentos e permanências lineares explícitos; exclui links ausentes, aceleração, mudanças de ferramentas e tempo de eixo rotativo. O estoque usa instantâneos de operação."
          }
        }
      }
    },
    "app.bilingual.3d9bd580bb97a000": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅含已有直线切削段；未包含空移、加减速、主轴升降速、换刀或 A/C 运动时间。材料显示仍为工序快照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing linear cutting segments only; excludes rapid links, acceleration, spindle transients, tool changes and A/C motion time. Stock remains phase snapshots."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅含已有直線切削段；未包含空移、加減速、主軸升降速、換刀或 A/C 運動時間。材料顯示仍為工序快照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のリニア切削セグメントのみ；ラピッドリンク、アクセラレーション、スピンドルトランジェント、ツールチェンジ、A/Cモーション時間は除外されます。 在庫はフェーズスナップショットのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 선형 절단 구간만 해당되며, 급속 링크, 가속도, 스핀들 과도, 공구 교체 및 A/C 동작 시간은 제외합니다. 재고는 단계 스냅샷을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Segments de coupe linéaires existants uniquement ; exclut les liaisons rapides, l'accélération, les transitoires de broche, les changements d'outils et le temps de mouvement de la climatisation. Le stock reste des instantanés de phase."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur vorhandene lineare Schneidsegmente; schließt schnelle Verbindungen, Beschleunigung, Spindeltransienten, Werkzeugwechsel und A/C-Bewegungszeit aus. Stock bleibt Phasen-Snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo segmentos de corte lineales existentes; excluye enlaces rápidos, aceleración, transitorios de husillo, cambios de herramienta y tiempo de movimiento de A/C. Las acciones siguen siendo instantáneas de fase."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas segmentos de corte linear existentes; exclui links rápidos, aceleração, transientes do fuso, mudanças de ferramentas e tempo de movimento A/C. O estoque permanece instantâneos de fase."
          }
        }
      }
    },
