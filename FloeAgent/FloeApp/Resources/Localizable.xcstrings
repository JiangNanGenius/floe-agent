    "cad.thread.geometryHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models the basic thread profile. Fit allowances are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建立基本牙型几何，不含配合公差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立基本牙型幾何，不含配合公差。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的なスレッドプロファイルをモデル化します。 フィット手当は含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 스레드 프로파일을 모델링합니다. 핏 허용량은 포함되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modélise le profil de thread de base. Les allocations d'ajustement ne sont pas incluses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelliert das grundlegende Thread-Profil. Fit-Zulagen sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modela el perfil de hilo básico. Los subsidios de ajuste no están incluidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modela o perfil de thread básico. Subsídios de ajuste não estão incluídos."
          }
        }
      }
    },
    "cad.thread.schematicHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the solid unchanged and records the thread specification."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原实体，记录螺纹规格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留原實體，記錄螺紋規格。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソリッドを変更せずに保持し、スレッドの仕様を記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "솔리드를 변경하지 않고 스레드 사양을 기록합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le solide inchangé et enregistre la spécification du fil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Feststoff unverändert und zeichnet die Gewindespezifikation auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el sólido sin cambios y registra la especificación del hilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o sólido inalterado e registra a especificação da rosca."
          }
        }
      }
    },
