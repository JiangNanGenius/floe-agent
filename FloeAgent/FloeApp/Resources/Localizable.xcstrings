        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été interrompue ; vérifiez le fichier avant de réessayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wurde unterbrochen; überprüfen Sie die Datei, bevor Sie es erneut versuchen"
