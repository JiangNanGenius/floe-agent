      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This material is used in %d place(s). Deleting the library entry does not change those models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此材质已用于 %d 处。删除库中的记录不会改变这些模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
