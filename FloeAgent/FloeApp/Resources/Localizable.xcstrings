    "cad.building.error.selectABeamAndEnterItsMaterial": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a beam and enter its material, supports and load before analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
