    "websearch.professional.result_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask one clear question at a time and name the dataset or subject. Results come from the configured professional data service."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次提出一个明确问题，并写清数据类型或查询对象。结果来自已配置的专业数据服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次提出一個明確問題，並寫清資料型別或查詢物件。結果來自已配置的專業資料服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に一つの明確な質問をし、データセットまたは対象の名前を挙げてください。 結果は、設定されたプロフェッショナルデータサービスから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 하나의 명확한 질문을 하고, 데이터셋이나 주제를 지정하십시오. 결과는 구성된 전문 데이터 서비스에서 제공됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question claire à la fois et nommez l'ensemble de données ou le sujet. Les résultats proviennent du service de données professionnel configuré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine klare Frage nach der anderen und benennen Sie den Datensatz oder das Thema. Die Ergebnisse stammen vom konfigurierten professionellen Datendienst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga una pregunta clara a la vez y nombre el conjunto de datos o el tema. Los resultados vienen del servicio de datos profesional configurado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta clara de vez e nomeie o conjunto de dados ou assunto. Os resultados vêm do serviço de dados profissional configurado."
          }
        }
      }
    },
    "websearch.professional.summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search papers, company records and risks, financial data, vehicles, legislation and court cases."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检索文献、企业工商与风险、金融数据、汽车、法律法规和司法案例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢索文獻、企業工商與風險、金融資料、汽車、法律法規和司法案例。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索書類、企業記録およびリスク、財務データ、車両、法令および裁判案件。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서, 기업 기록 및 위험, 재무 데이터, 차량, 법률 및 법원 사건을 검색합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des documents, des dossiers et des risques de l'entreprise, des données financières, des véhicules, de la législation et des affaires judiciaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie Papiere, Unternehmensunterlagen und Risiken, Finanzdaten, Fahrzeuge, Gesetze und Gerichtsverfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentos de búsqueda, registros y riesgos de la empresa, datos financieros, vehículos, legislación y casos judiciales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise documentos, registros e riscos da empresa, dados financeiros, veículos, legislação e processos judiciais."
          }
        }
      }
    },
    "websearch.professional.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Professional data search"
          }
        },
