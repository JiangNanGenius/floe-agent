    "settings.privacy.clear_models.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all providers and models and removes their API keys from Keychain. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部供应商与模型，并从钥匙串移除对应 API Key。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除全部供應商與模型，並從鑰匙串移除對應 API Key。此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのプロバイダーとモデルを削除し、Keychain からそれらの API キーを削除します。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에서 모든 제공자와 모델을 삭제하고 해당 API 키를 제거합니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime tous les fournisseurs et modèles et supprime leurs clés API du trousseau. Cela ne peut pas être défait."
          }
        },
        "de": {
