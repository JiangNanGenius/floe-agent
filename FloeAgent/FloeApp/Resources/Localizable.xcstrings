    "hosts.host_editor_view.one_device_can_store_both_plain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One device can store both plain VNC and SSH-tunnel VNC; credentials are kept only in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一设备可同时保存普通 VNC 和 SSH 隧道 VNC；凭据只保存在钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一裝置可同時儲存普通 VNC 和 SSH 隧道 VNC；憑據只儲存在鑰匙串。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのデバイスは、プレーンな VNC と SSH‐tunnel VNC の両方を保存できます。認証情報はキーチェーンにのみ保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 장치는 일반 VNC와 SSH-tunnel VNC를 모두 저장할 수 있으며, 자격 증명은 키체인에만 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil peut stocker à la fois VNC et SSH-tunnel VNC ; les informations d'identification ne sont conservées que dans le trousseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gerät kann sowohl einfache VNC als auch SSH-tunnel VNC speichern; Anmeldeinformationen werden nur im Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo puede almacenar tanto VNC como SSH-tunnel VNC; las credenciales se guardan solo en el llavero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo pode armazenar VNC simples e SSH-tunnel VNC; as credenciais são mantidas apenas no Keychain."
          }
        }
      }
    },
