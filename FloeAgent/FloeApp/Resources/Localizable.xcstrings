    "memory.memory_view.updates_only_after_at_least_7": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates only after at least 7 days and a cumulative 10 completed runs or 30 user messages."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少间隔 7 天，并累计 10 个完成运行或 30 条用户消息后才更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少間隔 7 天，並累計 10 個完成執行或 30 條使用者訊息後才更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新は、少なくとも7日が経過した後、累計で10回の実行完了または30件のユーザーメッセージが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 최소 7일 이상이며, 누적된 10개의 완료된 실행 또는 30개의 사용자 메시지가 있는 경우에만 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour uniquement après au moins 7 jours et un cumul de 10 exécutions terminées ou 30 messages utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisierungen erst nach mindestens 7 Tagen und insgesamt 10 abgeschlossenen Läufen oder 30 Benutzernachrichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones solo después de al menos 7 días y un acumulado de 10 ejecuciones completadas o 30 mensajes de usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações somente após pelo menos 7 dias e um total de 10 execuções concluídas ou 30 mensagens do usuário."
          }
        }
      }
    },
