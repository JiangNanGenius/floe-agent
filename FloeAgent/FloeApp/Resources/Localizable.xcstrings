    "app.bilingual.47a683f0b950291d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务仍在停止，文件和对话已保留。请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Work is still stopping. The file and conversation are kept. Try again shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務仍在停止，檔案和對話已保留。請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業はまだ停止しています。 ファイルと会話は保持されています。 すぐにもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직도 중단되고 있습니다. 파일과 대화는 보관됩니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail s'arrête toujours. Le dossier et la conversation sont conservés. Réessayez sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeit hört immer noch auf. Die Datei und das Gespräch werden aufbewahrt. Versuchen Sie es in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo todavía se está deteniendo. El archivo y la conversación se mantienen. Inténtalo de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho ainda está parando. O arquivo e a conversa são mantidos. Tente novamente em breve."
          }
        }
      }
    },
    "app.bilingual.9838ccd0fa5c41b7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件操作尚在收尾，记录已保留。请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file operation is still finishing. Its records are kept. Try again shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案操作尚在收尾，記錄已保留。請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル操作はまだ完了していません。 その記録は保管されています。 すぐにもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 작업이 아직 완료 중입니다. 그 기록은 보관됩니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération de fichier est toujours en cours de fin. Ses dossiers sont conservés. Réessayez sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateivorgang wird noch abgeschlossen. Seine Aufzeichnungen werden aufbewahrt. Versuchen Sie es in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación del archivo todavía está terminando. Sus registros se mantienen. Inténtalo de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação do arquivo ainda está terminando. Seus registros são mantidos. Tente novamente em breve."
          }
        }
      }
    },
    "app.bilingual.ce2f4c024dd7dfd5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件助手已改变，请重新打开文件后重试。"
