    "shortcuts.floe_shortcuts.create_and_start_a_floe_task": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and start a Floe task in the background, suited to Shortcuts automation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台创建并开始一个 Floe 任务，适合快捷指令自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在後臺建立並開始一個 Floe 任務，適合快捷指令自動化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット自動化に適したFloeタスクをバックグラウンドで作成し、開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts 자동화에 적합한 Floe 작업을 백그라운드에서 생성하고 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez et démarrez une tâche Floe en arrière-plan, adaptée à l'automatisation des raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen und starten Sie eine Floe-Aufgabe im Hintergrund, die für die Automatisierung von Shortcuts geeignet ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree e inicie una tarea Floe en segundo plano, adecuada para la automatización de accesos directos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie e inicie uma tarefa Floe em segundo plano, adequada para automação de Atalhos."
          }
        }
      }
    },
