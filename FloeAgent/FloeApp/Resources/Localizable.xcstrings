    "app.bilingual.5a970ee6c8338b8e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前目录没有识别到所选引擎，请在游戏引擎中选择已识别的游戏目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected engine was not recognized in this folder. Choose a recognized game folder in Game Engine."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前目錄沒有識別到所選引擎，請在遊戲引擎中選擇已識別的遊戲目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたエンジンはこのフォルダーで認識されませんでした。 Game Engineで認識されたゲームフォルダーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 엔진이 이 폴더에서 인식되지 않았습니다. Game Engine에서 인식된 게임 폴더를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur sélectionné n'a pas été reconnu dans ce dossier. Choisissez un dossier de jeu reconnu dans Game Engine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Engine wurde in diesem Ordner nicht erkannt. Wählen Sie einen erkannten Spielordner in Game Engine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor seleccionado no fue reconocido en esta carpeta. Elija una carpeta de juego reconocida en Game Engine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo selecionado não foi reconhecido nesta pasta. Escolha uma pasta de jogo reconhecida no Game Engine."
          }
        }
      }
    },
