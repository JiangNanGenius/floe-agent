    "app.bilingual.452eabc0ef7957e2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "子任务有操作结果尚未确认，请先在原位置恢复或处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A subtask has an unconfirmed operation. Resume or resolve it in the original environment first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "子任務有操作結果尚未確認，請先在原位置恢復或處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブタスクに未確認の操作があります。 まず、元の環境で再開するか、解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 작업에 확인되지 않은 작업이 있습니다. 먼저 원래 환경에서 재개하거나 해결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sous-tâche a une opération non confirmée. Reprenez ou résolvez-le d'abord dans l'environnement d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Unteraufgabe hat einen unbestätigten Vorgang. Setzen Sie es fort oder lösen Sie es zuerst in der ursprünglichen Umgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una subtarea tiene una operación no confirmada. Reanude o resuelva primero en el entorno original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma subtarefa tem uma operação não confirmada. Retome ou resolva-o no ambiente original primeiro."
          }
        }
      }
    },
    "app.bilingual.4f1281bb2c918cc4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有操作的执行结果尚未确认。请先核对原运行位置，再迁移。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation’s result is unknown. Check the original environment before moving this task."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有操作的執行結果尚未確認。請先核對原執行位置，再遷移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作の結果は不明です。 このタスクを移動する前に、元の環境を確認してください。"
