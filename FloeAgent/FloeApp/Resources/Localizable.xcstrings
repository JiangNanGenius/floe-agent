    "app.bilingual.72aac8c83aef88e4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在所属任务中停止这个工程的外部计算，再删除它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop this project's external calculations in their owning task before deleting it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在所屬任務中停止這個工程的外部計算，再刪除它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトの外部計算を、削除する前に所有タスクで停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트의 외부 계산을 삭제하기 전에 자체 작업에서 중지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez les calculs externes de ce projet dans leur tâche de possession avant de le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie die externen Berechnungen dieses Projekts in ihrer eigenen Aufgabe, bevor Sie sie löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenga los cálculos externos de este proyecto en su tarea de propiedad antes de eliminarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompa os cálculos externos deste projeto em sua tarefa de propriedade antes de excluí-lo."
          }
        }
      }
    },
    "app.bilingual.c250ffc61a2ff5a7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次计算仍在提交，原件已保留；请稍后再试删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calculation is still submitting. Its original has been retained; try the deletion again shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次計算仍在提交，原件已保留；請稍後再試刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計算はまだ送信中です。 元のものは保持されていますので、すぐに削除をもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계산은 아직 제출 중입니다. 원본이 유지되었습니다; 곧 다시 삭제해 보시기 바랍니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce calcul est toujours en coumission. Son original a été conservé ; essayez à nouveau la suppression sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Berechnung wird noch eingereicht. Das Original wurde beibehalten; versuchen Sie die Löschung in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cálculo todavía se está enviando. Su original se ha conservado; intente la eliminación de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cálculo ainda está ser enviado. Seu original foi mantido; tente a exclusão novamente em breve."
          }
        }
      }
    },
    "app.bilingual.14da44093af7f03a": {
      "extractionState": "manual",
      "localizations": {
