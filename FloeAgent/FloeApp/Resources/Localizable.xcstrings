    "chat.thread_detail_view_model.waiting_for_background_work_continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is waiting for required background work. It continues in the same task when that work finishes; send a message if you want to steer it now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本任务正在等待所需的后台作业，作业完成后会在同一任务中继续；如需现在插话，请直接发送消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本任務正在等待所需的後臺作業，作業完成後會在同一任務中繼續；如需現在插話，請直接傳送訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクは、必要なバックグラウンド作業を待っています。 その作業が完了したら、同じタスクで続行されます。今すぐ操作したい場合はメッセージを送ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 필요한 배경 작업을 기다리고 있습니다. 작업이 완료되면 동일한 작업에서 계속됩니다; 지금 바로 진행하고 싶으시면 메시지를 보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche attend le travail de fond requis. Il continue dans la même tâche lorsque ce travail est terminé ; envoyez un message si vous voulez le diriger maintenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe wartet auf die erforderliche Hintergrundarbeit. Es wird in der gleichen Aufgabe fortgesetzt, wenn diese Arbeit abgeschlossen ist; senden Sie eine Nachricht, wenn Sie es jetzt steuern möchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea está esperando el trabajo de fondo requerido. Continúa en la misma tarea cuando ese trabajo termina; envía un mensaje si quieres dirigirlo ahora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa está aguardando o trabalho de fundo necessário. Ele continua na mesma tarefa quando esse trabalho termina; envie uma mensagem se quiser direcioná-lo agora."
          }
        }
      }
    },
