    "canvas.scene_migration.completed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The node keeps its id, name, position, size and connections. The original scene and node were backed up on this device before conversion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点保留原有 ID、名称、位置、尺寸和连线。转换前，本机已备份原始场景与节点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點保留原有 ID、名稱、位置、尺寸和連線。轉換前，本機已備份原始場景與節點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードは ID、名前、位置、サイズ、および接続を保持します。 元のシーンとノードは、変換前にこのデバイスにバックアップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드는 ID, 이름, 위치, 크기 및 연결을 유지합니다. 원본 장면과 노드는 변환하기 전에 이 장치에 백업되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nœud conserve son identifiant, son nom, sa position, sa taille et ses connexions. La scène et le nœud d'origine ont été sauvegardés sur cet appareil avant la conversion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Knoten behält seine ID, seinen Namen, seine Position, seine Größe und seine Verbindungen bei. Die ursprüngliche Szene und der Knoten wurden vor der Konvertierung auf diesem Gerät gesichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nodo mantiene su identificación, nombre, posición, tamaño y conexiones. La escena y el nodo originales se respaldaron en este dispositivo antes de la conversión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nó mantém sua identificação, nome, posição, tamanho e conexões. A cena e o nó originais foram copiados neste dispositivo antes da conversão."
          }
        }
      }
    },
