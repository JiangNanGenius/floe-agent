    "skills.finder.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a reviewed HTTPS skill envelope. Floe validates every file and never executes install hooks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装经审查的 HTTPS 技能包。Floe 会验证每个文件，且不会执行安装钩子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝經審查的 HTTPS 技能包。Floe 會驗證每個檔案，且不會執行安裝鉤子。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビュー済みのHTTPSスキルエンベロープをインストールしてください。 Floeはすべてのファイルを検証し、インストールフックは決して実行しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토된 HTTPS 스킬 봉투를 설치하십시오. Floe는 모든 파일을 검증하고 설치 훅을 실행하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez une enveloppe de compétences HTTPS examinée. Floe valide chaque fichier et n'exécute jamais les crochets d'installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie einen überarbeiteten HTTPS-Fähigkeitsumschlag. Floe validiert jede Datei und führt niemals Installations-Hooks aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale un sobre de habilidades HTTPS revisado. Floe valida todos los archivos y nunca ejecuta los ganchos de instalación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale um envelope de habilidade HTTPS revisado. Floe valida todos os arquivos e nunca executa ganchos de instalação."
          }
        }
      }
    },
