    "settings.data_management_view.partial_scan_warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be read or changed during the scan (%@ errors, %@ vanished). Totals are an estimate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描期间部分文件无法读取或发生变化（%@ 个错误，%@ 个已消失）。总量为估算值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描期間部分檔案無法讀取或發生變化（%@ 個錯誤，%@ 個已消失）。總量為估算值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中に一部のファイルを読み取ったり変更したりできませんでした（%@ エラー、%@ 消失）。 合計は概算です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔 중에 일부 파일을 읽거나 변경할 수 없었습니다 (%@ 오류, %@ 사라진). 총계는 추정치입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers n'ont pas pu être lus ou modifiés pendant l'analyse (erreurs %@, %@ disparu). Les totaux sont une estimation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten während des Scans nicht gelesen oder geändert werden (%@-Fehler, %@ verschwunden). Die Summen sind eine Schätzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos no se pudieron leer o cambiar durante el escaneo (errores %@, %@ desapareció). Los totales son una estimación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser lidos ou alterados durante a verificação (erros %@, %@ desapareceu). Os totais são uma estimativa."
          }
        }
      }
    },
    "settings.data_management_view.pdf_journal_retention": {
