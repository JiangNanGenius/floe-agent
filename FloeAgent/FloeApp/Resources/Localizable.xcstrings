    "app.bilingual.eb8e923c667fdfa3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作尚未完成，文件已保留，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation is incomplete. Files are retained; retry to finish."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作尚未完成，檔案已保留，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は未完成です。 ファイルは保持されています。完了するには再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 완료되지 않았습니다. 파일이 보존되었습니다; 다시 시도하여 완료하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opération est incomplète. Les fichiers sont conservés ; réessayez pour terminer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vorgang ist unvollständig. Dateien werden beibehalten; versuchen Sie erneut, um zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación está incompleta. Los archivos se conservan; inténtalo de nuevo para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A operação está incompleta. Os arquivos são retidos; tente novamente para terminar."
          }
        }
      }
    },
