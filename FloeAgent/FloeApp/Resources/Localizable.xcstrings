    "canvas.scene_migration.approx.lighting_normalized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighting intensity was normalized to the workbench scale; the exact original intensities stay in the saved scene backup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光照强度已按工作台比例归一化；原始精确值保留在场景备份中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "光照強度已按工作臺比例歸一化；原始精確值保留在場景備份中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "照明の強度は作業台スケールに正規化されました；正確な元の強度は保存されたシーンのバックアップに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조명 강도는 작업대 스케일에 맞춰 정규화되었으며, 정확한 원래 강도는 저장된 장면 백업에 그대로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'intensité de l'éclairage a été normalisée à l'échelle de l'établi ; les intensités d'origine exactes restent dans la sauvegarde de la scène enregistrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beleuchtungsintensität wurde auf die Werkbankskala normalisiert; die genauen ursprünglichen Intensitäten bleiben im gespeicherten Szenen-Backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La intensidad de la iluminación se normalizó a la escala del banco de trabajo; las intensidades originales exactas se quedan en el respaldo de la escena guardada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A intensidade da iluminação foi normalizada para a escala da bancada de trabalho; as intensidades originais exatas permanecem no backup da cena salva."
          }
        }
      }
    },
    "canvas.scene_migration.approx.planar_shadow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shadows use a planar ground projection instead of the legacy directional shadow map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影改为平面地面投影，替代旧版方向光阴影贴图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "陰影改為平面地面投影，替代舊版方向光陰影貼圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャドウは、従来の方向性シャドウマップの代わりに平面投影を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자는 기존 방향성 그림자 맵 대신 평면 지면 투영을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ombres utilisent une projection au sol plane au lieu de la carte de l'ombre directionnelle héritée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schatten verwenden eine planare Bodenprojektion anstelle der älteren gerichteten Schattenkarte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sombras utilizan una proyección de tierra plana en lugar del mapa de sombra direccional heredado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sombras usam uma projeção de solo planar em vez do mapa de sombra direcional legado."
          }
        }
      }
    },
    "canvas.scene_migration.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 3D scene was converted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
