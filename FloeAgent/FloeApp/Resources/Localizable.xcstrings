    "app.bilingual.33f6979554b134ff": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档尚未进入可编辑状态，暂时无法应用笔迹参数。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document is not editable yet; ink settings cannot be applied."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件尚未進入可編輯狀態，暫時無法應用筆跡引數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書はまだ編集できません。インク設定を適用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서는 아직 편집할 수 없으며, 잉크 설정을 적용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document n'est pas encore modifiable ; les paramètres d'encre ne peuvent pas être appliqués."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument ist noch nicht bearbeitbar; Tinteneinstellungen können nicht angewendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento aún no es editable; no se pueden aplicar los ajustes de tinta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento ainda não está editável; as configurações de tinta não podem ser aplicadas."
          }
        }
      }
    },
    "app.bilingual.5ce324d997f754a6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请抬笔后再调整画笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift the Pencil before changing pen settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請抬筆後再調整畫筆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンの設定を変更する前に、鉛筆を持ち上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜 설정을 변경하기 전에 연필을 들어 올리세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soulevez le crayon avant de modifier les paramètres du stylo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heben Sie den Stift an, bevor Sie die Stifteinstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Levanta el lápiz antes de cambiar la configuración del bolígrafo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levante o lápis antes de alterar as configurações da caneta."
          }
        }
      }
    },
    "app.bilingual.5843addf7cd33d0c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先轻点文档空白处，取消对象选择后再调整画笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a blank area to deselect the object before changing pen settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先輕點文件空白處，取消物件選擇後再調整畫筆。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペン設定を変更する前に、空白の領域をタップしてオブジェクトの選択を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "펜 설정을 변경하기 전에 객체의 선택을 해제하려면 빈 영역을 탭하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur une zone vide pour désélectionner l'objet avant de modifier les paramètres du stylo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf einen leeren Bereich, um die Auswahl des Objekts aufzuheben, bevor Sie die Stifteinstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque un área en blanco para anular la selección del objeto antes de cambiar la configuración del lápiz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma área em branco para desmarcar o objeto antes de alterar as configurações da caneta."
          }
        }
      }
    },
