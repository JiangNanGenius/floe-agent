    "cad.nodes.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opaque linear-color nodes bake into color, roughness and metallic textures. No scripts or displacement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明的线性色彩节点可烘焙为颜色、粗糙度和金属度纹理。不运行脚本或产生位移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明的線性色彩節點可烘焙為顏色、粗糙度和金屬度紋理。不執行指令碼或產生位移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不透明な線形色のノードは、色、粗さ、金属的なテクスチャに変化します。 スクリプトや変位はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "불투명한 선형 색상 노드가 색상, 거칠음 및 금속 질감으로 변합니다. 스크립트나 변위가 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nœuds de couleur linéaire opaque se cuisent en couleur, en rugosité et en textures métalliques. Pas de scripts ou de déplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Undurchsichtige lineare Farbknoten in Farbe, Rauheit und metallische Texturen. Keine Skripte oder Verschiebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nodos de color lineal opaco se hornean en color, rugosidad y texturas metálicas. Sin guiones ni desplazamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nós de cores lineares opacas se transformam em cores, rugosidade e texturas metálicas. Sem scripts ou deslocamento."
          }
        }
      }
    },
    "cad.nodes.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed. Bake the graph again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源已改变，请重新烘焙节点图。"
