    "providers.save.concurrent_rejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another save for this provider is still in progress. Nothing was written by this attempt; wait for it to finish and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该服务商还有一次保存正在进行。本次没有写入任何内容；请等待完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該服務商還有一次儲存正在進行。本次沒有寫入任何內容；請等待完成後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーの別のセーブはまだ進行中です。 この試みでは何も書かれていませんでした。完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제공자에 대한 또 다른 저장이 아직 진행 중입니다. 이 시도에는 아무것도 쓰여 있지 않았습니다; 완료될 때까지 기다렸다가 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre sauvegarde pour ce fournisseur est toujours en cours. Rien n'a été écrit par cette tentative ; attendez qu'il se termine et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein weiterer Speicherstand für diesen Anbieter ist noch im Gange. Dieser Versuch hat nichts geschrieben; warten Sie, bis es abgeschlossen ist, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro guardado para este proveedor todavía está en curso. No se escribió nada por este intento; espera a que termine e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro salvamento para este provedor ainda está em andamento. Nada foi escrito por esta tentativa; espere terminar e tente novamente."
          }
        }
      }
    },
