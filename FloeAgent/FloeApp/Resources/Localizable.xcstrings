    "chat.temporary.toggle.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a temporary chat. Chats opened this way are kept out of history and cleared when they end; the model provider still processes content under its own policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始临时会话：此类会话不保留在历史记录中，结束或切换后清除；模型提供方仍按其政策处理内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始臨時會話：此類會話不保留在歷史記錄中，結束或切換後清除；模型提供方仍按其政策處理內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットを開始してください。 このように開かれたチャットは履歴から削除され、終了時にクリアされます；モデルプロバイダーは依然として独自のポリシーに基づいてコンテンツを処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 채팅을 시작하십시오. 이와 같이 열린 채팅은 기록에서 제거되며 종료될 때 삭제됩니다; 모델 제공자는 여전히 자체 정책에 따라 콘텐츠를 처리합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez un chat temporaire. Les chats ouverts de cette manière sont gardés hors de l'historique et effacés lorsqu'ils se terminent ; le fournisseur de modèles traite toujours le contenu en vertu de sa propre politique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie einen temporären Chat. Auf diese Weise geöffnete Chats werden aus dem Verlauf herausgehalten und gelöscht, wenn sie enden; der Modellanbieter verarbeitet Inhalte weiterhin unter seiner eigenen Richtlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie un chat temporal. Los chats abiertos de esta manera se mantienen fuera del historial y se borran cuando terminan; el proveedor modelo todavía procesa el contenido bajo su propia política."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie um bate-papo temporário. Os bate-papos abertos dessa maneira são mantidos fora do histórico e apagados quando terminam; o provedor do modelo ainda processa o conteúdo sob sua própria política."
          }
        }
      }
    },
    "chat.temporary.voiceNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice input follows your usual speech settings. Apple recognition may process audio online; Floe does not save recordings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音沿用当前识别设置；Apple 识别可能在线处理，Floe 不保存录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音沿用當前識別設定；Apple 識別可能線上處理，Floe 不儲存錄音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声入力は、通常の音声設定に従います。 Apple の認識はオンラインで音声を処理する可能性があります；Floe は録音を保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 입력은 평소의 음성 설정을 따릅니다. Apple 인식은 온라인에서 오디오를 처리할 수 있습니다; Floe는 녹음을 저장하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'entrée vocale suit vos paramètres de parole habituels. La reconnaissance Apple peut traiter l'audio en ligne ; Floe n'enregistre pas les enregistrements."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracheingabe folgt Ihren üblichen Spracheinstellungen. Die Apple-Anerkennung kann Audio online verarbeiten; Floe speichert keine Aufnahmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La entrada de voz sigue su configuración habitual de voz. El reconocimiento de Apple puede procesar audio en línea; Floe no guarda grabaciones."
