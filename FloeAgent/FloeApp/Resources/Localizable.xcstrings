          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バンドルされた Linux クリーンアップサービスはまだ準備が整っていません。後ほど再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번들된 Linux 정리 서비스가 아직 준비되지 않았습니다; 곧 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de nettoyage Linux fourni n'est pas encore prêt ; réessayez sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
