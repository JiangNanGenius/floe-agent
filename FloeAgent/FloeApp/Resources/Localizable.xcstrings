        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已在其他位置開啟，請先關閉原來的編輯視窗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書はすでに開かれています。 まず、他のエディタを閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 이미 열려 있습니다. 다른 편집기를 먼저 닫으세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document est déjà ouvert. Fermez d'abord son autre éditeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist bereits geöffnet. Schließen Sie zuerst den anderen Editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento ya está abierto. Cierre su otro editor primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento já está aberto. Feche seu outro editor primeiro."
