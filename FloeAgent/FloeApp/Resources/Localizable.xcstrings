        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집된 사본이 보관되었습니다: 미리보기를 다시 시도하거나 편집된 사본을 복원하십시오; 저장하기 전에 페이지 내용을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie modifiée a été conservée : réessayez l'aperçu ou restaurez la copie modifiée ; confirmez le contenu de la page avant d'enregistrer."
