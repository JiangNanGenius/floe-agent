    "app.bilingual.e2e466675669b8a1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择引擎和游戏目录，或导入一个完整工程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an engine and game folder, or import a complete project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇引擎和遊戲目錄，或匯入一個完整工程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンとゲームフォルダーを選択するか、プロジェクト全体をインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진과 게임 폴더를 선택하거나 전체 프로젝트를 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un moteur et un dossier de jeu, ou importez un projet complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Engine- und Spielordner oder importieren Sie ein komplettes Projekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un motor y una carpeta de juegos, o importe un proyecto completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um mecanismo e uma pasta de jogos ou importe um projeto completo."
          }
        }
      }
    },
    "app.bilingual.abecc07bd7c5ad66": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空工程还没有游戏文件。先创建起始模板，或导入已有工程；导入完成后再识别引擎。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The empty project has no game files. Create a starter or import a project; recognition runs after the import."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空工程還沒有遊戲檔案。先建立起始模板，或匯入已有工程；匯入完成後再識別引擎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のプロジェクトにはゲームファイルがありません。 スターターを作成するか、プロジェクトをインポートしてください。認識はインポート後に実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 프로젝트에 게임 파일이 없습니다. 시작을 생성하거나 프로젝트를 가져오십시오; 인식은 가져오기 후에 실행됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet vide n'a pas de fichiers de jeu. Créez un démarreur ou importez un projet ; la reconnaissance s'exécute après l'importation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das leere Projekt hat keine Spieldateien. Erstellen Sie einen Starter oder importieren Sie ein Projekt; die Erkennung läuft nach dem Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto vacío no tiene archivos de juego. Crear un iniciador o importar un proyecto; el reconocimiento se ejecuta después de la importación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto vazio não tem arquivos de jogo. Crie um iniciador ou importe um projeto; o reconhecimento é executado após a importação."
          }
        }
      }
    },
    "app.bilingual.dea9d2c8ac95e19c": {
