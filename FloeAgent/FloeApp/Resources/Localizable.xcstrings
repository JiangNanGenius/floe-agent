    "notes.notes_session.the_cited_material_is_in_trash": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cited material is in Trash; restore it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引用资料在回收站中，请先恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引用資料在回收站中，請先恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用された資料はゴミ箱にありますので、まず復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인용된 자료는 휴지통에 있습니다; 먼저 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel cité est dans la corbeille ; restaurez-le d'abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das zitierte Material befindet sich im Papierkorb; stellen Sie es zuerst wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material citado está en la papelera; restaure primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O material citado está no Lixo; restaure-o primeiro."
          }
        }
      }
    },
    "notes.notes_session.the_cited_page_was_deleted_you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cited page was deleted; you can undo that deletion in the source note."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引用页面已被删除，可以在源手记中撤销相应删除操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引用頁面已被刪除，可以在源手記中撤銷相應刪除操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引用されたページは削除されました。その削除はソースノートで元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인용된 페이지가 삭제되었습니다; 원본 메모에서 해당 삭제를 취소하실 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page citée a été supprimée ; vous pouvez annuler cette suppression dans la note source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zitierte Seite wurde gelöscht; Sie können diese Löschung in der Quellennotiz rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La página citada fue eliminada; puede deshacer esa eliminación en la nota de origen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A página citada foi excluída; você pode desfazer essa exclusão na nota de origem."
          }
        }
      }
    },
    "notes.notes_session.the_current_document_is_not_saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current document is not saved yet; retry saving before switching or closing tabs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前文档尚未保存，请先重试保存，再切换或关闭标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前文件尚未儲存，請先重試儲存，再切換或關閉標籤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のドキュメントはまだ保存されていません。タブを切り替えたり閉じたりする前に、保存を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 문서는 아직 저장되지 않았습니다; 탭을 전환하거나 닫기 전에 저장을 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document actuel n'est pas encore enregistré ; essayez à nouveau d'enregistrer avant de changer ou de fermer les onglets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Dokument ist noch nicht gespeichert. Versuchen Sie das Speichern erneut, bevor Sie die Registerkarten wechseln oder schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento actual aún no se ha guardado; intente volver a guardarlo antes de cambiar o cerrar las pestañas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento atual ainda não foi salvo; tente salvar novamente antes de alternar ou fechar as guias."
          }
        }
      }
    },
