    "setup.creation.canvas.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas can inherit the agent defaults; set them here only if you want a different model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布可继承默认设置，仅在需要不同模型时在此指定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布可繼承預設設定，僅在需要不同模型時在此指定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas はエージェントのデフォルトを継承できます。別のモデルが欲しい場合にのみ、ここで設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas는 에이전트 기본값을 상속받을 수 있습니다; 다른 모델을 원할 경우에만 여기에서 설정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas peut hériter des valeurs par défaut de l'agent ; définissez-les ici uniquement si vous voulez un modèle différent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas kann die Agenten-Standardeinstellungen erben; setzen Sie sie hier nur, wenn Sie ein anderes Modell wünschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas puede heredar los valores predeterminados del agente; constálelos aquí solo si desea un modelo diferente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Canvas pode herdar os padrões do agente; defina-os aqui somente se você quiser um modelo diferente."
          }
        }
      }
    },
