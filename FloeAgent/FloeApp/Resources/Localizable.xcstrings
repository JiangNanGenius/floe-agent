    "app.floe_platform_services.linux_is_already_on_the": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境已经是当前版本，未再次重建；已有资料保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux is already on the current environment; nothing was rebuilt and existing data was kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境已經是當前版本，未再次重建；已有資料保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxはすでに現在の環境にあります；何も再構築されず、既存のデータは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux는 이미 현재 환경에 있으며, 아무것도 재구성되지 않았으며 기존 데이터는 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux est déjà sur l'environnement actuel ; rien n'a été reconstruit et les données existantes ont été conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux befindet sich bereits in der aktuellen Umgebung; nichts wurde neu erstellt und vorhandene Daten wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ya está en el entorno actual; no se reconstruyó nada y se conservaron los datos existentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux já está no ambiente atual; nada foi reconstruído e os dados existentes foram mantidos."
          }
        }
      }
    },
