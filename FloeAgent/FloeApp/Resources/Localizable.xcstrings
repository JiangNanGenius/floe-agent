    },
    "platform.background_run_coordinator.the_provider_task_id_was_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider task ID was not saved before cancellation; whether the provider accepted it is unknown. Check the provider console if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消时尚未保存供应商任务 ID；供应商是否已受理未知，请在需要时核对供应商控制台。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消時尚未儲存供應商任務 ID；供應商是否已受理未知，請在需要時核對供應商控制檯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのタスクIDはキャンセル前に保存されていませんでした；プロバイダーがそれを受け入れたかどうかは不明です。 必要に応じてプロバイダーコンソールを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 작업 ID가 취소 전에 저장되지 않았으며, 제공자가 이를 수락했는지는 알 수 없습니다. 필요한 경우 제공자 콘솔을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ID de la tâche du fournisseur n'a pas été enregistré avant l'annulation ; on ne sait pas si le fournisseur l'a accepté. Vérifiez la console du fournisseur si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Task-ID des Anbieters wurde vor der Stornierung nicht gespeichert; ob der Anbieter sie akzeptiert hat, ist unbekannt. Überprüfen Sie bei Bedarf die Anbieterkonsole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de la tarea del proveedor no se guardó antes de la cancelación; se desconoce si el proveedor lo aceptó. Revise la consola del proveedor si es necesario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID da tarefa do provedor não foi salvo antes do cancelamento; não se sabe se o provedor o aceitou. Verifique o console do provedor, se necessário."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_result_download_link_has_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result download link has expired after its validity period (24 hours); generate it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果下载地址已在有效期（24 小时）后过期，请重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果下載地址已在有效期（24 小時）後過期，請重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果のダウンロードリンクは有効期限（24時間）を過ぎました。再度生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과 다운로드 링크가 유효 기간(24시간) 후 만료되었습니다; 다시 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lien de téléchargement du résultat a expiré après sa période de validité (24 heures) ; générez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ergebnis-Download-Link ist nach seiner Gültigkeitsdauer (24 Stunden) abgelaufen; generieren Sie ihn erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El enlace de descarga del resultado ha caducado después de su período de validez (24 horas); genérelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O link de download do resultado expirou após seu período de validade (24 horas); gere-o novamente."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_selected_image_model_can_generate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected image model can generate at most %@ images at a time; this request asks for %@. Reduce the count or use a model that supports multiple images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片模型单次最多生成 %@ 张图片；当前请求 %@ 张。请减少生成数量，或改用支持多图输出的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選圖片模型單次最多生成 %@ 張圖片；當前請求 %@ 張。請減少生成數量，或改用支援多圖輸出的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された画像モデルは、一度に最大%@画像を生成できます。このリクエストは%@を要求しています。 カウントを減らすか、複数画像に対応したモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 이미지 모델은 한 번에 최대 %@ 이미지를 생성할 수 있으며, 이 요청은 %@를 요구합니다. 카운트를 줄이거나 여러 이미지를 지원하는 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'image sélectionné peut générer au plus des images %@ à la fois ; cette demande demande %@. Réduisez le nombre ou utilisez un modèle qui prend en charge plusieurs images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Bildmodell kann höchstens %@-Bilder auf einmal erzeugen; diese Anforderung fragt nach %@. Reduzieren Sie die Anzahl oder verwenden Sie ein Modell, das mehrere Bilder unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de imagen seleccionado puede generar como máximo imágenes %@ a la vez; esta solicitud solicita %@. Reduzca el recuento o use un modelo que admita múltiples imágenes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de imagem selecionado pode gerar no máximo imagens %@ por vez; esta solicitação pede %@. Reduza a contagem ou use um modelo que suporte várias imagens."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_selected_image_model_supports_up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected image model supports up to %@ reference images; %@ are present. Remove reference images connected to the generation node or change the model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片模型最多支持 %@ 张参考图；当前有 %@ 张。请减少连接到生成节点的参考图，或改用支持更多参考图的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選圖片模型最多支援 %@ 張參考圖；當前有 %@ 張。請減少連線到生成節點的參考圖，或改用支援更多參考圖的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された画像モデルは最大%@参照画像をサポートしており、%@が存在します。 生成ノードに接続された参照画像を削除するか、モデルを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 이미지 모델은 최대 %@ 참조 이미지를 지원합니다; %@가 존재합니다. 생성 노드에 연결된 참조 이미지를 제거하거나 모델을 변경하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'image sélectionné prend en charge jusqu'à des images de référence %@ ; %@ sont présents. Supprimez les images de référence connectées au nœud de génération ou modifiez le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Bildmodell unterstützt bis zu %@ Referenzbilder; %@ sind vorhanden. Entfernen Sie Referenzbilder, die mit dem Generationsknoten verbunden sind, oder ändern Sie das Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de imagen seleccionado admite hasta imágenes de referencia %@; %@ están presentes. Elimine las imágenes de referencia conectadas al nodo de generación o cambie el modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de imagem selecionado suporta até imagens de referência %@; %@ estão presentes. Remova imagens de referência conectadas ao nó de geração ou altere o modelo."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_selected_model_or_provider_does": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected model or provider does not support reference-image editing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选模型或服务商不支持参考图编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選模型或服務商不支援參考圖編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたモデルまたはプロバイダーは、参照画像編集をサポートしていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델 또는 제공자는 참조 이미지 편집을 지원하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle ou le fournisseur sélectionné ne prend pas en charge l'édition d'images de référence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Modell oder Anbieter unterstützt keine Referenzbildbearbeitung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo o proveedor seleccionado no admite la edición de imágenes de referencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ou provedor selecionado não suporta edição de imagem de referência."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_task_already_ended_and_cannot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task already ended (%@) and cannot be canceled. Use video.status to see the final status."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务已结束（%@），无法取消。使用 video.status 查看最终状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該任務已結束（%@），無法取消。使用 video.status 檢視最終狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはすでに終了しており（%@）、キャンセルできません。 Video.status を使用して最終ステータスをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 이미 종료되었습니다 (%@) 그리고 취소할 수 없습니다. Video.status를 사용하여 최종 상태를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche est déjà terminée (%@) et ne peut pas être annulée. Utilisez video.status pour voir l'état final."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe ist bereits beendet (%@) und kann nicht abgebrochen werden. Verwenden Sie video.status, um den endgültigen Status anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea ya ha finalizado (%@) y no se puede cancelar. Usa video.status para ver el estado final."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa já terminou (%@) e não pode ser cancelada. Use video.status para ver o status final."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_task_completed_before_it_was": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task completed before it was canceled; results are downloading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务在取消前已完成，结果正在下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務在取消前已完成，結果正在下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはキャンセルされる前に完了しました；結果はダウンロード中です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 취소되기 전에 완료되었습니다; 결과가 다운로드 중입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche terminée avant d'être annulée ; les résultats sont en cours de téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde abgeschlossen, bevor sie abgebrochen wurde; die Ergebnisse werden heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se completó antes de que se cancelara; los resultados se están descargando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa foi concluída antes de ser cancelada; os resultados estão sendo baixados."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_task_was_canceled_before_provider": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task was canceled before provider confirmation; cancellation of the provider task was attempted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务在供应商确认前已被取消，已尝试取消供应商任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
