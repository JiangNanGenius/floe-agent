          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich ist nicht verfügbar, daher ist die Bearbeitung nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo no está disponible, por lo que la edición no está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho não está disponível, então a edição não está disponível."
          }
        }
      }
    },
    "app.bilingual.209c892e7064cb95": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云工作区文件仅供只读预览，本版本不支持写回原文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud workspace files are preview-only here; writing back is not supported in this version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲工作區檔案僅供只讀預覽，本版本不支援寫回原檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは、クラウドワークスペースファイルはプレビューのみであり、書き戻しはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 워크스페이스 파일은 여기에서 미리 보기 전용이며, 이 버전에서는 다시 쓰기가 지원되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de l'espace de travail Cloud ne sont que des aperçus ici ; la réécriture n'est pas prise en charge dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Arbeitsbereichsdateien können hier nur in der Vorschau angezeigt werden; das Zurückschreiben wird in dieser Version nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del espacio de trabajo en la nube son solo para vista previa aquí; la escritura no es compatible en esta versión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do espaço de trabalho na nuvem são apenas para visualização aqui; a gravação de volta não é suportada nesta versão."
          }
        }
      }
    },
    "app.file_preview_view.is_a_read_only_network": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是只读网络挂载，无法写回文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is a read-only network mount, so the file cannot be written back."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是隻讀網路掛載，無法寫回檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は読み取り専用のネットワークマウントであるため、ファイルを書き戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 읽기 전용 네트워크 마운트이므로 파일을 다시 쓸 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" est un montage réseau en lecture seule, de sorte que le fichier ne peut pas être réécrit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ist eine schreibgeschützte Netzwerkhalterung, so dass die Datei nicht zurückgeschrieben werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" es un montaje de red de solo lectura, por lo que el archivo no se puede volver a escribir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” é uma montagem de rede somente leitura, portanto, o arquivo não pode ser gravado de volta."
          }
        }
