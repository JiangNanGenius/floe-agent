    "settings.content_updates.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed content from the official hub. Updates never grant permissions; approvals stay with you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自官方内容中心的签名内容。更新不会授予权限，授权始终由你确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自官方內容中心的簽名內容。更新不會授予許可權，授權始終由你確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式ハブからの署名済みコンテンツ。 アップデートは決して権限を付与しません。承認はあなたに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 허브의 서명된 콘텐츠. 업데이트는 절대 권한을 부여하지 않으며, 승인은 귀하에게 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu signé du hub officiel. Les mises à jour n'accordent jamais d'autorisations ; les approbations restent avec vous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Signierter Inhalt vom offiziellen Hub. Aktualisierungen erteilen niemals Berechtigungen; Genehmigungen bleiben bei Ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido firmado desde el centro oficial. Las actualizaciones nunca otorgan permisos; las aprobaciones se quedan contigo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo assinado do hub oficial. As atualizações nunca concedem permissões; as aprovações permanecem com você."
          }
        }
      }
    },
