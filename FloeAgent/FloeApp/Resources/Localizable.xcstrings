    "workspace.i_d_e_language_run_view.a_guest_is_already_running_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A guest is already running in this environment but its granted core count cannot be read; to ensure it never silently runs at a different shape, this run requesting %@ cores was rejected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境已有客户机在运行，但无法读取其已授予的内核数；为确保不静默按其他形状运行，请求 %@ 个内核的本次运行已被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該環境已有客戶機在執行，但無法讀取其已授予的核心數；為確保不靜默按其他形狀執行，請求 %@ 個核心的本次執行已被拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストはすでにこの環境で実行されていますが、その許可されたコア数を読み取ることができません。異なる形状で静かに実行されないようにするため、%@ コアを要求するこの実行は拒否されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트가 이미 이 환경에서 실행 중이지만 부여된 코어 수를 읽을 수 없습니다; 다른 형태로 조용히 실행되지 않도록 %@ 코어를 요청하는 이 실행은 거부되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invité est déjà en cours d'exécution dans cet environnement, mais son nombre de cœurs accordé ne peut pas être lu ; pour s'assurer qu'il ne s'exécute jamais silencieusement sous une forme différente, cette exécution demandant des cœurs %@ a été rejetée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Gast wird bereits in dieser Umgebung ausgeführt, aber seine gewährte Kernzahl kann nicht gelesen werden; um sicherzustellen, dass er nie stillschweigend in einer anderen Form ausgeführt wird, wurde dieser Lauf, der %@-Kerne anfordert, abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un invitado ya se está ejecutando en este entorno, pero su recuento de núcleos concedido no se puede leer; para garantizar que nunca se ejecute silenciosamente en una forma diferente, esta ejecución que solicita núcleos %@ fue rechazada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um convidado já está sendo executado neste ambiente, mas sua contagem de núcleos concedida não pode ser lida; para garantir que ele nunca seja executado silenciosamente em uma forma diferente, esta execução solicitando núcleos %@ foi rejeitada."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.an_unresolved_edit_conflict_cancelled_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unresolved edit conflict cancelled the run"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存在未解决的编辑冲突，已取消运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存在未解決的編輯衝突，已取消執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未解決の編集競合により実行がキャンセルされました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해결되지 않은 편집 충돌이 실행을 취소했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conflit d'édition non résolu a annulé l'exécution"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ungelöster Bearbeitungskonflikt hat den Lauf abgebrochen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un conflicto de edición no resuelto canceló la ejecución"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um conflito de edição não resolvido cancelou a execução"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.another_guest_start_is_already_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another guest start is already in progress for this environment; nothing was started for this run. Wait for it to finish and run again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境已有另一次客户机启动正在进行；本次运行未启动任何东西，请等它结束后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該環境已有另一次客戶機啟動正在進行；本次執行未啟動任何東西，請等它結束後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境では、別のゲスト起動がすでに進行中です。この実行では何も開始されませんでした。 完了するまで待ってから、再度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경에 대해 다른 게스트 시작이 이미 진행 중이며, 이번 실행에서는 아무 것도 시작되지 않았습니다. 그것이 완료될 때까지 기다렸다가 다시 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre démarrage d'invité est déjà en cours pour cet environnement ; rien n'a été lancé pour cette course. Attendez qu'il se termine et fonctionne à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein weiterer Gaststart ist bereits für diese Umgebung im Gange; für diesen Lauf wurde nichts gestartet. Warten Sie, bis es fertig ist, und laufen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro inicio de invitado ya está en progreso para este entorno; no se inició nada para esta ejecución. Espera a que termine y vuelve a correr."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro início de convidado já está em andamento para este ambiente; nada foi iniciado para esta execução. Espere terminar e corra novamente."
          }
        }
      }
    },
