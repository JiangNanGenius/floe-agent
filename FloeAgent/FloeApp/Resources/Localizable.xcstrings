    "execution.shared.stop_confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops all local project commands, terminals and web services. Files and installed dependencies are retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将停止所有本机项目中的命令、终端和网页服务。文件和已安装依赖保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將停止所有本機專案中的命令、終端和網頁服務。檔案和已安裝依賴保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのローカルプロジェクトコマンド、ターミナル、およびウェブサービスが停止します。 ファイルとインストールされた依存関係は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 모든 로컬 프로젝트 명령, 터미널 및 웹 서비스를 중단합니다. 파일과 설치된 종속성이 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête toutes les commandes de projet locaux, les terminaux et les services Web. Les fichiers et les dépendances installées sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle lokalen Projektbefehle, Terminals und Webdienste gestoppt. Dateien und installierte Abhängigkeiten werden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene todos los comandos de proyectos locales, terminales y servicios web. Los archivos y las dependencias instaladas se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso interrompe todos os comandos de projetos locais, terminais e serviços da web. Arquivos e dependências instaladas são mantidos."
          }
        }
      }
    },
