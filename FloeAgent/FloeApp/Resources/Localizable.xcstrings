    "cad.datum.missingPoint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A source point is missing. Reselect all three points."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源点已缺失，请重新选择三个点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源點已缺失，請重新選擇三個點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースポイントが欠如しています。 3つのポイントをすべて再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 포인트가 없습니다. 세 가지 항목을 모두 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point source est manquant. Resélectionnez les trois points."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Quellpunkt fehlt. Wählen Sie alle drei Punkte erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta un punto de origen. Vuelve a seleccionar los tres puntos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto de origem está faltando. Selecione novamente todos os três pontos."
          }
        }
      }
    },
    "cad.document.readOnlyAssociation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document uses newer features. Update the app to edit it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档使用了新版功能，请更新 App 后再编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件使用了新版功能，請更新 App 後再編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は新しい機能を使用しています。 アプリを更新して編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 최신 기능을 사용합니다. 앱을 업데이트하여 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document utilise des fonctionnalités plus récentes. Mettez à jour l'application pour la modifier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument verwendet neuere Funktionen. Aktualisieren Sie die App, um sie zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento utiliza características más nuevas. Actualiza la aplicación para editarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento usa recursos mais recentes. Atualize o aplicativo para editá-lo."
          }
        }
      }
    },
    "cad.error.associativeEditRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change would break model references. Adjust the dependent features first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改会破坏模型引用，请先调整依赖它的特征。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改會破壞模型引用，請先調整依賴它的特徵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更はモデル参照を壊すことになります。 まず、依存する機能を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
