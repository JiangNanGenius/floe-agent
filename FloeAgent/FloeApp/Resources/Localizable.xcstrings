    "app.bilingual.88be972fc4f81702": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "引脚位置或映射不兼容，请保留原元件并手动调整连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin positions or mapping are incompatible. Keep the original part and adjust connections explicitly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引腳位置或對映不相容，請保留原元件並手動調整連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピンの位置やマッピングは互換性がありません。 元の部品を保持し、接続を明示的に調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핀 위치 또는 매핑이 호환되지 않습니다. 원본 부품을 유지하고 연결을 명시적으로 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions des broches ou la cartographie sont incompatibles. Conservez la pièce d'origine et ajustez explicitement les connexions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin-Positionen oder Zuordnungen sind nicht kompatibel. Behalten Sie das Originalteil und passen Sie die Anschlüsse explizit an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones de pines o el mapeo son incompatibles. Mantenga la pieza original y ajuste las conexiones explícitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições dos pinos ou o mapeamento são incompatíveis. Mantenha a peça original e ajuste as conexões explicitamente."
          }
        }
      }
    },
