    "ide.process.stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor stopped unexpectedly. Unsaved changes may not have reached disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器意外停止，未保存的更改可能尚未写入文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器意外停止，未儲存的更改可能尚未寫入檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集者は予期せず停止しました。 保存されていない変更がディスクに届いていない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자가 예기치 않게 멈추었습니다. 저장되지 않은 변경 사항이 디스크에 도달하지 않았을 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur s'est arrêté de façon inattendue. Les modifications non enregistrées peuvent ne pas avoir atteint le disque."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Redakteur hörte unerwartet auf. Nicht gespeicherte Änderungen sind möglicherweise nicht auf der Festplatte angekommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor se detuvo inesperadamente. Es posible que los cambios no guardados no hayan llegado al disco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor parou inesperadamente. Alterações não salvas podem não ter chegado ao disco."
          }
        }
      }
    },
    "ide.resources.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IDE resources are missing."
