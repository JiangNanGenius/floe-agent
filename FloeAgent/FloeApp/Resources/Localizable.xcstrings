    "app.bilingual.653b8feea3d61d9b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交后未收到可下载的图片；无法确认服务商是否已生成，不会自动重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No downloadable image was returned after submission; the provider outcome is unknown and it will not be retried automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交後未收到可下載的圖片；無法確認服務商是否已生成，不會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信後にダウンロード可能な画像が返されませんでした；プロバイダーの結果は不明であり、自動的に再送されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출 후 다운로드 가능한 이미지가 반환되지 않았으며, 제공자의 결과는 알 수 없고 자동으로 재시도되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image téléchargeable n'a été renvoyée après la soumission ; le résultat du fournisseur est inconnu et il ne sera pas réessayé automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Einreichung wurde kein herunterladbares Bild zurückgegeben; das Ergebnis des Anbieters ist unbekannt und wird nicht automatisch erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se devolvió ninguna imagen descargable después del envío; el resultado del proveedor es desconocido y no se volverá a intentar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma imagem para download foi retornada após o envio; o resultado do provedor é desconhecido e não será tentado novamente automaticamente."
          }
        }
      }
    },
    "app.bilingual.bf859239628d0dd7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待图片结果时被中断；不会自动重新提交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted while waiting for image results; it will not be resubmitted automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待圖片結果時被中斷；不會自動重新提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像結果の待機中に中断されました。自動的に再提出されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 결과를 기다리는 중에 중단되었습니다; 자동으로 재제출되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompu en attendant les résultats de l'image ; il ne sera pas soumis à nouveau automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird während des Wartens auf die Bildergebnisse unterbrochen; es wird nicht automatisch erneut eingereicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrumpido mientras se esperan los resultados de la imagen; no se volverá a enviar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido enquanto aguardava os resultados da imagem; não será reenviado automaticamente."
          }
        }
      }
    },
