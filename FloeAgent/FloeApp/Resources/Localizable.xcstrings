    "memory.memory_view.pending_capacity_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the most recent pending memories. Older items are discarded when the limit is reached."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最近的待确认记忆，超出上限时自动丢弃最早的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留最近的待確認記憶，超出上限時自動丟棄最早的專案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の保留中の記憶を保持します。 古い項目は、上限に達した際に破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근에 보류 중인 기억을 보관합니다. 제한에 도달하면 오래된 항목은 폐기됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les souvenirs en attente les plus récents. Les articles plus anciens sont jetés lorsque la limite est atteinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die neuesten ausstehenden Erinnerungen. Ältere Gegenstände werden verworfen, wenn das Limit erreicht ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene los recuerdos pendientes más recientes. Los artículos más antiguos se descartan cuando se alcanza el límite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém as memórias pendentes mais recentes. Itens mais antigos são descartados quando o limite é atingido."
          }
        }
      }
    },
