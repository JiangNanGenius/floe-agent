    "app.bilingual.1d299c6adbe923f6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止等待只停止本地刷新；取消会请求远端真正取消。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop waiting only stops local refreshes; cancel requests a real remote cancellation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止等待只停止本地重新整理；取消會請求遠端真正取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機停止はローカルリフレッシュのみを停止し、キャンセルは実際のリモートキャンセルを要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중지를 멈추면 로컬 새로 고침만 중단됩니다; 취소 요청은 실제 원격 취소입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter d'attendre n'arrête que les rafraîchissements locaux ; annuler les demandes une véritable annulation à distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie das Warten stoppt nur lokale Aktualisierungen; Stornierungsanfragen für eine echte Remote-Stornierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de esperar solo detiene las actualizaciones locales; la cancelación solicita una cancelación remota real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de esperar apenas interrompe atualizações locais; solicitações de cancelamento um cancelamento remoto real."
          }
        }
      }
    },
