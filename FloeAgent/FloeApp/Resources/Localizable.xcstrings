    "app.bilingual.5f3a52a6ac98e36b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有未保存或待评审的缓冲区；处理后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some buffers are still unsaved or under review; resolve them and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有未儲存或待評審的緩衝區；處理後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のバッファはまだ保存されていないか、レビュー中です。解決して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 버퍼가 아직 저장되지 않거나 검토 중입니다; 이를 해결하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains tampons ne sont toujours pas enregistrés ou en cours d'examen ; résolvez-les et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Puffer sind noch nicht gespeichert oder werden überprüft; beheben Sie sie und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos búferes aún no se guardan o están en revisión; resuélvalos y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns buffers ainda não estão salvos ou em revisão; resolva-os e tente novamente."
          }
        }
      }
    },
