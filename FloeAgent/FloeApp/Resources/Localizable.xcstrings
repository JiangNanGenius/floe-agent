    "app.bilingual.5339384d2ecd9c2b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥只保存在本机钥匙串。费用与额度由你的 Music.AI 账户决定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key stays in this device's Keychain. Costs follow your own Music.AI account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰只儲存在本機鑰匙串。費用與額度由你的 Music.AI 賬戶決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはこのデバイスのキーチェーンに保持されます。 費用はご自身のMusic.AIアカウントに従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 장치의 키체인에 보관됩니다. 비용은 귀하의 Music.AI 계정을 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé reste dans le trousseau de cet appareil. Les coûts suivent votre propre compte Music.AI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel verbleibt im Schlüsselbund dieses Geräts. Die Kosten folgen Ihrem eigenen Music.AI-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave permanece en el llavero de este dispositivo. Los costos siguen su propia cuenta de Music.AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave permanece nas Chaves deste dispositivo. Os custos seguem sua própria conta Music.AI."
          }
        }
      }
    },
