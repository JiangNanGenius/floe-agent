    "execution.language_package_sources.the_software_source_must_be_an": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The software source must be an HTTPS URL without credentials, query parameters or fragments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件源须为不含凭据、查询参数或片段的 HTTPS 地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軟體源須為不含憑據、查詢引數或片段的 HTTPS 地址"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェアのソースは、資格情報、クエリパラメータ、フラグメントを指定しない HTTPS URL である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어 소스는 자격 증명, 쿼리 매개변수 또는 프래그먼트 없이 HTTPS URL이어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source du logiciel doit être une URL HTTPS sans informations d'identification, paramètres de requête ou fragments"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Softwarequelle muss eine HTTPS-URL ohne Anmeldeinformationen, Abfrageparameter oder Fragmente sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente del software debe ser una URL HTTPS sin credenciales, parámetros de consulta o fragmentos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte do software deve ser uma URL HTTPS sem credenciais, parâmetros de consulta ou fragmentos"
          }
        }
      }
    },
