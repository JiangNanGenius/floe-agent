    "app.bilingual.ae146b0813d3e00f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按当前刀路估算切削时间。主轴转速与 C 轴定位分别设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate cutting time from the current paths. Spindle RPM and C-axis positioning are separate settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按當前刀路估算切削時間。主軸轉速與 C 軸定位分別設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の経路から切削時間を見積もってください。 スピンドルRPMとC軸位置決めは別々の設定です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 경로에서 절단 시간을 추정하십시오. 스핀들 RPM과 C축 위치 지정은 별개의 설정입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimer le temps de coupe à partir des chemins actuels. Le RPM de la broche et le positionnement de l'axe C sont des paramètres distincts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schätzen Sie die Schnittzeit von den aktuellen Pfaden. Spindeldrehzahl und Positionierung der C-Achse sind separate Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule el tiempo de corte de las rutas actuales. Las RPM del husillo y el posicionamiento del eje C son configuraciones separadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estime o tempo de corte a partir dos caminhos atuais. O posicionamento da RPM do fuso e do eixo C são configurações separadas."
          }
        }
      }
    },
