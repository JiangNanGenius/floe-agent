    "app.bilingual.c8ae2ac2e454f5df": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更新中。关闭 App 后构建继续，重新打开会同步结果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates automatically. Builds continue with the App closed; reopening syncs the result."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動更新中。關閉 App 後構建繼續，重新開啟會同步結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に更新されます。 ビルドはアプリを閉じたままで続行され、再開すると結果が同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 업데이트됩니다. 앱을 닫은 상태에서 빌드가 계속되며, 다시 열면 결과가 동기화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour automatiques. Les constructions se poursuivent avec l'application fermée ; la réouverture synchronise le résultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch aktualisiert. Builds werden fortgesetzt, wenn die App geschlossen ist; das erneute Öffnen synchronisiert das Ergebnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se actualiza automáticamente. Las compilaciones continúan con la aplicación cerrada; la reapertura sincroniza el resultado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza automaticamente. As compilações continuam com o aplicativo fechado; a reabertura sincroniza o resultado."
          }
        }
      }
    },
