    "providers.model_editor_view.this_is_an_advanced_custom_media": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an advanced custom media model. Size, ratio, duration and quality are filled from the endpoint's actual capabilities at generation time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是高级自定义媒体模型。尺寸、比例、时长和质量会在生成时按端点实际能力填写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是高階自定義媒體模型。尺寸、比例、時長和質量會在生成時按端點實際能力填寫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは高度なカスタムメディアモデルです。 サイズ、比率、期間、品質は、エンドポイントの生成時の実際の能力から埋められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 고급 맞춤형 미디어 모델입니다. 크기, 비율, 지속 시간 및 품질은 생성 시점에 엔드포인트의 실제 용량을 기준으로 채워집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'un modèle de média personnalisé avancé. La taille, le ratio, la durée et la qualité sont remplis à partir des capacités réelles du point de terminaison au moment de la génération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein fortschrittliches benutzerdefiniertes Medienmodell. Größe, Verhältnis, Dauer und Qualität werden von den tatsächlichen Fähigkeiten des Endpunkts zum Zeitpunkt der Generierung ausgefüllt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un modelo de medios personalizado avanzado. El tamaño, la relación, la duración y la calidad se llenan a partir de las capacidades reales del punto final en el momento de la generación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um modelo de mídia personalizado avançado. Tamanho, proporção, duração e qualidade são preenchidos a partir dos recursos reais do ponto final no momento da geração."
          }
        }
      }
    },
