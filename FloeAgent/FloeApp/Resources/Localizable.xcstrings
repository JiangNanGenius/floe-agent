        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el discurso del clip como una nueva pista de subtítulos, conservando los subtítulos existentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o discurso do clipe como uma nova faixa de legenda, mantendo as legendas existentes."
          }
        }
      }
    },
