    "cad.material.target.reselectFaceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection doesn't match one stable face. Reselect a single face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选择无法对应唯一稳定的面。请重新选择一个面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前選擇無法對應唯一穩定的面。請重新選擇一個面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択は1つの安定した顔と一致しません。 単一の顔を再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택은 하나의 안정된 얼굴과 일치하지 않습니다. 단일 얼굴을 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection ne correspond pas à un visage stable. Resélectionnez un seul visage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl passt nicht zu einem stabilen Gesicht. Wählen Sie ein einzelnes Gesicht erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta selección no coincide con una cara estable. Vuelve a seleccionar una sola cara."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seleção não corresponde a um rosto estável. Selecione novamente um único rosto."
          }
        }
      }
    },
    "cad.material.target.reselectHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This selection does not match exactly one analytic face. Reselect a single planar face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前选择无法对应唯一的解析面。请重新选择一个平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
