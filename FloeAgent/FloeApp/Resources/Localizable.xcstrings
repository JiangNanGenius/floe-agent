    "langpkg.inherited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inherited from the Linux image / parent layer (read-only)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继承自 Linux 镜像/父层（只读）"
          }
        }
      }
    },
    "langpkg.node_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs into this environment's own Node modules; environments stay separate. Installing real npm/pnpm packages may run their install scripts, add native binaries and create command shortcuts; on failure the previous packages are kept. The runtimes built into the app are not removed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装到此环境自有的 Node 模块，不同环境彼此隔离。安装真实 npm/pnpm 包时可能运行其安装脚本、添加原生程序并创建命令快捷方式；失败时保留原有软件。App 自带的运行时不会在此卸载。"
          }
        }
      }
    },
    "langpkg.python_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs into this environment's own managed Python packages; this environment's shell, Python tools and this page share one set, and environments stay separate. Prebuilt Linux packages are preferred; source-only packages need build tools inside Linux (the Development & documents template includes them). Packages built into the Linux image are shown read-only under Inherited."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装到此环境自有的受管 Python 软件包：此环境的 Shell、Python 工具与本页共用同一套包，不同环境彼此隔离。优先安装 Linux 预构建包；只有源码的包需要在 Linux 内具备编译工具（开发文档模板已包含）。Linux 镜像自带的包只在“继承”部分只读展示。"
          }
        }
      }
    },
    "langpkg.runtime_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only software installed inside the environment is listed here; runtimes built into the app are not removed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示环境中安装的软件；App 自带的运行时不会在此卸载。"
          }
        }
      }
    },
    "langpkg.writable.node": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This environment's own Node modules (checked live in Linux)"
