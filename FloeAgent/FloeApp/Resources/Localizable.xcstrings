    "settings.licenses.note.office": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Office engine is Collabora Online (LibreOffice-based) at the pinned commit, MPL-2.0. The qualified engine bundle retains its upstream third-party license files; the complete engine notice inventory remains a separate office qualification gate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Office 引擎为固定提交的 Collabora Online（基于 LibreOffice），采用 MPL-2.0。合格引擎包中保留了上游第三方许可文件；完整的引擎声明清单仍是独立的 Office 资格门禁。"
          }
        }
      }
    },
    "settings.licenses.note.verification": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every Swift package license was read from the resolved checkout license file. scripts/license-evidence.json records the exact file and sha256, and the generator re-verifies them when a checkout is present."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
