    "app.bilingual.89f4ce499918dbb5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能的来源已更改，原来源的凭据仍单独保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This skill's source changed. Saved credentials from its previous source are kept separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能的來源已更改，原來源的憑據仍單獨保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキルのソースが変更されました。 以前のソースから保存された認証情報は別々に保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스킬의 출처가 변경되었습니다. 이전 출처의 저장된 자격 증명은 별도로 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source de cette compétence a changé. Les informations d'identification enregistrées à partir de sa source précédente sont conservées séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle dieser Fähigkeit hat sich geändert. Gespeicherte Anmeldeinformationen aus der vorherigen Quelle werden separat aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de esta habilidad cambió. Las credenciales guardadas de su fuente anterior se mantienen por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte dessa habilidade mudou. As credenciais salvas de sua fonte anterior são mantidas separadamente."
          }
        }
      }
    },
