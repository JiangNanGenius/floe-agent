    "app.bilingual.76f6d62d3d2dbcd4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应刀具需填写量规长度。保留旋转分支，不可达会明确失败。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tool needs a gauge length. Rotary branches are preserved; unreachable poses fail explicitly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應刀具需填寫量規長度。保留旋轉分支，不可達會明確失敗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールにはゲージの長さが必要です。 回転枝は保存されます；到達できない姿勢は明示的に失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도구는 게이지 길이가 필요합니다. 회전 지점은 보존됩니다; 도달할 수 없는 자세는 명시적으로 실패합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'outil a besoin d'une longueur de jauge. Les branches rotatives sont préservées ; les poses inaccessibles échouent explicitement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Werkzeug benötigt eine Messlänge. Rotationszweige bleiben erhalten; unerreichbare Posen versagen explizit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta necesita una longitud de calibre. Las ramas giratorias se conservan; las poses inalcanzables fallan explícitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta precisa de um comprimento de calibre. Ramos rotativos são preservados; poses inatingíveis falham explicitamente."
          }
        }
      }
    },
