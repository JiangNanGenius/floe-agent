    "workspace.workspace_canvas_view.image_the_image_could_not_be": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image %@: the image could not be understood (%@). Do not retry the visual read; tell the user directly how to configure a compatible canvas vision model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片 %@：无法理解图片（%@）。不要重试视觉读取；直接告诉用户如何配置兼容的画布视觉模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片 %@：無法理解圖片（%@）。不要重試視覺讀取；直接告訴使用者如何配置相容的畫布視覺模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像 %@: 画像が理解できませんでした (%@)。 視覚的な読み取りを再試行しないでください；ユーザーに直接、互換性のあるキャンバスビジョンモデルの設定方法を伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 %@: 이미지를 이해할 수 없습니다 (%@). 시각적 읽기를 다시 시도하지 말고, 사용자에게 호환 가능한 캔버스 비전 모델을 구성하는 방법을 직접 알려 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Image %@ : l'image n'a pas pu être comprise (%@). N'essayez pas la lecture visuelle ; dites directement à l'utilisateur comment configurer un modèle de vision de toile compatible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild %@: Das Bild konnte nicht verstanden werden (%@). Versuchen Sie das visuelle Lesen nicht erneut; sagen Sie dem Benutzer direkt, wie er ein kompatibles Canvas-Vision-Modell konfigurieren kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagen %@: la imagen no se pudo entender (%@). No vuelva a intentar la lectura visual; dígale al usuario directamente cómo configurar un modelo de visión de lienzo compatible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagem %@: a imagem não pôde ser entendida (%@). Não tente novamente a leitura visual; diga ao usuário diretamente como configurar um modelo de visão de tela compatível."
          }
        }
      }
    },
