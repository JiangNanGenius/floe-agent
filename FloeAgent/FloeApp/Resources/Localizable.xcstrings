    "settings.files.clear_cache.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes cached previews and temporary exports. Workspaces and conversations are not touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除缓存的预览与临时导出，不影响工作区与对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除快取的預覽與臨時匯出，不影響工作區與對話。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたプレビューと一時的なエクスポートを削除します。 ワークスペースと会話は触れられていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 미리보기와 임시 내보내기를 제거합니다. 작업 공간과 대화는 손대지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les aperçus mis en cache et les exportations temporaires. Les espaces de travail et les conversations ne sont pas touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt zwischengespeicherte Vorschauen und temporäre Exporte. Arbeitsbereiche und Unterhaltungen werden nicht berührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina las vistas previas almacenadas en caché y las exportaciones temporales. Los espacios de trabajo y las conversaciones no se tocan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove visualizações em cache e exportações temporárias. Espaços de trabalho e conversas não são tocados."
          }
        }
      }
    },
