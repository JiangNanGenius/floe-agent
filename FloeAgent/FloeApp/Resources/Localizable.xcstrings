    "memory.memory_view.memories_let_the_assistant_remember_your": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memories let the assistant remember your preferences across conversations. Add the first one below, or tell it to “remember…” in a chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆让助手跨对话记住你的偏好。点下方添加第一条，或在对话中让它「记住…」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶讓助手跨對話記住你的偏好。點下方新增第一條，或在對話中讓它「記住…」。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリは、アシスタントが会話全体であなたの好みを記憶することを可能にします。 下の最初のものを追加するか、チャットで「remember...」と伝えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리는 어시스턴트가 대화 전반에 걸쳐 귀하의 선호도를 기억하도록 합니다. 아래 첫 번째를 추가하거나, 채팅에서 “기억하세요...”라고 말하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les souvenirs ont laissé l'assistant se souvenir de vos préférences à travers les conversations. Ajoutez le premier ci-dessous, ou dites-lui de « se souvenir... » dans un chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen können sich der Assistent an Ihre Präferenzen über Unterhaltungen hinweg erinnern. Fügen Sie den ersten unten hinzu oder sagen Sie ihm, dass er sich in einem Chat \"erinnern...\" soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuerdos le dejan al asistente recordar tus preferencias a través de las conversaciones. Añade el primero a continuación, o dile que \"recuerde...\" en un chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memórias mam que o assistente se lembre de suas preferências em todas as conversas. Adicione o primeiro abaixo, ou diga a ele para “lembrar...” em um bate-papo."
          }
        }
      }
    },
