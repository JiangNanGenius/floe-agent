    "app.bilingual.60d3d2f3258839d5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先创建空的游戏工程。进入工程后再选择或确认真实引擎和游戏目录，创建起始模板或导入已有工程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty game project is created first. Choose or confirm the real engine and game folder inside the project, then create a starter or import an existing project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先建立空的遊戲工程。進入工程後再選擇或確認真實引擎和遊戲目錄，建立起始模板或匯入已有工程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のゲームプロジェクトが最初に作成されます。 プロジェクト内の実際のエンジンとゲームフォルダーを選択または確認し、次にスターターを作成するか、既存のプロジェクトをインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 게임 프로젝트가 먼저 생성됩니다. 프로젝트 내에서 실제 엔진 및 게임 폴더를 선택하거나 확인한 후, 스타터를 생성하거나 기존 프로젝트를 가져오십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un projet de jeu vide est d'abord créé. Choisissez ou confirmez le vrai moteur et le dossier de jeu à l'intérieur du projet, puis créez un démarreur ou importez un projet existant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst wird ein leeres Spielprojekt erstellt. Wählen oder bestätigen Sie die echte Engine und den Spielordner innerhalb des Projekts, erstellen Sie dann einen Starter oder importieren Sie ein vorhandenes Projekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se crea un proyecto de juego vacío. Elija o confirme el motor real y la carpeta del juego dentro del proyecto, luego cree un inicio o importe un proyecto existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
