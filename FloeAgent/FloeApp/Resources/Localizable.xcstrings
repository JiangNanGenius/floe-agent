          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止本次本地執行"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルランを停止しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 실행을 중단했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêté cette course locale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Habe diesen lokalen Lauf gestoppt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detuvo esta carrera local"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parou essa corrida local"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_current_image_manifest_does_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current image manifest does not certify support for %@ cores, so the resource pool rejects the request; it never silently runs with fewer cores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前镜像清单没有证明支持 %@ 核，资源池会拒绝该请求；不会静默降核运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前映象清單沒有證明支援 %@ 核，資源池會拒絕該請求；不會靜默降核執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のイメージマニフェストは %@ コアのサポートを認証していないため、リソースプールはリクエストを拒否します。また、少数のコアで静かに実行されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이미지 매니페스트는 %@ 코어에 대한 지원을 인증하지 않으므로 리소스 풀은 요청을 거부합니다; 코어 수가 적은 상태로 조용히 실행되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le manifeste d'image actuel ne certifie pas la prise en charge des cœurs %@, de sorte que le pool de ressources rejette la demande ; il ne s'exécute jamais silencieusement avec moins de cœurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Image-Manifest zertifiziert nicht die Unterstützung für %@-Kerne, so dass der Ressourcenpool die Anforderung ablehnt; er wird nie stillschweigend mit weniger Kernen ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El manifiesto de imagen actual no certifica el soporte para los núcleos %@, por lo que el grupo de recursos rechaza la solicitud; nunca se ejecuta silenciosamente con menos núcleos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O manifesto de imagem atual não certifica suporte para núcleos %@, então o pool de recursos rejeita a solicitação; ele nunca é executado silenciosamente com menos núcleos."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_do_not_ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals do not ask for parallelism: this run starts with 1 guest core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号未要求并行：本次以 1 个客户机内核启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "宣告訊號未要求並行：本次以 1 個客戶機核心啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宣言されたシグナルは並列性を求めません：この実行は1つのゲストコアで開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언된 신호는 병렬성을 요구하지 않습니다: 이 실행은 1개의 게스트 코어로 시작합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signaux déclarés ne demandent pas de parallélisme : cette exécution commence avec 1 noyau invité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die deklarierten Signale fragen nicht nach Parallelität: Dieser Lauf beginnt mit 1 Gastkern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las señales declaradas no piden paralelismo: esta ejecución comienza con 1 núcleo de invitado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sinais declarados não pedem paralelismo: esta execução começa com 1 núcleo de convidado."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_recommend_2_cores": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals recommend 2 cores, but only 1 can be delivered. This run starts with 1 guest core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号推荐 2 核，但当前只能交付 1 核。本次将以 1 个客户机内核启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "宣告訊號推薦 2 核，但當前只能交付 1 核。本次將以 1 個客戶機核心啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宣言されたシグナルは2コアを推奨していますが、1コアしか供給できません。 このランは1つのゲストコアから開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언된 신호는 2개의 코어를 권장하지만, 오직 1개만 전달할 수 있습니다. 이 실행은 1개의 게스트 코어로 시작합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signaux déclarés recommandent 2 cœurs, mais un seul peut être livré. Cette exécution commence avec 1 noyau invité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die deklarierten Signale empfehlen 2 Kerne, aber nur 1 kann geliefert werden. Dieser Lauf beginnt mit 1 Gastkern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las señales declaradas recomiendan 2 núcleos, pero solo se puede entregar 1. Esta ejecución comienza con 1 núcleo de invitado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sinais declarados recomendam 2 núcleos, mas apenas 1 pode ser entregue. Esta corrida começa com 1 núcleo de convidado."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_support_parallelism_this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals support parallelism: this will start with 2 guest cores. Dual-core has passed S0–S4 correctness, but equivalent-work benchmarks are slower on 2 cores (about %@); use it only when the task genuinely benefits from parallelism."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号表明可并行：本次将以 2 个客户机内核启动。双核已通过 S0–S4 正确性验证，但等量工作基准在 2 核上更慢（约 %@）；仅在任务确实受益于并行时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "宣告訊號表明可並行：本次將以 2 個客戶機核心啟動。雙核已透過 S0–S4 正確性驗證，但等量工作基準在 2 核上更慢（約 %@）；僅在任務確實受益於並行時使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宣言されたシグナルは並列性をサポートしています：これは2つのゲストコアから開始されます。 デュアルコアは S0–S4 の正確性を超えましたが、等価作業ベンチマークは 2 コア（約 %@）で遅くなります。タスクが実際に並列性の恩恵を受ける場合にのみ使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언된 신호는 병렬성을 지원합니다: 이는 2개의 게스트 코어로 시작됩니다. 듀얼 코어는 S0–S4 정확성을 통과했지만, 동등한 작업 벤치마크는 2코어(약 %@)에서 더 느립니다; 작업이 실제로 병렬성을 활용할 수 있을 때만 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signaux déclarés prennent en charge le parallélisme : cela commencera par 2 cœurs invités. Le double cœur a passé l'exactitude S0-S4, mais les repères de travail équivalent sont plus lents sur 2 cœurs (environ %@) ; utilisez-le uniquement lorsque la tâche bénéficie vraiment du parallélisme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die deklarierten Signale unterstützen die Parallelität: Dies beginnt mit 2 Gastkernen. Dual-Core hat die S0-S4-Korrektur überschritten, aber Benchmarks für gleichwertige Arbeit sind auf 2 Kernen langsamer (etwa %@); verwenden Sie es nur, wenn die Aufgabe wirklich von Parallelität profitiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las señales declaradas admiten el paralelismo: esto comenzará con 2 núcleos invitados. El núcleo dual ha pasado la corrección S0-S4, pero los puntos de referencia de trabajo equivalente son más lentos en 2 núcleos (alrededor de %@); úselo solo cuando la tarea se beneficie genuinamente del paralelismo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sinais declarados suportam paralelismo: isso começará com 2 núcleos de convidados. O dual-core passou a correção S0–S4, mas os benchmarks de trabalho equivalente são mais lentos em 2 núcleos (cerca de %@); use-o apenas quando a tarefa realmente se beneficiar do paralelismo."
          }
        }
      }
    },
