        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の変更が完了しています。 両方のファイルは保持されています。完了するには再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 바꾸기가 완료되지 않았습니다. 두 파일이 모두 보존되어 있습니다; 다시 시도하여 완료하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le renom est incomplet. Les deux fichiers sont conservés ; réessayez pour terminer."
          }
