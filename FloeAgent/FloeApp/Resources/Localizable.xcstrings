    "app.bilingual.59c9c33ac097347a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有匹配的已转换记录。可显示待复核项，但它们不能安装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching converted records. Review-required records can be shown but cannot be installed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有匹配的已轉換記錄。可顯示待複核項，但它們不能安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致する変換されたレコードがありません。 レビューが必要なレコードは表示できますが、インストールできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 변환된 레코드가 없습니다. 검토가 필요한 레코드는 표시할 수 있지만 설치할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'enregistrements convertis correspondants. Les enregistrements requis pour l'examen peuvent être affichés, mais ne peuvent pas être installés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine übereinstimmenden konvertierten Datensätze. Die für die Überprüfung erforderlichen Datensätze können angezeigt, aber nicht installiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay registros convertidos coincidentes. Los registros requeridos para la revisión se pueden mostrar, pero no se pueden instalar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum registro convertido correspondente. Os registros necessários para revisão podem ser mostrados, mas não podem ser instalados."
          }
        }
      }
    },
    "app.bilingual.50658c4e90027aff": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录需要先复核，不能直接安装。原始记录仍可查看或下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record needs review and cannot be installed directly. Its original record remains readable and downloadable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此記錄需要先複核，不能直接安裝。原始記錄仍可檢視或下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレコードはレビューが必要で、直接インストールすることはできません。 その元の記録は依然として読みやすく、ダウンロード可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레코드는 검토가 필요하며 직접 설치할 수 없습니다. 원본 기록은 여전히 읽을 수 있고 다운로드할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement doit être examiné et ne peut pas être installé directement. Son disque original reste lisible et téléchargeable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz muss überprüft werden und kann nicht direkt installiert werden. Die Originalaufzeichnung bleibt lesbar und herunterladbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro necesita revisión y no se puede instalar directamente. Su registro original sigue siendo legible y descargable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro precisa de revisão e não pode ser instalado diretamente. Seu registro original permanece legível e para download."
          }
        }
      }
    },
