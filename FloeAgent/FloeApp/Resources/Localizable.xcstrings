    "localmodels.apple_foundation_model_runtime.this_conversation_exceeds_the_apple_intelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation exceeds the Apple Intelligence model's capacity; compact the conversation and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前对话超出 Apple Intelligence 模型的容量，请先整理对话后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前對話超出 Apple Intelligence 模型的容量，請先整理對話後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話はApple Intelligenceモデルの容量を超えています。会話をコンパクトにして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 Apple Intelligence 모델의 용량을 초과합니다; 대화를 압축하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation dépasse la capacité du modèle Apple Intelligence ; compactez la conversation et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung überschreitet die Kapazität des Apple Intelligence-Modells; verdichten Sie die Konversation und versuchen Sie es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación excede la capacidad del modelo Apple Intelligence; compacta la conversación e inténtalo de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa excede a capacidade do modelo Apple Intelligence; compacte a conversa e tente novamente"
          }
        }
      }
    },
