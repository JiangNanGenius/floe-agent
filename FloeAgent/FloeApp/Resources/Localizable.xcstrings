    "cad.shell.pickHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this panel, then tap wall faces. Other faces keep the common thickness."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭面板后点选壁面，其他面沿用统一壁厚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉面板後點選壁面，其他面沿用統一壁厚。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパネルを閉じてから、壁の面をタップしてください。 他の面は共通の厚さを保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패널을 닫은 다음, 벽면을 탭하십시오. 다른 얼굴들은 일반적인 두께를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermez ce panneau, puis appuyez sur les faces murales. Les autres faces conservent l'épaisseur commune."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie dieses Panel, und tippen Sie dann auf die Wandflächen. Andere Flächen behalten die übliche Dicke."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra este panel y, a continuación, pulsa los rostros de la pared. Otras caras mantienen el grosor común."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feche este painel e toque em faces de parede. Outras faces mantêm a espessura comum."
          }
        }
      }
    },
