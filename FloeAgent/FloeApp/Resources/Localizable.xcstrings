    "cad.present.error.framing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This view doesn’t fit the current window. Rotate the screen or resize the window and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前窗口无法完整显示此视角。请旋转屏幕或调整窗口大小后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前視窗無法完整顯示此視角。請旋轉螢幕或調整視窗大小後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビューは現在のウィンドウに適合しません。 画面を回転させるか、ウィンドウのサイズを変更して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 뷰는 현재 창에 맞지 않습니다. 화면을 회전하거나 창의 크기를 조정한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vue ne correspond pas à la fenêtre actuelle. Faites pivoter l'écran ou redimensionnez la fenêtre et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ansicht passt nicht zum aktuellen Fenster. Drehen Sie den Bildschirm oder ändern Sie die Größe des Fensters und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista no se ajusta a la ventana actual. Gire la pantalla o redimensione la ventana e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta visualização não se encaixa na janela atual. Gire a tela ou redimensione a janela e tente novamente."
          }
        }
      }
    },
    "cad.present.error.notActive": {
