    "workspace.i_d_e_language_run_view.the_guest_in_this_environment_is": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest in this environment is running with %@ cores, which differs from the requested %@; this request was rejected without restarting or changing the running guest. Stop the guest first, then start it at the new shape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境的客户机正在以 %@ 个内核运行，与请求的 %@ 个内核不一致；已拒绝本次请求，未重启或改变正在运行的客户机。请先停止该客户机，再以新形状启动。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_host_did_not_acknowledge_the": {
