          "stringUnit": {
            "state": "translated",
            "value": "그리기 가져오기를 사용할 수 없습니다. 이 작업을 다시 열고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation du dessin n'est pas disponible. Rouvrir ce travail et réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeichnungsimport ist nicht verfügbar. Öffnen Sie diese Arbeit erneut und versuchen Sie es erneut."
