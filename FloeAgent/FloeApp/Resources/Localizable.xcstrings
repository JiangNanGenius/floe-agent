          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Intervall überschreitet die 128 MiB Upload-Begrenzte. Kürzen Sie es und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El intervalo seleccionado supera el límite de carga de 128 MiB. Acorta y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O intervalo selecionado excede o limite de upload de 128 MiB. Encurte e tente novamente."
