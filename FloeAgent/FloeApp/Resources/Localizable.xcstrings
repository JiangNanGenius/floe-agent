    "cad.loftSurface.guideHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guide must meet every section. Use up to eight parallel sections without inner loops. The surface is checked to a tolerance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导轨须与每个截面相交。最多使用八个平行且无内环的截面，结果按容差检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導軌須與每個截面相交。最多使用八個平行且無內環的截面，結果按容差檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガイドはすべてのセクションを満たさなければなりません。 内部ループなしで、最大8つの平行セクションをご使用ください。 表面は許容範囲まで検査されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가이드는 모든 섹션을 충족해야 합니다. 내부 루프 없이 최대 8개의 평행 구간을 사용하십시오. 표면이 허용 오차로 확인됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guide doit respecter chaque section. Utilisez jusqu'à huit sections parallèles sans boucles intérieures. La surface est vérifiée pour une tolérance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Leitfaden muss jeden Abschnitt erfüllen. Verwenden Sie bis zu acht parallele Abschnitte ohne innere Schleifen. Die Oberfläche wird auf eine Toleranz geprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guía debe cumplir con cada sección. Utilice hasta ocho secciones paralelas sin bucles internos. Se comprueba la superficie para una tolerancia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O guia deve atender a todas as seções. Use até oito seções paralelas sem loops internos. A superfície é verificada para uma tolerância."
          }
        }
      }
    },
