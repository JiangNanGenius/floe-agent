          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renombre está incompleto. Ambos archivos se conservan; inténtalo de nuevo para terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renomear está incompleto. Ambos os arquivos são mantidos; tente novamente para terminar."
          }
        }
      }
