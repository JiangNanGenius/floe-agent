    "workbench.task_inspector_views.the_task_remains_limited_by_workspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task remains limited by workspace and tool scope; catastrophic commands are always blocked."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务仍受工作区和工具范围限制；灾难性命令始终阻止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務仍受工作區和工具範圍限制；災難性命令始終阻止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはワークスペースとツールの範囲によって制限されたままであり、壊滅的なコマンドは常にブロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 작업 공간 및 도구 범위에 의해 제한되며, 치명적인 명령은 항상 차단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche reste limitée par l'espace de travail et la portée de l'outil ; les commandes catastrophiques sont toujours bloquées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe bleibt durch Arbeitsbereich und Werkzeugumfang begrenzt; katastrophale Befehle werden immer blockiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea permanece limitada por el espacio de trabajo y el alcance de la herramienta; los comandos catastróficos siempre están bloqueados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa permanece limitada pelo espaço de trabalho e pelo escopo da ferramenta; comandos catastróficos são sempre bloqueados."
          }
        }
      }
    },
