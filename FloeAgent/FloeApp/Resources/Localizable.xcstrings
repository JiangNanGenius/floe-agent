    "screenshare.screen_share_center.could_not_request_system_screen_sharing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not request system screen-sharing approval; restart the task and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发起系统屏幕共享确认，请重新开始任务后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法發起系統螢幕共享確認，請重新開始任務後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム画面共有の承認を要求できませんでした。タスクを再起動し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 화면 공유 승인을 요청할 수 없습니다; 작업을 다시 시작하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de demander l'approbation du partage d'écran du système ; redémarrez la tâche et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Genehmigung für die Bildschirmfreigabe des Systems konnte nicht angefordert werden. Starten Sie die Aufgabe neu und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo solicitar la aprobación del sistema para compartir la pantalla; reinicie la tarea e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível solicitar a aprovação do compartilhamento de tela do sistema; reinicie a tarefa e tente novamente."
          }
        }
      }
    },
    "screenshare.screen_share_center.no_broadcast_footage_has_been_received": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No broadcast footage has been received yet. Confirm Floe Agent is selected in the system list and tap “Start Broadcast”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未收到系统广播画面。请确认已在系统列表中选择 Floe Agent 并点“开始直播”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未收到系統廣播畫面。請確認已在系統列表中選擇 Floe Agent 並點“開始直播”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放送映像はまだ受領されていません。 システムリストで Floe エージェントが選択されていることを確認し、「Start Broadcast」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 방송 영상이 접수되지 않았습니다. 시스템 목록에서 Floe 에이전트가 선택되어 있는지 확인하고 “Start Broadcast”를 탭하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image de diffusion n'a encore été reçue. Vérifiez que l'agent Floe est sélectionné dans la liste système et appuyez sur « Démarrer la diffusion »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind noch keine Sendungsaufnahmen eingegangen. Bestätigen Sie, dass Floe Agent in der Systemliste ausgewählt ist, und tippen Sie auf \"Sendung starten\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han recibido imágenes de transmisión. Confirme que el agente Floe está seleccionado en la lista del sistema y toque \"Iniciar transmisión\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma filmagem de transmissão foi recebida ainda. Confirme se o Agente Floe está selecionado na lista do sistema e toque em “Iniciar Transmissão”."
          }
        }
      }
    },
