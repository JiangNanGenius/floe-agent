    "notes.notes_store.the_recovery_copy_already_has_newer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery copy already has newer changes; keep both versions and continue in the copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复副本已有新的修改；请保留两个版本，在副本中继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復副本已有新的修改；請保留兩個版本，在副本中繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリコピーにはすでに新しい変更が含まれています。両方のバージョンを保持し、コピー内で続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 복사본에는 이미 새로운 변경 사항이 포함되어 있습니다; 두 버전을 모두 유지하고 복사본에서 계속 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie de récupération a déjà des modifications plus récentes ; conservez les deux versions et continuez dans la copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungskopie hat bereits neuere Änderungen; behalten Sie beide Versionen bei und fahren Sie in der Kopie fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de recuperación ya tiene cambios más recientes; mantenga ambas versiones y continúe en la copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia de recuperação já tem alterações mais recentes; mantenha ambas as versões e continue na cópia."
          }
        }
      }
    },
