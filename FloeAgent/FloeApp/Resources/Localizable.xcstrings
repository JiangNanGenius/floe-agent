    "app.bilingual.b56eaade575b6c68": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务已启动，但无法确认其当前工作区归属；请到“服务”中查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service started, but its current workspace ownership could not be confirmed; check Services."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務已啟動，但無法確認其當前工作區歸屬；請到“服務”中檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスは開始されましたが、現在のワークスペースの所有権を確認できませんでした。サービスをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 시작되었지만 현재 작업 공간 소유자를 확인할 수 없습니다; 서비스를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service a commencé, mais la propriété actuelle de son espace de travail n'a pas pu être confirmée ; vérifiez les services."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst wurde gestartet, aber der aktuelle Arbeitsplatzbesitz konnte nicht bestätigt werden. Überprüfen Sie die Dienste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio se inició, pero no se pudo confirmar la propiedad actual del espacio de trabajo; consulte Servicios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço foi iniciado, mas a propriedade atual do espaço de trabalho não pôde ser confirmada; verifique Serviços."
          }
        }
      }
    },
    "app.bilingual.f3b08ff0c2d78d17": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于 UI 验收：模拟的服务作业，不执行真实 Linux 服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI acceptance only: a simulated service job; no real Linux service runs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於 UI 驗收：模擬的服務作業，不執行真實 Linux 服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UI受け入れのみ：シミュレートされたサービスジョブであり、実際のLinuxサービスは実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UI 수락 전용: 시뮬레이션된 서비스 작업이며, 실제 Linux 서비스는 실행되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceptation de l'interface utilisateur uniquement : un travail de service simulé ; aucun véritable service Linux ne s'exécute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur UI-Akzeptanz: ein simulierter Serviceauftrag; kein echter Linux-Dienst läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo aceptación de la interfaz de usuario: un trabajo de servicio simulado; no se ejecuta ningún servicio Linux real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas aceitação da interface do usuário: um trabalho de serviço simulado; nenhum serviço Linux real é executado."
          }
        }
      }
    },
