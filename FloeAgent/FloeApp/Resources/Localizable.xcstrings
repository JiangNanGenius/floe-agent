    "app.bilingual.177fdf3413cc9052": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用的工艺转速优先；缺省转速仅补足未给定项。默认值用于研究演示，请按材料和刀具调整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active process speeds take precedence. Fallback speed fills unspecified values. Defaults are for research examples; adjust for the material and tool."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用的工藝轉速優先；預設轉速僅補足未給定項。預設值用於研究演示，請按材料和刀具調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなプロセス速度が優先されます。 フォールバック速度は未指定の値を埋めます。 デフォルトは研究例用です；素材とツールに合わせて調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 프로세스 속도가 우선합니다. 대체 속도가 지정되지 않은 값을 채웁니다. 기본값은 연구 예시용이며, 자료와 도구에 맞게 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vitesses de processus actives ont la priorité. La vitesse de secours remplit des valeurs non spécifiées. Les valeurs par défaut sont pour les exemples de recherche ; ajustez le matériel et l'outil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Prozessgeschwindigkeiten haben Vorrang. Die Fallback-Geschwindigkeit füllt nicht angegebene Werte aus. Standardwerte sind für Forschungsbeispiele; passen Sie sich an das Material und das Werkzeug an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las velocidades de proceso activos tienen prioridad. La velocidad de respaldo llena valores no especificados. Los valores predeterminados son para ejemplos de investigación; ajuste para el material y la herramienta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As velocidades de processo ativas têm precedência. A velocidade de Fallback preenche valores não especificados. Os padrões são para exemplos de pesquisa; ajuste para o material e a ferramenta."
          }
        }
      }
    },
