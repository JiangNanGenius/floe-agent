            "state": "translated",
            "value": "Commencez dans l'établi, puis inspectez chaque décision et le résultat dans son fil de discussion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie in der Werkbank, überprüfen Sie dann jede Entscheidung und Ergebnisse in ihrem Thread."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience en el banco de trabajo, luego inspeccione cada decisión y resulte en su hilo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece na bancada de trabalho, depois inspecione cada decisão e resulte em seu tópico."
          }
