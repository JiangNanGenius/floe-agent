    "settings.document_recovery_list_view.choose_what_to_restore_the_current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what to restore. The current copy is kept as another version and the original file does not change."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要恢复的内容。当前副本会保留为另一个版本，原文件不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要恢復的內容。當前副本會保留為另一個版本，原檔案不會改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元するものを選択してください。 現在のコピーは別のバージョンとして保持され、元のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원할 항목을 선택하십시오. 현재 복사본은 다른 버전으로 유지되며 원본 파일은 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ce que vous voulez restaurer. La copie actuelle est conservée comme une autre version et le fichier original ne change pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, was wiederhergestellt werden soll. Die aktuelle Kopie bleibt als andere Version erhalten und die Originaldatei ändert sich nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué restaurar. La copia actual se mantiene como otra versión y el archivo original no cambia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o que restaurar. A cópia atual é mantida como outra versão e o arquivo original não muda."
          }
        }
      }
    },
