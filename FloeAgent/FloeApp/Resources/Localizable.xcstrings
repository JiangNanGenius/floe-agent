    "localmodels.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model files are used only after you choose to download them and are kept on this device only. Downloaded models can be removed here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型文件需在你主动下载后使用，仅保存在当前设备；已下载的模型可在此删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型檔案需在你主動下載後使用，僅儲存在當前裝置；已下載的模型可在此刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルファイルは、ダウンロードを選択した後にのみ使用され、このデバイスにのみ保存されます。 ダウンロードしたモデルはここで削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 파일은 다운로드를 선택한 후에만 사용되며, 이 기기에만 보관됩니다. 다운로드한 모델은 여기에서 제거할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers modèles ne sont utilisés qu'après que vous ayez choisi de les télécharger et sont conservés sur cet appareil uniquement. Les modèles téléchargés peuvent être supprimés ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelldateien werden nur verwendet, nachdem Sie sie heruntergeladen haben, und werden nur auf diesem Gerät gespeichert. Heruntergeladene Modelle können hier entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de modelo se utilizan solo después de que elija descargarlos y se mantienen solo en este dispositivo. Los modelos descargados se pueden eliminar aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do modelo são usados somente depois que você escolhe baixá-los e são mantidos apenas neste dispositivo. Modelos baixados podem ser removidos aqui."
          }
        }
      }
    },
