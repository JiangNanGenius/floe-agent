    "canvas.destination.openFailed.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas workspace is missing or unreadable. Retry, or close and reopen the canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布工作区缺失或无法读取。可以重试，或关闭后重新打开画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布工作區缺失或無法讀取。可以重試，或關閉後重新開啟畫布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスのワークスペースが見つからないか、読めません。 再試行するか、キャンバスを閉じて再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 작업 공간이 없거나 읽을 수 없습니다. 다시 시도하거나, 캔버스를 닫았다가 다시 여십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de travail canvas est manquant ou illisible. Réessayez, ou fermez et rouvrez le canevas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich \"Canvas\" fehlt oder ist nicht lesbar. Versuchen Sie es erneut oder schließen Sie die Leinwand und öffnen Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el espacio de trabajo del lienzo o es ilegible. Vuelva a intentarlo, o cierre y vuelva a abrir el lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho da tela está ausente ou ilegível. Tente novamente, ou feche e reabra a tela."
          }
        }
      }
    },
