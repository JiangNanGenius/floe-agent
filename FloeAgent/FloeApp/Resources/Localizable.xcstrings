    "app.bilingual.3a60f3f709f3a1a7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试更短的型号或封装名。只有已转换记录可直接安装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a shorter part or footprint name. Only converted records can install directly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嘗試更短的型號或封裝名。只有已轉換記錄可直接安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より短い部品名またはフットプリント名をお試しください。 変換されたレコードのみが直接インストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 부품이나 풋프린트 이름을 시도해 보세요. 변환된 레코드만 직접 설치할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un nom de pièce ou d'empreinte plus court. Seuls les enregistrements convertis peuvent s'installer directement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es mit einem kürzeren Teil- oder Fußabdrucknamen. Nur konvertierte Datensätze können direkt installiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe un nombre de parte o huella más corto. Solo los registros convertidos se pueden instalar directamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente uma parte mais curta ou um nome de pegada. Somente registros convertidos podem ser instalados diretamente."
          }
        }
      }
    },
