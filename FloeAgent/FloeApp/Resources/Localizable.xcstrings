    "providers.model_editor_view.media_models_are_configured_by_official": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media models are configured by official API capabilities and do not use conversation context or output token settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体模型按官方接口能力配置，不使用对话上下文或输出 Token 设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "媒體模型按官方介面能力配置，不使用對話上下文或輸出 Token 設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアモデルは公式の API 機能によって構成され、会話コンテキストや出力トークン設定は使用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 모델은 공식 API 기능에 의해 구성되며 대화 컨텍스트나 출력 토큰 설정을 사용하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles multimédias sont configurés par les capacités officielles de API et n'utilisent pas de contexte de conversation ou de paramètres de jeton de sortie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Medienmodelle werden durch offizielle API-Funktionen konfiguriert und verwenden keine Konversationskontext- oder Ausgabe-Token-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos multimedia están configurados por las capacidades oficiales de API y no utilizan el contexto de conversación ni la configuración del token de salida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de mídia são configurados pelos recursos oficiais do API e não usam contexto de conversa ou configurações de token de saída."
          }
        }
      }
    },
