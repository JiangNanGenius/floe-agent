    "cad.advanced.exchange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB uses fixed sheen roughness 1 and records native-angle conversion loss. Refraction and displacement are unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB 的绒面光泽粗糙度固定为 1，并记录原生角度转换损失。本轮不支持折射和位移。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB 的絨面光澤粗糙度固定為 1，並記錄原生角度轉換損失。本輪不支援折射和位移。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GLBは固定光沢粗さ1を使用し、ネイティブ角度変換損失を記録します。 屈折と変位は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB는 고정 광택 거칠기 1을 사용하고 네이티브 각도 변환 손실을 기록합니다. 굴절 및 변위는 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB utilise la rugosité de la breillure fixe 1 et enregistre la perte de conversion de l'angle natif. La réfraction et le déplacement ne sont pas disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB verwendet feste Glarrauheit 1 und zeichnet den Umwandlungsverlust im nativen Winkel auf. Brechung und Verschiebung sind nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GLB utiliza una rugosidad de brino fijo 1 y registra la pérdida de conversión de ángulo nativo. La refracción y el desplazamiento no están disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O GLB usa rugosidade de brilho fixo 1 e registra a perda de conversão de ângulo nativo. Refração e deslocamento não estão disponíveis."
          }
        }
      }
    },
    "cad.advanced.preview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced shading appears in Present. Anisotropy needs UVs or a projected mapping."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级着色在展示中预览。各向异性需要 UV 或投影映射。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高階著色在展示中預覽。各向異性需要 UV 或投影對映。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度なシェーディングが現在に表示されます。 異方性はUVまたは投影マッピングを必要とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 음영이 현재에 표시됩니다. 이방성은 UV 또는 투영 매핑이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ombrage avancé apparaît dans Present. L'anisotropie a besoin d'UV ou d'une cartographie projetée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Schattierung wird in Present angezeigt. Die Anisotropie benötigt UV-Strahlen oder eine projizierte Kartierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sombreado avanzado aparece en Presente. La anisotropía necesita rayos UV o un mapeo proyectado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sombreamento avançado aparece no Presente. A anisotropia precisa de UVs ou um mapeamento projetado."
          }
        }
      }
    },
