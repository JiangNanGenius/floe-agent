    "app.bilingual.208877f20ebff45b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置尚未载入，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be loaded. Please retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定尚未載入，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込めませんでした。 もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 로드할 수 없습니다. 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres n'ont pas pu être chargés. Veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen konnten nicht geladen werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración. Por favor, inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações não puderam ser carregadas. Por favor, tente novamente."
          }
        }
      }
    },
    "app.bilingual.26b51b948c7b47b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理任务的工作文件夹暂时无法打开。请重新打开此任务后重试；本次未启动清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cleanup task's working folder is unavailable. Reopen this task and retry; cleanup has not started."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理任務的工作資料夾暫時無法開啟。請重新開啟此任務後重試；本次未啟動清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリーンアップタスクの作業フォルダーが利用できません。 このタスクを再度開いて、再試行してください。クリーンアップは開始されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정리 작업의 작업 폴더를 사용할 수 없습니다. 이 작업을 다시 열고 다시 시도하십시오; 정리 작업이 시작되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de travail de la tâche de nettoyage n'est pas disponible. Rouvrir cette tâche et réessayer ; le nettoyage n'a pas commencé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsordner der Bereinigungsaufgabe ist nicht verfügbar. Öffnen Sie diese Aufgabe erneut und versuchen Sie es erneut; die Bereinigung wurde nicht gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de trabajo de la tarea de limpieza no está disponible. Vuelva a abrir esta tarea e inténtelo de nuevo; la limpieza no ha comenzado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de trabalho da tarefa de limpeza não está disponível. Reabra esta tarefa e tente novamente; a limpeza não foi iniciada."
          }
        }
      }
    },
    "app.bilingual.4045dd1a70e415dd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
