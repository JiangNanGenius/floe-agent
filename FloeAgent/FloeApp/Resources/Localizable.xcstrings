    "app.bilingual.127543c57b26cbf5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单文件运行：仅将当前文件按已保存字节传输到主机上本次运行专属的暂存目录，回读校验 SHA-256 后才会执行；项目依赖不会被传输。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-file run: only the current file is transferred — byte-exact into a run-owned staging directory on the host, verified by SHA-256 read-back before anything executes; project dependencies are not transferred."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單檔案執行：僅將當前檔案按已儲存位元組傳輸到主機上本次執行專屬的暫存目錄，回讀校驗 SHA-256 後才會執行；專案依賴不會被傳輸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シングルファイル実行：現在のファイルのみが転送され、バイトエクサクトでホスト上の実行時所有ステージングディレクトリに格納され、SHA-256リードバックにより検証され、何も実行されません；プロジェクトの依存関係は転送されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 파일 실행: 현재 파일만 전송됩니다 — 바이트-정확하게 호스트의 실행이 가능한 스테이징 디렉터리로 전송되며, 실행되기 전에 SHA-256 읽기백으로 검증됩니다; 프로젝트 의존성은 전송되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécution à fichier unique : seul le fichier actuel est transféré - byte-exact dans un répertoire de staging appartenant à l'exécution sur l'hôte, vérifié par la lecture SHA-256 avant que quoi que ce soit ne soit exécuté ; les dépendances du projet ne sont pas transférées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Single-File-Lauf: Nur die aktuelle Datei wird übertragen - byte-exact in ein laufendes Staging-Verzeichnis auf dem Host, verifiziert durch SHA-256-Readback, bevor etwas ausgeführt wird; Projektabhängigkeiten werden nicht übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar un solo archivo: solo se transfiere el archivo actual - byte-exact a un directorio de ensayo propiedad de la ejecución en el host, verificado por la lectura SHA-256 antes de que se ejecute nada; las dependencias del proyecto no se transfieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executação de arquivo único: apenas o arquivo atual é transferido — byte-exact para um diretório de teste de propriedade da execução no host, verificado pela leitura SHA-256 antes que qualquer coisa seja executada; as dependências do projeto não são transferidas."
          }
        }
      }
    },
    "app.bilingual.afd3428d52100b8c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行结束后，该次运行的清理陷阱只删除本次运行专属的暂存目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the run, this run's cleanup trap removes only its own staging directory."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行結束後，該次執行的清理陷阱只刪除本次執行專屬的暫存目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行後、この実行のクリーンアップトラップは、独自のステージングディレクトリのみを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 후, 이 실행의 정리 트랩은 자체 스테이징 디렉터리만 제거합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l'exécution, le piège de nettoyage de cette exécution ne supprime que son propre répertoire de mise en scène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Lauf entfernt der Aufräumfalle dieses Laufs nur das eigene Staging-Verzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la ejecución, la trampa de limpieza de esta ejecución elimina solo su propio directorio de preparación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a execução, a armadilha de limpeza desta execução remove apenas seu próprio diretório de teste."
          }
        }
      }
    },
    "app.idelanguage_run_view.this_project_also_has_a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目还在该主机上配置了完整项目镜像：%@（仅供参考，运行使用已校验的暂存副本）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project also has a full mirror on this host: %@ (informational; the run uses the verified staged copy)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該專案還在該主機上配置了完整專案映象：%@（僅供參考，執行使用已校驗的暫存副本）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトは、このホスト上にフルミラー（%@）も持っています（情報提供；実行は検証済みのステージドコピーを使用します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트는 또한 이 호스트에 전체 미러가 있습니다: %@ (정보용; 실행은 검증된 스테이징된 복사본을 사용합니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet a également un miroir complet sur cet hôte : %@ (informatif ; l'exécution utilise la copie mise en scène vérifiée)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt hat auch einen vollständigen Spiegel auf diesem Host: %@ (informatisch; der Lauf verwendet die verifizierte inszenierte Kopie)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto también tiene un espejo completo en este host: %@ (información; la ejecución utiliza la copia en etapa verificada)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este projeto também tem um espelho completo neste host: %@ (informacional; a execução usa a cópia em fase verificada)."
          }
        }
      }
    },
