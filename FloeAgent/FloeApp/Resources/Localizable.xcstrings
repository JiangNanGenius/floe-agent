    "app.bilingual.5476f4ae6f531a85": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编号随 MIDI 导出；本机琴声由轨道音色决定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs are exported in MIDI; the track preset controls the built-in sound."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編號隨 MIDI 匯出；本機琴聲由軌道音色決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プログラムはMIDIでエクスポートされます；トラックプリセットは組み込みサウンドを制御します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램은 MIDI로 내보내집니다; 트랙 프리셋은 내장 사운드를 제어합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les programmes sont exportés en MIDI ; le préréglage de la piste contrôle le son intégré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme werden in MIDI exportiert; die Titelvoreinstellung steuert den integrierten Sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los programas se exportan en MIDI; el preajuste de la pista controla el sonido incorporado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os programas são exportados em MIDI; a predefinição da faixa controla o som integrado."
          }
        }
      }
    },
