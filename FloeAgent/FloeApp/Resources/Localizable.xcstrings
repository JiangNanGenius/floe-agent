    "cad.sketch.curve.exactRangeRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This curve cannot be edited exactly yet. The original is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持精确编辑此曲线，原曲线已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援精確編輯此曲線，原曲線已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この曲線はまだ正確に編集できません。 元のものは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 곡선은 아직 정확히 편집할 수 없습니다. 원본은 변함이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette courbe ne peut pas encore être modifiée exactement. L'original est inchangé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kurve kann noch nicht genau bearbeitet werden. Das Original ist unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta curva aún no se puede editar exactamente. El original no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta curva ainda não pode ser editada exatamente. O original não mudou."
          }
        }
      }
    },
    "cad.sketch.curve.references": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Release the curve's constraints or links first. Nothing was removed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先解除曲线的约束或关联，原有内容均已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先解除曲線的約束或關聯，原有內容均已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、曲線の制約やリンクを解放してください。 何も削除されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡선의 제약 조건이나 링크를 먼저 해제하십시오. 아무것도 제거되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relâchez d'abord les contraintes ou les liens de la courbe. Rien n'a été supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösen Sie zuerst die Einschränkungen oder Verknüpfungen der Kurve. Nichts wurde entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere primero las restricciones o enlaces de la curva. No se eliminó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte as restrições ou links da curva primeiro. Nada foi removido."
          }
        }
      }
    },
    "cad.sketch.curve.collapse": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offset collapses the curve. Reduce the inward distance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏移后曲线会塌缩，请减小内偏移距离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏移後曲線會塌縮，請減小內偏移距離。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフセットは曲線を崩壊させます。 内向きの距離を減らす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프셋이 곡선을 축소합니다. 내부 거리를 줄이십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décalage réduit la courbe. Réduisez la distance vers l'intérieur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versatz lässt die Kurve zusammenklappen. Reduzieren Sie den Abstand nach innen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento colapsa la curva. Reduce la distancia hacia adentro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslocamento colapsa a curva. Reduza a distância para dentro."
          }
        }
      }
    },
