    "workspace.office_attachment_list_view.file_attachments_embedded_in_the_document": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File attachments embedded in the document are listed here. Objects such as charts and images can be manipulated in the document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处列出嵌入文档的文件附件。图表、图片等对象可在文档中操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處列出嵌入文件的檔案附件。圖表、圖片等物件可在文件中操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書に埋め込まれたファイル添付はここに一覧されています。 チャートや画像などのオブジェクトは、文書内で操作できます。"
          }
