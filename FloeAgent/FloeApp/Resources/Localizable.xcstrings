    "workspace.source_control_center.this_build_has_no_github_oauth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no GitHub OAuth Client ID configured; contact the build administrator. Access-token sign-in still works."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建尚未配置 GitHub OAuth Client ID，请联系构建管理员；访问令牌登录仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此構建尚未配置 GitHub OAuth Client ID，請聯絡構建管理員；訪問令牌登入仍可使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには GitHub OAuth クライアント ID が設定されていません。ビルド管理者にお問い合わせください。 アクセストークンのサインインは依然として機能しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 GitHub OAuth 클라이언트 ID가 구성되어 있지 않습니다; 빌드 관리자에게 문의하십시오. 액세스 토큰 로그인은 여전히 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n'a pas d'ID client GitHub OAuth configuré ; contactez l'administrateur de la construction. La connexion au jeton d'accès fonctionne toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keine GitHub OAuth Client ID konfiguriert; wenden Sie sich an den Build-Administrator. Die Anmeldung mit Zugangstoken funktioniert weiterhin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene configurado ningún ID de cliente GitHub OAuth; póngase en contacto con el administrador de la compilación. El inicio de sesión con token de acceso sigue funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem um ID de Cliente GitHub OAuth configurado; entre em contato com o administrador da compilação. O login do token de acesso ainda funciona."
          }
        }
      }
    },
