    "cad.detach.rebuild_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't detach the projection. Check the sketch's features and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法断开关联，请检查草图相关特征后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法斷開關聯，請檢查草圖相關特徵後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投影を切り離すことができませんでした。 スケッチの機能を確認し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝션을 분리할 수 없었습니다. 스케치의 특징을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de détacher la projection. Vérifiez les caractéristiques du croquis et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte die Projektion nicht lösen. Überprüfen Sie die Funktionen des Sketches und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo separar la proyección. Comprueba las características del boceto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível separar a projeção. Verifique os recursos do esboço e tente novamente."
          }
        }
      }
    },
    "cad.project.broken_reference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d projected edge(s) lost their source. Detach them, or undo the source deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 条投影边失去了来源。可断开关联，或撤销源删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 條投影邊失去了來源。可斷開關聯，或撤銷源刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d の投影エッジはソースを失いました。 それらを切り離すか、ソースの削除を取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d가 프로젝트된 엣지(들)가 소스를 잃었습니다. 분리하거나 소스 삭제를 취소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d bord(s) projeté(s) ont perdu leur source. Détachez-les ou effacez la suppression de la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d projizierte Kante(n) verloren ihre Quelle. Trennen Sie sie oder machen Sie die Quelllöschung rückgängig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El(los) borde(s) proyectado(s) %d perdió su fuente. Secótelos o deshaca la eliminación de la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%d borda(s) projetada(s) perdeu sua fonte. Separe-os ou desfaz a exclusão da fonte."
          }
        }
      }
    },
    "cad.project.detach_to_edit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This edge follows its source body. Detach it to edit the geometry here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此边跟随其源实体，断开关联后即可在此编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此邊跟隨其源實體，斷開關聯後即可在此編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエッジはソースボディに続きます。 ここでジオメトリを編集するには、それを切り離してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엣지는 원본 본문을 따릅니다. 여기에서 기하학을 편집하려면 분리하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bord suit son corps de source. Détachez-le pour modifier la géométrie ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kante folgt ihrem Quellkörper. Trennen Sie es, um die Geometrie hier zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este borde sigue su cuerpo de origen. Desenchágalo para editar la geometría aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta borda segue seu corpo de origem. Separa-o para editar a geometria aqui."
          }
        }
      }
    },
    "cad.project.duplicate": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That edge is already projected in this sketch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该边已投影到此草图中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該邊已投影到此草圖中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのエッジはすでにこのスケッチに投影されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 가장자리는 이미 이 스케치에 투사되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bord est déjà projeté dans cette esquisse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kante ist bereits in dieser Skizze projiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese borde ya está proyectado en este boceto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa borda já está projetada neste esboço."
          }
        }
      }
    },
    "cad.project.empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to project — the body has no edges to flatten onto this plane."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可投影的内容——该实体没有能压平到此平面的边。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可投影的內容——該實體沒有能壓平到此平面的邊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投影すべきものはありません――本体にはこの平面に平らにできる縁がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투사할 것이 없습니다 — 몸체는 이 평면에 평평하게 펴지는 가장자리가 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à projeter - le corps n'a pas de bords à aplatir sur ce plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zu projizieren - der Körper hat keine Kanten, um auf dieser Ebene zu glätten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que proyectar, el cuerpo no tiene bordes para aplanar en este plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para projetar — o corpo não tem bordas para achatar neste plano."
          }
        }
      }
    },
    "cad.project.rebuild_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The projection conflicts with an existing feature. Check the sketch and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投影与现有特征冲突，请检查草图后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投影與現有特徵衝突，請檢查草圖後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投影は既存の特徴と競合しています。 スケッチを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투영이 기존 기능과 충돌합니다. 스케치를 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La projection entre en conflit avec une fonctionnalité existante. Vérifiez le croquis et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Projektion kollidiert mit einem vorhandenen Merkmal. Überprüfen Sie die Skizze und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proyección entra en conflicto con una característica existente. Revisa el boceto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A projeção entra em conflito com um recurso existente. Verifique o esboço e tente novamente."
          }
        }
      }
    },
    "cad.project.skipped_degenerate_single": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That edge is parallel to this plane — it projects to a point, not a line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该边与此平面平行——投影结果是一个点而非线。"
