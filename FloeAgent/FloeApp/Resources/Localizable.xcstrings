          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt wurde wiederhergestellt; das vorherige Backup wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto fue restaurado; se retuvo la copia de seguridad anterior."
          }
        },
