    "notes.notes_knowledge_attachment.note_material_selected_documentid_use_notes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note material selected: %@. documentID=%@. Use notes.read for the latest content; strokes and images require a separate selection image and cannot be treated as recognized text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已选择手记资料：%@。documentID=%@。可使用 notes.read 读取最新内容；笔迹及图片需另行提供选区图像，不能当作已识别的文字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選擇手記資料：%@。documentID=%@。可使用 notes.read 讀取最新內容；筆跡及圖片需另行提供選區影象，不能當作已識別的文字。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注資料が選択されました: %@. documentID=%@. 最新のコンテンツについては notes.read を使用してください。ストロークと画像は別々の選択画像が必要で、認識されたテキストとして扱うことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 참고 자료: %@. documentID=%@. 최신 콘텐츠는 notes.read를 사용하십시오; 획과 이미지는 별도의 선택 이미지가 필요하며 인식된 텍스트로 취급될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note matériel sélectionné : %@. documentID=%@. Utilisez notes.read pour le dernier contenu ; les traits et les images nécessitent une image de sélection distincte et ne peuvent pas être traités comme du texte reconnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewähltes Material beachten: %@. documentID=%@. Verwenden Sie notes.read für die neuesten Inhalte; Striche und Bilder erfordern ein separates Auswahlbild und können nicht als anerkannter Text behandelt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota material seleccionado: %@. documentID=%@. Utilice notes.read para obtener el contenido más reciente; los trazos y las imágenes requieren una imagen de selección separada y no se pueden tratar como texto reconocido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Material de nota selecionado: %@. documentID=%@. Use notes.read para o conteúdo mais recente; traços e imagens exigem uma imagem de seleção separada e não podem ser tratados como texto reconhecido."
          }
        }
      }
    },
    "notes.notes_knowledge_picker.after_removal_the_assistant_can_no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After removal, the assistant can no longer read or modify that material through note tools; text and attachments already sent remain in the conversation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除后助手不能再通过手记工具读取或修改该资料；已发送的文字和附件仍保留在对话中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除後助手不能再透過手記工具讀取或修改該資料；已傳送的文字和附件仍保留在對話中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除後、アシスタントはノートツールでその資料を読んだり変更したりできなくなり、すでに送信されたテキストや添付ファイルは会話内に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제거 후, 어시스턴트는 더 이상 메모 도구를 통해 해당 자료를 읽거나 수정할 수 없으며, 이미 보낸 텍스트와 첨부 파일은 대화에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la suppression, l'assistant ne peut plus lire ou modifier ce matériel à l'aide d'outils de notes ; le texte et les pièces jointes déjà envoyés restent dans la conversation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Entfernen kann der Assistent das Material nicht mehr über Notizwerkzeuge lesen oder ändern; Text und bereits gesendete Anhänge bleiben in der Konversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la eliminación, el asistente ya no puede leer o modificar ese material a través de las herramientas de notas; el texto y los archivos adjuntos ya enviados permanecen en la conversación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a remoção, o assistente não pode mais ler ou modificar esse material por meio de ferramentas de notas; o texto e os anexos já enviados permanecem na conversa."
          }
        }
      }
    },
