    "app.apns_settings_view.system_registration_service_connection_and": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统登记、服务连接和收到通知是不同阶段。后台运行由系统安排。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System registration, service connection and notification receipt are separate stages. The system schedules background work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統登記、服務連線和收到通知是不同階段。後臺執行由系統安排。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム登録、サービス接続、通知受領は別々の段階です。 システムはバックグラウンド作業をスケジュールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 등록, 서비스 연결 및 알림 수신은 별개의 단계입니다. 시스템이 백그라운드 작업을 예약합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement du système, la connexion au service et la réception de la notification sont des étapes distinctes. Le système planifie le travail de fond."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systemregistrierung, die Dienstverbindung und der Benachrichtigungsempfang sind separate Phasen. Das System plant Hintergrundarbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro del sistema, la conexión de servicio y la recepción de notificaciones son etapas separadas. El sistema programa el trabajo de fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro do sistema, a conexão de serviço e o recebimento da notificação são estágios separados. O sistema agenda o trabalho em segundo plano."
          }
        }
      }
    },
