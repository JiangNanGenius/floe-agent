          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能通过已配置的 SSH 主机运行，请选择目标主机"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 只能透過已配置的 SSH 主機執行，請選擇目標主機"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、設定された SSH ホストでのみ実行できます。対象のホストを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 구성된 SSH 호스트에서만 실행될 수 있습니다; 대상 호스트를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut s'exécuter que sur un hôte SSH configuré ; veuillez choisir un hôte cible"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann nur auf einem konfigurierten SSH-Host ausgeführt werden; bitte wählen Sie einen Zielhost"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo se puede ejecutar en un host SSH configurado; elija un host de destino"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ só pode ser executado em um host SSH configurado; escolha um host de destino"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.cancel_requested_github_finalizes_the_run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel requested; GitHub finalizes the run asynchronously and Floe keeps checking until it is cancelled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求取消；GitHub 会异步结束该运行，Floe 会继续核对直到确认 cancelled。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求取消；GitHub 會非同步結束該執行，Floe 會繼續核對直到確認 cancelled。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセルが要求されました；GitHub は非同期で実行を完了し、Floe はキャンセルされるまでチェックし続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소 요청; GitHub는 비동기적으로 실행을 마무리하고 Floe는 취소될 때까지 계속 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation demandée ; GitHub finalise l'exécution de manière asynchrone et Floe continue de vérifier jusqu'à ce qu'elle soit annulée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen angefordert; GitHub schließt den Lauf asynchron ab und Floe überprüft weiter, bis er abgebrochen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelación solicitada; GitHub finaliza la ejecución de forma asíncrona y Floe sigue comprobando hasta que se cancela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelamento solicitado; GitHub finaliza a execução de forma assíncrona e Floe continua verificando até que seja cancelada."
          }
        }
      }
    },
