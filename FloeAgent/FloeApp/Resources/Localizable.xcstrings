    "cad.workbench.assembly.explodedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A view is display/drawing state. It never changes the base placements."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视图只用于显示和工程图，绝不改变基准位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視只用於顯示和工程圖，絕不改變基準位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューは表示/描画状態です。 それは基本的な配置を決して変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰는 표시/그림 상태입니다. 기본 배치를 절대 변경하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vue est en état d'affichage/de dessin. Il ne change jamais les emplacements de base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Ansicht hat einen Anzeige-/Zeichnungszustand. Es ändert nie die Basisplatzierungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vista es el estado de visualización/dibujo. Nunca cambia las ubicaciones de base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visualização é o estado de exibição/desenho. Nunca muda os posicionamentos da base."
          }
        }
      }
    },
