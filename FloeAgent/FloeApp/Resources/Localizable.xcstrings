    "onboarding.point.approvals.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Consequential actions show their exact scope before they run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要操作执行前会显示完整、准确的授权范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重要操作執行前會顯示完整、準確的授權範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果的なアクションは、実行される前に正確なスコープを示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과적인 행동은 실행되기 전에 정확한 범위를 보여줍니다."
          }
        },
