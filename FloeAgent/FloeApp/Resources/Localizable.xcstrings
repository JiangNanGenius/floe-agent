        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中瞭解雲端與本地模型、視覺與審批、搜尋、Apple 能力、SSH、後臺執行、同步和診斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドおよびローカルモデル、ビジョンと承認、検索、Apple の機能、SSH、バックグラウンド操作、同期、診断をレビューします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 및 로컬 모델, 비전 및 승인, 검색, Apple 기능, SSH, 백그라운드 운영, 동기화 및 진단을 검토합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez en revue les modèles cloud et locaux, la vision et les approbations, la recherche, les capacités Apple, SSH, le fonctionnement en arrière-plan, la synchronisation et les diagnostics."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Cloud- und lokale Modelle, Vision und Genehmigungen, Suche, Apple-Funktionen, SSH, Hintergrundbetrieb, Synchronisierung und Diagnose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise modelos en la nube y locales, visión y aprobaciones, búsqueda, capacidades de Apple, SSH, operación en segundo plano, sincronización y diagnósticos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise a nuvem e os modelos locais, visão e aprovações, pesquisa, recursos da Apple, SSH, operação em segundo plano, sincronização e diagnósticos."
          }
        }
      }
    },
