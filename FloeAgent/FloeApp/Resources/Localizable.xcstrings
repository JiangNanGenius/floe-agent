    "chat.thread_detail_view_model.the_auto_approval_model_is_temporarily": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The auto-approval model is temporarily unavailable or timed out. Safe read actions continue under local rules; retry sensitive actions or confirm them manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动审批模型暂时不可用或响应超时。安全读操作会按本地规则继续；敏感操作请重试或手动确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動審批模型暫時不可用或響應超時。安全讀操作會按本地規則繼續；敏感操作請重試或手動確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動承認モデルは一時的に利用できないか、タイムアウトしています。 安全な読み取り操作はローカルルールに従って継続されます；機密操作を再試行するか、手動で確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 승인 모델이 일시적으로 이용 불가능하거나 시간 초과되었습니다. 안전 읽기 작업은 현지 규칙에 따라 계속됩니다; 민감한 작업을 다시 시도하거나 수동으로 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'approbation automatique est temporairement indisponible ou a un délai d'attente. Les actions de lecture sécurisée se poursuivent selon les règles locales ; réessayez les actions sensibles ou confirmez-les manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das automatische genehmigungsmodell ist vorübergehend nicht verfügbar oder hat eine Zeitüberschreitung. Sichere Leseaktionen werden gemäß den lokalen Regeln fortgesetzt; versuchen Sie sensible Aktionen erneut oder bestätigen Sie sie manuell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de aprobación automática no está disponible temporalmente o se ha acaducado. Las acciones de lectura segura continúan bajo las reglas locales; vuelva a intentar las acciones confidenciales o confírmelas manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de aprovação automática está temporariamente indisponível ou com tempo limite. As ações de leitura segura continuam de acordo com as regras locais; tente novamente as ações confidenciais ou confirme-as manualmente."
          }
        }
      }
    },
    "chat.thread_detail_view_model.the_compaction_check_finished_without_replacing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The compaction check finished without replacing history this time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩检查结束，本次未替换历史。"
