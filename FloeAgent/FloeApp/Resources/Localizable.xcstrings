    "workspace.workspace_canvas_view.draw_content_with_apple_pencil_or": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw content with Apple Pencil, or switch to “select” and marquee existing strokes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请用 Apple Pencil 画出内容，或切到“选择”后框选已有笔迹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請用 Apple Pencil 畫出內容，或切到“選擇”後框選已有筆跡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilでコンテンツを描画するか、または「select」に切り替えて既存のストロークをマークしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil로 내용을 그리거나, “select”로 전환하여 기존 스트로크를 표시하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez du contenu avec Apple Pencil, ou passez à \"sélectionner\" et marquez les traits existants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie Inhalte mit Apple Pencil oder wechseln Sie zu \"Auswählen\" und markieren Sie vorhandene Striche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja contenido con Apple Pencil, o cambia a \"seleccionar\" y marcar los trazos existentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe conteúdo com Apple Pencil ou mude para \"selecionar\" e marcar traços existentes."
          }
        }
      }
    },
