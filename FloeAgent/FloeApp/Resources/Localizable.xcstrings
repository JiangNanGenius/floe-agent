    "app.bilingual.2d456ec044828c10": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此存档来自不同的游戏修订；读取后可能与当前版本不匹配。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save was captured from a different game revision. Loading it may not fit the current build."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此存檔來自不同的遊戲修訂；讀取後可能與當前版本不匹配。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブは別のゲームリビジョンから取得されました。 ロード中は現在のビルドに合わない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장은 다른 게임 리비전에서 캡처되었습니다. 로드하는 것이 현재 빌드에 맞지 않을 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été capturée à partir d'une autre révision du jeu. Le chargement peut ne pas s'adapter à la construction actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicherstand wurde aus einer anderen Spielrevision gewonnen. Das Laden passt möglicherweise nicht zum aktuellen Build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guardado fue capturado de una revisión del juego diferente. La carga puede no encajar en la construcción actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvamento foi capturado a partir de uma revisão diferente do jogo. Carregar pode não se encaixar na compilação atual."
          }
        }
      }
    },
    "app.bilingual.24e8062c77558510": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先开始游戏，才能捕获原生存档。"
