    "app.bilingual.675d9ca43f58e8a8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择视频或图片片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a video or image clip."
          }
        },
