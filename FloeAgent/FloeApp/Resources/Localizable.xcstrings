    "app.bilingual.5f53b0d7bed217b8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份副本的子项目尚未复制。请先创建独立子项目，再从这里继续编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy's child project has not been duplicated. Create an independent child project before editing it here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份副本的子專案尚未複製。請先建立獨立子專案，再從這裡繼續編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーの子プロジェクトは複製されていません。 ここで編集する前に、独立した子プロジェクトを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복사본의 하위 프로젝트는 복제되지 않았습니다. 여기에서 편집하기 전에 독립적인 하위 프로젝트를 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet enfant de cette copie n'a pas été dupliqué. Créez un projet enfant indépendant avant de le modifier ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das untergeordnete Projekt dieser Kopie wurde nicht dupliziert. Erstellen Sie ein unabhängiges untergeordnetes Projekt, bevor Sie es hier bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto hijo de esta copia no se ha duplicado. Crea un proyecto infantil independiente antes de editarlo aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto filho desta cópia não foi duplicado. Crie um projeto infantil independente antes de editá-lo aqui."
          }
        }
      }
    },
