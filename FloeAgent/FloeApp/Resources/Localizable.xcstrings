      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写服务暂时繁忙或额度不足，请稍后重试或检查账户。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription is busy or out of quota. Try later or check your account."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉寫服務暫時繁忙或額度不足，請稍後重試或檢查賬戶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしが混雑しているか、割り当て外です。 後で試すか、アカウントをご確認ください。"
