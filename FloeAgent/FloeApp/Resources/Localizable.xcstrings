    "core.canvas_copy_fork_planner.the_node_asset_changed_during_editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The node asset changed during editing; the export was saved to the asset library and the original node was not modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点素材在编辑期间已改变；导出结果已保存到素材库，原节点未修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點素材在編輯期間已改變；匯出結果已儲存到素材庫，原節點未修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードのアセットは編集中に変更され、エクスポートはアセットライブラリに保存され、元のノードは変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 자산이 편집 중에 변경되었으며, 내보내기가 자산 라이브러리에 저장되었고 원본 노드는 수정되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'actif de nœud a changé pendant l'édition ; l'exportation a été enregistrée dans la bibliothèque d'actifs et le nœud d'origine n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Knoten-Asset hat sich während der Bearbeitung geändert; der Export wurde in der Asset-Bibliothek gespeichert und der ursprüngliche Knoten wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El activo del nodo cambió durante la edición; la exportación se guardó en la biblioteca de activos y el nodo original no se modificó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
