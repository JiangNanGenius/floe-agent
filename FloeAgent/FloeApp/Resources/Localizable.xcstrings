    "app.bilingual.11b1c717e35e8c61": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此板没有带三维模型引用的元件。可在在线元件库中安装并下载模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No placed footprint has a 3D model reference. Install and download a model from the online library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此板沒有帶三維模型引用的元件。可在線上元件庫中安裝並下載模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
