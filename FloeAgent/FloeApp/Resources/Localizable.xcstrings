    "app.bilingual.63694916598cc404": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导热系数使用 W/(mm·K)；从 W/(m·K) 输入时需除以1000。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conductivity uses W/(mm·K); divide W/(m·K) values by 1000 at input."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導熱係數使用 W/(mm·K)；從 W/(m·K) 輸入時需除以1000。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "導電率は W/(mm·K) を使用します；入力時に W/(m·K) の値を 1000 で除算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전도도는 W/(mm·K)를 사용합니다; 입력 시 W/(m·K) 값을 1000으로 나눕니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conductivité utilise W/(mm·K) ; diviser les valeurs W/(m·K) par 1000 à l'entrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitfähigkeit verwendet W/(mm·K); teilen Sie die W/(m·K)-Werte durch 1000 an der Eingabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conductividad utiliza W/(mm·K); divide los valores W/(m·K) por 1000 en la entrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A condutividade usa W/(mm·K); divida os valores W/(m·K) por 1000 na entrada."
          }
        }
      }
    },
