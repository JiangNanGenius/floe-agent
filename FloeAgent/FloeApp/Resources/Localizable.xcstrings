    "app.bilingual.bbc1ca97e31d724d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间不足，请清理空间后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough storage space. Free up space and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間不足，請清理空間後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージ容量が不足しています。 スペースを確保して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 충분하지 않습니다. 공간을 확보하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d'espace de stockage. Libérez de l'espace et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Speicherplatz. Platz frei machen und es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio de almacenamiento. Libera espacio e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço de armazenamento suficiente. Libere espaço e tente novamente."
          }
        }
      }
    },
    "app.bilingual.cd7e66f0f41677b4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件中有无法安全访问的路径。请检查文件夹或压缩包中的链接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game contains a path that cannot be accessed safely. Check links in the folder or archive and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲檔案中有無法安全訪問的路徑。請檢查資料夾或壓縮包中的連結後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームには安全にアクセスできないパスが含まれています。 フォルダーまたはアーカイブ内のリンクを確認し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임에는 안전하게 접근할 수 없는 경로가 포함되어 있습니다. 폴더 또는 아카이브의 링크를 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu contient un chemin auquel on ne peut pas accéder en toute sécurité. Vérifiez les liens dans le dossier ou l'archive et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel enthält einen Pfad, auf den man nicht sicher zugreifen kann. Überprüfen Sie die Links im Ordner oder Archiv und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego contiene una ruta a la que no se puede acceder de forma segura. Revise los enlaces en la carpeta o archivo e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo contém um caminho que não pode ser acessado com segurança. Verifique os links na pasta ou arquivo e tente novamente."
          }
        }
      }
    },
    "app.bilingual.a485383b4063ce5f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件夹中包含受保护的文件，请检查所选文件后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game folder contains a protected file. Check the selected files and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲資料夾中包含受保護的檔案，請檢查所選檔案後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフォルダーには保護されたファイルが含まれています。 選択したファイルを確認し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 폴더에 보호된 파일이 포함되어 있습니다. 선택한 파일을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de jeu contient un fichier protégé. Vérifiez les fichiers sélectionnés et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielordner enthält eine geschützte Datei. Überprüfen Sie die ausgewählten Dateien und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del juego contiene un archivo protegido. Compruebe los archivos seleccionados e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta do jogo contém um arquivo protegido. Verifique os arquivos selecionados e tente novamente."
          }
        }
      }
    },
