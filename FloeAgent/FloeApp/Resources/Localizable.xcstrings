    "app.workspace_canvas_view.drawing_draft_s_have_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 份图纸草稿尚未写入本地；编辑会话已保留并会自动重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ drawing draft(s) have not been written locally yet; the edit session is retained and will retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 份圖紙草稿尚未寫入本地；編輯會話已保留並會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のドラフトはまだローカルで作成されていません；編集セッションは保持され、再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 도면 초안은 아직 현지에서 작성되지 않았으며, 편집 세션은 유지되고 재시도될 예정입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le(s) brouillon(s) de dessin %@ n'ont pas encore été écrits localement ; la session d'édition est conservée et sera réessayée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Zeichnungsentwürfe wurden noch nicht lokal geschrieben; die Bearbeitungssitzung wird beibehalten und wird erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores de dibujo de %@ aún no se han escrito localmente; la sesión de edición se mantiene y se volverá a intentar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O(s) rascunho(s) de desenho %@ ainda não foram escritos localmente; a sessão de edição é mantida e será tentada novamente."
          }
        }
      }
    },
