    "app.bilingual.f1c2131e4c1e9915": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档会移入“最近删除”，之后仍可恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The slot moves to Recently deleted and can be restored later."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存檔會移入“最近刪除”，之後仍可恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロットは「最近削除された」に移動し、後で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 슬롯은 최근 삭제된 항목으로 이동하며 나중에 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement passe à Récemment supprimé et peut être restauré plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Slot wechselt zu Kürzlich gelöscht und kann später wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura se mueve a Eliminado recientemente y se puede restaurar más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O slot se move para Excluído recentemente e pode ser restaurado mais tarde."
          }
        }
      }
    },
    "app.bilingual.e6bd617919b1c299": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改存档名称，快照内容保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the slot name changes; the snapshot stays the same."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只修改存檔名稱，快照內容保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロット名だけが変わり、スナップショットは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬롯 이름만 변경되고 스냅샷은 동일하게 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom de l'emplacement change ; l'instantané reste le même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Slotname ändert sich; der Snapshot bleibt gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia el nombre de la ranura; la instantánea permanece igual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o nome do slot muda; o instantâneo permanece o mesmo."
          }
        }
      }
    },
    "app.bilingual.5673aa1078e855a7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份仅包含一个存档槽，不包含任何源文件；导入始终创建新存档槽。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups contain one save slot only. Source files are never included, and import always creates a new slot."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份僅包含一個存檔槽，不包含任何原始檔；匯入始終建立新存檔槽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには1つのセーブスロットのみが含まれています。 ソースファイルは決して含まれず、インポートは常に新しいスロットを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에는 저장 슬롯이 하나만 포함됩니다. 소스 파일은 절대 포함되지 않으며, 가져오기는 항상 새 슬롯을 생성합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes ne contiennent qu'un seul emplacement de sauvegarde. Les fichiers source ne sont jamais inclus, et l'importation crée toujours un nouvel emplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups enthalten nur einen Speicherplatz. Quelldateien werden nie enthalten, und der Import erstellt immer einen neuen Slot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad contienen solo una ranura de guardado. Los archivos fuente nunca se incluyen, y la importación siempre crea una nueva ranura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups contêm apenas um slot de salvamento. Os arquivos de origem nunca são incluídos, e a importação sempre cria um novo slot."
          }
        }
      }
    },
    "app.bilingual.b5f7f76105c4f95d": {
      "extractionState": "manual",
      "localizations": {
