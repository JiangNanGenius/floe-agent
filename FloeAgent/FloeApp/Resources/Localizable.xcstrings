    "app.game_runtime_resource_registry.the_runtime_declares_a_bundled": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行资源声明随 App 打包，但 App 中没有该声明文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runtime declares a bundled attribution profile, but the App bundle does not contain it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行資源宣告隨 App 打包，但 App 中沒有該宣告檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムはバンドルされたアトリビューションプロファイルを宣言しますが、App バンドルにはそれが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런타임은 번들된 어트리뷰션 프로필을 선언하지만, 앱 번들에는 해당 프로필이 포함되어 있지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le runtime déclare un profil d'attribution groupé, mais l'app bundle ne le contient pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Laufzeit deklariert ein gebündeltes Attributionsprofil, aber das App-Bundle enthält es nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de ejecución declara un perfil de atribución agrupado, pero el paquete de aplicaciones no lo contiene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de execução declara um perfil de atribuição empacotado, mas o pacote de aplicativos não o contém."
          }
        }
      }
    },
