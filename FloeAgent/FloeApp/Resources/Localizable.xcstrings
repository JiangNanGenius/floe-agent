    "cad.mechanical.tangent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flange lengths start at the bend tangencies. K is your process value."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直边长度从折弯切点量起。K 系数采用你的工艺值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直邊長度從折彎切點量起。K 係數採用你的工藝值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フランジの長さはベンドタンジから始まります。 K はあなたのプロセス値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플랜지 길이는 굽힘 접선에서 시작합니다. K는 귀하의 프로세스 값입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les longueurs des brides commencent aux tangentes de flexion. K est votre valeur de processus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Flanschlängen beginnen an den Biegetangenzen. K ist Ihr Prozesswert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las longitudes de la brida comienzan en las tangencias de la curva. K es el valor de tu proceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comprimentos dos flanges começam nas tangências de curva. K é o valor do seu processo."
          }
        }
      }
