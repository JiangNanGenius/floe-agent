      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此字幕包含尚未支持的样式或定位。请先导出为纯文本字幕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These captions use unsupported styling or positioning. Export plain-text captions first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此字幕包含尚未支援的樣式或定位。請先匯出為純文字字幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのキャプションは、サポートされていないスタイリングまたはポジショニングを使用しています。 まずプレーンテキストのキャプションをエクスポートしてください。"
          }
