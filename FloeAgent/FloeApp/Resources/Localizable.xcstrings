    "settings.sync.configuration.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs providers, model settings, defaults, and onboarding preferences through your private CloudKit database. Changes made while paused stay on this device and are queued for later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的私有 CloudKit 数据库同步供应商、模型设置、默认选择和向导偏好。暂停期间的更改保留在本机，并会排队等待以后同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過你的私有 CloudKit 資料庫同步供應商、模型設定、預設選擇和嚮導偏好。暫停期間的更改保留在本機，並會排隊等待以後同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートの CloudKit データベースを通じて、プロバイダー、モデル設定、デフォルト、オンボーディング設定を同期します。 一時停止中に行われた変更はこのデバイスに残り、後でキューに入れられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 개인 CloudKit 데이터베이스를 통해 공급자, 모델 설정, 기본값 및 온보딩 선호도를 동기화합니다. 일시 중지된 동안 이루어진 변경 사항은 이 기기에 남아 나중에 대기열에 저장됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronise les fournisseurs, les paramètres du modèle, les valeurs par défaut et les préférences d'intégration via votre base de données privée CloudKit. Les modifications apportées en pause restent sur cet appareil et sont mises en file d'attente pour plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert Anbieter, Modelleinstellungen, Standardeinstellungen und Onboarding-Einstellungen über Ihre private CloudKit-Datenbank. Änderungen, die während der Pause vorgenommen werden, bleiben auf diesem Gerät und werden für später in die Warteschlange gestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza proveedores, configuraciones de modelos, valores predeterminados y preferencias de incorporación a través de su base de datos privada de CloudKit. Los cambios realizados durante la pausa se quedan en este dispositivo y se ponen en cola para más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza provedores, configurações de modelo, padrões e preferências de integração através do seu banco de dados CloudKit privado. As alterações feitas durante a pausa permanecem neste dispositivo e são enfileiradas para mais tarde."
          }
        }
      }
    },
