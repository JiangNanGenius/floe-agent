    "app.bilingual.ebc27e406f59289": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看当前计算所用的设置。修改后请返回工序设置并重新生成刀路。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the settings for the current result. Change them in operation setup, then regenerate toolpaths."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視當前計算所用的設定。修改後請返回工序設定並重新生成刀路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは現在の結果の設定です。 操作設定でそれらを変更し、次にツールパスを再生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 결과에 대한 설정입니다. 운영 설정에서 변경한 후 툴패스를 재생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les paramètres du résultat actuel. Changez-les dans la configuration d'opération, puis régénérez les chemins d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind die Einstellungen für das aktuelle Ergebnis. Ändern Sie sie in der Betriebseinrichtung und regenerieren Sie dann Werkzeugpfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los ajustes para el resultado actual. Cámbialos en la configuración de la operación, luego regenera las rutas de las herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as configurações para o resultado atual. Altere-os na configuração da operação e, em seguida, regenere os caminhos da ferramenta."
          }
        }
      }
    },
