    "cad.animation.issue.duplicateTrack": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two tracks target the same object; only one is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两条轨道指向同一对象，仅使用一条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩條軌道指向同一物件，僅使用一條。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのトラックが同じ対象を対象としており、1つだけが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 개의 트랙이 동일한 객체를 대상으로 하며, 하나만 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux pistes ciblent le même objet ; une seule est utilisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Spuren zielen auf dasselbe Objekt ab; es wird nur eine verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos pistas apuntan al mismo objeto; solo se utiliza una."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas faixas visam o mesmo objeto; apenas uma é usada."
          }
        }
      }
    },
