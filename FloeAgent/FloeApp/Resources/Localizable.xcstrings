    "app.bilingual.1cc2ea747ffd2eb6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在手记或文件中保存内容，也可直接导入素材。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save content in Notes or Files, or import media directly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在手記或檔案中儲存內容，也可直接匯入素材。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノートやファイルにコンテンツを保存するか、メディアを直接インポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노트 또는 파일에 콘텐츠를 저장하거나, 미디어를 직접 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez du contenu dans Notes ou Fichiers, ou importez directement des médias."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Inhalte in Notizen oder Dateien oder importieren Sie Medien direkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde contenido en Notas o Archivos, o importe medios directamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve o conteúdo em Notas ou Arquivos, ou importe mídia diretamente."
          }
        }
      }
    },
