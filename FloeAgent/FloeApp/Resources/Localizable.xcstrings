    "settings.data_management_view.prompt_library_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User-authored prompts; never treated as a cache."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户创作的提示词，绝不当作缓存处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
