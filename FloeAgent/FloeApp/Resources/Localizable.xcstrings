      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run is frozen to the input and spec shown above; later edits do not change what was frozen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该运行已冻结到上方显示的输入和规范；之后的修改不会改变已冻结内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該執行已凍結到上方顯示的輸入和規範；之後的修改不會改變已凍結內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行は上記に示された入力と仕様で凍結されています。後の編集では凍結された内容は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 실행은 위에 표시된 입력 및 사양에 따라 동결됩니다; 이후 편집에서는 동결된 내용이 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette exécution est gelée à l'entrée et aux spécifications indiquées ci-dessus ; les modifications ultérieures ne modifient pas ce qui a été gelé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Lauf wird auf die oben gezeigte Eingabe und Spezifikation eingefroren; spätere Bearbeitungen ändern nicht, was eingefroren wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ejecución se congela a la entrada y especificación que se muestran arriba; las ediciones posteriores no cambian lo que se congeló."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta execução é congelada para a entrada e especificação mostradas acima; edições posteriores não alteram o que foi congelado."
