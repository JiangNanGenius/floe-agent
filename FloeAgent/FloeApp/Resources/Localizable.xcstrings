    "runtime.intelligence_store.the_same_fact_slot_has_different": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same fact slot has different values across scopes; confirm before organizing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一事实槽位跨多个范围存在不同值，需要确认后再整理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一事實槽位跨多個範圍存在不同值，需要確認後再整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じファクトスロットはスコープ間で異なる値がありますので、整理する前にご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 사실 슬롯은 범위마다 다른 값을 가지고 있습니다; 정리하기 전에 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même emplacement de fait a des valeurs différentes dans toutes les portées ; confirmez avant d'organiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Fakten-Slot hat unterschiedliche Werte in allen Bereichen; bestätigen Sie, bevor Sie organisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma ranura de hechos tiene diferentes valores en todos los ámbitos; confirme antes de organizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo slot de fatos tem valores diferentes em todos os escopos; confirme antes de organizar."
          }
        }
      }
    },
