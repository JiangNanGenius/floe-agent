    "app.bilingual.cb00a90212201223": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在对话中提供凭据，此处不会显示已保存的秘密原值。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also provide credentials in a conversation. Saved secret values are never displayed here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在對話中提供憑據，此處不會顯示已儲存的秘密原值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の中で資格情報を提供することもできます。 保存されたシークレット値はここには決して表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 중에 자격 증명을 제공할 수도 있습니다. 저장된 비밀 값은 여기에서 절대 표시되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez également fournir des informations d'identification dans une conversation. Les valeurs secrètes enregistrées ne sont jamais affichées ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auch Anmeldeinformationen in einem Gespräch angeben. Gespeicherte geheime Werte werden hier nie angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puede proporcionar credenciales en una conversación. Los valores secretos guardados nunca se muestran aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode fornecer credenciais em uma conversa. Os valores secretos salvos nunca são exibidos aqui."
          }
        }
      }
    },
