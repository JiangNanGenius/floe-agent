    "cad.workbench.drawing.tooManyRevisionRows": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template supports at most six revision rows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模板最多支持六行修订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個模板最多支援六行修訂。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートはリビジョン行を最大6行までサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 최대 여섯 개의 리비전 행을 지원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle prend en charge au plus six lignes de révision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Vorlage unterstützt höchstens sechs Revisionszeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una plantilla admite como máximo seis filas de revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modelo suporta no máximo seis linhas de revisão."
          }
        }
      }
    },
    "cad.workbench.drawing.revisionRowNeedsContent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each revision row needs a revision or a description."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行修订需要填写版次或说明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行修訂需要填寫版次或說明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各リビジョン行には、リビジョンまたは説明が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 리비전 행에는 리비전 또는 설명이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne de révision nécessite une révision ou une description."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Revisionszeile benötigt eine Revision oder eine Beschreibung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada fila de revisión necesita una revisión o una descripción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha de revisão precisa de uma revisão ou uma descrição."
          }
