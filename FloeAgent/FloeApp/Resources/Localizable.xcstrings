    "app.bilingual.4a1a2d1251787945": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏运行已结束，请从正在运行的游戏重新打开存档管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game run ended. Reopen save management from the running game."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲執行已結束，請從正在執行的遊戲重新開啟存檔管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームの実行が終了しました。 実行中のゲームからセーブ管理を再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 실행이 종료되었습니다. 실행 중인 게임에서 저장 관리를 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La course du jeu s'est terminée. Rouvrir la gestion de sauvegarde à partir du jeu en cours d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spiellauf endete. Speichern Sie die Speicherverwaltung aus dem laufenden Spiel erneut öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carrera del juego terminó. Vuelva a abrir la gestión de guardados desde el juego de ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução do jogo terminou. Reabrir o gerenciamento de salvamento do jogo em execução."
          }
        }
      }
    },
