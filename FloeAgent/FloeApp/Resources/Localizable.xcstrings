    "settings.data_management_view.cleanup_reclaimed_measured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reclaimed about %@ of allocated storage (measured). Workspaces, documents, models, environments and fonts were not touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实际释放约 %@ 已分配储存空间（实测）。未改动工作区、文稿、模型、环境和字体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實際釋放約 %@ 已分配儲存空間（實測）。未改動工作區、文稿、模型、環境和字型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "割り当てられたストレージ（測定済み）から約%@を回収しました。 ワークスペース、ドキュメント、モデル、環境、フォントは触れられていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할당된 저장 용량의 약 %@를 회수했습니다(측정됨). 워크스페이스, 문서, 모델, 환경 및 글꼴은 손대지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupéré environ %@ de stockage alloué (mesuré). Les espaces de travail, les documents, les modèles, les environnements et les polices n'ont pas été touchés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurückgefordert etwa %@ des zugewiesenen Speichers (gemessen). Arbeitsbereiche, Dokumente, Modelle, Umgebungen und Schriftarten wurden nicht berührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperado alrededor de %@ de almacenamiento asignado (medido). No se tocaron espacios de trabajo, documentos, modelos, entornos y fuentes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperado sobre %@ de armazenamento alocado (medido). Espaços de trabalho, documentos, modelos, ambientes e fontes não foram tocados."
          }
        }
      }
    },
