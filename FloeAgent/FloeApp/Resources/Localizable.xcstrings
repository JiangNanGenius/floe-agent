    "design.panel.select_node_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design workflow is attached to one canvas node. Select a node on the canvas, then reopen this panel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设计流程绑定在单个画布节点上。请先在画布中选择一个节点，再打开此面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計流程繫結在單個畫布節點上。請先在畫布中選擇一個節點，再開啟此面板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインワークフローは1つのキャンバスノードに添付されています。 キャンバス上のノードを選択し、次にこのパネルを再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디자인 워크플로는 하나의 캔버스 노드에 연결되어 있습니다. 캔버스에서 노드를 선택한 다음, 이 패널을 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le flux de travail de conception est attaché à un nœud de toile. Sélectionnez un nœud sur le canevas, puis rouvrez ce panneau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Design-Workflow ist an einen Canvas-Noten angehängt. Wählen Sie einen Knoten auf der Leinwand aus, und öffnen Sie dann das Bedienfeld erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El flujo de trabajo de diseño está adjunto a un nodo de lienzo. Seleccione un nodo en el lienzo y, a continuación, vuelva a abrir este panel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O fluxo de trabalho de design está anexado a um nó de tela. Selecione um nó na tela e, em seguida, reabra este painel."
          }
        }
      }
    },
