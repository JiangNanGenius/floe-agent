    "settings.settings_root_view.the_canvas_assistant_handles_search_reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas assistant handles search, reading assets and calling generation tools; the screen-understanding model recognizes handwriting, sketches and visual content that non-multimodal models cannot read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布助手负责搜索、读取素材与调用生成工具；画面理解模型负责识别笔迹、草图和非多模态模型无法读取的视觉内容。"
          }
        }
      }
    },
    "settings.settings_root_view.turning_sync_off_only_stops_transfers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning sync off only stops transfers; it does not delete uploaded canvases or assets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步只停止传输，不会删除已上传的画布或素材。"
          }
        }
      }
    },
    "settings.settings_root_view.understand_and_organize": {
      "extractionState": "manual",
      "localizations": {
