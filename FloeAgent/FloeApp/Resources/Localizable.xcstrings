    "app.bilingual.8557361a5d176688": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有网站数据？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all website data?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除所有網站資料？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのウェブサイトデータを削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 웹사이트 데이터를 삭제하시겠습니까?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer toutes les données du site Web ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Website-Daten löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los datos del sitio web?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir todos os dados do site?"
          }
        }
      }
    },
    "app.bilingual.27dd26721faaf4e4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除所有网站的 Cookie、缓存和本地存储，不会影响 Safari、钥匙串或你的文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes cookies, cache and local storage for all sites. It does not touch Safari, Keychain or your files."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除所有網站的 Cookie、快取和本地儲存，不會影響 Safari、鑰匙串或你的檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、すべてのサイトのクッキー、キャッシュ、ローカルストレージが削除されます。 Safari、Keychain、またはファイルには触れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 모든 사이트의 쿠키, 캐시 및 로컬 스토리지를 삭제합니다. Safari, 키체인 또는 파일에 영향을 주지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les cookies, le cache et le stockage local pour tous les sites. Il ne touche pas Safari, Keychain ou vos fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Cookies, Cache und lokaler Speicher für alle Websites gelöscht. Es berührt Safari, Schlüsselbund oder Ihre Dateien nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina las cookies, la caché y el almacenamiento local para todos los sitios. No toca Safari, Llavero ni tus archivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui cookies, cache e armazenamento local para todos os sites. Ele não toca no Safari, nas Chaves ou nos seus arquivos."
          }
        }
      }
    },
