    "app.bilingual.8ff239c98376e6c8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网站版本只改变请求中的 User-Agent，不会改变登录状态或页面权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site version changes only the request User-Agent; it does not change login state or page permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網站版本只改變請求中的 User-Agent，不會改變登入狀態或頁面許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトのバージョンは、User-Agent のリクエストのみを変更し、ログイン状態やページの権限は変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트 버전은 User-Agent 요청만 변경하며, 로그인 상태나 페이지 권한은 변경하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version du site ne modifie que l'agent utilisateur de la demande ; elle ne modifie pas l'état de connexion ou les autorisations de la page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Site-Version ändert nur den Anforderungs-User-Agent; sie ändert keinen Anmeldestatus oder Seitenberechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión del sitio solo cambia la solicitud de agente de usuario; no cambia el estado de inicio de sesión ni los permisos de la página."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão do site altera apenas a solicitação User-Agent; ela não altera o estado de login ou as permissões da página."
          }
        }
      }
    },
