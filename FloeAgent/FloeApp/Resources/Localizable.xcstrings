    "app.bilingual.2503c1b0396c201e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换库版本只影响以后选择的元件。已有设计保留自己的元件快照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching versions affects future selections. Existing designs keep their own part snapshots."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換庫版本隻影響以後選擇的元件。已有設計保留自己的元件快照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンを切り替えると、今後の選択に影響します。 既存のデザインは独自のパーツスナップショットを保持しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 전환은 향후 선택에 영향을 미칩니다. 기존 설계는 자체 부품 스냅샷을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de version affecte les sélections futures. Les conceptions existantes conservent leurs propres instantanés de pièces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wechseln von Versionen wirkt sich auf zukünftige Auswahlen aus. Vorhandene Designs behalten ihre eigenen Teil-Snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cambio de versión afecta a futuras selecciones. Los diseños existentes mantienen sus propias instantáneas de piezas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A troca de versões afeta as seleções futuras. Os projetos existentes mantêm seus próprios instantâneos de peças."
          }
        }
      }
    },
