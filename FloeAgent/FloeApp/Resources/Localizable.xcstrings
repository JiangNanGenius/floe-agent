    "app.bilingual.c6d4ac40c66b24e0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示网站域名和数据类型；缓存正文、Cookie 值和页面内容不会在这里显示。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only site domains and data types are shown; cache bodies, cookie values and page content are not displayed here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示網站域名和資料型別；快取正文、Cookie 值和頁面內容不會在這裡顯示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイトドメインとデータタイプのみが表示され、キャッシュボディ、クッキー値、ページコンテンツはここには表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이트 도메인과 데이터 유형만 표시되며, 캐시 본문, 쿠키 값 및 페이지 내용은 여기 표시되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les domaines de site et les types de données sont affichés ; les corps de cache, les valeurs des cookies et le contenu de la page ne sont pas affichés ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur Site-Domains und Datentypen angezeigt; Cache-Bodys, Cookie-Werte und Seiteninhalte werden hier nicht angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran los dominios del sitio y los tipos de datos; los cuerpos de caché, los valores de las cookies y el contenido de la página no se muestran aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente domínios de sites e tipos de dados são mostrados; corpos de cache, valores de cookies e conteúdo da página não são exibidos aqui."
          }
        }
      }
    },
