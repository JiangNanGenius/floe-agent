    "workbench.task_inspector_views.changes_save_automatically_and_apply_to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes save automatically and apply to the current run's next tool call."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改会自动保存，并立即应用到当前运行的下一次工具调用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改會自動儲存，並立即應用到當前執行的下一次工具呼叫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は自動的に保存され、現在の実行の次のツール呼び出しに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 자동으로 저장되며 현재 실행의 다음 도구 호출에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont automatiquement sauvegardées et appliquées au prochain appel d'outil de l'exécution actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden automatisch gespeichert und auf den nächsten Toolaufruf des aktuellen Laufs angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan automáticamente y se aplican a la siguiente llamada de herramienta de la ejecución actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são salvas automaticamente e se aplicam à próxima chamada de ferramenta da execução atual."
          }
        }
      }
    },
