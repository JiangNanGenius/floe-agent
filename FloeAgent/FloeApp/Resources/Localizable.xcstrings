    "cad.versions.restore.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document will be restored in place from “%@” and a new branch checkpoint will be created. The current design is saved as a recovery version first. Undo history starts fresh; the recovery version is how you go back to the previous design."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档将从“%@”就地恢复，并创建新的分支检查点。当前设计会先保存为恢复版本。撤销历史将重新开始；可通过恢复版本回到之前的设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件將從“%@”就地恢復，並建立新的分支檢查點。當前設計會先儲存為恢復版本。撤銷歷史將重新開始；可透過恢復版本回到之前的設計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書は「%@」から元の位置に復元され、新しいブランチチェックポイントが作成されます。 現在のデザインは、まずリカバリ版として保存されます。 元に戻す履歴は新たに開始されます。リカバリーバージョンは、前のデザインに戻る方法です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서는 “%@”에서 복원되며 새로운 지점 체크포인트가 생성됩니다. 현재 설계는 먼저 복구 버전으로 저장됩니다. 실행 취소 기록은 새롭게 시작됩니다; 복구 버전은 이전 디자인으로 돌아가는 방법입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document sera restauré en place à partir de \"%@\" et un nouveau point de contrôle de la succursale sera créé. La conception actuelle est d'abord enregistrée en tant que version de récupération. L'historique d' UndoUndo recommence à zéro ; la version de récupération est la façon dont vous revenez à la conception précédente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wird von \"%@\" wiederhergestellt und ein neuer Zweigstellen-Checkpoint erstellt. Das aktuelle Design wird zuerst als Wiederherstellungsversion gespeichert. Der Rückgängig-Verlauf beginnt neu; die Wiederherstellungsversion ist, wie Sie zum vorherigen Design zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento se restaurará en su lugar desde \"%@\" y se creará un nuevo punto de control de la sucursal. El diseño actual se guarda primero como una versión de recuperación. El historial de deshacer comienza de nuevo; la versión de recuperación es cómo se vuelve al diseño anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento será restaurado no lugar de “%@” e um novo ponto de verificação da filial será criado. O design atual é salvo como uma versão de recuperação primeiro. O histórico de desfazer começa de novo; a versão de recuperação é como você volta ao design anterior."
          }
        }
      }
    },
