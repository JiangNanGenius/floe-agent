    "app.bilingual.865b5ba673bfbf8f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未选择对应源码。完整分发导出需要你的精确源码包；公开源码未发布不影响本地工程导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No corresponding source selected. A full distribution export needs your exact source bundle; the unpublished public offer does not block this local engineering export."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未選擇對應原始碼。完整分發匯出需要你的精確原始碼包；公開原始碼未釋出不影響本地工程匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "該当するソースが選択されていません。 完全な配布エクスポートには正確なソースバンドルが必要です；未公開の公開オファーはこのローカルエンジニアリングエクスポートをブロックしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 소스가 선택되지 않았습니다. 전체 배포 내보내기에는 귀하의 정확한 소스 번들이 필요합니다; 미공개 공개 제안은 이 로컬 엔지니어링 내보내기를 차단하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune source correspondante n'a été sélectionnée. Une exportation de distribution complète a besoin de votre paquet source exact ; l'offre publique non publiée ne bloque pas cette exportation d'ingénierie locale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine entsprechende Quelle ausgewählt. Ein vollständiger Verteilungsexport benötigt Ihr genaues Quellpaket; das unveröffentlichte öffentliche Angebot blockiert diesen lokalen Engineering-Export nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha seleccionado ninguna fuente correspondiente. Una exportación de distribución completa necesita su paquete de origen exacto; la oferta pública no publicada no bloquea esta exportación de ingeniería local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma fonte correspondente selecionada. Uma exportação de distribuição completa precisa do seu pacote de origem exato; a oferta pública não publicada não bloqueia essa exportação de engenharia local."
          }
        }
      }
    },
