    "app.bilingual.c99b80e405518ba7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会先备份同名原文件；存档已被修改时将停止替换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file is backed up first. Replacement stops if the save has changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會先備份同名原檔案；存檔已被修改時將停止替換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のファイルは最初にバックアップされます。 保存が変更された場合、置換は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일이 먼저 백업됩니다. 저장이 변경된 경우 교체가 중지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier original est sauvegardé en premier. Le remplacement s'arrête si la sauvegarde a changé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei wird zuerst gesichert. Der Austausch wird gestoppt, wenn sich das Speichern geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se hace una copia de seguridad del archivo original. El reemplazo se detiene si el guardado ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original é copiado primeiro. A substituição é interrompida se o salvamento tiver mudado."
          }
        }
      }
    },
