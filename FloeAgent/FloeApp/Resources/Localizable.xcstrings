            "value": "Exclua este registro"
          }
        }
      }
    },
    "app.bilingual.d9dd472252fb66ff": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除记录后可在历史版本中恢复其名称与注释；序列至少保留一条记录。新记录请通过导入文件或新建空白序列创建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting a record keeps its name and annotations recoverable in version history; a sequence keeps at least one record. New records come from imported files or a new blank sequence."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除記錄後可在歷史版本中恢復其名稱與註釋；序列至少保留一條記錄。新記錄請透過匯入檔案或新建空白序列建立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レコードを削除すると、その名前とアノテーションはバージョン履歴で復元可能に保たれます。シーケンスは少なくとも1つのレコードを保持します。 新しいレコードは、インポートされたファイルまたは新しい空白シーケンスから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레코드를 삭제하면 해당 레코드의 이름과 주석이 버전 기록에서 복구 가능하도록 유지되며, 시퀀스는 최소 하나의 레코드를 유지합니다. 새 레코드는 가져온 파일이나 새로운 빈 시퀀스에서 가져옵니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression d'un enregistrement conserve son nom et ses annotations récupérables dans l'historique des versions ; une séquence conserve au moins un enregistrement. Les nouveaux enregistrements proviennent de fichiers importés ou d'une nouvelle séquence vierge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen eines Datensatzes behält seinen Namen und seine Anmerkungen im Versionsverlauf wiederherstellbar; eine Sequenz behält mindestens einen Datensatz bei. Neue Datensätze kommen aus importierten Dateien oder einer neuen leeren Sequenz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un registro mantiene su nombre y anotaciones recuperables en el historial de versiones; una secuencia mantiene al menos un registro. Los nuevos registros vienen de archivos importados o de una nueva secuencia en blanco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir um registro mantém seu nome e anotações recuperáveis no histórico de versões; uma sequência mantém pelo menos um registro. Novos registros vêm de arquivos importados ou de uma nova sequência em branco."
          }
        }
      }
    },
