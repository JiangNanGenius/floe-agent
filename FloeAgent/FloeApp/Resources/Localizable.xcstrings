    "app.bilingual.a6fb42e536982acf": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自实际计算回执；X 为径向、Z 为轴向，黑点为刀尖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the actual calculation receipt. X is radial, Z axial; the black point marks the tip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自實際計算回執；X 為徑向、Z 為軸向，黑點為刀尖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の計算領収書から。 Xは放射状で、Zは軸方向です。黒い点が先端を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 계산 영수증에서. X는 방사형이고 Z는 축형이며, 검은 점이 끝을 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À partir du reçu de calcul réel. X est radial, Z axial ; le point noir marque la pointe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der tatsächlichen Berechnungsquittung. X ist radial, Z axial; der schwarze Punkt markiert die Spitze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Del recibo del cálculo real. X es radial, Z axial; el punto negro marca la punta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do recibo de cálculo real. X é radial, Z axial; o ponto preto marca a ponta."
          }
        }
      }
    },
