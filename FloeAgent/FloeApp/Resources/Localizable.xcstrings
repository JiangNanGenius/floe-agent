    "edit.conflict.draftChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your draft changed. Your new edits are preserved; save again to review the conflict."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已发生变化，已保留你的新修改。请重新保存并检查冲突。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿已發生變化，已保留你的新修改。請重新儲存並檢查衝突。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のドラフトが変更されました。 新しい編集は保存されます。競合を確認するために、再度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 초안이 변경되었습니다. 새로운 편집이 보존됩니다; 충돌을 검토하려면 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre brouillon a changé. Vos nouvelles modifications sont conservées ; enregistrez à nouveau pour examiner le conflit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Entwurf hat sich geändert. Ihre neuen Änderungen bleiben erhalten; speichern Sie erneut, um den Konflikt zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu borrador cambió. Sus nuevas ediciones se conservan; guarde de nuevo para revisar el conflicto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu rascunho mudou. Suas novas edições são preservadas; salve novamente para revisar o conflito."
          }
        }
      }
    },
    "edit.conflict.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed while you were editing. Changes in separate places are combined; choose which overlapping changes to keep. The version will be checked again when saving."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在你编辑期间有了新的修改。不同位置的改动已合并；重叠部分由你选择。保存时会再次检查版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案在你編輯期間有了新的修改。不同位置的改動已合併；重疊部分由你選擇。儲存時會再次檢查版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集中にファイルが変更されました。 別々の場所の変更は結合されます。重複する変更のうち、保持するものを選択してください。 保存時にバージョンが再度確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에 파일이 변경되었습니다. 각각 다른 장소의 변경 사항이 결합됩니다; 유지할 겹치는 변경 사항을 선택하십시오. 버전을 저장할 때 다시 확인됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé pendant que vous étiez en train d'éditer. Les modifications dans des endroits distincts sont combinées ; choisissez les changements qui se chevauchent à conserver. La version sera vérifiée à nouveau lors de l'enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wurde während der Bearbeitung geändert. Änderungen an verschiedenen Stellen werden kombiniert; wählen Sie aus, welche sich überlappenden Änderungen behalten möchten. Die Version wird beim Speichern erneut überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió mientras estabas editando. Los cambios en lugares separados se combinan; elija qué cambios superpuestos mantener. La versión se comprobará de nuevo al guardar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo mudou enquanto você estava editando. Alterações em lugares separados são combinadas; escolha quais alterações sobrepostas manter. A versão será verificada novamente ao salvar."
          }
        }
      }
    },
