    "shortcuts.note.find_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find notes by title or indexed text, optionally within a date range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按标题或已索引的正文查找手记，可限定修改日期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按標題或已索引的正文查詢手記，可限定修改日期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトルまたはインデックスされたテキストで、任意で日付範囲内のノートを検索できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제목이나 색인된 텍스트로 메모를 찾을 수 있으며, 선택적으로 날짜 범위 내에서도 찾을 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des notes par titre ou texte indexé, éventuellement dans une plage de dates."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie Notizen nach Titel oder indiziertem Text, optional innerhalb eines Datumsbereichs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre notas por título o texto indexado, opcionalmente dentro de un rango de fechas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre notas por título ou texto indexado, opcionalmente dentro de um intervalo de datas."
          }
        }
