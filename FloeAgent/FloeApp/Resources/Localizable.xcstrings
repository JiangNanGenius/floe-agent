    "notes.notes_agent_tools.this_content_has_no_note_pages": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content has no note pages; only a limited read-only summary is available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容没有手记页面，仅提供受限的只读摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容沒有手記頁面，僅提供受限的只讀摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツにはノートページがなく、限られた読み取り専用の要約のみが利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠에는 메모 페이지가 없으며, 제한된 읽기 전용 요약만 제공됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu n'a pas de pages de notes ; seul un résumé limité en lecture seule est disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt hat keine Notizseiten; nur eine eingeschränkte schreibgeschützte Zusammenfassung ist verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido no tiene páginas de notas; solo está disponible un resumen limitado de solo lectura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conteúdo não tem páginas de notas; apenas um resumo limitado somente para leitura está disponível."
          }
        }
      }
    },
    "notes.notes_agent_tools.this_content_has_no_paginated_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content has no paginated note pages; for Office use section=officeText. Other types provide only a read-only summary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容没有分页手记页面；Office 请用 section=officeText，其他类型仅提供只读摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容沒有分頁手記頁面；Office 請用 section=officeText，其他型別僅提供只讀摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツにはページングされた注記ページがありません；Office の場合は section=officeText を使用してください。 他のタイプは読み取り専用の要約のみを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠에는 페이지가 구분된 메모 페이지가 없습니다; Office에서는 section=officeText를 사용하십시오. 다른 유형은 읽기 전용 요약만 제공합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu n'a pas de pages de notes paginées ; pour Office, utilisez section=officeText. D'autres types ne fournissent qu'un résumé en lecture seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt hat keine paginierten Notizseiten; für Office verwenden Sie section=officeText. Andere Typen bieten nur eine schreibgeschützte Zusammenfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido no tiene páginas de notas paginadas; para Office use section=officeText. Otros tipos proporcionan solo un resumen de solo lectura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conteúdo não tem páginas de notas paginadas; para o Office use section=officeText. Outros tipos fornecem apenas um resumo somente para leitura."
          }
        }
      }
    },
