    "cad.mesh.voxel.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild one enclosed scan as a uniform voxel surface. The original scan is kept; textures are not transferred."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将单个封闭扫描体重建为均匀体素表面。保留原扫描体，不传递纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將單個封閉掃描體重建為均勻體素表面。保留原掃描體，不傳遞紋理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたスキャンを1つ、均一なボクセル面として再構築してください。 元のスキャンは保持されます；テクスチャは転送されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 폐쇄된 스캔을 균일한 복셀 표면으로 재구성하십시오. 원본 스캔은 유지되며, 텍스처는 전송되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruisez un scan fermé comme une surface de voxel uniforme. Le scan original est conservé ; les textures ne sont pas transférées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bauen Sie einen geschlossenen Scan als einheitliche Voxeloberfläche wieder auf. Der Original-Scan bleibt erhalten; Texturen werden nicht übertragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruye un escaneo cerrado como una superficie de vóxel uniforme. El escaneo original se conserva; las texturas no se transfieren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstrua uma varredura fechada como uma superfície de voxel uniforme. A digitalização original é mantida; as texturas não são transferidas."
          }
        }
      }
    },
