    "environment.backend.update_needed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed Linux component is outdated. Update it from the download entry below; execution retries will not fix the old runner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装的 Linux 组件版本过旧。请通过下方下载入口更新；旧运行器不会因重试而恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝的 Linux 元件版本過舊。請透過下方下載入口更新；舊執行器不會因重試而恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされた Linux コンポーネントは古くなっています。 以下のダウンロードエントリから更新してください。実行の再試行では古いランナーは修正されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 Linux 구성 요소가 오래되었습니다. 아래 다운로드 항목에서 업데이트하십시오; 실행 재시도는 이전 실행자를 수정하지 못합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le composant Linux installé est obsolète. Mettez-le à jour à partir de l'entrée de téléchargement ci-dessous ; les nouvelles tentatives d'exécution ne répareront pas l'ancien coureur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierte Linux-Komponente ist veraltet. Aktualisieren Sie es über den Download-Eintrag unten; Ausführungsversuche beheben den alten Läufer nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El componente Linux instalado está desactualizado. Actualícelo desde la entrada de descarga a continuación; los reintentos de ejecución no arreglarán el antiguo corredor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O componente Linux instalado está desatualizado. Atualize-o a partir da entrada de download abaixo; novas tentativas de execução não corrigirão o corredor antigo."
          }
        }
      }
    },
