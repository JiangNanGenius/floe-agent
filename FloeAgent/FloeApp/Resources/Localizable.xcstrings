    "edit.conflict.notesApplyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These excerpts show text only. Open each version to check handwriting, images and layout. Applying your changes affects the original edited objects; unrelated content is retained. The recovery copy stays available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示文字摘要；请打开版本检查笔迹、图片和布局。应用修改会替换本次编辑涉及的内容，其余内容保留。恢复副本仍然保留。"
          }
        }
      }
    },
    "edit.conflict.notesCopy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered edit"
