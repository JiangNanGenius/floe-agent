    "voice.assistant.synthesis.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to assistant-generated audio. Ordinary read-aloud keeps its own voice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于助手生成音频；普通朗读仍使用其自身语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於助手生成音訊；普通朗讀仍使用其自身語音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタント生成オーディオにのみ適用されます。 普通の朗読は自らの声を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 생성한 오디오에만 적용됩니다. 일반적인 낭독은 자체적인 목소리를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique uniquement à l'audio généré par l'assistant. La lecture à haute voix ordinaire garde sa propre voix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für vom Assistenten generiertes Audio. Gewöhnliches Vorlesen behält seine eigene Stimme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica solo al audio generado por el asistente. La lectura en voz alta ordinaria mantiene su propia voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se apenas ao áudio gerado pelo assistente. Leitura em voz alta comum mantém sua própria voz."
          }
        }
      }
    },
