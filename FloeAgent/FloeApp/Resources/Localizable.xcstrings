    "hosts.tofu.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default the host key is trusted on first use and pinned thereafter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认首次使用时信任主机密钥，此后固定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設首次使用時信任主機金鑰，此後固定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、ホストキーは初回使用時に信頼され、その後は固定されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 호스트 키는 처음 사용할 때 신뢰되며 이후에 고정됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, la clé hôte est fiable lors de la première utilisation et épinglée par la suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig wird der Host-Schlüssel bei der ersten Verwendung vertrauenswürdig und danach angeheftet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, la clave de host es de confianza en el primer uso y se fija a partir de entonces."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, a chave do host é confiável no primeiro uso e fixada depois disso."
          }
        }
      }
    },
