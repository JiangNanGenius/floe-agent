    "canvas.native.flowDefinitionHelp": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置端口、条件、循环体、变量和自定义步骤。凭据与执行权限由宿主提供。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure ports, conditions, loop bodies, variables and custom steps. Credentials and execution access come from the host."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置埠、條件、迴圈體、變數和自定義步驟。憑據與執行許可權由宿主提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート、条件、ループ本体、変数、およびカスタムステップを構成します。 認証情報および実行アクセスはホストから取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트, 조건, 루프 본체, 변수 및 사용자 정의 단계를 구성합니다. 자격 증명 및 실행 접근 권한은 호스트에서 제공됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez les ports, les conditions, les corps de boucle, les variables et les étapes personnalisées. Les informations d'identification et l'accès à l'exécution proviennent de l'hôte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie Ports, Bedingungen, Schleifenkörper, Variablen und benutzerdefinierte Schritte. Anmeldeinformationen und Ausführungszugriff kommen vom Gastgeber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure puertos, condiciones, cuerpos de bucle, variables y pasos personalizados. Las credenciales y el acceso a la ejecución vienen del host."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure portas, condições, corpos de loop, variáveis e etapas personalizadas. As credenciais e o acesso à execução vêm do host."
          }
        }
      }
    },
