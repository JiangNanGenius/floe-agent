    "app.bilingual.2989e97d562042ae": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生引用已读回。请从现有元件选择器放置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native reference read back. Place it from the existing part chooser."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生引用已讀回。請從現有元件選擇器放置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ参照の読み返し 既存のパーツ選択器から配置してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 참조를 다시 읽습니다. 기존 부품 선택기에서 배치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Référence native lue en arrière. Placez-le à partir du sélecteur de pièces existant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Referenz zurückgelesen. Platzieren Sie es aus der vorhandenen Teileauswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Referencia nativa leída de nuevo. Colocarlo desde el selector de piezas existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Referência nativa lida de volta. Coloque-o a partir do seletor de peças existente."
          }
        }
      }
    },
