    "app.local_linux_display_owner.this_linux_environment_cannot_safely": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Linux 环境缺少安全启动屏幕所需的能力。请升级环境后再打开屏幕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Linux environment cannot safely start a screen. Upgrade it before reopening the screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前 Linux 環境缺少安全啟動螢幕所需的能力。請升級環境後再開啟螢幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Linux 環境では、画面を安全に起動できません。 画面を再度開く前にアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Linux 환경은 화면을 안전하게 시작할 수 없습니다. 화면을 다시 열기 전에 업그레이드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet environnement Linux ne peut pas démarrer un écran en toute sécurité. Mettez-le à niveau avant de rouvrir l'écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Linux-Umgebung kann einen Bildschirm nicht sicher starten. Aktualisieren Sie es, bevor Sie den Bildschirm wieder öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entorno Linux no puede iniciar una pantalla de forma segura. Actualízalo antes de volver a abrir la pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ambiente Linux não pode iniciar uma tela com segurança. Atualize-o antes de reabrir a tela."
          }
        }
      }
    },
    "app.local_linux_display_owner.this_linux_runtime_cannot_safely": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Linux 环境无法安全管理屏幕进程。请在执行环境中停止并重新启动 Linux；若问题仍在，请修复运行组件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Linux runtime cannot safely manage the screen process. Stop and restart Linux in Execution Environment; repair the component if it continues."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前 Linux 環境無法安全管理螢幕程序。請在執行環境中停止並重新啟動 Linux；若問題仍在，請修復執行元件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Linux ランタイムは、スクリーンプロセスを安全に管理できません。 実行環境で Linux を停止し、再起動してください；継続する場合はコンポーネントを修復してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Linux 런타임은 화면 프로세스를 안전하게 관리할 수 없습니다. 실행 환경에서 Linux를 중지하고 재시작하십시오; 계속되면 구성 요소를 복구하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce runtime Linux ne peut pas gérer le processus d'écran en toute sécurité. Arrêtez et redémarrez Linux dans l'environnement d'exécution ; réparez le composant s'il continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Linux-Laufzeit kann den Bildschirmprozess nicht sicher verwalten. Stoppen und starten Sie Linux in der Ausführungsumgebung neu; reparieren Sie die Komponente, wenn sie fortgesetzt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tiempo de ejecución de Linux no puede gestionar de forma segura el proceso de la pantalla. Detenga y reinicie Linux en el entorno de ejecución; repare el componente si continúa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este tempo de execução Linux não pode gerenciar com segurança o processo de tela. Pare e reinicie o Linux no Ambiente de Execução; repare o componente se continuar."
          }
        }
      }
    },
