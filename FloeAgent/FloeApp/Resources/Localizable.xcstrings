    "voice.cloud.profile.streaming.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show words while you speak. When off, recognize after each utterance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边说边显示文字。关闭后，在每句话结束后识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊說邊顯示文字。關閉後，在每句話結束後識別。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すときに言葉を示してください。 オフのときは、各発話の後に認識してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 동안 단어를 보여 주세요. 꺼져 있을 때는 각 발화 후에 인식하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrez des mots pendant que vous parlez. Lorsque vous êtes éteint, reconnaissez après chaque énoncé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie Wörter, während Sie sprechen. Wenn Sie aus sind, erkennen Sie nach jeder Äußerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra palabras mientras hablas. Cuando esté apagado, reconozca después de cada expresión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre palavras enquanto fala. Quando desligado, reconheça após cada enunciado."
          }
        }
      }
    },
