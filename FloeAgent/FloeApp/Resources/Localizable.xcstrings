          "stringUnit": {
            "state": "translated",
            "value": "原件已改變，請重新選擇元件後定位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元は変更されました。 部品を見つける前に、もう一度コンポーネントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본이 변경되었습니다. 해당 구성 요소를 찾기 전에 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original a changé. Sélectionnez à nouveau le composant avant de le localiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original hat sich geändert. Wählen Sie die Komponente erneut aus, bevor Sie sie finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original cambió. Selecciona el componente de nuevo antes de localizarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original mudou. Selecione o componente novamente antes de localizá-lo."
          }
        }
      }
    },
    "app.bilingual.57793c82ddf18b2": {
