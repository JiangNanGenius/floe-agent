    "app.bilingual.cba66dd8950a6dec": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作品已保存，但文件列表暂未更新。请稍后刷新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work was saved, but its file listing could not be updated. Refresh it shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作品已儲存，但檔案列表暫未更新。請稍後重新整理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業は保存されましたが、ファイル一覧を更新できませんでした。 すぐに更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 저장되었지만 파일 목록을 업데이트할 수 없습니다. 잠시 후에 새로 고침하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail a été enregistré, mais sa liste de fichiers n'a pas pu être mise à jour. Rafraîchissez-le sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeit wurde gespeichert, aber ihre Dateiliste konnte nicht aktualisiert werden. Aktualisieren Sie es in Kürze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo se guardó, pero no se pudo actualizar su lista de archivos. Refrésalo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho foi salvo, mas sua lista de arquivos não pôde ser atualizada. Atualize-o em breve."
          }
        }
      }
    },
