    "app.bilingual.a8c8a652d801b6ba": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音仍在进行。继续录音会保留后台录音；停止后会先保存最后一段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording is still in progress. Continue keeps recording in the background. Stopping saves the final audio before leaving."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音仍在進行。繼續錄音會保留後臺錄音；停止後會先儲存最後一段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はまだ進行中です。 Continue はバックグラウンドで録音し続けます。 停止すると、退出前に最終音声が保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹화가 아직 진행 중입니다. Continue는 백그라운드에서 계속 녹음됩니다. 중지하면 떠나기 전에 최종 오디오가 저장됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est toujours en cours. Continuez à enregistrer en arrière-plan. L'arrêt enregistre l'audio final avant de partir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist noch im Gange. Weiter nimmt im Hintergrund weiter auf. Stoppen speichert den letzten Ton, bevor er geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación sigue en curso. Continuar sigue grabando en segundo plano. Detenerse guarda el audio final antes de irse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação ainda está em andamento. Continuar continua gravando em segundo plano. Parar salva o áudio final antes de sair."
          }
        }
      }
    },
