    "app.git_hub_source_details.this_is_the_saved_location": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处保留这次读取的定位结果；尚未读取的讨论或历史行不会自动补齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the saved location. Discussions or historical lines outside the read are not automatically fetched."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處保留這次讀取的定位結果；尚未讀取的討論或歷史行不會自動補齊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは保存された場所です。 読み取り領域外の議論や履歴行は自動的に取得されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 저장된 위치입니다. 읽기 영역 외부에 있는 토론이나 과거 행은 자동으로 가져오지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'emplacement enregistré. Les discussions ou les lignes historiques en dehors de la lecture ne sont pas automatiquement récupérées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist der gespeicherte Standort. Diskussionen oder historische Zeilen außerhalb der Lektüre werden nicht automatisch abgerufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la ubicación guardada. Las discusiones o líneas históricas fuera de la lectura no se atraen automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a localização salva. Discussões ou linhas históricas fora da leitura não são abascadas automaticamente."
          }
        }
      }
    },
    "app.git_hub_source_details.this_link_references_a_historical": {
      "extractionState": "manual",
