    "canvas.generation.error.configuration_missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task has no saved generation configuration. Open Configure Task and save it first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该任务没有已保存的生成配置，请先打开“配置任务”并保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該任務沒有已儲存的生成配置，請先開啟“配置任務”並儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクには保存された生成設定がありません。 Configure Task を開き、まず保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에는 저장된 생성 구성이 없습니다. Configure Task를 열고 먼저 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche n'a pas de configuration de génération enregistrée. Ouvrez Configurer la tâche et enregistrez-la d'abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe hat keine Konfiguration der gespeicherten Generation. Öffnen Sie die Aufgabe konfigurieren und speichern Sie sie zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea no tiene una configuración de generación guardada. Abra Configurar tarea y guárdela primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa não tem configuração de geração salva. Abra a Tarefa de Configuração e salve-a primeiro."
          }
        }
      }
    },
    "canvas.generation.error.empty_image_result": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider completed without returning an image. Check the model and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商已完成请求，但没有返回图片。请检查模型后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商已完成請求，但沒有返回圖片。請檢查模型後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーは画像を返さずに完了しました。 モデルを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자는 이미지를 반환하지 않고 완료했습니다. 모델을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a terminé sans renvoyer d'image. Vérifiez le modèle et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat abgeschlossen, ohne ein Bild zurückzugeben. Überprüfen Sie das Modell und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor completó sin devolver una imagen. Comprueba el modelo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor completou sem retornar uma imagem. Verifique o modelo e tente novamente."
          }
        }
      }
    },
    "canvas.generation.error.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation could not be completed. Open task details to review the configuration and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成未能完成，请打开任务详情检查配置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成未能完成，請開啟任務詳情檢查配置後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成を完了できませんでした。 タスクの詳細を開いて、設定を確認し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성을 완료할 수 없습니다. 작업 세부 정보를 열어 구성을 검토하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération n'a pas pu être achevée. Ouvrez les détails de la tâche pour revoir la configuration et réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erzeugung konnte nicht abgeschlossen werden. Öffnen Sie die Aufgabendetails, um die Konfiguration zu überprüfen und es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la generación. Abra los detalles de la tarea para revisar la configuración y volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geração não pôde ser concluída. Abra os detalhes da tarefa para revisar a configuração e tentar novamente."
          }
        }
      }
    },
    "canvas.generation.error.invalid_request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider rejected the task parameters. Update the model or generation settings and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商拒绝了任务参数，请修改模型或生成设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商拒絕了任務引數，請修改模型或生成設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーはタスクパラメータを拒否しました。 モデルまたは世代設定を更新し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 작업 매개변수를 거부했습니다. 모델 또는 세대 설정을 업데이트하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a rejeté les paramètres de la tâche. Mettez à jour les paramètres du modèle ou de génération et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat die Aufgabenparameter abgelehnt. Aktualisieren Sie die Modell- oder Generationseinstellungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor rechazó los parámetros de la tarea. Actualice la configuración del modelo o generación y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor rejeitou os parâmetros da tarefa. Atualize as configurações do modelo ou geração e tente novamente."
          }
        }
      }
    },
    "canvas.generation.error.invalid_response": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider returned an incomplete result. The existing task and artifact have been preserved for retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商返回的结果不完整，原任务和产物节点已保留，可直接重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商返回的結果不完整，原任務和產物節點已保留，可直接重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーは不完全な結果を返しました。 既存のタスクとアーティファクトは再試行のために保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 불완전한 결과를 반환했습니다. 기존 작업과 아티팩트가 재시도를 위해 보존되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé un résultat incomplet. La tâche et l'artefact existants ont été préservés pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat ein unvollständiges Ergebnis zurückgegeben. Die vorhandene Aufgabe und das Artefakt wurden für einen erneuten Versuch aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor devolvió un resultado incompleto. La tarea y el artefacto existentes se han conservado para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor retornou um resultado incompleto. A tarefa e o artefato existentes foram preservados para nova tentativa."
          }
        }
      }
    },
    "canvas.generation.error.request_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote generation service failed. Check its status or credentials, then retry this task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程生成服务执行失败，请检查服务状态或凭据后重试当前任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端生成服務執行失敗，請檢查服務狀態或憑據後重試當前任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート生成サービスが失敗しました。 ステータスまたは認証情報を確認し、再度このタスクを実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 생성 서비스가 실패했습니다. 상태 또는 자격 증명을 확인한 후, 이 작업을 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de génération à distance a échoué. Vérifiez son statut ou ses informations d'identification, puis réessayez cette tâche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remote-Generierungsdienst ist fehlgeschlagen. Überprüfen Sie den Status oder die Anmeldeinformationen, und versuchen Sie diese Aufgabe erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de generación remota falló. Comprueba su estado o credenciales y, a continuación, vuelve a intentar esta tarea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de geração remota falhou. Verifique seu status ou credenciais e tente novamente esta tarefa."
          }
        }
      }
    },
    "canvas.generation.error.video_model_missing": {
      "localizations": {
        "en": {
