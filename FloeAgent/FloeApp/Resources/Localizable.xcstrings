    "app.bilingual.7c517990817ad816": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示文稿未能在限定时间内完成渲染，未显示空白编辑界面；编辑副本已保留，可重试或从“保留的文档”恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The presentation did not finish rendering in time. Your editing copy was retained; retry, or recover it under Retained Documents."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡報未能在限定時間內完成渲染，未顯示空白編輯介面；編輯副本已保留，可重試或從“保留的文件”恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレゼンテーションは時間内にレンダリングを完了しませんでした。 編集コピーが保持されました。再試行するか、Retained Documents から復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레젠테이션이 제때 렌더링을 마치지 못했습니다. 편집본이 보존되었습니다; 다시 시도하시거나 보존 문서에서 복구하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La présentation n'a pas terminé le rendu à temps. Votre copie d'édition a été conservée ; réessayez ou récupérez-la sous Documents conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Präsentation wurde nicht rechtzeitig zum Rendern abgeschlossen. Ihre bearbeitete Kopie wurde beibehalten. Versuchen Sie es erneut oder stellen Sie sie unter \"Behaltene Dokumente\" wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La presentación no terminó de renderizarse a tiempo. Su copia de edición se retuvo; inténtelo de nuevo o recupérela en Documentos retenidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A apresentação não terminou a renderização a tempo. Sua cópia de edição foi retida; tente novamente ou recupere-a em Documentos Retidos."
          }
        }
      }
    },
    "app.bilingual.39aeef038034ec78": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑副本未能在限定时间内完成渲染；编辑副本已保留，可重试或恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editing copy did not finish rendering in time. Your editing copy was retained; retry or recover it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯副本未能在限定時間內完成渲染；編輯副本已保留，可重試或恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集されたコピーは、時間内にレンダリングが完了しませんでした。 編集したコピーが保持されました。再試行するか、復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집본이 제때 렌더링을 완료하지 못했습니다. 편집본이 보관되었습니다; 다시 시도하거나 복구하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie d'édition n'a pas terminé le rendu à temps. Votre copie d'édition a été conservée ; réessayez-la ou récupérez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bearbeitungskopie wurde nicht rechtzeitig zum Rendern abgeschlossen. Ihre bearbeitete Kopie wurde beibehalten. Versuchen Sie es erneut oder stellen Sie sie wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de edición no terminó de renderizar a tiempo. Su copia de edición fue retenida; inténtela de nuevo o recupérela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia de edição não terminou a renderização a tempo. Sua cópia de edição foi mantida; tente novamente ou recupere-a."
          }
        }
      }
    },
    "app.bilingual.e5d5d11894ed2c8a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档渲染进程已停止；编辑副本已保留，可重试或稍后从“保留的文档”恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document renderer stopped. Your editing copy was retained; retry now or recover it later under Retained Documents."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件渲染程序已停止；編輯副本已保留，可重試或稍後從“保留的文件”恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントレンダラが停止しました。 編集コピーが保持されました。今すぐ再試行するか、後で「Retained Documents」から復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 렌더러가 멈췄습니다. 귀하의 편집본이 보관되었습니다; 지금 다시 시도하시거나 보관된 문서에서 나중에 복구하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de rendu de documents s'est arrêté. Votre copie d'édition a été conservée ; réessayez maintenant ou récupérez-la plus tard sous Documents conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument-Renderer wurde gestoppt. Ihre bearbeitete Kopie wurde beibehalten. Versuchen Sie es jetzt erneut oder stellen Sie sie später unter \"Behaltene Dokumente\" wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renderizador de documentos se detuvo. Su copia de edición se retuvo; vuelva a intentarlo ahora o recupérela más tarde en Documentos retenidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renderizador de documentos parou. Sua cópia de edição foi mantida; tente novamente agora ou recupere-a mais tarde em Documentos Retidos."
          }
        }
      }
    },
    "app.bilingual.3b58a41b9342a197": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档服务已停止响应，编辑副本已保留；重启应用后可恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document service stopped responding. Your editing copies were retained; restart the app to recover."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件服務已停止響應，編輯副本已保留；重啟應用後可恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書サービスが応答しなくなりました。 編集したコピーが保持されました。アプリを再起動して復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 서비스가 응답을 중단했습니다. 편집 복사본이 보관되었습니다; 복구하려면 앱을 재시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de documents a cessé de répondre. Vos copies d'édition ont été conservées ; redémarrez l'application pour récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dokumentendienst reagierte nicht mehr. Ihre Bearbeitungskopien wurden beibehalten; starten Sie die App neu, um sie wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de documentos dejó de responder. Sus copias de edición se conservaron; reinicie la aplicación para recuperarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de documentos parou de responder. Suas cópias de edição foram mantidas; reinicie o aplicativo para recuperar."
          }
        }
      }
    },
    "app.bilingual.48a4b7528ef9df3b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端/网络文档当前为只读快照。要编辑，请先将文件下载到本地工作区后再打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud and network documents are read-only snapshots. To edit, download the file to a local workspace and open it there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端/網路文件當前為只讀快照。要編輯，請先將檔案下載到本地工作區後再開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドおよびネットワーク文書は読み取り専用のスナップショットです。 編集するには、ファイルをローカルのワークスペースにダウンロードし、そこで開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 및 네트워크 문서는 읽기 전용 스냅샷입니다. 편집하려면 파일을 로컬 작업 공간에 다운로드한 뒤 그곳에서 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents cloud et réseau sont des instantanés en lecture seule. Pour modifier, téléchargez le fichier dans un espace de travail local et ouvrez-le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud- und Netzwerkdokumente sind schreibgeschützte Snapshots. Um sie zu bearbeiten, laden Sie die Datei in einen lokalen Arbeitsbereich herunter und öffnen Sie sie dort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos en la nube y de red son instantáneas de solo lectura. Para editar, descargue el archivo en un espacio de trabajo local y ábralo allí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Documentos de nuvem e rede são instantâneos somente leitura. Para editar, baixe o arquivo para um espaço de trabalho local e abra-o lá."
          }
        }
      }
    },
    "app.bilingual.b65d018076aa60bd": {
