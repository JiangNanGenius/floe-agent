    },
    "design.owner.generate_stopped_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting was stopped. The provider may already have generated and charged a result; this request will not be resubmitted automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止等待。服务商可能已经生成并计费；此请求不会自动重新提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止等待。服務商可能已經生成並計費；此請求不會自動重新提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機は停止されました。 プロバイダーはすでに結果を生成し、料金を請求している可能性があります。このリクエストは自動的に再送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기가 중단되었습니다. 제공자는 이미 결과를 생성하고 청구했을 수 있으며, 이 요청은 자동으로 재제출되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attente a été arrêtée. Le fournisseur a peut-être déjà généré et facturé un résultat ; cette demande ne sera pas soumise à nouveau automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Warten wurde gestoppt. Der Anbieter hat möglicherweise bereits ein Ergebnis generiert und berechnet; diese Anfrage wird nicht automatisch erneut eingereicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo la espera. Es posible que el proveedor ya haya generado y cobrado un resultado; esta solicitud no se volverá a enviar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A espera foi interrompida. O provedor pode já ter gerado e cobrado um resultado; esta solicitação não será reenviada automaticamente."
          }
        }
      }
    },
