          }
        }
      }
    },
    "app.bilingual.3031bf8cdeed6865": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的快照将被替换，且无法撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved snapshot will be replaced. This cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的快照將被替換，且無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたスナップショットは置き換えられます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 스냅샷이 교체됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'instantané enregistré sera remplacé. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Snapshot wird ersetzt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea guardada será reemplazada. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instantâneo salvo será substituído. Isso não pode ser desfeito."
          }
        }
      }
    },
    "app.bilingual.39169cda2417d496": {
