    "app.bilingual.5806dffb5d41cf11": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择仓库。仅本地/设备路径可用；需要 CI 的路线会给出明确缺失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No repository selected. Local/device routes remain; CI-only routes report their real missing prerequisite."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未選擇倉庫。僅本地/裝置路徑可用；需要 CI 的路線會給出明確缺失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリが選択されていません。 ローカル/デバイス ルートは残ります；CI のみのルートは実際の欠落した前提条件を報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 저장소가 없습니다. 로컬/디바이스 경로는 그대로 유지되며, CI 전용 경로는 실제 누락된 전제 조건을 보고합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun référentiel sélectionné. Les itinéraires locaux/d'appareils restent ; les itinéraires IC uniquement signalent leur véritable condition préalable manquante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Repository ausgewählt. Lokale/Geräterouten bleiben bestehen; Nur-CI-Routen melden ihre wirklich fehlende Voraussetzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha seleccionado el repositorio. Las rutas locales/dispositivos permanecen; las rutas solo de CI informan de su verdadero requisito previo perdido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum repositório selecionado. As rotas locais/dispositivos permanecem; as rotas somente de CI relatam seu pré-requisito real ausente."
          }
        }
      }
    },
