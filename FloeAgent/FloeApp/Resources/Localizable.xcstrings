          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade de um recurso de construção entra em conflito com outro recurso."
          }
        }
      }
    },
    "cad.building.error.theBuildingCouldNotBeRebuiltThe": {
      "localizations": {
