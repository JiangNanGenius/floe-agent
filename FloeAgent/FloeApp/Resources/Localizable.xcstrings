          }
        }
      }
    },
    "exec.vcpu.note_dual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared runtime supports up to %lld cores. CPU changes apply while running; stop projects before changing memory. Additional cores help work that can run in parallel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享环境最多使用 %lld 核。CPU 可在运行时调整，更改内存前需停止项目。更多核心只对能并行的任务有帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享環境最多使用 %lld 核。CPU 可在執行時調整，更改記憶體前需停止專案。更多核心只對能並行的任務有幫助。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有ランタイムは最大%lldコアをサポートしています。 CPUの変更は実行中に適用されます。メモリを変更する前にプロジェクトを停止してください。 追加のコアは、並行して実行できる作業を支援します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 런타임은 최대 %lld 코어를 지원합니다. CPU 변경 사항은 실행 중에 적용됩니다; 메모리를 교체하기 전에 프로젝트를 중지하십시오. 추가 코어는 병렬로 실행될 수 있는 작업을 돕습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution partagée prend en charge jusqu'à des cœurs %lld. Les modifications du processeur s'appliquent pendant l'exécution ; arrêtez les projets avant de changer la mémoire. Des cœurs supplémentaires aident à travailler en parallèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gemeinsame Laufzeit unterstützt bis zu %lld-Kerne. CPU-Änderungen gelten während der Ausführung; stoppen Sie Projekte, bevor Sie den Speicher wechseln. Zusätzliche Kerne helfen bei Arbeiten, die parallel ausgeführt werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de ejecución compartido admite hasta núcleos %lld. Los cambios de CPU se aplican durante la ejecución; detenga los proyectos antes de cambiar la memoria. Los núcleos adicionales ayudan a trabajar en paralelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de execução compartilhado suporta até núcleos %lld. As alterações da CPU se aplicam durante a execução; interrompa os projetos antes de alterar a memória. Núcleos adicionais ajudam a trabalhar que pode ser executado em paralelo."
          }
        }
      }
    },
    "exec.vcpu.note_single": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version uses 1 core. Choosing 2 cores shows an error instead of silently using 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本使用 1 个核心；选择 2 核会提示错误，不会静默改用 1 核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本使用 1 個核心；選擇 2 核會提示錯誤，不會靜默改用 1 核。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンは1コアを使用しています。 2コアを選択すると、静かに1コアを使用する代わりにエラーが発生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전은 1개의 코어를 사용합니다. 2개의 코어를 선택하면 1개를 조용히 사용하는 대신 오류가 발생합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version utilise 1 noyau. Choisir 2 cœurs montre une erreur au lieu d'en utiliser 1 en silence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version verwendet 1 Kern. Das Auswählen von 2 Kernen zeigt einen Fehler an, anstatt 1 stillschweigend zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión utiliza 1 núcleo. Elegir 2 núcleos muestra un error en lugar de usar 1 en silencio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão usa 1 núcleo. Escolher 2 núcleos mostra um erro em vez de usar silenciosamente 1."
          }
        }
      }
    },
