    "app.bilingual.b2ed5b4f653c160c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存修改会暂停后续推进，本轮按原目标继续执行。已有进度和结果会保留，可在目标条重新启用后续推进。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving pauses future advancement. This round keeps its original objective. Progress and results are retained; Resume re-enables future advancement."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存修改會暫停後續推進，本輪按原目標繼續執行。已有進度和結果會保留，可在目標條重新啟用後續推進。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存は将来の進展を一時停止します。 このラウンドは元の目的を維持します。 進捗と成果は保持されます；履歴書は将来の昇進を再び可能にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장은 미래 발전을 일시 중지합니다. 이번 라운드는 원래 목표를 유지합니다. 진전과 결과는 보존됩니다; 이력서는 미래의 발전을 재가능하게 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'épargne met en pause l'avancement futur. Ce tour conserve son objectif initial. Les progrès et les résultats sont conservés ; Resume permet à nouveau l'avancement futur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparen pausiert zukünftigen Fortschritt. Diese Runde behält ihr ursprüngliches Ziel bei. Fortschritte und Ergebnisse bleiben erhalten; Lebenslauf ermöglicht zukünftigen Fortschritt wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro pausa el progreso futuro. Esta ronda mantiene su objetivo original. El progreso y los resultados se conservan; el currículum vuelve a permiter el avance futuro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar pausa o avanço futuro. Esta rodada mantém seu objetivo original. O progresso e os resultados são mantidos; o currículo reativa o avanço futuro."
          }
        }
      }
    },
