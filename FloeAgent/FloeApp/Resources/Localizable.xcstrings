    "app.bilingual.6e42101c9bbbc989": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间线还没有可导出的画面。请先加入并显示视频或图片片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timeline has no visible frames to export. Add a video or image clip and make it visible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間線還沒有可匯出的畫面。請先加入並顯示影片或圖片片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインにはエクスポートできる可視フレームがありません。 動画または画像クリップを追加し、表示できるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인에 내보낼 눈에 보이는 프레임이 없습니다. 비디오 또는 이미지 클립을 추가하고 보이게 하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chronologie n'a pas de cadres visibles à exporter. Ajoutez un clip vidéo ou image et rendez-le visible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Timeline hat keine sichtbaren Frames zum Exportieren. Fügen Sie einen Video- oder Bildclip hinzu und machen Sie ihn sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La línea de tiempo no tiene marcos visibles para exportar. Añade un vídeo o un clip de imagen y hazlo visible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A linha do tempo não tem quadros visíveis para exportar. Adicione um vídeo ou clipe de imagem e torne-o visível."
          }
        }
      }
    },
