    "mail.error.connectionFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection failed. Check the server, certificate and network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败，请检查服务器、证书与网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線失敗，請檢查伺服器、證書與網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続に失敗しました。 サーバー、証明書、ネットワークを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결에 실패했습니다. 서버, 인증서 및 네트워크를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a échoué. Vérifiez le serveur, le certificat et le réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung fehlgeschlagen. Überprüfen Sie den Server, das Zertifikat und das Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión fallida. Compruebe el servidor, el certificado y la red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na conexão. Verifique o servidor, o certificado e a rede."
          }
        }
      }
    },
    "mail.error.deliveryUnknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delivery status unknown. Do not resend automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投递状态不确定，请勿自动重发。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "投遞狀態不確定，請勿自動重發。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配達状況は不明です。 自動的に再送しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배송 상태를 알 수 없습니다. 자동으로 다시 전송하지 마십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statut de livraison inconnu. Ne pas renvoyer automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieferstatus unbekannt. Senden Sie nicht automatisch erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de entrega desconocido. No vuelvas a enviar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Status de entrega desconhecido. Não reenvie automaticamente."
          }
        }
      }
    },
