    "services.start_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the assistant to start a Node.js or Python preview server in this workspace. Its status and controls appear here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以让助手在此工作区启动 Node.js 或 Python 网页预览服务，随后在这里查看状态与管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以讓助手在此工作區啟動 Node.js 或 Python 網頁預覽服務，隨後在這裡檢視狀態與管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントに、このワークスペースで Node.js または Python プレビューサーバーを起動するよう依頼してください。 そのステータスとコントロールはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간에서 보조에게 Node.js 또는 Python 프리뷰 서버를 시작하도록 요청하십시오. 그 상태와 제어가 여기 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l'assistant de démarrer un serveur de prévisualisation Node.js ou Python dans cet espace de travail. Son statut et ses contrôles apparaissent ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitten Sie den Assistenten, einen Node.js- oder Python-Vorschauserver in diesem Arbeitsbereich zu starten. Sein Status und seine Kontrollen werden hier angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pida al asistente que inicie un servidor de vista previa de Node.js o Python en este espacio de trabajo. Su estado y controles aparecen aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ao assistente para iniciar um servidor de visualização Node.js ou Python neste espaço de trabalho. Seu status e controles aparecem aqui."
          }
        }
      }
    },
