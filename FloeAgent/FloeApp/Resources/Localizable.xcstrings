    "environment.packages.linux.recommended.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download common tools from the current Linux environment’s package sources. APT resolves dependencies and architecture compatibility during installation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从当前 Linux 环境的软件源下载常用工具。安装时由 APT 解析依赖与架构兼容性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從當前 Linux 環境的軟體源下載常用工具。安裝時由 APT 解析依賴與架構相容性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のLinux環境のパッケージソースから共通ツールをダウンロードしてください。 APTは、インストール時に依存関係とアーキテクチャの互換性を解決します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Linux 환경의 패키지 소스에서 일반 도구를 다운로드하십시오. APT는 설치 중에 종속성 및 아키텍처 호환성을 해결합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez les outils courants à partir des sources de paquets de l'environnement Linux actuel. APT résout les dépendances et la compatibilité de l'architecture pendant l'installation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie gängige Tools aus den Paketquellen der aktuellen Linux-Umgebung herunter. APT löst Abhängigkeiten und Architekturkompatibilität während der Installation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargue herramientas comunes de las fuentes de paquetes del entorno actual Linux. APT resuelve las dependencias y la compatibilidad de la arquitectura durante la instalación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe ferramentas comuns das fontes de pacotes do ambiente Linux atual. O APT resolve dependências e compatibilidade de arquitetura durante a instalação."
          }
        }
      }
    },
