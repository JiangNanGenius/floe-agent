    "share.intake.discard_confirm_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared items will be deleted. This can't be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的内容将被删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分享的內容將被刪除，且無法恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された項目は削除されます。 これは取り消すことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 항목이 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments partagés seront supprimés. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die freigegebenen Elemente werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos compartidos serán eliminados. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens compartilhados serão excluídos. Isso não pode ser desfeito."
          }
        }
      }
    },
