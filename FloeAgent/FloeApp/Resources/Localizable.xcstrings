    "cad.sculpt.hasLevels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mesh has sculpt levels. Use Sculpt to keep its detail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网格包含多级雕刻，请使用“雕刻”保留细节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此網格包含多級雕刻，請使用“雕刻”保留細節。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッシュには彫刻レベルがあります。 Sculpt を使用して詳細を保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시는 스컬프트 레벨을 가지고 있습니다. Sculpt를 사용하여 세부 사항을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette maille a des niveaux de sculpture. Utilisez Sculpt pour conserver ses détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netz hat Formstufen. Verwenden Sie Sculpt, um seine Details beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta malla tiene niveles de escultura. Usa Sculpt para mantener sus detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta malha tem níveis de escultura. Use Sculpt para manter seus detalhes."
          }
        }
      }
    },
    "cad.sculpt.strokeLimit": {
