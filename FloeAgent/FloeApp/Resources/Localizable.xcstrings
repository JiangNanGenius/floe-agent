        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa cara no es única (candidatos %d). Vuelve a seleccionar una cara distinta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse rosto não é único (candidatos %d). Selecione novamente um rosto distinto."
          }
        }
      }
    },
    "cad.material.error.duplicateName": {
