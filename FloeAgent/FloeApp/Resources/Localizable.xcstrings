    "providers.auxiliary_models_view.add_and_maintain_video_models_under": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add and maintain video models under “Model providers”; here you only choose the model the agent uses by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“模型服务商”中添加和维护视频模型；这里仅选择 Agent 默认使用的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在“模型服務商”中新增和維護影片模型；這裡僅選擇 Agent 預設使用的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Model providers」の下でビデオモデルを追加し、維持します。ここでは、エージェントがデフォルトで使用するモデルのみを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“Model providers” 아래에서 비디오 모델을 추가하고 유지하십시오; 여기서는 에이전트가 기본적으로 사용하는 모델만 선택합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez et maintenez des modèles vidéo sous \"Fournisseurs de modèles\" ; ici, vous ne choisissez que le modèle que l'agent utilise par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Videomodelle unter \"Modellanbieter\" hinzu und pflegen Sie sie; hier wählen Sie nur das Modell aus, das der Agent standardmäßig verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue y mantenga modelos de vídeo en \"Proveedores de modelos\"; aquí solo elige el modelo que el agente utiliza por defecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione e mantenha modelos de vídeo em \"Provedores de modelos\"; aqui você escolhe apenas o modelo que o agente usa por padrão."
          }
        }
      }
    },
