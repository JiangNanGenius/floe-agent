    "app.task_schedule_cleanup_popup.was_deleted_you_had_set": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除「%@」。你为它设置过系统自动化，请在快捷指令中删除对应自动化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” was deleted. You had set up a system automation for it — remove that automation in Shortcuts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除「%@」。你為它設定過系統自動化，請在快捷指令中刪除對應自動化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”は削除されました。 それに対してシステムオートメーションを設定していました — ショートカットでそのオートメーションを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”가 삭제되었습니다. 귀하께서는 이를 위해 시스템 자동화를 설정하셨지만, 단축어에서 해당 자동화를 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" a été supprimé. Vous aviez configuré une automatisation du système pour cela - supprimez cette automatisation dans Raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wurde gelöscht. Sie hatten eine Systemautomatisierung dafür eingerichtet - entfernen Sie diese Automatisierung in Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" fue eliminado. Había configurado una automatización del sistema para ello, elimine esa automatización en Accesos directos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” foi excluído. Você configurou uma automação de sistema para isso — remova essa automação em Atalhos."
          }
        }
      }
    },
    "app.task_schedule_cleanup_popup.the_one_time_plan_has": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性计划「%@」已运行结束，不会再运行。请在快捷指令中删除对应自动化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-time plan “%@” has finished running and will not fire again. Remove its automation in Shortcuts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性計劃「%@」已執行結束，不會再執行。請在快捷指令中刪除對應自動化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタイムプラン「%@」は実行が終了し、再び発火しません。 ショートカット内の自動化を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회성 요금제 “%@”가 실행을 마쳤으며 다시는 발사되지 않을 것입니다. 단축어에서 자동화를 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan unique \"%@\" a fini de fonctionner et ne se déclenchera plus. Supprimez son automatisation dans les raccourcis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der einmalige Plan \"%@\" läuft nicht mehr und wird nicht mehr abgefeuert. Entfernen Sie die Automatisierung in Shortcuts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan único \"%@\" ha terminado de funcionar y no se volverá a disparar. Elimine su automatización en Atajos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano único “%@” terminou de funcionar e não disparará novamente. Remova sua automação em Atalhos."
          }
        }
      }
    },
