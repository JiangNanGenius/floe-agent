    "app.bilingual.c18be4d9598461c6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃修改或中止合并时，会先保留可恢复内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discarding changes or aborting a merge first keeps recoverable content."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄修改或中止合併時，會先保留可恢復內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を破棄するか、マージを最初に中止することで、復元可能なコンテンツが保たれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 먼저 삭제하거나 병합을 중단하면 복구 가능한 콘텐츠가 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abandon des modifications ou l'annulation d'une fusion conserve d'abord le contenu récupérable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verwerfen von Änderungen oder das Abbrechen einer Zusammenführung zuerst behält wiederherstellbare Inhalte bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar cambios o abortar una fusión primero mantiene el contenido recuperable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar alterações ou abortar uma mesclagem primeiro mantém o conteúdo recuperável."
          }
        }
      }
    },
