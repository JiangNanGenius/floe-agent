        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오가 내보냈으며, 캔버스 또는 노드가 변경되었으므로 재질 라이브러리에서 삽입하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo a été exportée ; le canevas ou le nœud a changé, alors insérez-le à partir de la bibliothèque de matériel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Video wurde exportiert; die Leinwand oder der Knoten hat sich geändert, also fügen Sie es aus der Materialbibliothek ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo fue exportado; el lienzo o nodo cambió, así que insértelo desde la biblioteca de materiales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo foi exportado; a tela ou o nó mudou, então insira-o na biblioteca de materiais."
          }
        }
      }
    },
