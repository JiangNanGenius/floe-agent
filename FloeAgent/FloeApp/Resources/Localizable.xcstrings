    "app.cadbuilding_professional_view.generate_ifc4_from_the_current": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从当前建筑构件与保存的几何生成 IFC4，并重新读取检查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate IFC4 from the current building elements and saved geometry, then read it back for validation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從當前建築構件與儲存的幾何生成 IFC4，並重新讀取檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の建築要素と保存されたジオメトリからIFC4を生成し、検証のためにそれを読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 건물 요소와 저장된 기하학에서 IFC4를 생성한 뒤, 검증을 위해 다시 읽어오십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez IFC4 à partir des éléments de construction actuels et de la géométrie enregistrée, puis relisez-le pour validation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generieren Sie IFC4 aus den aktuellen Gebäudeelementen und gespeicherten Geometrien und lesen Sie es dann zur Validierung zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genere IFC4 a partir de los elementos del edificio actual y la geometría guardada, luego vuelva a leerlo para su validación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere IFC4 a partir dos elementos de construção atuais e geometria salva, depois leia-o de volta para validação."
          }
        }
      }
    },
    "app.cadbuilding_professional_view.run_a_linear_elastic_calculation": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对一根矩形梁进行线弹性计算。请明确选择梁、支撑条件、材料与均布载荷。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a linear elastic calculation for one rectangular beam. Explicitly choose its supports, material and uniform load."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對一根矩形梁進行線彈性計算。請明確選擇梁、支撐條件、材料與均布載荷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つの長方形ビームに対して線形弾性計算を実行してください。 サポート、材料、そして均一な荷重を明示的に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 직사각형 빔에 대해 선형 탄성 계산을 수행하십시오. 그 지지대, 재료 및 균일 하중을 명시적으로 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez un calcul élastique linéaire pour une poutre rectangulaire. Choisissez explicitement ses supports, sa charge matérielle et uniforme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie eine lineare elastische Berechnung für einen rechteckigen Balken durch. Wählen Sie explizit die Stützen, das Material und die einheitliche Last."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecute un cálculo elástico lineal para una viga rectangular. Elija explícitamente sus soportes, material y carga uniforme."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute um cálculo elástico linear para uma viga retangular. Escolha explicitamente seus suportes, material e carga uniforme."
          }
        }
      }
    },
    "app.cadbuilding_professional_view.check_geometric_intersections_between_pipes": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查管道、风管与墙、板、屋顶、梁柱之间的几何相交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check geometric intersections between pipes or ducts and walls, slabs, roofs, beams and columns."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查管道、風管與牆、板、屋頂、樑柱之間的幾何相交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配管やダクトと壁、スラブ、屋根、梁、柱との幾何学的交差を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파이프 또는 덕트와 벽, 슬래브, 지붕, 빔 및 기둥 사이의 기하학적 교차점을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les intersections géométriques entre les tuyaux ou les conduits et les murs, les dalles, les toits, les poutres et les colonnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie geometrische Schnittpunkte zwischen Rohren oder Kanälen und Wänden, Platten, Dächern, Balken und Säulen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe las intersecciones geométricas entre tuberías o conductos y paredes, losas, techos, vigas y columnas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as interseções geométricas entre tubos ou dutos e paredes, lajes, telhados, vigas e colunas."
          }
        }
      }
    },
