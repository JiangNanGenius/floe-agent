        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビューではいくつかのパスが省略されており、エクスポートは完全な結果を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 보기에서는 일부 경로가 생략되었습니다; 내보내기가 전체 결과를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains chemins sont omis de cette vue ; l'exportation conserve le résultat complet."
