    "skills.skills_view.only_pinned_version_pypi_none_any": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only pinned-version PyPI none-any wheels are accepted; after installation, identical scripts and dependencies skip repeated review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只接受固定版本的 PyPI none-any wheel；安装后仅相同脚本与依赖可免重复审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只接受固定版本的 PyPI none-any wheel；安裝後僅相同指令碼與依賴可免重複稽核。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされた PyPI の no-any ホイールのみが受け付けられます；インストール後、同一のスクリプトや依存関係は繰り返しレビューを省略します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 버전 PyPI none-any 휠만 허용됩니다; 설치 후 동일한 스크립트와 종속성은 반복 검토를 생략합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les roues PyPI en version épinglée sont acceptées ; après l'installation, les scripts et les dépendances identiques sautent l'examen répété."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur angeheftete PyPI-Version keine-keine Räder werden akzeptiert; nach der Installation überspringen identische Skripte und Abhängigkeiten die wiederholte Überprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aceptan las ruedas de la versión anclada PyPI ninguna; después de la instalación, los scripts y dependencias idénticos omiten la revisión repetida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a versão fixada PyPI nenhuma-qualquer rodas são aceitas; após a instalação, scripts e dependências idênticos ignoram a revisão repetida."
          }
        }
      }
    },
