    "shortcuts.schedule.run.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the selected Floe schedule's due occurrence in the background and return its run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台运行所选 Floe 日程已到期的实例，并返回它的运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在後臺執行所選 Floe 日程已到期的例項，並返回它的執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された Floe スケジュールの実行期限をバックグラウンドで実行し、その実行を返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 Floe 일정의 due occurrence를 백그라운드에서 실행하고 해당 실행을 반환합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez l'occurrence due du calendrier Floe sélectionné en arrière-plan et retournez son exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie das fällige Vorkommen des ausgewählten Floe-Zeitplans im Hintergrund aus und geben Sie seine Ausführung zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecute la debida ocurrencia del horario Floe seleccionado en segundo plano y devuelva su ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute a ocorrência devida do cronograma Floe selecionado em segundo plano e retorne sua execução."
          }
        }
      }
    },
    "shortcuts.schedule.run.error.claimed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another executor is already starting this schedule. Try again shortly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个执行器正在启动该日程，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個執行器正在啟動該日程，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の執行者がすでにこのスケジュールを開始しています。 すぐにもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 집행자가 이미 이 일정을 시작하고 있습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre exécuteur est déjà en train de commencer ce calendrier. Réessayez sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Testamentsvollstrecker beginnt bereits mit diesem Zeitplan. Versuchen Sie es in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro ejecutor ya está comenzando este horario. Inténtalo de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro executor já está iniciando este cronograma. Tente novamente em breve."
          }
        }
      }
    },
