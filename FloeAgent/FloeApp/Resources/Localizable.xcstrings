    "document.intake.busy_switch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save or close the current note, then open the imported document from Notes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存或关闭当前手记，再从“手记”中打开导入的文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
