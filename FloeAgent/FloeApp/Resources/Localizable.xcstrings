        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for image generation and editing; the default routing is set under “Auxiliary models”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于图片生成与编辑；默认路由在“辅助模型”中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於圖片生成與編輯；預設路由在“輔助模型”中設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の生成および編集に使用されます；デフォルトのルーティングは「Auxiliary models」で設定されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 생성 및 편집에 사용됩니다; 기본 라우팅은 “보조 모델” 아래에 설정됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour la génération et l'édition d'images ; le routage par défaut est défini sous \"Modèles auxiliaires\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für die Bildgenerierung und -bearbeitung verwendet; das Standardrouting ist unter \"Hilfsmodelle\" festgelegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para la generación y edición de imágenes; el enrutamiento predeterminado se establece en \"Modelos auxiliares\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para geração e edição de imagens; o roteamento padrão é definido em \"Modelos auxiliares\"."
          }
        }
      }
    },
