    "app.bilingual.5cb6d8fa11114567": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "羽化在工具选项栏调整；选区本身是临时状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust feather in the tool options bar; the selection itself is temporary."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "羽化在工具選項欄調整；選區本身是臨時狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールオプションバーのフェザーを調整してください；選択自体は一時的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 옵션 바에서 페더를 조정하십시오; 선택 자체가 임시입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la plume dans la barre d'options d'outils ; la sélection elle-même est temporaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie die Feder in der Werkzeugoptionenleiste an; die Auswahl selbst ist vorübergehend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la pluma en la barra de opciones de herramientas; la selección en sí es temporal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste a pena na barra de opções de ferramentas; a seleção em si é temporária."
          }
        }
      }
    },
    "app.bilingual.80536f8dbd2a878a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上拖动建立矩形、椭圆或套索选区，或点按使用魔棒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the canvas to make a rectangular, elliptical or lasso selection, or tap with the magic wand."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布上拖動建立矩形、橢圓或套索選區，或點按使用魔棒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスをドラッグして、長方形、楕円形、またはラッソで選択するか、マジックワンドでタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 드래그하여 직사각형, 타원형 또는 올가미 선택을 만들거나, 마법 지팡이로 탭하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser la toile pour faire une sélection rectangulaire, elliptique ou lasso, ou appuyez avec la baguette magique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie auf der Leinwand, um eine rechteckige, elliptische oder Lasso-Auswahl zu treffen, oder tippen Sie mit dem Zauberstab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre el lienzo para hacer una selección rectangular, elíptica o de lazo, o toque con la varita mágica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a tela para fazer uma seleção retangular, elíptica ou de lasso, ou toque com a varinha mágica."
          }
        }
      }
    },
