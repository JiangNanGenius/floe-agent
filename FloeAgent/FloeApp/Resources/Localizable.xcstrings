    "workspace.office_document_editor_view.save_writes_changes_to_the_original": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save writes changes to the original file. Discard removes the editing copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存会通过共享保存流程写回原文件；放弃会删除编辑副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存會透過共享儲存流程寫回原檔案；放棄會刪除編輯副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存は元のファイルに変更を書き込みます。 Discard は編集コピーを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Save는 원본 파일에 변경 사항을 기록합니다. 버리면 편집 복사본이 제거됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les modifications d'écriture dans le fichier d'origine. Décarte supprime la copie d'édition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Schreibänderungen in der Originaldatei. \"Verwerfen\" entfernt die Bearbeitungskopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar los cambios de escritura en el archivo original. Descartar elimina la copia de edición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve as alterações de gravação no arquivo original. Descartar remove a cópia de edição."
          }
        }
      }
    },
