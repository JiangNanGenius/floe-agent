    "cad.mesh.hybrid.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add editable holes, cuts and bosses to a closed mesh, or combine it with a solid. The original bodies are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在闭合网格上添加可编辑的孔、切除和凸台，或与实体组合。原始模型会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在閉合網格上新增可編輯的孔、切除和凸臺，或與實體組合。原始模型會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じたメッシュに編集可能な穴、カット、ボスを追加するか、ソリッドと組み合わせてください。 元の遺体は保管されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 메시에 편집 가능한 구멍, 컷 및 보스를 추가하거나 솔리드와 결합하십시오. 원본 시신은 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des trous, des coupes et des bosses modifiables à un maillage fermé, ou combinez-le avec un solide. Les corps originaux sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einem geschlossenen Netz bearbeitbare Löcher, Schnitte und Knöcher hinzu oder kombinieren Sie es mit einem festen. Die Originalkörper werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue agujeros, cortes y jefes editables a una malla cerrada, o combínela con un sólido. Se conservan los cuerpos originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione furos, cortes e chefes editáveis a uma malha fechada ou combine-o com um sólido. Os corpos originais são mantidos."
          }
        }
      }
    },
