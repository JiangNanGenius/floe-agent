    "app.git_hub_source_card.this_historical_source_is_read": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此历史来源仅供阅读。请从已关联的原项目打开协作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
