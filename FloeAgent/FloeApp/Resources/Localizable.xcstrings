        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an execution location in this work assistant's main task before checking its capabilities."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在當前作品助手的主任務中選擇執行位置，再檢查環境能力。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この作業アシスタントのメインタスクで実行場所を選択し、その機能を確認する前に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 도우미의 기본 작업에서 실행 위치를 선택한 후 기능을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un emplacement d'exécution dans la tâche principale de cet assistant de travail avant de vérifier ses capacités."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Ausführungsort in der Hauptaufgabe dieses Arbeitsassistenten, bevor Sie seine Fähigkeiten überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una ubicación de ejecución en la tarea principal de este asistente de trabajo antes de comprobar sus capacidades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um local de execução na tarefa principal deste assistente de trabalho antes de verificar suas capacidades."
          }
        }
      }
    },
    "app.bilingual.c7fd88e03e353a18": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选运行环境不可用或已更改。请检查当前任务的运行位置后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected execution environment is unavailable or changed. Check this task's execution location before retrying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選執行環境不可用或已更改。請檢查當前任務的執行位置後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された実行環境は利用できないか、変更されています。 再試行する前に、このタスクの実行場所を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 실행 환경이 사용 불가능하거나 변경되었습니다. 재시도하기 전에 이 작업의 실행 위치를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement d'exécution sélectionné est indisponible ou modifié. Vérifiez l'emplacement d'exécution de cette tâche avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Ausführungsumgebung ist nicht verfügbar oder wurde geändert. Überprüfen Sie den Ausführungsort dieser Aufgabe, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de ejecución seleccionado no está disponible o ha cambiado. Compruebe la ubicación de ejecución de esta tarea antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente de execução selecionado não está disponível ou foi alterado. Verifique o local de execução desta tarefa antes de tentar novamente."
          }
        }
      }
    },
    "app.bilingual.52b2c12820c6d5a0": {
      "extractionState": "manual",
      "localizations": {
