    "app.bilingual.3bdd5ca3a0b8134": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件内容在解压后按需读取，不会修改压缩包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File content is read on demand after a bounded extraction; the archive itself is never modified."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案內容在解壓後按需讀取，不會修改壓縮包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容は、有界抽出後にオンデマンドで読み取られます；アーカイブ自体は決して変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 내용은 제한된 추출 후 필요에 따라 읽히며, 아카이브 자체는 절대 수정되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du fichier est lu à la demande après une extraction limitée ; l'archive elle-même n'est jamais modifiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateiinhalt wird nach einer begrenzten Extraktion bei Bedarf gelesen; das Archiv selbst wird nie geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido del archivo se lee bajo demanda después de una extracción limitada; el archivo en sí nunca se modifica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo do arquivo é lido sob demanda após uma extração limitada; o arquivo em si nunca é modificado."
          }
        }
      }
    },
