    "hosts.host_editor_view.ssh_is_an_optional_connection_method": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH is an optional connection method for the device; only VNC, Telnet, TCP or BLE serial devices do not need it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 是设备可选的连接方式；仅 VNC、Telnet、TCP 或 BLE 串口设备无需启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH 是裝置可選的連線方式；僅 VNC、Telnet、TCP 或 BLE 串列埠裝置無需啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH はデバイスのオプション接続方式です；VNC、Telnet、TCP、または BLE シリアルデバイスのみが必要としません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH는 장치에 대한 선택적 연결 방법이며, VNC, Telnet, TCP 또는 BLE 직렬 장치만 필요하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH est une méthode de connexion optionnelle pour l'appareil ; seuls les appareils série VNC, Telnet, TCP ou BLE n'en ont pas besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH ist eine optionale Verbindungsmethode für das Gerät; nur VNC-, Telnet-, TCP- oder BLE-Seriengeräte benötigen sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH es un método de conexión opcional para el dispositivo; solo los dispositivos serie VNC, Telnet, TCP o BLE no lo necesitan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SSH é um método de conexão opcional para o dispositivo; apenas os dispositivos seriais VNC, Telnet, TCP ou BLE não precisam dele."
          }
        }
      }
    },
