          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved authorization is unavailable. Unlock this device and try again; it was retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法使用已儲存的授權。請解鎖裝置後重試；連線已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された認可は利用できません。 このデバイスのロックを解除し、再度お試しください；保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 권한을 사용할 수 없습니다. 이 기기의 잠금을 해제하고 다시 시도하십시오; 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation enregistrée n'est pas disponible. Déverrouillez cet appareil et réessayez ; il a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Autorisierung ist nicht verfügbar. Entsperren Sie dieses Gerät und versuchen Sie es erneut; es wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La autorización guardada no está disponible. Desbloquee este dispositivo e inténtelo de nuevo; se retuvo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autorização salva não está disponível. Desbloqueie este dispositivo e tente novamente; ele foi retido."
          }
        }
      }
    },
    "app.bilingual.9583b2de345b7f97": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
