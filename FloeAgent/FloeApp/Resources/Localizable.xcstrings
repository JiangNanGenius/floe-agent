    "app.bilingual.45145bf56fd077ac": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无图形，可在上方输入坐标添加，或直接在图纸上拖拽绘制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No graphics yet. Add coordinates above or drag on the drawing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無圖形，可在上方輸入座標新增，或直接在圖紙上拖拽繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだグラフィックはありません。 座標を上に追加するか、図面上でドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 그래픽이 없습니다. 그림 위에 좌표를 추가하거나 끌어다 놓으세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de graphiques. Ajoutez les coordonnées ci-dessus ou faites glisser le dessin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Grafiken. Fügen Sie oben Koordinaten hinzu oder ziehen Sie auf die Zeichnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay gráficos. Añade las coordenadas arriba o arrastra el dibujo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem gráficos ainda. Adicione coordenadas acima ou arraste no desenho."
          }
        }
      }
    },
