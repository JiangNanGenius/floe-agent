    "app.bilingual.ae7eeac6b1fa8bd5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指绘画，双指移动与缩放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw with one finger; use two to pan and zoom."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指繪畫，雙指移動與縮放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片指で描き、2本でパンとズームをしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 그리세요; 두 손가락을 사용해 팬하고 확대하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez avec un doigt ; utilisez-en deux pour faire un panoramique et zoomer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie mit einem Finger; verwenden Sie zwei, um zu spanieren und zu zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con un dedo; usa dos para pasar y hacer zoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe com um dedo; use dois para panorâmicas e ampliações."
          }
        }
      }
    },
    "app.bilingual.6a274a19dc7e272d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Pencil 或鼠标绘画；手指移动画布，双指缩放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw with Pencil or a pointer; drag to pan and pinch to zoom."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Pencil 或滑鼠繪畫；手指移動畫布，雙指縮放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鉛筆またはポインタで描いてください；ドラッグするとパンし、ピンチでズームしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연필이나 포인터로 그리세요; 드래그하면 팬, 핀치하면 확대됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez avec un crayon ou un pointeur ; faites glisser pour faire glisser et pincez pour zoomer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie mit einem Bleistift oder einem Zeiger; ziehen Sie, um zu senken, und kneifen Sie, um zu zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja con lápiz o un puntero; arrastra para panorámica y pellizca para hacer zoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe com um lápis ou um ponteiro; arraste para pan e aperte para ampliar."
          }
        }
      }
    },
    "app.bilingual.a6d8ae0be295ad64": {
