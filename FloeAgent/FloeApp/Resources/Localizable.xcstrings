    "envdetail.delete_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks in this environment will be stopped, and its software and data will be deleted. A project with child conversations must be cleaned up first. If stopping fails, data is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将停止此环境的任务并删除其软件和数据。有子会话的项目须先清理子会话；停止失败时保留数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將停止此環境的任務並刪除其軟體和資料。有子會話的專案須先清理子會話；停止失敗時保留資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境のタスクは停止され、そのソフトウェアとデータは削除されます。 子どもの会話があるプロジェクトは、まず整理しなければなりません。 停止が失敗した場合、データは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경의 작업은 중단되며, 해당 소프트웨어와 데이터는 삭제됩니다. 어린이 대화가 포함된 프로젝트는 먼저 정리되어야 합니다. 정지에 실패하면 데이터가 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tâches dans cet environnement seront arrêtées et son logiciel et ses données seront supprimés. Un projet avec des conversations avec des enfants doit d'abord être nettoyé. Si l'arrêt échoue, les données sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben in dieser Umgebung werden gestoppt und die Software und Daten werden gelöscht. Ein Projekt mit Kindergesprächen muss zuerst aufgeräumt werden. Wenn das Stoppen fehlschlägt, werden die Daten gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas en este entorno se detendrán y su software y datos se eliminarán. Un proyecto con conversaciones con niños debe limpiarse primero. Si la parada falla, los datos se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As tarefas neste ambiente serão interrompidas e seu software e dados serão excluídos. Um projeto com conversas infantis deve ser limpo primeiro. Se a parada falhar, os dados são mantidos."
          }
        }
      }
    },
