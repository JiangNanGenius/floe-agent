    "settings.data_management_view.rebuildable_caches_and_temporary_files_left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuildable caches and temporary files left more than an hour ago will be deleted. User content is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除可重建缓存和一小时前遗留的临时文件。用户内容不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除可重建快取和一小時前遺留的臨時檔案。使用者內容不會被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間以上前に残されたリビルド可能なキャッシュおよび一時ファイルは削除されます。 ユーザーコンテンツは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 가능한 캐시와 1시간 이상 남아 있는 임시 파일은 삭제됩니다. 사용자 콘텐츠는 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caches reconstructibles et les fichiers temporaires laissés il y a plus d'une heure seront supprimés. Le contenu de l'utilisateur n'est pas supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederaufbaubare Caches und temporäre Dateien, die vor mehr als einer Stunde zurückgelassen wurden, werden gelöscht. Benutzerinhalte werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las cachés reconstruibles y los archivos temporales que quedan hace más de una hora se eliminarán. El contenido del usuario no se elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches reconstruíveis e arquivos temporários deixados há mais de uma hora serão excluídos. O conteúdo do usuário não é excluído."
          }
        }
      }
    },
