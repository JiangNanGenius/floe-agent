    "settings.data_management_view.cleanup_scratch_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only directories idle for over a day are eligible; live leases and recent files are always kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅删除闲置超过一天的目录；活跃租约与最近文件始终保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅刪除閒置超過一天的目錄；活躍租約與最近檔案始終保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日以上アイドル状態のディレクトリのみが対象となります；ライブリースと最近のファイルは常に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 이상 방치된 디렉터리만 이용 가능하며, 실시간 임대와 최신 파일은 항상 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les répertoires inactifs pendant plus d'une journée sont éligibles ; les baux en direct et les fichiers récents sont toujours conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Verzeichnisse, die seit mehr als einem Tag ungenutzt sind, sind förderfähig; Live-Leasing- und aktuelle Dateien werden immer aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los directorios inactivos durante más de un día son elegibles; los arrendamientos en vivo y los archivos recientes siempre se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente diretórios ociosos por mais de um dia são elegíveis; arrendamentos ativos e arquivos recentes são sempre mantidos."
          }
        }
      }
    },
