          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma dependência de conteúdo necessária não está disponível."
          }
        }
      }
    },
    "content.update.error.persistence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content update could not be saved; the previous version remains active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容更新保存失败；上一版本保持生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容更新儲存失敗；上一版本保持生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの更新を保存できませんでした。前のバージョンは有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 업데이트를 저장할 수 없습니다; 이전 버전은 여전히 활성 상태입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour du contenu n'a pas pu être enregistrée ; la version précédente reste active."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Inhaltsupdate konnte nicht gespeichert werden; die vorherige Version bleibt aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la actualización de contenido; la versión anterior permanece activa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização de conteúdo não pôde ser salva; a versão anterior permanece ativa."
          }
        }
      }
    },
    "content.update.error.signature": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
