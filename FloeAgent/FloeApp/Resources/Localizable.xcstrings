    "settings.permissions.gate.fail_closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection unavailable — all destructive commands blocked"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护不可用——所有破坏性命令均被阻止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保護不可用——所有破壞性命令均被阻止"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護が利用できません — すべての破壊的コマンドがブロックされています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보호 기능을 사용할 수 없습니다 — 모든 파괴적인 명령이 차단되었습니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protection indisponible - toutes les commandes destructrices bloquées"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schutz nicht verfügbar - alle zerstörerischen Befehle blockiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protección no disponible - todos los comandos destructivos bloqueados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteção indisponível — todos os comandos destrutivos bloqueados"
          }
        }
      }
    },
    "settings.permissions.gate.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This independent layer blocks high-confidence destructive commands before any approval policy runs. It cannot be disabled from settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一独立层在任何授权策略之前拦截高置信度的破坏性命令，无法在设置中关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一獨立層在任何授權策略之前攔截高置信度的破壞性命令，無法在設定中關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この独立した層は、承認ポリシーが実行される前に、高信頼度の破壊的コマンドをブロックします。 設定から無効にすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 독립 계층은 승인 정책이 실행되기 전에 고신뢰 파괴 명령을 차단합니다. 설정에서 비활성화할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette couche indépendante bloque les commandes destructrices de haute confiance avant l'exécution d'une stratégie d'approbation. Il ne peut pas être désactivé à partir des paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese unabhängige Ebene blockiert hochverlässige zerstörerische Befehle, bevor eine Genehmigungsrichtlinie ausgeführt wird. Es kann nicht in den Einstellungen deaktiviert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta capa independiente bloquea comandos destructivos de alta confianza antes de que se ejecute cualquier política de aprobación. No se puede desactivar desde la configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta camada independente bloqueia comandos destrutivos de alta confiança antes que qualquer política de aprovação seja executada. Não pode ser desativado nas configurações."
          }
        }
      }
    },
