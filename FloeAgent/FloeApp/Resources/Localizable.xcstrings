            "value": "其中 %@ 個正在執行，會先停止其自身工作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は稼働しています；彼ら自身の作業は先に停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그들 중 %@가 실행되고 있으며, 그들의 작업이 먼저 중단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ d'entre eux sont en cours d'exécution ; leur propre travail est arrêté en premier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ von ihnen laufen; ihre eigene Arbeit wird zuerst gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de ellos están funcionando; su propio trabajo se detiene primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deles estão em execução; seu próprio trabalho é interrompido primeiro."
          }
