    "cad.workbench.assembly.referenceCachedHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cached geometry, mates and BOM row are preserved. Check or update with the source document to recover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留缓存几何、配合和物料行；用源文档检查或更新即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留快取幾何、配合和物料行；用源文件檢查或更新即可恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュされたジオメトリ、メイト、およびBOM行は保持されます。 復元のために、ソース文書で確認または更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시된 기하학, 메이트 및 BOM 행이 보존됩니다. 복구를 위해 원본 문서를 확인하거나 업데이트하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie mise en cache, les compagnons et la ligne de nomenclature sont préservées. Vérifiez ou mettez à jour avec le document source pour récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zwischengespeicherte Geometrie, die Mates und die Stücklistenzeile bleiben erhalten. Überprüfen oder aktualisieren Sie mit dem Quelldokument, um es wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan la geometría en caché, los compañeros y la fila de la lista de materiales. Compruebe o actualice con el documento de origen para recuperarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometria armazenada em cache, os companheiros e a linha da lista de materiais são preservados. Verifique ou atualize com o documento de origem para recuperar."
          }
        }
      }
    },
