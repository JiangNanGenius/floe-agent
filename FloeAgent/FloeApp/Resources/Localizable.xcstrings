    "edit.conflict.notesCopyChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery copy has been edited again. Keep both versions and continue in that copy; the older reviewed changes were not applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复副本已有新的编辑。请保留两个版本，在副本中继续；本次没有将旧的审阅结果应用到原件。"
          }
        }
      }
    },
