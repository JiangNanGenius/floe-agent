    "workspace.workspace_canvas_view.is_the_last_canvas_continuing_deletes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” is the last canvas. Continuing deletes the entire canvas project, its linked canvas assistant conversations and unfinished media tasks. The linked workspace is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是最后一张画布。继续将删除整个画布项目、关联的画布助手会话和未完成媒体任务。绑定的工作区不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”是最後一張畫布。繼續將刪除整個畫布專案、關聯的畫布助手會話和未完成媒體任務。繫結的工作區不會被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は最後のキャンバスです。 続行すると、キャンバスプロジェクト全体、リンクされたキャンバスアシスタントの会話、および未完了のメディアタスクが削除されます。 リンクされたワークスペースは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 마지막 캔버스입니다. 계속 진행하면 전체 캔버스 프로젝트와 연결된 캔버스 어시스턴트 대화 및 미완료된 미디어 작업이 삭제됩니다. 연결된 작업 공간이 삭제되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » est la dernière toile. Continuer supprime l'ensemble du projet de toile, ses conversations d'assistant de toile liées et ses tâches multimédias inachevées. L'espace de travail lié n'est pas supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ist die letzte Leinwand. Fortfahren löscht das gesamte Canvas-Projekt, seine verknüpften Canvas-Assistenten-Konversationen und unvollendete Medienaufgaben. Der verknüpfte Arbeitsbereich wird nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" es el último lienzo. Continuar elimina todo el proyecto de lienzo, sus conversaciones de asistente de lienzo vinculados y tareas de medios sin terminar. El espacio de trabajo vinculado no se elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” é a última tela. Continuar exclui todo o projeto de tela, suas conversas de assistente de tela vinculadas e tarefas de mídia inacabadas. O espaço de trabalho vinculado não é excluído."
          }
        }
      }
    },
