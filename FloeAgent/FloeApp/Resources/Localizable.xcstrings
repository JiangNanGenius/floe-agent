    "settings.licenses.bundled.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every notice here is a file copied into this build. A file missing from the build is shown as unavailable instead of being hidden."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处每一条都是复制进本构建的文件；构建中缺失的文件会显示为不可用，而不是被隐藏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處每一條都是複製進本構建的檔案；構建中缺失的檔案會顯示為不可用，而不是被隱藏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにあるすべての通知は、このビルドにコピーされたファイルです。 ビルドから欠落しているファイルは、非表示になる代わりに「利用不可」と表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 있는 모든 공지는 이 빌드에 복사된 파일입니다. 빌드에 누락된 파일이 숨겨진 것이 아니라 사용 불가능한 것으로 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque avis ici est un fichier copié dans cette version. Un fichier manquant dans la construction est affiché comme indisponible au lieu d'être caché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Hinweis hier ist eine Datei, die in diesen Build kopiert wurde. Eine Datei, die im Build fehlt, wird als nicht verfügbar angezeigt, anstatt ausgeblendet zu sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aviso aquí es un archivo copiado en esta compilación. Un archivo que falta en la compilación se muestra como no disponible en lugar de estar oculto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
