      }
    },
    "settings.agent_permissions_view.this_setting_affects_only_tasks_created": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting affects only tasks created later. In-task tools run automatically; catastrophic commands are always blocked and package installation still requires source review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设置只影响以后新建的任务。任务内工具会自动执行；灾难性命令始终阻止，软件包安装仍需源码审查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該設定隻影響以後新建的任務。任務內工具會自動執行；災難性命令始終阻止，軟體包安裝仍需原始碼審查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は、後で作成されたタスクにのみ影響します。 インタスクツールは自動的に実行されます；カタストロフィックなコマンドは常にブロックされ、パッケージのインストールには依然としてソースの確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 나중에 생성된 작업에만 영향을 미칩니다. 작업 내 도구는 자동으로 실행되며, 치명적인 명령은 항상 차단되고 패키지 설치는 여전히 소스 검토가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce paramètre n'affecte que les tâches créées ultérieurement. Les outils in-task s'exécutent automatiquement ; les commandes catastrophiques sont toujours bloquées et l'installation du paquet nécessite toujours un examen de la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellung betrifft nur Aufgaben, die später erstellt wurden. In-Task-Tools werden automatisch ausgeführt; katastrophale Befehle werden immer blockiert und die Paketinstallation erfordert weiterhin eine Quellüberprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuración solo afecta a las tareas creadas más tarde. Las herramientas en la tarea se ejecutan automáticamente; los comandos catastróficos siempre están bloqueados y la instalación del paquete todavía requiere la revisión de la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa configuração afeta apenas as tarefas criadas posteriormente. As ferramentas na tarefa são executadas automaticamente; comandos catastróficos são sempre bloqueados e a instalação do pacote ainda requer revisão de origem."
          }
        }
      }
    },
