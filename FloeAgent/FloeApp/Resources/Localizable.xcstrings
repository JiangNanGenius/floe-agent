    "app.bilingual.8d46f1fbffb735b7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用各声部的音色，在当前播放头位置加入新音轨。"
