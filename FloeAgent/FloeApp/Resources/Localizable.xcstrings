    "app.bilingual.730754a152aaf1ca": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次连接仍在停止，请再次尝试取消。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous connection is still stopping. Try Cancel again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次連線仍在停止，請再次嘗試取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の接続はまだ停止しています。 もう一度キャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 연결이 아직 중단되고 있습니다. 다시 취소를 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion précédente s'arrête toujours. Essayez à nouveau d'annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Verbindung wird immer noch unterbrochen. Versuchen Sie erneut Abbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión anterior todavía se detiene. Intenta cancelar de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão anterior ainda está parando. Tente Cancelar novamente."
          }
        }
      }
    },
    "app.bilingual.24ce57b02013b44d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个账号正在连接，请先完成或取消。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another account is connecting. Finish or cancel it first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個賬號正在連線，請先完成或取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアカウントが接続されています。 先に完了するか、キャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 계정이 연결되고 있습니다. 먼저 완료하거나 취소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre compte se connecte. Terminez-le ou annulez-le d'abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Konto wird verbunden. Beenden oder stornieren Sie es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está conectando otra cuenta. Termina o cancélalo primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra conta está se conectando. Termine ou cancele primeiro."
          }
        }
      }
    },
    "app.bilingual.ee6237c7b5f0a8e6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务暂不可用，请检查所选环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection service is unavailable. Check the selected environment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線服務暫不可用，請檢查所選環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続サービスは利用できません。 選択した環境を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 서비스를 이용할 수 없습니다. 선택한 환경을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
