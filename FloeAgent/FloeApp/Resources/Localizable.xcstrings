    "app.bilingual.76851bfeea5fd450": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板添加为新片段，保留原有内容和当前轨音色，可在工作台撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patterns add a new clip, preserving existing content and the current track's preset. Undo is available in the workbench."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模板新增為新片段，保留原有內容和當前軌音色，可在工作臺撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パターンは新しいクリップを追加し、既存のコンテンツと現在のトラックのプリセットを保持します。 作業台で元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패턴은 기존 콘텐츠와 현재 트랙의 프리셋을 보존하면서 새로운 클립을 추가합니다. 작업대에서 실행 취소를 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les motifs ajoutent un nouveau clip, préservant le contenu existant et le préréglage de la piste actuelle. Annuler est disponible dans l'établi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Muster fügen einen neuen Clip hinzu, wobei der vorhandene Inhalt und die Voreinstellung des aktuellen Titels erhalten bleiben. Rückgängig ist in der Werkbank verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones añaden un nuevo clip, preservando el contenido existente y el preajuste de la pista actual. Deshacer está disponible en el banco de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões adicionam um novo clipe, preservando o conteúdo existente e a predefinição da faixa atual. Desfazer está disponível na bancada de trabalho."
          }
        }
      }
    },
