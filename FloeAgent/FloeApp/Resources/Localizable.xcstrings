    "settings.privacy.export.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The export contains counts and capability states only; secrets are redacted before writing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出内容仅含计数与能力状态；秘密信息在写入前已脱敏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出內容僅含計數與能力狀態；秘密資訊在寫入前已脫敏。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートにはカウントと機能状態のみが含まれており、シークレットは書き込み前に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기에는 카운트와 능력 상태만 포함되어 있으며, 비밀은 쓰기 전에 미리 지정됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exportation contient uniquement des comptes et des états de capacité ; les secrets sont expurgés avant l'écriture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Export enthält nur Zählungen und Fähigkeitszustände; Geheimnisse werden vor dem Schreiben redigiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación contiene solo recuentos y estados de capacidad; los secretos se redactan antes de escribirlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação contém apenas contagens e estados de capacidade; segredos são redigidos antes da escrita."
          }
        }
      }
    },
