    "canvas.scene_migration.conflict.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The embedded original no longer matches the saved conversion marker. The converted document stays authoritative; the legacy preview remains read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内嵌原始数据与已保存的转换标记不再一致。已转换的文档保持权威；旧版预览仍为只读。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內嵌原始資料與已儲存的轉換標記不再一致。已轉換的文件保持權威；舊版預覽仍為只讀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "埋め込まれたオリジナルは、保存された変換マーカーともう一致しません。 変換されたドキュメントは権威性を保ち、レガシープレビューは読み取り専用のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삽입된 원본이 저장된 변환 마커와 더 이상 일치하지 않습니다. 변환된 문서는 권한을 유지하고, 레거시 프리뷰는 읽기 전용으로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original intégré ne correspond plus au marqueur de conversion enregistré. Le document converti reste faisant autorité ; l'aperçu hérité reste en lecture seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eingebettete Original stimmt nicht mehr mit der gespeicherten Konvertierungsmarkierung überein. Das konvertierte Dokument bleibt maßgeblich; die Legacy-Vorschau bleibt schreibgeschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original incrustado ya no coincide con el marcador de conversión guardado. El documento convertido sigue siendo autorizado; la vista previa heredada sigue siendo de solo lectura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original incorporado não corresponde mais ao marcador de conversão salvo. O documento convertido permanece autorizado; a visualização legada permanece somente leitura."
          }
        }
      }
    },
