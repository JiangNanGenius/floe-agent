    "voice.settings.audition.sample": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi, it's good to see you. What would you like to talk about today?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，很高兴见到你。今天有什么想一起聊聊的？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你好，很高興見到你。今天有什麼想一起聊聊的？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こんにちは、お会いできてよかったです。 本日は何についてお話ししたいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안녕하세요, 만나서 반갑습니다. 오늘 어떤 이야기를 나누고 싶으신가요?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salut, c'est bon de te voir. De quoi aimeriez-vous parler aujourd'hui ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo, schön, dich zu sehen. Worüber möchten Sie heute sprechen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola, me alegro de verte. ¿De qué te gustaría hablar hoy?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oi, é bom te ver. Sobre o que você gostaria de falar hoje?"
          }
        }
      }
    },
