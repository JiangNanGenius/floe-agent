    "cad.nodes.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the graph connections, image references and values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查节点连接、图像引用和数值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查節點連線、影象引用和數值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフの接続、画像参照、値を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그래프 연결, 이미지 참조 및 값을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les connexions graphiques, les références d'image et les valeurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Graphenverbindungen, Bildreferenzen und Werte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe las conexiones de gráficos, las referencias de imágenes y los valores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique as conexões do gráfico, referências de imagem e valores."
          }
        }
      }
    },
    "cad.nodes.mapping": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose UVs or a projected mapping in the inspector. Unlinked outputs keep their baked textures."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在检查器中选择 UV 或投影映射。断开的输出会保留已烘焙的纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在檢查器中選擇 UV 或投影對映。斷開的輸出會保留已烘焙的紋理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスペクタでUVまたは投影マッピングを選択してください。 リンクされていない出力は、ベイクされたテクスチャを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인스펙터에서 UV 또는 프로젝트 매핑을 선택하십시오. 연결되지 않은 출력은 구워진 텍스처를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les UV ou une cartographie projetée dans l'inspecteur. Les sorties non liées conservent leurs textures cuites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie UVs oder eine projizierte Zuordnung im Informationsfenster. Unverknüpfte Ausgaben behalten ihre gebackenen Texturen bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija UV o un mapeo proyectado en el inspector. Las salidas no vinculadas mantienen sus texturas horneadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha UVs ou um mapeamento projetado no inspetor. As saídas não vinculadas mantêm suas texturas assadas."
          }
        }
      }
    },
