    "cad.workbench.mesh.downgradeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytic bodies will be refused unless “Allow destructive mesh edits” is on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非开启“允许破坏性网格编辑”，解析实体将被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非開啟“允許破壞性網格編輯”，解析實體將被拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「Allallow destructive mesh edits」がオンになっていない限り、分析体は拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 본문은 “Allow destructive mesh edits”가 켜져 있지 않은 경우 거부됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les organismes analytiques seront refusés à moins que \"Autoriser les modifications de maillage destructifs\" ne soit activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytische Körper werden abgelehnt, es sei denn, \"Zerstörerische Mesh-Bearbeitungen zulassen\" ist an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los organismos analíticos serán rechazados a menos que \"Permitir ediciones de malla destructivas\" esté encendido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os corpos analíticos serão recusados, a menos que \"Permitir edições de malha destrutiva\" esteja ativado."
          }
        }
      }
    },
    "cad.workbench.mesh.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
