    "providers.provider_editor_view.video_models_are_an_optional_enhancement": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video models are an optional enhancement in Creative mode; only an image generation model is required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频模型是创意模式的可选增强；创意模式只强制要求图片生成模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片模型是創意模式的可選增強；創意模式只強制要求圖片生成模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリエイティブモードにおけるビデオモデルはオプションの強化であり、画像生成モデルのみが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 모델은 크리에이티브 모드에서 선택적인 향상이며, 이미지 생성 모델만 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles vidéo sont une amélioration facultative en mode Créatif ; seul un modèle de génération d'images est requis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videomodelle sind eine optionale Erweiterung im Creative-Modus; nur ein Bildgenerierungsmodell ist erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de vídeo son una mejora opcional en el modo Creativo; solo se requiere un modelo de generación de imágenes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos de vídeo são um aprimoramento opcional no modo Criativo; apenas um modelo de geração de imagem é necessário."
          }
        }
      }
    },
