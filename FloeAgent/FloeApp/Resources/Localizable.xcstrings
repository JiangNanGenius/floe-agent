    "notes.notes_agent_tools.editing_an_office_field_requires_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing an Office field requires a non-empty fieldID and text (pass text=\"\" explicitly to clear a field); text must not exceed 65,536 bytes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 字段编辑需要非空 fieldID 和 text（清空字段请显式传 text=\"\"）；text 不超过 65536 字节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 欄位編輯需要非空 fieldID 和 text（清空欄位請顯式傳 text=\"\"）；text 不超過 65536 位元組。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Office フィールドを編集するには、空でない fieldID と text が必要です（フィールドをクリアするには text=\"\" を明示的に指定してください）；テキストは 65,536 バイトを超えてはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 필드를 편집하려면 비어 있지 않은 필드ID와 텍스트가 필요합니다(필드를 비워 두려면 text=\"\"를 명시적으로 입력해야 합니다); 텍스트는 65,536바이트를 초과할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification d'un champ Office nécessite un identifiant de champ non vide et du texte (passer text=\"\" explicitement pour effacer un champ) ; le texte ne doit pas dépasser 65 536 octets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bearbeiten eines Office-Feldes erfordert eine nicht leere Feld-ID und Text (pass text=\"\" explizit, um ein Feld zu löschen); Text darf 65.536 Bytes nicht überschreiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar un campo de Office requiere un ID de campo no vacío y texto (pase text=\"\" explícitamente para borrar un campo); el texto no debe superar los 65.536 bytes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Editar um campo do Office requer um ID de campo e texto não vazios (passar text=\"\" explicitamente para limpar um campo); o texto não deve exceder 65.536 bytes."
          }
        }
      }
    },
