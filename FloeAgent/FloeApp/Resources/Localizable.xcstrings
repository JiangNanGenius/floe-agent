    "app.bilingual.bb4854f7f65d0683": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览此页面及同目录资源。关闭窗口后服务继续运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview this page and its nearby files. The service keeps running when this window closes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽此頁面及同目錄資源。關閉視窗後服務繼續執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページとその近くのファイルをプレビューしてください。 このウィンドウが閉じたときも、サービスは実行され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지와 그 주변 파일을 미리 보기. 이 창이 닫히면 서비스가 계속 실행됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualisez cette page et ses fichiers à proximité. Le service continue de fonctionner lorsque cette fenêtre se ferme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen Sie sich diese Seite und die Dateien in der Nähe an. Der Dienst läuft weiter, wenn dieses Fenster geschlossen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenga una vista previa de esta página y sus archivos cercanos. El servicio sigue funcionando cuando se cierra esta ventana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualize esta página e seus arquivos próximos. O serviço continua em execução quando esta janela se fecha."
          }
        }
      }
    },
    "app.bilingual.a2aa890dc0e826c0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本应监听所选端口。关闭窗口后服务继续运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your script should listen on the selected port. The service keeps running when this window closes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令碼應監聽所選埠。關閉視窗後服務繼續執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのスクリプトは、選択されたポートでリスンするはずです。 このウィンドウが閉じたときも、サービスは実行され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트는 선택된 포트에서 수신해야 합니다. 이 창이 닫히면 서비스가 계속 실행됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre script doit écouter sur le port sélectionné. Le service continue de fonctionner lorsque cette fenêtre se ferme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Skript sollte auf dem ausgewählten Port abhören. Der Dienst läuft weiter, wenn dieses Fenster geschlossen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su guión debe escuchar en el puerto seleccionado. El servicio sigue funcionando cuando se cierra esta ventana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu script deve ouvir na porta selecionada. O serviço continua em execução quando esta janela se fecha."
          }
        }
      }
    },
