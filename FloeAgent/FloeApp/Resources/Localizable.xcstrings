    "remote.conversation_center.this_steer_has_already_started_sending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This steer has already started sending and cannot be withdrawn. Send a new correction message."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条引导已开始发送，无法撤回。请发送新的更正消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這條引導已開始傳送，無法撤回。請傳送新的更正訊息。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このステアはすでに送信が開始されており、撤回できません。 新しい修正メッセージを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스티어는 이미 전송을 시작했으며 인출할 수 없습니다. 새로운 정정 메시지를 보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bœuf a déjà commencé à envoyer et ne peut pas être retiré. Envoyez un nouveau message de correction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ochsen hat bereits mit dem Versand begonnen und kann nicht zurückgezogen werden. Senden Sie eine neue Korrekturnachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este buey ya ha comenzado a enviarse y no se puede retirar. Envía un nuevo mensaje de corrección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este boi já começou a ser enviado e não pode ser retirado. Envie uma nova mensagem de correção."
          }
        }
      }
    },
