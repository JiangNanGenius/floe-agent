    "storage.capacity.no_auto_delete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe does not automatically delete your chats, projects or skills. After freeing space, retry the operation that failed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 不会自动删除你的聊天、项目或技能。释放空间后，请重试刚才失败的操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 不會自動刪除你的聊天、專案或技能。釋放空間後，請重試剛才失敗的操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floeは、あなたのチャット、プロジェクト、スキルを自動的に削除しません。 空き領域を解放した後、失敗した操作を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe는 귀하의 채팅, 프로젝트 또는 스킬을 자동으로 삭제하지 않습니다. 공간을 확보한 후, 실패한 작업을 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe ne supprime pas automatiquement vos discussions, projets ou compétences. Après avoir libéré de l'espace, réessayez l'opération qui a échoué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe löscht Ihre Chats, Projekte oder Fähigkeiten nicht automatisch. Nachdem Sie Speicherplatz frei gemacht haben, versuchen Sie den Vorgang, der fehlgeschlagen ist, erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe no elimina automáticamente tus chats, proyectos o habilidades. Después de liberar espacio, vuelva a intentar la operación que falló."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe não exclui automaticamente seus bate-papos, projetos ou habilidades. Depois de liberar espaço, tente novamente a operação que falhou."
          }
        }
      }
    },
    "storage.capacity.startup_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device storage is full, so Floe cannot finish opening its local data. Free up space first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备存储空间已满，Floe 暂时无法完成本地数据的加载。请先释放空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置儲存空間已滿，Floe 暫時無法完成本地資料的載入。請先釋放空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのストレージが満杯であるため、Floe はローカルデータの開放を完了できません。 まずスペースを確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치 저장 용량이 가득 차서 Floe가 로컬 데이터를 완전히 열 수 없습니다. 먼저 공간을 확보하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage de l'appareil est plein, donc Floe ne peut pas finir d'ouvrir ses données locales. Libérez d'abord de l'espace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätespeicher ist voll, daher kann Floe das Öffnen seiner lokalen Daten nicht abschließen. Räumen Sie zuerst Platz frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento del dispositivo está lleno, por lo que Floe no puede terminar de abrir sus datos locales. Libera espacio primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento do dispositivo está cheio, então o Floe não pode terminar de abrir seus dados locais. Libere espaço primeiro."
          }
        }
      }
    },
    "storage.capacity.reopen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After freeing space, close and reopen Floe to load your saved data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放空间后，请关闭并重新打开 Floe，以加载已保存的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放空間後，請關閉並重新開啟 Floe，以載入已儲存的資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き領域を解放した後、Floe を閉じて再度開いて、保存したデータをロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 확보한 후, Floe를 닫았다가 다시 열어 저장된 데이터를 로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir libéré de l'espace, fermez et rouvrez Floe pour charger vos données enregistrées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Sie Speicherplatz frei haben, schließen und öffnen Sie Floe erneut, um Ihre gespeicherten Daten zu laden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de liberar espacio, cierre y vuelva a abrir Floe para cargar sus datos guardados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de liberar espaço, feche e reabra o Floe para carregar seus dados salvos."
          }
        }
      }
    },
    "storage.capacity.download_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough storage to prepare the environment. Required: %@; available: %@. Free up space and retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备运行环境所需空间不足：需要 %@，当前可用 %@。请释放空间后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備執行環境所需空間不足：需要 %@，當前可用 %@。請釋放空間後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境を準備するための十分なストレージがありません。 必要: %@; 利用可能: %@. 空き領域を確保し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경을 준비하기에 충분한 저장 공간이 없습니다. 필수: %@; 사용 가능: %@. 공간을 확보하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de stockage pour préparer l'environnement. Requis : %@ ; disponible : %@. Libérez de l'espace et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Stauraum, um die Umgebung vorzubereiten. Erforderlich: %@; verfügbar: %@. Platz frei machen und es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente almacenamiento para preparar el medio ambiente. Requerido: %@; disponible: %@. Libera espacio y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há armazenamento suficiente para preparar o ambiente. Necessário: %@; disponível: %@. Libere espaço e tente novamente."
          }
        }
      }
    },
