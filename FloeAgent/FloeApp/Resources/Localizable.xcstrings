    "chat.temporary.keep.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep as a saved chat: saves this conversation to history and continues without resending."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留为正式会话：将本次会话保存到历史记录并继续，无需重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留為正式會話：將本次會話儲存到歷史記錄並繼續，無需重新傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたチャットとして保持する：この会話を履歴に保存し、再送せずに続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 채팅으로 유지: 이 대화를 기록에 저장하고 다시 전송하지 않고 계속합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver comme chat enregistré : enregistre cette conversation dans l'historique et continue sans renvoyer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als gespeicherten Chat behalten: Speichert diese Unterhaltung im Verlauf und wird fortgesetzt, ohne sie erneut zu senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener como chat guardado: guarda esta conversación en el historial y continúa sin reenviar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter como um bate-papo salvo: salva esta conversa no histórico e continua sem reenviar."
          }
        }
      }
    },
    "chat.temporary.keepFailedRetry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save. Tap to retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できませんでした。 タップして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 수 없습니다. 다시 시도하려면 탭하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'économiser. Appuyez pour réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht speichern. Tippen Sie, um es erneut zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. Toque para volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Toque para tentar novamente."
          }
        }
      }
    },
    "chat.temporary.keepPartialRetry": {
