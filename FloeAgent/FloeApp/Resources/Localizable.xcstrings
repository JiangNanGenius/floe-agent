    "edit.conflict.previewLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview shortened. The complete content is retained in the combined result and recovery copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览已缩短；完整内容保留在合并结果及恢复副本中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽已縮短；完整內容保留在合併結果及恢復副本中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューが短縮されました。 完全なコンテンツは、結合された結果およびリカバリコピーに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기가 단축되었습니다. 전체 내용은 결합된 결과와 복구 복사본에 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu raccourci. Le contenu complet est conservé dans le résultat combiné et la copie de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau verkürzt. Der vollständige Inhalt wird in der kombinierten Ergebnis- und Wiederherstellungskopie beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa acortada. El contenido completo se conserva en el resultado combinado y la copia de recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualização abreviada. O conteúdo completo é mantido no resultado combinado e na cópia de recuperação."
          }
        }
      }
    },
    "edit.conflict.recovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A copy of your draft is saved in the workspace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的草稿副本已保存在工作区"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的草稿副本已儲存在工作區"
          }
