    "skills.hub.delta.reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This update needs additional access. Allow it to continue installing, or deny it to stop."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新需要新增访问权限。允许后继续安装，拒绝则停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此更新需要新增訪問許可權。允許後繼續安裝，拒絕則停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップデートには追加のアクセスが必要です。 インストールの継続を許可するか、停止させるか拒否してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업데이트는 추가 접근 권한이 필요합니다. 설치를 계속하도록 허용하거나, 중지를 거부하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mise à jour nécessite un accès supplémentaire. Autorisez-le à poursuivre l'installation ou refusez-le de s'arrêter."
          }
        },
