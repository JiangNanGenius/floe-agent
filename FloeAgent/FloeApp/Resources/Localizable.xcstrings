    "app.bilingual.6eb91a702508bb34": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 Linux 环境当前不可用于清理。请打开 设置 → 执行环境，检查或修复共享运行时后重试。没有重置磁盘。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shared Linux environment is not currently usable for cleanup. Open Settings > Execution Environments, check or repair the shared runtime, then retry. No disk was reset."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享 Linux 環境當前不可用於清理。請開啟 設定 → 執行環境，檢查或修復共享執行時後重試。沒有重置磁碟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された Linux 環境は現在、クリーンアップに使用できません。 設定 > 実行環境を開き、共有ランタイムを確認または修復してから、再試行してください。 ディスクがリセットされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 Linux 환경은 현재 정리에 사용할 수 없습니다. 설정 > 실행 환경을 열고, 공유 런타임을 확인하거나 복구한 후 다시 시도하십시오. 디스크가 재설정되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement partagé Linux n'est actuellement pas utilisable pour le nettoyage. Ouvrez Paramètres > Environnements d'exécution, vérifiez ou réparez l'exécution partagée, puis réessayez. Aucun disque n'a été réinitialisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gemeinsam genutzte Linux-Umgebung kann derzeit nicht für die Bereinigung verwendet werden. Öffnen Sie Einstellungen > Ausführungsumgebungen, überprüfen oder reparieren Sie die freigegebene Laufzeit, und versuchen Sie es erneut. Es wurde kein Datenträger zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno compartido Linux no se puede utilizar actualmente para la limpieza. Abra Configuración > Entornos de ejecución, compruebe o repare el tiempo de ejecución compartido y vuelva a intentarlo. No se restableció el disco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente compartilhado Linux não é atualmente utilizável para limpeza. Abra Configurações > Ambientes de Execução, verifique ou repare o tempo de execução compartilhado e tente novamente. Nenhum disco foi redefinido."
          }
        }
      }
    },
    "app.bilingual.ff5af1b88dfac88c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务已绑定到另一个运行环境；请创建一个新的清理任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This task is already bound to another environment; create a new cleanup task."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此任務已繫結到另一個執行環境；請建立一個新的清理任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクはすでに別の環境にバインドされています。新しいクリーンアップタスクを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 이미 다른 환경에 바인딩되어 있습니다; 새 정리 작업을 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche est déjà liée à un autre environnement ; créez une nouvelle tâche de nettoyage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe ist bereits an eine andere Umgebung gebunden. Erstellen Sie eine neue Bereinigungsaufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea ya está vinculada a otro entorno; cree una nueva tarea de limpieza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa já está vinculada a outro ambiente; crie uma nova tarefa de limpeza."
          }
        }
      }
    },
    "app.bilingual.b40c3b12163e76f8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置 Linux 清理服务尚未就绪，请稍后重试。"
