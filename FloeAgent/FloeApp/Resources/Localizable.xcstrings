    "cad.workbench.assembly.interference.toleranceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces within this distance count as touching. The volume threshold flags small overlaps without hiding them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "间距不超过此值时视为接触。体积阈值仅标记较小的干涉，不会隐藏结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "間距不超過此值時視為接觸。體積閾值僅標記較小的干涉，不會隱藏結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この距離内の表面は接触としてカウントされます。 ボリュームしきい値は、小さな重なりを非表示にせずにフラグ付けします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거리 내의 표면은 접촉으로 간주됩니다. 볼륨 임계값은 작은 겹침을 숨기지 않고 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les surfaces à cette distance comptent comme touchantes. Le seuil de volume signale les petits chevauchements sans les cacher."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberflächen innerhalb dieser Entfernung zählen als berührend. Der Lautstärkeschwellenwert markiert kleine Überschneidungen, ohne sie zu verbergen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las superficies dentro de esta distancia cuentan como táctiles. El umbral de volumen señala pequeñas superposiciones sin ocultarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Superfícies dentro dessa distância contam como toques. O limite de volume sinaliza pequenas sobreposições sem escondê-las."
          }
        }
      }
    },
