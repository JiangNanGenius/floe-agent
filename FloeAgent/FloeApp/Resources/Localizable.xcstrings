    "core.managed_python_package_spec_parser.supported_commands": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports pip install, uninstall, list, show, freeze, check and --version; native packages need compatible builds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 pip install、uninstall、list、show、freeze、check 与 --version；原生包需要兼容构建"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 pip install、uninstall、list、show、freeze、check 與 --version；原生包需要相容構建"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip のインストール、アンインストール、リスト、表示、フリーズ、チェック、--version をサポートしています。ネイティブパッケージは互換性のあるビルドが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip install, uninstall, list, show, freeze, check 및 --version을 지원합니다; 네이티브 패키지는 호환 가능한 빌드가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend en charge l'installation, la désinstallation, la liste, l'exposition, le gel, la vérification et la version - de pip ; les paquets natifs ont besoin de constructions compatibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterstützt pip install, deinstall, list, show, freeze, check und --version; native Pakete benötigen kompatible Builds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Admite pip install, desinstall, list, show, freeze, check y --version; los paquetes nativos necesitan compilaciones compatibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suporta pip install, desinstall, list, show, freeze, check e --version; pacotes nativos precisam de compilações compatíveis."
          }
        }
      }
    },
