    "notes.note_models.each_topic_keeps_at_most_32": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each topic keeps at most 32 attachments and identifiers cannot repeat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个主题最多保留 32 个附件，且标识不能重复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個主題最多保留 32 個附件，且標識不能重複。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各トピックは最大32個の添付ファイルを保持し、識別子は重複できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 주제는 최대 32개의 첨부 파일을 유지하며 식별자는 중복될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque sujet conserve au plus 32 pièces jointes et les identifiants ne peuvent pas être répétés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Thema hat höchstens 32 Anhänge und Kennungen können nicht wiederholt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tema mantiene un máximo de 32 archivos adjuntos y los identificadores no pueden repetirse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada tópico mantém no máximo 32 anexos e os identificadores não podem ser repetidos."
          }
        }
      }
    },
