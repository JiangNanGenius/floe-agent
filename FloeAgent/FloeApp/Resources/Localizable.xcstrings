    "cad.environment.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment changed. Reopen it before applying your changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境设置已更改，请重新打开后再修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境設定已更改，請重新開啟後再修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境が変わりました。 変更を適用する前に、再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경이 변했습니다. 변경 사항을 적용하기 전에 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement a changé. Rouvrez-le avant d'appliquer vos modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung hat sich verändert. Öffnen Sie es erneut, bevor Sie Ihre Änderungen anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno cambió. Vuelva a abrirlo antes de aplicar sus cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente mudou. Reabra-o antes de aplicar suas alterações."
          }
        }
      }
    },
    "cad.sketch.curve.cusp": {
      "localizations": {
