    "cad.feature.axisNotInPlane": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That axis does not lie in the sketch plane, so it cannot drive this revolve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该轴不在草图平面内，无法驱动此旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該軸不在草圖平面內，無法驅動此旋轉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その軸はスケッチ平面に位置していないため、この回転を駆動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 축은 스케치 평면에 있지 않으므로 이 회전을 구동할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet axe ne se trouve pas dans le plan d'esquisse, il ne peut donc pas conduire ce tour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Achse liegt nicht in der Skizzenebene, so dass sie diese Drehung nicht antreiben kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese eje no se encuentra en el plano del boceto, por lo que no puede conducir esta rotación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse eixo não está no plano do esboço, então não pode conduzir este giro."
          }
        }
      }
    },
    "cad.feature.axisUnresolved": {
