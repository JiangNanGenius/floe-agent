    "app.bilingual.7d03e6381c8d89bc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级 Linux 环境？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade Linux environment?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級 Linux 環境？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境をアップグレードしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경을 업그레이드하시겠습니까?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à niveau l'environnement Linux ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade der Linux-Umgebung?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Actualizar el entorno Linux?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
