    "template.intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Official software templates include preinstalled software. Files are verified on download; a new environment pins to the version shown, while existing environments stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "官方软件模板包含预装软件。下载时会校验文件，新环境固定使用所示版本；已有环境保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "官方軟體模板包含預裝軟體。下載時會校驗檔案，新環境固定使用所示版本；已有環境保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公式ソフトウェアテンプレートには、事前にインストールされたソフトウェアが含まれています。 ファイルはダウンロード時に検証され、新しい環境が表示されたバージョンに固定され、既存の環境は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식 소프트웨어 템플릿에는 사전 설치된 소프트웨어가 포함됩니다. 파일은 다운로드 시 검증됩니다; 새로운 환경이 표시된 버전에 고정되며, 기존 환경은 그대로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles logiciels officiels comprennent des logiciels préinstallés. Les fichiers sont vérifiés lors du téléchargement ; un nouvel environnement est épinglé à la version affichée, tandis que les environnements existants restent inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offizielle Softwarevorlagen enthalten vorinstallierte Software. Dateien werden beim Herunterladen verifiziert; eine neue Umgebung pinnt an die angezeigte Version, während bestehende Umgebungen unverändert bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas de software oficiales incluyen software preinstalado. Los archivos se verifican en la descarga; un nuevo entorno se fija a la versión que se muestra, mientras que los entornos existentes permanecen sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de software oficiais incluem software pré-instalado. Os arquivos são verificados no download; um novo ambiente fixa na versão mostrada, enquanto os ambientes existentes permanecem inalterados."
          }
        }
      }
    },
