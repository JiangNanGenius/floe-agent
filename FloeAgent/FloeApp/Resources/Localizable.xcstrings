    "settings.questions.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For small decisions with a displayed default. Important decisions still wait for your answer. Changes apply to new questions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于已显示默认值的小决定。重大决定仍等待你的回答。修改仅影响新问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於已顯示預設值的小決定。重大決定仍等待你的回答。修改僅影響新問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトが表示された小さな決定の場合。 重要な決定はまだあなたの答えを待っています。 変更は新しい質問に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 기본값이 있는 작은 결정에 대해. 중요한 결정은 아직 귀하의 답변을 기다리고 있습니다. 변경 사항은 새로운 질문에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les petites décisions avec un défaut affiché. Les décisions importantes attendent toujours votre réponse. Les changements s'appliquent aux nouvelles questions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für kleine Entscheidungen mit einem angezeigten Standard. Wichtige Entscheidungen warten immer noch auf Ihre Antwort. Änderungen gelten für neue Fragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pequeñas decisiones con un valor predeterminado mostrado. Las decisiones importantes aún esperan su respuesta. Los cambios se aplican a las nuevas preguntas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para pequenas decisões com um padrão exibido. Decisões importantes ainda aguardam sua resposta. As alterações se aplicam a novas perguntas."
          }
        }
      }
    },
