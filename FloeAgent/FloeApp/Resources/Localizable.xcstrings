    "notes.notes_agent_tools.reading_and_writing_office_body_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reading and writing Office body text supports only .docx, .xlsx and .pptx files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 正文读写仅支持 .docx、.xlsx 和 .pptx 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 正文讀寫僅支援 .docx、.xlsx 和 .pptx 檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Office の本文テキストの読み書きは、.docx、.xlsx、.pptx ファイルのみをサポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 본문 텍스트를 읽고 쓰는 기능은 .docx, .xlsx 및 .pptx 파일만 지원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture et l'écriture du corps du texte Office ne prennent en charge que les fichiers .docx, .xlsx et .pptx."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lesen und Schreiben von Office-Text unterstützt nur .docx-, .xlsx- und .pptx-Dateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer y escribir el texto del cuerpo de Office solo admite archivos .docx, .xlsx y .pptx."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A leitura e gravação do corpo do Office suporta apenas arquivos .docx, .xlsx e .pptx."
          }
        }
      }
    },
    "notes.notes_agent_tools.reading_pages_text_or_topics_requires": {
