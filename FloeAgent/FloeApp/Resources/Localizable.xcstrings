    "cad.workbench.script.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write ShapeScript above and Preview it — applying creates a body bound to its source so later manual edits are detected, never overwritten silently."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方编写 ShapeScript 并预览——应用会创建与源码绑定的实体，之后的手工修改会被检测，绝不会被静默覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方編寫 ShapeScript 並預覽——應用會建立與原始碼繫結的實體，之後的手工修改會被檢測，絕不會被靜默覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上にShapeScriptを書き、プレビューしてください — 適用すると、ソースにバインドされたボディが作成され、後で手動編集が検出され、黙って上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위에 ShapeScript를 작성하고 미리 보기하십시오 — 적용하면 원본에 바인딩된 본문이 생성되어 이후 수동 편집이 감지되고, 조용히 덮어쓰기되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez ShapeScript ci-dessus et prévisualisez-le - l'application crée un corps lié à sa source afin que les modifications manuelles ultérieures soient détectées, jamais écrasées silencieusement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreiben Sie ShapeScript oben und sehen Sie es in der Vorschau an - die Anwendung erstellt einen an die Quelle gebundenen Körper, so dass spätere manuelle Bearbeitungen erkannt werden, die niemals stillschweigend überschrieben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escriba ShapeScript arriba y previsualícelo: la aplicación crea un cuerpo vinculado a su fuente para que se detecten ediciones manuales posteriores, nunca sobrescritas silenciosamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva ShapeScript acima e visualize-o — a aplicação cria um corpo vinculado à sua fonte para que edições manuais posteriores sejam detectadas, nunca substituídas silenciosamente."
          }
        }
      }
    },
