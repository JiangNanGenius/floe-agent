    "setup.features.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with one conversation model. The remaining capabilities are optional and can be enabled later in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先配置一个对话模型即可开始；其余能力均为可选项，可稍后在设置中逐步启用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先配置一個對話模型即可開始；其餘能力均為可選項，可稍後在設定中逐步啟用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは1つの会話モデルから始めてください。 残りの機能は任意で、設定で後で有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 대화 모델부터 시작하십시오. 남은 기능은 선택 사항이며, 나중에 설정에서 활성화할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec un modèle de conversation. Les fonctionnalités restantes sont facultatives et peuvent être activées plus tard dans les paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnen Sie mit einem Gesprächsmodell. Die verbleibenden Funktionen sind optional und können später in den Einstellungen aktiviert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un modelo de conversación. Las capacidades restantes son opcionales y se pueden habilitar más tarde en Configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um modelo de conversa. Os recursos restantes são opcionais e podem ser ativados posteriormente em Configurações."
          }
        }
      }
    },
    "setup.features.local_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefer offline use? Skip the setup guide, then download a model in Settings > Local Models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "希望离线使用？可跳过设置向导，再到“设置 > 本地模型”下载模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "希望離線使用？可跳過設定嚮導，再到“設定 > 本地模型”下載模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインでの使用をご希望ですか？ セットアップガイドをスキップし、設定 > ローカルモデルでモデルをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 사용을 선호하십니까? 설정 가이드를 건너뛰고, 설정 > 로컬 모델에서 모델을 다운로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférez-vous l'utilisation hors ligne ? Ignorez le guide de configuration, puis téléchargez un modèle dans Réglages > Modèles locaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevorzugen Sie die Offline-Nuttung? Überspringen Sie die Einrichtungsanleitung und laden Sie ein Modell in \"Einstellungen\" > \"Lokale Modelle\" herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Prefieres el uso sin conexión? Omita la guía de configuración y, a continuación, descargue un modelo en Ajustes > Modelos locales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere o uso offline? Pule o guia de configuração e baixe um modelo em Configurações > Modelos Locais."
          }
        }
      }
    },
    "setup.features.models.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud models provide full capability. Downloaded local models provide an offline fallback and load only when needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云模型提供完整能力；下载的本地模型可作为离线补充，并仅在需要时加载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲模型提供完整能力；下載的本地模型可作為離線補充，並僅在需要時載入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドモデルは完全な機能を提供します。 ダウンロードしたローカルモデルは、オフラインのフォールバックを提供し、必要な場合にのみロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 모델은 전체 기능을 제공합니다. 다운로드된 로컬 모델은 오프라인 폴백을 제공하며 필요할 때만 로드됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles cloud offrent une capacité complète. Les modèles locaux téléchargés fournissent un repli hors ligne et ne se chargent qu'en cas de besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Modelle bieten volle Kapazität. Heruntergeladene lokale Modelle bieten einen Offline-Fallback und laden nur bei Bedarf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos en la nube proporcionan capacidad total. Los modelos locales descargados proporcionan un respaldo fuera de línea y se cargan solo cuando es necesario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de nuvem fornecem capacidade total. Os modelos locais baixados fornecem um fallback offline e carregam apenas quando necessário."
          }
        }
      }
    },
    "setup.features.models.title": {
      "extractionState": "manual",
      "localizations": {
