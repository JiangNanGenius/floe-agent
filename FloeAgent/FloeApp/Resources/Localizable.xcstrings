    "cad.render.error.pixels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window could not render the requested image size. Try a smaller size."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前窗口无法渲染此尺寸，请选择较小的图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前視窗無法渲染此尺寸，請選擇較小的圖片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウィンドウは要求された画像サイズをレンダリングできませんでした。 小さいサイズをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 창은 요청한 이미지 크기를 렌더링할 수 없습니다. 더 작은 사이즈를 시도해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre n'a pas pu rendre la taille d'image demandée. Essayez une taille plus petite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Fenster konnte die angeforderte Bildgröße nicht rendern. Versuchen Sie es mit einer kleineren Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana no pudo renderizar el tamaño de imagen solicitado. Prueba una talla más pequeña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela não pôde renderizar o tamanho da imagem solicitado. Experimente um tamanho menor."
          }
        }
      }
    },
