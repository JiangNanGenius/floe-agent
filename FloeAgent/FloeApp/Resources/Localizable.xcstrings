    "settings.data_management_view.shared_allocation_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counts shared runtime-image blocks in full, so this is an upper estimate; iOS Storage may show a different number, and it is not an exact amount that can be freed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将共享的运行时镜像块全额计入，因此这是上限估算；iOS“储存空间”可能显示不同数值，且这并非可精确释放的容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將共享的執行時映象塊全額計入，因此這是上限估算；iOS“儲存空間”可能顯示不同數值，且這並非可精確釋放的容量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたランタイムイメージブロックを全てカウントするため、これは上位の推定値です；iOS Storage は異なる数値を表示する可能性があり、解放できる正確な量ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 런타임 이미지 블록을 전부 계산하므로 이는 상위 추정치이며, iOS 스토리지는 다른 수치를 표시할 수 있고, 이는 확보할 수 있는 정확한 양이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compte les blocs d'images d'exécution partagés dans leur intégralité, il s'agit donc d'une estimation supérieure ; iOS Storage peut afficher un nombre différent, et ce n'est pas un montant exact qui peut être libéré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zählt gemeinsame Laufzeit-Image-Blöcke vollständig, daher ist dies eine höhere Schätzung; iOS Storage kann eine andere Anzahl anzeigen, und es ist keine genaue Menge, die freigegeben werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta los bloques de imágenes de tiempo de ejecución compartidos en su totalidad, por lo que esta es una estimación superior; iOS Storage puede mostrar un número diferente, y no es una cantidad exacta que se pueda liberar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta blocos de imagem de tempo de execução compartilhados na íntegra, então esta é uma estimativa superior; iOS Storage pode mostrar um número diferente, e não é uma quantidade exata que pode ser liberada."
          }
        }
      }
    },
