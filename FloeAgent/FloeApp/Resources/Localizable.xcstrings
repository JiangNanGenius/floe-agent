          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La toile a été mise à jour par une autre action ; le dernier contenu a été rechargé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leinwand wurde durch eine andere Aktion aktualisiert; der neueste Inhalt wurde neu geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lienzo fue actualizado por otra acción; el contenido más reciente fue recargado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela foi atualizada por outra ação; o conteúdo mais recente foi recarregado."
          }
        }
      }
    },
    "workspace.workspace_canvas_view.the_cloud_deletion_was_confirmed_this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud deletion was confirmed. This device will not re-upload the old canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端删除已经确认。当前设备不会重新上传这份旧画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端刪除已經確認。當前裝置不會重新上傳這份舊畫布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドの削除が確認されました。 このデバイスは古いキャンバスを再アップロードしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 삭제가 확인되었습니다. 이 장치는 기존 캔버스를 다시 업로드하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression du cloud a été confirmée. Cet appareil ne téléchargera pas à nouveau l'ancienne toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Löschung der Cloud wurde bestätigt. Dieses Gerät lädt die alte Leinwand nicht erneut hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se confirmó la eliminación de la nube. Este dispositivo no volverá a subir el lienzo antiguo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão da nuvem foi confirmada. Este dispositivo não carregará novamente a tela antiga."
          }
        }
      }
    },
