    "app.floe_agent_app.is_running_on_this_device_local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is running on this device. Local models and the Linux environment cannot run at the same time: continuing stops these environments first (disk and data are preserved), or cancel this local model request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机正在运行 %@。本地模型与 Linux 环境不能同时运行：继续将先停止这些环境（磁盘与数据会保留），或取消本次本地模型请求。"
          }
        }
      }
    },
    "app.floe_agent_app.linux_environments": {
      "extractionState": "manual",
