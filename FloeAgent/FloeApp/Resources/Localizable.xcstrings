    "app.bilingual.60cd5d9163b50d4a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一轮仍在等待后台工作，完成后可继续目标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another round is awaiting background work. Resume the Goal after it finishes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一輪仍在等待後臺工作，完成後可繼續目標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のラウンドがバックグラウンド作業を待っています。 目標が完了した後に再開してください。"
