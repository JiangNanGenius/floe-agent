    "storage.capacity.low_bytes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %@ is available. Free up space to keep saving and downloading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前可用 %@。请释放一些空间，以免影响保存和下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前可用 %@。請釋放一些空間，以免影響儲存和下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のみが利用可能です。 保存とダウンロードを続けるために、空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@만 이용 가능합니다. 저장 및 다운로드를 지속할 수 있도록 공간을 확보하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul %@ est disponible. Libérez de l'espace pour continuer à enregistrer et à télécharger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur %@ ist verfügbar. Platz freimachen, um weiter zu speichern und herunterzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ está disponible. Libera espacio para seguir guardando y descargando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %@ está disponível. Libere espaço para continuar salvando e baixando."
          }
        }
      }
    },
    "storage.capacity.write_failed_bytes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation ran out of storage. Currently available: %@. Free up space, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚才的操作因存储空间不足而失败。当前可用 %@，释放空间后可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剛才的操作因儲存空間不足而失敗。當前可用 %@，釋放空間後可重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オペレーションのストレージが尽きました。 現在利用可能: %@. スペースを確保し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 저장소를 초과했습니다. 현재 이용 가능: %@. 공간을 확보한 뒤 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération a manqué de stockage. Actuellement disponible : %@. Libérez de l'espace, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Betrieb lief aus dem Speicher. Derzeit verfügbar: %@. Platz frei machen, dann versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una operación se quedó sin almacenamiento. Actualmente disponible: %@. Libera espacio, luego vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação ficou sem armazenamento. Atualmente disponível: %@. Libere espaço e tente novamente."
          }
        }
      }
    },
    "storage.capacity.write_failed": {
