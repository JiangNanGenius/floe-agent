    "cad.building.error.placeEachDoorOrWindowInsideA": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place each door or window inside a wall on the same floor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将门窗放在同一楼层的墙体范围内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將門窗放在同一樓層的牆體範圍內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ドアまたは窓は、同じフロアの壁内に配置してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 문이나 창문을 같은 층에 있는 벽 안에 배치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez chaque porte ou fenêtre à l'intérieur d'un mur au même étage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platzieren Sie jede Tür oder jedes Fenster innerhalb einer Wand auf der gleichen Etage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque cada puerta o ventana dentro de una pared en el mismo piso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque cada porta ou janela dentro de uma parede no mesmo andar."
          }
        }
      }
    },
    "cad.building.error.onlyDoorsAndWindowsMayReferenceA": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only doors and windows may reference a wall opening."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有门窗可以关联墙体开洞。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有門窗可以關聯牆體開洞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドアと窓のみが壁の開口部を参照できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문과 창문만이 벽 개구부를 참조할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les portes et les fenêtres peuvent faire référence à une ouverture murale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Türen und Fenster dürfen auf eine Wandöffnung verweisen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las puertas y ventanas pueden hacer referencia a una abertura de pared."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente portas e janelas podem fazer referência a uma abertura de parede."
          }
        }
      }
