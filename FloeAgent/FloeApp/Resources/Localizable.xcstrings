    "cad.workbench.drawing.bomEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No BOM items. Refresh from a live assembly to derive names and quantities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无 BOM 条目。从当前装配刷新以生成名称和数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無 BOM 條目。從當前裝配重新整理以生成名稱和數量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BOM項目はありません。 ライブアセンブリからリフレッシュして、名前と数量を導き出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BOM 항목이 없습니다. 실시간 어셈블리에서 새로 고침하여 이름과 수량을 도출하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'articles BOM. Actualiser à partir d'un assemblage en direct pour dériver des noms et des quantités."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Stücklisten. Aktualisieren Sie aus einer Live-Assembly, um Namen und Mengen abzuleiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay artículos de la lista de materiales. Actualizar desde un ensamblaje en vivo para derivar nombres y cantidades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum item de BOM. Atualize de uma montagem ao vivo para derivar nomes e quantidades."
          }
        }
      }
    },
    "cad.workbench.drawing.bomItems": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BOM items available; the balloon links to the matching item."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 个 BOM 条目；气泡会链接到对应条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 個 BOM 條目；氣泡會連結到對應條目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BOM アイテムが利用可能です；バルーンは対応するアイテムにリンクしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ BOM 아이템이 사용 가능하며, 풍선이 일치하는 아이템에 연결됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Articles de nomenclature %@ disponibles ; le ballon renvoie à l'article correspondant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Stücklisten sind verfügbar; der Ballon verlinkt auf den passenden Gegenstand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Artículos de la lista de materiales %@ disponibles; el globo se vincula al elemento correspondiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens de BOM %@ disponíveis; o balão está vinculado ao item correspondente."
          }
        }
      }
    },
