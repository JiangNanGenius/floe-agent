    "settings.licenses.note.guest_image": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux guest is a separately distributed downloadable image built from Debian 13 riscv64 packages plus a pinned kernel, bbl and static glibc. Its source and license texts are recorded in the pinned image manifest; they are not linked into the app binary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 客体是从 Debian 13 riscv64 软件包加固定内核、bbl 与静态 glibc 构建、单独分发的可下载镜像，其源码与许可文本记录在固定的镜像清单中，不链接进 App 二进制。"
          }
        }
      }
    },
    "settings.licenses.note.libgit2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 is licensed under GPL-2.0 with a linking exception that explicitly permits linking it into this application. The complete GPL-2.0 text ships in this app as Licenses/libgit2-COPYING.txt, and libgit2's source is the pinned repository in the component list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "libgit2 采用 GPL-2.0 并附带链接例外，明确允许将其链接进本应用。完整的 GPL-2.0 文本随本应用打包为 Licenses/libgit2-COPYING.txt，libgit2 源码为构件清单中的固定仓库。"
          }
        }
      }
    },
    "settings.licenses.note.mlx_vendor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "mlx-swift-lm is vendored at ThirdParty/MLXSwiftLM from upstream commit d5d8b290e601ac1bf11f24635f8f811a83b98bf8 with a minimal Floe prefill-stability patch; the complete MIT text ships in the app as Licenses/MLXSwiftLM-LICENSE.txt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "mlx-swift-lm 内置固定于 ThirdParty/MLXSwiftLM，来源为上游提交 d5d8b290e601ac1bf11f24635f8f811a83b98bf8，并附带最小的 Floe 预填充稳定性补丁；完整 MIT 文本随 App 以 Licenses/MLXSwiftLM-LICENSE.txt 提供。"
          }
        }
      }
    },
    "settings.licenses.note.occt": {
