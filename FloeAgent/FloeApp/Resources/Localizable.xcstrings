    "settings.agent_permissions_view.follow_app_default_explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This task follows the live app-wide default approval mode. Choose a specific mode to override it for this task only, or switch back anytime."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本任务跟随应用实时的默认审批模式。选择特定模式可仅覆盖本任务，也可随时切换回跟随默认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本任務跟隨應用實時的預設審批模式。選擇特定模式可僅覆蓋本任務，也可隨時切換回跟隨預設。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクは、ライブアプリ全体のデフォルト承認モードに従います。 このタスクに限り、特定のモードを選択して上書きするか、いつでも元に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 실시간 앱 전체 기본 승인 모드를 따릅니다. 특정 모드를 선택하여 이 작업에만 적용하거나 언제든지 되돌리세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette tâche suit le mode d'approbation par défaut à l'échelle de l'application en direct. Choisissez un mode spécifique pour le remplacer uniquement pour cette tâche, ou revenez en arrière à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufgabe folgt dem App-weiten Standardgenehmigungsmodus. Wählen Sie einen bestimmten Modus, um ihn nur für diese Aufgabe zu überschreiben, oder wechseln Sie jederzeit zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarea sigue el modo de aprobación predeterminado de toda la aplicación en vivo. Elija un modo específico para anularlo solo para esta tarea, o cambie de nuevo en cualquier momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tarefa segue o modo de aprovação padrão em todo o aplicativo ao vivo. Escolha um modo específico para substituí-lo apenas para esta tarefa ou volte a qualquer momento."
          }
        }
      }
    },
