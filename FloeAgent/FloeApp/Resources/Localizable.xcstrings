    "app.bilingual.6a7e4e53350e8cb0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动四个控制点变形，或拖动中心移动。预览后应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the four handles to reshape, or drag the center to move. Then apply the preview."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動四個控制點變形，或拖動中心移動。預覽後應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つのハンドルをドラッグして形状を調整するか、中心をドラッグして移動してください。 それからプレビューを適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네 개의 핸들을 드래그하여 형태를 조정하거나, 중앙을 드래그하여 이동하십시오. 그럼 미리보기를 적용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les quatre poignées pour les remodeler, ou faites glisser le centre pour les déplacer. Ensuite, appliquez l'aperçu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die vier Griffe, um sie neu zu formen, oder ziehen Sie die Mitte, um sich zu bewegen. Wenden Sie dann die Vorschau an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre las cuatro asas para remodelar, o arrastre el centro para moverse. A continuación, aplique la vista previa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as quatro alças para remodelar ou arraste o centro para mover. Em seguida, aplique a visualização."
          }
        }
      }
    },
