    "app.bilingual.20c816ab94cc957d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置字体供所有工作区使用，随 App 更新，不能删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included fonts are available in every workspace and updated with the App. They cannot be deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建字型供所有工作區使用，隨 App 更新，不能刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "含まれるフォントはすべてのワークスペースで利用可能で、アプリにより更新されます。 それらは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 글꼴은 모든 작업 공간에서 사용할 수 있으며 앱에 따라 업데이트됩니다. 삭제할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices incluses sont disponibles dans chaque espace de travail et mises à jour avec l'application. Ils ne peuvent pas être supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthaltene Schriftarten sind in jedem Arbeitsbereich verfügbar und mit der App aktualisiert. Sie können nicht gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes incluidas están disponibles en cada espacio de trabajo y se actualizan con la aplicación. No se pueden eliminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes incluídas estão disponíveis em todos os espaços de trabalho e atualizadas com o aplicativo. Eles não podem ser excluídos."
          }
        }
      }
    },
