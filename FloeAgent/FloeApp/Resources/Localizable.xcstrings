    "content.update.error.missing_dependency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A required content dependency is not available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少所需的内容依赖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少所需的內容依賴。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
