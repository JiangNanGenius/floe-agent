    "chat.conversation_list_view.all_tasks_in_the_archive_and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All tasks in the archive and their private data will be permanently deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档区内的所有任务及其私有数据将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔區內的所有任務及其私有資料將被永久刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ内のすべてのタスクとそれらのプライベートデータは永久に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아카이브에 있는 모든 작업과 해당 개인 데이터는 영구적으로 삭제됩니다."
          }
        },
        "fr": {
          "stringUnit": {
