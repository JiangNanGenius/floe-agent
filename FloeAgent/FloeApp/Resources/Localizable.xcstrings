    "remote.conversation_center.run_output_cleanup_failed_partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld task was deleted, but its run outputs could not be removed. Floe will retry automatically; if this keeps appearing, the storage may need attention."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 %lld 个任务，但其运行输出未能移除。Floe 会自动重试；如果此提示反复出现，可能需要检查存储空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除 %lld 個任務，但其執行輸出未能移除。Floe 會自動重試；如果此提示反覆出現，可能需要檢查儲存空間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld タスクは削除されましたが、その実行出力は削除できませんでした。 Floe は自動的に再試行されます。この状態が続く場合、ストレージの対応が必要になる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 작업이 삭제되었지만, 해당 실행 출력은 제거할 수 없었습니다. Floe는 자동으로 재시도합니다; 이 메시지가 계속 표시되면 스토리지에 주의가 필요할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche %lld a été supprimée, mais ses sorties d'exécution n'ont pas pu être supprimées. Floe réessayera automatiquement ; si cela continue d'apparaître, le stockage peut nécessiter une attention particulière."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe %lld wurde gelöscht, aber ihre Ausführungen konnten nicht entfernt werden. Floe versucht es automatisch erneut; wenn dies weiterhin angezeigt wird, muss der Speicher möglicherweise beachtet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea %lld se eliminó, pero no se pudieron eliminar sus salidas de ejecución. Floe lo intentará de nuevo automáticamente; si esto sigue apareciendo, el almacenamiento puede necesitar atención."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa %lld foi excluída, mas suas saídas de execução não puderam ser removidas. Floe tentará novamente automaticamente; se isso continuar aparecendo, o armazenamento pode precisar de atenção."
          }
        }
      }
    },
