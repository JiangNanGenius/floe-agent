    "cad.material.target.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a body or a face in the viewport, then open Material again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在视口中选择实体或面，然后重新打开材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在視口中選擇實體或面，然後重新開啟材質。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューポートで体または顔を選択し、再度マテリアルを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰포트에서 몸이나 얼굴을 선택한 다음, Material을 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
