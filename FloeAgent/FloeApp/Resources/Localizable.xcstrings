          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace la configuration et le résultat actuels non enregistrés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ersetzt das aktuelle nicht gespeicherte Setup und Ergebnis."
          }
