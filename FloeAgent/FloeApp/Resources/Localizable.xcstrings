    "localmodels.apple_foundation_model_runtime.the_current_system_supports_apple_intelligence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current system supports Apple Intelligence text chat only; upgrade the system to handle images directly"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前系统仅支持 Apple Intelligence 文字对话；升级系统后才能直接处理图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前系統僅支援 Apple Intelligence 文字對話；升級系統後才能直接處理圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のシステムはApple Intelligenceテキストチャットのみをサポートしています。システムをアップグレードして画像を直接処理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시스템은 Apple Intelligence 텍스트 채팅만 지원합니다; 이미지를 직접 처리하도록 시스템을 업그레이드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système actuel prend uniquement en charge le chat textuel Apple Intelligence ; mettez à niveau le système pour gérer directement les images"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle System unterstützt nur Apple Intelligence-Text-Chat; aktualisieren Sie das System, um Bilder direkt zu verarbeiten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema actual solo admite chat de texto Apple Intelligence; actualice el sistema para manejar imágenes directamente"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema atual suporta apenas bate-papo de texto Apple Intelligence; atualize o sistema para lidar com imagens diretamente"
          }
        }
      }
    },
