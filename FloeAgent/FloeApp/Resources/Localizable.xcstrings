    "app.bilingual.78cd3fc0d3c4380e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标将停止后续自动推进，本轮仍会继续。对话、文件和已有结果会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Goal will stop advancing to future rounds. This round continues. Your conversation, files and results will be kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標將停止後續自動推進，本輪仍會繼續。對話、檔案和已有結果會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標は今後のラウンドへの進行を停止します。 このラウンドは続きます。 お客様の会話、ファイル、結果は保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표는 향후 라운드로의 진행을 중단합니다. 이번 라운드가 계속됩니다. 귀하의 대화, 파일 및 결과가 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objectif cessera d'avancer vers les prochains tours. Ce tour continue. Votre conversation, vos fichiers et vos résultats seront conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel wird nicht mehr in zukünftige Runden vorrücken. Diese Runde geht weiter. Ihre Konversation, Dateien und Ergebnisse werden gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo dejará de avanzar a rondas futuras. Esta ronda continúa. Su conversación, archivos y resultados se mantendrán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Objetivo vai parar de avançar para rodadas futuras. Esta rodada continua. Sua conversa, arquivos e resultados serão mantidos."
          }
        }
      }
    },
    "app.bilingual.22475f5f4927ddc3": {
