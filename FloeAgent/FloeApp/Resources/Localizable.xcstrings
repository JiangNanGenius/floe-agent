    "canvas.native.debuggerRunBatchTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量输出过大或嵌套过深，无法放置为卡片（%@）。请导出运行结果以保留全部内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The batch output is too large or too deeply nested to place as cards (%@). Export the run result to keep every value."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次輸出過大或巢狀過深，無法放置為卡片（%@）。請匯出執行結果以保留全部內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチ出力が大きすぎるか、カードとして配置するには過度に深く入れ子状です (%@)。 実行結果をエクスポートして、すべての値を保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배치 출력이 너무 크거나 너무 깊게 중첩되어 카드로 배치하기에는 너무 큽니다 (%@). 실행 결과를 내보내어 모든 값을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie par lots est trop importante ou trop profondément imbriquée pour être placée comme cartes (%@). Exportez le résultat d'exécution pour conserver chaque valeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Batch-Ausgabe ist zu groß oder zu tief verschachtelt, um sie als Karten zu platzieren (%@). Exportieren Sie das Laufergebnis, um jeden Wert beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida por lotes es demasiado grande o demasiado anidada para colocarse como tarjetas (%@). Exporte el resultado de ejecución para mantener cada valor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída do lote é muito grande ou muito profundamente aninhada para ser colocada como cartões (%@). Exporte o resultado da execução para manter todos os valores."
          }
        }
      }
    },
