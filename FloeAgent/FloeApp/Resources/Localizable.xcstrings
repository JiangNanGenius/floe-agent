          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la generación se guardó en la biblioteca de activos y se restaurará en el lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da geração foi salvo na biblioteca de ativos e será restaurado na tela."
          }
        }
      }
    },
