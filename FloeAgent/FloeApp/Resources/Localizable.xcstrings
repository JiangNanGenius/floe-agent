        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生为兼容后端，仅提供 POSIX Shell（无 Python/Node）；Linux 会在同一个 TinyEMU 客户机中运行 Shell、Python、Node 和服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生為相容後端，僅提供 POSIX Shell（無 Python/Node）；Linux 會在同一個 TinyEMU 客戶機中執行 Shell、Python、Node 和服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Native は POSIX シェルのみと互換性のあるバックエンドです（Python/Node は使用しません）；Linux はシェル、Python、Node、およびサービスを 1 つの TinyEMU ゲストで実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Native는 POSIX 셸과만 호환되는 백엔드이며 (Python/Node는 없습니다); Linux는 쉘, Python, Node 및 서비스를 하나의 TinyEMU 게스트에서 실행합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Native est le backend de compatibilité avec le shell POSIX uniquement (pas de Python/Node) ; Linux exécute le shell, Python, Node et les services dans un invité TinyEMU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Native ist das Kompatibilitäts-Backend nur mit der POSIX-Shell (kein Python/Node); Linux führt Shell, Python, Node und Dienste in einem TinyEMU-Gast aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Native es el backend de compatibilidad solo con el shell POSIX (sin Python/Node); Linux ejecuta shell, Python, Node y servicios en un invitado TinyEMU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Native é o back-end de compatibilidade apenas com o shell POSIX (sem Python/Node); Linux executa shell, Python, Node e serviços em um convidado TinyEMU."
          }
        }
      }
    },
