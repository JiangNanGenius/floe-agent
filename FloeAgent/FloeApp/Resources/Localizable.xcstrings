    "portforward.remapped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed port %1$lld was busy; using %2$lld instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定端口 %1$lld 已被占用，已改用 %2$lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定埠 %1$lld 已被佔用，已改用 %2$lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート %1$lld がビジーだった問題を修正しました。代わりに %2$lld を使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 포트가 바빴던 문제를 해결했으며, 대신 %2$lld를 사용하고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
