    "app.bilingual.a412d69cc5d1153d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在助手运行时生效。切换标签或收起助手时继续运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies while an assistant is running. Switching tabs or hiding the assistant keeps it running."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在助手執行時生效。切換標籤或收起助手時繼續執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントが実行中に適用されます。 タブを切り替えたり、アシスタントを非表示にしたりすることで、動作が維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 실행 중일 때 적용됩니다. 탭을 전환하거나 어시스턴트를 숨기면 계속 실행됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique pendant qu'un assistant est en cours d'exécution. Changer d'onglet ou cacher l'assistant le fait fonctionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt, während ein Assistent läuft. Das Wechseln von Tabs oder das Ausblenden des Assistenten hält ihn am Laufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica mientras un asistente está corriendo. Cambiar de pestaña u ocultar el asistente lo mantiene funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se enquanto um assistente está em execução. Trocar de guia ou ocultar o assistente mantém-o funcionando."
          }
        }
      }
    },
