    "design.page.noArtifact.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the result in the conversation; the real preview appears here with the first revision."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中描述成果；首个真实修订出现后这里会显示真实预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在對話中描述成果；首個真實修訂出現後這裡會顯示真實預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の結果を記述してください；実際のプレビューは最初のリビジョンとともにここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화에서 결과를 설명하십시오; 실제 미리보기는 첫 번째 수정과 함께 여기에서 나타납니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le résultat dans la conversation ; l'aperçu réel apparaît ici avec la première révision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie das Ergebnis im Gespräch; die echte Vorschau erscheint hier mit der ersten Revision."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describa el resultado en la conversación; la vista previa real aparece aquí con la primera revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o resultado na conversa; a visualização real aparece aqui com a primeira revisão."
