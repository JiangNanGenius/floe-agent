    "home.draft_task_permissions_sheet.ordinary_actions_run_automatically_mandatory_protections": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary actions run automatically; mandatory protections remain in effect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通操作自动执行，强制保护仍然有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "普通操作自動執行，強制保護仍然有效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の操作は自動的に実行されます；必須の保護は引き続き有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 작업은 자동으로 실행되며, 필수 보호는 계속 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions ordinaires s'exécutent automatiquement ; les protections obligatoires restent en vigueur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewöhnliche Aktionen werden automatisch ausgeführt; obligatorische Schutzmaßnahmen bleiben in Kraft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones ordinarias se ejecutan automáticamente; las protecciones obligatorias permanecen en vigor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ações comuns são executadas automaticamente; as proteções obrigatórias permanecem em vigor."
          }
        }
      }
    },
    "home.draft_task_permissions_sheet.reads_run_automatically_side_effecting_actions": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routine local work runs automatically; repository writes and risky remote actions follow the review policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地日常操作自动执行；代码库写入与远端风险操作按审核策略处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地日常操作自動執行；程式碼庫寫入與遠端風險操作按稽核策略處理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的なローカル作業は自動的に実行され、リポジトリへの書き込みおよびリスクの高いリモート操作はレビュー ポリシーに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상적인 로컬 작업은 자동으로 실행되며, 저장소 쓰기 및 위험한 원격 작업은 검토 정책을 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail local de routine s'exécute automatiquement ; les écritures du référentiel et les actions à distance risquées suivent la politique d'examen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Routinemäßige lokale Arbeit wird automatisch ausgeführt; Repository-Schreibvorgänge und riskante Remote-Aktionen folgen der Überprüfungsrichtlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo local de rutina se ejecuta automáticamente; las escrituras del repositorio y las acciones remotas arriesgadas siguen la política de revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho local de rotina é executado automaticamente; gravações de repositório e ações remotas arriscadas seguem a política de revisão."
          }
        }
      }
    },
