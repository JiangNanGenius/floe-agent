    "app.bilingual.642b9620ba415ce": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分工程需要额外资源；已包含运行文件的游戏可以直接运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some projects need extra resources; games with their own runtime can run directly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分工程需要額外資源；已包含執行檔案的遊戲可以直接執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のプロジェクトでは追加のリソースが必要です；独自のランタイムを持つゲームは直接実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 프로젝트는 추가 자원이 필요합니다; 자체 런타임을 가진 게임은 직접 실행할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains projets ont besoin de ressources supplémentaires ; les jeux avec leur propre runtime peuvent s'exécuter directement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Projekte benötigen zusätzliche Ressourcen; Spiele mit eigener Laufzeit können direkt ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos proyectos necesitan recursos adicionales; los juegos con su propio tiempo de ejecución pueden ejecutarse directamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns projetos precisam de recursos extras; jogos com seu próprio tempo de execução podem ser executados diretamente."
          }
        }
      }
    },
