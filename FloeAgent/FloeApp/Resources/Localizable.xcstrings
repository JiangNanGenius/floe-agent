    "feedback.images.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to three images. Floe resizes them and removes location and camera metadata before upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多三张。上传前会缩放图片并移除位置、相机等元数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多三張。上傳前會縮放圖片並移除位置、相機等後設資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大で3枚の画像まで。 Floeは、アップロードする前にサイズを変更し、位置情報とカメラのメタデータを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 세 장의 이미지. Floe는 업로드하기 전에 크기를 조정하고 위치 및 카메라 메타데이터를 제거합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à trois images. Floe les redimensionne et supprime les métadonnées de localisation et de caméra avant le téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu drei Bilder. Floe ändern die Größe und entfernt Standort- und Kamera-Metadaten vor dem Hochladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta tres imágenes. Floe los cambia de tamaño y elimina la ubicación y los metadatos de la cámara antes de la carga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até três imagens. Floe redimensiona e remove a localização e os metadados da câmera antes do upload."
          }
        }
      }
    },
