    "notes.note_file_importer.previewing_this_engineering_drawing_format_is": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previewing this engineering drawing format is not supported yet; export to DXF, DWG, STL or STEP and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持预览此工程图格式，请导出为 DXF、DWG、STL 或 STEP 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援預覽此工程圖格式，請匯出為 DXF、DWG、STL 或 STEP 後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジニアリング図面形式のプレビューはまだサポートされていません。DXF、DWG、STL、またはSTEPにエクスポートして、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔지니어링 도면 형식의 미리보기는 아직 지원되지 않습니다; DXF, DWG, STL 또는 STEP으로 내보내어 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu de ce format de dessin d'ingénierie n'est pas encore pris en charge ; exportez vers DXF, DWG, STL ou STEP et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau dieses technischen Zeichnungsformats wird noch nicht unterstützt; exportieren Sie es nach DXF, DWG, STL oder STEP und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de este formato de dibujo de ingeniería aún no es compatible; exporte a DXF, DWG, STL o STEP e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização deste formato de desenho de engenharia ainda não é suportada; exporte para DXF, DWG, STL ou STEP e tente novamente."
          }
        }
      }
    },
