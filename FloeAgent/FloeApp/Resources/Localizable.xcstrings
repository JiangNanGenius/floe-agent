    "app.bilingual.cea7a1867b2090c7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在验证后已改变，已拒绝预览。请重新验证后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file changed after verification, so the preview was refused. Verify it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案在驗證後已改變，已拒絕預覽。請重新驗證後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証後にファイルが変更されたため、プレビューは拒否されました。 もう一度ご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 인증 후 변경되어 미리보기가 거부되었습니다. 다시 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier a changé après vérification, donc l'aperçu a été refusé. Vérifiez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich nach der Überprüfung geändert, so dass die Vorschau abgelehnt wurde. Überprüfen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo cambió después de la verificación, por lo que la vista previa fue rechazada. Vuelve a verificarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo mudou após a verificação, então a visualização foi recusada. Verifique novamente."
          }
        }
      }
    },
    "app.bilingual.82ee08410f83df20": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件超过只读预览上限（20 MiB / 32 个资源）。原文件未被修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file exceeds the read-only preview limit (20 MiB / 32 resources). The original file was not changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案超過只讀預覽上限（20 MiB / 32 個資源）。原檔案未被修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは読み取り専用プレビュー上限（20 MiB / 32 リソース）を超えています。 元のファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 읽기 전용 미리보기 제한을 초과했습니다 (20 MiB / 32 리소스). 원본 파일이 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier dépasse la limite de prévisualisation en lecture seule (20 MiB / 32 ressources). Le fichier original n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei überschreitet das schreibgeschützte Vorschaulimit (20 MiB / 32 Ressourcen). Die Originaldatei wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo supera el límite de vista previa de solo lectura (20 MiB / 32 recursos). El archivo original no fue cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo excede o limite de visualização somente leitura (20 MiB / 32 recursos). O arquivo original não foi alterado."
          }
        }
      }
    },
