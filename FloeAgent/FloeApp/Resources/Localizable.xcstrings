          "stringUnit": {
            "state": "translated",
            "value": "Unable to queue the transfer. Select files and check the folders and permissions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能加入傳輸佇列。當前支援檔案傳輸；請檢查目錄和許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送をキューに入れません。 ファイルを選択し、フォルダーと権限を確認してください。"
