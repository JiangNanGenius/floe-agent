    "app.bilingual.9dbbe239dd1402d3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有项目共用运行资源，可在设置的本机运行环境中调整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects share runtime resources. Adjust them in Local runtime settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有專案共用執行資源，可在設定的本機執行環境中調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトは実行時リソースを共有します。 ローカルランタイム設定で調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 런타임 리소스를 공유합니다. 로컬 런타임 설정에서 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets partagent les ressources d'exécution. Ajustez-les dans les paramètres d'exécution locaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte teilen sich die Ressourcen zur Laufzeit. Passen Sie sie in den lokalen Laufzeiteinstellungen an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos comparten recursos de tiempo de ejecución. Ajústelos en la configuración de tiempo de ejecución local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos compartilham recursos de tempo de execução. Ajuste-os nas configurações de tempo de execução local."
          }
        }
      }
    },
