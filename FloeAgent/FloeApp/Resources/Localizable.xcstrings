    "app.bilingual.247af2ce4aeafb5b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此浏览器最多支持 6 个标签页。关闭一个标签页后再打开新的标签页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This browser supports up to 6 tabs. Close a tab before opening another."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此瀏覽器最多支援 6 個標籤頁。關閉一個標籤頁後再開啟新的標籤頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザは最大6タブまでサポートしています。 別のタブを開く前に、タブを閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 브라우저는 최대 6개의 탭을 지원합니다. 다른 탭을 열기 전에 탭을 닫으십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce navigateur prend en charge jusqu'à 6 onglets. Fermez un onglet avant d'en ouvrir un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Browser unterstützt bis zu 6 Tabs. Schließen Sie eine Registerkarte, bevor Sie eine andere öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este navegador admite hasta 6 pestañas. Cierre una pestaña antes de abrir otra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este navegador suporta até 6 guias. Feche uma guia antes de abrir outra."
          }
        }
      }
    },
