    "notes.mindmap.hint.reparent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a target topic to change its parent; tap empty space to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按目标主题完成改父级；点按空白取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按目標主題完成改父級；點按空白取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象のトピックをタップすると親が変更されます。空白のスペースをタップしてキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 주제를 탭하면 상위 항목을 변경하고, 빈 공간을 탭하면 취소합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un sujet cible pour changer son parent ; appuyez sur espace vide pour annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein Zielthema, um sein übergeordnetes Thema zu ändern; tippen Sie auf Leerzeichen, um es abzubrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque un tema de destino para cambiar su padre; toque espacio vacío para cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um tópico de destino para alterar seu pai; toque em espaço vazio para cancelar."
          }
        }
      }
    },
    "notes.mindmap.hint.rootSibling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The central topic has no siblings; pick a branch topic."
          }
        },
        "zh-Hans": {
