        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时会话：不保存到历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時會話：不儲存到歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
