    "cad.error.repickPlanarOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a flat face — only planar faces can be re-picked here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点平面 — 此处仅支持重新选择平面。"
