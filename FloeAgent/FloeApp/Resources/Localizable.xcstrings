    "settings.licenses.note.swiftgitx_native": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 retains its pinned upstream source and original MIT notice in FloeNativeGit; its native Git transport is provided by the separately declared libgit2 component."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 在 FloeNativeGit 中保留固定版本的上游源码与原始 MIT 声明；原生 Git 传输由单独列出的 libgit2 组件提供。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 在 FloeNativeGit 中保留固定版本的上游原始碼與原始 MIT 宣告；原生 Git 傳輸由單獨列出的 libgit2 元件提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 は、固定された上流ソースと FloeNativeGit のオリジナル MIT 通知を保持し、そのネイティブ Git トランスポートは別途宣言された libgit2 コンポーネントによって提供されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0은 고정된 업스트림 소스와 FloeNativeGit에 있는 원본 MIT 공지를 유지하며, 기본 Git 전송은 별도로 선언된 libgit2 컴포넌트에 의해 제공됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 conserve sa source en amont épinglée et son avis MIT original dans FloeNativeGit ; son transport Git natif est fourni par le composant libgit2 déclaré séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 behält seine angeheftete Upstream-Quelle und den ursprünglichen MIT-Hinweis in FloeNativeGit bei; sein nativer Git-Transport wird von der separat deklarierten libgit2-Komponente bereitgestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SwiftGitX 0.4.0 conserva su fuente ascendente anclada y su aviso original del MIT en FloeNativeGit; su transporte nativo de Git es proporcionado por el componente libgit2 declarado por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SwiftGitX 0.4.0 mantém sua fonte upstream fixada e o aviso MIT original no FloeNativeGit; seu transporte Git nativo é fornecido pelo componente libgit2 declarado separadamente."
          }
        }
      }
    },
