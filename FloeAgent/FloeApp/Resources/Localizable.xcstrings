    "providers.readback.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Post-save readback failed. Please try again; if it persists, restart the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后读回失败，请重试；若仍失败请重启应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後讀回失敗，請重試；若仍失敗請重啟應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後のリードバックに失敗しました。 もう一度お試しください。問題が解決しない場合は、アプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 후 읽기가 실패했습니다. 다시 시도해 주세요; 계속되면 앱을 재시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture post-enregistrement a échoué. Veuillez réessayer ; si cela persiste, redémarrez l'application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Speichern ist die Rücklese fehlgeschlagen. Bitte versuchen Sie es erneut; wenn es weiterhin besteht, starten Sie die App neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la lectura posterior al guardado. Por favor, inténtelo de nuevo; si persiste, reinicie la aplicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na leitura pós-salvamento. Por favor, tente novamente; se persistir, reinicie o aplicativo."
          }
        }
      }
    },
    "providers.readback.mismatch": {
