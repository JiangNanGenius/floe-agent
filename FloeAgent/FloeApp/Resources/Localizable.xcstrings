            "value": "La tâche actuelle est en cours d'exécution ou de compactage ; exécute /compact lorsque la tâche est inactive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Aufgabe wird ausgeführt oder komprimiert; run /compact, wenn die Aufgabe im Leerlauf ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea actual se está ejecutando o compactando; ejecutar / compactar cuando la tarea está inactiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa atual está em execução ou compactando; execute /compacte quando a tarefa estiver ociosa."
          }
        }
      }
    },
    "remote.conversation_center.the_event_record_changed_during_export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The event record changed during export; please try again."
