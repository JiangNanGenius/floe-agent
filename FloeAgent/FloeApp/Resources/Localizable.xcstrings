    "app.bilingual.62e0429d104fb529": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图文内容会转换为目标格式支持的文字，完整内容请保留原生文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich content is converted to text supported by this format. Keep the editable original for the complete content."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖文內容會轉換為目標格式支援的文字，完整內容請保留原生檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リッチコンテンツは、このフォーマットがサポートするテキストに変換されます。 完全なコンテンツについては、編集可能なオリジナルをそのまま保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리치 콘텐츠는 이 형식이 지원하는 텍스트로 변환됩니다. 전체 콘텐츠에 대한 편집 가능한 원본을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu riche est converti en texte pris en charge par ce format. Conservez l'original modifiable pour le contenu complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rich-Inhalte werden in Text umgewandelt, der von diesem Format unterstützt wird. Behalten Sie das bearbeitbare Original für den vollständigen Inhalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido enriquecido se convierte en texto compatible con este formato. Mantenga el original editable para el contenido completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo rico é convertido em texto suportado por este formato. Mantenha o original editável para o conteúdo completo."
          }
        }
      }
    },
    "app.bilingual.6a14bcefd1054e2e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负责人、日期、依赖等项目字段不能完整保留。"
          }
        },
        "en": {
          "stringUnit": {
