        "zh-Hans": { "stringUnit": { "state": "translated", "value": "搜索、Apple 与远程主机" } }
      }
    },
    "setup.features.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Start with one conversation model. The remaining capabilities are optional and can be enabled later in Settings." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "先配置一个对话模型即可开始；其余能力均为可选项，可稍后在设置中逐步启用。" } }
      }
    },
    "setup.features.local_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Prefer offline use? Skip the setup guide, then download a model in Settings > Local Models." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "希望离线使用？可跳过设置向导，再到“设置 > 本地模型”下载模型。" } }
      }
    },
    "setup.features.models.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Cloud models provide full capability. Downloaded local models provide an offline fallback and load only when needed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "云模型提供完整能力；下载的本地模型可作为离线补充，并仅在需要时加载。" } }
      }
    },
