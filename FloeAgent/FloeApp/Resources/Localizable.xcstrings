    "runtime.intelligence_store.a_fact_slot_in_the_same": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fact slot in the same scope has multiple current values; keep the newest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一范围的事实槽位存在多个当前值，应保留最新值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一範圍的事實槽位存在多個當前值，應保留最新值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じスコープ内のファクトスロットには複数の現在の値があります。最新のものを保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 범위 내의 사실 슬롯에 현재 값이 여러 개 있습니다; 최신 값을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un emplacement de fait dans la même portée a plusieurs valeurs actuelles ; conservez la plus récente."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Faktensteckplatz im selben Bereich hat mehrere aktuelle Werte; behalte den neuesten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ranura de hechos en el mismo alcance tiene múltiples valores actuales; mantenga el más nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um slot de fato no mesmo escopo tem vários valores atuais; mantenha o mais novo."
          }
        }
      }
    },
    "runtime.intelligence_store.the_content_is_identical_cross_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content is identical; cross-scope deletion still requires confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容完全相同；跨范围删除仍需确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容完全相同；跨範圍刪除仍需確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容は同一です；クロススコープ削除にはまだ確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용이 동일합니다; 교차 범위 삭제는 여전히 확인이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu est identique ; la suppression de la portée croisée nécessite toujours une confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalt ist identisch; das Löschen von Cross-Scope erfordert noch eine Bestätigung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido es idéntico; la eliminación de alcance cruzado aún requiere confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo é idêntico; a exclusão de escopo cruzado ainda requer confirmação."
          }
        }
      }
    },
    "runtime.intelligence_store.the_memory_has_passed_its_validity": {
      "extractionState": "manual",
