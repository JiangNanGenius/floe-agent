    "app.bilingual.e91ad768d98cf0af": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动力刀具的切削部分检查夹具；刀杆和刀柄检查夹具及当时的剩余材料。车刀和完整机床部件另行记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live-tool cutting part is checked against fixtures; shank and holder against fixtures and stock at the current step. Turning-tool bodies and full machine components remain separate."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動力刀具的切削部分檢查夾具；刀杆和刀柄檢查夾具及當時的剩餘材料。車刀和完整機床部件另行記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブツール切削部品は治具と照合され、シャンクとホルダーは現在の工程で治具およびストックと照合されます。 旋削工具本体と全機械部品は別々に保たれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 툴 절단 부품은 고정구와 맞물리며, 샹크와 홀더는 현재 단계에서 고정구와 재고에 대해 점검됩니다. 선반 본체와 전체 기계 부품은 별도로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La partie de coupe de l'outil en direct est vérifiée par rapport aux accessoires ; la tige et le support par rapport aux appareils et au stock à l'étape actuelle. Les corps d'outils de tournage et les composants complets de la machine restent séparés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schneideteil des Live-Tools wird mit den Vorrichtungen verglichen; Schaft und Halter gegen Vorrichtungen und Lagerbestand im aktuellen Schritt. Drehwerkzeugkörper und vollständige Maschinenkomponenten bleiben getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La parte de corte de la herramienta viva se comprueba con los accesorios; el vástago y el soporte contra los accesorios y el stock en el paso actual. Los cuerpos de la herramienta de torneado y los componentes completos de la máquina permanecen separados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parte de corte da ferramenta ao vivo é verificada contra acessórios; haste e suporte contra acessórios e estoque na etapa atual. Corpos de ferramentas de torneamento e componentes completos da máquina permanecem separados."
          }
        }
      }
    },
