    "cad.datum.axisFromPlanesHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The axis is the intersection line and follows both planes, including their own edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该轴为两平面的交线，会跟随这两个平面及其编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該軸為兩平面的交線，會跟隨這兩個平面及其編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸は交点線であり、両方の平面に従い、それぞれの編集も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축은 교차선이며 두 평면을 모두 따라가며, 각 평면의 자체 편집을 포함합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'axe est la ligne d'intersection et suit les deux plans, y compris leurs propres modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Achse ist die Schnittlinie und folgt beiden Ebenen, einschließlich ihrer eigenen Bearbeitungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El eje es la línea de intersección y sigue ambos planos, incluidas sus propias ediciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O eixo é a linha de interseção e segue ambos os planos, incluindo suas próprias edições."
          }
        }
      }
    },
