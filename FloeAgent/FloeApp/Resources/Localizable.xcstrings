          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leinwand hat sich geändert; versuchen Sie es erneut mit den neuesten Inhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lienzo cambió; inténtalo de nuevo con el contenido más reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela mudou; tente novamente com o conteúdo mais recente."
          }
        }
      }
    },
