    "app.workspace_canvas_view.the_drawing_changed_while_preparing": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸在恢复准备期间已变化；已重新载入，请再次选择历史版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing changed while preparing the restore; reloaded, please choose the historical version again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙在恢復準備期間已變化；已重新載入，請再次選擇歷史版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元の準備中に図面が変更されました。再読み込みされましたので、再度過去のバージョンを選択してください。"
          }
