    "cad.recovery.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document can't be opened. The last verified save can be restored as a new copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档无法打开。可将上次已验证的保存恢复为新副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件無法開啟。可將上次已驗證的儲存恢復為新副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は開くことができません。 最後に検証されたセーブは、新しいコピーとして復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 열 수 없습니다. 마지막으로 검증된 저장 파일을 새 사본으로 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document ne peut pas être ouvert. La dernière sauvegarde vérifiée peut être restaurée en tant que nouvelle copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument kann nicht geöffnet werden. Der letzte verifizierte Speicher kann als neue Kopie wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no se puede abrir. El último guardado verificado se puede restaurar como una nueva copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento não pode ser aberto. O último salvamento verificado pode ser restaurado como uma nova cópia."
          }
        }
      }
    },
    "cad.recovery.error.sourceChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed since this preview. Refresh before restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档在此预览后已更改。请刷新后再恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在此預覽後已更改。請重新整理後再恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビュー以降、文書が変更されました。 復元する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 미리보기 이후로 문서가 변경되었습니다. 복원하기 전에 새로 고침하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé depuis cet aperçu. Rafraîchissez avant de restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument hat sich seit dieser Vorschau geändert. Vor der Wiederherstellung aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento ha cambiado desde esta vista previa. Actualizar antes de restaurar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou desde esta visualização. Atualize antes de restaurar."
          }
        }
      }
    },
    "cad.recovery.error.destinationExists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recovered copy with this name already exists. Nothing was overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同名恢复副本已存在；未覆盖任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同名恢復副本已存在；未覆蓋任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前の復元されたコピーはすでに存在します。 何も上書きされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름을 가진 복구된 사본이 이미 존재합니다. 아무것도 덮어쓰지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie récupérée avec ce nom existe déjà. Rien n'a été écrasé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine wiederhergestellte Kopie mit diesem Namen existiert bereits. Nichts wurde überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe una copia recuperada con este nombre. Nada fue sobrescrito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma cópia recuperada com este nome. Nada foi substituído."
          }
        }
      }
    },
    "cad.recovery.error.noPrevious": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last saved version could not be verified, so nothing can be restored. The damaged document was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次保存的版本无法验证，因此无法恢复。损坏的文档未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次儲存的版本無法驗證，因此無法恢復。損壞的文件未被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に保存されたバージョンは検証できなかったため、何も復元できません。 損傷した文書は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 저장된 버전을 확인할 수 없어 복구할 수 없습니다. 손상된 문서는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version enregistrée n'a pas pu être vérifiée, donc rien ne peut être restauré. Le document endommagé n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt gespeicherte Version konnte nicht überprüft werden, so dass nichts wiederhergestellt werden kann. Das beschädigte Dokument wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la última versión guardada, por lo que no se puede restaurar nada. El documento dañado no fue cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última versão salva não pôde ser verificada, então nada pode ser restaurado. O documento danificado não foi alterado."
          }
        }
      }
    },
    "cad.recovery.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy could not be created. The damaged document was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建副本。损坏的文档未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法建立副本。損壞的文件未被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーを作成できませんでした。 損傷した文書は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본을 생성할 수 없습니다. 손상된 문서는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie n'a pas pu être créée. Le document endommagé n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie konnte nicht erstellt werden. Das beschädigte Dokument wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear la copia. El documento dañado no fue cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia não pôde ser criada. O documento danificado não foi alterado."
          }
        }
      }
    },
    "cad.recovery.error.openFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
