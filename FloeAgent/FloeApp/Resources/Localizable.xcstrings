    "app.bilingual.7275dec3c14e7194": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入编曲，演奏记录暂未更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added to the arrangement; its performance record could not be updated."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入編曲，演奏記錄暫未更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アレンジに追加されました；そのパフォーマンス記録は更新できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배열에 추가되었습니다; 성능 기록을 업데이트할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté à l'arrangement ; son dossier de performance n'a pas pu être mis à jour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Arrangement hinzugefügt; sein Leistungsrekord konnte nicht aktualisiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido al arreglo; su registro de rendimiento no se pudo actualizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionado ao arranjo; seu registro de desempenho não pôde ser atualizado."
          }
        }
      }
    },
    "app.bilingual.40ec8e7ef7bec3bc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演奏音频已保留，尚未加入编曲。请查看当前编曲后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The performed audio is kept but was not added. Check the current arrangement before trying again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "演奏音訊已保留，尚未加入編曲。請檢視當前編曲後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行された音声は保持されていますが、追加されていません。 再度試す前に、現在の配置をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연주된 오디오는 유지되지만 추가되지 않았습니다. 다시 시도하기 전에 현재 배열을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio exécuté est conservé mais n'a pas été ajouté. Vérifiez l'arrangement actuel avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aufgeführte Audio wird beibehalten, aber nicht hinzugefügt. Überprüfen Sie die aktuelle Anordnung, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio realizado se conserva, pero no se agregó. Compruebe el arreglo actual antes de intentarlo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio executado é mantido, mas não foi adicionado. Verifique o arranjo atual antes de tentar novamente."
          }
        }
      }
    },
