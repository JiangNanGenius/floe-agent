    "workspace.workspace_canvas_view.and_its_canvas_assistant_conversations_will": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and its canvas assistant conversations will be deleted. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除“%@”及其画布助手会话。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除“%@”及其畫布助手會話。此操作無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とそのキャンバスアシスタントの会話は削除されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와 해당 캔버스 어시스턴트 대화는 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et ses conversations d'assistant de toile seront supprimés. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" und seine Canvas-Assistenten-Konversationen werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y sus conversaciones de asistente de lienzo serán eliminadas. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e suas conversas de assistente de tela serão excluídas. Isso não pode ser desfeito."
          }
        }
      }
    },
