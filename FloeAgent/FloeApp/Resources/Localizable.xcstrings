    "settings.general_settings_view.the_queue_starts_a_new_turn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue starts a new turn after the current task ends; a steer is inserted into context after the current model output or tool call fully completes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "队列会在当前任务结束后启动新一轮；引导会在当前模型输出或工具调用完整结束后插入上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "佇列會在當前任務結束後啟動新一輪；引導會在當前模型輸出或工具呼叫完整結束後插入上下文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューは現在のタスクが終了した後に新しいターンを開始し、現在のモデル出力またはツール呼び出しが完全に完了した後にステアがコンテキストに挿入されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업이 종료된 후 큐가 새로운 턴을 시작하고, 현재 모델 출력 또는 툴 호출이 완전히 완료된 후 컨텍스트에 스티어가 삽입됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La file d'attente commence un nouveau tour après la fin de la tâche en cours ; un steer est inséré dans le contexte après la fin complète de la sortie du modèle ou de l'appel d'outil actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Warteschlange beginnt eine neue Runde, nachdem die aktuelle Aufgabe beendet ist; ein Steuer wird in den Kontext eingefügt, nachdem die aktuelle Modellausgabe oder der Werkzeugaufruf vollständig abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola comienza un nuevo turno después de que finalice la tarea actual; una dirección se inserta en contexto después de que la salida del modelo actual o la llamada a la herramienta se complete por completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fila inicia uma nova rodada após o término da tarefa atual; uma direção é inserida no contexto após a conclusão total da saída do modelo atual ou da chamada da ferramenta."
          }
        }
      }
    },
