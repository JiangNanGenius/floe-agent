    "git.local_git_service.the_merge_has_conflicts_resolve_each": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The merge has conflicts; resolve each one before submitting"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合并存在冲突，请逐个解决后提交"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "合並存在衝突，請逐個解決後提交"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マージに競合があります。提出する前にそれぞれを解決してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "병합에 충돌이 있습니다; 제출하기 전에 각각을 해결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusion a des conflits ; résolvez chacun d'eux avant de soumettre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenführung hat Konflikte; lösen Sie jeden vor dem Absenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fusión tiene conflictos; resuelva cada uno antes de enviarlo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesclagem tem conflitos; resolva cada um antes de enviar"
          }
        }
      }
    },
    "git.local_git_service.the_repository_url_cannot_contain_an": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository URL cannot contain an account or credentials; save them separately in the GitHub connection"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库地址不能包含账号或凭据，请在 GitHub 连接中单独保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倉庫地址不能包含賬號或憑據，請在 GitHub 連線中單獨儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリの URL にはアカウントや認証情報を含めることはできません。GitHub 接続で別途保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 URL에 계정이나 자격 증명이 포함될 수 없습니다; GitHub 연결에 별도로 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL du référentiel ne peut pas contenir de compte ou d'informations d'identification ; enregistrez-les séparément dans la connexion GitHub"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Repository-URL kann kein Konto oder Anmeldeinformationen enthalten; speichern Sie sie separat in der GitHub-Verbindung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del repositorio no puede contener una cuenta o credenciales; guárdelas por separado en la conexión GitHub"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O URL do repositório não pode conter uma conta ou credenciais; salve-as separadamente na conexão GitHub"
          }
        }
      }
    },
