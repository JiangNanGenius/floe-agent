    "voice.file_speech_transcriber.whisper_is_unavailable_and_apple_speech": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition could not start. Check the model and microphone permission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别无法启动，请检查模型和麦克风权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語音識別無法啟動，請檢查模型和麥克風許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声認識が開始できませんでした。 モデルとマイクの許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 인식을 시작할 수 없습니다. 모델 및 마이크 권한을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale n'a pas pu démarrer. Vérifiez le modèle et l'autorisation du microphone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung konnte nicht gestartet werden. Überprüfen Sie die Berechtigung des Modells und des Mikrofons."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el reconocimiento de voz. Comprueba el permiso del modelo y del micrófono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala não pôde ser iniciado. Verifique o modelo e a permissão do microfone."
          }
        }
      }
    },
