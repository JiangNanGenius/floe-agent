    "execution.runtime_reset.complete": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime restored. Your project files are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行环境已恢复，项目文件已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行環境已恢復，專案檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムが復元されました。 お客様のプロジェクトファイルは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런타임이 복구되었습니다. 귀하의 프로젝트 파일이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
