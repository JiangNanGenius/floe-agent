          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Asset-Referenz-Abstimmungsjournal konnte nicht geschrieben werden; die Abstimmung wird fortgesetzt, aber dieser Fortschritt wird einen Neustart nicht überleben: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
