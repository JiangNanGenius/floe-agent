    "app.bilingual.848030c8f0e5372d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法定位，请检查工程是否仍打开且原件未改变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not locate the component. Check that the project is still open and the original has not changed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法定位，請檢查工程是否仍開啟且原件未改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントが見つかりませんでした。 プロジェクトがまだ開いているか、元のものが変更されていないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성 요소를 찾을 수 없습니다. 프로젝트가 아직 열려 있는지, 원본이 변경되지 않았는지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de localiser le composant. Vérifiez que le projet est toujours ouvert et que l'original n'a pas changé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Komponente konnte nicht gefunden werden. Überprüfen Sie, ob das Projekt noch offen ist und sich das Original nicht geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo localizar el componente. Compruebe que el proyecto sigue abierto y que el original no haya cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível localizar o componente. Verifique se o projeto ainda está aberto e se o original não mudou."
          }
        }
      }
    },
