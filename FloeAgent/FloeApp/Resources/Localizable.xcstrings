    "shortcuts.run.cancel.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops this exact run; later runs are not affected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止这次运行，不影响之后的运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
