    "mail.settings.test_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only connects and authenticates. Does not send, read or delete messages. Re-enter the password when changing a password account’s server."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅连接并验证账号，不发送、读取或删除邮件。更换密码账户的服务器时需重新输入密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅連線並驗證賬號，不傳送、讀取或刪除郵件。更換密碼賬戶的伺服器時需重新輸入密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続と認証のみを行います。 メッセージの送信、読み取り、削除は行いません。 パスワードを変更する際に、アカウントのサーバーでパスワードを再入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결하고 인증만 합니다. 메시지를 전송하거나 읽거나 삭제하지 않습니다. 비밀번호 계정의 서버를 변경할 때 비밀번호를 다시 입력하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne se connecte et s'authentifie que. N'envoie pas, ne lit pas ou ne supprime pas de messages. Rentrez le mot de passe lorsque vous changez le serveur d'un compte de mot de passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindet und authentifiziert sich nur. Sendet, liest oder löscht keine Nachrichten. Geben Sie das Passwort erneut ein, wenn Sie den Server eines Passwortkontos ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se conecta y autentica. No envía, lee ni elimina mensajes. Vuelva a introducir la contraseña al cambiar el servidor de una cuenta de contraseña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas se conecta e autentica. Não envia, lê ou exclui mensagens. Digite novamente a senha ao alterar o servidor de uma conta de senha."
          }
        }
      }
    },
    "mail.settings.test_success": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both servers authenticated successfully. No mail was sent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收发服务器均认证成功，未发送邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收發伺服器均認證成功，未傳送郵件。"
