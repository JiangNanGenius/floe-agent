    "providers.manual_fallback.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This endpoint does not support model discovery. Add models manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此端点不支持模型发现，请手动添加模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此端點不支援模型發現，請手動新增模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンドポイントはモデル検出をサポートしていません。 モデルを手動で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔드포인트는 모델 검색을 지원하지 않습니다. 모델을 수동으로 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de terminaison ne prend pas en charge la découverte du modèle. Ajoutez des modèles manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Endpunkt unterstützt die Modellerkennung nicht. Modelle manuell hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto final no admite el descubrimiento de modelos. Añade modelos manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endpoint não suporta a descoberta do modelo. Adicione modelos manualmente."
          }
        }
      }
    },
