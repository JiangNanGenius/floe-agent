    "workspace.i_d_e_language_run_view.the_current_image_manifest_does_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current image manifest does not certify support for %@ cores, so the resource pool rejects the request; it never silently runs with fewer cores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前镜像清单没有证明支持 %@ 核，资源池会拒绝该请求；不会静默降核运行。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_do_not_ask": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals do not ask for parallelism: this run starts with 1 guest core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号未要求并行：本次以 1 个客户机内核启动。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_recommend_2_cores": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals recommend 2 cores, but only 1 can be delivered. This run starts with 1 guest core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号推荐 2 核，但当前只能交付 1 核。本次将以 1 个客户机内核启动。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_declared_signals_support_parallelism_this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared signals support parallelism: this will start with 2 guest cores. Dual-core has passed S0–S4 correctness, but equivalent-work benchmarks are slower on 2 cores (about %@); use it only when the task genuinely benefits from parallelism."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明信号表明可并行：本次将以 2 个客户机内核启动。双核已通过 S0–S4 正确性验证，但等量工作基准在 2 核上更慢（约 %@）；仅在任务确实受益于并行时使用。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_file_exceeds_the_kb_transfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file exceeds the %@ KB transfer limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件超过 %@ KB 的传输上限"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_file_path_is_not_valid": {
      "extractionState": "manual",
      "localizations": {
