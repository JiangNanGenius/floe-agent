    "settings.remote.idle_disconnect.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle sessions disconnect after this many minutes to release remote resources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空闲会话在设定分钟数后断开，以释放远程资源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空閒會話在設定分鐘數後斷開，以釋放遠端資源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイドルセッションはこの数分後に切断され、リモートリソースを解放します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 몇 분 후에 유휴 세션이 끊어지고 원격 리소스를 해제합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions inactives se déconnectent après autant de minutes pour libérer des ressources à distance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indle-Sitzungen werden nach so vielen Minuten die Verbindung unterbrochen, um Remote-Ressourcen freizugeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones inactivas se desconectan después de tantos minutos para liberar recursos remotos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As sessões ociosas se desconectam após tantos minutos para liberar recursos remotos."
          }
        }
      }
    },
