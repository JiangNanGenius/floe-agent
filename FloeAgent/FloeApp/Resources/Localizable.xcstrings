    "app.bilingual.df43cdd90dd606d1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位移、反力、单元应变与应力均保存在完整结果中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Displacements, reactions, element strains and stresses are retained in the complete result."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位移、反力、單元應變與應力均儲存在完整結果中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変位、反応、要素ひずみおよび応力は、完全な結果に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변위, 반응, 요소 변형 및 응력은 완전한 결과에 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les déplacements, les réactions, les déformations d'éléments et les contraintes sont conservés dans le résultat complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebungen, Reaktionen, Elementzerrungen und Spannungen bleiben im Gesamtergebnis erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los desplazamientos, reacciones, cepas de elementos y tensiones se retienen en el resultado completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslocamentos, reações, tensões de elementos e tensões são retidos no resultado completo."
          }
        }
      }
    },
