    "cad.recovery.error.outsideSource": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy must be created in the same folder as the damaged document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "副本必须创建在损坏文档所在的文件夹中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "副本必須建立在損壞文件所在的資料夾中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーは、破損した文書と同じフォルダーに作成しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사본은 손상된 문서와 동일한 폴더에 생성되어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie doit être créée dans le même dossier que le document endommagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kopie muss im selben Ordner wie das beschädigte Dokument erstellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia debe crearse en la misma carpeta que el documento dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia deve ser criada na mesma pasta do documento danificado."
          }
        }
      }
    },
