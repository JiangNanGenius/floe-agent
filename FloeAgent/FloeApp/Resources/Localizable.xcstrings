    "cad.overlay.footer.partAnimation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part animation moves the cut with each part. Remove the section before playing or exporting part tracks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "零件动画会让剖切随零件移动。播放或导出零件轨道前请先移除剖切。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "零件動畫會讓剖切隨零件移動。播放或匯出零件軌道前請先移除剖切。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パートアニメーションは、各パートに合わせてカットを動かします。 パートトラックを再生またはエクスポートする前に、セクションを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파트 애니메이션은 각 파트마다 컷을 이동합니다. 파트 트랙을 재생하거나 내보내기 전에 섹션을 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'animation de la partie déplace la coupe avec chaque partie. Supprimez la section avant de lire ou d'exporter des pistes de pièces."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Teilanimation verschiebt den Schnitt mit jedem Teil. Entfernen Sie den Abschnitt, bevor Sie Teilespuren abspielen oder exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La animación parcial mueve el corte con cada parte. Elimine la sección antes de reproducir o exportar pistas de piezas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A animação parcial move o corte com cada parte. Remova a seção antes de reproduzir ou exportar faixas de peças."
          }
        }
      }
    },
