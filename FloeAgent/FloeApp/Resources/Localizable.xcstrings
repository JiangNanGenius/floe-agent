    "setup.voice.browse.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can pick a voice that is not downloaded yet. The voice you use now keeps playing until the new one is ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以选择尚未下载的声音。新声音就绪前，当前声音会继续使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以選擇尚未下載的聲音。新聲音就緒前，當前聲音會繼續使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだダウンロードされていない音声を選択できます。 現在使用している音声は、新しいものが準備できるまで再生され続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 다운로드되지 않은 음성을 선택하실 수 있습니다. 현재 사용 중인 음성은 새로운 음성이 준비될 때까지 계속 재생됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir une voix qui n'est pas encore téléchargée. La voix que vous utilisez maintenant continue de jouer jusqu'à ce que la nouvelle soit prête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können eine Stimme auswählen, die noch nicht heruntergeladen wurde. Die Stimme, die Sie jetzt verwenden, spielt weiter, bis die neue fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir una voz que aún no se haya descargado. La voz que usas ahora sigue sonando hasta que la nueva esté lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode escolher uma voz que ainda não foi baixada. A voz que você usa agora continua tocando até que a nova esteja pronta."
          }
        }
      }
    },
