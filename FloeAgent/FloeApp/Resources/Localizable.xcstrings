    "notes.notes_agent_tools.a_full_mind_map_edit_requires": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full mind-map edit requires nodes, connections, summaries and direction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整导图编辑需要 nodes、connections、summaries 和 direction。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整導圖編輯需要 nodes、connections、summaries 和 direction。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なマインドマップの編集には、ノード、接続、要約、そして方向が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 마인드맵 편집에는 노드, 연결, 요약 및 방향이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une édition complète de la carte mentale nécessite des nœuds, des connexions, des résumés et une direction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vollständige Mind-Map-Bearbeitung erfordert Knoten, Verbindungen, Zusammenfassungen und Richtungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una edición completa del mapa mental requiere nodos, conexiones, resúmenes y dirección."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma edição completa do mapa mental requer nós, conexões, resumos e direção."
          }
        }
      }
    },
