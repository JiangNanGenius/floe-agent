    "app.bilingual.bbf753a81da291dc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两盘实时混音；速度、锁调、跳点和循环直接作用于当前音频。耳机预听需要独立输出通道。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both decks mix live. Rate, key lock, cues and loops control the current audio. Headphone cueing requires a separate output channel."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩盤實時混音；速度、鎖調、跳點和迴圈直接作用於當前音訊。耳機預聽需要獨立輸出通道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデッキがライブでミックスされます。 レート、キー ロック、キュー、ループが現在のオーディオを制御します。 ヘッドフォンキューイングには別個の出力チャンネルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 덱이 실시간으로 혼합됩니다. 레이트, 키 잠금, 큐 및 루프가 현재 오디오를 제어합니다. 헤드폰 큐잉은 별도의 출력 채널이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux decks se mélangent en direct. Le taux, le verrouillage à clé, les indices et les boucles contrôlent l'audio actuel. Le signal du casque nécessite un canal de sortie séparé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Decks mischen sich live. Rate, Tastensperre, Hinweise und Schleifen steuern den aktuellen Ton. Das Auslauslen des Kopfhörers erfordert einen separaten Ausgangskanal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas barajas se mezclan en vivo. La frecuencia, el bloqueo de teclas, las señales y los bucles controlan el audio actual. La señal de los auriculares requiere un canal de salida separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos os decks se misturam ao vivo. Taxa, bloqueio de teclas, dicas e loops controlam o áudio atual. A sinalização do fone de ouvido requer um canal de saída separado."
          }
        }
      }
    },
