    "app.cadbuilding_project_entry.the_project_copies_the_saved": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工程会复制当前已保存的 CAD 图形到工作区的“Building Projects”，原文件保持不变；之后请在工程中继续编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project copies the saved CAD drawing into “Building Projects” in this workspace. The original file stays unchanged; continue in the project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工程會複製當前已儲存的 CAD 圖形到工作區的“Building Projects”，原檔案保持不變；之後請在工程中繼續編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトは、保存された CAD 図面をこのワークスペースの「Building Projects」にコピーします。 元のファイルは変更されませんので、プロジェクト内で続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트는 저장된 CAD 도면을 이 작업 공간의 “Building Projects”에 복사합니다. 원본 파일은 그대로 유지됩니다; 프로젝트에서 계속 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet copie le dessin CAD enregistré dans \"Projets de construction\" dans cet espace de travail. Le fichier original reste inchangé ; continuez dans le projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt kopiert die gespeicherte CAD-Zeichnung in \"Building Projects\" in diesem Arbeitsbereich. Die ursprüngliche Datei bleibt unverändert; im Projekt fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto copia el dibujo CAD guardado en \"Construcción de proyectos\" en este espacio de trabajo. El archivo original permanece sin cambios; continúe en el proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto copia o desenho CAD salvo para “Projetos de Construção” neste espaço de trabalho. O arquivo original permanece inalterado; continue no projeto."
          }
        }
      }
    },
