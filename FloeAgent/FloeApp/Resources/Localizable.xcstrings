    "app.bilingual.d29ddc049a3dd7f5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃该文件的修改？原内容会先保留在恢复记录中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this file's changes? The original content is kept in recovery first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄該檔案的修改？原內容會先保留在恢復記錄中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルの変更を破棄しますか？ 元のコンテンツはまずリカバリで保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일의 변경 사항을 삭제하시겠습니까? 원본 콘텐츠는 먼저 복구 상태로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeter les modifications de ce fichier ? Le contenu original est d'abord conservé en récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an dieser Datei verwerfen? Der ursprüngliche Inhalt wird zuerst in der Wiederherstellung aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar los cambios de este archivo? El contenido original se mantiene en recuperación primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartar as alterações deste arquivo? O conteúdo original é mantido na recuperação primeiro."
          }
        }
      }
    },
    "app.bilingual.2660d0445f84ed36": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留原内容，可从“更多操作 → 恢复修改”恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original content was kept. Use More Actions → Recover Changes to restore it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留原內容，可從“更多操作 → 恢復修改”恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のコンテンツは保持されました。 「More Actions」→「Recover Changes」を使用して復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 콘텐츠가 보존되었습니다. 추가 작업 사용 → 변경 사항 복구를 사용하여 복원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu original a été conservé. Utilisez Plus d'actions → Récupérer les modifications pour les restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ursprüngliche Inhalt wurde beibehalten. Verwenden Sie Weitere Aktionen → Wiederherstellen von Änderungen, um es wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantuvo el contenido original. Usar más acciones → Recuperar cambios para restaurarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo original foi mantido. Use Mais Ações → Recuperar Alterações para restaurá-lo."
          }
        }
      }
    },
