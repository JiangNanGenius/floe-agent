    "settings.data_management_view.syncs_only_when_both_the_master": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs only when both the master switch and the canvas’s own switch are on. Turning sync off does not delete cloud copies; permanently deleting an asset removes it from sync after confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总开关和画布自身开关都开启时才会同步。关闭同步不会删除云端副本；永久删除素材会在确认后从同步中删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總開關和畫布自身開關都開啟時才會同步。關閉同步不會刪除雲端副本；永久刪除素材會在確認後從同步中刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスタースイッチとキャンバス自身のスイッチの両方がオンの場合にのみ同期します。 同期をオフにしてもクラウドのコピーは削除されません。アセットを永久に削除すると、確認後に同期から削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스터 스위치와 캔버스 자체 스위치가 모두 켜져 있을 때만 동기화됩니다. 동기화를 끄면 클라우드 복사본이 삭제되지 않으며, 자산을 영구적으로 삭제하면 확인 후 동기화에서 제거됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se synchronise uniquement lorsque le commutateur principal et le commutateur du canevas sont tous deux enclens. La désactivation de la synchronisation ne supprime pas les copies du cloud ; la suppression permanente d'un actif le supprime de la synchronisation après confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisiert nur, wenn sowohl der Hauptschalter als auch der eigene Schalter der Leinwand aktiviert sind. Wenn Sie die Synchronisierung deatenieren, werden keine Cloud-Kopien gelöscht; das dauerhafte Löschen eines Assets wird nach der Bestätigung aus der Synchronisierung entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se sincroniza solo cuando tanto el interruptor maestro como el propio interruptor del lienzo están encendidos. Desactivar la sincronización no elimina las copias en la nube; la eliminación permanente de un activo lo elimina de la sincronización después de la confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza somente quando o interruptor mestre e o próprio interruptor da tela estão ligados. Desativar a sincronização não exclui cópias da nuvem; a exclusão permanente de um ativo o remove da sincronização após a confirmação."
          }
        }
      }
    },
