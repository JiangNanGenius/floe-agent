    "app.bilingual.7a6c20e3aff7592f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工程内容已变化，这个建议不能直接采用。重新读取后再建议。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project changed, so this proposal cannot be used. Inspect again before proposing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工程內容已變化，這個建議不能直接採用。重新讀取後再建議。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトが変更されたため、この提案は使用できません。 提案する前に再度検査してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트가 변경되어 이 제안을 사용할 수 없습니다. 제안하기 전에 다시 한 번 점검하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet a changé, donc cette proposition ne peut pas être utilisée. Inspectez à nouveau avant de proposer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt hat sich geändert, so dass dieser Vorschlag nicht verwendet werden kann. Überprüfen Sie erneut, bevor Sie einen Vorschlag machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto cambió, por lo que esta propuesta no se puede utilizar. Inspeccione de nuevo antes de proponer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto mudou, então esta proposta não pode ser usada. Inspecione novamente antes de propor."
          }
        }
      }
    },
    "app.bilingual.65667461ab2a393": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个建议没有识别依据；确认后保存为手动未验证，运行和构建保持关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This suggestion has no recognized evidence; confirming saves it as manual/unverified and keeps play/build closed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個建議沒有識別依據；確認後儲存為手動未驗證，執行和構建保持關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提案には認められた証拠がありません。確認すると、手動/未検証として保存され、プレイ/ビルドが閉じられたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안에는 인정된 증거가 없으며, 확인하면 수동/미검증으로 저장되고 재생/빌드가 닫힌 상태로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette suggestion n'a aucune preuve reconnue ; la confirmation l'enregistre comme manuelle/non vérifiée et garde le jeu/la construction fermé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vorschlag hat keine anerkannten Beweise; die Bestätigung speichert ihn als manuell/unverifiziert und hält Play/Build geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sugerencia no tiene evidencia reconocida; la confirmación la guarda como manual/no verificada y mantiene la reproducción/compilación cerrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sugestão não tem evidências reconhecidas; a confirmação a salva como manual/não verificada e mantém a reprodução/construção fechada."
          }
        }
      }
    },
