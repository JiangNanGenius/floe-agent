          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf ein flaches Gesicht – nur planare Gesichter können hier erneut ausgewählt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
