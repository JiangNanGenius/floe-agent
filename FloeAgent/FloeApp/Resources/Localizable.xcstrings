    "settings.feedback_upload_service.feedback_requests_are_too_frequent_try": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback requests are too frequent; try again in %@ seconds. The report was saved on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈服务请求过于频繁，请在 %@ 秒后重试。报告已保存在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反饋服務請求過於頻繁，請在 %@ 秒後重試。報告已儲存在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックのリクエストが頻繁すぎます。%@ 秒後に再度お試しください。 このデバイスにレポートが保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 요청이 너무 빈번합니다; %@초 후에 다시 시도해 주세요. 보고서가 이 장치에 저장되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de commentaires sont trop fréquentes ; réessayez dans %@ secondes. Le rapport a été enregistré sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback-Anfragen sind zu häufig; versuchen Sie es in %@ Sekunden erneut. Der Bericht wurde auf diesem Gerät gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de comentarios son demasiado frecuentes; inténtelo de nuevo en %@ segundos. El informe se guardó en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações de feedback são muito frequentes; tente novamente em %@ segundos. O relatório foi salvo neste dispositivo."
          }
        }
      }
    },
    "settings.feedback_upload_service.feedback_requests_are_too_frequent_try_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback requests are too frequent; try again later. The report was saved on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反馈服务请求过于频繁，请稍后重试。报告已保存在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "反饋服務請求過於頻繁，請稍後重試。報告已儲存在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックのリクエストが頻繁すぎますので、後ほど再度お試しください。 このデバイスにレポートが保存されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 요청이 너무 자주 있습니다; 나중에 다시 시도해 주세요. 보고서가 이 장치에 저장되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes de commentaires sont trop fréquentes ; réessayez plus tard. Le rapport a été enregistré sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feedback-Anfragen sind zu häufig; versuchen Sie es später noch einmal. Der Bericht wurde auf diesem Gerät gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de comentarios son demasiado frecuentes; inténtelo de nuevo más tarde. El informe se guardó en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitações de feedback são muito frequentes; tente novamente mais tarde. O relatório foi salvo neste dispositivo."
          }
        }
      }
    },
