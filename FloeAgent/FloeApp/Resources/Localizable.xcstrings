    "app.bilingual.33b18bd9b0b2fb23": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用后，此坐标系用于当前铣削工序和后续新工序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On apply, this coordinate system is used by current and newly created milling operations."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用後，此座標系用於當前銑削工序和後續新工序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用時に、この座標系は現在および新規に作成されたミリング操作で使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용 시, 이 좌표계는 현재 및 새로 생성된 밀링 작업에 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cas écas, ce système de coordonnées est utilisé par les opérations de fraisage actuelles et nouvellement créées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Anwendung wird dieses Koordinatensystem von aktuellen und neu geschaffenen Fräsbetrieben verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En su caso, este sistema de coordenadas es utilizado por operaciones de fresado actuales y recién creadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplicável, este sistema de coordenadas é usado por operações de fresagem atuais e recém-criadas."
          }
        }
      }
    },
