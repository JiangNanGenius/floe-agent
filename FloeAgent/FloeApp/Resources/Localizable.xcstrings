    "providers.no_models": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No models yet. Test the connection to discover models, or add one manually."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无模型。测试连接以发现模型，或手动添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無模型。測試連線以發現模型，或手動新增。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだモデルはありません。 接続をテストしてモデルを検出するか、手動で追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 모델이 없습니다. 연결을 테스트하여 모델을 발견하거나, 직접 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de modèles. Testez la connexion pour découvrir les modèles ou ajoutez-en un manuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Modelle. Testen Sie die Verbindung, um Modelle zu entdecken, oder fügen Sie eine manuell hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay modelos. Pruebe la conexión para descubrir modelos o agregue uno manualmente."
          }
