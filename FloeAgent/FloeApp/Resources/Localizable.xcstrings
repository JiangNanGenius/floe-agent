    "app.bilingual.9003450d68159fcd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前文件会保留在历史中；不会改写 Git 或原始导入包。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current files remain in history; Git and the imported archive are unchanged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前檔案會保留在歷史中；不會改寫 Git 或原始匯入包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のファイルは履歴に残ります；Git とインポートされたアーカイブは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 파일은 기록에 남아 있으며, Git 및 가져온 아카이브는 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers actuels restent dans l'historique ; Git et l'archive importée sont inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Dateien bleiben in der Geschichte; Git und das importierte Archiv sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos actuales permanecen en el historial; Git y el archivo importado no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos atuais permanecem no histórico; Git e o arquivo importado permanecem inalterados."
          }
        }
      }
    },
    "app.bilingual.27331f05f45c7b6e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工程键位声明无法识别，当前使用引擎默认键位。"
