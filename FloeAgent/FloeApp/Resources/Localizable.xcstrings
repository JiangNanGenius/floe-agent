          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le canevas pour ajouter des sommets, puis fermez la sélection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Leinwand, um Eckpunkte hinzuzufügen, und schließen Sie dann die Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
