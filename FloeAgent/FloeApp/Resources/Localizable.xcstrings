    "chat.thread_detail_view_model.the_sync_service_is_temporarily_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync service is temporarily unavailable; data on this device still works and retries happen automatically later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步服务暂时不可用，本机数据仍可继续使用。稍后会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步服務暫時不可用，本機資料仍可繼續使用。稍後會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期サービスは一時的に利用できません；このデバイスのデータは引き続き動作し、再試行は後で自動的に行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 서비스가 일시적으로 이용할 수 없으며, 이 장치의 데이터는 여전히 작동하고 재시도는 나중에 자동으로 이루어집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de synchronisation est temporairement indisponible ; les données de cet appareil fonctionnent toujours et les nouvelles tentatives se produisent automatiquement plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Synchronisierungsdienst ist vorübergehend nicht verfügbar; Daten auf diesem Gerät funktionieren weiterhin und Wiederholungen erfolgen später automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de sincronización no está disponible temporalmente; los datos de este dispositivo siguen funcionando y los reintentos se realizan automáticamente más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de sincronização está temporariamente indisponível; os dados neste dispositivo ainda funcionam e as novas tentativas acontecem automaticamente mais tarde."
          }
        }
      }
    },
