            "value": "After importing or downloading once, Word, PDF and all workspaces can reuse it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入或下载一次后，Word、PDF 和所有工作区都可复用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入或下載一次後，Word、PDF 和所有工作區都可複用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度インポートまたはダウンロードすれば、Word、PDF、およびすべてのワークスペースで再利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 가져오거나 다운로드한 후에는 Word, PDF 및 모든 작업 공간이 이를 재사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir importé ou téléchargé une fois, Word, PDF et tous les espaces de travail peuvent le réutiliser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem einmaligen Importieren oder Herunterladen können Word, PDF und alle Arbeitsbereiche es wiederverwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de importar o descargar una vez, Word, PDF y todos los espacios de trabajo pueden reutilizarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de importar ou baixar uma vez, o Word, PDF e todos os espaços de trabalho podem reutilizá-lo."
          }
        }
      }
    },
