    "settings.git_hub_settings_view.sign_in_credentials_are_kept_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in credentials are kept only in this device's Keychain. Floe never writes tokens into repositories, remote addresses, logs or model context."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录凭据只保存在本机钥匙串。Floe 不会把令牌写入仓库、远程地址、日志或模型上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入憑據只儲存在本機鑰匙串。Floe 不會把令牌寫入倉庫、遠端地址、日誌或模型上下文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインの認証情報は、このデバイスのキーチェーンにのみ保持されます。 Floe は、トークンをリポジトリ、リモートアドレス、ログ、またはモデルコンテキストに書き込むことは決してありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인 자격 증명은 이 기기의 키체인에만 보관됩니다. Floe는 토큰을 저장소, 원격 주소, 로그 또는 모델 컨텍스트에 절대 쓰지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de connexion ne sont conservés que dans le trousseau de cet appareil. Floe n'écrit jamais de jetons dans des référentiels, des adresses distantes, des journaux ou un contexte de modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldedaten werden nur im Schlüsselbund dieses Geräts gespeichert. Floe schreibt niemals Token in Repositories, Remote-Adressen, Protokolle oder Modellkontext."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales de inicio de sesión se guardan solo en el llavero de este dispositivo. Floe nunca escribe tokens en repositorios, direcciones remotas, registros o contexto de modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais de login são mantidas apenas nas Chaves deste dispositivo. Floe nunca grava tokens em repositórios, endereços remotos, registros ou contexto de modelo."
          }
        }
      }
    },
