    "app.bilingual.c84ceb455e2bc607": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络挂载文件仅供只读预览，本版本不支持写回原文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network mount files are preview-only here; writing back is not supported in this version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路掛載檔案僅供只讀預覽，本版本不支援寫回原檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークマウントファイルはここではプレビューのみです。このバージョンでは書き戻しはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 마운트 파일은 여기에서 미리 보기 전용이며, 이 버전에서는 쓰기가 지원되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de montage réseau ne sont que des prévisualisations ici ; la réécriture n'est pas prise en charge dans cette version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk-Mount-Dateien sind hier nur in der Vorschau; das Zurückschreiben wird in dieser Version nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de montaje en red son solo para vista previa aquí; la escritura no es compatible con esta versión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de montagem de rede são apenas para visualização aqui; a gravação de volta não é suportada nesta versão."
          }
        }
      }
    },
    "app.bilingual.af9be7fd21b9ae47": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片格式暂不支持编辑（支持 PNG、JPEG、HEIC）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image format can't be edited yet (PNG, JPEG and HEIC are supported)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片格式暫不支援編輯（支援 PNG、JPEG、HEIC）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像形式はまだ編集できません（PNG、JPEG、HEICがサポートされています）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지 형식은 아직 편집할 수 없습니다 (PNG, JPEG 및 HEIC가 지원됩니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format d'image ne peut pas encore être modifié (PNG, JPEG et HEIC sont pris en charge)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bildformat kann noch nicht bearbeitet werden (PNG, JPEG und HEIC werden unterstützt)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de imagen aún no se puede editar (PNG, JPEG y HEIC son compatibles)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de imagem ainda não pode ser editado (PNG, JPEG e HEIC são suportados)."
          }
        }
      }
    },
    "app.bilingual.f399f86e30cd55cd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件在当前位置不可写，请先调整权限或复制到可写位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is not writable in its current location; adjust permissions or copy it somewhere writable first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該檔案在當前位置不可寫，請先調整許可權或複製到可寫位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは現在の場所では書き込みできません。権限を調整するか、まず書き込み可能な場所にコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 현재 위치에서 쓰기가 불가능합니다; 권한을 조정하거나 먼저 쓰기 가능한 곳에 복사하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'est pas inscrible à son emplacement actuel ; ajustez les autorisations ou copiez-le d'abord dans un endroit inscrible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist an ihrem aktuellen Speicherort nicht schreibbar; passen Sie die Berechtigungen an oder kopieren Sie sie zuerst an einen schreibenden Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede escritar en su ubicación actual; ajuste los permisos o cópielo en algún lugar que se puede escrear primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não é escritável em sua localização atual; ajuste as permissões ou copie-o para algum lugar que pode ser ser escritos primeiro."
          }
        }
      }
    },
    "app.file_preview_view.the_edited_image_exceeds_the": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑后的图片超过工作区单次写入上限（%@ MiB），请先压缩原图再编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edited image exceeds the workspace write limit (%@ MiB); compress the original before editing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯後的圖片超過工作區單次寫入上限（%@ MiB），請先壓縮原圖再編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集された画像がワークスペースの書き込み上限（%@ MiB）を超えています。編集する前に元の画像を圧縮してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집된 이미지가 작업 공간 쓰기 제한(%@ MiB)을 초과했습니다; 편집하기 전에 원본을 압축하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image modifiée dépasse la limite d'écriture de l'espace de travail (%@ MiB) ; compressez l'original avant l'édition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das bearbeitete Bild überschreitet das Schreiblimit des Arbeitsbereichs (%@ MiB); komprimieren Sie das Original vor dem Bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen editada excede el límite de escritura del espacio de trabajo (%@ MiB); comprima el original antes de editarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem editada excede o limite de gravação do espaço de trabalho (%@ MiB); comprima o original antes de editar."
          }
        }
      }
    },
