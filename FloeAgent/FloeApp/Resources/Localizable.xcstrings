    "chat.thread_detail_view_model.steps_acceptance_evidence_or_checklist_items": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps, acceptance evidence or checklist items remain, so Goal will not finish early"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有步骤、验收证据或检查项未完成，Goal 不会提前结束"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "仍有步驟、驗收證據或檢查項未完成，Goal 不會提前結束"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ、受諾証拠、またはチェックリスト項目が残っているため、目標は早期に完了しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계, 수락 증거 또는 체크리스트 항목이 남아 있어 목표가 조기에 완료되지 않을 것입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes, les preuves d'acceptation ou les éléments de liste de contrôle restent, de sorte que l'objectif ne se terminera pas tôt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schritte, Annahmebeweise oder Checklistenelemente bleiben bestehen, so dass das Ziel nicht vorzeitig endet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos, la evidencia de aceptación o los elementos de la lista de verificación permanecen, por lo que el objetivo no terminará antes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Etapas, evidências de aceitação ou itens da lista de verificação permanecem, portanto, a Meta não terminará mais cedo"
          }
        }
      }
    },
    "chat.thread_detail_view_model.task_failed_you_can_continue_from": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Task failed; you can continue from the checkpoint"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务失败，可从检查点继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務失敗，可從檢查點繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクに失敗しました。チェックポイントから続行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 실패했습니다; 체크포인트에서 계속 진행할 수 있습니다."
          }
        },
        "fr": {
