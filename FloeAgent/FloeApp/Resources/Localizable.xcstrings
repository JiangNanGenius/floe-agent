    "portforward.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each rule publishes one Linux TCP port to this device. The iPad port can be fixed or assigned automatically (49152–65535); at most %1$lld rules per environment. The default bind address is %2$@ (reachable on your local network). Floe does not set up UPnP/NAT mapping and shows no public address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条规则把 Linux 的一个 TCP 端口发布到本机；iPad 端口可固定或自动分配（49152–65535），每个环境最多 %1$lld 条。默认绑定 %2$@（同一局域网可访问）。应用不做 UPnP/NAT 映射，也不显示公网地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每條規則把 Linux 的一個 TCP 埠釋出到本機；iPad 埠可固定或自動分配（49152–65535），每個環境最多 %1$lld 條。預設繫結 %2$@（同一區域網可訪問）。應用不做 UPnP/NAT 對映，也不顯示公網地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ルールは、このデバイスに Linux TCP ポートを 1 つ公開します。 iPad ポートは自動的に固定または割り当てることができます（49152–65535）；環境ごとに最大 %1$lld ルールです。 デフォルトのバインドアドレスは %2$@ です（ローカルネットワークで到達可能です）。 Floe は UPnP/NAT マッピングを設定せず、公開アドレスも表示しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 규칙은 이 장치에 Linux TCP 포트 하나를 배포합니다. iPad 포트는 고정되거나 자동으로 할당될 수 있습니다 (49152–65535); 최대 %1$lld 규칙은 환경당 적용됩니다. 기본 바인드 주소는 %2$@이며, 로컬 네트워크에서 접근 가능합니다. Floe는 UPnP/NAT 매핑을 설정하지 않으며 공개 주소를 표시하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque règle publie un port Linux TCP sur cet appareil. Le port iPad peut être fixé ou attribué automatiquement (49152–65535) ; au plus %1$lld règles par environnement. L'adresse de liaison par défaut est %2$@ (accessible sur votre réseau local). Floe ne met pas en place le mappage UPnP/NAT et n'affiche aucune adresse publique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Regel veröffentlicht einen Linux TCP-Port zu diesem Gerät. Der iPad-Port kann repariert oder automatisch zugewiesen werden (49152–65535); höchstens %1$lld-Regeln pro Umgebung. Die Standard-Bindungsadresse ist %2$@ (erreichbar in Ihrem lokalen Netzwerk). Floe richtet keine UPnP/NAT-Zuordnung ein und zeigt keine öffentliche Adresse an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada regla publica un puerto Linux TCP en este dispositivo. El puerto iPad se puede fijar o asignar automáticamente (49152–65535); como máximo, las reglas %1$lld por entorno. La dirección de enlace predeterminada es %2$@ (alcanzable en su red local). Floe no configura la asignación UPnP/NAT y no muestra ninguna dirección pública."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada regra publica uma porta Linux TCP para este dispositivo. A porta iPad pode ser fixa ou atribuída automaticamente (49152–65535); no máximo as regras %1$lld por ambiente. O endereço de vinculação padrão é %2$@ (acessível em sua rede local). Floe não configura o mapeamento UPnP/NAT e não mostra endereço público."
          }
        }
      }
    },
    "portforward.guest_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux port must be a whole number from 1 to 65535."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 端口必须是 1–65535 的整数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 埠必須是 1–65535 的整數。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ポートは 1 から 65535 までの整数でなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 포트는 1부터 65535까지의 정수여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port Linux doit être un nombre entier de 1 à 65535."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Linux-Port muss eine ganze Zahl von 1 bis 65535 sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto Linux debe ser un número entero del 1 al 65535."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta Linux deve ser um número inteiro de 1 a 65535."
          }
        }
      }
