    "notes.notes_document_editor.located_on_page_this_match_comes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Located on page %@; this match comes from the page text layer and cannot show an exact highlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已定位到第 %@ 页；该匹配来自页面文本层，无法显示精确高亮。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已定位到第 %@ 頁；該匹配來自頁面文字層，無法顯示精確高亮。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページ %@ にあります。このマッチはページのテキストレイヤーから来ており、正確なハイライトを表示できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지 %@에 위치합니다; 이 매치는 페이지 텍스트 레이어에서 온 것이며 정확한 하이라이트를 표시할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Situé sur la page %@ ; cette correspondance provient de la couche de texte de la page et ne peut pas afficher un surlignage exact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befindet sich auf Seite %@; diese Übereinstimmung stammt aus der Seitentextebene und kann kein genaues Highlight anzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicado en la página %@; esta coincidencia proviene de la capa de texto de la página y no puede mostrar un resaltado exacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Localizado na página %@; esta correspondência vem da camada de texto da página e não pode mostrar um destaque exato."
          }
        }
      }
    },
