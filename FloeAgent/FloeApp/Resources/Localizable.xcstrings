    "app.bilingual.c1ae8249b999b78d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手还在处理这份文档。离开后要如何继续？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant is still working on this document. What should happen when you leave?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助手還在處理這份文件。離開後要如何繼續？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントはまだこの文書に取り組んでいます。 退去時に何が起こるべきですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조자는 아직 이 문서를 작업하고 있습니다. 떠날 때 어떤 일이 일어나야 합니까?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant travaille toujours sur ce document. Que devrait-il se passer lorsque vous partez ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Assistent arbeitet noch an diesem Dokument. Was sollte passieren, wenn du gehst?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente todavía está trabajando en este documento. ¿Qué debería pasar cuando te vayas?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O assistente ainda está trabalhando neste documento. O que deve acontecer quando você sair?"
          }
        }
      }
    },
