    "settings.permissions.full_control.info": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full control requires Face ID or passcode plus a risk acknowledgement, and applies per host for a limited window."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全控制需要 Face ID 或密码并加以风险确认，且按主机在有限时间窗内生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全控制需要 Face ID 或密碼並加以風險確認，且按主機在有限時間窗內生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルコントロールにはFace IDまたはパスコードとリスク認識が必要であり、ホストごとに限定されたウィンドウに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 제어는 Face ID 또는 비밀번호와 위험 인식을 필요로 하며, 제한된 기간 동안 호스트당 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle total nécessite un Face ID ou un code d'accès ainsi qu'une reconnaissance de risque, et s'applique par hôte pour une fenêtre limitée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Kontrolle erfordert Face ID oder Passcode sowie eine Risikobestätigung und gilt pro Gastgeber für ein begrenztes Fenster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control total requiere Face ID o código de acceso más un reconocimiento de riesgo, y se aplica por host para una ventana limitada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O controle total requer Face ID ou senha, além de um reconhecimento de risco, e se aplica por host para uma janela limitada."
          }
        }
      }
    },
