    "design.owner.creative_awaiting.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested output type: %@. No candidate can be proposed until the first real result is generated and bound."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求的输出类型：%@。在首个真实结果生成并绑定之前，暂不能提出候选。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求的輸出型別：%@。在首個真實結果生成並繫結之前，暫不能提出候選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求された出力タイプ: %@. 最初の実際の結果が生成され、バインドされるまで、候補者を提案することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청된 출력 유형: %@. 첫 번째 실제 결과가 생성되고 바인딩될 때까지 후보를 제안할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Type de sortie demandé : %@. Aucun candidat ne peut être proposé tant que le premier résultat réel n'est pas généré et lié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angeforderter Ausgabetyp: %@. Kein Kandidat kann vorgeschlagen werden, bis das erste echte Ergebnis generiert und gebunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de salida solicitado: %@. No se puede proponer un candidato hasta que se genere y se vincule el primer resultado real."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de saída solicitado: %@. Nenhum candidato pode ser proposto até que o primeiro resultado real seja gerado e vinculado."
          }
        }
      }
    },
    "design.owner.creative_bind_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No existing asset of this type yet. Generate the first result with the existing media tools, then return here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "素材库中暂无此类型的已有资源。请先用现有媒体工具生成首个结果，然后回到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "素材庫中暫無此型別的已有資源。請先用現有媒體工具生成首個結果，然後回到這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタイプの既存の資産はまだありません。 既存のメディアツールで最初の結果を生成し、ここに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 이 유형의 기존 자산이 없습니다. 기존 미디어 도구를 사용하여 첫 번째 결과를 생성한 후 여기로 돌아오십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun actif existant de ce type n'est encore. Générez le premier résultat avec les outils multimédias existants, puis revenez ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein vorhandener Vermögenswert dieser Art. Generieren Sie das erste Ergebnis mit den vorhandenen Medientools und kehren Sie dann hierher zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay activos existentes de este tipo. Genere el primer resultado con las herramientas de medios existentes, luego regrese aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ativo existente desse tipo ainda. Gere o primeiro resultado com as ferramentas de mídia existentes e, em seguida, retorne aqui."
          }
        }
      }
    },
    "design.owner.creative_bind_hint": {
      "extractionState": "manual",
      "localizations": {
