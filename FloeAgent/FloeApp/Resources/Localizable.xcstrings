            "value": "이 편집 프로젝트에는 현재 작업대에서 지원되지 않는 작업이 포함되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet d'édition contient des opérations non prises en charge par l'établi actuel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bearbeitungsprojekt enthält Vorgänge, die von der aktuellen Werkbank nicht unterstützt werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto de edición contiene operaciones no soportadas por el banco de trabajo actual"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este projeto de edição contém operações não suportadas pela bancada de trabalho atual"
          }
        }
      }
    },
    "media.media_editor_view.times_follow_the_original_asset_inside": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times follow the original asset; inside the editor you can adjust subtitle text, position and size. Trimming and speed changes remap subtitle times."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间以原素材为准；进入编辑器后可调整字幕文字、位置和大小。裁剪和变速会重新映射字幕时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "時間以原素材為準；進入編輯器後可調整字幕文字、位置和大小。裁剪和變速會重新對映字幕時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間は元のアセットに従います。エディタ内では字幕テキスト、位置、サイズを調整できます。 トリミングと速度の変更、字幕の再割り当て時間。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간은 원본 자산을 따르며, 편집기 내에서 자막 텍스트, 위치 및 크기를 조정할 수 있습니다. 트리밍 및 속도 변경은 자막 시간을 재조정합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les temps suivent l'actif original ; à l'intérieur de l'éditeur, vous pouvez ajuster le texte, la position et la taille du sous-titre. Les changements de coupe et de vitesse remappent les temps de sous-titres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten folgen dem ursprünglichen Asset; im Inneren des Editors können Sie den Untertiteltext, die Position und die Größe anpassen. Trimmen und Geschwindigkeitsänderungen ordnen Sie die Untertitelzeiten neu zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos siguen el activo original; dentro del editor puede ajustar el texto, la posición y el tamaño del subtítulo. Los cambios de recorte y velocidad reasignan los tiempos de los subtítulos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os tempos seguem o ativo original; dentro do editor, você pode ajustar o texto, a posição e o tamanho da legenda. As mudanças de corte e velocidade remapeiam os tempos de legenda."
          }
        }
      }
    },
