    "app.bilingual.5fda055d38df8883": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸由轮廓确定。可在画布中重绘轮廓。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The outline sets the size. Redraw it on the canvas to change it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸由輪廓確定。可在畫布中重繪輪廓。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アウトラインはサイズを設定します。 キャンバス上で再描画して変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "윤곽선은 크기를 설정합니다. 캔버스에 다시 그려서 변경하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contour définit la taille. Redessinez-le sur la toile pour la changer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umriss legt die Größe fest. Zeichnen Sie es auf der Leinwand neu, um es zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El esquema establece el tamaño. Vuelve a dibujarlo en el lienzo para cambiarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contorno define o tamanho. Redesenhe-o na tela para alterá-lo."
          }
        }
      }
    },
