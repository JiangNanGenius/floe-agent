    "execution.node_package_manager_policy.put_install_remove_after_the_manager": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put install/remove after the manager name; the install location is determined by the current environment"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将 install/remove 放在管理器名称后；安装位置由当前环境决定"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
