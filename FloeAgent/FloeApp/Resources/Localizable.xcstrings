    "app.bilingual.839857e86ad38f2f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刀具库与工序按本工件保存。工序依列表顺序共用剩余材料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools and operations belong to this workpiece. Operations share the remaining stock in list order."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刀具庫與工序按本工件儲存。工序依列表順序共用剩餘材料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "工具と操作はこの作業部品に属します。 オペレーションは残りの在庫をリスト順に共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구와 작업은 이 작업물에 속합니다. 운영팀은 남은 재고를 목록 순서대로 공유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils et les opérations appartiennent à cette pièce. Les opérations partagent le stock restant dans l'ordre de la liste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkzeuge und Operationen gehören zu diesem Werkstück. Der Betrieb teilt sich den verbleibenden Bestand in der Listenreihenfolge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas y operaciones pertenecen a esta pieza de trabajo. Las operaciones comparten las existencias restantes en el orden de la lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramentas e operações pertencem a esta peça de trabalho. As operações dividem o estoque restante na ordem da lista."
          }
        }
