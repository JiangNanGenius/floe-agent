    "app.bilingual.978cfcd8c2f1f3c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始文件随库保留。不兼容的项目不会被替换成空符号或简化封装。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Original files stay with the library. Unsupported entries won’t be replaced with empty symbols or simplified footprints."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始檔案隨庫保留。不相容的專案不會被替換成空符號或簡化封裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルファイルはライブラリに保管されます。 サポートされていないエントリは、空の記号や簡略化されたフットプリントに置き換えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일은 라이브러리에 보관됩니다. 지원되지 않는 항목은 빈 기호나 간소화된 풋프린트로 교체되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers originaux restent avec la bibliothèque. Les entrées non prises en charge ne seront pas remplacées par des symboles vides ou des empreintes simplifiées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originaldateien bleiben bei der Bibliothek. Nicht unterstützte Einträge werden nicht durch leere Symbole oder vereinfachte Footprints ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos originales se quedan con la biblioteca. Las entradas no compatibles no se reemplazarán con símbolos vacíos o huellas simplificadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos originais permanecem com a biblioteca. Entradas não suportadas não serão substituídas por símbolos vazios ou pegadas simplificadas."
          }
        }
      }
    },
