    "app.bilingual.50f82a79c789caef": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刀具主轴转速由各工序设置；它与 C 轴定位分别保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-tool spindle speed belongs to each operation and is separate from C-axis positioning."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刀具主軸轉速由各工序設定；它與 C 軸定位分別儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブツールスピンドル速度は各操作に属し、C軸位置決めとは別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 툴 스핀들 속도는 각 작업에 속하며 C축 위치 지정과는 별개입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vitesse de la broche de l'outil en direct appartient à chaque opération et est distincte du positionnement de l'axe C."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschwindigkeit der Live-Tool-Spindel gehört zu jedem Betrieb und ist von der Positionierung der C-Achse getrennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La velocidad del husillo de la herramienta en vivo pertenece a cada operación y es independiente del posicionamiento del eje C."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A velocidade do fuso da ferramenta ao vivo pertence a cada operação e é separada do posicionamento do eixo C."
          }
        }
      }
    },
