    "cad.workbench.assembly.noConstraints": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No constraints yet — add fixed, coaxial, planar, distance or angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无约束——可添加固定、同轴、平面对齐、距离或角度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無約束——可新增固定、同軸、平面對齊、距離或角度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ制約はありません — 固定、同軸、平面、距離、または角度を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 제약이 없습니다 — 고정, 동축, 평면, 거리 또는 각도를 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de contraintes - ajoutez fixe, coaxial, planaire, distance ou angle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Einschränkungen - fügen Sie fest, koaxial, planar, Entfernung oder Winkel hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay restricciones: agregue fijo, coaxial, plano, distancia o ángulo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem restrições ainda — adicione fixo, coaxial, planar, distância ou ângulo."
          }
        }
      }
    },
