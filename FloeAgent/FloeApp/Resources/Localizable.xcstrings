    "github.auth.workflows.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable this when installing build templates. Existing credentials are unchanged until you sign in again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装构建模板时开启。已有凭据只会在重新登录并授权后更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝構建模板時開啟。已有憑據只會在重新登入並授權後更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドテンプレートをインストールする際にこれを有効にしてください。 既存の認証情報は、再度サインインするまで変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드 템플릿을 설치할 때 이를 활성화하십시오. 기존 자격 증명은 다시 로그인할 때까지 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option lors de l'installation de modèles de construction. Les informations d'identification existantes restent inchangées jusqu'à ce que vous vous reconnectiez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie dies bei der Installation von Build-Vorlagen. Vorhandene Anmeldeinformationen bleiben unverändert, bis Sie sich erneut anmelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite esto al instalar plantillas de compilación. Las credenciales existentes no cambian hasta que vuelva a iniciar sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite isso ao instalar modelos de compilação. As credenciais existentes permanecem inalteradas até que você faça login novamente."
          }
        }
      }
    },
