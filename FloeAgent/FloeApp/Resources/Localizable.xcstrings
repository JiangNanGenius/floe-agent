    "app.bilingual.99f75689cbbd68ad": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，在文件列表删除的内容将永久移除。回收站已有内容仍可恢复或清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, deleting from the file list removes items permanently. Existing items in Trash can still be restored or removed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，在檔案列表刪除的內容將永久移除。回收站已有內容仍可恢復或清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、ファイルリストから削除すると項目が永久に削除されます。 ゴミ箱にある既存のアイテムは、引き続き復元または削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼져 있을 때 파일 목록에서 삭제하면 항목이 영구적으로 제거됩니다. 휴지통에 있는 기존 항목은 여전히 복원하거나 제거할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est désactivé, la suppression de la liste des fichiers supprime définitivement les éléments. Les éléments existants dans la corbeille peuvent toujours être restaurés ou supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Löschen aus der Dateiliste ausgeschaltet ist, werden Elemente dauerhaft entfernt. Vorhandene Elemente im Papierkorb können weiterhin wiederhergestellt oder entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, la eliminación de la lista de archivos elimina elementos de forma permanente. Los artículos existentes en la papelera aún se pueden restaurar o eliminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desligado, excluir da lista de arquivos remove itens permanentemente. Os itens existentes no Lixo ainda podem ser restaurados ou removidos."
          }
        }
      }
    },
