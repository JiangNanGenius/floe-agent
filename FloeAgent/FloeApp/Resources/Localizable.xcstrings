    "app.bilingual.30bd0d4ea5ce0ccd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份交互内容已失效。请回到原对话重新载入，或请助手重新生成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This interactive content has expired. Return to its conversation and reload it, or ask the assistant to generate it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份互動內容已失效。請回到原對話重新載入，或請助手重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインタラクティブコンテンツは期限切れです。 会話に戻って再読み込みするか、アシスタントに再生成を依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화형 콘텐츠는 만료되었습니다. 대화로 돌아가서 다시 로드하거나, 어시스턴트에게 다시 생성해 달라고 요청하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu interactif a expiré. Revenez à sa conversation et rechargez-la, ou demandez à l'assistant de la générer à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser interaktive Inhalt ist abgelaufen. Kehren Sie zu seiner Konversation zurück und laden Sie sie neu, oder bitten Sie den Assistenten, sie erneut zu generieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido interactivo ha caducado. Vuelve a su conversación y vuelve a cargarla, o pídele al asistente que la genere de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conteúdo interativo expirou. Retorne à sua conversa e recarregue-a, ou peça ao assistente para gerá-la novamente."
          }
        }
      }
    },
