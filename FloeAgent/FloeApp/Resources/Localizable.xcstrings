    "app.bilingual.e0b85fdcc680522": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留全部画面，移动边缘可能露出背景。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the whole frame; moving edges may reveal the background."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留全部畫面，移動邊緣可能露出背景。"
