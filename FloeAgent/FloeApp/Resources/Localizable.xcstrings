    "app.bilingual.9deae759f33e4f94": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Office 格式没有已保存 PDF 导出（仅支持 .docx、.xlsx、.pptx）。请导出原始文件或 .floenote。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved PDF export is not available for this Office format (only .docx, .xlsx and .pptx support it). Export the original or a .floenote archive instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Office 格式沒有已儲存 PDF 匯出（僅支援 .docx、.xlsx、.pptx）。請匯出原始檔案或 .floenote。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された PDF エクスポートは、この Office 形式では利用できません（.docx、.xlsx、.pptx のみがサポートしています）。 代わりに、オリジナルまたは .floenote アーカイブをエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Office 형식에서는 저장된 PDF 내보내기를 사용할 수 없습니다(.docx, .xlsx 및 .pptx만 지원합니다). 원본 또는 .floenote 아카이브를 대신 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exportation PDF enregistrée n'est pas disponible pour ce format Office (seuls .docx, .xlsx et .pptx le prennent en charge). Exportez plutôt l'original ou une archive .floenote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeicherter PDF-Export ist für dieses Office-Format nicht verfügbar (nur .docx, .xlsx und .pptx unterstützen ihn). Exportieren Sie stattdessen das Original oder ein .floenote-Archiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una exportación PDF guardada no está disponible para este formato de Office (solo .docx, .xlsx y .pptx lo admiten). En su lugar, exporte el original o un archivo .floenote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma exportação PDF salva não está disponível para este formato do Office (apenas .docx, .xlsx e .pptx o suportam). Em vez disso, exporte o original ou um arquivo .floenote."
          }
        }
      }
    },
    "app.bilingual.1b76dc7e09e0666a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表和页面设置选项仅适用于 .xlsx 工作簿。Word/PowerPoint 只支持最终 PDF 页码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheet and page-setup options apply to .xlsx workbooks only. Word/PowerPoint export supports the final PDF page range only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作表和頁面設定選項僅適用於 .xlsx 工作簿。Word/PowerPoint 只支援最終 PDF 頁碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シートおよびページ設定オプションは、.xlsx ワークブックにのみ適用されます。 Word/PowerPoint のエクスポートは、最終的な PDF ページ範囲のみをサポートしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트 및 페이지 설정 옵션은 .xlsx 워크북에만 적용됩니다. Word/PowerPoint 내보내기는 최종 PDF 페이지 범위만 지원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de configuration de la feuille et de la page ne s'appliquent qu'aux classeurs .xlsx. L'exportation Word/PowerPoint ne prend en charge que la plage finale de pages PDF."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Optionen für die Einrichtung von Blättern und Seiten gelten nur für .xlsx-Arbeitsmappen. Der Word/PowerPoint-Export unterstützt nur den endgültigen PDF-Seitenbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de configuración de hojas y páginas se aplican solo a los libros de trabajo .xlsx. La exportación de Word/PowerPoint solo admite el rango final de páginas PDF."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de configuração de planilha e página se aplicam apenas a pastas de trabalho .xlsx. A exportação do Word/PowerPoint suporta apenas o intervalo final da página PDF."
          }
        }
      }
    },
