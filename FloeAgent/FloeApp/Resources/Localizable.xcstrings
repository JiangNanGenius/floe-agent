    "workspace.i_d_e_native_text_workspace.buffers_are_open_and_all_have": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ buffers are open and all have unsaved changes, so “%@” cannot be opened. Save them all or close one buffer first; current drafts were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 %@ 个缓冲区且全部有未保存的修改，无法打开「%@」。请先保存全部或关闭一个缓冲区；当前草稿均已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟 %@ 個緩衝區且全部有未儲存的修改，無法開啟「%@」。請先儲存全部或關閉一個緩衝區；當前草稿均已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ バッファは開いており、すべて未保存の変更があるため、“%@” を開くことはできません。 すべてを保存するか、まずバッファを1つ閉じてください；現在のドラフトは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 버퍼가 열려 있으며 모두 저장되지 않은 변경 사항이 있기 때문에 “%@”를 열 수 없습니다. 모두 저장하거나 먼저 하나의 버퍼를 닫으세요; 현재 초안은 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tampons %@ sont ouverts et ont tous des modifications non enregistrées, donc \"%@\" ne peut pas être ouvert. Enregistrez-les tous ou fermez d'abord un tampon ; les brouillons actuels ont été conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Puffer sind offen und alle haben nicht gespeicherte Änderungen, so dass \"%@\" nicht geöffnet werden kann. Speichern Sie sie alle oder schließen Sie zuerst einen Puffer; aktuelle Entwürfe wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los búferes %@ están abiertos y todos tienen cambios no guardados, por lo que \"%@\" no se puede abrir. Guárdalos todos o cierra un búfer primero; los borradores actuales se mantuvieron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os buffers %@ estão abertos e todos têm alterações não salvas, portanto “%@” não pode ser aberto. Salve todos eles ou feche um buffer primeiro; os rascunhos atuais foram mantidos."
          }
        }
      }
    },
    "workspace.i_d_e_native_text_workspace.buffers_are_open_and_all_have.one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ buffer is open with unsaved changes, so “%@” cannot be opened. Save it or close the buffer first; current drafts were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开 %@ 个缓冲区且全部有未保存的修改，无法打开「%@」。请先保存全部或关闭一个缓冲区；当前草稿均已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開啟 %@ 個緩衝區且全部有未儲存的修改，無法開啟「%@」。請先儲存全部或關閉一個緩衝區；當前草稿均已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ バッファは未保存の変更で開いているため、「%@」を開くことができません。 保存するか、まずバッファを閉じてください；現在のドラフトは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 버퍼가 저장되지 않은 변경 사항과 함께 열려 있어 “%@”를 열 수 없습니다. 먼저 저장하거나 버퍼를 닫아 주세요; 현재 초안은 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tampon %@ est ouvert avec des modifications non enregistrées, donc \"%@\" ne peut pas être ouvert. Enregistrez-le ou fermez d'abord le tampon ; les brouillons actuels ont été conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der %@-Puffer ist mit nicht gespeicherten Änderungen geöffnet, daher kann \"%@\" nicht geöffnet werden. Speichern Sie es oder schließen Sie zuerst den Puffer; die aktuellen Entwürfe wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El búfer %@ está abierto con cambios no guardados, por lo que \"%@\" no se puede abrir. Guárdelo o cierre el búfer primero; se conservaron los borradores actuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O buffer %@ está aberto com alterações não salvas, então “%@” não pode ser aberto. Salve-o ou feche o buffer primeiro; os rascunhos atuais foram mantidos."
          }
        }
      }
    },
