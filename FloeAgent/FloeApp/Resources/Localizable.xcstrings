        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas rutas se omiten de esta vista; la exportación conserva el resultado completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns caminhos são omitidos desta visualização; a exportação mantém o resultado completo."
