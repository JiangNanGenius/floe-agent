    "cad.versions.compare.unsavedNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This comparison uses the last committed document. Unsaved edits are not included; save or create a version to compare them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此比较使用上次提交的文档，不包含未保存的编辑；请先保存或创建版本再比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此比較使用上次提交的文件，不包含未儲存的編輯；請先儲存或建立版本再比較。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この比較は、最後にコミットされた文書を使用しています。 保存されていない編集は含まれません。比較するために保存するか、バージョンを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 비교는 마지막으로 커밋된 문서를 사용합니다. 저장되지 않은 편집은 포함되지 않으며, 저장하거나 버전을 생성하여 비교하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette comparaison utilise le dernier document engagé. Les modifications non enregistrées ne sont pas incluses ; enregistrez ou créez une version pour les comparer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Vergleich verwendet das zuletzt festgelegte Dokument. Nicht gespeicherte Bearbeitungen sind nicht enthalten; speichern oder erstellen Sie eine Version, um sie zu vergleichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comparación utiliza el último documento comprometido. Las ediciones no guardadas no están incluidas; guarde o cree una versión para compararlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comparação usa o último documento comprometido. Edições não salvas não estão incluídas; salve ou crie uma versão para compará-las."
          }
        }
      }
    },
