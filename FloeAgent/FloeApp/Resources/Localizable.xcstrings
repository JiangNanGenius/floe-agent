    "app.bilingual.2d2a4c2597ab3b14": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 6 个标签页。关闭最后一个标签页会留下空白页。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up to 6 tabs. Closing the last tab leaves a blank tab."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最多 6 個標籤頁。關閉最後一個標籤頁會留下空白頁。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大で6タブまで。 最後のタブを閉じると、空白のタブが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 6개의 탭. 마지막 탭을 닫으면 빈 탭이 남습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à 6 onglets. La fermeture du dernier onglet laisse un onglet vide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis zu 6 Registerkarten. Beim Schließen der letzten Registerkarte bleibt eine leere Registerkarte übrig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta 6 pestañas. Al cerrar la última pestaña, deja una pestaña en blanco."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até 6 guias. Fechar a última guia deixa uma guia em branco."
          }
        }
      }
    },
