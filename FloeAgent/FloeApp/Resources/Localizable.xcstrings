    "connectors.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectors provide tools as needed for a task. Models, Apple permissions and SSH/VNC hosts remain in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接器按任务需要提供工具。模型、Apple 权限和 SSH/VNC 主机仍在设置中管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯結器按任務需要提供工具。模型、Apple 許可權和 SSH/VNC 主機仍在設定中管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コネクタは、タスクに必要なツールを提供します。 モデル、Apple の権限、および SSH/VNC ホストは設定に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커넥터는 작업에 필요한 도구를 제공합니다. 모델, Apple 권한 및 SSH/VNC 호스트는 설정에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connecteurs fournissent des outils nécessaires pour une tâche. Les modèles, les autorisations Apple et les hôtes SSH/VNC restent dans les paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectors stellen Werkzeuge bereit, die für eine Aufgabe benötigt werden. Modelle, Apple-Berechtigungen und SSH/VNC-Hosts bleiben in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conectores proporcionan herramientas según sea necesario para una tarea. Los modelos, los permisos de Apple y los hosts SSH/VNC permanecen en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os conectores fornecem ferramentas conforme necessário para uma tarefa. Modelos, permissões da Apple e hosts SSH/VNC permanecem em Configurações."
          }
        }
      }
    },
