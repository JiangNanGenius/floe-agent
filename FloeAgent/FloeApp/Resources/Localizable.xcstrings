    "app.bilingual.26bac87401aa168a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读预览不会修改原文件；缺失或未支持的资源不会被自动下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The read-only preview never changes the original file; missing or unsupported resources are never fetched automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀預覽不會修改原檔案；缺失或未支援的資源不會被自動下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取り専用プレビューは元のファイルを決して変更せず、欠落またはサポートされていないリソースは自動的に取得されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽기 전용 미리보기는 원본 파일을 절대 변경하지 않으며, 누락되었거나 지원되지 않는 리소스는 자동으로 가져오지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu en lecture seule ne modifie jamais le fichier d'origine ; les ressources manquantes ou non prises en charge ne sont jamais récupérées automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die schreibgeschützte Vorschau ändert nie die Originaldatei; fehlende oder nicht unterstützte Ressourcen werden nie automatisch abgerufen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de solo lectura nunca cambia el archivo original; los recursos que faltan o no son compatibles nunca se caparan automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização somente leitura nunca altera o arquivo original; recursos ausentes ou não suportados nunca são buscados automaticamente."
          }
        }
      }
    },
