          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfang: sichtbarer Inhalt im aktuellen Ansichtsfenster; Screenshots sind der primäre Beweis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance: contenido visible en la ventana gráfica actual; las capturas de pantalla son la evidencia principal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
