    "memory.memory_view.this_also_deletes_the_selected_long": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also deletes the selected long-term memories and cannot be automatically restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该操作会同步删除所选长期记忆，无法自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該操作會同步刪除所選長期記憶，無法自動恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、選択された長期記憶も削除され、自動的に復元することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 또한 선택된 장기 기억을 삭제하며 자동으로 복원할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime également les mémoires à long terme sélectionnées et ne peut pas être restauré automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden auch die ausgewählten Langzeitspeicher gelöscht und kann nicht automatisch wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto también elimina los recuerdos a largo plazo seleccionados y no se puede restaurar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso também exclui as memórias de longo prazo selecionadas e não pode ser restaurado automaticamente."
          }
        }
      }
    },
