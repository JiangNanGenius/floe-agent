    "notes.mind_map_topic_inspector.attachments_are_saved_with_the_mind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments are saved with the mind map long term. Removing an attachment can be undone after saving; web links open in the system browser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件随导图长期保存。移除附件可在保存后撤销；网页链接在系统浏览器中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件隨導圖長期儲存。移除附件可在儲存後撤銷；網頁連結在系統瀏覽器中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルはマインドマップで長期保存されます。 添付ファイルの削除は、保存後に元に戻すことができます；ウェブリンクはシステムブラウザで開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일은 장기적으로 마인드맵과 함께 저장됩니다. 첨부 파일을 삭제하면 저장 후 되돌릴 수 있으며, 웹 링크는 시스템 브라우저에서 열립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes sont enregistrées avec la carte mentale à long terme. La suppression d'une pièce jointe peut être annulée après l'enregistrement ; les liens Web s'ouvrent dans le navigateur système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge werden mit der Mind Map langfristig gespeichert. Das Entfernen eines Anhangs kann nach dem Speichern rückgängig gemacht werden; Weblinks werden im Systembrowser geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos adjuntos se guardan con el mapa mental a largo plazo. La eliminación de un archivo adjunto se puede deshacer después de guardar; los enlaces web se abren en el navegador del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anexos são salvos com o mapa mental de longo prazo. A remoção de um anexo pode ser desfeita após o salvamento; links da web abertos no navegador do sistema."
          }
        }
      }
    },
    "notes.mind_map_topic_inspector.could_not_open_the_source_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open the source; check that the material is still available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开来源，请检查资料是否仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟來源，請檢查資料是否仍然可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースを開くことができませんでした。素材がまだ利用可能か確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스를 열 수 없습니다; 자료가 아직 사용 가능한지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir la source ; vérifiez que le matériel est toujours disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle konnte nicht geöffnet werden; überprüfen Sie, ob das Material noch verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la fuente; compruebe que el material todavía está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir a fonte; verifique se o material ainda está disponível."
          }
        }
      }
    },
