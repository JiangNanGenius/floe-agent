    "app.bilingual.bd5a006284a045d4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅丢弃本次会话在内存中的修改；已保存的项目版本、原始文件和素材都会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this session's in-memory edits are discarded. Saved project versions, source files and assets are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅丟棄本次會話在記憶體中的修改；已儲存的專案版本、原始檔案和素材都會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションのインメモリ編集のみが破棄されます。 保存されたプロジェクトのバージョン、ソースファイル、およびアセットは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션의 메모리 내 편집만 폐기됩니다. 저장된 프로젝트 버전, 소스 파일 및 자산이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les modifications en mémoire de cette session sont rejetées. Les versions de projet enregistrées, les fichiers sources et les ressources sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die In-Memory-Bearbeitungen dieser Sitzung werden verworfen. Gespeicherte Projektversionen, Quelldateien und Assets bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se descartan las ediciones en memoria de esta sesión. Se conservan las versiones guardadas del proyecto, los archivos fuente y los activos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as edições na memória desta sessão são descartadas. Versões salvas do projeto, arquivos de origem e ativos são mantidos."
          }
        }
      }
    },
