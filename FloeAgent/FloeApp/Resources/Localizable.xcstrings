    "app.bilingual.3d0d7c1a585161f2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个引擎没有所选输出。选择其他输出或配置引擎工具。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine has no selected output. Choose another output or configure the engine tool."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個引擎沒有所選輸出。選擇其他輸出或配置引擎工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンには選択された出力がありません。 別の出力を選択するか、エンジンツールを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔진에는 선택된 출력이 없습니다. 다른 출력을 선택하거나 엔진 도구를 구성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur n'a pas de sortie sélectionnée. Choisissez une autre sortie ou configurez l'outil moteur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Motor hat keine ausgewählte Leistung. Wählen Sie eine andere Ausgabe oder konfigurieren Sie das Engine-Tool."
          }
        },
        "es": {
