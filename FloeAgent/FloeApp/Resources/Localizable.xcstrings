    "notes.notes_store.the_linked_mind_map_was_moved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked mind map was moved to Trash; restore it or unlink it before exporting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联导图已移入回收站；请恢复或解除关联后再导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
