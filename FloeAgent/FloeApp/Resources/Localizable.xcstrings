    "providers.tool_name_compatibility.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert tool names with dots (e.g. workspace.createFile) to underscores for providers like DeepSeek that enforce ^[a-zA-Z0-9_-]+$."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将带点号的工具名（如 workspace.createFile）转换为下划线格式，用于 DeepSeek 等要求 ^[a-zA-Z0-9_-]+$ 的供应商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將帶點號的工具名（如 workspace.createFile）轉換為下劃線格式，用於 DeepSeek 等要求 ^[a-zA-Z0-9_-]+$ 的供應商。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドットで始まるツール名（例: workspace.createFile）を、DeepSeek のように ^[a-zA-Z0-9_-]+$ を強制するプロバイダー向けにアンダースコアに変換してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek와 같이 ^[a-zA-Z0-9_-]+$를 적용하는 공급업체에 대해 점(예: workspace.createFile)으로 도구 이름을 밑줄로 변환하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez les noms d'outils avec des points (par exemple workspace.createFile) en traits de soulignement pour les fournisseurs comme DeepSeek qui appliquent ^[a-zA-Z0-9_-]+$."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konvertieren Sie Werkzeugnamen mit Punkten (z. B. workspace.createFile) in Unterstriche für Anbieter wie DeepSeek, die ^[a-zA-Z0-9_-]+$ erzwingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierta los nombres de las herramientas con puntos (por ejemplo, workspace.createFile) a guiones bajos para proveedores como DeepSeek que aplican ^[a-zA-Z0-9_-]+$."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converta nomes de ferramentas com pontos (por exemplo, workspace.createFile) em sublinhados para provedores como DeepSeek que aplicam ^[a-zA-Z0-9_-]+$."
          }
        }
      }
    },
    "providers.validation.connection_changed_requires_key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider connection changed. Enter the API key for the new connection; the stored key is not reused across connections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商连接已更改，请重新输入新连接的 API 密钥；已保存的密钥不会跨连接复用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商連線已更改，請重新輸入新連線的 API 金鑰；已儲存的金鑰不會跨連線複用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーの接続が変更されました。 新しい接続のために API キーを入力してください。保存されたキーは接続間で再利用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 연결이 변경되었습니다. 새 연결에 API 키를 입력하십시오; 저장된 키는 연결 간에 재사용되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion du fournisseur a changé. Entrez la clé API pour la nouvelle connexion ; la clé stockée n'est pas réutilisée entre les connexions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anbieterverbindung hat sich geändert. Geben Sie die API-Taste für die neue Verbindung ein; der gespeicherte Schlüssel wird nicht über Verbindungen hinweg wiederverwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión del proveedor cambió. Introduzca la clave API para la nueva conexión; la clave almacenada no se reutiliza en todas las conexiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão do provedor mudou. Digite a chave API para a nova conexão; a chave armazenada não é reutilizada nas conexões."
          }
        }
      }
    },
    "providers.validation.display_name_control": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider name contains an unsupported control character. Remove it and save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商名称包含不支持的控制字符，请删除后重新保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商名稱包含不支援的控制字元，請刪除後重新儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダー名にサポートされていない制御文字が含まれています。 削除して、もう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 이름에 지원되지 않는 제어 문자가 포함되어 있습니다. 제거하고 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du fournisseur contient un caractère de contrôle non pris en charge. Retirez-le et enregistrez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name des Anbieters enthält ein nicht unterstütztes Steuerzeichen. Entfernen Sie es und speichern Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del proveedor contiene un carácter de control no compatible. Retíralo y guárdalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do provedor contém um caractere de controle não suportado. Remova-o e salve novamente."
          }
        }
      }
    },
    "providers.validation.display_name_empty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a provider name or leave it blank to use the default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入服务商名称，或留空使用默认名称"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入服務商名稱，或留空使用預設名稱"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダー名を入力するか、空欄のままにしてデフォルトを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 이름을 입력하거나 비워 두면 기본값을 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un nom de fournisseur ou laissez-le vide pour utiliser la valeur par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Namen eines Anbieters ein oder lassen Sie ihn leer, um den Standardnamen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca el nombre de un proveedor o déjelo en blanco para usar el valor predeterminado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome de provedor ou deixe-o em branco para usar o padrão."
          }
        }
      }
    },
    "providers.validation.display_name_too_long": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Provider name is %2$@ UTF-8 bytes; the maximum is %1$@. Shorten the name and save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务商名称为 %2$@ 个 UTF-8 字节，上限为 %1$@ 字节；请缩短后重新保存"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務商名稱為 %2$@ 個 UTF-8 位元組，上限為 %1$@ 位元組；請縮短後重新儲存"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダー名は %2$@ UTF-8 バイトで、最大は %1$@ です。 名前を短くして、もう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 이름은 %2$@ UTF-8 바이트이며, 최대값은 %1$@입니다. 이름을 단축하고 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom du fournisseur est %2$@ UTF-8 octets ; le maximum est %1$@. Raccourcir le nom et enregistrer à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Name des Anbieters ist %2$@ UTF-8 Bytes; das Maximum ist %1$@. Kürzen Sie den Namen und speichern Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre del proveedor es %2$@ UTF-8 bytes; el máximo es %1$@. Acorta el nombre y guarda de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome do provedor é %2$@ UTF-8 bytes; o máximo é %1$@. Encurte o nome e salve novamente."
          }
        }
      }
    },
