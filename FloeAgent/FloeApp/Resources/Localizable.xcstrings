    "settings.data_management_view.cleanup_checkpoints_reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery state for interrupted tasks; deleting can break recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断任务的恢复状态；删除会破坏恢复能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷任務的恢復狀態；刪除會破壞恢復能力。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断されたタスクの復旧状態です。削除すると復旧が妨げられる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 작업에 대한 복구 상태; 삭제하면 복구가 중단될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de récupération pour les tâches interrompues ; la suppression peut interrompre la récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungszustand für unterbrochene Aufgaben; das Löschen kann die Wiederherstellung unterbrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de recuperación para tareas interrumpidas; la eliminación puede interrumpir la recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de recuperação para tarefas interrompidas; a exclusão pode interromper a recuperação."
          }
        }
      }
    },
    "settings.data_management_view.cleanup_confirm_detail": {
