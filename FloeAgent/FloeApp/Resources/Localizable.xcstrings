    "cad.present.selection.sharedMaterial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared material — changes apply to all instances of this part."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享材质：修改会应用于此零件的所有实例。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享材質：修改會應用於此零件的所有例項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有資料 — 変更はこのパートのすべてのインスタンスに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 자료 — 변경 사항은 이 파트의 모든 인스턴스에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Matériel partagé - les modifications s'appliquent à toutes les instances de cette partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigegebenes Material – Änderungen gelten für alle Instanzen dieses Teils."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Material compartido: los cambios se aplican a todas las instancias de esta parte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Material compartilhado — as alterações se aplicam a todas as instâncias desta parte."
          }
        }
      }
    },
    "cad.sketch.editInterrupted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sketch edit was interrupted. Start the edit again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草图编辑已中断，请重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "草圖編輯已中斷，請重新開始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケッチの編集が中断されました。 編集をもう一度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스케치 편집이 중단되었습니다. 편집을 다시 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'édition du croquis a été interrompue. Recommencer la modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Skizzenbearbeitung wurde unterbrochen. Beginnen Sie die Bearbeitung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición del boceto fue interrumpida. Comienza la edición de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição do esboço foi interrompida. Inicie a edição novamente."
          }
        }
      }
    },
    "cad.sketch.finishCurrentEdit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or cancel the sketch edit first."
          }
        },
        "zh-Hans": {
