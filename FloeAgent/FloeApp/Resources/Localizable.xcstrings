        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하단 원본 이미지에서 캡처 메타데이터를 보관하며, 여기에는 위치가 포함될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve les métadonnées de capture de l'image source du bas, qui peut inclure l'emplacement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält die Erfassung von Metadaten aus dem unteren Quellbild bei, das den Standort enthalten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la captura de metadatos de la imagen de origen inferior, que puede incluir la ubicación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém os metadados de captura da imagem de origem inferior, que pode incluir localização."
          }
        }
      }
    },
