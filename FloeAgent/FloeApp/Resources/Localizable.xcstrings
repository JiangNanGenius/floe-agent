    "cad.workbench.mesh.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sketch and extrude a solid first; mesh operations run on tessellations and keep analytic B-rep bodies intact unless you explicitly force a downgrade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先绘制草图并拉伸实体；网格操作作用于三角网格，除非你明确强制降级，否则解析 B-rep 实体保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先繪製草圖並拉伸實體；網格操作作用於三角網格，除非你明確強制降級，否則解析 B-rep 實體保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、ソリッドをスケッチし、押出ししてください；メッシュ操作はテッセレーション上で実行され、明示的にダウングレードを強制しない限り、解析的なBレプボディはそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 솔리드를 스케치하고 압출하십시오; 메쉬 연산은 테셀레이션에서 실행되며, 명시적으로 다운그레이드를 강제하지 않는 한 분석적 B-레프 몸체를 그대로 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquissez et extrudez d'abord un solide ; les opérations de maillage s'exécutent sur des tessellations et conservent les corps analytiques B-rep intacts à moins que vous ne forciez explicitement une rétrogradation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skizzieren und extrudieren Sie zuerst einen Feststoff; Mesh-Operationen laufen auf Tessellationen und halten analytische B-Rep-Körper intakt, es sei denn, Sie erzwingen explizit ein Downgrade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja y extruye un sólido primero; las operaciones de malla se ejecutan en teselaciones y mantienen intactos los cuerpos analíticos B-rep a menos que force explícitamente una degradación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esboce e extrude um sólido primeiro; as operações de malha são executadas em tesselações e mantêm os corpos analíticos B-rep intactos, a menos que você force explicitamente um downgrade."
          }
        }
      }
    },
