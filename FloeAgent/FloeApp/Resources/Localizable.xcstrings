    "localmodels.remove_message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted model files must be downloaded again. This cannot be undone automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除后需重新下载模型文件，且无法自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除後需重新下載模型檔案，且無法自動恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたモデルファイルは再度ダウンロードする必要があります。 これは自動的に元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 모델 파일은 다시 다운로드해야 합니다. 이것은 자동으로 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de modèle supprimés doivent être téléchargés à nouveau. Cela ne peut pas être défait automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Modelldateien müssen erneut heruntergeladen werden. Dies kann nicht automatisch rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de modelo eliminados deben descargarse de nuevo. Esto no se puede deshacer automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de modelo excluídos devem ser baixados novamente. Isso não pode ser desfeito automaticamente."
          }
        }
      }
    },
