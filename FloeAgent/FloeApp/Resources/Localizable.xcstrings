    "notes.notes_document_editor.restores_strokes_whose_save_did_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores strokes whose save did not finish; can be undone after restoring."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复未完成保存的笔迹；恢复后可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復未完成儲存的筆跡；恢復後可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存が完了しなかったストロークを復元します。復元後に元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장이 완료되지 않은 스트로크를 복원합니다; 복원 후 되돌릴 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure les coups dont l'enregistrement n'est pas terminé ; peut être défait après la restauration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Striche wieder her, deren Speicher nicht abgeschlossen wurde; kann nach der Wiederherstellung rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura los trazos cuyo guardado no terminó; se puede deshacer después de restaurar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura traços cujo salvamento não foi concluído; pode ser desfeito após a restauração."
          }
        }
      }
    },
