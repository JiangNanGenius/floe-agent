        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux is not enabled for this environment. Your existing files are preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此環境尚未啟用 Linux。現有檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxはこの環境では有効になっていません。 既存のファイルは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux는 이 환경에서 활성화되지 않았습니다. 귀하의 기존 파일이 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux n'est pas activé pour cet environnement. Vos fichiers existants sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ist für diese Umgebung nicht aktiviert. Ihre vorhandenen Dateien bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux no está habilitado para este entorno. Sus archivos existentes se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux não está habilitado para este ambiente. Seus arquivos existentes são preservados."
          }
        }
      }
    },
