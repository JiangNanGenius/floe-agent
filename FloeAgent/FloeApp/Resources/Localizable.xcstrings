    "cad.workbench.assembly.partInfoSharedHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every shared instance of this part uses this part number, engineering material and version; an independent copy keeps its own record."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该零件的所有共享实例使用这里的料号、工程材料和版本；独立副本保留自己的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該零件的所有共享例項使用這裡的料號、工程材料和版本；獨立副本保留自己的記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この部品のすべての共有インスタンスは、この部品番号、エンジニアリング材料、およびバージョンを使用します。独立したコピーが独自の記録を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 부품의 모든 공유 인스턴스는 이 부품 번호, 엔지니어링 재료 및 버전을 사용하며, 독립적인 복사본은 자체 기록을 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque instance partagée de cette partie utilise ce numéro de pièce, ce matériel d'ingénierie et cette version ; une copie indépendante conserve son propre enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede gemeinsam genutzte Instanz dieses Teils verwendet diese Teilenummer, dieses technische Material und diese Version; eine unabhängige Kopie führt ihre eigene Aufzeichnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada instancia compartida de esta parte utiliza este número de pieza, material de ingeniería y versión; una copia independiente mantiene su propio registro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada instância compartilhada desta parte usa esse número de peça, material de engenharia e versão; uma cópia independente mantém seu próprio registro."
          }
        }
      }
    },
    "cad.workbench.assembly.partInfoIndependentHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This independent copy has its own part record; changes do not affect the shared source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此独立副本拥有自己的零件记录，修改不会影响共享来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此獨立副本擁有自己的零件記錄，修改不會影響共享來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この独立したコピーには独自のパートレコードがあり、変更は共有ソースに影響を与えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 독립 복사본은 자체 파트 레코드를 가지고 있으며, 변경 사항은 공유 소스에 영향을 미치지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie indépendante a son propre enregistrement de pièces ; les changements n'affectent pas la source partagée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese unabhängige Kopie hat ihren eigenen Teiledatensatz; Änderungen wirken sich nicht auf die gemeinsam genutzte Quelle aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia independiente tiene su propio registro de piezas; los cambios no afectan a la fuente compartida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia independente tem seu próprio registro de peças; as alterações não afetam a fonte compartilhada."
          }
        }
      }
    },
