    "app.bilingual.69179ba751d52cbd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定格期间不播放原声；独立配乐保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source audio is silent during a held frame. Independent music continues."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定格期間不播放原聲；獨立配樂保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースオーディオは、フレームが保持されている間は無音です。 インディペンデント音楽は続いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 오디오가 보류된 프레임 동안 무음입니다. 독립 음악이 계속됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio source est silencieux pendant une image maintenue. La musique indépendante continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Quellton ist während eines gehaltenen Bildes stumm. Unabhängige Musik geht weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio de origen es silencioso durante un fotograma retenido. La música independiente continúa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio de origem é silencioso durante um quadro retido. A música independente continua."
          }
        }
      }
    },
