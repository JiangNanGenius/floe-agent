    },
    "cad.building.error.someBuildingGeometryIsMissingRebuildOr": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some building geometry is missing. Rebuild or review it before export."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分建筑几何缺失，请先重新生成或检查，再导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分建築幾何缺失，請先重新生成或檢查，再匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの建築ジオメトリが欠落しています。 エクスポートする前に、再構築またはレビューしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 건물 기하학이 누락되었습니다. 내보내기 전에 다시 구축하거나 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque une certaine géométrie du bâtiment. Reconstruisez-le ou examinez-le avant l'exportation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Gebäudegeometrien fehlen. Erstellen oder überprüfen Sie es vor dem Export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta algo de geometría de construcción. Reconstrígalo o revíselo antes de exportarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguma geometria de construção está faltando. Reconstrua ou revise antes de exportar."
          }
        }
      }
    },
    "cad.building.error.thisStudyIsLimitedTo500000": {
