    "execution.environment_language_package_service.the_linux_environment_is_not_running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux environment is not running; start it before installing Node dependencies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境未运行；请先启动该环境再安装 Node 依赖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境未執行；請先啟動該環境再安裝 Node 依賴"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境が実行されていません。Node の依存関係をインストールする前に起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경이 실행 중이 아닙니다; Node 종속성을 설치하기 전에 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement Linux ne fonctionne pas ; démarrez-le avant d'installer les dépendances Node"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wird nicht ausgeführt; starten Sie sie, bevor Sie Knotenabhängigkeiten installieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno Linux no se está ejecutando; inícielo antes de instalar las dependencias de Node"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux não está em execução; inicie-o antes de instalar as dependências do Node"
          }
        }
      }
    },
