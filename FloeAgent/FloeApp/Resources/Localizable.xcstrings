    "app.bilingual.116cda550d4a86ea": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算仍在停止中，原件已保留；等它停止后再删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calculation is still stopping. Its original has been retained; delete it again after the calculation stops."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計算仍在停止中，原件已保留；等它停止後再刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計算はまだ停止しています。 元のものは保持されています。計算が停止した後、再度削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계산이 아직 중단되고 있습니다. 원본은 유지되었습니다; 계산이 중단된 후 다시 삭제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calcul s'arrête toujours. Son original a été conservé ; supprimez-le à nouveau après l'arrêt du calcul."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechnung bleibt immer noch stehen. Das Original wurde beibehalten; löschen Sie es erneut, nachdem die Berechnung eingestellt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cálculo sigue deteniéndose. Su original se ha conservado; elimínelo de nuevo después de que se detenga el cálculo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cálculo ainda está parando. Seu original foi mantido; exclua-o novamente após a parada do cálculo."
          }
        }
      }
    },
    "app.bilingual.c50069889b584a41": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份计算仍在运行。请先在发起它的任务中停止，再删除这个文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calculation is still running. Stop it in the task that started it, then delete this file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份計算仍在執行。請先在發起它的任務中停止，再刪除這個檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計算はまだ実行中です。 開始したタスクでそれを停止し、次にこのファイルを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계산은 아직 진행 중입니다. 시작한 작업에서 중지한 다음, 이 파일을 삭제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce calcul est toujours en cours. Arrêtez-le dans la tâche qui l'a lancé, puis supprimez ce fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Berechnung wird noch ausgeführt. Stoppen Sie es in der Aufgabe, die es gestartet hat, und löschen Sie dann diese Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cálculo sigue en marcha. Deténgalo en la tarea que lo inició, luego elimine este archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cálculo ainda está em execução. Pare-o na tarefa que o iniciou e, em seguida, exclua este arquivo."
          }
        }
      }
    },
    "app.bilingual.c3f1cc9f767109b8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次计算所属的任务可能仍在提交。请先完成或停止那个任务，再删除这个文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This calculation's task may still be submitting its job. Finish or stop that task before deleting this file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次計算所屬的任務可能仍在提交。請先完成或停止那個任務，再刪除這個檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この計算タスクは、まだジョブを提出している可能性があります。 このファイルを削除する前に、そのタスクを完了するか停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계산 작업이 아직 작업을 제출하고 있을 수 있습니다. 이 파일을 삭제하기 전에 해당 작업을 완료하거나 중지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche de ce calcul peut encore soumettre son travail. Terminez ou arrêtez cette tâche avant de supprimer ce fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe dieser Berechnung kann immer noch ihren Auftrag einreichen. Beenden oder stoppen Sie diese Aufgabe, bevor Sie diese Datei löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea de este cálculo aún puede estar enviando su trabajo. Termine o detenga esa tarea antes de eliminar este archivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa deste cálculo ainda pode estar enviando seu trabalho. Conclua ou pare essa tarefa antes de excluir este arquivo."
          }
        }
      }
    },
    "app.bilingual.ed4b239285c2cca5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随化学工程删除而对账为已停止。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconciled as stopped when its chemistry project was deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨化學工程刪除而對賬為已停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "化学プロジェクトが削除された際に、停止されたように再調整されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화학 프로젝트가 삭제될 때 중단된 것으로 재조정되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réconcilié comme arrêté lorsque son projet de chimie a été supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versöhnt als gestoppt, als sein Chemieprojekt gelöscht wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconciliado como detenido cuando se eliminó su proyecto de química."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconciliado como parado quando seu projeto de química foi excluído."
          }
        }
      }
    },
    "app.bilingual.7ec6d2c0625ea680": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境检查会准备计算文件，需要当前任务批准。请在作品助手的主任务中批准后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An environment check prepares calculation files and needs this task's approval. Approve it in the work assistant's main task before retrying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境檢查會準備計算檔案，需要當前任務批准。請在作品助手的主任務中批准後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境チェックは計算ファイルを準備し、このタスクの承認が必要です。 再試行する前に、作業アシスタントのメインタスクで承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경 검사는 계산 파일을 준비하며 이 작업의 승인이 필요합니다. 재시도하기 전에 작업 도우미의 기본 작업에서 승인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification de l'environnement prépare des fichiers de calcul et nécessite l'approbation de cette tâche. Approuvez-le dans la tâche principale de l'assistant de travail avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Umgebungsprüfung bereitet Berechnungsdateien vor und erfordert die Genehmigung dieser Aufgabe. Genehmigen Sie es in der Hauptaufgabe des Arbeitsassistenten, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación de entorno prepara archivos de cálculo y necesita la aprobación de esta tarea. Aprobarlo en la tarea principal del asistente de trabajo antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação de ambiente prepara arquivos de cálculo e precisa da aprovação dessa tarefa. Aprove-o na tarefa principal do assistente de trabalho antes de tentar novamente."
          }
        }
      }
    },
    "app.bilingual.c86fe04d1043a7b5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少已批准的调用记录。请从作品助手的主任务重新发起环境检查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approved call record is missing. Start the environment check again from the work assistant's main task."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "缺少已批准的呼叫記錄。請從作品助手的主任務重新發起環境檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認された通話記録が見つかりません。 作業アシスタントのメインタスクから環境チェックを再度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 통화 기록이 없습니다. 작업 도우미의 기본 작업에서 환경 검사를 다시 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement d'appel approuvé est manquant. Recommencer la vérification de l'environnement à partir de la tâche principale de l'assistant de travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der genehmigte Anrufdatensatz fehlt. Starten Sie die Umgebungsprüfung erneut von der Hauptaufgabe des Arbeitsassistenten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el registro de llamadas aprobado. Inicie de nuevo la comprobación del entorno desde la tarea principal del asistente de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de chamada aprovado está faltando. Inicie a verificação do ambiente novamente a partir da tarefa principal do assistente de trabalho."
          }
        }
      }
    },
    "app.bilingual.59089584d47fbd43": {
