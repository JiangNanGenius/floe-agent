    "app.bilingual.6d0762451d7d994c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应实例过多，本次无法定位。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many corresponding instances to locate in one operation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應例項過多，本次無法定位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応するインスタンスが多すぎて、1つの操作で特定するには不可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 작업으로 찾기에는 대응되는 인스턴스가 너무 많습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop d'instances correspondantes à localiser dans une seule opération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele entsprechende Instanzen, um sie in einer Operation zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiadas instancias correspondientes para localizar en una operación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas instâncias correspondentes para localizar em uma operação."
          }
        }
      }
    },
    "app.bilingual.cce624c32b7cc7e5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元件图形超出本次定位预算，未改变画面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The component drawing exceeds the cross-probe budget. The view was kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "元件圖形超出本次定位預算，未改變畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネント図面がクロスプローブ予算を超えています。 眺めは保たれました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성 요소 도면이 교차 프로브 예산을 초과합니다. 그 전망은 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin des composants dépasse le budget de la sonde croisée. La vue a été maintenue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Komponentenzeichnung übersteigt das Cross-Sonde-Budget. Die Ansicht wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo del componente excede el presupuesto de la sonda cruzada. La vista se mantuvo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho do componente excede o orçamento de sonda cruzada. A visão foi mantida."
          }
        }
      }
    },
