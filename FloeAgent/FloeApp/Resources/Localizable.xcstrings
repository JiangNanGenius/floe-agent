        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Originalbild bleibt erhalten. Sie können nach der Bewerbung rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
