        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 > 실행 환경을 열고, 공유 Linux 환경을 검사하거나 복구한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Paramètres > Environnements d'exécution, inspectez ou réparez l'environnement Linux partagé, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Einstellungen > Ausführungsumgebungen, überprüfen oder reparieren Sie die freigegebene Linux-Umgebung, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes > Entornos de ejecución, inspecciona o repara el entorno compartido Linux y vuelve a intentarlo."
