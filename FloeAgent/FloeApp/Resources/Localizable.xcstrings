      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前图纸有未保存的修改；请先点“完成”应用，或先放弃修改后再恢复历史版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing has unsaved edits: Finish to apply them, or discard them first, then restore a historical version."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前圖紙有未儲存的修改；請先點“完成”應用，或先放棄修改後再恢復歷史版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面に未保存の編集があります：それらを適用するために完了するか、先に破棄し、その後履歴バージョンを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림에 저장되지 않은 편집이 있습니다: 이를 적용하려면 작업을 완료하거나, 먼저 삭제한 후 과거 버전을 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a des modifications non enregistrées : Terminez pour les appliquer, ou jetez-les d'abord, puis restaurez une version historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung hat nicht gespeicherte Änderungen: Beenden Sie die Anwendung oder verwerfen Sie sie zuerst, und stellen Sie dann eine historische Version wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo tiene ediciones no guardadas: termine de aplicarlas, o deséchelas primero, luego restaure una versión histórica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho tem edições não salvas: Termine de aplicá-las ou descarte-as primeiro e, em seguida, restaure uma versão histórica."
          }
        }
      }
    },
    "app.workspace_canvas_view.the_saved_draft_has_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前图纸的草稿尚未应用到画布；请先点“完成”应用，或创建变体保留后再恢复历史版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved draft has not been applied to the canvas: Finish to apply it, or keep it via a variant first, then restore."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前圖紙的草稿尚未應用到畫布；請先點“完成”應用，或建立變體保留後再恢復歷史版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたドラフトはキャンバスに適用されていません。適用を完了するか、まずバリアントで保持し、その後復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 초안이 캔버스에 적용되지 않았습니다: 적용하려면 완료하거나, 먼저 변형을 통해 보관한 뒤 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon enregistré n'a pas été appliqué à la toile : Terminez pour l'appliquer, ou gardez-le d'abord via une variante, puis restaurez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Entwurf wurde nicht auf die Leinwand angewendet: Beenden Sie, um ihn anzuwenden, oder behalten Sie ihn zuerst über eine Variante, und stellen Sie ihn dann wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador guardado no se ha aplicado al lienzo: termine para aplicarlo, o manténgalo a través de una variante primero, luego restaure."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho salvo não foi aplicado à tela: Termine para aplicá-lo ou mantenha-o através de uma variante primeiro, depois restaure."
          }
        }
      }
    },
