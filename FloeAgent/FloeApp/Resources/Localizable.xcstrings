    "notes.notes_office_view.could_not_save_to_notes_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not save to Notes: %@ The Office editing copy was kept; you can retry or export."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能保存到手记：%@ Office 编辑副本已保留，可重试或导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能儲存到手記：%@ Office 編輯副本已保留，可重試或匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes: %@ に保存できませんでした。Office の編集コピーは保持されています。再試行またはエクスポートが可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
