    "settings.data_management_view.cleanup_environment_fallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment container root"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境容器根目录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境容器根目錄"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境コンテナルート"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
