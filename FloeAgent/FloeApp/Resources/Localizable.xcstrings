    "app.bilingual.c0d22d1e646ec89b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎提供字段但没有游戏调试快照；恢复只能还原已捕获的字段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine exposes fields but no game debug snapshot; reverts restore captured fields only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎提供欄位但沒有遊戲除錯快照；恢復只能還原已捕獲的欄位。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンはフィールドを公開しますが、ゲームのデバッグスナップショットは取得せず、取得したフィールドのみを復元します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔진은 필드를 노출하지만 게임 디버그 스냅샷은 없으며, 캡처된 필드만 복원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur expose les champs, mais pas d'instantané de débogage du jeu ; il n'inverse que les champs capturés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine legt Felder offen, aber keinen Spiel-Debug-Snapshot; kehrt nur erfasste Felder wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor expone campos, pero no hay instantánea de depuración del juego; revierte solo restaura campos capturados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo expõe campos, mas nenhum instantâneo de depuração do jogo; reverte a restauração apenas dos campos capturados."
          }
        }
      }
    },
    "app.bilingual.e5cf1673792a9662": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查点仅保存在本次运行的内存中，关闭播放器后消失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoints live in memory for this run and disappear when the player closes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查點僅儲存在本次執行的記憶體中，關閉播放器後消失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この実行ではチェックポイントがメモリ上に存在し、プレイヤーが閉じると消失します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크포인트는 이번 실행 동안 메모리에 저장되어 있으며, 플레이어가 종료될 때 사라집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points de contrôle vivent en mémoire pour cette course et disparaissent lorsque le joueur ferme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkpoints leben im Speicher für diesen Lauf und verschwinden, wenn der Player geschlossen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos de control viven en la memoria para esta carrera y desaparecen cuando el jugador se cierra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pontos de verificação vivem na memória para esta corrida e desaparecem quando o jogador fecha."
          }
        }
      }
    },
    "app.bilingual.8765013512521b61": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先运行游戏，再把菜单连接到实际播放器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a game run, then connect the menu to its live player."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先執行遊戲，再把選單連線到實際播放器。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームランを開き、次にメニューをライブプレイヤーに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 실행을 실행한 다음, 메뉴를 라이브 플레이어와 연결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez une exécution de jeu, puis connectez le menu à son lecteur en direct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einen Spiellauf und verbinden Sie dann das Menü mit dem Live-Player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una carrera de juego, luego conecta el menú a su reproductor en vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra uma execução de jogo e, em seguida, conecte o menu ao seu jogador ao vivo."
          }
        }
      }
    },
