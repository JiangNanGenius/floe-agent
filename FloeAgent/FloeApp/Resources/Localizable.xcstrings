            "value": "프리셋이 저장되었습니다; 적용이 현재 작업물을 업데이트합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préréglage enregistré ; Appliquer les mises à jour de la pièce actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voreinstellung gespeichert; Apply aktualisiert das aktuelle Werkstück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preajuste guardado; Aplicar actualiza la pieza de trabajo actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinição salva; Aplicar atualiza a peça de trabalho atual."
          }
        }
      }
    },
