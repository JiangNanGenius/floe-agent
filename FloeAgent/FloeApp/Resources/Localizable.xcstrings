    "app.media_workbench_view.has_revisions_resume_keeps_its": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已有 %@ 次修订。继续编辑会保留已有图层/时间线/撤销历史；新建会从当前素材重新开始。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” has %@ revisions. Resume keeps its layers/timeline/undo history; start fresh rebuilds from the current media."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已有 %@ 次修訂。繼續編輯會保留已有圖層/時間線/撤銷歷史；新建會從當前素材重新開始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” には %@ のリビジョンがあります。 Resumeはレイヤー/タイムライン/アンドゥ履歴を保持し、現在のメディアから新たにリビルドを開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 %@ 수정본을 가지고 있습니다. Resume는 레이어/타임라인/언도 기록을 유지하고, 현재 미디어에서 새로 재구성을 시작합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" a des révisions %@. Reprendre conserve ses couches/calenie/historique d'exécution ; commencez de nouvelles reconstructions à partir des médias actuels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" hat %@-Revisionen. Resume behält seine Schichten/Zeitlinie/Undo-Verlauf bei; beginnen Sie mit neuen Rekonstruktionen aus den aktuellen Medien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" tiene revisiones %@. El currículum mantiene sus capas/línea de tiempo/historial de deshacer; inicie nuevas reconstrucciones a partir de los medios actuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” tem revisões %@. O currículo mantém suas camadas/linha do tempo/histórico de desfazer; inicie novas reconstruções a partir da mídia atual."
          }
        }
      }
    },
