      }
    },
    "setup.features.operations.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Sync preferences, review token and speed metrics, and export correlated diagnostic logs when troubleshooting." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "同步偏好设置、查看 Token 与速度统计，并在排障时导出带关联信息的诊断日志。" } }
