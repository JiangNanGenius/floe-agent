    "providers.provider_list_view.video_is_an_optional_enhancement_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video is an optional enhancement in Creative mode and does not affect private canvases or image creation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频是创意模式的可选增强，不影响私人画布和图片创作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片是創意模式的可選增強，不影響私人畫布和圖片創作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオはクリエイティブモードにおけるオプションの強化であり、プライベートキャンバスや画像作成には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오는 크리에이티브 모드에서 선택적인 향상 기능이며, 개인 캔버스나 이미지 제작에 영향을 주지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo est une amélioration facultative en mode créatif et n'affecte pas les toiles privées ou la création d'images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video ist eine optionale Erweiterung im Kreativmodus und hat keine Auswirkungen auf private Leinwände oder die Bilderstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo es una mejora opcional en modo creativo y no afecta a los lienzos privados ni a la creación de imágenes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vídeo é um aprimoramento opcional no modo Criativo e não afeta telas privadas ou a criação de imagens."
          }
        }
      }
    },
    "providers.provider_list_view.video_model_provider": {
      "extractionState": "manual",
      "localizations": {
