    "app.bilingual.b53f8f51c6f0e096": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此存档已在别处变化；列表已刷新，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save changed elsewhere. The list was refreshed; try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此存檔已在別處變化；列表已重新整理，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブは別の場所に変更されました。 リストが更新されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장이 다른 곳에서 변경되었습니다. 목록이 새로 고쳐졌습니다; 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a changé ailleurs. La liste a été actualisée ; réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicher wurde an anderer Stelle geändert. Die Liste wurde aktualisiert; versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guardado cambió en otro lugar. La lista se actualizó; inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvamento mudou em outro lugar. A lista foi atualizada; tente novamente."
          }
        }
      }
    },
