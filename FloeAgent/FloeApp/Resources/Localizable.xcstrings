    "notes.notes_root_view.and_its_undo_history_cannot_be": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and its undo history cannot be recovered. Attachments used by independently linked mind maps and other content are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其撤销记录将无法恢复。独立关联导图和其他内容使用的附件会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其撤銷記錄將無法恢復。獨立關聯導圖和其他內容使用的附件會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” とその元に戻す履歴は復元できません。 独立してリンクされたマインドマップやその他のコンテンツで使用される添付ファイルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와 그 되돌리기 기록을 복구할 수 없습니다. 독립적으로 연결된 마인드맵 및 기타 콘텐츠에서 사용되는 첨부 파일이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et son historique d'annulation ne peuvent pas être récupérés. Les pièces jointes utilisées par les cartes mentales liées indépendamment et d'autres contenus sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" und sein Rückgängig-Verlauf können nicht wiederhergestellt werden. Anhänge, die von unabhängig verknüpften Mind Maps und anderen Inhalten verwendet werden, werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y su historial de deshacer no se pueden recuperar. Los archivos adjuntos utilizados por los mapas mentales vinculados de forma independiente y otro contenido se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e seu histórico de desfazer não podem ser recuperados. Anexos usados por mapas mentais vinculados de forma independente e outros conteúdos são mantidos."
          }
        }
      }
    },
