          "stringUnit": {
            "state": "translated",
            "value": "Choose a use first, then configure the endpoint, credentials and model capabilities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选择用途，再配置端点、凭据和模型能力。"
