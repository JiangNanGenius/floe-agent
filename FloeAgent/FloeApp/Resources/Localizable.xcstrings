    "exec.notifications.note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed, failed, cancelled and approval-waiting tasks are kept as events. They queue while notification permission is not ready and are never dropped. Tapping a notification opens the related task or environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成、失败、取消和等待审批都会保存为事件；通知未授权时排队，不会丢失。点击通知可打开对应任务或环境。"
          }
        }
      }
    },
