    "portforward.host_port_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPad port must be between %1$lld and %2$lld. Leave it blank to use the smallest free port in that range."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad 端口必须在 %1$lld–%2$lld 之间；留空时自动分配该范围内最小的空闲端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad 埠必須在 %1$lld–%2$lld 之間；留空時自動分配該範圍內最小的空閒埠。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad ポートは %1$lld と %2$lld の間にある必要があります。 その範囲内で最小の空きポートを使用するには、空白のままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad 포트는 %1$lld와 %2$lld 사이에 있어야 합니다. 해당 범위 내에서 가장 작은 자유 포트를 사용하려면 비워 두십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le port iPad doit se situer entre %1$lld et %2$lld. Laissez-le vide pour utiliser le plus petit port libre de cette plage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iPad-Port muss zwischen %1$lld und %2$lld liegen. Lassen Sie es leer, um den kleinsten freien Port in diesem Bereich zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puerto iPad debe estar entre %1$lld y %2$lld. Déjelo en blanco para usar el puerto libre más pequeño de ese rango."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A porta iPad deve estar entre %1$lld e %2$lld. Deixe em branco para usar a menor porta livre nesse intervalo."
          }
        }
      }
    },
    "portforward.loopback_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local-network address found yet; the address shown only works on this iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未检测到局域网地址；显示的地址仅能在本机使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未檢測到區域網地址；顯示的地址僅能在本機使用。"
          }
