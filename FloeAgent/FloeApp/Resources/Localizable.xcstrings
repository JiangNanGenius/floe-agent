    "storage.capacity.guidance": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open system Settings, then General → Storage. Remove content you no longer need, then return to Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开设备的系统设置，在“通用”中查看储存空间，清理不需要的内容后返回 Floe。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟裝置的系統設定，在“通用”中檢視儲存空間，清理不需要的內容後返回 Floe。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定を開き、次に「一般」→「ストレージ」を選択してください。 不要なコンテンツを削除し、Floe に戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정을 연 다음 일반 → 저장소를 선택하십시오. 더 이상 필요하지 않은 콘텐츠를 삭제한 후, Floe로 돌아가십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Paramètres système, puis Général → Stockage. Supprimez le contenu dont vous n'avez plus besoin, puis revenez à Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie die Systemeinstellungen, dann Allgemein → Speicher. Entfernen Sie Inhalte, die Sie nicht mehr benötigen, und kehren Sie dann zu Floe zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Configuración del sistema, luego General → Almacenamiento. Elimine el contenido que ya no necesita y luego regrese a Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra as Configurações do sistema e, em seguida, Geral → Armazenamento. Remova o conteúdo que você não precisa mais e retorne ao Floe."
          }
        }
      }
    },
