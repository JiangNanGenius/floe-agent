        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 비디오 프로젝트를 만들 수 없습니다. 폴더를 오프라인에서 사용할 수 있게 만든 뒤 다시 시도하거나, 로컬 작업 공간을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer le projet vidéo ici. Rendez le dossier disponible hors ligne et réessayez, ou utilisez un espace de travail local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
