    "settings.data_management_view.shared_physical_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are Floe-owned file sizes; shared blocks may be counted more than once, so real usage and freeable space can be less."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上为 Floe 自有文件的文件容量；共享块可能被重复计入，实际占用与可释放容量可能更少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上為 Floe 自有檔案的檔案容量；共享塊可能被重複計入，實際佔用與可釋放容量可能更少。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは Floe が所有するファイルサイズです；共有ブロックは複数回カウントされる可能性があるため、実際の使用量と空き領域は少なくなる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 Floe가 소유한 파일 크기이며, 공유 블록은 한 번 이상 계산될 수 있어 실제 사용량과 여유 공간을 줄일 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont des tailles de fichiers appartenant à Floe ; les blocs partagés peuvent être comptés plus d'une fois, de sorte que l'utilisation réelle et l'espace libérable peuvent être moindres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dabei handelt es sich um Dateigrößen von Floe; freigegebene Blöcke können mehr als einmal gezählt werden, so dass die reale Nutzung und freier Speicherplatz geringer sein können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son tamaños de archivo propiedad de Floe; los bloques compartidos se pueden contar más de una vez, por lo que el uso real y el espacio liberable pueden ser menos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são tamanhos de arquivo de propriedade da Floe; blocos compartilhados podem ser contados mais de uma vez, portanto, o uso real e o espaço liberável podem ser menores."
          }
        }
      }
    },
