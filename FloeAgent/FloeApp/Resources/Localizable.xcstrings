    "app.bilingual.39bc4ef73b492a99": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改可撤销，锁定内容会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes can be undone. Locked content stays protected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改可撤銷，鎖定內容會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は取り消すことができます。 ロックされたコンテンツは保護されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항은 되돌릴 수 있습니다. 잠긴 콘텐츠는 계속 보호됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les changements peuvent être annés. Le contenu verrouillé reste protégé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen können rückgängig gemacht werden. Gesperrte Inhalte bleiben geschützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se pueden deshacer. El contenido bloqueado permanece protegido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações podem ser desfeitas. O conteúdo bloqueado permanece protegido."
          }
        }
      }
    },
