    "app.bilingual.a2c5e41e1353e98e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上选择元件、走线、过孔或铜区以编辑属性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a part, track, via or zone on the canvas to edit its properties."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布上選擇元件、走線、過孔或銅區以編輯屬性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス上のパート、トラック、バイア、またはゾーンを選択して、そのプロパティを編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에서 파트, 트랙, 비아 또는 영역을 선택하여 해당 속성을 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une partie, une piste, via ou une zone sur le canevas pour modifier ses propriétés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Teil, eine Spur, einen Weg oder eine Zone auf der Leinwand aus, um seine Eigenschaften zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione una parte, pista, vía o zona en el lienzo para editar sus propiedades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma parte, faixa, via ou zona na tela para editar suas propriedades."
          }
        }
      }
    },
