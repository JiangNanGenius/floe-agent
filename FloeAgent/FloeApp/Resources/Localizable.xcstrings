    "chat.temporary.about.tools": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools are read-only here: public web search, personal-data lookups, file/media inspection and skill instructions. Writing, execution, installs, VM changes, jobs, delegation, sends and GUI control are not offered. Model requests still go to your configured provider under its own policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的工具为只读：公开网络搜索、个人数据查询、文件/媒体检查与技能说明；不提供写入、执行、安装、虚拟机变更、后台作业、委派、发送与界面控制。模型请求仍会发送到你配置的服务提供方，并受其政策约束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的工具為只讀：公開網路搜尋、個人資料查詢、檔案/媒體檢查與技能說明；不提供寫入、執行、安裝、虛擬機器變更、後臺作業、委派、傳送與介面控制。模型請求仍會傳送到你配置的服務提供方，並受其政策約束。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールはここでは読み取り専用です：パブリックウェブ検索、個人データ検索、ファイル/メディア検査、スキル指示。 書き込み、実行、インストール、VM の変更、ジョブ、委任、送信、および GUI 制御は提供されていません。 モデルリクエストは、依然として設定されたプロバイダーに、独自のポリシーで送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서는 도구가 읽기 전용입니다: 공개 웹 검색, 개인 데이터 조회, 파일/미디어 검사 및 스킬 지침. 작성, 실행, 설치, VM 변경, 작업, 위임, 전송 및 GUI 제어는 제공되지 않습니다. 모델 요청은 여전히 자체 정책에 따라 귀하가 구성한 제공업체로 전송됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils sont en lecture seule ici : recherche publique sur le Web, recherches de données personnelles, inspection de fichiers/médias et instructions de compétences. L'écriture, l'exécution, les installations, les modifications de VM, les tâches, la délégation, les envois et le contrôle de l'interface graphique ne sont pas offerts. Les demandes de modèle vont toujours à votre fournisseur configuré en vertu de sa propre politique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools sind hier schreibgeschützt: öffentliche Websuche, Nachschlagen personenbezogener Daten, Datei-/Medienprüfung und Anleitungen zu Fähigkeiten. Schreiben, Ausführen, Installieren, VM-Änderungen, Aufträge, Delegieren, Senden und GUI-Steuerung werden nicht angeboten. Modellanfragen gehen gemäß seiner eigenen Richtlinie weiterhin an Ihren konfigurierten Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas son de solo lectura aquí: búsqueda pública en la web, búsquedas de datos personales, inspección de archivos/medios e instrucciones de habilidades. No se ofrecen escritura, ejecución, instalaciones, cambios de VM, trabajos, delegación, envíos y control de GUI. Las solicitudes de modelo todavía van a su proveedor configurado bajo su propia política."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas são somente leitura aqui: pesquisa pública na web, pesquisas de dados pessoais, inspeção de arquivos/mídia e instruções de habilidades. Gravação, execução, instalações, alterações de VM, trabalhos, delegação, envios e controle de GUI não são oferecidos. As solicitações de modelo ainda vão para o seu provedor configurado sob sua própria política."
          }
        }
      }
    },
