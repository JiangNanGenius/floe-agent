    "workbench.task_inspector_views.tools_for_this_task_run_automatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools for this task run automatically; catastrophic commands are always blocked and package installation still requires model review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本任务工具自动执行；灾难性命令始终阻止，软件包安装仍需模型审查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本任務工具自動執行；災難性命令始終阻止，軟體包安裝仍需模型審查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクのツールは自動的に実行されます；壊滅的なコマンドは常にブロックされ、パッケージのインストールには依然としてモデルのレビューが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에 대한 도구는 자동으로 실행되며, 치명적인 명령은 항상 차단되고 패키지 설치는 여전히 모델 검토가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils pour cette tâche s'exécutent automatiquement ; les commandes catastrophiques sont toujours bloquées et l'installation du paquet nécessite toujours un examen du modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tools für diese Aufgabe werden automatisch ausgeführt; katastrophale Befehle werden immer blockiert und die Paketinstallation erfordert weiterhin eine Modellüberprüfung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas para esta tarea se ejecutan automáticamente; los comandos catastróficos siempre están bloqueados y la instalación del paquete aún requiere revisión del modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas para esta tarefa são executadas automaticamente; comandos catastróficos são sempre bloqueados e a instalação do pacote ainda requer revisão do modelo."
          }
        }
      }
    },
