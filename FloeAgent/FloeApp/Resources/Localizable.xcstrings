    "pip.audio.error.playback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ambient sound could not start. Other sounds are unaffected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背景音未能启动，其他声音不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景音未能啟動，其他聲音不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境音が起動できませんでした。 他の音は影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 소리를 시작할 수 없었습니다. 다른 소리는 영향을 받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son ambiant ne pouvait pas démarrer. Les autres sons ne sont pas affectés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Umgebungsgeräusch konnte nicht gestartet werden. Andere Töne sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sonido ambiental no pudo comenzar. Otros sonidos no se ven afectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som ambiente não pôde começar. Outros sons não são afetados."
          }
        }
      }
    },
    "pip.audio.error.session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
