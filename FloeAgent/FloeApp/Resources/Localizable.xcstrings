    "files.compress.format.tbz2_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 can be created on this device but cannot be extracted in the app; open it in a Linux environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 可在设备上创建，但应用内暂不能解压；可在 Linux 环境中打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 可在裝置上建立，但應用內暫不能解壓；可在 Linux 環境中開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2はこのデバイスで作成できますが、アプリ内で展開することはできません。Linux環境で開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2는 이 장치에서 생성할 수 있지만 앱에서는 추출할 수 없습니다; Linux 환경에서 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 peut être créé sur cet appareil mais ne peut pas être extrait dans l'application ; ouvrez-le dans un environnement Linux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 kann auf diesem Gerät erstellt werden, kann aber nicht in der App extrahiert werden; öffnen Sie es in einer Linux-Umgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 se puede crear en este dispositivo, pero no se puede extraer en la aplicación; ábralo en un entorno Linux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "TAR.BZ2 pode ser criado neste dispositivo, mas não pode ser extraído no aplicativo; abra-o em um ambiente Linux."
          }
        }
      }
    },
