        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度に最大2分まで分析してください。 お客様のオリジナル動画は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 최대 2분까지 분석하십시오. 원본 비디오가 보존되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez jusqu'à deux minutes à la fois. Votre vidéo originale est préservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysieren Sie bis zu zwei Minuten auf einmal. Ihr Originalvideo ist erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza hasta dos minutos a la vez. Tu vídeo original se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise até dois minutos de cada vez. Seu vídeo original está preservado."
          }
        }
      }
    },
