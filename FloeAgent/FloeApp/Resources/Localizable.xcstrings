            "value": "未知の世代への試みを破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 생성 시도를 버리시겠습니까?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter la tentative de génération inconnue ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Den unbekannten Generationsversuch verwerfen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar el intento de generación desconocida?"
          }
        },
        "pt-BR": {
