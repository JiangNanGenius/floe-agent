    "cad.textureImport.error.invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image could not be read safely. The source and existing textures are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全读取这张图片。原图和已有贴图均未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全讀取這張圖片。原圖和已有貼圖均未更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は安全に読み取ることができませんでした。 ソースと既存のテクスチャは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지를 안전하게 읽을 수 없습니다. 소스와 기존 텍스처는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image n'a pas pu être lue en toute sécurité. La source et les textures existantes sont inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild konnte nicht sicher gelesen werden. Die Quelle und die vorhandenen Texturen sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen no se pudo leer de forma segura. La fuente y las texturas existentes no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem não pôde ser lida com segurança. A fonte e as texturas existentes permanecem inalteradas."
          }
        }
      }
    },
    "cad.textureImport.error.hdr": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert HDR, EXR, KTX or UDIM resources to individual SDR images first. The originals are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先将 HDR、EXR、KTX 或 UDIM 资源转换为单张 SDR 图片。原始文件未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先將 HDR、EXR、KTX 或 UDIM 資源轉換為單張 SDR 圖片。原始檔案未更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、HDR、EXR、KTX、またはUDIMリソースを個別のSDR画像に変換してください。 原本は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 HDR, EXR, KTX 또는 UDIM 리소스를 개별 SDR 이미지로 변환하십시오. 원본은 변함이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez d'abord les ressources HDR, EXR, KTX ou UDIM en images SDR individuelles. Les originaux sont inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konvertieren Sie zuerst HDR-, EXR-, KTX- oder UDIM-Ressourcen in einzelne SDR-Images. Die Originale sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierta primero los recursos HDR, EXR, KTX o UDIM en imágenes SDR individuales. Los originales no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converta recursos HDR, EXR, KTX ou UDIM em imagens SDR individuais primeiro. Os originais não foram alterados."
          }
        }
      }
    },
    "cad.textureImport.error.multiple": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a single-frame image. Pages and animation frames will not be discarded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择单帧图片。不会自动丢弃其他页面或动画帧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇單幀圖片。不會自動丟棄其他頁面或動畫幀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単一フレームの画像を選択してください。 ページとアニメーションフレームは破棄されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단일 프레임 이미지를 선택하십시오. 페이지와 애니메이션 프레임은 폐기되지 않습니다."
