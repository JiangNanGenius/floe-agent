            "state": "translated",
            "value": "仅用于此技能配置，添加变量不会授予执行或网络访问权限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to this skill configuration. Adding a variable does not grant execution or network access."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於此技能配置，新增變數不會授予執行或網路訪問許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキル設定に適用されます。 変数を追加しても、実行やネットワークへのアクセスは許可されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스킬 구성에 적용됩니다. 변수를 추가해도 실행이나 네트워크 접근 권한이 부여되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à cette configuration de compétence. L'ajout d'une variable n'accorde pas l'exécution ou l'accès au réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für diese Skill-Konfiguration. Das Hinzufügen einer Variablen gewährt keine Ausführung oder Netzwerkzugriff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a esta configuración de habilidades. Agregar una variable no otorga ejecución ni acceso a la red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a esta configuração de habilidade. Adicionar uma variável não concede execução ou acesso à rede."
          }
        }
      }
    },
