    "settings.content_updates.catalog.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverified providers are still listed with their reason, but they are not activated and cannot be selected for requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经验证的提供商会连同原因一并列出，但不会激活，也无法被选择用于请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未經驗證的提供商會連同原因一併列出，但不會啟用，也無法被選擇用於請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未確認のプロバイダーは理由とともに依然として一覧表示されますが、アクティブ化されていないため、リクエストに選択できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증되지 않은 제공자는 여전히 그 이유와 함께 목록에 표시되지만, 활성화되지 않아 요청에 선택될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fournisseurs non vérifiés sont toujours répertoriés avec leur raison, mais ils ne sont pas activés et ne peuvent pas être sélectionnés pour les demandes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht verifizierte Anbieter sind immer noch mit ihrem Grund aufgeführt, aber sie sind nicht aktiviert und können nicht für Anfragen ausgewählt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proveedores no verificados siguen en la lista con su razón, pero no están activados y no pueden ser seleccionados para solicitudes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Provedores não verificados ainda estão listados com seu motivo, mas não estão ativados e não podem ser selecionados para solicitações."
          }
        }
      }
    },
