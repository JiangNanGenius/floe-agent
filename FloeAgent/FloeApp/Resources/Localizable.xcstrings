    "setup.features.auxiliary.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a fast vision model for non-visual chats and a lightweight model for automatic approval review."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为非视觉对话配置快速读图模型，并用轻量模型执行自动审批。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為非視覺對話配置快速讀圖模型，並用輕量模型執行自動審批。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非視覚チャット用の高速ビジョンモデルと、自動承認レビュー用の軽量モデルを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비시각 채팅을 위한 빠른 비전 모델과 자동 승인 검토를 위한 경량 모델을 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un modèle de vision rapide pour les chats non visuels et un modèle léger pour l'examen automatique de l'approbation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie ein Schnellbildmodell für nicht-visuelle Chats und ein leichtes Modell für die automatische Genehmigungsprüfung hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue un modelo de visión rápida para chats no visuales y un modelo ligero para la revisión automática de la aprobación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um modelo de visão rápida para bate-papos não visuais e um modelo leve para revisão automática de aprovação."
          }
        }
      }
    },
    "setup.features.auxiliary.title": {
