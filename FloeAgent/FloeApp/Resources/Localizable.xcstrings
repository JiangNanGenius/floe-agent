      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接曾中断，请核对文件后重试"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection was interrupted; check the file before retrying"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線曾中斷，請核對檔案後重試"
