    "app.bilingual.c71b1cd66e8556a5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按原图百分比裁剪，原素材保留。也可在画布拖动框选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crop by source percentage while retaining the original. Drag on the canvas to crop visually."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按原圖百分比裁剪，原素材保留。也可在畫布拖動框選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のまま、ソースの割合でトリミングしてください。 キャンバスをドラッグして視覚的にトリミングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 유지하면서 소스 비율에 따라 자르십시오. 캔버스를 드래그하여 시각적으로 자르세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadrer par pourcentage de source tout en conservant l'original. Faites glisser sur la toile pour recadrer visuellement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnitt nach Quellenprozentsatz unter Beibehaltung des Originals. Ziehen Sie auf der Leinwand, um sie visuell zuzuschneiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortar por porcentaje de fuente mientras se conserva el original. Arrastra el lienzo para recortar visualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corte por porcentagem de origem, mantendo o original. Arraste a tela para cortar visualmente."
          }
        }
      }
    },
