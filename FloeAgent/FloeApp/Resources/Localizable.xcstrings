          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette correspondance se trouve dans le texte du corps du bureau ou une page supprimée et ne peut pas être localisée sur une page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Übereinstimmung befindet sich im Office-Text oder auf einer gelöschten Seite und kann nicht auf einer Seite gefunden werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
