    "cad.datum.pointOnAxisHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A point on the axis, offset along it. It follows the axis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位于轴上、沿轴偏移的点，会跟随该轴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位於軸上、沿軸偏移的點，會跟隨該軸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸上の一点で、軸に沿ってオフセットされています。 それは軸に沿っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축에 있는 점, 그에 따라 오프셋된 점. 축을 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point sur l'axe, décalé le long de lui. Il suit l'axe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Punkt auf der Achse, versetzt sich entlang. Es folgt der Achse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto en el eje, desplazado a lo largo de él. Sigue el eje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto no eixo, desloque ao longo dele. Segue o eixo."
          }
        }
      }
    },
    "cad.datum.pointPickHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then tap a flat face or a straight edge and press Apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后点按平面或直边，并按“应用”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後點按平面或直邊，並按“應用”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、平らな面または直線のエッジをタップし、Apply を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 평평한 면이나 직선 모서리를 탭하고 적용을 누르십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez ensuite sur une face plate ou un bord droit et appuyez sur Appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie dann auf ein flaches Gesicht oder einen geraden Rand und drücken Sie auf \"Anwenden\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, pulsa una cara plana o un borde recto y pulsa Aplicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, toque em uma face plana ou em uma borda reta e pressione Aplicar."
          }
        }
      }
    },
    "cad.datum.readOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is read-only; reopen it to edit reference geometry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档为只读；请重新打开后再编辑参考几何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件為只讀；請重新開啟後再編輯參考幾何。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は読み取り専用です。参照ジオメトリを編集するには、再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 읽기 전용이며, 참조 기하학을 편집하려면 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document est en lecture seule ; rouvrez-le pour modifier la géométrie de référence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist schreibgeschützt; öffnen Sie es erneut, um die Referenzgeometrie zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento es de solo lectura; vuelva a abrirlo para editar la geometría de referencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento é somente leitura; reabra-o para editar a geometria de referência."
          }
        }
      }
    },
    "cad.datum.reselectPointHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then tap the new straight edge or flat face and press Apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后点按新的直边或平面，并按“应用”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後點按新的直邊或平面，並按“應用”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、新しいストレートエッジまたはフラットフェイスをタップし、Apply を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 새 직선 가장자리 또는 평면 면을 탭하고 적용을 누르십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez ensuite sur le nouveau bord droit ou face plate et appuyez sur Appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie dann auf die neue gerade Kante oder flache Fläche und drücken Sie \"Anwenden\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, pulsa el nuevo borde recto o cara plana y pulsa Aplicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, toque na nova borda reta ou face plana e pressione Aplicar."
          }
        }
      }
    },
    "cad.datum.reselectSourceHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then tap the new straight edge, flat face or round face and press Apply. The kind must match the axis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后点按新的直边、平面或圆柱面并按“应用”。所选类型必须与轴一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後點按新的直邊、平面或圓柱面並按“應用”。所選型別必須與軸一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、新しいストレートエッジ、フラットフェイス、またはラウンドフェイスをタップし、適用ボタンを押してください。 種類は軸と一致しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 새로운 직선 가장자리, 평면 또는 원형을 탭하고 적용을 누르십시오. 그 종류는 축과 일치해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez ensuite sur le nouveau bord droit, la face plate ou la face ronde et appuyez sur Appliquer. Le type doit correspondre à l'axe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie dann auf die neue gerade Kante, die flache oder die runde Fläche und drücken Sie auf \"Anwenden\". Die Art muss mit der Achse übereinstimmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, pulsa el nuevo borde recto, cara plana o cara redonda y pulsa Aplicar. El tipo debe coincidir con el eje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, toque na nova borda reta, face plana ou face redonda e pressione Aplicar. O tipo deve corresponder ao eixo."
          }
        }
      }
    },
