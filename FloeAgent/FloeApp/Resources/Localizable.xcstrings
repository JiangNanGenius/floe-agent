        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 삭제되었습니다; %@ 개인 작업 공간은 아직 정리되지 않았으며 다음 실행 시 다시 시도될 예정입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche a été supprimée ; les espaces de travail privés %@ ne sont pas encore nettoyés et seront réessayés au prochain lancement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde gelöscht; %@ private Arbeitsbereiche sind noch nicht bereinigt und werden beim nächsten Start erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea fue eliminada; los espacios de trabajo privados %@ aún no se han limpiado y se volverán a intentar en el próximo lanzamiento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa foi excluída; os espaços de trabalho privados %@ ainda não foram limpos e serão tentados novamente no próximo lançamento."
          }
        }
      }
    },
