    "cad.text.too_complex": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text is too detailed. Try a shorter phrase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字过于复杂，请缩短内容后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字過於複雜，請縮短內容後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストは詳細すぎます。 短いフレーズを試してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 텍스트는 너무 자세합니다. 짧은 구절을 시도해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte est trop détaillé. Essayez une phrase plus courte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text ist zu detailliert. Versuchen Sie einen kürzeren Satz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto es demasiado detallado. Prueba una frase más corta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto é muito detalhado. Tente uma frase mais curta."
          }
        }
      }
    },
    "cad.text.unsupported_characters": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some characters cannot be drawn with this font. Choose another font or change the text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此字体无法绘制部分字符，请更换字体或修改内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此字型無法繪製部分字元，請更換字型或修改內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォントでは一部の文字を描画できません。 別のフォントを選択するか、テキストを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 문자는 이 글꼴로 그릴 수 없습니다. 다른 글꼴을 선택하거나 텍스트를 변경하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains caractères ne peuvent pas être dessinés avec cette police. Choisissez une autre police ou changez le texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Zeichen können nicht mit dieser Schriftart gezeichnet werden. Wählen Sie eine andere Schriftart oder ändern Sie den Text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos caracteres no se pueden dibujar con esta fuente. Elija otra fuente o cambie el texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns caracteres não podem ser desenhados com esta fonte. Escolha outra fonte ou altere o texto."
          }
        }
      }
    },
    "cad.text.no_outlines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No outlines were found. Change the text or font."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
