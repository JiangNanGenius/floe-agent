    "cad.building.error.theDesignChangedReopenTheBuildingSettings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design changed. Reopen the building settings."
          }
        },
        "zh-Hans": {
