    "home.detail.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start in the workbench, then inspect every decision and result in its thread."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左侧工作台开始，再到任务线程中查看每个决定和结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從左側工作臺開始，再到任務執行緒中檢視每個決定和結果。"
