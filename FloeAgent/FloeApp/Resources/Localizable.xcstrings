    "cad.datum.axisLengthHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the reference axis is drawn. It never changes the geometry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考轴的绘制长度，不影响几何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考軸的繪製長度，不影響幾何。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照軸が描かれる長さ。 それは決してジオメトリを変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 축이 그려지는 길이. 그것은 절대 기하학을 바꾸지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps l'axe de référence est dessiné. Il ne change jamais la géométrie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange die Referenzachse gezeichnet ist. Es ändert nie die Geometrie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo se dibuja el eje de referencia. Nunca cambia la geometría."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quanto tempo o eixo de referência é desenhado. Isso nunca muda a geometria."
          }
        }
      }
    },
