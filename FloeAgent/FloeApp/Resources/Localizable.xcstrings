    "execution.runtime_reset.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops local tasks and clears the runtime and its installed dependencies. Project files, conversations and installed Skills are kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将停止本机任务，并清除运行环境及已安装依赖。项目文件、聊天和已安装 Skill 会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將停止本機任務，並清除執行環境及已安裝依賴。專案檔案、聊天和已安裝 Skill 會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これによりローカルタスクが停止され、ランタイムとインストールされた依存関係がクリアされます。 プロジェクトファイル、会話、インストール済みのスキルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 로컬 작업을 중지하고 런타임 및 해당에 설치된 의존성을 제거합니다. 프로젝트 파일, 대화 및 설치된 스킬이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête les tâches locales et efface l'exécution et ses dépendances installées. Les fichiers de projet, les conversations et les compétences installées sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden lokale Aufgaben gestoppt und die Laufzeit und ihre installierten Abhängigkeiten gelöscht. Projektdateien, Gespräche und installierte Fähigkeiten werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene las tareas locales y borra el tiempo de ejecución y sus dependencias instaladas. Se guardan los archivos del proyecto, las conversaciones y las habilidades instaladas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso interrompe as tarefas locais e limpa o tempo de execução e suas dependências instaladas. Arquivos de projeto, conversas e habilidades instaladas são mantidos."
          }
        }
      }
    },
