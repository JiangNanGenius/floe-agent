    "platform.background_video_service.the_picture_in_picture_source_is": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Picture in Picture source is not connected to the app window yet; keep the app in the foreground and retry"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画中画来源尚未连接到应用窗口，请保持应用在前台后重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫中畫來源尚未連線到應用視窗，請保持應用在前臺後重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクチャー・イン・ピクチャーのソースはまだアプリウィンドウに接続されていません。アプリを前面に保って、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture 소스가 아직 앱 창에 연결되어 있지 않습니다; 앱을 포그라운드에 두고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source Picture in Picture n'est pas encore connectée à la fenêtre de l'application ; gardez l'application au premier plan et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bild-in-Bild-Quelle ist noch nicht mit dem App-Fenster verbunden; lassen Sie die App im Vordergrund und versuchen Sie es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente Picture in Picture aún no está conectada a la ventana de la aplicación; mantenga la aplicación en primer plano y vuelva a intentarlo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte Picture in Picture ainda não está conectada à janela do aplicativo; mantenha o aplicativo em primeiro plano e tente novamente"
          }
        }
      }
    },
