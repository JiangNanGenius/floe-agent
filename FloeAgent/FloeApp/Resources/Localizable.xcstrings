          "stringUnit": {
            "state": "translated",
            "value": "此檔案超過預覽大小限制，仍可儲存或分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはプレビュー制限を超えています。 まだ保存したり共有したりできます。"
