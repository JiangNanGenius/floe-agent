          "stringUnit": {
            "state": "translated",
            "value": "偏移产生尖点。请减小距离或修改源曲线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏移產生尖點。請減小距離或修改源曲線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフセットはカスプを形成します。 距離を短くするか、ソース曲線を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프셋은 커스프를 형성합니다. 거리를 줄이거나 소스 곡선을 변경하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décalage forme une cuspide. Réduisez la distance ou modifiez la courbe de la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versatz bildet eine Spitze. Reduzieren Sie die Entfernung oder ändern Sie die Quellkurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento forma una cúspide. Reduzca la distancia o cambie la curva de origen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslocamento forma uma cúspide. Reduza a distância ou altere a curva de origem."
          }
        }
      }
    },
    "cad.sketch.curve.selfIntersection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offset intersects itself. Reduce the distance or change the source curve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "偏移发生自交。请减小距离或修改源曲线。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偏移發生自交。請減小距離或修改源曲線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフセットはそれ自身と交差します。 距離を短くするか、ソース曲線を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프셋이 스스로 교차합니다. 거리를 줄이거나 소스 곡선을 변경하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décalage se croise. Réduisez la distance ou modifiez la courbe de la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versatz schneidet sich selbst. Reduzieren Sie die Entfernung oder ändern Sie die Quellkurve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desplazamiento se cruza a sí mismo. Reduzca la distancia o cambie la curva de origen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O deslocamento se cruza. Reduza a distância ou altere a curva de origem."
          }
        }
      }
    },
