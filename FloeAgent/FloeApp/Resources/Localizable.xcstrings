      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workflow was dispatched but no unique run is associated yet; Floe will not resubmit and keeps checking by snapshot."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已触发工作流，但尚未唯一关联到本次快照；不会重复提交，将按快照继续核对。"
