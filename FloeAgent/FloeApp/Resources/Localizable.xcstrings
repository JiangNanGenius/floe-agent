    "app.bilingual.65f3a10dacaf6f02": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续执行未取得可核对的进展。补充信息或调整任务后可继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeated cycles produced no verifiable progress. Add information or adjust the task, then continue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續執行未取得可核對的進展。補充資訊或調整任務後可繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "繰り返しのサイクルでは、検証可能な進展は見られませんでした。 情報を追加するか、タスクを調整してから、続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반복된 사이클은 검증 가능한 진전을 이루지 않았습니다. 정보를 추가하거나 작업을 조정한 후 계속하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cycles répétés n'ont produit aucun progrès vérifiable. Ajoutez des informations ou ajustez la tâche, puis continuez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederholte Zyklen führten zu keinem überprüfbaren Fortschritt. Fügen Sie Informationen hinzu oder passen Sie die Aufgabe an, und fahren Sie dann fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ciclos repetidos no produjeron ningún progreso verificable. Añade información o ajusta la tarea, luego continúa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciclos repetidos não produziram nenhum progresso verificável. Adicione informações ou ajuste a tarefa e continue."
          }
        }
      }
    },
    "app.bilingual.e441560d9adeb7ea": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有结果尚未通过核对。查看任务结果，处理问题后可继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The results did not pass review. Check the task results, address the issue, then continue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現有結果尚未透過核對。檢視任務結果，處理問題後可繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果は審査に合格しませんでした。 タスクの結果を確認し、問題に対処してから、続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 검토를 통과하지 못했습니다. 작업 결과를 확인하고, 문제를 해결한 뒤 계속 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats n'ont pas passé l'examen. Vérifiez les résultats de la tâche, résolez le problème, puis continuez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse haben die Überprüfung nicht bestanden. Überprüfen Sie die Aufgabenergebnisse, beheben Sie das Problem und fahren Sie dann fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados no pasaron la revisión. Comprueba los resultados de la tarea, aborda el problema y continúa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados não passaram na revisão. Verifique os resultados da tarefa, resolva o problema e continue."
          }
        }
      }
    },
