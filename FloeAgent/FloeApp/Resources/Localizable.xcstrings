    "app.bilingual.b2acbc08ad7a8ccf": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加旁白并与配乐在时间轴上对齐。旁白需要取消静音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add narration overlapping the music in the timeline, and unmute it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增旁白並與配樂在時間軸上對齊。旁白需要取消靜音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインの音楽と重なるナレーションを追加し、ミュートを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인의 음악과 겹치는 내레이션을 추가하고, 음소거를 해제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la narration qui chevauche la musique dans la chronologie et réactivez-la."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie eine Erzählung hinzu, die die Musik in der Timeline überlagert, und schalten Sie die Stummschaltung auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una narración que superponga la música en la línea de tiempo y activa el sonido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione narração sobreposta à música na linha do tempo e ative o som."
          }
        }
      }
    },
