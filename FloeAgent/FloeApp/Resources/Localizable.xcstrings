    "app.bilingual.fb5198367dfd136d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "元件三维模型尚未下载或不受支持；引用仍保留。请在在线元件库中下载模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Component 3D models are not downloaded or not supported; references are retained. Download them in the online library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "元件三維模型尚未下載或不受支援；引用仍保留。請在線上元件庫中下載模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントの3Dモデルはダウンロードされていないか、サポートされていません。参照は保持されます。 オンラインライブラリからダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴포넌트 3D 모델은 다운로드되지 않거나 지원되지 않으며, 참고 문헌은 유지됩니다. 온라인 도서관에서 다운로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles 3D de composants ne sont pas téléchargés ou ne sont pas pris en charge ; les références sont conservées. Téléchargez-les dans la bibliothèque en ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Komponenten-3D-Modelle werden nicht heruntergeladen oder nicht unterstützt; Referenzen werden beibehalten. Laden Sie sie in der Online-Bibliothek herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos 3D de componentes no se descargan ni son compatibles; las referencias se conservan. Descárguelos en la biblioteca en línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos 3D de componentes não são baixados ou não são suportados; referências são mantidas. Baixe-os na biblioteca online."
          }
        }
      }
    },
