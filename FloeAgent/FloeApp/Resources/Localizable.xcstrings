    "skills.skills_view.mcp_is_off_by_default_for": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP is off by default for canvases. Only after you explicitly turn on this server can the canvas agent see its tools."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布默认关闭 MCP。只有你明确打开此服务器后，画布 Agent 才能看到它的工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布預設關閉 MCP。只有你明確開啟此伺服器後，畫布 Agent 才能看到它的工具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP はキャンバスに対してデフォルトでオフになっています。 このサーバーを明示的に起動した後でのみ、キャンバスエージェントはツールを見ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP는 캔버스에 대해 기본적으로 꺼져 있습니다. 이 서버를 명시적으로 활성화한 후에야 캔버스 에이전트가 해당 도구를 볼 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP est désactivé par défaut pour les toiles. Ce n'est qu'après avoir explicitement activé ce serveur que l'agent de toile peut voir ses outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP ist für Canvass standardmäßig ausgeschaltet. Erst nachdem Sie diesen Server explizit einschalten, kann der Canvas-Agent seine Werkzeuge sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP está desactivado por defecto para los lienzos. Solo después de activar explícitamente este servidor, el agente de lienzo puede ver sus herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP está desativado por padrão para telas. Somente depois de ligar explicitamente este servidor, o agente de tela pode ver suas ferramentas."
          }
        }
      }
    },
