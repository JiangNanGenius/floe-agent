    "cad.building.centreLines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected straight lines become wall centre lines. Review double-line walls and remove dimensions or furniture from the selection in the drawing editor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选直线将作为墙中心线。请在二维编辑器中检查双线墙，并从选择中移除尺寸标注和家具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選直線將作為牆中心線。請在二維編輯器中檢查雙線牆，並從選擇中移除尺寸標註和傢俱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された直線は壁の中心線になります。 図面エディタで、ダブルライン壁を確認し、選択項目から寸法や家具を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 직선은 벽의 중심선이 됩니다. 이중 라인 벽을 검토하고 도면 편집기에서 치수 또는 가구를 선택 항목에서 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes droites sélectionnées deviennent des lignes centrales du mur. Passez en revue les murs à double ligne et supprimez les dimensions ou les meubles de la sélection dans l'éditeur de dessin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte gerade Linien werden zu Wandmittenlinien. Überprüfen Sie doppelzeilige Wände und entfernen Sie Abmessungen oder Möbel aus der Auswahl im Zeichnungseditor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas rectas seleccionadas se convierten en líneas centrales de la pared. Revise las paredes de doble línea y elimine las dimensiones o los muebles de la selección en el editor de dibujos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linhas retas selecionadas tornam-se linhas centrais da parede. Revise paredes de linha dupla e remova dimensões ou móveis da seleção no editor de desenhos."
          }
        }
      }
    },
