    "cad.hole.directionHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the plane normal points out of the part, choose Opposite normal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若平面法向指向实体外侧，请选择反向法向。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若平面法向指向實體外側，請選擇反向法向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平面法線が部品から外側を向く場合は、反対法線を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평면 법선이 부품에서 벗어나면, 반대 법선을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le plan normal pointe hors de la pièce, choisissez Normal opposé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Ebene normal aus dem Teil zeigt, wählen Sie \"Gegengesetzt normal\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el plano normal apunta fuera de la pieza, elija Normal opuesto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o plano normal apontar para fora da peça, escolha Oposto normal."
          }
        }
      }
    },
