    "app.bilingual.a7495fddb350bb83": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说话人识别未完成，录音与文字已保留。可在会议设置中重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker recognition is unfinished. Audio and text are saved. Retry in meeting settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說話人識別未完成，錄音與文字已保留。可在會議設定中重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スピーカー認識は未完成です。 音声とテキストが保存されています。 会議設定で再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스피커 인식이 완료되지 않았습니다. 오디오와 텍스트가 저장되었습니다. 회의 설정에서 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance du haut-parleur est inachevée. L'audio et le texte sont enregistrés. Réessayez dans les paramètres de réunion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lautsprechererkennung ist noch nicht abgeschlossen. Audio und Text werden gespeichert. Wiederholen Sie es in den Meeting-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento del altavoz no está terminado. El audio y el texto están guardados. Vuelva a intentarlo en la configuración de la reunión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento do alto-falante está inacabado. Áudio e texto são salvos. Tente novamente nas configurações de reunião."
          }
        }
      }
    },
