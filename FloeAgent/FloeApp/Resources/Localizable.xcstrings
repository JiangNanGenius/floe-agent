    "app.bilingual.21990bee4de89de": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆弧和样条保留原始定义；直线保持直线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcs and splines retain their definitions; lines remain straight."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圓弧和樣條保留原始定義；直線保持直線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "弧とスプラインは定義を保持し、線は直線のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호와 스플라인은 정의를 유지하고, 선은 곧게 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les arcs et les splines conservent leurs définitions ; les lignes restent droites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bögen und Splines behalten ihre Definitionen; Linien bleiben gerade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los arcos y las espinas conservan sus definiciones; las líneas permanecen rectas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcos e spline mantêm suas definições; linhas permanecem retas."
          }
        }
      }
    },
