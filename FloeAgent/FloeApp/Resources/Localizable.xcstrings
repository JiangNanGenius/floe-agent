    "app.bilingual.dbe28cc11f315bf4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分画面跟踪丢失，请检查后重新框选。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking was lost in some frames. Review the result or select the object again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分畫面跟蹤丟失，請檢查後重新框選。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかのフレームでトラッキングが失われました。 結果を確認するか、再度オブジェクトを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 프레임에서 추적이 손실되었습니다. 결과를 검토하거나 객체를 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi a été perdu dans certains cadres. Passez en revue le résultat ou sélectionnez à nouveau l'objet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verfolgung ging in einigen Rahmen verloren. Überprüfen Sie das Ergebnis oder wählen Sie das Objekt erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento se perdió en algunos marcos. Revise el resultado o seleccione el objeto de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento foi perdido em alguns quadros. Revise o resultado ou selecione o objeto novamente."
          }
        }
      }
    },
