    "terminal.status.output_overflow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Output buffer filled while the terminal was hidden; reconnect to continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端隐藏期间输出缓冲已满，请重新连接后继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端隱藏期間輸出緩衝已滿，請重新連線後繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が非表示の間、出力バッファが満たされました。続行するには再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널이 숨겨져 있는 동안 출력 버퍼가 채워졌습니다; 계속하려면 다시 연결합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampon de sortie rempli alors que le terminal était caché ; reconnectez-vous pour continuer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgabepuffer gefüllt, während das Terminal versteckt war; verbinden, um fortzufahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El búfer de salida se llenó mientras el terminal estaba oculto; vuelva a conectar para continuar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O buffer de saída foi preenchido enquanto o terminal estava oculto; reconecte para continuar"
          }
        }
      }
    },
