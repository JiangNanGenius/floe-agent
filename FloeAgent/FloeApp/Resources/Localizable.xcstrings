    "app.bilingual.202824a749e2e6ee": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除草稿会一并删除其导出文件和助手会话；已安装的字体会保留，除非也选中了它。内置字体无法删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting drafts also removes their exports and assistant conversations. Installed fonts are kept unless selected separately. Included fonts cannot be deleted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除草稿會一併刪除其匯出檔案和助手會話；已安裝的字型會保留，除非也選中了它。內建字型無法刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラフトを削除すると、エクスポートとアシスタントの会話も削除されます。 インストールされたフォントは、別途選択しない限り保持されます。 含まれるフォントは削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초안을 삭제하면 내보내기와 보조 대화도 제거됩니다. 설치된 글꼴은 별도로 선택하지 않는 한 유지됩니다. 포함된 글꼴은 삭제할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression des brouillons supprime également leurs exportations et leurs conversations d'assistant. Les polices installées sont conservées à moins qu'elles ne soient sélectionnées séparément. Les polices incluses ne peuvent pas être supprimées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen von Entwürfen entfernt auch deren Exporte und Assistentengespräche. Installierte Schriftarten bleiben erhalten, es sei denn, sie werden separat ausgewählt. Enthaltene Schriftarten können nicht gelöscht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación de borradores también elimina sus exportaciones y conversaciones de asistente. Las fuentes instaladas se mantienen a menos que se seleccionen por separado. Las fuentes incluidas no se pueden eliminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir rascunhos também remove suas exportações e conversas assistentes. As fontes instaladas são mantidas, a menos que sejam selecionadas separadamente. As fontes incluídas não podem ser excluídas."
          }
        }
      }
    },
