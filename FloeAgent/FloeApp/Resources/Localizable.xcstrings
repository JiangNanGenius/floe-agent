    "cad.uv.stale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometry changed. Saved UV edits are kept; unwrap the current mesh to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几何已更改，原有 UV 编辑仍保留；请重新展开当前模型后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾何已更改，原有 UV 編輯仍保留；請重新展開當前模型後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジオメトリが変更されました。 保存されたUV編集は保持されます。続行するには現在のメッシュをアンラップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학이 변경되었습니다. 저장된 UV 편집이 유지됩니다; 계속하려면 현재 메쉬를 풀어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie a changé. Les modifications UV enregistrées sont conservées ; déballez le maillage actuel pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geometrie hat sich verändert. Gespeicherte UV-Bearbeitungen bleiben erhalten; entpacken Sie das aktuelle Netz, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La geometría cambió. Las ediciones UV guardadas se guardan; desenvuelve la malla actual para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometria mudou. As edições UV salvas são mantidas; desembrulhe a malha atual para continuar."
          }
        }
      }
    },
