    "app.bilingual.afd0bb39b29e3d1e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有工序随本 CAD 文档保存。修改模型后，更新加工模型并重新生成刀路。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Operations are saved with this CAD document. After changing the model, update the machining model and regenerate toolpaths."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有工序隨本 CAD 文件儲存。修改模型後，更新加工模型並重新生成刀路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この CAD ドキュメントで操作が保存されます。 モデルを変更した後、加工モデルを更新し、ツールパスを再生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업은 이 CAD 문서에 저장됩니다. 모델을 변경한 후, 가공 모델을 업데이트하고 툴패스를 재생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les opérations sont enregistrées avec ce document CAD. Après avoir changé le modèle, mettez à jour le modèle d'usinage et régénérez les chemins d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorgänge werden mit diesem CAD-Dokument gespeichert. Aktualisieren Sie nach dem Ändern des Modells das Bearbeitungsmodell und regenerieren Sie Werkzeugpfade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las operaciones se guardan con este documento CAD. Después de cambiar el modelo, actualice el modelo de mecanizado y regenere las rutas de la herramienta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As operações são salvas com este documento CAD. Depois de alterar o modelo, atualize o modelo de usinagem e regenere os caminhos da ferramenta."
          }
        }
      }
    },
