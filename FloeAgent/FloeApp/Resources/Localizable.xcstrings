    "app.cadbuilding_professional_view.geometry_could_not_be_evaluated": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成几何检查。请检查管道、风管与建筑构件是否具有封闭几何。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometry could not be evaluated. Check that pipes, ducts and building elements have closed geometry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成幾何檢查。請檢查管道、風管與建築構件是否具有封閉幾何。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジオメトリは評価できませんでした。 配管、ダクト、建築部材が閉じた形状であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학을 평가할 수 없습니다. 파이프, 덕트 및 건축 요소가 폐쇄형 기하학을 가지고 있는지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie n'a pas pu être évaluée. Vérifiez que les tuyaux, les conduits et les éléments de construction ont une géométrie fermée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geometrie konnte nicht bewertet werden. Überprüfen Sie, ob Rohre, Kanäle und Gebäudeelemente eine geschlossene Geometrie haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo evaluar la geometría. Compruebe que las tuberías, los conductos y los elementos del edificio tengan una geometría cerrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometria não pôde ser avaliada. Verifique se os tubos, dutos e elementos de construção têm geometria fechada."
          }
        }
      }
    },
    "app.cadbuilding_professional_view.some_geometry_could_not_be": {
      "extractionState": "manual",
      "localizations": {
