    "app.bilingual.918d7fc30b906c29": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在设置的“文档助手”中更改。已保存的内容和聊天记录会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this later in Settings under Document assistant. Saved content and conversation history are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可在設定的“文件助手”中更改。已儲存的內容和聊天記錄會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の「ドキュメント アシスタント」項目で後ほど変更してください。 保存されたコンテンツと会話履歴は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 도우미 아래의 설정에서 나중에 변경하십시오. 저장된 콘텐츠와 대화 기록이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez-le plus tard dans Paramètres sous l'assistant Document. Le contenu enregistré et l'historique des conversations sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändern Sie dies später in den Einstellungen unter dem Dokumentassistenten. Gespeicherte Inhalte und Konversationsverlauf werden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambie esto más tarde en Configuración en el asistente de documentos. El contenido guardado y el historial de conversaciones se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altere isso mais tarde em Configurações em Documento assistente. O conteúdo salvo e o histórico de conversas são mantidos."
          }
        }
      }
    },
