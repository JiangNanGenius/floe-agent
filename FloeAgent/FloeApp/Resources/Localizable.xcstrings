    "app.workspace_canvas_view.the_drawing_has_unsaved_edits": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸有未保存修改；点“完成”会先写入本地草稿，再应用回画布。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing has unsaved edits: Finish writes them to the local draft first, then applies to the canvas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙有未儲存修改；點“完成”會先寫入本地草稿，再應用回畫布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画に未保存の編集があります。Finish はそれらをまずローカルドラフトに書き込み、次にキャンバスに適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 그림에 저장되지 않은 편집이 있습니다: Finish는 먼저 이를 로컬 초안에 기록한 뒤 캔버스에 적용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a des modifications non enregistrées : Finish les écrit d'abord dans le brouillon local, puis s'applique à la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung hat nicht gespeicherte Bearbeitungen: Finish schreibt sie zuerst in den lokalen Entwurf und wendet sie dann auf die Leinwand an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo tiene ediciones no guardadas: Finish las escribe primero en el borrador local, luego se aplica al lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho tem edições não salvas: Finish as escreve para o rascunho local primeiro e depois se aplica à tela."
          }
        }
      }
    },
