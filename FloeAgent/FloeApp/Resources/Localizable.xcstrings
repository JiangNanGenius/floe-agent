      }
    },
    "app.bilingual.f1df3cf520f5dff2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手写笔迹将作为图像嵌入，可编辑笔迹保留在原生文件中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handwriting is embedded as an image. Editable strokes remain in the original."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手寫筆跡將作為影象嵌入，可編輯筆跡保留在原生檔案中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手書き文字は画像として埋め込まれています。 編集可能なストロークは元のもののままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손글씨가 이미지로 삽입됩니다. 편집 가능한 획은 원본에 그대로 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écriture manuscrite est intégrée en tant qu'image. Les traits modifiables restent dans l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handschrift ist als Bild eingebettet. Bearbeitbare Striche bleiben im Original erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escritura a mano está incrustada como una imagen. Los trazos editables permanecen en el original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A caligrafia é incorporada como uma imagem. Traços editáveis permanecem no original."
          }
        }
      }
    },
    "app.bilingual.28607dc07e4c62f0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公式将以图像嵌入 SVG，PDF 保留原生公式绘制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Formulas are embedded as images in SVG; PDF retains native formula drawing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公式將以影象嵌入 SVG，PDF 保留原生公式繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数式は SVG に画像として埋め込まれています；PDF はネイティブの数式描画を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공식은 SVG에 이미지로 삽입됩니다; PDF는 기본 공식 도면을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formules sont intégrées en tant qu'images dans SVG ; PDF conserve un dessin de formule natif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formeln werden als Bilder in SVG eingebettet; PDF behält native Formelzeichnung bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fórmulas se incrustan como imágenes en SVG; PDF conserva el dibujo de fórmula nativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fórmulas são incorporadas como imagens no SVG; o PDF mantém o desenho da fórmula nativa."
          }
        }
      }
    },
    "app.bilingual.ef3e7414515c5816": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大图的 PNG 分辨率已缩小；建议使用 PDF 或 SVG。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG resolution was reduced for this large diagram. Use PDF or SVG for more detail."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大圖的 PNG 解析度已縮小；建議使用 PDF 或 SVG。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG の解像度はこの大きな図のために低減されました。 詳細については、PDF または SVG をご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PNG 해상도가 이 큰 도표에 대해 감소되었습니다. 자세한 내용은 PDF 또는 SVG를 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La résolution PNG a été réduite pour ce grand diagramme. Utilisez PDF ou SVG pour plus de détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auflösung von PNG wurde für dieses große Diagramm reduziert. Verwenden Sie PDF oder SVG für weitere Details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La resolución de PNG se redujo para este diagrama grande. Utilice PDF o SVG para obtener más detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resolução do PNG foi reduzida para este diagrama grande. Use PDF ou SVG para mais detalhes."
          }
        }
      }
    },
    "app.bilingual.7ff338192581f5d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非零的依赖间隔会转换为日期，请核对排期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependency delays are converted to dates. Check the schedule."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非零的依賴間隔會轉換為日期，請核對排期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存性遅延は日付に変換されます。 スケジュールをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "의존성 지연은 날짜로 변환됩니다. 일정을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les retards de dépendance sont convertis en dates. Vérifiez l'horaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängigkeitsverzögerungen werden in Daten umgewandelt. Überprüfen Sie den Zeitplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los retrasos de la dependencia se convierten en fechas. Revisa el horario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atrasos de dependência são convertidos em datas. Verifique a programação."
          }
        }
      }
    },
    "app.bilingual.630f52f7d39a7c94": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid 依赖可能重新计算手工日期，请保留原生排期。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid dependencies may recalculate manual dates. Keep the original schedule."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid 依賴可能重新計算手工日期，請保留原生排期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーメイド依存関係は手動日付を再計算する可能性があります。 元のスケジュールをそのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인어 종속성은 수동 날짜를 다시 계산할 수 있습니다. 원래 일정을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépendances de sirène peuvent recalculer les dates manuelles. Gardez l'horaire original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meerjungfrauen-Abhängigkeiten können manuelle Daten neu berechnen. Halten Sie sich an den ursprünglichen Zeitplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dependencias de la sirena pueden volver a calcular las fechas manuales. Mantén el horario original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependências de sereia podem recalcular datas manuais. Mantenha o cronograma original."
          }
        }
      }
    },
    "app.bilingual.971d08a249411886": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次转换根导图，关联文件需要单独保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversion includes the root map. Keep linked files separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次轉換根導圖，關聯檔案需要單獨保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変換にはルートマップが含まれています。 リンクされたファイルは別々に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변환에는 루트 맵이 포함됩니다. 연결된 파일은 별도로 보관하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversion comprend la carte racine. Conservez les fichiers liés séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Konvertierung enthält die Stammkarte. Bewahren Sie verknüpfte Dateien getrennt auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversión incluye el mapa raíz. Mantenga los archivos vinculados por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversão inclui o mapa raiz. Mantenha os arquivos vinculados separados."
          }
        }
      }
    },
    "app.bilingual.d49e4fa829bd44ca": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG 中的部分图片会转换为 PNG 预览，原图保留在原生文件中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images become PNG previews in SVG. Original images remain in the editable file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG 中的部分圖片會轉換為 PNG 預覽，原圖保留在原生檔案中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SVGでは、一部の画像がPNGプレビューになります。 元の画像は編集可能なファイルに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 이미지가 SVG에서 PNG 미리보기가 됩니다. 원본 이미지는 편집 가능한 파일에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines images deviennent des aperçus PNG en SVG. Les images originales restent dans le fichier modifiable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Bilder werden zu PNG-Vorschauen in SVG. Originalbilder verbleiben in der bearbeitbaren Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas imágenes se convierten en vistas previas de PNG en SVG. Las imágenes originales permanecen en el archivo editable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas imagens se tornam visualizações PNG em SVG. As imagens originais permanecem no arquivo editável."
          }
        }
      }
    },
    "app.bilingual.3a5cd9a72e9ceb0a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG 不包含系统符号图标；PDF、PNG 和可编辑原生文件会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG does not include system-symbol icons. PDF, PNG and the editable original preserve them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG 不包含系統符號圖示；PDF、PNG 和可編輯原生檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SVGにはシステムシンボルアイコンが含まれていません。 PDF、PNG、および編集可能なオリジナルはそれらを保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG는 시스템 기호 아이콘을 포함하지 않습니다. PDF, PNG 및 편집 가능한 원본을 보존하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG n'inclut pas d'icônes de symbole système. PDF, PNG et l'original modifiable les conservent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG enthält keine Systemsymbolsymbole. PDF, PNG und das bearbeitbare Original bewahren sie auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG no incluye iconos de símbolos del sistema. PDF, PNG y el original editable los conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "SVG não inclui ícones de símbolos do sistema. PDF, PNG e o original editável os preservam."
          }
        }
      }
    },
    "app.bilingual.83f5bd91688937e9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容、结构或样式需要按目标格式转换。完整内容请保留原生文件，并查看详细说明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content or formatting needs conversion. Keep the editable original and view details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分內容、結構或樣式需要按目標格式轉換。完整內容請保留原生檔案，並檢視詳細說明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツやフォーマットは変換が必要です。 編集可能なオリジナルを保持し、詳細をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠 또는 형식은 변환이 필요합니다. 편집 가능한 원본을 유지하고 세부 정보를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains contenus ou formats nécessitent une conversion. Gardez l'original modifiable et visualisez les détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte oder Formatierungen müssen konvertiert werden. Behalten Sie das bearbeitbare Original und sehen Sie sich die Details an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos contenidos o formatos necesitan conversión. Mantenga el original editable y vea los detalles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algum conteúdo ou formatação precisa de conversão. Mantenha o original editável e visualize os detalhes."
          }
        }
      }
    },
