    "settings.agent_permissions_view.the_approval_model_gets_no_tools": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval model gets no tools and can only return allow, deny or ask; any exception falls back to ask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批模型不获得工具，只能返回允许、拒绝或询问；任何异常都会回退为询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審批模型不獲得工具，只能返回允許、拒絕或詢問；任何異常都會回退為詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認モデルはツールを取得せず、allow、deny、ask のいずれかを返すだけです。例外は ask にフォールバックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 모델은 도구가 없으며 허용, 거부 또는 ask만 반환할 수 있습니다; 모든 예외는 ask로 되돌아갑니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'approbation n'obtient aucun outil et ne peut renvoyer que permettre, refuser ou demander ; toute exception revient à demander."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Genehmigungsmodell erhält keine Werkzeuge und kann nur \"Zulassen\", \"Verweigern\" oder \"fragen\" zurückgeben; jede Ausnahme wird auf \"fragen\" zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de aprobación no recibe herramientas y solo puede devolver permitir, negar o pedir; cualquier excepción recae en preguntar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de aprovação não recebe ferramentas e só pode retornar permitir, negar ou perguntar; qualquer exceção volta para perguntar."
          }
        }
      }
    },
    "settings.agent_permissions_view.the_approval_model_setting_was_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval model setting was not fully saved: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "审批模型设置未完整保存：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "審批模型設定未完整儲存：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認モデル設定が完全に保存されていません: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 모델 설정이 완전히 저장되지 않았습니다: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
