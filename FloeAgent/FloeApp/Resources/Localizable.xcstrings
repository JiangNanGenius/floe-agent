    "app.bilingual.c6ae62b676f63ad1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预设会替换相应属性的关键帧。其他动画保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaces keyframes for the preset's properties. Other animation stays."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設會替換相應屬性的關鍵幀。其他動畫保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットのプロパティのキーフレームを置き換えます。 他のアニメーションは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋 속성의 키프레임을 교체합니다. 다른 애니메이션은 그대로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les images clés pour les propriétés du préréglage. D'autres séjours d'animation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt Keyframes für die Eigenschaften der Voreinstellung. Andere Animation bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplaza los fotogramas clave para las propiedades del preajuste. Otra animación se queda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui os quadros-chave para as propriedades da predefinição. Outra animação permanece."
          }
        }
      }
    },
