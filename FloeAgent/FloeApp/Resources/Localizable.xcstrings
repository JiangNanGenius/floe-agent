    "app.bilingual.c96e7e2452186f2b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前游戏中没有此引擎的资源归档或加密图片、音频。散装文件可在 IDE 中查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game has no asset archive or encrypted images or audio for its engine. Loose files are available in the IDE."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前遊戲中沒有此引擎的資源歸檔或加密圖片、音訊。散裝檔案可在 IDE 中檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームには、エンジン用のアセットアーカイブや暗号化された画像、音声がありません。 IDEで緩いファイルが利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임은 엔진에 대한 자산 아카이브나 암호화된 이미지, 오디오가 없습니다. IDE에서 느슨한 파일을 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu n'a pas d'archive d'actifs ni d'images ou d'audio cryptés pour son moteur. Des fichiers en vrac sont disponibles dans l'IDE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel hat kein Asset-Archiv oder verschlüsselte Bilder oder Audio für seine Engine. Lose Dateien sind in der IDE verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego no tiene archivo de activos ni imágenes o audio cifrados para su motor. Los archivos sueltos están disponibles en el IDE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo não tem arquivo de ativos ou imagens criptografadas ou áudio para seu mecanismo. Arquivos soltos estão disponíveis no IDE."
          }
        }
      }
    },
