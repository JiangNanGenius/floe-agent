    "settings.data_management_view.cleanup_environment_fallback_reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real environment state when the app container root is unavailable; never deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用容器根不可用时的真实环境状态；绝不删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用容器根不可用時的真實環境狀態；絕不刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリコンテナのルートが利用できない場合の実環境状態で、決して削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 컨테이너 루트가 사용 불가능할 때 실제 환경 상태; 절대 삭제되지 않음."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de l'environnement réel lorsque la racine du conteneur d'applications n'est pas disponible ; jamais supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Realer Umgebungszustand, wenn das App-Container-Root nicht verfügbar ist; nie gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de entorno real cuando la raíz del contenedor de la aplicación no está disponible; nunca se elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de ambiente real quando a raiz do contêiner do aplicativo não está disponível; nunca excluído."
          }
        }
      }
    },
    "settings.data_management_view.cleanup_estimate_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safe-to-clean figure only counts items whose owner is proven idle and that pass the age/retention rules at estimate time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“可安全清理”仅计入估算时所有者已被证明空闲且通过时间/保留规则的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“可安全清理”僅計入估算時所有者已被證明空閒且透過時間/保留規則的專案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に清掃できる数値は、所有者が未使用であることが証明され、推定時点で年齢・保持規則を通過した項目のみをカウントします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전하게 청소할 수 있는 수치는 소유자가 유휴 상태임이 입증되고 추정 시점에 연령·보류 규칙을 통과한 항목만을 계산합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiffre de la sécurité pour nettoyer ne compte que les articles dont le propriétaire est inactif et qui passent les règles d'âge/de rétention au moment estimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Safe-to-Clean-Zahl zählt nur Gegenstände, deren Besitzer nachweislich untätig ist und die die Alters-/Retentionsregeln zum geschätzten Zeitpunkt bestehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cifra de seguridad para la limpieza solo cuenta los artículos cuyo propietario está inactivo y que pasan las reglas de edad/retención en el momento estimado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A figura segura para limpar conta apenas itens cujo proprietário está ocioso e que passam pelas regras de idade/retenção no tempo estimado."
          }
        }
      }
    },
    "settings.data_management_view.cleanup_no_registered_candidates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No deletable cleanup candidates are registered; unregistered scratch is retained. User data is never touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已注册的可清理候选项；未注册暂存一律保留。绝不触碰用户数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已註冊的可清理候選項；未註冊暫存一律保留。絕不觸碰使用者資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除可能なクリーンアップ候補は登録されていません；未登録のスクラッチは保持されます。 ユーザーデータは決して触れられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제 가능한 정리 후보가 등록되지 않았으며, 등록되지 않은 스크래치는 보관됩니다. 사용자 데이터는 절대 손대지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun candidat de nettoyage supprimable n'est enregistré ; la rayure non enregistrée est conservée. Les données des utilisateurs ne sont jamais touchées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine löschbaren Bereinigungskandidaten registriert; nicht registrierter Kratzer bleibt erhalten. Benutzerdaten werden nie berührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se registran candidatos de limpieza borrables; se conserva el scratch no registrado. Los datos del usuario nunca se tocan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum candidato de limpeza apagável é registrado; o rascunho não registrado é mantido. Os dados do usuário nunca são tocados."
          }
        }
      }
    },
    "settings.data_management_view.cleanup_nothing_eligible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was eligible: owners were busy/unproven, items were recent, or only retained data matched. No user data was touched."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有符合条件的项目：所有者忙碌/无法证明空闲、项目较新，或仅命中保留数据。未触碰任何用户数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有符合條件的專案：所有者忙碌/無法證明空閒、專案較新，或僅命中保留資料。未觸碰任何使用者資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象外でした：所有者が忙しい/未証明、アイテムが最近のもの、または保持されたデータのみが一致していました。 ユーザーデータには触れられていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격이 되는 항목이 없습니다: 소유자가 바쁘거나 검증되지 않은 경우, 항목이 최근인 경우, 혹은 보유 데이터만 일치했습니다. 사용자 데이터가 손대지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'était éligible : les propriétaires étaient occupés/non prouvés, les articles étaient récents ou seules les données conservées étaient appariées. Aucune donnée utilisateur n'a été touchée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts war berechtigt: Eigentümer waren beschäftigt/unbewiesen, Artikel waren neu oder nur beibehaltenen Daten wurden übereinbart. Es wurden keine Benutzerdaten berührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada era elegible: los propietarios estaban ocupados/no probados, los artículos eran recientes o solo los datos retenidos coincidían. No se tocaron los datos del usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada era elegível: os proprietários estavam ocupados/não comprovados, os itens eram recentes ou apenas os dados retidos correspondidos. Nenhum dado do usuário foi tocado."
          }
        }
      }
    },
    "settings.data_management_view.cleanup_observed_allocation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observed allocation change: %@. This is the change in measured allocated bytes, not an exact physical reclaim (shared/cloned blocks may not be returned to the volume)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已分配空间观察变化：%@。这是实测已分配字节的变化，并非精确的物理释放量（共享/克隆块可能未归还卷）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已分配空間觀察變化：%@。這是實測已分配位元組的變化，並非精確的物理釋放量（共享/克隆塊可能未歸還卷）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観測された割り当ての変化: %@. これは測定された割り当てバイト数の変化であり、正確な物理的リクレイムではありません（共有/クローンされたブロックはボリュームに戻らない可能性があります）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관찰된 할당 변경: %@. 이는 측정된 할당 바이트의 변화이며, 정확한 물리적 복구가 아닙니다(공유/복제된 블록은 볼륨으로 반환되지 않을 수 있습니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changement d'allocation observé : %@. Il s'agit du changement d'octets alloués mesurés, et non d'une récupération physique exacte (les blocs partagés/clonés ne peuvent pas être retournés au volume)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beobachtete Zuordnungsänderung: %@. Dies ist die Änderung der gemessenen zugewiesenen Bytes, nicht eine exakte physische Rückgewinnung (gemeinsame/geklonte Blöcke können nicht auf das Volumen zurückgegeben werden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambio de asignación observado: %@. Este es el cambio en los bytes asignados medidos, no una recuperación física exacta (los bloques compartidos/clonados no pueden ser devueltos al volumen)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudança de alocação observada: %@. Esta é a mudança nos bytes alocados medidos, não uma recuperação física exata (blocos compartilhados/clonados podem não ser retornados ao volume)."
          }
        }
      }
    },
