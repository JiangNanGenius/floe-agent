    "app.workbench_center.the_source_is_above_the": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片尺寸 %@×%@ 超过编辑上限，已创建最长边 %@ 像素的缩放工作副本；导出将按该尺寸输出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source is %@×%@, above the editing budget; a scaled working copy with a %@px longest edge was created and export follows that size."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片尺寸 %@×%@ 超過編輯上限，已建立最長邊 %@ 畫素的縮放工作副本；匯出將按該尺寸輸出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースは %@×%@ で、編集予算を上回っています；%@px の最長エッジを持つスケーリングされた作業コピーが作成され、エクスポートはそのサイズに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스는 %@×%@이며, 편집 예산을 초과합니다; %@px 최장 가장자리를 가진 확장된 작업 복사본이 생성되었으며, 내보내기가 해당 크기를 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source est %@×%@, au-dessus du budget d'édition ; une copie de travail à l'échelle avec un bord le plus long %@px a été créée et l'exportation suit cette taille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle ist %@×%@, über dem Bearbeitungsbudget; eine skalierte Arbeitskopie mit einer %@px längsten Kante wurde erstellt und der Export folgt dieser Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente es %@×%@, por encima del presupuesto de edición; se creó una copia de trabajo a escala con un borde más largo de %@px y la exportación sigue ese tamaño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte é %@×%@, acima do orçamento de edição; uma cópia de trabalho dimensionada com uma borda mais longa %@px foi criada e a exportação segue esse tamanho."
          }
        }
      }
    },
