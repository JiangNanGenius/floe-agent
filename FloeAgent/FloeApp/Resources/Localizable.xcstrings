    "cad.material.stale.removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stale face assignments were removed. Undo restores them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除失效的面分配。撤销可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除失效的面分配。撤銷可恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い顔の割り当ては削除されました。 元に戻すと復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테일 페이스 할당이 제거되었습니다. 실행 취소는 복원됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les affectations de visage périmées ont été supprimées. Annuler les restaure."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgestandene Gesichtszuweisungen wurden entfernt. Rückgängig stellt sie wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminaron las asignaciones de rostros ranchos. Deshacerlos los restaura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atribuições de rosto obsoleto foram removidas. Desfazer os restaura."
          }
