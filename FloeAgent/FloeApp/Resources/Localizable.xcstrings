    "cad.recovery.item.changesSincePrevious": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes made after this save can't be verified. Their fields are unknown; they stay in the damaged document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次保存之后的更改无法验证，具体字段未知；它们仍保留在损坏文档中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此次儲存之後的更改無法驗證，具體欄位未知；它們仍保留在損壞文件中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存後に行われた変更は検証できません。 それらのフィールドは不明です；それらは破損した文書に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장 후에 이루어진 변경 사항은 확인할 수 없습니다. 그들의 필드는 알 수 없으며, 손상된 문서에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications apportées après cet enregistrement ne peuvent pas être vérifiées. Leurs champs sont inconnus ; ils restent dans le document endommagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen, die nach diesem Speichern vorgenommen werden, können nicht überprüft werden. Ihre Felder sind unbekannt; sie bleiben im beschädigten Dokument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios realizados después de este guardado no se pueden verificar. Sus campos son desconocidos; se quedan en el documento dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações feitas após esse salvamento não podem ser verificadas. Seus campos são desconhecidos; eles permanecem no documento danificado."
          }
        }
      }
    },
