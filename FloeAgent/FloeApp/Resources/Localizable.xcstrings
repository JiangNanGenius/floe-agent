    "app.game_runtime_resource_registry.the_installed_engine_pack_failed": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装引擎包校验失败。点按重试会先移除该未验证目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed engine pack failed verification. Retry removes the unverified directory first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已安裝引擎包校驗失敗。點按重試會先移除該未驗證目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされたエンジンパックの検証に失敗しました。 再試行は、まず未検証のディレクトリを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 엔진 팩이 검증에 실패했습니다. 재시도하면 검증되지 않은 디렉터리가 먼저 제거됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pack moteur installé a échoué à la vérification. Réessayer supprime d'abord le répertoire non vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierte Engine-Pack-Überprüfung fehlgeschlagen. Der erneute Versuch entfernt zuerst das nicht verifizierte Verzeichnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete del motor instalado no se verificó. Reintentar elimina primero el directorio no verificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote do motor instalado falhou na verificação. Tente novamente remove o diretório não verificado primeiro."
          }
        }
      }
    },
