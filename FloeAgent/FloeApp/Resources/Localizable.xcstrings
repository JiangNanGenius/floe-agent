          "stringUnit": {
            "state": "translated",
            "value": "Grave ou importe mídia e, em seguida, transcreva-a primeiro."
          }
        }
      }
    },
    "app.bilingual.1d1d936509e26319": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音已保存。请在会议设置中选择转写服务，再重试未完成片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recording is saved. Choose a transcription service in meeting settings, then retry unfinished chunks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音已儲存。請在會議設定中選擇轉寫服務，再重試未完成片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音が保存されました。 会議設定で文字起こしサービスを選択し、未完了のチャンクを再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 저장되었습니다. 회의 설정에서 전사 서비스를 선택한 다음, 미완료된 청크를 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est enregistré. Choisissez un service de transcription dans les paramètres de réunion, puis réessayez les morceaux inachevés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wird gespeichert. Wählen Sie einen Transkriptionsdienst in den Meeting-Einstellungen aus, und versuchen Sie es dann erneut mit unvollendeten Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación está guardada. Elija un servicio de transcripción en la configuración de la reunión, luego vuelva a intentar los fragmentos sin terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação está salva. Escolha um serviço de transcrição nas configurações de reunião e, em seguida, tente novamente os trechos inacabados."
          }
        }
      }
    },
    "app.bilingual.3cbf7d333cf97d5": {
      "extractionState": "manual",
