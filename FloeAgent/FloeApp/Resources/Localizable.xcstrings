    "workspace.workspace_canvas_view.reads_the_selected_nodes_and_their": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the selected nodes and their upstream nodes in canvas connection order; the original nodes are always kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会按画布连接顺序读取所选节点及其上游节点；原节点始终保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會按畫布連線順序讀取所選節點及其上游節點；原節點始終保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したノードとそれらの上流ノードをキャンバス接続順に読み取ります；元のノードは常に保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 노드와 해당 업스트림 노드를 캔버스 연결 순서대로 읽으며, 원본 노드는 항상 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les nœuds sélectionnés et leurs nœuds en amont dans l'ordre de connexion du canevas ; les nœuds d'origine sont toujours conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die ausgewählten Knoten und ihre vorgelagerten Knoten in der Reihenfolge der Canvas-Verbindung; die ursprünglichen Knoten werden immer beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee los nodos seleccionados y sus nodos ascendentes en orden de conexión del lienzo; los nodos originales siempre se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê os nós selecionados e seus nós upstream na ordem de conexão da tela; os nós originais são sempre mantidos."
          }
        }
      }
    },
