        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geschichte ist kurz genug; keine Verdichtung erforderlich und die Originalaufzeichnungen sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La historia es lo suficientemente corta; no se necesita compactación y los registros originales no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A história é curta o suficiente; nenhuma compactação necessária e os registros originais permanecem inalterados."
          }
        }
      }
    },
