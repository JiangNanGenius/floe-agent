    "design.owner.feedback_stale_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bound revision moved. Relocate the anchor first; feedback resolves only against a verified changing revision."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绑定的版本已变化。请先重新定位锚点；反馈只会在已校验的实际变更版本上完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繫結的版本已變化。請先重新定位錨點；反饋只會在已校驗的實際變更版本上完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バインドされたリビジョンが移動しました。 まずアンカーを移動してください；フィードバックは検証された変更リビジョンに対してのみ解決されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바인딩된 리비전이 이동되었습니다. 먼저 앵커를 재배치하십시오; 피드백은 검증된 변경된 리비전에 대해서만 해결됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révision liée a bougé. Déployez d'abord l'ancre ; la rétroaction ne se résout qu'avec une révision de changement vérifiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gebundene Revision hat sich verschoben. Versetzen Sie zuerst den Anker; das Feedback löst sich nur gegen eine verifizierte Änderungsrevision auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión encuadernada se movió. Reubique el ancla primero; la retroalimentación se resuelve solo contra una revisión de cambio verificada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão vinculada mudou. Reloque a âncora primeiro; o feedback resolve apenas contra uma revisão de mudança verificada."
          }
        }
      }
    },
