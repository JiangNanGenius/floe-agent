    "app.bilingual.614ece9a112ae843": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区已切换；此处仍显示“%@”。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current workspace changed; this still shows “%@”."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前工作區已切換；此處仍顯示“%@”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークスペースが変更されましたが、依然として「%@」と表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간이 변경되었습니다; 여전히 “%@”가 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de travail actuel a changé ; cela montre toujours \"%@\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Arbeitsbereich hat sich geändert; hier wird immer noch \"%@\" angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo actual ha cambiado; esto todavía muestra \"%@\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho atual mudou; isso ainda mostra “%@”."
          }
        }
      }
    },
