    "notes.note_element_inspector.edits_and_deletions_can_both_be": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits and deletions can both be restored with the note's Undo button."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改和删除均可通过手记的撤销按钮恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改和刪除均可透過手記的撤銷按鈕恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集と削除は、ノートの元に戻すボタンで両方とも復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 및 삭제는 메모의 실행 취소 버튼을 사용하여 모두 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications et les suppressions peuvent être restaurées à l'aide du bouton Annuler de la note."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitungen und Löschungen können sowohl mit der Rückgängig-Schaltfläche der Notiz wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanto las ediciones como las eliminaciones se pueden restaurar con el botón Deshacer de la nota."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edições e exclusões podem ser restauradas com o botão Desfazer da nota."
          }
        }
      }
    },
