            "value": "네이티브 라이브러리에 설치되었습니다. 기존 부품 선택기에서 배치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé dans la bibliothèque native. Placez-le à partir du sélecteur de pièces existant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der nativen Bibliothek installiert. Platzieren Sie es aus der vorhandenen Teileauswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado en la biblioteca nativa. Colocarlo desde el selector de piezas existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado na biblioteca nativa. Coloque-o a partir do seletor de peças existente."
          }
        }
      }
    },
    "app.bilingual.dbeb0e67364de500": {
