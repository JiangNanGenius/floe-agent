    "app.bilingual.fa8d8b74edd3d573": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览与导出使用同一颜色格式，原素材保持不变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview and export use the same color format. Original media is preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽與匯出使用同一顏色格式，原素材保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューとエクスポートは同じ色形式を使用します。 元のメディアは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기와 내보내기는 동일한 색상 형식을 사용합니다. 원본 미디어가 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prévisualisation et l'exportation utilisent le même format de couleur. Les médias originaux sont préservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau und Export verwenden das gleiche Farbformat. Die Originalmedien sind erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa y la exportación utilizan el mismo formato de color. Los medios originales se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização e a exportação usam o mesmo formato de cores. A mídia original é preservada."
          }
        }
      }
    },
