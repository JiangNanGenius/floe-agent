    "app.bilingual.bd3844b8ffc87408": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时对话不会保留导出文件。请在普通任务或手记中导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary chats do not keep exported files. Export from an ordinary task or from Notes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時對話不會保留匯出檔案。請在普通任務或手記中匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットはエクスポートされたファイルを保持しません。 通常のタスクまたはノートからエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 채팅은 내보낸 파일을 보관하지 않습니다. 일반 작업 또는 메모에서 내보내기."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chats temporaires ne conservent pas les fichiers exportés. Exporter à partir d'une tâche ordinaire ou de Notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre Chats behalten keine exportierten Dateien. Exportieren Sie aus einer normalen Aufgabe oder aus Notizen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats temporales no guardan archivos exportados. Exportar desde una tarea ordinaria o desde Notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bate-papos temporários não mantêm arquivos exportados. Exportar de uma tarefa comum ou de Notas."
          }
        }
      }
    },
    "app.document_export_service.the_live_office_editor_could": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前 Office 编辑器无法证明本文件已保存且静止（状态=%@，原因=%@）%@。未导出任何文件；请等当前操作完成或抬笔后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live Office editor could not prove a saved, quiescent state for this exact document (outcome=%@, reason=%@)%@. Nothing was exported; wait for the current operation or lift the pen, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前 Office 編輯器無法證明本檔案已儲存且靜止（狀態=%@，原因=%@）%@。未匯出任何檔案；請等當前操作完成或抬筆後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブの Office エディタは、この正確なドキュメントに対して保存された静止状態を証明できませんでした（outcome=%@, reason=%@）%@. 何もエクスポートされませんでした。現在の操作を待つか、ペンを持ち上げてから、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 Office 편집기가 이 정확한 문서에 대해 저장된 정지 상태를 증명할 수 없었습니다 (outcome=%@, reason=%@)%@. 아무것도 내보내지 않았습니다; 현재 작업이 진행 중일 때까지 기다리시거나 펜을 들어 올리시고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur Office en direct n'a pas pu prouver un état enregistré et silencieux pour ce document exact (outcome=%@, reason=%@)%@. Rien n'a été exporté ; attendez l'opération en cours ou soulevez le stylo, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Office-Editor konnte keinen gespeicherten, ruhenden Zustand für genau dieses Dokument nachweisen (outcome=%@, reason=%@)%@. Nichts wurde exportiert; warten Sie auf den aktuellen Vorgang oder heben Sie den Stift an, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de Office en vivo no pudo probar un estado guardado y en reposo para este documento exacto (resultado=%@, razón=%@)%@. No se exportó nada; espere la operación actual o levante el bolígrafo, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor do Office ao vivo não pôde provar um estado salvo e quiescente para este documento exato (resultado=%@, razão=%@)%@. Nada foi exportado; aguarde a operação atual ou levante a caneta, depois tente novamente."
          }
        }
      }
    },
    "app.bilingual.65e75789376c2109": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出期间 Office 编辑器已关闭或切换；未导出任何文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live Office editor closed or switched during the save; nothing was exported."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出期間 Office 編輯器已關閉或切換；未匯出任何檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存中にライブの Office エディタが閉じるか切り替えましたが、何もエクスポートされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 Office 편집기가 저장 중에 닫히거나 전환되었으며, 아무것도 내보내지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur Office en direct s'est fermé ou a basculé pendant l'enregistrement ; rien n'a été exporté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Office-Editor wurde während des Speicherns geschlossen oder gewechselt; es wurde nichts exportiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de Office en vivo se cerró o cambió durante el guardado; no se exportó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor do Office ao vivo fechou ou trocou durante o salvamento; nada foi exportado."
          }
        }
      }
    },
    "app.bilingual.32bffb81715941df": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出期间 Office 编辑器已关闭或切换；已丢弃本次导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The live Office editor closed or switched during the export; the produced file was discarded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出期間 Office 編輯器已關閉或切換；已丟棄本次匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート中にライブの Office エディタが終了または切り替わり、生成されたファイルは破棄されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 Office 편집기가 내보내는 동안 닫히거나 전환되었으며, 생성된 파일은 폐기되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur Office en direct s'est fermé ou changé pendant l'exportation ; le fichier produit a été supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Office-Editor wurde während des Exports geschlossen oder umgeschaltet; die erzeugte Datei wurde verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor de Office en vivo se cerró o cambió durante la exportación; el archivo producido fue descartado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor do Office ao vivo fechou ou trocou durante a exportação; o arquivo produzido foi descartado."
          }
        }
      }
    },
