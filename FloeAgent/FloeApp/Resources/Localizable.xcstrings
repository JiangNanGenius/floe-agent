    "app.bilingual.41cb79defbfd4444": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存尚未完成：编辑仍在进行。更改已保留，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save did not finish: edits are still arriving. Your changes are kept; retry in a moment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存尚未完成：編輯仍在進行。更改已保留，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存が完了していません：編集はまだ届いていません。 変更は保持されますので、しばらくして再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장이 완료되지 않았습니다: 편집이 아직 도착하고 있습니다. 귀하의 변경 사항은 보관됩니다; 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n'est pas terminée : les modifications arrivent toujours. Vos modifications sont conservées ; réessayez dans un instant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherstand wurde nicht abgeschlossen: Die Bearbeitungen kommen noch an. Ihre Änderungen werden beibehalten; versuchen Sie es gleich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado no se terminó: las ediciones aún están llegando. Sus cambios se mantienen; inténtelo de nuevo en un momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar não terminou: as edições ainda estão chegando. Suas alterações são mantidas; tente novamente em um momento."
          }
        }
      }
    },
