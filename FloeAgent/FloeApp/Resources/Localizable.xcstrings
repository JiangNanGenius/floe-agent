    "cad.datum.selectedFaceHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reselects this datum's source from the face currently held by the native picker."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用原生选择器当前选中的面重新指定该基准面的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用原生選擇器當前選中的面重新指定該基準面的來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブピッカーが現在保持している顔から、このデータのソースを再選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 피커가 현재 보유하고 있는 얼굴에서 이 날짜의 소스를 다시 선택합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résélectionne la source de cette donnée à partir du visage actuellement détenu par le sélecteur natif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt die Quelle dieses Datums erneut aus dem Gesicht aus, das derzeit vom nativen Kommissionierer gehalten wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
