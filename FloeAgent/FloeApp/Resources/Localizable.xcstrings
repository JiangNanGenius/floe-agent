    "design.owner.protection_rearm_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was adopted, but the write protection could not be re-established. The original stays protected (further automatic writes are refused); retry or restart the app to recover."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变更已采用，但写保护重建失败。原件仍受保护（后续自动写入会被拒绝）；请重试或重启应用恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更已採用，但防寫重建失敗。原件仍受保護（後續自動寫入會被拒絕）；請重試或重啟應用恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は採用されましたが、書き込み保護は再確立できませんでした。 元のものは保護されたままです（自動書き込みは拒否されます）；復元するには、再試行するかアプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경이 채택되었지만, 쓰기 보호를 재설정할 수 없었습니다. 원본은 보호된 상태를 유지합니다(추가 자동 쓰기는 거부됩니다); 복구를 위해 앱을 재시도하거나 재시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement a été adopté, mais la protection en écriture n'a pas pu être rétablie. L'original reste protégé (d'autres écritures automatiques sont refusées) ; réessayez ou redémarrez l'application pour récupérer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde übernommen, aber der Schreibschutz konnte nicht wiederhergestellt werden. Das Original bleibt geschützt (weitere automatische Schreibvorgänge werden abgelehnt); versuchen Sie es erneut oder starten Sie die App neu, um sich wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adoptó el cambio, pero no se pudo restablecer la protección de escritura. El original permanece protegido (se rechazan más escrituras automáticas); reintente o reinicie la aplicación para recuperarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mudança foi adotada, mas a proteção contra gravação não pôde ser restabelecida. O original permanece protegido (outras gravações automáticas são recusadas); tente novamente ou reinicie o aplicativo para recuperar."
          }
        }
      }
    },
