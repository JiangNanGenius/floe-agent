    "notes.mindmap.hint.connection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag onto a target topic to connect; tap empty space to cancel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖到目标主题上松手完成连接；点按空白取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖到目標主題上鬆手完成連線；點按空白取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象トピックにドラッグして接続し、空欄をタップしてキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 토픽에 끌어다 놓아 연결하십시오; 빈 공간을 탭하여 취소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers un sujet cible pour vous connecter ; appuyez sur espace vide pour annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie auf ein Zielthema, um eine Verbindung herzustellen; tippen Sie auf Leerzeichen, um abzubrechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre a un tema de destino para conectarse; toque espacio vacío para cancelar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para um tópico de destino para se conectar; toque em espaço vazio para cancelar."
          }
        }
      }
    },
    "notes.mindmap.hint.invalidReparent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A topic cannot move into its own branch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把主题移动到它自己的分支里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能把主題移動到它自己的分支裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トピックは独自のブランチに移動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주제는 자체 브랜치로 이동할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sujet ne peut pas entrer dans sa propre branche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Thema kann sich nicht in seinen eigenen Zweig bewegen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tema no puede pasar a su propia rama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um tópico não pode se mover para seu próprio ramo."
          }
        }
      }
    },
    "notes.mindmap.hint.noSelectionChild": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a topic first, then add a child topic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先选择主题，再新增子节点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先選擇主題，再新增子節點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずトピックを選択し、次に子トピックを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 주제를 선택한 다음, 하위 주제를 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez d'abord un sujet, puis ajoutez un sujet enfant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie zuerst ein Thema aus und fügen Sie dann ein untergeordnetes Thema hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un tema primero, luego agregue un tema secundario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um tópico primeiro e, em seguida, adicione um tópico filho."
          }
        }
      }
    },
    "notes.mindmap.hint.noSelectionSibling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a reference topic first, then add a sibling topic."
          }
        },
