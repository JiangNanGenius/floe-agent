    "design.panel.authorized_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized: the assistant may adopt this candidate once with a single-use grant."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已授权：助手可用一次性凭据采纳此候选一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已授權：助手可用一次性憑據採納此候選一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認可: アシスタントは、この候補者を一度、シングルユース助成金で養子縁組できる。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인: 보조자는 단일 사용 보조금으로 이 후보자를 한 번 채택할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé : l'assistant peut adopter ce candidat une fois avec une subvention à usage unique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisiert: Der Assistent kann diesen Kandidaten einmal mit einem Einmalzuschuss adoptieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizado: el asistente puede adoptar a este candidato una vez con una subvención de un solo uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorizado: o assistente pode adotar este candidato uma vez com uma concessão de uso único."
          }
        }
      }
    },
