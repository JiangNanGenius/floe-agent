    "settings.content_updates.policy.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every update is verified against the app's fixed signing key before it can be activated. Blocked or incompatible versions are kept, never implicitly installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有更新在激活前都会通过应用固定签名密钥验证。被阻止或不兼容的版本会保留，绝不隐式安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有更新在啟用前都會透過應用固定簽名金鑰驗證。被阻止或不相容的版本會保留，絕不隱式安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアップデートは、アプリの固定署名キーに対して検証され、アクティベートできるようになります。 ブロックされたバージョンや互換性のないバージョンは保持され、暗黙的にインストールされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 업데이트는 활성화되기 전에 앱의 고정 서명 키에 대해 검증됩니다. 차단되었거나 호환되지 않는 버전은 유지되며, 절대로 암묵적으로 설치되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mise à jour est vérifiée par rapport à la clé de signature fixe de l'application avant de pouvoir être activée. Les versions bloquées ou incompatibles sont conservées, jamais implicitement installées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Update wird anhand des festen Signaturschlüssels der App überprüft, bevor es aktiviert werden kann. Gesperrte oder inkompatible Versionen werden beibehalten, niemals implizit installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada actualización se verifica con la clave de firma fija de la aplicación antes de que se pueda activar. Las versiones bloqueadas o incompatibles se mantienen, nunca se instalan implícitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada atualização é verificada em relação à chave de assinatura fixa do aplicativo antes de poder ser ativada. Versões bloqueadas ou incompatíveis são mantidas, nunca instaladas implicitamente."
          }
        }
      }
    },
