    "workspace.engineering_review_sheet.scope_visible_content_in_the_current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scope: visible content in the current viewport; screenshots are the primary evidence."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围：当前视口中的可见内容，截图为主证据。"
