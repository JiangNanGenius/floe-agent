    "cad.building.check.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some building elements no longer have model geometry. Rebuild or review them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分建筑构件缺少模型几何，请重新生成或检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分建築構件缺少模型幾何，請重新生成或檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の建築要素は、もはやモデルジオメトリを持っていません。 それらを再構築するか、レビューしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 건축 요소는 더 이상 모델 기하학을 가지고 있지 않습니다. 다시 구축하거나 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments de construction n'ont plus de géométrie de modèle. Reconstruisez-les ou examinez-les."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Gebäudeelemente haben keine Modellgeometrie mehr. Bauen Sie sie um oder überprüfen Sie sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos elementos de construcción ya no tienen geometría de modelo. Reconstruyelos o revísalos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns elementos de construção não têm mais geometria de modelo. Reconstrua ou revise-os."
          }
        }
      }
    },
    "cad.building.rules.missing": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the region, use and code edition, then add sourced rules to evaluate them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择地区、用途和规范版本，再添加有来源的规则进行检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇地區、用途和規範版本，再新增有來源的規則進行檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地域を選択し、使用し、エディションをコードし、次にそれらを評価するためにソースルールを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지역을 선택하고, 사용 및 코드 에디션을 선택한 다음, 이를 평가하기 위해 소스 규칙을 추가하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la région, utilisez et codez l'édition, puis ajoutez des règles source pour les évaluer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Region, die Verwendung und die Codeausgabe und fügen Sie dann Quellregeln hinzu, um sie auszuwerten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la región, el uso y la edición de código, luego agregue reglas de origen para evaluarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a região, o uso e a edição de código e, em seguida, adicione regras de origem para avaliá-las."
          }
        }
      }
    },
