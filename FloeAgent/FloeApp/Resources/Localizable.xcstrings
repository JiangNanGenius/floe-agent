    "setup.features.background.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture keeps active tasks visible in the background; screen access is requested only when needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画中画在后台展示活动任务；屏幕权限只在任务确实需要时申请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫中畫在後臺展示活動任務；螢幕許可權只在任務確實需要時申請。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクチャー・イン・ピクチャーは、アクティブなタスクをバックグラウンドで表示し、画面へのアクセスは必要な場合にのみ要求されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture는 활성 작업을 백그라운드에서 표시하도록 유지하며, 화면 접근은 필요할 때만 요청됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture garde les tâches actives visibles en arrière-plan ; l'accès à l'écran n'est demandé qu'en cas de besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bild in Bild hält aktive Aufgaben im Hintergrund sichtbar; Bildschirmzugriff wird nur bei Bedarf angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture mantiene las tareas activas visibles en el fondo; el acceso a la pantalla se solicita solo cuando es necesario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Picture in Picture mantém as tarefas ativas visíveis em segundo plano; o acesso à tela é solicitado somente quando necessário."
          }
        }
      }
    },
    "setup.features.background.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background continuity"
          }
        },
