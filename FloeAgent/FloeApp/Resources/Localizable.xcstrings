    "cad.native.import_surface_limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open surfaces are exact B-rep bodies: move, rotate, scale, material and IGES re-export work; boolean, fillet and shell need closed solids."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开放曲面为精确 B-rep 实体：可移动、旋转、缩放、赋材质并重新导出 IGES；布尔、圆角与抽壳需要封闭实体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開放曲面為精確 B-rep 實體：可移動、旋轉、縮放、賦材質並重新匯出 IGES；布林、圓角與抽殼需要封閉實體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンサーフェスは正確なBレップ体であり、移動、回転、スケーリング、材料、そしてIGES再エクスポート作業です；ブール、フィレット、シェルは閉じた実体が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 표면은 정확한 B-rep 몸체이며, 이동, 회전, 스케일링, 재질 및 IGES 재수출 작업을 포함합니다; 불리언, 필렛 및 쉘은 닫힌 솔리드가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les surfaces ouvertes sont des corps B-rep exacts : déplacer, tourner, mettre à l'échelle, le matériel et le travail de réexportation IGES ; le booléen, le filet et la coque ont besoin de solides fermés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Oberflächen sind exakte B-Rep-Körper: Bewegen, Drehen, Skalieren, Material und IGES-Reexportarbeiten; boolesch, Filet und Schale benötigen geschlossene Feststoffe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las superficies abiertas son cuerpos B-rep exactos: movimiento, rotación, escala, trabajo de reexportación de material e IGES; booleano, filete y cáscara necesitan sólidos cerrados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Superfícies abertas são corpos B-rep exatos: movimento, rotação, escala, material e trabalho de reexportação IGES; booleano, filé e shell precisam de sólidos fechados."
          }
        }
      }
    },
    "cad.exactSurface.refused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs a closed solid. This exact open surface was left unchanged; move, rotate, scale, material and IGES export still work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要封闭实体。此精确开放曲面未更改；仍可移动、旋转、缩放、赋材质和导出 IGES。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要封閉實體。此精確開放曲面未更改；仍可移動、旋轉、縮放、賦材質和匯出 IGES。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は閉じた固体が必要です。 この正確なオープンサーフェスは変更されず、移動、回転、スケール、マテリアル、そして IGES エクスポートは引き続き機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 닫힌 고체가 필요합니다. 이 정확한 개방 표면은 그대로 유지되었으며, 이동, 회전, 스케일링, 재료 및 IGES 내보내기가 여전히 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin d'un solide fermé. Cette surface ouverte exacte a été laissée inchangée ; le déplacement, la rotation, l'échelle, le matériel et l'exportation IGES fonctionnent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ benötigt einen geschlossenen Körper. Genau diese offene Fläche wurde unverändert gelassen; Bewegung, Drehung, Skalierung, Material- und IGES-Export funktionieren immer noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ necesita un sólido cerrado. Esta superficie abierta exacta se dejó sin cambios; el movimiento, la rotación, la escala, el material y la exportación de IGES siguen funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ precisa de um sólido fechado. Esta superfície aberta exata foi deixada inalterada; movimento, rotação, escala, material e exportação IGES ainda funcionam."
          }
        }
      }
    },
