    "content.update.error.archive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content archive is unsafe, oversized or corrupt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容归档不安全、过大或已损坏。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容歸檔不安全、過大或已損壞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツアーカイブは安全でないか、サイズが大きすぎるか、破損しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 아카이브가 안전하지 않거나, 크기가 과대하거나 손상되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archive de contenu est dangereuse, surdimensionnée ou corrompue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Inhaltsarchiv ist unsicher, übergroß oder beschädigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de contenido es inseguro, de gran tamaño o corrupto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de conteúdo é inseguro, superdimensionado ou corrompido."
          }
        }
      }
    },
    "content.update.error.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content version cannot be applied safely (pinned, downgrade, incompatible, missing dependency or already installed bytes)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该内容版本无法安全应用（已固定、降级、不兼容、缺少依赖或已存在相同版本）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該內容版本無法安全應用（已固定、降級、不相容、缺少依賴或已存在相同版本）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツバージョンは安全に適用できません（ピン留め、ダウングレード、互換性がない、依存関係が欠如している、または既にインストールされているバイト）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠 버전은 안전하게 적용할 수 없습니다(핀, 다운그레이드, 호환되지 않음, 종속성 누락 또는 이미 설치된 바이트)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de contenu ne peut pas être appliquée en toute sécurité (épinglée, rétrogradée, incompatible, dépendance manquante ou octets déjà installés)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Inhaltsversion kann nicht sicher angewendet werden (gepinnt, Downgrade, inkompatibel, fehlende Abhängigkeit oder bereits installierte Bytes)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de contenido no se puede aplicar de forma segura (anclado, degradado, incompatible, falta de dependencia o bytes ya instalados)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão de conteúdo não pode ser aplicada com segurança (fixada, downgrade, incompatível, dependência ausente ou bytes já instalados)."
          }
        }
      }
    },
    "content.update.error.corrupt_state": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored content state is unreadable; installed content was left untouched. Reopen Floe, then check again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的内容状态无法读取；已安装内容未被改动。请重新打开 Floe 后再次检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的內容狀態無法讀取；已安裝內容未被改動。請重新開啟 Floe 後再次檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたコンテンツの状態は読めません；インストールされたコンテンツはそのまま残されています。 Floe を再度開いてから、再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 콘텐츠 상태는 읽을 수 없으며, 설치된 콘텐츠는 손대지 않았습니다. Floe를 다시 열고 다시 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état du contenu stocké est illisible ; le contenu installé a été laissé intact. Rouvrir Floe, puis vérifiez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Status des gespeicherten Inhalts ist nicht lesbar; der installierte Inhalt wurde unberührt gelassen. Öffnen Sie Floe erneut und überprüfen Sie dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado del contenido almacenado es ilegible; el contenido instalado se dejó intacto. Vuelva a abrir Floe, luego vuelva a comprobarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estado do conteúdo armazenado é ilegível; o conteúdo instalado foi deixado intocado. Reabra o Floe e verifique novamente."
          }
        }
      }
    },
    "content.update.error.feed": {
