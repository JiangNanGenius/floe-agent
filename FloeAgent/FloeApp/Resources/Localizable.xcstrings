          "stringUnit": {
            "state": "translated",
            "value": "The file records its unit. Confirm it matches the source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已记录单位，请确认与源模型一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案已記錄單位，請確認與源模型一致。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはその単位を記録します。 ソースと一致していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 그 단위를 기록합니다. 출처와 일치하는지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier enregistre son unité. Vérifiez qu'il correspond à la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei zeichnet ihre Einheit auf. Vergewissern Sie sich, dass es mit der Quelle übereinstimmt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo registra su unidad. Confirma que coincide con la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo registra sua unidade. Confirme se corresponde à fonte."
          }
        }
      }
    },
    "cad.import.undeclaredNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file has no declared unit. Choose the unit used by its author; the detected size is a hint."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件未记录单位，请选择制作时使用的单位；检测尺寸仅供参考。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案未記錄單位，請選擇製作時使用的單位；檢測尺寸僅供參考。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルには宣言された単位がありません。 作者が使用した単位を選択してください；検出されたサイズはヒントです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 선언된 단위가 없습니다. 작성자가 사용한 단위를 선택하십시오; 감지된 크기는 힌트입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas d'unité déclarée. Choisissez l'unité utilisée par son auteur ; la taille détectée est un indice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat keine deklarierte Einheit. Wählen Sie die von seinem Autor verwendete Einheit aus; die erkannte Größe ist ein Hinweis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no tiene ninguna unidad declarada. Elija la unidad utilizada por su autor; el tamaño detectado es una pista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não tem nenhuma unidade declarada. Escolha a unidade usada por seu autor; o tamanho detectado é uma dica."
          }
        }
      }
    },
    "cad.import.groupSelect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one model and its referenced resource files, or one complete ZIP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择一个模型及其引用的资源文件，或一个完整 ZIP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇一個模型及其引用的資原始檔，或一個完整 ZIP。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つのモデルとそれを参照するリソースファイル、または完全なZIPファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 하나와 해당 참조 리소스 파일을 선택하거나 전체 ZIP 파일을 하나 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un modèle et ses fichiers de ressources référencés, ou un ZIP complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Modell und die referenzierten Ressourcendateien oder eine vollständige ZIP-Datei aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un modelo y sus archivos de recursos referenciados, o un ZIP completo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um modelo e seus arquivos de recursos referenciados, ou um ZIP completo."
          }
        }
      }
    },
    "cad.import.groupBudget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected files exceed the import limit or include a folder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件超出导入限制，或包含文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案超出匯入限制，或包含資料夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたファイルはインポート上限を超えているか、フォルダーが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일이 가져오기 제한을 초과했거나 폴더를 포함하고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sélectionnés dépassent la limite d'importation ou incluent un dossier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Dateien überschreiten das Importlimit oder enthalten einen Ordner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados exceden el límite de importación o incluyen una carpeta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos selecionados excedem o limite de importação ou incluem uma pasta."
          }
        }
      }
    },
    "cad.import.groupAmbiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some resource names conflict. Use a complete ZIP with unique paths."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分资源名称冲突，请使用路径唯一的完整 ZIP。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分資源名稱衝突，請使用路徑唯一的完整 ZIP。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のリソース名が競合しています。 ユニークなパスを持つ完全な ZIP を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 리소스 이름이 충돌합니다. 고유한 경로를 가진 완전한 ZIP를 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains noms de ressources sont en conflit. Utilisez un ZIP complet avec des chemins uniques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Ressourcennamen sind in Konflikt. Verwenden Sie einen vollständigen ZIP mit eindeutigen Pfaden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos nombres de recursos entran en conflicto. Utilice un ZIP completo con rutas únicas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns nomes de recursos entram em conflito. Use um ZIP completo com caminhos exclusivos."
          }
        }
      }
    },
