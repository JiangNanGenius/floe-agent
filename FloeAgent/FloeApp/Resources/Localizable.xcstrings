    "app.bilingual.c42805386c02f952": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级后可打开屏幕。旧运行盘会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to open the screen. The old runtime disk will be retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級後可開啟螢幕。舊執行盤會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を開くにはアップグレードしてください。 古いランタイムディスクは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 열기 위해 업그레이드하십시오. 이전 런타임 디스크가 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à niveau pour ouvrir l'écran. L'ancien disque d'exécution sera conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade, um den Bildschirm zu öffnen. Die alte Laufzeitdiskette bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza para abrir la pantalla. El antiguo disco de tiempo de ejecución se conservará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize para abrir a tela. O disco de tempo de execução antigo será mantido."
          }
        }
      }
    },
    "app.bilingual.852dfd4187468471": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试连接或停止屏幕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry the connection or stop the screen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試連線或停止螢幕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続を再試行するか、画面を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결을 다시 시도하거나 화면을 중지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez la connexion ou arrêtez l'écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie die Verbindung erneut oder stoppen Sie den Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a intentar la conexión o detenga la pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente a conexão ou pare a tela."
          }
        }
      }
    },
    "app.bilingual.a9efeaac9d49d84d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重试，或检查执行环境。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again, or check Execution Environment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請重試，或檢查執行環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しください、または実行環境をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하거나 실행 환경을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez ou vérifiez l'environnement d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut, oder überprüfen Sie die Ausführungsumgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inténtalo de nuevo o comprueba el entorno de ejecución."
