    "app.workspace_canvas_view.the_drawing_changed_externally_while": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸在编辑期间已被外部修改；当前未保存的编辑还未能写入本地草稿，请先在编辑器中保存。原草稿不会被删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing changed externally while you were editing; the unsaved edits could not be written to the local draft yet. Save in the editor first; the old draft is preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙在編輯期間已被外部修改；當前未儲存的編輯還未能寫入本地草稿，請先在編輯器中儲存。原草稿不會被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面が外部で変更されたため、未保存の編集はまだローカルドラフトに書き出すことができませんでした。 まずエディタに保存してください。古いドラフトは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 중에 도면이 외부에서 변경되었으며, 저장되지 않은 편집본은 아직 로컬 초안에 기록되지 않았습니다. 먼저 편집기에 저장하십시오; 이전 초안은 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a changé à l'extérieur pendant que vous étiez en train d'éditer ; les modifications non enregistrées n'ont pas encore pu être écrites dans le brouillon local. Enregistrez d'abord dans l'éditeur ; l'ancien brouillon est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung wurde extern geändert, während Sie bearbeitet haben; die nicht gespeicherten Bearbeitungen konnten noch nicht in den lokalen Entwurf geschrieben werden. Zuerst im Editor speichern; der alte Entwurf bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo cambió externamente mientras estabas editando; las ediciones no guardadas aún no se pudieron escribir en el borrador local. Guarde primero en el editor; el borrador antiguo se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho mudou externamente enquanto você estava editando; as edições não salvas ainda não puderam ser escritas no rascunho local. Salve no editor primeiro; o rascunho antigo é preservado."
          }
        }
      }
    },
    "app.workspace_canvas_view.the_drawing_changed_externally_the": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸在编辑期间已被外部修改；旧草稿已保留（%@），已为最新版本新建编辑副本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing changed externally; the previous draft was preserved (%@) and a fresh editable copy was staged for the latest revision."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙在編輯期間已被外部修改；舊草稿已保留（%@），已為最新版本新建編輯副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面は外部で変更されました；以前のドラフトは（%@）が保存され、最新の改訂版のために新しい編集可能なコピーがステージングされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도면이 외부에서 변경되었으며, 이전 초안은 보존되었습니다 (%@) 그리고 최신 개정판을 위해 새로운 편집 가능한 사본이 배치되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a été modifié à l'extérieur ; le projet précédent a été conservé (%@) et une nouvelle copie modifiable a été mise en scène pour la dernière révision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung wurde extern geändert; der vorherige Entwurf wurde beibehalten (%@) und eine neue bearbeitbare Kopie wurde für die letzte Überarbeitung inszeniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo cambió externamente; el borrador anterior se conservó (%@) y se organizó una nueva copia editable para la última revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho foi alterado externamente; o rascunho anterior foi preservado (%@) e uma nova cópia editável foi encenada para a última revisão."
          }
        }
      }
    },
    "app.workspace_canvas_view.the_previous_edit_session_could": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一条编辑会话尚未保存成功，已在后台保留并会重试；草稿文件未删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous edit session could not be saved yet; it is retained in the background for retry and its draft files are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一條編輯會話尚未儲存成功，已在後臺保留並會重試；草稿檔案未刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の編集セッションはまだ保存できませんでした。バックグラウンドで保持され、再試行のために保持され、ドラフトファイルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 편집 세션을 아직 저장할 수 없으며, 재시도를 위해 백그라운드에 보관되고 초안 파일이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session d'édition précédente n'a pas encore pu être enregistrée ; elle est conservée en arrière-plan pour réessayer et ses fichiers de brouillon sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Bearbeitungssitzung konnte noch nicht gespeichert werden; sie wird im Hintergrund zum erneuten Versuch beibehalten und ihre Entwurfsdateien werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de edición anterior aún no se pudo guardar; se conserva en segundo plano para volver a intentarlo y sus borradores se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
