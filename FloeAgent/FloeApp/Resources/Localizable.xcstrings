    "chat.thread_detail_view_model.saved_mode_unreadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read the saved mode for this chat. It stays in Chat; choose Agent to allow editing and execution."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此对话已保存的模式，将保持“聊天”模式；如需编辑与执行，请选择“智能体”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此對話已儲存的模式，將保持“聊天”模式；如需編輯與執行，請選擇“智慧體”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットの保存モードを読み取れませんでした。 チャットに残ります。編集と実行を許可するには、エージェントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 채팅의 저장된 모드를 읽을 수 없습니다. 채팅에 남아 있습니다; 편집 및 실행을 허용하려면 에이전트를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le mode enregistré pour ce chat. Il reste dans le chat ; choisissez Agent pour permettre l'édition et l'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Modus für diesen Chat konnte nicht gelesen werden. Es bleibt im Chat; wählen Sie Agent, um Bearbeitung und Ausführung zu ermöglichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el modo guardado para este chat. Permanece en el chat; elija Agente para permitir la edición y la ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o modo salvo para este bate-papo. Ele permanece no Bate-papo; escolha Agente para permitir edição e execução."
          }
        }
      }
    },
