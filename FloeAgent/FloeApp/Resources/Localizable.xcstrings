    "design.appearance_settings_section.appearance_is_currently_fixed_choose_automatic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance is currently fixed; choose “Automatic” to follow the system again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已固定外观，选择「自动」即可恢复跟随系统。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前已固定外觀，選擇「自動」即可恢復跟隨系統。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観は現在固定されています。システムに再度従うには「Automatic」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외관이 현재 고정되어 있습니다; 시스템을 다시 따라가려면 “Automatic”을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apparence est actuellement corrigée ; choisissez \"Automatique\" pour suivre à nouveau le système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aussehen ist derzeit behoben; wählen Sie \"Automatisch\", um dem System erneut zu folgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia está actualmente fija; elija \"Automático\" para seguir el sistema de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência está fixa no momento; escolha “Automático” para seguir o sistema novamente."
          }
        }
      }
    },
    "design.appearance_settings_section.switches_automatically_with_the_system_appearance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches automatically with the system appearance. Scheduled or sunset switching can be set in iOS “Settings → Display & Brightness → Automatic”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动随系统外观切换。定时或日落切换可在 iOS「设置 → 显示与亮度 → 自动」中设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動隨系統外觀切換。定時或日落切換可在 iOS「設定 → 顯示與亮度 → 自動」中設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの外観が自動的に切り替わります。 スケジュールまたはサンセットスイッチングは、iOS「設定 → ディスプレイと明るさ → 自動」で設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 외관에 따라 자동으로 전환됩니다. iOS “Settings → Display & Brightness → Automatic”에서 예약 또는 일몰 스위칭을 설정할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commute automatiquement avec l'apparence du système. La commutation programmée ou au coucher du soleil peut être réglée dans iOS \"Paramètres → Affichage et luminosité → Automatique\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt automatisch mit dem Systembild. Geplante oder Sonnenuntergangsumschaltung kann in iOS \"Einstellungen → Anzeige & Helligkeit → Automatisch\" eingestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia automáticamente con la apariencia del sistema. La conmutación programada o puesta de sol se puede configurar en iOS \"Configuración → Pantalla y brillo → Automático\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda automaticamente com a aparência do sistema. A comutação programada ou do pôr do sol pode ser definida em iOS “Configurações → Exibição e Brilho → Automático”."
          }
        }
      }
    },
