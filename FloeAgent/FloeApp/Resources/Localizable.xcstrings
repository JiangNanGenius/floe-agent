    "voice.assistant.transcription.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies only to assistant file transcription. It does not change dictation or ordinary voice input."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于助手文件转写，不会改变听写或普通语音输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於助手檔案轉寫，不會改變聽寫或普通語音輸入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントファイルの文字起こしにのみ適用されます。 音声入力や音声入力は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보조 파일 전사에만 적용됩니다. 받아쓰기나 일반 음성 입력을 변경하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique uniquement à la transcription des fichiers assistants. Il ne modifie pas la dictée ou la saisie vocale ordinaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt nur für Assistent-Dateitranskription. Es ändert nicht das Diktat oder die gewöhnliche Spracheingabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica solo a la transcripción de archivos asistentes. No cambia el dictado ni la entrada de voz ordinaria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se apenas à transcrição de arquivo assistente. Não altera o ditado ou a entrada de voz comum."
          }
        }
      }
    },
