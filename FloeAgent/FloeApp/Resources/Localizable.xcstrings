    "app.bilingual.1ac30948a0b40518": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份副本的 CAD 子项目尚未复制，原项目仍然保留。请先创建独立子项目。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy's CAD child project was not duplicated. The original is kept; create an independent child project first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份副本的 CAD 子專案尚未複製，原專案仍然保留。請先建立獨立子專案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーの CAD 子プロジェクトは複製されていませんでした。 原本は保持されますので、まず独立した子プロジェクトを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복사본의 CAD 자식 프로젝트는 복제되지 않았습니다. 원본은 유지됩니다; 먼저 독립적인 하위 프로젝트를 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet enfant CAD de cette copie n'a pas été dupliqué. L'original est conservé ; créez d'abord un projet enfant indépendant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das untergeordnete Projekt CAD dieser Kopie wurde nicht dupliziert. Das Original wird beibehalten; erstellen Sie zuerst ein unabhängiges Kinderprojekt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto secundario CAD de esta copia no se duplicó. El original se conserva; primero crea un proyecto infantil independiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto filho CAD desta cópia não foi duplicado. O original é mantido; crie um projeto infantil independente primeiro."
          }
        }
      }
    },
