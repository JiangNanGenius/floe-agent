    "services.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js and Python servers stay alive when you close a preview or switch tasks. iOS may suspend them in the background. After restarting Floe, restart the services you still need."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭预览或切换任务不会停止 Node.js 和 Python 服务。iOS 进入后台后可能暂停执行；重新打开 Floe 后，请重启仍需使用的服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉預覽或切換任務不會停止 Node.js 和 Python 服務。iOS 進入後臺後可能暫停執行；重新開啟 Floe 後，請重啟仍需使用的服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js と Python サーバーは、プレビューやスイッチタスクを閉じたときでも稼働したままです。 iOSはバックグラウンドでそれらを停止する可能性があります。 Floe を再起動した後、まだ必要なサービスを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js와 Python 서버는 미리보기를 닫거나 작업을 전환하면 계속 유지됩니다. iOS는 백그라운드에서 그들을 일시 정지시킬 수 있습니다. Floe를 재시작한 후, 아직 필요한 서비스를 다시 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs Node.js et Python restent en vie lorsque vous fermez un aperçu ou changez de tâche. iOS peut les suspendre en arrière-plan. Après avoir redémarré Floe, redémarrez les services dont vous avez encore besoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Node.js- und Python-Server bleiben aktiv, wenn Sie eine Vorschau schließen oder Aufgaben wechseln. iOS kann sie im Hintergrund aussetzen. Starten Sie nach dem Neustart von Floe die Dienste, die Sie noch benötigen, neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores Node.js y Python se mantienen vivos cuando cierras una vista previa o cambias de tarea. iOS puede suspenderlos en segundo plano. Después de reiniciar Floe, reinicie los servicios que aún necesita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores Node.js e Python permanecem ativos quando você fecha uma visualização ou troca de tarefas. iOS pode suspendê-los em segundo plano. Depois de reiniciar o Floe, reinicie os serviços que você ainda precisa."
          }
        }
      }
    },
