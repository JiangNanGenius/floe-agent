    "cad.versions.busy.changedDuringLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed while the version was being read. Nothing was restored; try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取版本时文档已更改。未恢复任何内容；请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取版本時文件已更改。未恢復任何內容；請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンを読み上げている間に文書が変更されました。 何も復元されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전을 읽는 동안 문서가 변경되었습니다. 복원된 것이 없습니다; 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé pendant la lecture de la version. Rien n'a été restauré ; réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde geändert, während die Version gelesen wurde. Nichts wurde wiederhergestellt; versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió mientras se leía la versión. No se restableció nada; inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou enquanto a versão estava sendo lida. Nada foi restaurado; tente novamente."
          }
        }
      }
    },
    "cad.versions.error.promotionRetained": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The version was not published (%@). The document format was updated safely and the checkpoint was kept for recovery."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本未能发布（%@）。文档格式已安全更新，检查点已保留以便恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本未能釋出（%@）。文件格式已安全更新，檢查點已保留以便恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンは公開されていません（%@）。 文書形式は安全に更新され、チェックポイントは復旧のために保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전이 게시되지 않았습니다 (%@). 문서 형식이 안전하게 업데이트되었으며, 체크포인트는 복구를 위해 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version n'a pas été publiée (%@). Le format du document a été mis à jour en toute sécurité et le point de contrôle a été conservé pour la récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version wurde nicht veröffentlicht (%@). Das Dokumentformat wurde sicher aktualisiert und der Kontrollpunkt wurde zur Wiederherstellung beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión no fue publicada (%@). El formato del documento se actualizó de forma segura y se mantuvo el punto de control para su recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão não foi publicada (%@). O formato do documento foi atualizado com segurança e o ponto de verificação foi mantido para recuperação."
          }
        }
      }
    },
    "cad.versions.error.recoveryUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recovery checkpoint can't be used (%@). The document and other versions were not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用此恢复检查点（%@）。文档和其他版本均未更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用此恢復檢查點（%@）。文件和其他版本均未更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリカバリチェックポイントは使用できません (%@)。 文書および他のバージョンは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복구 체크포인트는 사용할 수 없습니다 (%@). 문서와 다른 버전은 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de contrôle de récupération ne peut pas être utilisé (%@). Le document et les autres versions n'ont pas été modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Wiederherstellungskontrollpunkt kann nicht verwendet werden (%@). Das Dokument und andere Versionen wurden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto de control de recuperación no se puede utilizar (%@). El documento y otras versiones no se cambiaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ponto de verificação de recuperação não pode ser usado (%@). O documento e outras versões não foram alteradas."
          }
        }
      }
    },
    "cad.versions.error.recoveryCollision": {
      "extractionState": "manual",
      "localizations": {
