    "app.workspace_canvas_view.will_move_to_recently_deleted": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将移至最近删除，可以从那里恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will move to Recently Deleted, where you can restore it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”將移至最近刪除，可以從那裡恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は「最近削除された項目」に移動し、そこで復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 최근 삭제된 항목으로 이동하며, 그곳에서 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" passera à Récemment supprimé, où vous pouvez le restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wird zu Kürzlich gelöscht verschoben, wo Sie es wiederherstellen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se moverá a Eliminado recientemente, donde puede restaurarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será movido para Excluído Recentemente, onde você pode restaurá-lo."
          }
        }
      }
    },
