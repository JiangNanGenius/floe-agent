    "localmodels.local_provider_adapter.the_apple_intelligence_model_did_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Intelligence model did not respond for too long, so this task was stopped; please try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 模型长时间没有响应，本次任务已停止，请重试"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 模型長時間沒有響應，本次任務已停止，請重試"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceモデルが長時間応答しなかったため、このタスクは停止されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 모델이 너무 오래 응답하지 않아 이 작업이 중단되었습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple Intelligence n'a pas répondu pendant trop longtemps, cette tâche a donc été arrêtée ; veuillez réessayer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Apple Intelligence-Modell hat zu lange nicht reagiert, daher wurde diese Aufgabe gestoppt; bitte versuchen Sie es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo Apple Intelligence no respondió durante demasiado tiempo, por lo que esta tarea se detuvo; por favor, inténtelo de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo Apple Intelligence não respondeu por muito tempo, então esta tarefa foi interrompida; tente novamente"
          }
        }
      }
    },
    "localmodels.local_provider_adapter.the_apple_intelligence_model_is_currently": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Intelligence model is currently unavailable: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
