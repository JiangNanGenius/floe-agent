    "app.bilingual.7c1f8ccbc0991968": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "理论残留高度只考虑圆弧刀尖与进给，不代表实测粗糙度。预览网格、磨损和振动需另行判断。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideal cusp height considers only a circular nose and feed; it is not measured roughness. Mesh faceting, wear and vibration require separate assessment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "理論殘留高度只考慮圓弧刀尖與進給，不代表實測粗糙度。預覽網格、磨損和振動需另行判斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理想的な尖頂高さは、円形のノーズとフィードのみを考慮し、測定された粗さではありません。 メッシュのファセット、摩耗、振動は別途評価が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이상적인 커스프 높이는 원형 코와 피드만을 고려하며, 측정된 거칠기는 아닙니다. 메시 면각, 마모 및 진동은 별도의 평가가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur idéale de la cuspide ne prend en compte qu'un nez circulaire et une alimentation ; il ne s'agit pas d'une rugosité mesurée. Le facetage de la maille, l'usure et la vibration nécessitent une évaluation distincte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ideale Höckerhöhe berücksichtigt nur eine kreisförmige Nase und Futter; es ist keine gemessene Rauheit. Mesh-Facetting, Verschleiß und Vibrationen erfordern eine separate Bewertung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La altura ideal de la cúspide considera solo una nariz y alimentación circulares; no se mide la rugosidad. La facetación, el desgaste y la vibración de la malla requieren una evaluación separada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A altura ideal da cúspide considera apenas um nariz circular e uma alimentação; não é medida a rugosidade. Faceting, desgaste e vibração da malha requerem avaliação separada."
          }
        }
      }
    },
