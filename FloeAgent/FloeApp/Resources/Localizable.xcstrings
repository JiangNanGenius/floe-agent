    "settings.diagnostics.privacy.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No analytics, no ads, no Floe backend. Secrets live only in Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无分析、无广告、无 Floe 后端。秘密仅存于钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無分析、無廣告、無 Floe 後端。秘密僅存於鑰匙串。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析も広告もFloeのバックエンドもありません。 秘密はキーチェーンにのみあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석도 없고, 광고도 없으며, Floe 백엔드도 없습니다. 비밀은 키체인에만 살아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'analyse, pas de publicités, pas de backend Floe. Les secrets ne vivent que dans le porte-clés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Analysen, keine Werbung, kein Floe-Backend. Geheimnisse leben nur im Schlüsselbund."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin análisis, sin anuncios, sin backend Floe. Los secretos viven solo en el llavero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem análises, sem anúncios, sem back-end Floe. Segredos vivem apenas no Chaveiro."
          }
        }
      }
    },
