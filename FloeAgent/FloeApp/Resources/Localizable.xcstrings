    "notes.notes_session.deleted_attachments_could_not_be_reclaimed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted attachments could not be reclaimed; reopen the note to retry:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能回收已删除附件，可重新打开手记重试："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能回收已刪除附件，可重新開啟手記重試："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された添付ファイルは復元できませんでした。ノートを再度開いて再試行してください："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 첨부 파일을 복구할 수 없습니다; 메모를 다시 열어 재시도하십시오:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes supprimées n'ont pas pu être récupérées ; rouvrez la note pour réessayer :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Anhänge konnten nicht wieder angezeigt werden. Öffnen Sie die Notiz erneut, um es erneut zu versuchen:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron recuperar los archivos adjuntos eliminados; vuelva a abrir la nota para volver a intentarlo:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexos excluídos não puderam ser recuperados; reabra a nota para tentar novamente:"
