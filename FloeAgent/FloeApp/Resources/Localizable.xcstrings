    "workspace.office_workspace_attachment_picker.choose_a_file_generated_in_a": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a file generated in a project or chat. After import, Notes keeps its own copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择项目或聊天中生成的文件。导入后，手记会独立保存副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇專案或聊天中生成的檔案。匯入後，手記會獨立儲存副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトまたはチャットで生成されたファイルを選択してください。 インポート後、Notes は独自のコピーを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 또는 채팅에서 생성된 파일을 선택하십시오. 가져온 후, Notes는 자체 사본을 보관합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier généré dans un projet ou un chat. Après l'importation, Notes conserve sa propre copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Datei aus, die in einem Projekt oder Chat generiert wurde. Nach dem Import behält Notes seine eigene Kopie."
          }
        },
        "es": {
          "stringUnit": {
