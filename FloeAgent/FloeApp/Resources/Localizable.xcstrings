    "app.bilingual.2030c0e7fcb8781a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能加入传输队列。当前支持文件传输；请检查目录和权限。"
          }
        },
