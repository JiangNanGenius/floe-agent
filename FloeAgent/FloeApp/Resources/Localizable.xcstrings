    "environment.packages.linux.remove_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs apt-get remove inside the Linux guest; packages that depend on it may be removed too."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Linux guest 内执行 apt-get remove；依赖它的软件包可能一并被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Linux guest 內執行 apt-get remove；依賴它的軟體包可能一併被移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ゲスト内で apt-get remove を実行します。これに依存しているパッケージも削除される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 게스트 내부에서 apt-get remove를 실행합니다; 이를 의존하는 패키지도 제거될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute apt-get remove à l'intérieur de l'invité Linux ; les paquets qui en dépendent peuvent également être supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt apt-get remove innerhalb des Linux-Gastes aus; Pakete, die davon abhängen, können auch entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta apt-get remove dentro del invitado Linux; los paquetes que dependen de él también se pueden eliminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa a remoção apt-get dentro do convidado Linux; pacotes que dependem dele também podem ser removidos."
          }
        }
      }
    },
