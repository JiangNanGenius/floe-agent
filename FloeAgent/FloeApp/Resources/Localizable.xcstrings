          }
        }
      }
    },
    "content.update.error.storage_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content storage is unavailable, so signed content cannot be checked or installed. Free device storage and reopen Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容存储不可用，无法检查或安装签名内容。请释放设备存储空间后重新打开 Floe。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容儲存不可用，無法檢查或安裝簽名內容。請釋放裝置儲存空間後重新開啟 Floe。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの保存が利用できないため、署名されたコンテンツを確認したりインストールしたりできません。 デバイスストレージを無料にし、Floe を再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 저장이 불가능하므로 서명된 콘텐츠를 확인하거나 설치할 수 없습니다. 무료 장치 저장 및 Floe를 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage de contenu n'est pas disponible, le contenu signé ne peut donc pas être vérifié ou installé. Stockage gratuit de l'appareil et réouverture de Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhaltsspeicher ist nicht verfügbar, daher können signierte Inhalte nicht überprüft oder installiert werden. Kostenloser Gerätespeicher und öffnen Sie Floe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento de contenido no está disponible, por lo que el contenido firmado no se puede comprobar ni instalar. Almacenamiento gratuito del dispositivo y vuelva a abrir Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento de conteúdo não está disponível, portanto, o conteúdo assinado não pode ser verificado ou instalado. Livre o armazenamento do dispositivo e reabra o Floe."
          }
        }
      }
    },
    "content.update.error.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content update source is unavailable. Check the network and repository access, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容更新源不可用。请检查网络与仓库连通性后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容更新源不可用。請檢查網路與倉庫連通性後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテンツの更新ソースは利用できません。 ネットワークとリポジトリへのアクセスを確認し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "콘텐츠 업데이트 소스를 사용할 수 없습니다. 네트워크와 저장소 접근을 확인한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source de mise à jour du contenu n'est pas disponible. Vérifiez l'accès au réseau et au référentiel, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle für die Inhaltsaktualisierung ist nicht verfügbar. Überprüfen Sie den Netzwerk- und Repository-Zugriff und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de actualización de contenido no está disponible. Compruebe el acceso a la red y al repositorio, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte de atualização de conteúdo não está disponível. Verifique a rede e o acesso ao repositório e tente novamente."
          }
        }
      }
    },
    "conversations.remote_video_tools.did_not_provide_a_supported_reference": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ did not provide a supported reference image/first-frame input; use a model with referenceImage.supported=true in video.models."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供受支持的参考图/首帧输入；请使用 video.models 中 referenceImage.supported=true 的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未提供受支援的參考圖/首幀輸入；請使用 video.models 中 referenceImage.supported=true 的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はサポートされている参照画像/ファーストフレーム入力を提供していません。video.models では referenceImage.supported=true のモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 지원되는 참조 이미지/첫 번째 프레임 입력을 제공하지 않았으니, video.models에서 referenceImage.supported=true인 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas fourni d'entrée d'image de référence/première image prise en charge ; utilisez un modèle avec referenceImage.supported=true dans video.models."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lieferte keine unterstützte Referenzbild-/First-Frame-Eingabe; verwenden Sie ein Modell mit referenceImage.supported=true in video.models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no proporcionó una entrada de imagen de referencia/primer fotograma compatible; use un modelo con referenceImage.supported=true en video.models."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ não forneceu uma entrada de imagem/primeiro quadro de referência suportada; use um modelo com referenceImage.supported=true em video.models."
          }
        }
      }
    },
    "conversations.remote_video_tools.reference_image_attachments_must_be_images": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference image attachments must be images"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图附件必须是图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考圖附件必須是圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照画像の添付ファイルは画像である必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 이미지 첨부 파일은 이미지여야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes d'image de référence doivent être des images"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Referenzbildanhänge müssen Bilder sein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos adjuntos de imágenes de referencia deben ser imágenes"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os anexos de imagem de referência devem ser imagens"
          }
        }
      }
    },
    "conversations.remote_video_tools.the_reference_image_exceeds_the_byte": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference image exceeds the %@-byte limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图超过 %@ 字节上限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考圖超過 %@ 位元組上限"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照画像が%@バイト制限を超えています"
          }
        },
        "ko": {
