    "settings.sync.secrets.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys use iCloud Keychain only when the master switch and that provider's own Keychain switch are both enabled. SSH and VNC credentials always stay on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有总开关和对应供应商的钥匙串开关都开启时，API Key 才会使用 iCloud 钥匙串。SSH 与 VNC 凭据始终只保存在本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有總開關和對應供應商的鑰匙串開關都開啟時，API Key 才會使用 iCloud 鑰匙串。SSH 與 VNC 憑據始終只儲存在本機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーは、マスタースイッチとそのプロバイダー独自のキーチェーンスイッチの両方が有効になっている場合にのみ、iCloudキーチェーンを使用します。 SSH と VNC の認証情報は常にこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키는 마스터 스위치와 해당 공급자의 자체 키체인 스위치가 모두 활성화된 경우에만 iCloud 키체인을 사용합니다. SSH 및 VNC 자격 증명은 항상 이 기기에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API utilisent le trousseau iCloud uniquement lorsque le commutateur principal et le commutateur de trousseau de ce fournisseur sont tous deux activés. Les informations d'identification SSH et VNC restent toujours sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel verwenden den iCloud-Schlüsselbund nur, wenn der Master-Switch und der eigene Schlüsselbundschalter des Anbieters aktiviert sind. Die Anmeldeinformationen SSH und VNC bleiben immer auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API usan el llavero de iCloud solo cuando el interruptor maestro y el interruptor del llavero propio de ese proveedor están habilitados. Las credenciales SSH y VNC siempre se quedan en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves API usam o iCloud Keychain somente quando o switch mestre e o próprio switch Keychain desse provedor estão ativados. As credenciais SSH e VNC sempre permanecem neste dispositivo."
          }
        }
      }
    },
