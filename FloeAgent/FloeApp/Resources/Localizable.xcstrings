    "app.bilingual.7d1aad70a818a15c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与下方轨道混合；降低不透明度可叠加画面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blend with lower tracks; reduce opacity to overlay the image."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與下方軌道混合；降低不透明度可疊加畫面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部トラックとブレンドし、不透明度を下げて画像をオーバーレイします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 트랙과 혼합하고, 이미지 오버레이를 위해 불투명도를 줄이십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mélangez avec des pistes inférieures ; réduisez l'opacité pour superposer l'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mischen Sie mit unteren Spuren; reduzieren Sie die Deckkraft, um das Bild zu überlagern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mezclar con pistas inferiores; reducir la opacidad para superponer la imagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Misture com faixas inferiores; reduza a opacidade para sobrepor a imagem."
          }
        }
      }
    },
