    "app.bilingual.b20647e1d2bbf671": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待已停止，请先查看保存的计算状态再重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting stopped. Inspect the saved calculation state before retrying."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待已停止，請先檢視儲存的計算狀態再重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機は止まりました。 再試行する前に、保存された計算状態を検査してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기가 멈췄습니다. 재시도하기 전에 저장된 계산 상태를 검사하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attente s'est arrêtée. Vérifiez l'état du calcul enregistré avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Warten hat aufgehört. Überprüfen Sie den gespeicherten Berechnungsstatus, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La espera se detuvo. Inspeccione el estado del cálculo guardado antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A espera parou. Inspecione o estado de cálculo salvo antes de tentar novamente."
          }
        }
      }
    },
