    "app.bilingual.b92d1d1cb3118825": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示前 5,000 个原子，可选择链缩小范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showing the first 5,000 atoms. Select a chain to narrow the view."
