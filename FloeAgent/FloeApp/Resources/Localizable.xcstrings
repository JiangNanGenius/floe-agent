    "setup.features.canvas.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each workspace includes a native infinite canvas for notes, sketches, and visual planning. Standard MCP servers remain optional and are disabled for canvas by default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个工作区都可使用原生无限画布整理文本、手绘与视觉规划；标准 MCP 为可选能力，默认不会开放给画布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個工作區都可使用原生無限畫布整理文字、手繪與視覺規劃；標準 MCP 為可選能力，預設不會開放給畫布。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ワークスペースには、ノート、スケッチ、ビジュアルプランニング用のネイティブ無限キャンバスが含まれています。 標準の MCP サーバーはオプションのままで、キャンバスではデフォルトで無効化されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 작업 공간에는 메모, 스케치 및 시각적 계획을 위한 기본 무한 캔버스가 포함되어 있습니다. 표준 MCP 서버는 선택 사항으로 남아 있으며 기본적으로 캔버스에서 비활성화되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque espace de travail comprend une toile infinie native pour les notes, les croquis et la planification visuelle. Les serveurs MCP standard restent facultatifs et sont désactivés pour le canevas par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Arbeitsbereich enthält eine native unendliche Leinwand für Notizen, Skizzen und visuelle Planung. Standard-MCP-Server bleiben optional und sind standardmäßig für Canvas deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada espacio de trabajo incluye un lienzo infinito nativo para notas, bocetos y planificación visual. Los servidores estándar MCP siguen siendo opcionales y están deshabilitados para canvas por defecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada espaço de trabalho inclui uma tela infinita nativa para anotações, esboços e planejamento visual. Os servidores padrão MCP permanecem opcionais e são desativados para canvas por padrão."
          }
        }
      }
    },
