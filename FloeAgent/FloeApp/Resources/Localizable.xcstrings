    "app.bilingual.cf15d59cc6ed58b5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先恢复尚未保存的修改"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recover unsaved changes first"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先恢復尚未儲存的修改"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、未保存の変更を復元してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 저장되지 않은 변경 사항을 복구합니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
