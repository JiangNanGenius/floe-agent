    "workspace.engineering_review_sheet.scope_only_the_currently_selected_object": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scope: only the currently selected object; prefer referencing its handle and geometry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围：仅当前选中的对象；请优先引用其句柄与几何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "範圍：僅當前選中的物件；請優先引用其控制代碼與幾何。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲：現在選択されているオブジェクトのみ；ハンドルとジオメトリを参照することを推奨します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위: 현재 선택된 객체만 해당되며, 해당 객체의 핸들과 기하학을 참조하는 것을 선호합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portée : uniquement l'objet actuellement sélectionné ; préférez référencer son poignée et sa géométrie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfang: nur das aktuell ausgewählte Objekt; bevorzugt Bezugnahme auf seinen Griff und seine Geometrie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcance: solo el objeto seleccionado actualmente; prefiere hacer referencia a su identificador y geometría."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escopo: apenas o objeto atualmente selecionado; prefira fazer referência ao seu identificador e geometria."
          }
        }
      }
    },
    "workspace.engineering_review_sheet.scope_structured_parsing_of_the_entire": {
