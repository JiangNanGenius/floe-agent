          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 이미지가 재읽기 인증에 실패했습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image exportée a échoué à la vérification de la relecture ; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das exportierte Bild hat die Überprüfung nicht erneut gelesen; bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen exportada falló en la verificación de relectura; por favor, inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem exportada falhou na verificação de releitura; tente novamente."
          }
        }
      }
    },
    "media.floe_image_editor_view.the_image_exceeds_the_current_editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image exceeds the current editing limit (24 megapixels or 16,384 pixels per side); shrink a copy first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片超过当前编辑上限（2400 万像素或单边 16384 像素），请先缩小副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片超過當前編輯上限（2400 萬畫素或單邊 16384 畫素），請先縮小副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像が現在の編集上限（24メガピクセルまたは1辺あたり16,384ピクセル）を超えています。まずコピーを縮小してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 현재 편집 제한(24메가픽셀 또는 한 면당 16,384픽셀)을 초과합니다; 먼저 복사본을 축소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image dépasse la limite d'édition actuelle (24 mégapixels ou 16 384 pixels par côté) ; réduisez d'abord une copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild überschreitet das aktuelle Bearbeitungslimit (24 Megapixel oder 16.384 Pixel pro Seite); verkleinern Sie zuerst eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen supera el límite de edición actual (24 megapíxeles o 16.384 píxeles por lado); primero reduzca una copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem excede o limite de edição atual (24 megapixels ou 16.384 pixels por lado); reduza uma cópia primeiro."
          }
        }
      }
    },
