    "cad.versions.unreadable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checkpoint did not pass verification. It cannot be compared or restored, and the current document was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此检查点未通过校验。无法比较或恢复，当前文档未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檢查點未透過校驗。無法比較或恢復，當前文件未被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックポイントは検証に合格しませんでした。 比較も復元もできません。また、現在の文書は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 체크포인트는 검증을 통과하지 못했습니다. 비교하거나 복원할 수 없으며, 현재 문서는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de contrôle n'a pas passé la vérification. Il ne peut pas être comparé ou restauré, et le document actuel n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kontrollpunkt hat die Überprüfung nicht bestanden. Es kann nicht verglichen oder wiederhergestellt werden, und das aktuelle Dokument wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto de control no pasó la verificación. No se puede comparar ni restaurar, y el documento actual no se ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ponto de verificação não passou na verificação. Não pode ser comparado ou restaurado, e o documento atual não foi alterado."
          }
        }
      }
    },
