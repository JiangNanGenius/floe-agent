    "remote.conversation_center.the_current_task_is_running_or": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current task is running or compacting; run /compact when the task is idle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
