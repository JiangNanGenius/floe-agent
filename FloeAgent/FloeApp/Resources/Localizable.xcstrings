    "cad.sculpt.prepareHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported meshes are prepared for sculpting first. Apple Pencil pressure controls the brush; two fingers move the view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入的网格会先转为可雕刻网格。Apple Pencil 笔压控制笔刷，双指移动视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入的網格會先轉為可雕刻網格。Apple Pencil 筆壓控制筆刷，雙指移動檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入メッシュはまず彫刻用に準備されます。 Apple Pencil の圧力がブラシを制御し、2本の指でビューを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입된 메시는 먼저 조각하기 위해 준비됩니다. Apple Pencil 압력이 브러시를 제어합니다; 두 손가락으로 뷰를 이동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mailles importées sont préparées pour la sculpture en premier. La pression Apple Pencil contrôle la brosse ; deux doigts déplacent la vue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte Maschen werden zuerst für die Bildhauerei vorbereitet. Der Druck von Apple Pencil steuert die Bürste; zwei Finger bewegen die Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mallas importadas se preparan para la escultura primero. La presión de Apple Pencil controla el cepillo; dos dedos mueven la vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As malhas importadas são preparadas para a escultura primeiro. A pressão do Apple Pencil controla o pincel; dois dedos movem a visão."
          }
        }
      }
    },
