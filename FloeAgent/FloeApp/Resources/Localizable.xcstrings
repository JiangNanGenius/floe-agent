    "cad.rig.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The polygon source changed. Bind it again before editing or export."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多边形源已改变，请重新绑定后再编辑或导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多邊形源已改變，請重新繫結後再編輯或匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポリゴンのソースが変更されました。 編集またはエクスポートする前に、再度バインドしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다각형 소스가 변경되었습니다. 편집하거나 내보내기 전에 다시 바인드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source du polygone a changé. Liez-le à nouveau avant de l'éditer ou de l'exporter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Polygonquelle hat sich geändert. Binden Sie es erneut, bevor Sie es bearbeiten oder exportieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente del polígono cambió. Encuadernarlo de nuevo antes de editarlo o exportarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte do polígono mudou. Vincule-o novamente antes de editar ou exportar."
          }
        }
      }
    },
