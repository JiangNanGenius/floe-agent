    "cad.building.error.useAValidFloorElevationAndHeight": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a valid floor elevation and height in millimetres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请以毫米输入有效的楼层标高和高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請以毫米輸入有效的樓層標高和高度。"
          }
