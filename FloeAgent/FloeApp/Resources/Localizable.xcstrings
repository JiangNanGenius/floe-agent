    "app.bilingual.b5be85bb1ea79a25": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前按每转进给计时；这里的方向速度仅是原生路径的每分钟指令，未建模的轴速限制不会改写每转进给。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timing currently uses feed per revolution. Axis feeds here describe native per-minute paths; unmodeled axis speed limits do not override the per-revolution law."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前按每轉進給計時；這裡的方向速度僅是原生路徑的每分鐘指令，未建模的軸速限制不會改寫每轉進給。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、タイミングは回転あたりのフィードを使用しています。 ここでの軸フィードは、ネイティブの1分あたりのパスを記述します；モデル化されていない軸速度制限は、1回転あたりの法則を上書きしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 타이밍은 회전당 피드를 사용합니다. 여기서 축 피드는 분당 기본 경로를 설명합니다; 모델링되지 않은 축 속도 제한은 회전당 법칙을 무시하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chronométrage utilise actuellement l'alimentation par révolution. Les flux d'axes décrivent ici les chemins natifs par minute ; les limites de vitesse d'axe non modélisées ne l'emportent pas sur la loi par révolution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Timing verwendet derzeit Feed pro Umdrehung. Axis-Feeds beschreiben hier native Pfade pro Minute; unmodellierte Achsgeschwindigkeitsbegrenzungen setzen das Pro-Revolution-Gesetz nicht außer Kraft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo actualmente utiliza alimentación por revolución. Los alimentos de eje aquí describen rutas nativas por minuto; los límites de velocidad del eje no modelados no anulan la ley por revolución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo atualmente usa alimentação por revolução. Os feeds de eixo aqui descrevem caminhos nativos por minuto; os limites de velocidade do eixo não modelados não substituem a lei por revolução."
          }
        }
      }
    },
