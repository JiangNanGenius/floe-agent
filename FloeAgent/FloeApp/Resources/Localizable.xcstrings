    "app.bilingual.524988bba9a17d7e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视图使用工件坐标。完整导出保留世界刀路、接料事件和装夹变换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This view uses part coordinates. The complete export retains world paths, transfer events and gripping transforms."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檢視使用工件座標。完整匯出保留世界刀路、接料事件和裝夾變換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビューは部分座標を使用します。 完全なエクスポートは、ワールドパス、転送イベント、そして魅力的な変換を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 뷰는 부분 좌표를 사용합니다. 전체 내보내기는 세계 경로, 전송 이벤트 및 그립 변환을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vue utilise les coordonnées des pièces. L'exportation complète conserve les chemins du monde, les événements de transfert et les transformations captivantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ansicht verwendet Teilekoordinaten. Der komplette Export behält Weltpfade, Transferereignisse und ergreifende Transformationen bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta vista utiliza coordenadas de piezas. La exportación completa conserva las rutas del mundo, los eventos de transferencia y las transformaciones apasionantes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta visualização usa coordenadas de peças. A exportação completa mantém caminhos mundiais, eventos de transferência e transformações emocionantes."
          }
        }
      }
    },
