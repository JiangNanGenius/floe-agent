    "settings.data_management_view.only_public_https_links_and_genuine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only public HTTPS links and genuine TTF, OTF, TTC and OTC fonts are accepted, up to 32 MB per file; private addresses, credential URLs and disguised files are rejected. Fonts are deduplicated by content and are not re-downloaded for different workspaces."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅接受公开 HTTPS 地址和真实的 TTF、OTF、TTC、OTC 字体，单文件上限 32 MB；私网地址、凭据 URL 和伪装文件会被拒绝。字体按内容去重，不会因不同工作区重复下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅接受公開 HTTPS 地址和真實的 TTF、OTF、TTC、OTC 字型，單檔案上限 32 MB；私網地址、憑據 URL 和偽裝檔案會被拒絕。字型按內容去重，不會因不同工作區重複下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開の HTTPS リンクおよび正規の TTF、OTF、TTC、OTC フォントのみ受け付けます。ファイルあたり最大 32 MB までです。プライベートアドレス、認証情報 URL、偽装されたファイルは受け付けません。 フォントはコンテンツによって重複除去され、異なるワークスペースでは再ダウンロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 HTTPS 링크와 정품 TTF, OTF, TTC 및 OTC 글꼴만 허용되며, 파일당 최대 32 MB까지 허용됩니다; 개인 주소, 자격 증명 URL 및 위장된 파일은 거부됩니다. 폰트는 콘텐츠에 의해 중복 제거되며, 다른 작업 공간에 대해 다시 다운로드되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les liens publics HTTPS et les véritables polices TTF, OTF, TTC et OTC sont acceptés, jusqu'à 32 Mo par fichier ; les adresses privées, les URL d'informations d'identification et les fichiers déguisés sont rejetés. Les polices sont dédupliquées par contenu et ne sont pas retéléchargées pour différents espaces de travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur öffentliche HTTPS-Links und echte TTF-, OTF-, TTC- und OTC-Schriftarten werden bis zu 32 MB pro Datei akzeptiert; private Adressen, Anmelde-URLs und getarnte Dateien werden abgelehnt. Schriftarten werden nach Inhalt dedupliziert und nicht für verschiedene Arbeitsbereiche erneut heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aceptan enlaces HTTPS públicos y fuentes genuinas TTF, OTF, TTC y OTC, hasta 32 MB por archivo; se rechazan direcciones privadas, URL de credenciales y archivos disfrazados. Las fuentes se deduplican por contenido y no se vuelven a descargar para diferentes espacios de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente links públicos HTTPS e fontes TTF, OTF, TTC e OTC genuínas são aceitos, até 32 MB por arquivo; endereços privados, URLs de credenciais e arquivos disfarçados são rejeitados. As fontes são desduplicadas por conteúdo e não são baixadas novamente para diferentes espaços de trabalho."
          }
        }
      }
    },
