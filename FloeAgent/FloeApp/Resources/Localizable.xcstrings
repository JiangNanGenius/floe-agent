    },
    "cad.merge.keepCopies": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both copies are unchanged. Keep them separate to preserve these edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个副本均未修改。请分别保留，以保存这些改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩個副本均未修改。請分別保留，以儲存這些改動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のコピーは変更されていません。 これらの編集を保持するために、それらを別々に保ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 사본 모두 변함이 없습니다. 이러한 편집을 보존하려면 별도로 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux copies sont inchangées. Gardez-les séparés pour préserver ces modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Kopien sind unverändert. Bewahren Sie sie getrennt auf, um diese Bearbeitungen beizubehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas copias no han cambiado. Manténgalos separados para preservar estas ediciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas as cópias permanecem inalteradas. Mantenha-os separados para preservar essas edições."
          }
        }
      }
    },
    "cad.merge.needVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a design version before making separate copies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先创建设计版本，再制作独立副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先建立設計版本，再製作獨立副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別々のコピーを作成する前に、デザインバージョンを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별도의 복사본을 만들기 전에 디자인 버전을 작성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une version de conception avant de faire des copies séparées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine Designversion, bevor Sie separate Kopien erstellen."
          }
        },
        "es": {
