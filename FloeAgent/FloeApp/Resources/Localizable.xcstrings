    "providers.sync.rejected_remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some cloud configuration failed validation: the local copy was kept and the remote update was skipped"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分云端配置未通过校验：已保留本机原有配置，并跳过该条云端更新"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分雲端配置未透過校驗：已保留本機原有配置，並跳過該條雲端更新"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のクラウド構成が検証に失敗しました：ローカルコピーは保持され、リモート更新はスキップされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 클라우드 구성에서 검증에 실패했습니다: 로컬 복사본은 유지되었고 원격 업데이트는 건너뛰었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines configurations cloud ont échoué à valider : la copie locale a été conservée et la mise à jour distante a été ignorée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Cloud-Konfigurationen konnten nicht validiert werden: Die lokale Kopie wurde beibehalten und das Remote-Update wurde übersprungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas configuraciones en la nube fallaron en la validación: se mantuvo la copia local y se omitió la actualización remota"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguma configuração de nuvem falhou na validação: a cópia local foi mantida e a atualização remota foi ignorada"
          }
        }
      }
    },
    "providers.sync.rejected_remote.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejected records are neither saved on this device nor acknowledged, so a corrected remote payload can still arrive. Retry now or wait for the next sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒绝的记录不会写入本机，也不会被确认，因此修正后的云端内容仍可同步过来。可立即重试，或等待下次同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被拒絕的記錄不會寫入本機，也不會被確認，因此修正後的雲端內容仍可同步過來。可立即重試，或等待下次同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否されたレコードはこのデバイスに保存されず、認識もされませんので、修正されたリモートペイロードが依然として届く可能性があります。 今すぐ再試行するか、次の同期をお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거부된 레코드는 이 장치에 저장되지도 않고 확인되지도 않으므로, 수정된 원격 페이로드가 여전히 도착할 수 있습니다. 지금 다시 시도하거나 다음 동기화를 기다리세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements rejetés ne sont ni enregistrés sur cet appareil ni reconnus, de sorte qu'une charge utile à distance corrigée peut toujours arriver. Réessayez maintenant ou attendez la prochaine synchronisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgelehnte Datensätze werden weder auf diesem Gerät gespeichert noch bestätigt, so dass eine korrigierte Remote-Payload weiterhin eintreffen kann. Versuchen Sie es jetzt erneut oder warten Sie auf die nächste Synchronisierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros rechazados no se guardan en este dispositivo ni se reconocen, por lo que aún puede llegar una carga útil remota corregida. Vuelve a intentarlo ahora o espera a la próxima sincronización."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros rejeitados não são salvos neste dispositivo nem reconhecidos, portanto, uma carga útil remota corrigida ainda pode chegar. Tente novamente agora ou aguarde a próxima sincronização."
          }
        }
      }
    },
