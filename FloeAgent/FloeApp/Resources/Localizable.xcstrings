          "stringUnit": {
            "state": "translated",
            "value": "A aplicação separa o intervalo de áudio de origem deste clipe de vídeo."
          }
        }
      }
    },
    "app.bilingual.47128eca18e4304c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在时间轴中选择要分离人声的配乐、录音或带原声的视频。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the music, recording or video-with-audio you want to separate in the timeline."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在時間軸中選擇要分離人聲的配樂、錄音或帶原聲的影片。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムラインで分離したい音楽、録音、またはビデオと音声を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타임라인에서 분리하고 싶은 음악, 녹음 또는 비디오와 오디오를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la musique, l'enregistrement ou la vidéo avec audio que vous souhaitez séparer dans la chronologie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Musik, Aufnahme oder das Video mit Audio, das Sie in der Timeline trennen möchten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la música, la grabación o el vídeo con audio que desea separar en la línea de tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a música, gravação ou vídeo com áudio que você deseja separar na linha do tempo."
          }
        }
      }
    },
