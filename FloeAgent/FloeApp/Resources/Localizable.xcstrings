        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is low on space; %@ is needed and %@ is currently available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备空间不足，需要 %@，目前可用 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置空間不足，需要 %@，目前可用 %@。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは容量が不足しています；%@が必要で、%@は現在入手可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 공간이 부족합니다; %@가 필요하고 %@는 현재 이용 가능합니다."
          }
        },
        "fr": {
