    "workspace.workspace_canvas_view.supports_up_to_reference_images_this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ supports up to %@ reference images; this connection would create %@ reference inputs. Remove other reference-image connections first, or use a model that supports more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最多支持 %@ 张参考图；这条连线会形成 %@ 张参考图输入。请先移除其他参考图连线，或更换支持更多参考图的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 最多支援 %@ 張參考圖；這條連線會形成 %@ 張參考圖輸入。請先移除其他參考圖連線，或更換支援更多參考圖的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は最大%@参照画像をサポートします。この接続は%@参照入力を生成します。 まず、他の参照画像接続を削除するか、より多くをサポートするモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 최대 %@ 참조 이미지를 지원합니다; 이 연결은 %@ 참조 입력을 생성합니다. 먼저 다른 참조 이미지 연결을 제거하거나, 더 많은 것을 지원하는 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ prend en charge jusqu'à des images de référence %@ ; cette connexion créerait des entrées de référence %@. Supprimez d'abord d'autres connexions d'images de référence, ou utilisez un modèle qui en prend en charge davantage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt bis zu %@-Referenzbilder; diese Verbindung würde %@-Referenzeingaben erstellen. Entfernen Sie zuerst andere Referenzbildverbindungen oder verwenden Sie ein Modell, das mehr unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ admite hasta imágenes de referencia %@; esta conexión crearía entradas de referencia %@. Elimine primero otras conexiones de imagen de referencia o utilice un modelo que admita más."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ suporta até imagens de referência %@; esta conexão criaria entradas de referência %@. Remova outras conexões de imagem de referência primeiro ou use um modelo que suporte mais."
          }
        }
      }
    },
