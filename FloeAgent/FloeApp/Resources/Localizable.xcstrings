          }
        }
      }
    },
    "app.bilingual.b8784972b08fc942": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选区包含锁定内容。请先解锁，或缩小修改范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection contains locked content. Unlock it or choose a smaller selection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選區包含鎖定內容。請先解鎖，或縮小修改範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択にはロックされたコンテンツが含まれています。 ロックを解除するか、より小さな選択肢を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택에 잠긴 콘텐츠가 포함되어 있습니다. 잠금을 해제하거나 더 작은 선택을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection contient du contenu verrouillé. Déverrouillez-le ou choisissez une plus petite sélection."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl enthält gesperrte Inhalte. Entsperren Sie es oder wählen Sie eine kleinere Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección contiene contenido bloqueado. Desbloquéalo o elige una selección más pequeña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção contém conteúdo bloqueado. Desbloqueie-o ou escolha uma seleção menor."
          }
        }
      }
    },
    "app.bilingual.b94406a8b81fe72c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次修改超出了选区。请调整选区后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change extends beyond the selection. Adjust the selection and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這次修改超出了選區。請調整選區後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は選択範囲を超えています。 選択範囲を調整して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경은 선택을 넘어 확장됩니다. 선택을 조정하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce changement s'étend au-delà de la sélection. Ajustez la sélection et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung geht über die Auswahl hinaus. Passen Sie die Auswahl an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio se extiende más allá de la selección. Ajusta la selección e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa mudança vai além da seleção. Ajuste a seleção e tente novamente."
          }
        }
      }
    },
    "app.bilingual.b1eb636aa9c3e18b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选内容已发生变化，请重新选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected content has changed. Select it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選內容已發生變化，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたコンテンツが変更されました。 もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 콘텐츠가 변경되었습니다. 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sélectionné a changé. Sélectionnez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ausgewählte Inhalt hat sich geändert. Wählen Sie es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido seleccionado ha cambiado. Selecciónelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo selecionado foi alterado. Selecione-o novamente."
          }
        }
      }
    },
    "app.bilingual.8bb8ad9691980a7c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标格式无法保留这些内容。请保留原生文件，或调整导出范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The target format cannot retain this content. Keep the native file or adjust the export scope."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標格式無法保留這些內容。請保留原生檔案，或調整匯出範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象フォーマットはこのコンテンツを保持できません。 ネイティブファイルを保持するか、エクスポート範囲を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 형식은 이 내용을 보존할 수 없습니다. 네이티브 파일을 유지하거나 내보내기 범위를 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format cible ne peut pas conserver ce contenu. Conservez le fichier natif ou ajustez la portée d'exportation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zielformat kann diesen Inhalt nicht beibehalten. Behalten Sie die native Datei bei oder passen Sie den Exportbereich an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato de destino no puede retener este contenido. Mantenga el archivo nativo o ajuste el alcance de exportación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O formato de destino não pode reter esse conteúdo. Mantenha o arquivo nativo ou ajuste o escopo de exportação."
          }
        }
      }
    },
    "app.bilingual.9206ab328c736143": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件未能读取或保存。已有内容仍保留，请重试或导出副本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn’t be read or saved. Existing content is retained. Retry or export a copy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案未能讀取或儲存。已有內容仍保留，請重試或匯出副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み取ることも保存することもできませんでした。 既存のコンテンツは保持されます。 コピーを再試行するか、エクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽거나 저장할 수 없습니다. 기존 콘텐츠가 유지됩니다. 복사본을 다시 시도하거나 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être lu ou enregistré. Le contenu existant est conservé. Réessayez ou exportez une copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht gelesen oder gespeichert werden. Vorhandene Inhalte werden beibehalten. Versuchen Sie es erneut oder exportieren Sie eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ni guardar el archivo. El contenido existente se conserva. Vuelva a intentar o exporte una copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pôde ser lido ou salvo. O conteúdo existente é mantido. Tente novamente ou exporte uma cópia."
          }
        }
      }
    },
    "app.bilingual.ea0770dcbd92a1f2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容或结构需要调整。请检查输入和选区后重试，当前草稿仍保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the content, structure and selection, then try again. Your current draft is retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內容或結構需要調整。請檢查輸入和選區後重試，當前草稿仍保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容、構造、選択を確認し、再度お試しください。 現在のドラフトは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내용, 구조 및 선택을 확인한 후 다시 시도하십시오. 귀하의 현재 초안이 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le contenu, la structure et la sélection, puis réessayez. Votre brouillon actuel est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie den Inhalt, die Struktur und die Auswahl und versuchen Sie es erneut. Ihr aktueller Entwurf wird beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el contenido, la estructura y la selección, luego inténtalo de nuevo. Su borrador actual se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o conteúdo, a estrutura e a seleção e tente novamente. Seu rascunho atual foi mantido."
          }
        }
      }
    },
    "app.bilingual.4e7dde0352e4ab49": {
