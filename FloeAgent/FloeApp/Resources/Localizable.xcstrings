        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatted content is placed beside the original, which stays editable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式化内容会放在原稿旁边，原笔迹保持可编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
