    "workspace.workspace_canvas_view.the_image_model_chosen_by_this": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image model chosen by this generation node is currently unavailable; open the node configuration and choose a model again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个生成节点选择的图片模型当前不可用，请先打开节点配置并重新选择模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個生成節點選擇的圖片模型當前不可用，請先開啟節點配置並重新選擇模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
