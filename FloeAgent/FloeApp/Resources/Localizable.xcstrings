        }
      }
    },
    "cad.recovery.error.notPackage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered copy must keep the .floecad package extension."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复副本必须保留 .floecad 文档扩展名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復副本必須保留 .floecad 文件副檔名。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元されたコピーは .floecad パッケージ拡張子を保持しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구된 복사본은 .floecad 패키지 확장자를 유지해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie récupérée doit conserver l'extension du paquet .floecad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wiederhergestellte Kopie muss die .floecad-Paketerweiterung behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia recuperada debe conservar la extensión del paquete .floecad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia recuperada deve manter a extensão do pacote .floecad."
          }
        }
      }
    },
    "cad.recovery.error.sourceNotContained": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last saved version contains a link outside the document, so it can't be copied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次保存的版本包含指向文档外部的链接，因此无法复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次儲存的版本包含指向文件外部的連結，因此無法複製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に保存されたバージョンには文書の外にリンクが含まれているため、コピーできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 저장된 버전에는 문서 외부에 링크가 포함되어 있어 복사할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière version enregistrée contient un lien en dehors du document, elle ne peut donc pas être copiée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zuletzt gespeicherte Version enthält einen Link außerhalb des Dokuments, so dass sie nicht kopiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última versión guardada contiene un enlace fuera del documento, por lo que no se puede copiar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última versão salva contém um link fora do documento, portanto, não pode ser copiada."
          }
        }
      }
    },
    "cad.recovery.canvas.saveFailedTitle": {
