    "app.cadoffline_render_view.compute_reflections_indirect_light_and": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本机计算反射、间接光与阴影。请保持 Floe 在前台；关闭此窗口后渲染会继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compute reflections, indirect light and shadows on this device. Keep Floe in the foreground; rendering continues when you close this window."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在本機計算反射、間接光與陰影。請保持 Floe 在前臺；關閉此視窗後渲染會繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスで反射、間接光、影を計算します。 Floe を前面に保持してください。このウィンドウを閉じてもレンダリングは続行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 반사, 간접광 및 그림자를 계산합니다. Floe를 전경에 유지하십시오; 이 창을 닫을 때 렌더링이 계속됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculez les reflets, la lumière indirecte et les ombres sur cet appareil. Gardez Floe au premier plan ; le rendu continue lorsque vous fermez cette fenêtre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnen Sie Reflexionen, indirektes Licht und Schatten auf diesem Gerät. Behalten Sie Floe im Vordergrund; das Rendern wird fortgesetzt, wenn Sie dieses Fenster schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula los reflejos, la luz indirecta y las sombras en este dispositivo. Mantenga Floe en primer plano; la representación continúa cuando cierra esta ventana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule reflexos, luz indireta e sombras neste dispositivo. Mantenha Floe em primeiro plano; a renderização continua quando você fecha esta janela."
          }
        }
      }
    },
