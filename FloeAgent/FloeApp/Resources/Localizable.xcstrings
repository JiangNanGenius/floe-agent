    "notes.office.externalUpdate.keepCopyFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edit could not be flushed, so it was not copied. The editor keeps your work and can be exported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能写入编辑副本，未创建新文档。当前页面仍保留你的编辑，可导出或重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能寫入編輯副本，未建立新文件。當前頁面仍保留你的編輯，可匯出或重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集をフラッシュできなかったため、コピーされませんでした。 エディタはあなたの作業を保持し、エクスポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집을 플러시할 수 없었으므로 복사되지 않았습니다. 편집기는 귀하의 작업을 보관하고 내보낼 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification n'a pas pu être vidée, elle n'a donc pas été copiée. L'éditeur conserve votre travail et peut être exporté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bearbeitung konnte nicht gespült werden, also wurde sie nicht kopiert. Der Editor behält Ihre Arbeit und kann exportiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edición no se pudo eliminar, por lo que no se copió. El editor conserva su trabajo y se puede exportar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição não pôde ser liberada, então não foi copiada. O editor mantém seu trabalho e pode ser exportado."
          }
        }
      }
    },
