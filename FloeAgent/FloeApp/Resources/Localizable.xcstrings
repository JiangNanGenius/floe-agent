    "cad.workbench.drawing.threadNeedsHole": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select the linked mechanical-hole face; the callout is checked against its live pilot/tap-drill diameter."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择关联的机械孔面；标注会按该孔当前底孔/攻丝直径校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇關聯的機械孔面；標註會按該孔當前底孔/攻絲直徑校驗。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクされた機械穴の面を選択してください；コールアウトはライブパイロット/タップドリルの直径と照合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 기계식 구멍 면을 선택하십시오; 콜아웃은 실제 파일럿/탭 드릴 직경에 따라 확인됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez la face du trou mécanique lié ; l'appel est vérifié par rapport à son diamètre de pilote en direct/perceuse de robinet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie das verknüpfte mechanische Lochgesicht; das Callout wird anhand seines Live-Pilot-/Tap-Bohr-Durchmessers überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione la cara del agujero mecánico vinculado; la llamada se comprueba con su diámetro de piloto/taladro de grifo vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione a face do orifício mecânico vinculado; a chamada é verificada em relação ao seu diâmetro de broca piloto/de torneira ao vivo."
          }
        }
      }
    },
    "cad.workbench.drawing.counterboreRead": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diameter, depth and through state are read from the linked counterbore feature; edit the hole to update the callout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直径、深度和通孔状态读取自关联沉孔特征；修改孔后标注会更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直徑、深度和通孔狀態讀取自關聯沉孔特徵；修改孔後標註會更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直径、深さ、および通過状態は、リンクされたカウンターボア機能から読み取られます；穴を編集してコールアウトを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직경, 깊이 및 통과 상태는 연결된 카운터보어 기능에서 읽어들입니다; 구멍을 편집하여 콜아웃을 업데이트하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diamètre, la profondeur et l'état traversant sont lus à partir de la fonction de contre-alésage lié ; modifiez le trou pour mettre à jour l'appel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchmesser, Tiefe und Durchgangszustand werden von der verknüpften Gegenbohrfunktion abgelesen; bearbeiten Sie das Loch, um den Aufruf zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diámetro, la profundidad y el estado de paso se leen de la función de contrabujero vinculado; edite el agujero para actualizar la llamada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diâmetro, profundidade e estado de passagem são lidos a partir do recurso de furo de contador vinculado; edite o orifício para atualizar a chamada."
          }
        }
      }
    },
