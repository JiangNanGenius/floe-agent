    "cad.error.importBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't import “%@” — another exact import is already running. Nothing was imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入“%@” — 另一个精确导入正在进行。未导入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法匯入“%@” — 另一個精確匯入正在進行。未匯入任何內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のインポートができませんでした — 別の正確なインポートがすでに実行されています。 何もインポートされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”를 가져올 수 없습니다 — 다른 정확한 가져오기가 이미 실행 중입니다. 아무것도 수입되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'importer \"%@\" - une autre importation exacte est déjà en cours d'exécution. Rien n'a été importé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" konnte nicht importiert werden - ein weiterer exakter Import wird bereits ausgeführt. Nichts wurde importiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo importar \"%@\" - otra importación exacta ya se está ejecutando. No se importó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível importar “%@” — outra importação exata já está em execução. Nada foi importado."
          }
        }
      }
    },
