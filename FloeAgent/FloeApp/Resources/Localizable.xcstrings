        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to export — the design has no solid bodies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可导出的内容 — 设计中没有实体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可匯出的內容 — 設計中沒有實體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートすべきものはありません — デザインには実体がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
