    "setup.features.operations.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync preferences, review token and speed metrics, and export correlated diagnostic logs when troubleshooting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步偏好设置、查看 Token 与速度统计，并在排障时导出带关联信息的诊断日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步偏好設定、檢視 Token 與速度統計，並在排障時匯出帶關聯資訊的診斷日誌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラブルシューティング時に、設定を同期し、トークンと速度の指標を確認し、関連する診断ログをエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 해결 시 환경 설정을 동기화하고, 토큰 및 속도 지표를 검토하며, 연관된 진단 로그를 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez les préférences, examinez les indicateurs de jetons et de vitesse, et exportez les journaux de diagnostic corrélés lors du dépannage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisieren Sie die Einstellungen, überprüfen Sie Token- und Geschwindigkeitsmetriken und exportieren Sie korrelierte Diagnoseprotokolle bei der Fehlerbehebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza las preferencias, revisa las métricas de token y velocidad, y exporta registros de diagnóstico correlacionados durante la resolución de problemas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize preferências, revise as métricas de token e velocidade e exporte registros de diagnóstico correlacionados durante a solução de problemas."
          }
        }
      }
    },
    "setup.features.operations.title": {
      "extractionState": "manual",
      "localizations": {
