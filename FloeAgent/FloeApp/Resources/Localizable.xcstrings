    "notes.notes_agent_tools.updateofficetext_rewrites_and_re_verifies_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText rewrites and re-verifies the Office package; use action=apply directly (also undoable with an idempotent receipt). Proposals are not supported yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText 需要改写并重新校验 Office 包，请直接用 action=apply（同样可撤销、带幂等回执）；提案暂不支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText 需要改寫並重新校驗 Office 包，請直接用 action=apply（同樣可撤銷、帶冪等回執）；提案暫不支援。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText は Office パッケージを書き換え、再検証します。action=apply を直接使用してください（冪等なレシートの場合は元に戻すこともできます）。 提案はまだサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText는 Office 패키지를 재작성하고 재검증합니다; action=apply를 직접 사용하십시오(또한 항등 영수증을 사용하면 되돌리실 수 있습니다). 제안은 아직 지원되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText réécrit et revérifie le package Office ; utilisez action=appliquer directement (également indéfaisable avec un reçu idempotent). Les propositions ne sont pas encore prises en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText schreibt das Office-Paket neu und verifiziert es erneut; verwenden Sie action=apply direkt (auch rückgängig mit einer idempotenten Quittung). Vorschläge werden noch nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText reescribe y vuelve a verificar el paquete de Office; use action=apply directamente (también se puede hacer con un recibo idempotente). Las propuestas aún no están respaldadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "updateOfficeText reescreve e verifica novamente o pacote Office; use action=apply diretamente (também desfazível com um recibo idempotente). As propostas ainda não são suportadas."
          }
        }
      }
    },
