      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控件不存在。请使用当前控件 ID 或指定键盘按键。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This control is unavailable. Use its current ID or explicit keyboard keys."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制元件不存在。請使用當前控制元件 ID 或指定鍵盤按鍵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコントロールは利用できません。 現在のIDまたは明示的なキーボードキーを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컨트롤을 사용할 수 없습니다. 현재 ID 또는 명시적인 키보드 키를 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contrôle n'est pas disponible. Utilisez son identifiant actuel ou les touches explicites du clavier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Steuerelement ist nicht verfügbar. Verwenden Sie seine aktuelle ID oder explizite Tastaturtasten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este control no está disponible. Use su ID actual o teclas de teclado explícitas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este controle não está disponível. Use seu ID atual ou teclas de teclado explícitas."
          }
        }
      }
    },
    "app.bilingual.105a6753ea8d12a9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待游戏画面超时。请查看游戏日志，等场景加载后再次截图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timed out waiting for the game frame. Check the game logs and retry after the scene loads."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待遊戲畫面超時。請檢視遊戲日誌，等場景載入後再次截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフレームの待機中にタイムアウトしました。 ゲームログを確認し、シーンが読み込まれた後に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 프레임을 기다리는 동안 시간 초과되었습니다. 게임 로그를 확인하고 장면이 로드된 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Délai d'attente pour le cadre du jeu. Vérifiez les journaux de jeu et réessayez après le chargement de la scène."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Warten auf den Spielrahmen ist abgezeigt. Überprüfen Sie die Spielprotokolle und versuchen Sie es erneut, nachdem die Szene geladen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo esperando el marco del juego. Revisa los registros del juego y vuelve a intentarlo después de que se cargue la escena."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempo esgotado esperando pelo quadro do jogo. Verifique os registros do jogo e tente novamente após o carregamento da cena."
          }
        }
      }
    },
    "app.bilingual.3fc8a1b23dd87588": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏画面还未就绪。请稍后再截图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game frame is not ready. Try capturing it again once the game has loaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲畫面還未就緒。請稍後再截圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフレームはまだ準備ができていません。 ゲームがロードされたら、もう一度キャプチャしてみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 프레임이 준비되지 않았습니다. 게임이 로드된 후에 다시 캡처해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cadre de jeu n'est pas prêt. Essayez de le capturer à nouveau une fois le jeu chargé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spielrahmen ist noch nicht fertig. Versuchen Sie, es erneut zu erfassen, sobald das Spiel geladen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El marco del juego no está listo. Intenta capturarlo de nuevo una vez que el juego se haya cargado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quadro do jogo não está pronto. Tente capturá-lo novamente assim que o jogo for carregado."
          }
        }
      }
    },
    "app.bilingual.11a94bb9b9b75206": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在游戏内保存，再停止运行收集存档。当前运行不支持通用即时存档。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save inside the game, then stop to collect the files. A universal live snapshot is unavailable for this run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在遊戲內儲存，再停止執行收集存檔。當前執行不支援通用即時存檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内に保存し、次にファイルを収集するために停止してください。 この実行では、ユニバーサルライブスナップショットは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 내에 저장한 후, 파일을 수집하기 위해 중지하십시오. 이번 실행에서는 범용 라이브 스냅샷을 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez à l'intérieur du jeu, puis arrêtez-vous pour collecter les fichiers. Un instantané universel en direct n'est pas disponible pour cette exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie im Spiel und stoppen Sie dann, um die Dateien zu sammeln. Ein universeller Live-Snapshot ist für diesen Lauf nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda dentro del juego, luego detente para recoger los archivos. Una instantánea en vivo universal no está disponible para esta ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve dentro do jogo e pare para coletar os arquivos. Um instantâneo ao vivo universal não está disponível para esta execução."
          }
        }
      }
    },
    "app.bilingual.6720ccaf2b5f8856": {
      "extractionState": "manual",
