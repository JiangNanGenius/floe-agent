    "engineering.processStopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The viewer stopped. Close other previews or use a smaller file, then retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看器已停止。请关闭其他预览，或使用较小文件后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視器已停止。請關閉其他預覽，或使用較小檔案後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者が止まりました。 他のプレビューを閉じるか、より小さなファイルを使用してから、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자가 멈췄습니다. 다른 미리보기를 닫거나 더 작은 파일을 사용한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spectateur s'est arrêté. Fermez d'autres aperçus ou utilisez un fichier plus petit, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zuschauer blieb stehen. Schließen Sie andere Vorschauen oder verwenden Sie eine kleinere Datei, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espectador se detuvo. Cierre otras vistas previas o use un archivo más pequeño, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espectador parou. Feche outras visualizações ou use um arquivo menor e tente novamente."
          }
        }
      }
    },
    "engineering.large_model.limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model exceeds the larger preview limit (64 MiB / 128 resources). Reduce the model or split its resources, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型超过较大预览上限（64 MiB／128 个资源）。请缩小模型或拆分资源后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型超過較大預覽上限（64 MiB／128 個資源）。請縮小模型或拆分資源後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは、より大きなプレビュー上限（64 MiB / 128 リソース）を超えています。 モデルを縮小するか、リソースを分割してから、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 더 큰 미리보기 제한(64 MiB / 128 리소스)을 초과합니다. 모델을 축소하거나 자원을 분할한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle dépasse la plus grande limite de prévisualisation (64 MiB / 128 ressources). Réduisez le modèle ou divisez ses ressources, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell überschreitet das größere Vorschaulimit (64 MiB / 128 Ressourcen). Reduzieren Sie das Modell oder teilen Sie seine Ressourcen auf, und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo supera el mayor límite de vista previa (64 MiB / 128 recursos). Reduzca el modelo o divida sus recursos, luego inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo excede o limite de visualização maior (64 MiB / 128 recursos). Reduza o modelo ou divida seus recursos e tente novamente."
          }
        }
      }
    },
