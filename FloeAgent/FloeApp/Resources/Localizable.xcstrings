          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausführung wurde unterbrochen. Fahren Sie mit dem gespeicherten Fortschritt fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución fue interrumpida. Continuar desde el progreso guardado."
          }
        },
