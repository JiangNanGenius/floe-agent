    "notes.notes_root_view.documents_are_not_fully_indexed_yet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ documents are not fully indexed yet; search results may be incomplete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 份文档尚未完整索引，搜索结果可能不完整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 份文件尚未完整索引，搜尋結果可能不完整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ドキュメントはまだ完全にインデックスされていません。検索結果が不完全である可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 문서는 아직 완전히 색인되지 않았으며, 검색 결과가 불완전할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents %@ ne sont pas encore entièrement indexés ; les résultats de la recherche peuvent être incomplets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Dokumente sind noch nicht vollständig indiziert; Suchergebnisse sind möglicherweise unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos %@ aún no están completamente indexados; los resultados de la búsqueda pueden estar incompletos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos %@ ainda não estão totalmente indexados; os resultados da pesquisa podem estar incompletos."
          }
        }
      }
    },
