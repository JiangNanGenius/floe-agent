          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섬을 탭하여 선택한 다음, 이동, 회전 또는 스케일을 적용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les îles pour les sélectionner, puis appliquez un mouvement, une rotation ou une échelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
