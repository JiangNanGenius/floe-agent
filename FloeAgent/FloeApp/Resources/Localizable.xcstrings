    "setup.features.auxiliary.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Add a fast vision model for non-visual chats and a lightweight model for automatic approval review." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "为非视觉对话配置快速读图模型，并用轻量模型执行自动审批。" } }
      }
    },
    "setup.features.auxiliary.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Vision and approval models" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "视觉与审批模型" } }
      }
    },
    "setup.features.background.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Picture in Picture keeps active tasks visible in the background; screen access is requested only when needed." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "画中画在后台展示活动任务；屏幕权限只在任务确实需要时申请。" } }
      }
    },
    "setup.features.background.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Background continuity" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "后台持续运行" } }
      }
    },
    "setup.features.canvas.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Each workspace includes a native infinite canvas for notes, sketches, and visual planning. Standard MCP servers remain optional and are disabled for canvas by default." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "每个工作区都可使用原生无限画布整理文本、手绘与视觉规划；标准 MCP 为可选能力，默认不会开放给画布。" } }
      }
    },
    "setup.features.canvas.title": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Native infinite canvas" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "原生无限画布" } }
      }
    },
    "setup.features.connections.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Enable web search, Apple capabilities, remote devices, or standard MCP servers only for the workflows you use." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "按需启用联网搜索、Apple 能力、远程设备或标准 MCP，模型会在任务中组合使用。" } }
      }
    },
    "setup.features.connections.title": {
