    "app.bilingual.2fde7c615854473e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高级浏览器功能允许任务读取此任务浏览器中的 Cookie、登录状态和网站存储，并让网页请求复用浏览器会话。启用后，账号、登录状态和私人页面内容可能随任务请求发送给你配置的模型提供商。官方提供商同样适用，没有任何提供商可被视为零风险。授权按提供商保留，不会按网站重复询问；关闭后，正在进行的敏感读取结果会被丢弃。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advanced browser features let a task read cookies, login state and website storage from its browser, and let web requests reuse the browser session. When on, accounts, login state and private page content may be sent to your configured model provider as part of task requests. Official providers are not exempt; no provider is risk-free. Authorization is retained per provider, not requested per site. Turning it off discards in-flight sensitive results."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高階瀏覽器功能允許任務讀取此任務瀏覽器中的 Cookie、登入狀態和網站儲存，並讓網頁請求複用瀏覽器會話。啟用後，賬號、登入狀態和私人頁面內容可能隨任務請求傳送給你配置的模型提供商。官方提供商同樣適用，沒有任何提供商可被視為零風險。授權按提供商保留，不會按網站重複詢問；關閉後，正在進行的敏感讀取結果會被丟棄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度なブラウザ機能により、タスクはブラウザからクッキー、ログイン状態、ウェブサイトのストレージを読み取り、ウェブリクエストでブラウザのセッションを再利用できます。 有効な場合、アカウント、ログイン状態、およびプライベートページのコンテンツは、タスクリクエストの一部として、設定されたモデルプロバイダーに送信される可能性があります。 公式のプロバイダーは免除されません；いかなるプロバイダーもリスクがないわけではありません。 認可はプロバイダーごとに保持され、サイトごとに要求されません。 それをオフにすると、飛行中の機密結果が破棄されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 브라우저 기능을 사용하면 작업이 브라우저에서 쿠키, 로그인 상태 및 웹사이트 저장소를 읽고, 웹 요청이 브라우저 세션을 재사용하도록 합니다. 켜져 있는 경우, 계정, 로그인 상태 및 개인 페이지 콘텐츠가 작업 요청의 일부로 구성된 모델 제공자에게 전송될 수 있습니다. 공식 제공자는 면제되지 않으며, 어떤 제공자도 위험이 없습니다. 인증은 제공자별로 유지되며, 사이트별로 요청되지 않습니다. 끄면 비행 중 민감한 결과가 삭제됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités avancées du navigateur permettent à une tâche de lire les cookies, l'état de connexion et le stockage du site Web à partir de son navigateur, et permettent aux requêtes Web de réutiliser la session du navigateur. Lorsqu'ils sont activés, les comptes, l'état de connexion et le contenu de la page privée peuvent être envoyés à votre fournisseur de modèle configuré dans le cadre des demandes de tâches. Les fournisseurs officiels ne sont pas exemptés ; aucun fournisseur n'est sans risque. L'autorisation est conservée par fournisseur, pas demandée par site. L'éteindre rejette les résultats sensibles en vol."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweiterte Browserfunktionen ermöglichen es einer Aufgabe, Cookies, Anmeldestatus und Website-Speicher aus ihrem Browser zu lesen und Webanfragen die Browsersitzung wiederzuverwenden. Wenn Sie online sind, können Konten, Anmeldestatus und private Seiteninhalte als Teil von Aufgabenanforderungen an Ihren konfigurierten Modellanbieter gesendet werden. Offizielle Anbieter sind nicht ausgenommen; kein Anbieter ist risikofrei. Die Autorisierung wird pro Anbieter beibehalten, nicht pro Standort angefordert. Wenn Sie es ausschalten, werden sensible Ergebnisse während des Fluges verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones avanzadas del navegador permiten que una tarea lea las cookies, el estado de inicio de sesión y el almacenamiento del sitio web desde su navegador, y permiten que las solicitudes web reutilicen la sesión del navegador. Cuando están activados, las cuentas, el estado de inicio de sesión y el contenido de la página privada se pueden enviar a su proveedor de modelos configurado como parte de las solicitudes de tareas. Los proveedores oficiales no están exentos; ningún proveedor está libre de riesgos. La autorización se conserva por proveedor, no se solicita por sitio. Al apagarlo, se descartan los resultados sensibles en vuelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos avançados do navegador permitem que uma tarefa leia cookies, o estado de login e o armazenamento do site de seu navegador e permitem que as solicitações da web reutilizem a sessão do navegador. Quando ativos, as contas, o estado de login e o conteúdo da página privada podem ser enviados ao provedor de modelo configurado como parte das solicitações de tarefas. Provedores oficiais não estão isentos; nenhum provedor está livre de riscos. A autorização é mantida por provedor, não solicitada por local. Desligá-lo descarta resultados sensíveis durante o voo."
          }
        }
      }
    },
    "app.bilingual.4221f956b41391a2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器会话数据（包括 Cookie、登录状态和本地存储）可能随任务请求发送给该模型提供商。官方与第三方提供商承担相同的信任风险；没有任何提供商可被视为零风险。授权会按提供商保留，不会按网站或每次调用重复询问。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser session data (including cookies, login state and local storage) may be sent to this model provider as part of task requests. Official and third-party providers carry the same trust risk; no provider is risk-free. Authorization is retained per provider and is not requested per site or per call."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器會話資料（包括 Cookie、登入狀態和本地儲存）可能隨任務請求傳送給該模型提供商。官方與第三方提供商承擔相同的信任風險；沒有任何提供商可被視為零風險。授權會按提供商保留，不會按網站或每次呼叫重複詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのセッションデータ（クッキー、ログイン状態、ローカルストレージを含む）は、タスクリクエストの一部としてこのモデルプロバイダーに送信されることがあります。 公的プロバイダーとサードパーティプロバイダーは同じ信頼リスクを負っており、いかなるプロバイダーもリスクがないということはありません。 認証はプロバイダーごとに保持され、サイトごとや通話ごとに要求されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 세션 데이터(쿠키, 로그인 상태 및 로컬 저장소 포함)는 작업 요청의 일부로 이 모델 제공자에게 전송될 수 있습니다. 공식 및 제3자 제공자는 동일한 신뢰 위험을 가지고 있으며, 어떤 제공자도 위험이 없는 것은 아닙니다. 승인은 제공자별로 유지되며 사이트별이나 통화별로 요청되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de session du navigateur (y compris les cookies, l'état de connexion et le stockage local) peuvent être envoyées à ce fournisseur de modèle dans le cadre de demandes de tâches. Les fournisseurs officiels et tiers comportent le même risque de confiance ; aucun fournisseur n'est exempt de risque. L'autorisation est conservée par fournisseur et n'est pas demandée par site ou par appel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser-Sitzungsdaten (einschließlich Cookies, Anmeldestatus und lokaler Speicher) können als Teil von Aufgabenanfragen an diesen Modellanbieter gesendet werden. Offizielle und Drittanbieter tragen das gleiche Vertrauensrisiko; kein Anbieter ist risikofrei. Die Autorisierung wird pro Anbieter beibehalten und nicht pro Standort oder pro Anruf angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la sesión del navegador (incluidas las cookies, el estado de inicio de sesión y el almacenamiento local) se pueden enviar a este proveedor de modelos como parte de las solicitudes de tareas. Los proveedores oficiales y terceros conllevan el mismo riesgo de confianza; ningún proveedor está libre de riesgos. La autorización se retiene por proveedor y no se solicita por sitio o por llamada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados da sessão do navegador (incluindo cookies, status de login e armazenamento local) podem ser enviados a este provedor de modelo como parte de solicitações de tarefas. Provedores oficiais e terceirizados carregam o mesmo risco de confiança; nenhum provedor está livre de risco. A autorização é mantida por provedor e não é solicitada por local ou por chamada."
          }
        }
      }
    },
