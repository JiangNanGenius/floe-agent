    "settings.settings_root_view.the_canvas_assistant_handles_search_reading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas assistant handles search, reading assets and calling generation tools; the screen-understanding model recognizes handwriting, sketches and visual content that non-multimodal models cannot read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布助手负责搜索、读取素材与调用生成工具；画面理解模型负责识别笔迹、草图和非多模态模型无法读取的视觉内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布助手負責搜尋、讀取素材與呼叫生成工具；畫面理解模型負責識別筆跡、草圖和非多模態模型無法讀取的視覺內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスアシスタントは検索、アセットの読み取り、生成ツールの呼び出しを処理し、スクリーン理解モデルは、非マルチモーダルモデルでは読み取れない手書き、スケッチ、ビジュアルコンテンツを認識します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 어시스턴트는 검색, 읽기 자산 및 생성 도구 호출을 처리합니다; 화면 이해 모델은 비멀티모달 모델이 읽을 수 없는 손글씨, 스케치 및 시각 콘텐츠를 인식합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant de toile gère les outils de recherche, de lecture d'actifs et de génération d'appels ; le modèle de compréhension d'écran reconnaît l'écriture manuscrite, les croquis et le contenu visuel que les modèles non multimodaux ne peuvent pas lire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Canvas-Assistent verarbeitet Such-, Lese-Assets- und Anrufgenerierungstools; das Bildschirmverständnismodell erkennt Handschrift, Skizzen und visuelle Inhalte, die nicht multimodale Modelle nicht lesen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente de lienzo maneja herramientas de búsqueda, lectura y generación de llamadas; el modelo de comprensión de pantalla reconoce la escritura a mano, bocetos y contenido visual que los modelos no multimodales no pueden leer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O assistente de tela lida com ferramentas de pesquisa, leitura, leitura de ativos e geração de chamadas; o modelo de compreensão de tela reconhece caligrafia, esboços e conteúdo visual que modelos não multimodais não conseguem ler."
          }
        }
      }
    },
    "settings.settings_root_view.turning_sync_off_only_stops_transfers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning sync off only stops transfers; it does not delete uploaded canvases or assets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步只停止传输，不会删除已上传的画布或素材。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉同步只停止傳輸，不會刪除已上傳的畫布或素材。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期をオフにすると、転送は停止するだけで、アップロードされたキャンバスやアセットは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화를 끄면 전송만 중단되고, 업로드된 캔버스나 자산은 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désactivation de la synchronisation n'arrête que les transferts ; elle ne supprime pas les toiles ou les ressources téléchargées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ausschalten der Synchronisierung stoppt nur die Übertragungen; hochgeladene Canvas oder Assets werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivar la sincronización solo detiene las transferencias; no elimina los lienzos o activos cargados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar a sincronização apenas interrompe as transferências; ele não exclui telas ou ativos carregados."
          }
        }
      }
    },
