    "settings.internal_prompts.auto_update_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the global declarative-content policy; it never applies content with scripts and never grants new permissions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是全局声明式内容策略；它不会自动应用含脚本的内容，也不会授予任何新权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是全域性宣告式內容策略；它不會自動應用含指令碼的內容，也不會授予任何新許可權。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはグローバル宣言コンテンツポリシーであり、スクリプトでコンテンツを適用せず、新しい権限を付与しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 전역 선언적 콘텐츠 정책이며, 스크립트를 사용한 콘텐츠를 절대 적용하지 않으며 새로운 권한을 부여하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit de la politique globale de contenu déclaratif ; elle n'applique jamais de contenu avec des scripts et n'accorde jamais de nouvelles autorisations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die globale Richtlinie für deklarative Inhalte; sie wendet niemals Inhalte mit Skripten an und gewährt niemals neue Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la política global de contenido declarativo; nunca aplica contenido con scripts y nunca otorga nuevos permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a política global de conteúdo declarativo; ela nunca aplica conteúdo com scripts e nunca concede novas permissões."
          }
        }
      }
    },
