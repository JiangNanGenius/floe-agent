    "app.bilingual.4cdda192a896311d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个大纲格式不保留关联与流程连线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This outline format does not preserve relationship or flow connections."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個大綱格式不保留關聯與流程連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアウトライン形式は、関係性やフローの接続を保持しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개요 형식은 관계 또는 흐름 연결을 보존하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format de contour ne préserve pas les connexions de relation ou de flux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gliederungsformat behält keine Beziehungs- oder Flussverbindungen bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de esquema no preserva las conexiones de relación o flujo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este formato de esboço não preserva conexões de relacionamento ou fluxo."
          }
        }
      }
    },
    "app.bilingual.91984d3f3da5e06c": {
      "extractionState": "manual",
      "localizations": {
