        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 형태에 표시할 수 없는 얼굴 재료를 저장했습니다. Material에서 그들을 재배정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a enregistré des matériaux de visage qui ne peuvent pas être montrés sur cette forme. Réattribuez-les dans Matériel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat Gesichtsmaterialien gespeichert, die auf dieser Form nicht gezeigt werden können. Weisen Sie sie in Material neu zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha guardado materiales de cara que no se pueden mostrar en esta forma. Reasignarlos en Material."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
