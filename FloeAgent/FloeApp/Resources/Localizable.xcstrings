    "goal.create_failed_preserved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal could not start. Your content is kept; check the run settings and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能启动目标。内容已保留，请检查运行设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能啟動目標。內容已保留，請檢查執行設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標は開始できませんでした。 コンテンツは保持されています。実行設定を確認し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 시작할 수 없습니다. 귀하의 콘텐츠는 보관됩니다; 실행 설정을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'objectif n'a pas pu commencer. Votre contenu est conservé ; vérifiez les paramètres d'exécution et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ziel konnte nicht beginnen. Ihr Inhalt wird beibehalten; überprüfen Sie die Laufeinstellungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo no pudo comenzar. Su contenido se conserva; compruebe la configuración de ejecución e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O gol não pôde começar. Seu conteúdo é mantido; verifique as configurações de execução e tente novamente."
          }
        }
      }
    },
    "goal.saved_setup_resume": {
      "extractionState": "manual",
      "localizations": {
