          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesuré pendant l'optimisation ; d'autres activités de l'appareil peuvent affecter cette valeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während der Optimierung gemessen; andere Geräteaktivitäten können diesen Wert beeinflussen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido durante la optimización; otra actividad del dispositivo puede afectar este valor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Medido durante a otimização; outra atividade do dispositivo pode afetar esse valor."
