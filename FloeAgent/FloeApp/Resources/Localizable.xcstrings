    "voice.assistant.priority.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some saved services are unavailable; they stay in your order and are skipped until ready."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分已保存服务暂不可用；它们会保留在顺序中，就绪前会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分已儲存服務暫不可用；它們會保留在順序中，就緒前會被跳過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の保存されたサービスはご利用いただけません。ご注文に残り、準備が完了するまでスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 저장된 서비스는 이용할 수 없으며, 주문에 남아 준비될 때까지 건너뛰게 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains services enregistrés ne sont pas disponibles ; ils restent dans votre commande et sont ignorés jusqu'à ce qu'ils soient prêts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige gespeicherte Dienste sind nicht verfügbar; sie bleiben in Ihrer Bestellung und werden übersprungen, bis sie fertig sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servicios guardados no están disponibles; se quedan en su pedido y se omiten hasta que estén listos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns serviços salvos não estão disponíveis; eles permanecem no seu pedido e são ignorados até que estejam prontos."
          }
        }
      }
    },
