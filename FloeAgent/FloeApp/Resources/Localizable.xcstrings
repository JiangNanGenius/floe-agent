    "canvas.generation.running.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task and artifact cards will stay in sync. You can cancel this attempt without creating another artifact node."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务卡与产物卡会同步显示进度；可取消本次尝试，且不会新增产物节点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務卡與產物卡會同步顯示進度；可取消本次嘗試，且不會新增產物節點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクカードとアーティファクトカードは同期されたままです。 別のアーティファクトノードを作成せずに、この試みをキャンセルできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 카드와 유물 카드는 동기화된 상태를 유지합니다. 다른 아티팩트 노드를 생성하지 않고도 이 시도를 취소할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cartes de tâche et d'artefact resteront synchronisées. Vous pouvez annuler cette tentative sans créer un autre nœud d'artefact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgaben- und Artefaktkarten bleiben synchron. Sie können diesen Versuch abbrechen, ohne einen weiteren Artefaktknoten zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tarjetas de tareas y artefactos se mantendrán sincronizadas. Puedes cancelar este intento sin crear otro nodo de artefacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As cartas de tarefa e artefato permanecerão sincronizadas. Você pode cancelar esta tentativa sem criar outro nó de artefato."
          }
        }
      }
    },
