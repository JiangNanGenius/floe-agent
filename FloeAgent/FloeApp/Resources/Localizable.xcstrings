    "cad.recovery.canvas.saveFailedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered copy is still open. Save it again before closing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复副本仍处于打开状态，请再次保存后关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復副本仍處於開啟狀態，請再次儲存後關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元されたコピーはまだ開いたままです。 閉じる前にもう一度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구된 복사본이 아직 열려 있습니다. 닫기 전에 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie récupérée est toujours ouverte. Enregistrez-le à nouveau avant de fermer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wiederhergestellte Kopie ist noch offen. Speichern Sie es erneut, bevor Sie es schließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia recuperada todavía está abierta. Guárdalo de nuevo antes de cerrarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia recuperada ainda está aberta. Salve-o novamente antes de fechar."
          }
        }
      }
    },
