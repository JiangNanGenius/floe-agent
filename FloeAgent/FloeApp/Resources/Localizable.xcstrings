    "app.bilingual.9401440d1f8dd902": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出当前音符、表达、音色编号和速度拍号；音频与原文件的其他事件保留在工程包中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports edited notes, expression, programs, tempo and meter. Audio and other original events remain in the project package."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出當前音符、表達、音色編號和速度拍號；音訊與原檔案的其他事件保留在工程包中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集されたノート、表現、プログラム、テンポ、メーターをエクスポートします。 音声やその他のオリジナルイベントはプロジェクトパッケージに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집된 노트, 표현, 프로그램, 템포 및 박자를 내보냅니다. 오디오 및 기타 원본 이벤트는 프로젝트 패키지에 그대로 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte les notes éditées, l'expression, les programmes, le tempo et la mesure. L'audio et d'autres événements originaux restent dans le package du projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiert bearbeitete Notizen, Ausdrücke, Programme, Tempo und Meter. Audio und andere Originalereignisse verbleiben im Projektpaket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta notas editadas, expresión, programas, tempo y metro. El audio y otros eventos originales permanecen en el paquete del proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta notas editadas, expressão, programas, ritmo e metro. Áudio e outros eventos originais permanecem no pacote do projeto."
          }
        }
      }
    },
