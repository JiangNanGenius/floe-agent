    "notes.notes_agent_tools.this_content_is_not_a_mind_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content is not a mind map; for note pages use pageID or section=pages. Other types provide only a read-only summary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此内容不是思维导图；手记页面请用 pageID 或 section=pages，其他类型仅提供只读摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此內容不是思維導圖；手記頁面請用 pageID 或 section=pages，其他型別僅提供只讀摘要。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツはマインドマップではありません。ノートページには pageID または section=pages を使用してください。 他のタイプは読み取り専用の要約のみを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠는 마인드맵이 아닙니다; 메모 페이지는 pageID 또는 section=pages를 사용하십시오. 다른 유형은 읽기 전용 요약만 제공합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu n'est pas une carte mentale ; pour les pages de notes, utilisez pageID ou section=pages. D'autres types ne fournissent qu'un résumé en lecture seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt ist keine Mind Map; für Notizseiten verwenden Sie pageID oder section=pages. Andere Typen bieten nur eine schreibgeschützte Zusammenfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido no es un mapa mental; para las páginas de notas, use pageID o section=pages. Otros tipos proporcionan solo un resumen de solo lectura."
