    },
    "app.workspace_canvas_view.the_drawing_was_saved_to": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸已保存到素材库；应用回画布失败，草稿已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing was saved to the library; applying it back failed and the draft is preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙已儲存到素材庫；應用回畫布失敗，草稿已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面はライブラリに保存されましたが、再適用に失敗し、下書きは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도면이 라이브러리에 저장되었습니다; 다시 적용하지 못해 초안이 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin a été enregistré dans la bibliothèque ; son application a échoué et le brouillon est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung wurde in der Bibliothek gespeichert; die Anwendung ist fehlgeschlagen und der Entwurf ist erhalten geblieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo se guardó en la biblioteca; la aplicación de nuevo falló y el borrador se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho foi salvo na biblioteca; aplicá-lo de volta falhou e o rascunho é preservado."
          }
        }
      }
    },
    "app.workspace_canvas_view.the_canvas_node_was_updated": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新画布节点，但草稿记录暂未写入；已保留并会自动重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas node was updated, but the draft record could not be persisted yet; it is kept and will be retried."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已更新畫布節點，但草稿記錄暫未寫入；已保留並會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスノードは更新されましたが、ドラフトレコードはまだ永続化できませんでした。保持されており、再実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 노드가 업데이트되었지만 초안 레코드를 아직 지속할 수 없으며, 유지되고 다시 시도될 예정입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nœud de toile a été mis à jour, mais l'enregistrement du brouillon n'a pas encore pu être conservé ; il est conservé et sera réessayé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Canvas-Node wurde aktualisiert, aber der Entwurfsdatensatz konnte noch nicht beibehalten werden; er bleibt erhalten und wird erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nodo del lienzo se actualizó, pero el registro del borrador aún no se pudo persistir; se conserva y se volverá a intentar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nó da tela foi atualizado, mas o registro de rascunho ainda não pôde ser persistente; ele foi mantido e será tentado novamente."
          }
        }
      }
    },
    "app.workspace_canvas_view.the_drawing_was_saved_to_2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
