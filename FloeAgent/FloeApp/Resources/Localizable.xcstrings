    "cad.versions.details.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo and Redo stay in this open session. A checkpoint is durable; it is not an Undo entry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销和重做仅存在于当前打开的会话。检查点会持久保存，但不是撤销条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷和重做僅存在於當前開啟的會話。檢查點會持久儲存，但不是撤銷條目。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo と Redo はこのオープンセッションにとどまっています。 チェックポイントは永続的であり、元に戻すエントリではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo와 Redo는 이 열린 세션에 남아 있습니다. 체크포인트는 내구성이 있으며, 실행 취소 항목이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler et Redo restent dans cette session ouverte. Un point de contrôle est durable ; ce n'est pas une entrée Annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückgängig machen und Wiederholen bleiben Sie in dieser offenen Sitzung. Ein Kontrollpunkt ist dauerhaft; es ist kein Rückgängig-Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer y Rehacer permanecer en esta sesión abierta. Un punto de control es duradero; no es una entrada de deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer e Refazem permanecer nesta sessão aberta. Um ponto de verificação é durável; não é uma entrada de Desfazer."
          }
        }
      }
    },
