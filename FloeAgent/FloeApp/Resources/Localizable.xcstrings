    "settings.environment_language_packages_view.scripts_that_depend_on_this_package": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts that depend on this package may not run; the version in the parent environment is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖此包的脚本可能无法运行；父环境中的版本会继续保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依賴此包的指令碼可能無法執行；父環境中的版本會繼續保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパッケージに依存しているスクリプトは実行できない場合があります；親環境のバージョンが保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 패키지에 의존하는 스크립트는 실행되지 않을 수 있으며, 상위 환경의 버전은 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scripts qui dépendent de ce paquet peuvent ne pas s'exécuter ; la version dans l'environnement parent est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skripte, die von diesem Paket abhängen, werden möglicherweise nicht ausgeführt; die Version in der übergeordneten Umgebung bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que los scripts que dependen de este paquete no se ejecuten; la versión en el entorno principal se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Scripts que dependem deste pacote não podem ser executados; a versão no ambiente pai é mantida."
          }
        }
      }
    },
