    "mail.error.protocolRejected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server rejected the operation or does not support it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝该操作或不支持该能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕該操作或不支援該能力。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
