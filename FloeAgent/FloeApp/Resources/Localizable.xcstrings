          "stringUnit": {
            "state": "translated",
            "value": "データソースは一時的に利用できません。 再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 소스가 일시적으로 이용할 수 없습니다. 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source de données est temporairement indisponible. Réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datenquelle ist vorübergehend nicht verfügbar. Erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de datos no está disponible temporalmente. Vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte de dados está temporariamente indisponível. Tente novamente."
          }
        }
      }
    },
