    "cad.recovery.restored.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The damaged document and its last saved version were left unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "损坏的文档及其上次保存的版本均已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "損壞的文件及其上次儲存的版本均已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破損した文書とその最後に保存されたバージョンは変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 문서와 마지막으로 저장된 버전은 그대로 유지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document endommagé et sa dernière version enregistrée ont été laissés inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das beschädigte Dokument und seine zuletzt gespeicherte Version blieben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento dañado y su última versión guardada se dejaron sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento danificado e sua última versão salva foram deixados inalterados."
          }
        }
      }
    },
    "cad.recovery.canvas.unbound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recovered copy isn't linked to the canvas node. The node still points to the damaged document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此恢复副本未与画布节点关联。节点仍指向损坏的文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此恢復副本未與畫布節點關聯。節點仍指向損壞的文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この復元されたコピーはキャンバスノードにリンクされていません。 ノードは依然として破損した文書を指しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복구된 복사본은 캔버스 노드에 연결되어 있지 않습니다. 노드가 여전히 손상된 문서를 가리키고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie récupérée n'est pas liée au nœud de canevas. Le nœud pointe toujours vers le document endommagé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese wiederhergestellte Kopie ist nicht mit dem Canvas-Noten verknüpft. Der Knoten zeigt immer noch auf das beschädigte Dokument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia recuperada no está vinculada al nodo canvas. El nodo todavía apunta al documento dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cópia recuperada não está vinculada ao nó da tela. O nó ainda aponta para o documento danificado."
          }
        }
      }
    },
