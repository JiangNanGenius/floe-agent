    "app.bilingual.d3d7e88ae930961a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将片段中的语音保存为新字幕轨；已有字幕会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
