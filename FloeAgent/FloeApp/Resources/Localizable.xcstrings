    "memory.memory_view.deterministic_duplicates_are_cleaned_automatically_semantic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministic duplicates are cleaned automatically; semantic conflicts and version changes are proposed by the model and applied only after confirmation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定性重复会自动清理；语义冲突和版本变化由模型提出建议，确认后再应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定性重複會自動清理；語義衝突和版本變化由模型提出建議，確認後再應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決定的な重複は自動的に除去されます；セマンティックな競合やバージョン変更はモデルによって提案され、確認後にのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정적 중복은 자동으로 정리되며, 의미 충돌 및 버전 변경은 모델이 제안하고 확인된 후에만 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les doublons déterministes sont nettoyés automatiquement ; les conflits sémantiques et les changements de version sont proposés par le modèle et appliqués uniquement après confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deterministische Duplikate werden automatisch bereinigt; semantische Konflikte und Versionsänderungen werden vom Modell vorgeschlagen und erst nach der Bestätigung angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los duplicados deterministas se limpian automáticamente; los conflictos semánticos y los cambios de versión son propuestos por el modelo y aplicados solo después de la confirmación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicatas determinísticas são limpas automaticamente; conflitos semânticos e alterações de versão são propostos pelo modelo e aplicados somente após a confirmação."
          }
        }
      }
    },
