    "app.storage_optimization_service.an_unfinished_optimization_needs_recovery": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的整理需要恢复，资料已保留。请稍后重试；若仍失败，请上传反馈日志。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unfinished optimization needs recovery. Data was kept. Try again later; if it persists, send a diagnostic report."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有未完成的整理需要恢復，資料已保留。請稍後重試；若仍失敗，請上傳反饋日誌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完成の最適化は回復が必要です。 データは保持されました。 後ほど再度お試しください。もし解決しない場合は、診断レポートを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
