    "cad.sculpt.captureAttributes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meshes with UVs or face textures cannot be prepared yet. The source is kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持将带 UV 或面纹理的网格转为可雕刻网格，原对象会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫不支援將帶 UV 或面紋理的網格轉為可雕刻網格，原物件會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UVやフェイステクスチャを使用したメッシュはまだ準備できません。 情報源は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UV 또는 얼굴 텍스처가 포함된 메시는 아직 준비할 수 없습니다. 소스는 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mailles avec des UV ou des textures de visage ne peuvent pas encore être préparées. La source est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maschen mit UV-Streichen oder Gesichtstexturen können noch nicht vorbereitet werden. Die Quelle wird beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mallas con UV o texturas faciales aún no se pueden preparar. Se mantiene la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Malhas com UVs ou texturas de rosto ainda não podem ser preparadas. A fonte é mantida."
          }
        }
      }
    },
    "cad.sculpt.captureLimit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This mesh exceeds the preparation limit. Use Mesh → Simplify before sculpting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网格超出雕刻准备上限，请先使用网格中的简化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此網格超出雕刻準備上限，請先使用網格中的簡化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッシュは準備上限を超えています。 彫刻する前に Mesh → Simplify を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시는 준비 한도를 초과합니다. Mesh → Simplify를 사용하여 조각하기 전에."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
