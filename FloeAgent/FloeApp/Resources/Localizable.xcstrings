    "app.bilingual.9ac4f6a0b88791ce": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布内容或所属工作区不匹配，原文件已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas content or workspace does not match. The original file was retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布內容或所屬工作區不匹配，原檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスのコンテンツまたはワークスペースが一致しません。 元のファイルは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 콘텐츠 또는 작업 공간이 일치하지 않습니다. 원본 파일이 보존되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu du canevas ou l'espace de travail ne correspond pas. Le fichier original a été conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Canvas-Inhalt oder der Arbeitsbereich stimmen nicht überein. Die Originaldatei wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido del lienzo o el espacio de trabajo no coinciden. Se retuvo el archivo original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo da tela ou o espaço de trabalho não correspondem. O arquivo original foi mantido."
          }
        }
      }
    },
