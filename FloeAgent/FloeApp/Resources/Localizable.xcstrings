    "app.bilingual.34a59c56581cd0ec": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先启用车削速度与进给。输入当前材料和实际切削条件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable turning speeds and feeds first. Supply the current material and actual cutting conditions."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先啟用車削速度與進給。輸入當前材料和實際切削條件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回転速度とフィードを先に有効にしてください。 現在の材料と実際の切断条件をご提供ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회전 속도와 피드를 먼저 활성화하십시오. 현재 재료와 실제 절단 조건을 제공하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d'abord les vitesses de rotation et les alimentations. Fournir le matériel actuel et les conditions de coupe réelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie zuerst Drehgeschwindigkeiten und Feeds. Liefern Sie das aktuelle Material und die tatsächlichen Schnittbedingungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite las velocidades de giro y las alimentaciones primero. Suministrar el material actual y las condiciones reales de corte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative velocidades de giro e alimenta primeiro. Forneça o material atual e as condições reais de corte."
          }
        }
      }
    },
