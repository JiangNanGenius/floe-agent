    "app.bilingual.286105001235cb54": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可靠依据时仍可人工选择。未识别到手头证据的选项会保存为手动未验证，运行和构建不会开放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still choose manually without reliable evidence. A choice without a recognized marker is saved as manual/unverified and does not unlock run or build."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可靠依據時仍可人工選擇。未識別到手頭證據的選項會儲存為手動未驗證，執行和構建不會開放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる証拠がなくても、手動で選択できます。 認識されたマーカーがない選択は、手動/未検証として保存され、実行やビルドのロックが解除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 증거 없이도 여전히 수동으로 선택할 수 있습니다. 인식된 마커가 없는 선택은 수동/검증되지 않은 것으로 저장되며 실행이나 빌드의 잠금을 해제하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours choisir manuellement sans preuve fiable. Un choix sans marqueur reconnu est enregistré comme manuel/non vérifié et ne déverrouille pas l'exécution ou la construction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können immer noch manuell ohne zuverlässige Beweise wählen. Eine Auswahl ohne einen erkannten Marker wird als manuell/unverifiziert gespeichert und entsperrt nicht den Lauf oder den Build."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía puedes elegir manualmente sin pruebas confiables. Una opción sin un marcador reconocido se guarda como manual/no verificado y no desbloquea la ejecución o la compilación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode escolher manualmente sem evidências confiáveis. Uma escolha sem um marcador reconhecido é salva como manual/não verificada e não desbloqueia a execução ou a compilação."
          }
        }
      }
    },
