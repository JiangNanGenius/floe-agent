    "workspace.workspace_canvas_view.this_submits_a_new_provider_task": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This submits a new provider task. The original task record and parameters are kept for audit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会提交一个新的供应商任务。原任务记录和参数会保留用于审计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會提交一個新的供應商任務。原任務記錄和引數會保留用於審計。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
