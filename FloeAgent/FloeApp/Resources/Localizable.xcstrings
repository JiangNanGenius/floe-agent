    "app.bilingual.1080ac22280aa700": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件很大，行号索引未完整建立；阅读与位置保存不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is large, so the line index is partial; reading and positions still work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案很大，行號索引未完整建立；閱讀與位置儲存不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは大きいため、行インデックスが部分的です。読み取りと位置はまだ機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 크기 때문에 줄 인덱스가 부분적이며, 읽기와 위치는 여전히 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est volumineux, donc l'index de la ligne est partiel ; la lecture et les positions fonctionnent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei ist groß, daher ist der Linienindex teilweise; Lesen und Positionen funktionieren immer noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo es grande, por lo que el índice de línea es parcial; la lectura y las posiciones siguen funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo é grande, então o índice de linha é parcial; a leitura e as posições ainda funcionam."
          }
        }
      }
    },
