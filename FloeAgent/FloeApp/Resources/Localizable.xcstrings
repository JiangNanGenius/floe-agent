    "workspace.i_d_e_language_run_view.the_remote_staging_directory_holds_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote staging directory holds data this run does not own; nothing was overwritten"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
