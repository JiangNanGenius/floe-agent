    "app.bilingual.5f6c6f02a3b54582": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会改写 game.json。安装会记录审核过的桥文件；导出或运行时把同样的惰性桥写入私有运行副本。已导出的可玩游戏无需再次导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "game.json is never rewritten. Installation records the reviewed bridge; the exporter or run path stamps the same dormant bridge into a private playable copy. An already-exported game needs no re-export."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會改寫 game.json。安裝會記錄稽核過的橋檔案；匯出或執行時把同樣的惰性橋寫入私有執行副本。已匯出的可玩遊戲無需再次匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.jsonは決して書き直されません。 インストールはレビューされたブリッジを記録し、エクスポーターまたは実行パスは同じ休止ブリッジをプライベートなプレイ可能なコピーにスタンプします。 既に輸出されたゲームは再輸出の必要がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.json은 절대 다시 작성되지 않습니다. 설치는 검토된 브리지를 기록합니다; 내보내기 또는 실행 경로는 동일한 휴면 브리지를 비공개 플레이 가능한 복사본에 스탬프합니다. 이미 수출된 게임은 재수출이 필요하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.json n'est jamais réécrit. L'installation enregistre le pont examiné ; l'exportateur ou le chemin d'exécution tamponne le même pont dormant dans une copie jouable privée. Un jeu déjà exporté n'a pas besoin d'être réexporté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.json wird nie neu geschrieben. Die Installation zeichnet die überprüfte Brücke auf; der Exporteur oder der Laufpfad stempelt dieselbe ruhende Brücke in eine private spielbare Kopie. Ein bereits exportiertes Spiel muss nicht erneut exportiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.json nunca se reescribe. La instalación registra el puente revisado; el exportador o la ruta de ejecución sella el mismo puente inactivo en una copia privada jugable. Un juego ya exportado no necesita reexportación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Game.json nunca é reescrito. A instalação registra a ponte revisada; o exportador ou o caminho de execução carimba a mesma ponte inativa em uma cópia privada jogável. Um jogo já exportado não precisa de reexportação."
          }
        }
      }
    },
    "app.bilingual.d008c3bea76e46ae": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建 Creator 3.8 组件与精确 .meta UUID，并挂接到所选场景。需要重新构建网页版；不会覆盖同名用户脚本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates the Creator 3.8 component and exact .meta UUID and attaches it to the selected scene. A Web rebuild is required; a same-name user script is never overwritten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立 Creator 3.8 元件與精確 .meta UUID，並掛接到所選場景。需要重新構建網頁版；不會覆蓋同名使用者指令碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Creator 3.8 コンポーネントと正確な .meta UUID を作成し、選択したシーンに添付します。 Web の再構築が必要です；同名のユーザースクリプトは決して上書きされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Creator 3.8 구성 요소와 정확한 .meta UUID를 생성하고 선택한 씬에 연결합니다. 웹 재구성이 필요합니다; 동일한 이름의 사용자 스크립트는 절대 덮어쓰지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée le composant Creator 3.8 et l'UUID exact .meta et l'attache à la scène sélectionnée. Une reconstruction Web est nécessaire ; un script utilisateur du même nom n'est jamais écrasé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt die Creator 3.8-Komponente und die genaue .meta-UUID und hängt sie der ausgewählten Szene an. Ein Web-Neuaufbau ist erforderlich; ein Benutzerskript mit demselben Namen wird niemals überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea el componente Creator 3.8 y el UUID exacto .meta y lo adjunta a la escena seleccionada. Se requiere una reconstrucción web; un script de usuario con el mismo nombre nunca se sobrescribe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria o componente Creator 3.8 e o .meta UUID exato e o anexa à cena selecionada. Uma reconstrução da Web é necessária; um script de usuário com o mesmo nome nunca é substituído."
          }
        }
      }
    },
    "app.bilingual.c4db3a4c2222d04a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过现有工程仓库安装审核过的开发钩子；安装后需要重新构建对应导出。普通导出保持惰性。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs the reviewed development hook through the existing project repository; rebuild the matching export afterward. Ordinary exports stay dormant."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過現有工程倉庫安裝稽核過的開發鉤子；安裝後需要重新構建對應匯出。普通匯出保持惰性。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のプロジェクトリポジトリを通じてレビュー済みの開発フックをインストールし、その後、対応するエクスポートを再構築します。 通常の輸出は休眠状態のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토된 개발 훅을 기존 프로젝트 저장소를 통해 설치하고, 이후에 일치하는 내보내기를 재구축합니다. 일반적인 수출은 침체된 상태를 유지하고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe le crochet de développement examiné via le référentiel de projet existant ; reconstruit l'exportation correspondante par la suite. Les exportations ordinaires restent inactives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert den überarbeiteten Entwicklungs-Hook über das vorhandene Projekt-Repository; baut den entsprechenden Export danach wieder auf. Gewöhnliche Exporte bleiben ruhend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el gancho de desarrollo revisado a través del repositorio del proyecto existente; reconstruye la exportación coincidente después. Las exportaciones ordinarias permanecen inactivas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o gancho de desenvolvimento revisado através do repositório do projeto existente; reconstrua a exportação correspondente depois. As exportações comuns permanecem inativas."
          }
        }
      }
    },
    "app.bilingual.4ef767faaee42e1d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到与已审阅记录一致的完整源码包。请选择精确源码包文件，或包含全部声明文件的已物化源码伴随目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No complete source bundle matching the reviewed record was found. Choose the exact bundle file, or a materialized source-companion folder containing every declared file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有找到與已審閱記錄一致的完整原始碼包。請選擇精確原始碼包檔案，或包含全部宣告檔案的已物化原始碼伴隨目錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レビューされたレコードに一致する完全なソースバンドルは見つかりませんでした。 正確なバンドルファイルを選択するか、すべての宣言されたファイルを含む実体化されたソースコンパニオンフォルダーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토된 기록과 일치하는 완전한 소스 번들이 발견되지 않았습니다. 정확한 번들 파일을 선택하거나, 선언된 모든 파일을 포함하는 구체화된 소스‐컴패니언 폴더를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paquet de sources complet correspondant à l'enregistrement examiné n'a été trouvé. Choisissez le fichier bundle exact, ou un dossier source-compagne matérialisé contenant chaque fichier déclaré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein vollständiges Quellpaket gefunden, das dem überprüften Datensatz entspricht. Wählen Sie die genaue Bundle-Datei oder einen materialisierten Quell-Begleitungs-Ordner, der jede deklarierte Datei enthält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún paquete de fuentes completo que coincidiera con el registro revisado. Elija el archivo de paquete exacto, o una carpeta de origen-compañante materializada que contenga cada archivo declarado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pacote de origem completo correspondente ao registro revisado foi encontrado. Escolha o arquivo de pacote exato ou uma pasta de companhia-fonte materializada contendo todos os arquivos declarados."
          }
        }
      }
    },
    "app.bilingual.addf0ab783103e21": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源码包大小或哈希与已审阅记录不一致，不能用于导出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source bundle size or hash does not match the reviewed record and cannot be used."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始碼包大小或雜湊與已審閱記錄不一致，不能用於匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースバンドルのサイズまたはハッシュがレビューされたレコードと一致しておらず、使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 번들 크기 또는 해시가 검토된 레코드와 일치하지 않아 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille ou le hachage du paquet source ne correspond pas à l'enregistrement examiné et ne peut pas être utilisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Größe oder der Hash des Quellbündels stimmt nicht mit dem überprüften Datensatz überein und kann nicht verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño o hash del paquete de origen no coincide con el registro revisado y no se puede utilizar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho ou hash do pacote de origem não corresponde ao registro revisado e não pode ser usado."
          }
        }
      }
    },
    "app.bilingual.cd1dc83fd5cddb2e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标已存在；不会覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The destination already exists; nothing was overwritten."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標已存在；不會覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宛先はすでに存在しています；何も上書きされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적지는 이미 존재합니다; 아무것도 덮어쓰지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La destination existe déjà ; rien n'a été écrasé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
