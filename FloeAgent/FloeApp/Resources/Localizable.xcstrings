    "engineering.review.workspaceChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active workspace changed. Reopen this drawing to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区已切换，请重新打开图纸后继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前工作區已切換，請重新開啟圖紙後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなワークスペースが変更されました。 この図面を再度開いて続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 작업 공간이 변경되었습니다. 계속하려면 이 그림을 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de travail actif a changé. Rouvrez ce dessin pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Arbeitsbereich hat sich geändert. Öffnen Sie diese Zeichnung erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo activo ha cambiado. Vuelve a abrir este dibujo para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho ativo mudou. Reabra este desenho para continuar."
          }
        }
      }
    },
    "engineering.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file exceeded the preview time limit. Try a smaller or simplified model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件处理超时，请使用较小或简化后的模型重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案處理超時，請使用較小或簡化後的模型重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはプレビューの時間制限を超えました。 小さいモデルまたは簡略化されたモデルをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 미리보기 시간 제한을 초과했습니다. 더 작거나 단순화된 모델을 시도해 보십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier a dépassé la limite de temps de prévisualisation. Essayez un modèle plus petit ou simplifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei hat das Zeitlimit für die Vorschau überschritten. Versuchen Sie es mit einem kleineren oder vereinfachten Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo superó el límite de tiempo de vista previa. Prueba un modelo más pequeño o simplificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo excedeu o limite de tempo de visualização. Tente um modelo menor ou simplificado."
          }
        }
      }
    },
    "engineering.unsupported.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export 2D drawings to DXF or PDF, or 3D models to GLB or STL. The original file remains unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维图纸可先导出为 DXF 或 PDF，三维模型可导出为 GLB 或 STL。原文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二維圖紙可先匯出為 DXF 或 PDF，三維模型可匯出為 GLB 或 STL。原檔案保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2D図面をDXFまたはPDFに、または3DモデルをGLBまたはSTLにエクスポートします。 元のファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2D 도면을 DXF 또는 PDF로 내보내고, 3D 모델을 GLB 또는 STL로 내보내십시오. 원본 파일은 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez des dessins 2D vers DXF ou PDF, ou des modèles 3D vers GLB ou STL. Le fichier original reste inchangé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie 2D-Zeichnungen nach DXF oder PDF oder 3D-Modelle nach GLB oder STL. Die Originaldatei bleibt unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte dibujos 2D a DXF o PDF, o modelos 3D a GLB o STL. El archivo original permanece sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte desenhos 2D para DXF ou PDF, ou modelos 3D para GLB ou STL. O arquivo original permanece inalterado."
          }
        }
      }
    },
