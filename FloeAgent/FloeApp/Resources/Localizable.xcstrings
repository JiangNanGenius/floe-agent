    "app.bilingual.4155fea92036fa0c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采用相交 A/C 转台；其他五轴结构可在后续机床设置中扩展。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses an intersecting A/C table. Other 5-axis layouts require their own machine definition."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "採用相交 A/C 轉檯；其他五軸結構可在後續機床設定中擴充套件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交差するA/Cテーブルを使用します。 他の5軸レイアウトは、独自の機械定義が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교차하는 A/C 테이블을 사용합니다. 다른 5축 레이아웃은 자체 기계 정의가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une table A/C qui se croise. D'autres dispositions à 5 axes nécessitent leur propre définition de machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet eine sich schneidende A/C-Tabelle. Andere 5-Achsen-Layouts erfordern eine eigene Maschinendefinition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza una mesa de aire acondicionado que se cruza. Otros diseños de 5 ejes requieren su propia definición de máquina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uma mesa de A/C que se cruza. Outros layouts de 5 eixos exigem sua própria definição de máquina."
          }
        }
      }
    },
    "app.bilingual.4c18656dc62a3239": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车削轴为模型 Z 轴。初始型线来自模型的径向外包络，请先检查型线与装夹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model Z axis is the turning axis. The initial profile is the model's radial envelope; check the profile and clamping first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "車削軸為模型 Z 軸。初始型線來自模型的徑向外包絡，請先檢查型線與裝夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのZ軸は回転軸です。 初期プロファイルはモデルのラジアルエンベロープです。まずプロファイルとクランプを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 Z축은 회전축입니다. 초기 프로파일은 모델의 방사형 외피이며, 먼저 프로파일과 클램핑을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'axe Z du modèle est l'axe tournant. Le profil initial est l'enveloppe radiale du modèle ; vérifiez d'abord le profil et le serrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modell-Z-Achse ist die Drehachse. Das Anfangsprofil ist der radiale Umschlag des Modells; überprüfen Sie zuerst das Profil und die Klemmung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El eje Z del modelo es el eje de giro. El perfil inicial es la envoltura radial del modelo; compruebe primero el perfil y la sujeción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O eixo Z do modelo é o eixo de rotação. O perfil inicial é o envelope radial do modelo; verifique o perfil e a fixação primeiro."
          }
        }
      }
    },
    "app.bilingual.3ecc4b0d08047a94": {
