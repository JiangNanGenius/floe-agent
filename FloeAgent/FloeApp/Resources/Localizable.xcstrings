    "app.bilingual.38d646979370c73": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手记包含墨迹或图片，阅读模式只显示文字内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note also contains ink or images; reading mode shows the text only."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此手記包含墨跡或圖片，閱讀模式只顯示文字內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメモにはインクまたは画像も含まれています。読み取りモードではテキストのみが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메모에는 잉크 또는 이미지가 포함되어 있으며, 읽기 모드에서는 텍스트만 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette note contient également de l'encre ou des images ; le mode de lecture n'affiche que le texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Notiz enthält auch Tinte oder Bilder; im Lesemodus wird nur der Text angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota también contiene tinta o imágenes; el modo de lectura muestra solo el texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta nota também contém tinta ou imagens; o modo de leitura mostra apenas o texto."
          }
        }
      }
    },
    "app.bilingual.bbe9adb937fbdd93": {
