    "localmodels.memory_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device may not have enough free memory right now: this model needs about %1$@, with %2$@ available. Close large apps and refresh, or choose a smaller model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前设备可用内存可能不足：该模型约需 %1$@，目前可用 %2$@。可关闭大型 App 后刷新，或选择较小的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前裝置可用記憶體可能不足：該模型約需 %1$@，目前可用 %2$@。可關閉大型 App 後重新整理，或選擇較小的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは現在、十分な空きメモリがない可能性があります。このモデルは約%1$@が必要で、%2$@が利用可能です。 大きなアプリを閉じてリフレッシュするか、より小さいモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치는 현재 충분한 여유 메모리가 없을 수 있습니다: 이 모델은 약 %1$@가 필요하며, %2$@가 제공됩니다. 대용량 앱을 닫고 새로 고침하거나, 더 작은 모델을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n'a peut-être pas assez de mémoire libre en ce moment : ce modèle a besoin d'environ %1$@, avec %2$@ disponible. Fermez les grandes applications et actualisez-les, ou choisissez un modèle plus petit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat derzeit möglicherweise nicht genug freien Speicher: Dieses Modell benötigt etwa %1$@, mit %2$@ verfügbar. Schließen Sie große Apps und aktualisieren Sie, oder wählen Sie ein kleineres Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que este dispositivo no tenga suficiente memoria libre en este momento: este modelo necesita aproximadamente %1$@, con %2$@ disponible. Cierre aplicaciones grandes y actualice, o elija un modelo más pequeño."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo pode não ter memória livre suficiente agora: este modelo precisa de cerca de %1$@, com %2$@ disponível. Feche aplicativos grandes e atualize, ou escolha um modelo menor."
          }
        }
      }
    },
    "localmodels.not_recommended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device models remain an experimental feature and are not recommended as your daily default. Prefer a configured cloud model service for everyday use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型仍为实验性功能，暂不推荐作为日常首选；日常使用建议优先选择已配置的云端模型服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型仍為實驗性功能，暫不推薦作為日常首選；日常使用建議優先選擇已配置的雲端模型服務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンデバイスモデルは実験的な機能のままであり、日常のデフォルトとしては推奨されません。 日常的に使用するために、設定されたクラウドモデルサービスを優先してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디바이스 기반 모델은 실험적인 기능으로 남아 있으며 일일 기본값으로 권장되지 않습니다. 일상적인 사용을 위해 구성된 클라우드 모델 서비스를 선호합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles sur l'appareil restent une fonctionnalité expérimentale et ne sont pas recommandés comme valeur par défaut quotidienne. Préférez un service de modèle de cloud configuré pour un usage quotidien."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "On-Device-Modelle bleiben eine experimentelle Funktion und werden nicht als tägliche Standardeinstellung empfohlen. Bevorzugen Sie einen konfigurierten Cloud-Modelldienst für den täglichen Gebrauch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos en el dispositivo siguen siendo una característica experimental y no se recomiendan como su valor predeterminado diario. Prefiere un servicio de modelo en la nube configurado para el uso diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos no dispositivo continuam sendo um recurso experimental e não são recomendados como seu padrão diário. Prefira um serviço de modelo de nuvem configurado para uso diário."
          }
        }
      }
    },
