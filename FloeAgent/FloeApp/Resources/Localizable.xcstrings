    "cad.workbench.drawing.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a body and tap “Standard sheet”; pages carry their own scale, paper and dimensions, and mark themselves stale when the model moves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个实体并点按“标准图纸”；每个页面带有自己的比例、图幅和标注，模型变更后会自动标记为已过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個實體並點按“標準圖紙”；每個頁面帶有自己的比例、圖幅和標註，模型變更後會自動標記為已過期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文を選択し、「Standard sheet」をタップしてください。ページはそれぞれ独自のスケール、用紙、寸法を持ち、モデルが移動すると古くなったとマークされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문을 선택하고 “표준 시트”를 탭하십시오; 페이지는 자체 스케일, 용지 및 치수를 가지고 있으며, 모델이 움직이면 오래된 것으로 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un corps et appuyez sur « Feuille standard » ; les pages portent leur propre échelle, leur papier et leurs propres dimensions, et se marquent comme révolus lorsque le modèle se déplace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Körper und tippen Sie auf \"Standardblatt\"; die Seiten tragen ihren eigenen Maßstab, Papier und Abmessungen und markieren sich selbst als als alte, wenn sich das Modell bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un cuerpo y toque \"Hoja estándar\"; las páginas llevan su propia escala, papel y dimensiones, y se marcan a sí mismas como ractos cuando el modelo se mueve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um corpo e toque em “Folha padrão”; as páginas carregam sua própria escala, papel e dimensões e se marcam como antigas quando o modelo se move."
          }
        }
      }
    },
