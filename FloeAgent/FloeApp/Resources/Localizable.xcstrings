    "exec.packages.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review each layer's dependencies and sizes, install or remove packages, stop and resume environments, and save templates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每层依赖与容量，安装或卸载软件包，停止、恢复环境，以及保存模板。"
          }
        }
      }
    },
    "exec.vcpu.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processor cores in use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中的处理器核心数"
          }
        }
      }
    },
    "exec.vcpu.note_dual": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version allows up to %lld cores per guest and 4 cores across the pool. Two or three cores require an installed Linux image verified for that count; an unsupported request is refused without silently reducing it. In our tests two cores were slightly slower for the same work, so no speed-up is promised."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本单台客户机最多使用 %lld 核，资源池总计 4 核。使用 2 核或 3 核需已安装镜像证明支持对应核数；不支持的请求会明确拒绝，不会静默降核。实测同等工作 2 核略慢，不承诺提速。"
          }
        }
      }
    },
    "exec.vcpu.note_single": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version uses 1 core. Choosing 2 cores shows an error instead of silently using 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本版本使用 1 个核心；选择 2 核会提示错误，不会静默改用 1 核。"
          }
        }
      }
    },
