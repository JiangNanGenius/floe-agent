    "app.bilingual.1c4d97d7480d4337": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未获得授权，请重新连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorization was not granted. Try connecting again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未獲得授權，請重新連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認可は付与されませんでした。 もう一度接続してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인이 부여되지 않았습니다. 다시 연결해 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation n'a pas été accordée. Essayez de vous connecter à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Genehmigung wurde nicht erteilt. Versuchen Sie erneut, eine Verbindung herzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió la autorización. Intenta conectarte de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autorização não foi concedida. Tente se conectar novamente."
          }
        }
      }
    },
    "app.bilingual.1dd2759e2036ef61": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成，请检查连接后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not finish. Check the connection and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成，請檢查連線後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了できませんでした。 接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝낼 수 없었습니다. 연결을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer. Vérifiez la connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte nicht fertig werden. Überprüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude terminar. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não consegui terminar. Verifique a conexão e tente novamente."
          }
        }
      }
    },
