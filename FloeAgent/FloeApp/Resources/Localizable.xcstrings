    "app.bilingual.3cc62a2ce8f7c5e5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可合并新的资料内容，并保留已有手工修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New source content can be merged while preserving manual edits."
          }
        },
