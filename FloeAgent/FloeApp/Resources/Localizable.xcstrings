    "providers.service_offers.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider can be configured for several uses at once; they share one endpoint and API key. Uses you skip are not offered again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该供应商可同时配置多种用途；它们共用同一个接口地址和 API 密钥。暂不配置的用途以后不会再提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該供應商可同時配置多種用途；它們共用同一個介面地址和 API 金鑰。暫不配置的用途以後不會再提示。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロバイダーは同時に複数の用途に構成でき、1つのエンドポイントとAPIキーを共有します。 スキップした使用は再度提供されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공급자는 한 번에 여러 용도로 구성할 수 있으며, 하나의 엔드포인트와 API 키를 공유합니다. 건너뛴 사용은 다시 제공되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur peut être configuré pour plusieurs utilisations à la fois ; ils partagent un point de terminaison et une clé API. Les utilisations que vous ignorez ne sont plus proposées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter kann für mehrere Anwendungen gleichzeitig konfiguriert werden; sie teilen sich einen Endpunkt und den API-Schlüssel. Verwendungen, die Sie überspringen, werden nicht mehr angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor se puede configurar para varios usos a la vez; comparten un punto final y la clave API. Los usos que omites no se ofrecen de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este provedor pode ser configurado para vários usos ao mesmo tempo; eles compartilham um ponto final e a chave API. Os usos que você pula não são oferecidos novamente."
          }
        }
      }
    },
