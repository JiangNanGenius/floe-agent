        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla de proyecto necesita un límite positivo, una cláusula y una fuente HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra de projeto precisa de um limite positivo, cláusula e fonte HTTPS."
          }
        }
      }
    },
    "cad.building.error.thisBuildingContainsNewerOrInvalidRecords": {
