    "app.bilingual.ea6664edde82211f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查我导入的游戏文件，判断游戏引擎和根目录，列出文件依据并提出可供我确认的建议；有不确定的地方请说明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect my imported game files to identify the engine and project root. Show the file evidence and propose a choice for me to confirm; explain any uncertainty."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查我匯入的遊戲檔案，判斷遊戲引擎和根目錄，列出檔案依據並提出可供我確認的建議；有不確定的地方請說明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポートしたゲームファイルを検査して、エンジンとプロジェクトのルートを特定してください。 ファイルの証拠をご提示いただき、私が確認できる選択肢をご提案ください；不確かさがある場合はご説明ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 게임 파일을 검사하여 엔진과 프로젝트 루트를 식별하십시오. 파일 증거를 보여 주시고 제가 확인할 수 있도록 선택을 제안해 주시기 바랍니다; 불확실한 사항이 있으면 설명해 주십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez mes fichiers de jeu importés pour identifier le moteur et la racine du projet. Montrez les preuves du dossier et proposez-moi un choix à confirmer ; expliquez toute incertitude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie meine importierten Spieldateien, um die Engine und das Projektroot zu identifizieren. Zeigen Sie die Dateibeweise und schlagen Sie mir eine Wahl vor, die ich bestätigen kann; erklären Sie jede Unsicherheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspeccione mis archivos de juego importados para identificar el motor y la raíz del proyecto. Muestre la evidencia del archivo y proponga una opción para que yo confirme; explique cualquier incertidumbre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione meus arquivos de jogo importados para identificar o mecanismo e a raiz do projeto. Mostre a evidência do arquivo e proponha uma opção para eu confirmar; explique qualquer incerteza."
          }
        }
      }
    },
