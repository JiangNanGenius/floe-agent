    "app.bilingual.cd64780e7fb84d58": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "几何、轴链与低频配置随完整配置文件保存；没有提供运动查询的工序会明确标为未覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometry, axis chains and uncommon settings are saved in the complete setup file. Operations without motion queries remain explicitly uncovered."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幾何、軸鏈與低頻配置隨完整配置檔案儲存；沒有提供運動查詢的工序會明確標為未覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジオメトリ、軸チェーン、および珍しい設定は、完全なセットアップファイルに保存されます。 モーションクエリがない操作は、明示的に未処理のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학, 축 체인 및 비정상적인 설정은 전체 설정 파일에 저장됩니다. 모션 쿼리가 없는 작업은 명시적으로 숨겨진 상태로 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie, les chaînes d'axes et les paramètres inhabituels sont enregistrés dans le fichier de configuration complet. Les opérations sans requêtes de mouvement restent explicitement découvertes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometrie, Achsenketten und ungewöhnliche Einstellungen werden in der vollständigen Setup-Datei gespeichert. Operationen ohne Bewegungsabfragen bleiben explizit unbedeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La geometría, las cadenas de ejes y los ajustes poco comunes se guardan en el archivo de configuración completo. Las operaciones sin consultas de movimiento permanecen explícitamente descubiertas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometria, cadeias de eixos e configurações incomuns são salvas no arquivo de configuração completo. Operações sem consultas de movimento permanecem explicitamente descobertas."
          }
        }
      }
    },
