    "workspace.i_d_e_language_run_view.the_run_scheduling_path_does_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The run scheduling path does not yet accept guest-shape requests, so %@ cores cannot be handed to the launch flow; rejected before launch and never silently runs as 1 core."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行调度路径尚未接入客户机形状请求，当前无法把 %@ 核交给启动流程；已在启动前拒绝，不会以 1 核静默运行。"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_runtime_is_not_installed_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ runtime is not installed on this device"
          }
