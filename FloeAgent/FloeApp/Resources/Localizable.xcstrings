    "environment.packages.language.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python and Node install from their own registries into the selected environment; apt never installs them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 与 Node 从各自的注册源安装到所选环境；apt 不会安装它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Python 與 Node 從各自的註冊源安裝到所選環境；apt 不會安裝它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Python と Node は、各自のレジストリから選択された環境へインストールします；apt はそれらを決してインストールしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Python와 Node는 자체 레지스트리에서 선택한 환경으로 설치합니다; apt는 절대 설치하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Python et Node s'installent à partir de leurs propres registres dans l'environnement sélectionné ; apt ne les installe jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Python und Node installieren aus ihren eigenen Registern in der ausgewählten Umgebung; apt installiert sie nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Python y Node se instalan desde sus propios registros en el entorno seleccionado; apt nunca los instala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Python e Node instalam de seus próprios registros no ambiente selecionado; o apt nunca os instala."
          }
        }
      }
    },
    "environment.packages.layer.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data-only payloads recorded in this layer's manifest (for example files unpacked with dpkg-deb -x). They are not Linux distribution packages; Debian packages live inside a running Linux environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录在本层清单中的数据归档（例如用 dpkg-deb -x 解包的文件）。它们不是 Linux 发行版软件包；Debian 软件包只存在于运行中的 Linux 环境内。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄在本層清單中的資料歸檔（例如用 dpkg-deb -x 解包的檔案）。它們不是 Linux 發行版軟體包；Debian 軟體包只存在於執行中的 Linux 環境內。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイヤーのマニフェストに記録されたデータのみのペイロード（例：dpkg-deb -xで展開されたファイル）。 それらは Linux ディストリビューション パッケージではありません；Debian パッケージは実行中の Linux 環境内にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이어의 매니페스트에 기록된 데이터 전용 페이로드(예: dpkg-deb -x로 풀어진 파일). 그들은 Linux 배포 패키지가 아니며, Debian 패키지는 실행 중인 Linux 환경 안에 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charges utiles de données uniquement enregistrées dans le manifeste de cette couche (par exemple, les fichiers décompressés avec dpkg-deb -x). Ce ne sont pas des paquets de distribution Linux ; les paquets Debian vivent dans un environnement Linux en cours d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur-Daten-Payloads, die im Manifest dieser Ebene aufgezeichnet wurden (z. B. Dateien, die mit dpkg-deb -x entpackt wurden). Es handelt sich nicht um Linux-Verteilungspakete; Debian-Pakete leben in einer laufenden Linux-Umgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargas útiles de solo datos registradas en el manifiesto de esta capa (por ejemplo, archivos desempaquetados con dpkg-deb -x). No son paquetes de distribución Linux; los paquetes Debian viven dentro de un entorno Linux en ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargas úteis somente de dados registradas no manifesto desta camada (por exemplo, arquivos descompactados com dpkg-deb -x). Eles não são pacotes de distribuição Linux; os pacotes Debian vivem dentro de um ambiente Linux em execução."
          }
        }
      }
    },
