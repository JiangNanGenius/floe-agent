    "mac.bridge.backup.new_task_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the backup runtime in a new task. Your current Mac job is kept and will not run again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在新任务中使用备用运行环境。当前 Mac 作业会保留，不会重新执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在新任務中使用備用執行環境。當前 Mac 作業會保留，不會重新執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいタスクでバックアップランタイムを使用してください。 現在のMacジョブは保持され、再度実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업에서 백업 런타임을 사용하십시오. 현재 Mac 작업이 유지되며 다시 실행되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le runtime de sauvegarde dans une nouvelle tâche. Votre tâche Mac actuelle est conservée et ne s'exécutera plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Backup-Laufzeit in einer neuen Aufgabe. Ihr aktueller Mac-Job bleibt erhalten und wird nicht mehr ausgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice el tiempo de ejecución de copia de seguridad en una nueva tarea. Su trabajo actual de Mac se mantiene y no se volverá a ejecutar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o tempo de execução do backup em uma nova tarefa. Seu trabalho atual do Mac é mantido e não será executado novamente."
          }
        }
      }
    },
