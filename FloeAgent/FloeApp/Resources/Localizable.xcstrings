    },
    "workspace.git_hub_actions_job_center.github_denied_this_workflow_request_403": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub denied this workflow request (403). Reconnect GitHub with “Allow GitHub Actions workflow setup”, or use a fine-grained token with Contents, Actions and Workflows write access. Existing credentials are unchanged until you sign in again. (%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 拒绝了此工作流请求（403）。请重新登录并开启“允许配置 GitHub Actions 工作流”，或使用具备 Contents、Actions 与 Workflows 写入权限的细粒度令牌。已有凭据在重新登录前保持不变。 / GitHub denied this workflow request (403). Reconnect GitHub with “Allow GitHub Actions workflow setup”, or use a fine-grained token with Contents, Actions and Workflows write access. Existing credentials are unchanged until you sign in again. (%@)"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 拒絕了此工作流請求（403）。請重新登入並開啟“允許配置 GitHub Actions 工作流”，或使用具備 Contents、Actions 與 Workflows 寫入許可權的細粒度令牌。已有憑據在重新登入前保持不變。 / GitHub denied this workflow request (403). Reconnect GitHub with “Allow GitHub Actions workflow setup”, or use a fine-grained token with Contents, Actions and Workflows write access. Existing credentials are unchanged until you sign in again. (%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub はこのワークフローリクエスト（403）を拒否しました。 GitHub を「Allow GitHub Actions workflow setup」で再接続するか、Contents、Actions、Workflows の書き込み権限を持つ細粒度トークンを使用してください。 既存の認証情報は、再度サインインするまで変更されません。 (%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub가 이 워크플로 요청을 거부했습니다 (403). GitHub를 “Allow GitHub Actions workflow setup”와 다시 연결하거나, Contents, Actions 및 Workflows 쓰기 권한이 있는 세분화된 토큰을 사용하십시오. 기존 자격 증명은 다시 로그인할 때까지 변경되지 않습니다. (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub a refusé cette demande de flux de travail (403). Reconnectez GitHub avec \"Autoriser la configuration du flux de travail GitHub Actions\", ou utilisez un jeton à grain fin avec un accès en écriture de contenu, d'actions et de flux de travail. Les informations d'identification existantes restent inchangées jusqu'à ce que vous vous reconnectiez. (%@)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat diese Workflow-Anfrage abgelehnt (403). Verbinden Sie GitHub erneut mit \"GitHub-Aktionen-Workflow-Einrichtung zulassen\" oder verwenden Sie ein feinkörniges Token mit Inhalts-, Aktions- und Workflow-Schreibzugriff. Vorhandene Anmeldeinformationen bleiben unverändert, bis Sie sich erneut anmelden. (%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub rechazó esta solicitud de flujo de trabajo (403). Vuelva a conectar GitHub con \"Permitir la configuración del flujo de trabajo de acciones GitHub\", o use un token de grano fino con acceso de escritura de Contenidos, Acciones y Flujos de trabajo. Las credenciales existentes no cambian hasta que vuelva a iniciar sesión. (%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub negou esta solicitação de fluxo de trabalho (403). Reconecte o GitHub com “Permitir a configuração do fluxo de trabalho do GitHub Actions” ou use um token de grão fino com acesso à gravação de Conteúdos, Ações e Fluxos de Trabalho. As credenciais existentes permanecem inalteradas até que você faça login novamente. (%@)"
          }
        }
      }
    },
