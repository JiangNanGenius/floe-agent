    "cad.sculpt.serviceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sculpting is unavailable for this document. Reopen it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档暂时无法雕刻，请重新打开后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件暫時無法雕刻，請重新開啟後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書では彫刻は利用できません。 再度開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서에서는 조각을 사용할 수 없습니다. 다시 열고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sculpture n'est pas disponible pour ce document. Rouvrez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sculpting ist für dieses Dokument nicht verfügbar. Öffnen Sie es erneut und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La escultura no está disponible para este documento. Vuelve a abrirlo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escultura não está disponível para este documento. Reabra e tente novamente."
          }
        }
      }
    },
    "cad.sculpt.sourceChanged": {
