    "app.workspace_canvas_view.the_unsaved_drawing_edits_could": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存的图纸修改未能写入本地草稿；请在编辑器中保存后重试，画布不会丢失草稿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The unsaved drawing edits could not be written to the local draft; save in the editor and retry. Nothing is discarded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未儲存的圖紙修改未能寫入本地草稿；請在編輯器中儲存後重試，畫布不會丟失草稿。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない図面の編集はローカルドラフトに書き出すことができませんでした。エディタに保存して再試行してください。 何も捨てられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 도면 편집을 로컬 초안에 기록할 수 없습니다; 편집기에서 저장하고 다시 시도하십시오. 아무것도 버려지지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de dessin non enregistrées n'ont pas pu être écrites dans le brouillon local ; enregistrez-les dans l'éditeur et réessayez. Rien n'est jeté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nicht gespeicherten Zeichnungsbearbeitungen konnten nicht an den lokalen Entwurf geschrieben werden; im Editor speichern und erneut versuchen. Nichts wird verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ediciones de dibujo no guardadas no se pudieron escribir en el borrador local; guardar en el editor y volver a intentarlo. No se descarta nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As edições de desenho não salvas não puderam ser escritas no rascunho local; salve no editor e tente novamente. Nada é descartado."
          }
        }
      }
    },
