    "settings.web_search_settings_center.when_saved_the_model_gets_both": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When saved, the model gets both web.search (regular web results) and web.searchAI (Bocha AI summary); no switching in settings is needed. Both share this API key and Base URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后会同时向模型提供 web.search（普通网页结果）和 web.searchAI（Bocha AI 摘要）两个工具，不需要在设置中切换。两者共用此 API Key 和 Base URL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後會同時向模型提供 web.search（普通網頁結果）和 web.searchAI（Bocha AI 摘要）兩個工具，不需要在設定中切換。兩者共用此 API Key 和 Base URL。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存すると、モデルは web.search（通常のウェブ結果）と web.searchAI（Bocha AI の概要）の両方を取得します。設定の切り替えは不要です。 両者はこのAPIキーとベースURLを共有しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되면 모델은 web.search(일반 웹 결과)와 web.searchAI(Bocha AI 요약)를 모두 받게 되며, 설정을 전환할 필요가 없습니다. 두 경우 모두 이 API 키와 기본 URL을 공유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est enregistré, le modèle obtient à la fois web.search (résultats Web réguliers) et web.searchAI (résumé de Bocha AI) ; aucune commutation dans les paramètres n'est nécessaire. Les deux partagent cette clé API et l'URL de base."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Speichern erhält das Modell sowohl web.search (reguläre Webergebnisse) als auch web.searchAI (Bocha AI-Zusammenfassung); es ist kein Umschalten der Einstellungen erforderlich. Beide teilen diesen API-Schlüssel und die Basis-URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se guarda, el modelo obtiene tanto web.search (resultados web regulares) como web.searchAI (resumen de Bocha AI); no es necesario cambiar de configuración. Ambos comparten esta clave API y la URL base."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando salvo, o modelo recebe tanto web.search (resultados regulares da web) quanto web.searchAI (resumo do Bocha AI); nenhuma troca nas configurações é necessária. Ambos compartilham esta chave API e a URL Base."
          }
        }
      }
    },
