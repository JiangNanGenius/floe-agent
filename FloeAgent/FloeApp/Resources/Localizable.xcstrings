    "app.bilingual.ee42799bebb96ad0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加音符，或取消所有声部的静音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add notes or unmute a part before performing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先新增音符，或取消所有聲部的靜音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "演奏する前に、ノートを追加するか、パートのミュートを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연주하기 전에 메모를 추가하거나 파트의 음소거를 해제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des notes ou réactivez une partie avant d'effectuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Notizen hinzu oder heben Sie die Stummschaltung eines Teils auf, bevor Sie ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade notas o activa el sonido de una parte antes de actuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione notas ou desative uma parte antes de executar."
          }
        }
      }
    },
    "app.bilingual.f912868baca1c660": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段演奏超过当前音频导入的大小限制，请缩短后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This performance exceeds the audio import size limit. Shorten it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段演奏超過當前音訊匯入的大小限制，請縮短後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパフォーマンスはオーディオインポートサイズの上限を超えています。 短くして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 성능은 오디오 가져오기 크기 제한을 초과합니다. 짧게 하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette performance dépasse la limite de taille d'importation audio. Raccourcissez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Leistung überschreitet die Begrenzung der Audioimportgröße. Kürzen Sie es und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este rendimiento supera el límite de tamaño de importación de audio. Acorta y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse desempenho excede o limite de tamanho de importação de áudio. Encurte e tente novamente."
          }
        }
      }
    },
