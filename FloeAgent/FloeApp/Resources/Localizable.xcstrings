    "providers.http_warning.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys and other data sent over HTTP can be read or changed by others. Continue only if you trust this connection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 HTTP 传输的 API 密钥和其他数据可能被他人读取或篡改。请仅在信任此连接时继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過 HTTP 傳輸的 API 金鑰和其他資料可能被他人讀取或篡改。請僅在信任此連線時繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーおよび HTTP を通じて送信されたその他のデータは、他者によって読み取られたり変更されたりすることができます。 この接続を信頼している場合にのみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키와 HTTP를 통해 전송된 기타 데이터는 다른 사람이 읽거나 변경할 수 있습니다. 이 연결을 신뢰하는 경우에만 계속하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API et autres données envoyées sur HTTP peuvent être lues ou modifiées par d'autres. Continuez uniquement si vous faites confiance à cette connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel und andere über HTTP gesendete Daten können von anderen gelesen oder geändert werden. Fahren Sie nur fort, wenn Sie dieser Verbindung vertrauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API y otros datos enviados a través de HTTP pueden ser leídos o cambiados por otros. Continúa solo si confías en esta conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves API e outros dados enviados pelo HTTP podem ser lidos ou alterados por outras pessoas. Continue somente se você confiar nesta conexão."
          }
        }
      }
    },
