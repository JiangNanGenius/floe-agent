    "canvas.onboarding.nodes.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-tap empty space to create. Double-tap content to edit it. Import artifacts from Files, Photos, or Materials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击空白处新建，双击内容节点编辑；产物可从文件、相册或素材库导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙擊空白處新建，雙擊內容節點編輯；產物可從檔案、相簿或素材庫匯入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白をダブルタップして作成してください。 コンテンツをダブルタップして編集してください。 ファイル、写真、または資料からアーティファクトをインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빈 공간을 두 번 탭하여 생성하십시오. 콘텐츠를 더블 탭하여 편집하십시오. 파일, 사진 또는 자료에서 아티팩트를 가져옵니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez deux fois sur l'espace vide pour créer. Appuyez deux fois sur le contenu pour le modifier. Importez des artefacts à partir de fichiers, de photos ou de matériaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen Sie auf leeres Leerzeichen, um zu erstellen. Doppeltippen Sie auf den Inhalt, um ihn zu bearbeiten. Importieren Sie Artefakte aus Dateien, Fotos oder Materialien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque dos veces el espacio vacío para crear. Toque dos veces el contenido para editarlo. Importar artefactos de archivos, fotos o materiales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes no espaço vazio para criar. Toque duas vezes no conteúdo para editá-lo. Importe artefatos de Arquivos, Fotos ou Materiais."
          }
        }
      }
    },
