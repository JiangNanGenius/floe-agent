    "background.live_activity.system_disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are off for Floe Agent. Turn them on in Settings to see task progress."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe Agent 的实时活动已关闭。请在“设置”中开启，以便查看任务进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe Agent 的實時活動已關閉。請在“設定”中開啟，以便檢視任務進度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe エージェントのライブアクティビティはオフです。 設定でそれらをオンにして、タスクの進行状況をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 에이전트의 실시간 활동이 꺼져 있습니다. 설정에서 켜면 작업 진행 상황을 확인할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées pour l'agent Floe. Activez-les dans Réglages pour voir la progression de la tâche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind für Floe Agent aus. Aktivieren Sie sie in den Einstellungen, um den Aufgabenfortschritt zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actividades en vivo están desactivadas para el agente Floe. Activarlos en Ajustes para ver el progreso de la tarea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atividades ao vivo estão desligadas para o Agente Floe. Ative-os em Configurações para ver o progresso da tarefa."
          }
        }
      }
    },
