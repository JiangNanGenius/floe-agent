    "app.bilingual.d88c2d0c591195db": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能连接，请检查服务器、网络或连接设置后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to connect. Check the server, network or connection settings, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能連線，請檢查伺服器、網路或連線設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できません。 サーバー、ネットワーク、または接続設定を確認し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결할 수 없습니다. 서버, 네트워크 또는 연결 설정을 확인한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de se connecter. Vérifiez les paramètres du serveur, du réseau ou de la connexion, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung nicht möglich. Überprüfen Sie die Server-, Netzwerk- oder Verbindungseinstellungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar. Compruebe la configuración del servidor, la red o la conexión, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível conectar. Verifique as configurações do servidor, rede ou conexão e tente novamente."
          }
        }
      }
    },
    "app.bilingual.b26ed3cd73e1a5d9": {
