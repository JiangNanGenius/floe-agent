            "value": "프로젝트의 키 선언을 읽을 수 없습니다. 엔진 기본값이 사용 중입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déclaration clé du projet n'a pas pu être lue. Les valeurs par défaut du moteur sont utilisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsseldeklaration des Projekts konnte nicht gelesen werden. Motor-Standardeinstellungen werden verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la declaración clave del proyecto. Los valores predeterminados del motor están en uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A declaração-chave do projeto não pôde ser lida. Os padrões do motor estão em uso."
          }
        }
      }
    },
