    "voice.input.preload.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare the installed model while Floe is open. Changing your main recognition method or service turns this off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Floe 前台运行时提前准备已安装的模型。切换主要识别方式或服务后会自动关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Floe 前臺執行時提前準備已安裝的模型。切換主要識別方式或服務後會自動關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe が開いている間に、インストール済みモデルを準備してください。 メインの認識方法またはサービスを変更すると、これがオフになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe가 열려 있는 동안 설치된 모델을 준비하십시오. 주요 인식 방식이나 서비스를 변경하면 이것이 꺼집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez le modèle installé pendant que Floe est ouvert. La modification de votre méthode ou service de reconnaissance principal le désactive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereiten Sie das installierte Modell vor, während das Floe geöffnet ist. Wenn Sie Ihre Haupterkennungsmethode oder Ihren Dienst ändern, wird dies ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara el modelo instalado mientras el Floe está abierto. Cambiar su método o servicio de reconocimiento principal lo desactiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare o modelo instalado enquanto o Floe estiver aberto. Alterar seu método ou serviço de reconhecimento principal desatina isso."
          }
        }
      }
    },
