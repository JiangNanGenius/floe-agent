          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgelöste Umgebung stimmt nicht mit dem gespeicherten Speicherort dieser Aufgabe überein. Überprüfen Sie die Aufgabeneinstellungen, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno resuelto no coincide con la ubicación guardada de esta tarea. Comprueba la configuración de la tarea antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente resolvido não corresponde ao local salvo desta tarefa. Verifique as configurações da tarefa antes de tentar novamente."
          }
