    "app.idelanguage_run_view.install_writes_only_if_that": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装只写入 %@；若该路径已有不同内容，Floe 会改为导出到工作区 .floe/workflows/ 供你审查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install writes only %@; if that path already has different content Floe exports it to .floe/workflows/ for review instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝只寫入 %@；若該路徑已有不同內容，Floe 會改為匯出到工作區 .floe/workflows/ 供你審查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Install は %@ のみを書きます。そのパスにすでに別のコンテンツがある場合は、Floe を .floe/workflows/ にエクスポートしてレビューします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치는 %@만 기록합니다; 해당 경로에 이미 다른 내용이 있는 경우 Floe는 대신 .floe/workflows/ 로 내보내어 검토합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation n'écrit que %@ ; si ce chemin a déjà un contenu différent, Floe l'exporte vers .floe/workflows/ pour examen à la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation schreibt nur %@; wenn dieser Pfad bereits einen anderen Inhalt hat, exportiert Floe ihn stattdessen zur Überprüfung an .floe/workflows/."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación escribe solo %@; si esa ruta ya tiene contenido diferente, Floe lo exporta a .floe/workflows/ para su revisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação grava apenas %@; se esse caminho já tiver conteúdo diferente, Floe o exporta para .floe/workflows/ para revisão."
          }
        }
      }
    },
