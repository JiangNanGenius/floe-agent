    "portforward.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each rule publishes one Linux TCP port to this device. The iPad port can be fixed or assigned automatically (49152–65535); at most %1$lld rules per environment. The default bind address is %2$@ (reachable on your local network). Floe does not set up UPnP/NAT mapping and shows no public address."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条规则把 Linux 的一个 TCP 端口发布到本机；iPad 端口可固定或自动分配（49152–65535），每个环境最多 %1$lld 条。默认绑定 %2$@（同一局域网可访问）。应用不做 UPnP/NAT 映射，也不显示公网地址。"
          }
        }
      }
    },
    "portforward.guest_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux port must be a whole number from 1 to 65535."
