    "core.canvas_operations.the_image_service_should_return_images": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image service should return %@ images but returned %@; this was not submitted as partial success. Retry from the configuration node."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片服务应返回 %@ 张图片，但实际返回 %@ 张；本次没有按部分成功提交，请从配置节点重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片服務應返回 %@ 張圖片，但實際返回 %@ 張；本次沒有按部分成功提交，請從配置節點重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージサービスは %@ 画像を返すはずですが、%@ が返されました。これは部分成功として提出されていません。 設定ノードから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 서비스는 %@ 이미지를 반환해야 하지만 %@를 반환했으며, 이는 부분 성공으로 제출되지 않았습니다. 구성 노드에서 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'image devait renvoyer des images %@, mais a renvoyé %@ ; cela n'a pas été soumis comme un succès partiel. Réessayez à partir du nœud de configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bilddienst sollte %@-Bilder zurückgeben, aber %@ zurückgeben; dies wurde nicht als teilweiser Erfolg eingereicht. Versuchen Sie es erneut vom Konfigurationsknoten aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de imágenes debería devolver imágenes %@, pero devolvió %@; esto no se envió como éxito parcial. Vuelva a intentarlo desde el nodo de configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de imagem deveria retornar imagens %@, mas retornou %@; isso não foi enviado como sucesso parcial. Tente novamente a partir do nó de configuração."
          }
        }
      }
    },
