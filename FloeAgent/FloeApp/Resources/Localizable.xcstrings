    "cad.present.camera.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbit, pan and zoom freely; a saved view keeps its own projection and framing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可自由旋转、平移和缩放；已保存镜头保留自己的投影与画幅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可自由旋轉、平移和縮放；已儲存鏡頭保留自己的投影與畫幅。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オービット、パン、ズームが自由に行えます；保存されたビューは独自の投影とフレーミングを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자유롭게 궤도를 돌리고, 팬을 돌며, 확대·축소를 자유롭게 할 수 있습니다; 저장된 뷰는 자체 투사와 프레이밍을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbite, panoramique et zoom librement ; une vue enregistrée conserve sa propre projection et son propre cadrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frei umkreisen, spanieren und zoomen; eine gespeicherte Ansicht behält ihre eigene Projektion und Rahmung bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbita, panorámica y haz zoom libremente; una vista guardada mantiene su propia proyección y encuadre."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Orbite, panorâmica e amplie livremente; uma visão salva mantém sua própria projeção e enquadramento."
          }
        }
      }
    },
