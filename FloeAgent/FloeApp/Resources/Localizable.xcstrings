    "app.bilingual.f6c7931fb7f80393": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。先读取当前项目的相关源码，保留现有改动，说明处理结果并引用原问题。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". Read the relevant project source first, preserve existing changes, and report the result with a link to the original issue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "。先讀取當前專案的相關原始碼，保留現有改動，說明處理結果並引用原問題。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ". まず該当するプロジェクトのソースを読み、既存の変更を保持し、結果を元の課題へのリンクとともに報告してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": ". 먼저 해당 프로젝트 소스를 읽고, 기존 변경 사항을 보존한 뒤, 원본 이슈에 대한 링크와 함께 결과를 보고하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Lisez d'abord la source pertinente du projet, conservez les modifications existantes et signalez le résultat avec un lien vers le problème original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ". Lesen Sie zuerst die entsprechende Projektquelle, bewahren Sie bestehende Änderungen auf und melden Sie das Ergebnis mit einem Link zum ursprünglichen Problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": ". Lea primero la fuente del proyecto relevante, conserve los cambios existentes e informe del resultado con un enlace al problema original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": ". Leia a fonte relevante do projeto primeiro, preserve as alterações existentes e relate o resultado com um link para o problema original."
          }
        }
      }
    },
