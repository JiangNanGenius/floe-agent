        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsame Anmeldeinformationen, die an anderer Stelle verwendet werden, und Daten in separaten Apps werden gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales compartidas utilizadas en otros lugares y los datos en aplicaciones separadas se mantienen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais compartilhadas usadas em outro lugar e os dados em aplicativos separados são mantidos."
          }
        }
      }
    },
    "app.bilingual.4eca1df053431929": {
