    "app.bilingual.cb539781ca4607c2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能没有游戏调试快照；未保存的进度可能丢失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game debug snapshot may not be available. Unsaved progress can be lost."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能沒有遊戲除錯快照；未儲存的進度可能丟失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのデバッグスナップショットが利用できない可能性があります。 保存されていない進行状況は失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 디버그 스냅샷을 사용할 수 없을 수도 있습니다. 저장되지 않은 진행 상황은 손실될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instantané de débogage du jeu peut ne pas être disponible. Les progrès non sauvegardés peuvent être perdus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Spieldebug-Snapshot ist möglicherweise nicht verfügbar. Nicht gespeicherter Fortschritt kann verloren gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que no esté disponible una instantánea de depuración del juego. El progreso no guardado puede perderse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um instantâneo de depuração do jogo pode não estar disponível. O progresso não salvo pode ser perdido."
          }
        }
      }
    },
