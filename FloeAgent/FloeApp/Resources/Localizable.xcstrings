    "app.bilingual.bdb771856fe62ada": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换后请返回刷新软件索引，再安装软件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After switching, refresh the package index before installing software."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換後請返回重新整理軟體索引，再安裝軟體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替え後は、ソフトウェアをインストールする前にパッケージインデックスを更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전환 후, 소프트웨어를 설치하기 전에 패키지 인덱스를 새로 고치십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le changement, actualisez l'index du paquet avant d'installer le logiciel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie nach dem Wechsel den Paketindex, bevor Sie die Software installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de cambiar, actualice el índice del paquete antes de instalar el software."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a troca, atualize o índice do pacote antes de instalar o software."
          }
        }
      }
    },
