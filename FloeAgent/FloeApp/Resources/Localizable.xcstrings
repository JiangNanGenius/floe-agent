    "design.page.awaitingFirstResult.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the request in the conversation; the preview appears as soon as a real revision exists — no placeholder is shown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在对话中发送请求；出现真实修订后这里立即显示预览，不展示占位内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在對話中傳送請求；出現真實修訂後這裡立即顯示預覽，不展示佔位內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話内でリクエストを送信してください。プレビューは実際のリビジョンが存在するとすぐに表示されます—プレースホルダーは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 중에 요청을 보내십시오; 실제 개정이 존재하는 즉시 미리보기가 표시됩니다 — 자리 표시자는 표시되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez la demande dans la conversation ; l'aperçu apparaît dès qu'une véritable révision existe - aucun espace réservé n'est affiché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie die Anfrage in der Konversation; die Vorschau wird angezeigt, sobald eine echte Revision vorhanden ist - es wird kein Platzhalter angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe la solicitud en la conversación; la vista previa aparece tan pronto como exista una revisión real; no se muestra ningún marcador de posición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie a solicitação na conversa; a visualização aparece assim que uma revisão real existe — nenhum espaço reservado é mostrado."
          }
        }
      }
    },
    "design.page.candidateImmutable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidates are immutable — adopt first to edit the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选内容不可编辑 — 先采用，再编辑原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選內容不可編輯 — 先採用，再編輯原件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補者は不変です — 最初に採用して元を編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후보자는 불변합니다 — 먼저 채택하여 원본을 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les candidats sont immuables - adoptez d'abord pour modifier l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidaten sind unveränderlich - adoptieren Sie zuerst, um das Original zu bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los candidatos son inmutables: adopten primero para editar el original."
          }
        },
        "pt-BR": {
