    "design.owner.generate_conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The design changed while generating. The result is retained; generate again to bind it to the current revision."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成期间设计已更改。结果已保留；再次点击生成可将其绑定到当前修订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成期間設計已更改。結果已保留；再次點選生成可將其繫結到當前修訂。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成中にデザインが変更されました。 結果は保持されます。現在のリビジョンにバインドするために、再度生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 중에 디자인이 변경되었습니다. 결과가 유지됩니다; 현재 리비전에 바인딩하려면 다시 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conception a changé lors de la génération. Le résultat est conservé ; générez-le à nouveau pour le lier à la révision actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Design hat sich während der Generierung geändert. Das Ergebnis wird beibehalten; generieren Sie es erneut, um es an die aktuelle Revision zu binden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diseño cambió durante la generación. El resultado se conserva; genere de nuevo para vincularlo a la revisión actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O design mudou durante a geração. O resultado é retido; gere novamente para vinculá-lo à revisão atual."
          }
        }
      }
    },
    "design.owner.generate_discard_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard the unknown attempt and allow a new generation"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃未知尝试并允许重新生成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄未知嘗試並允許重新生成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未知の試みを捨て、新しい世代を許す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 시도를 버리고 새로운 세대를 허용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejeter la tentative inconnue et permettre à une nouvelle génération"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwerfen Sie den unbekannten Versuch und erlauben Sie einer neuen Generation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarta el intento desconocido y permite una nueva generación"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarte a tentativa desconhecida e permita uma nova geração"
          }
        }
      }
    },
    "design.owner.generate_discarded_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locally closed after the user acknowledged the remote outcome is unknown; the provider may still have generated or charged for a result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户确认结果未知后已在本地关闭；服务商可能已生成或计费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用者確認結果未知後已在本地關閉；服務商可能已生成或計費。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーがリモート結果が不明であることを認めた後、ローカルでクローズされました；プロバイダーは依然として結果を生成したり、料金を請求した可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자가 원격 결과가 알 수 없음을 확인한 후 로컬에서 종료되었습니다; 제공자는 여전히 결과를 생성했거나 비용을 청구했을 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermé localement après que l'utilisateur a reconnu que le résultat à distance est inconnu ; le fournisseur peut toujours avoir généré ou facturé un résultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal geschlossen, nachdem der Benutzer bestätigt hat, dass das Remote-Ergebnis unbekannt ist; der Anbieter hat möglicherweise immer noch ein Ergebnis generiert oder berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrado localmente después de que el usuario reconociera que el resultado remoto es desconocido; el proveedor aún puede haber generado o cobrado por un resultado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechado localmente depois que o usuário reconheceu que o resultado remoto é desconhecido; o provedor ainda pode ter gerado ou cobrado por um resultado."
          }
        }
      }
    },
