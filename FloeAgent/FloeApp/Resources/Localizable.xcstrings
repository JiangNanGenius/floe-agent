    "canvas.onboarding.navigate.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag empty space with one finger to pan. Drag a node to move it. Two fingers always pan and zoom; Apple Pencil draws."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指拖动空白处平移画布，拖动节点移动节点；双指随时平移缩放，Apple Pencil 用于绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指拖動空白處平移畫布，拖動節點移動節點；雙指隨時平移縮放，Apple Pencil 用於繪製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空白のスペースを指一本でドラッグしてパンしてください。 ノードをドラッグして移動してください。 2本の指は常にパンとズームを行い、Apple Pencilは描画します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 빈 공간을 드래그하여 팬으로 이동하십시오. 노드를 끌어 이동하십시오. 두 손가락이 항상 팬하고 줌합니다; Apple Pencil가 그립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser l'espace vide avec un doigt pour paner. Faites glisser un nœud pour le déplacer. Deux doigts toujours pan et zoomer ; Apple Pencil tire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die leere Fläche mit einem Finger, um sie zu spanieren. Ziehen Sie einen Knoten, um ihn zu verschieben. Zwei Finger immer span und zoomen; Apple Pencil zeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre el espacio vacío con un dedo para hacer una panorámica. Arrastra un nodo para moverlo. Dos dedos siempre panorámicas y zoom; Apple Pencil dibuja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o espaço vazio com um dedo para panorâmica. Arraste um nó para movê-lo. Dois dedos sempre pan e zoom; Apple Pencil desenha."
          }
        }
      }
    },
