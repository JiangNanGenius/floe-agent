        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体のフレームを保持します；動くエッジは背景を露出させる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 프레임을 유지합니다; 움직이는 가장자리는 배경을 드러낼 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve tout le cadre ; les bords mobiles peuvent révéler l'arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält den gesamten Rahmen bei; sich bewegende Kanten können den Hintergrund freilegen."
