    "cad.building.rules.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add only rules whose source and applicability you have checked. Results cover the listed measurements; other regulations remain unevaluated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请添加已核对来源及适用范围的规则。结果只覆盖所列测量项，其余规范保持未检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請新增已核對來源及適用範圍的規則。結果只覆蓋所列測量項，其餘規範保持未檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースと適用性を確認したルールのみを追加してください。 結果は列挙された測定値を網羅しています；その他の規制は評価されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출처와 적용 가능성을 확인한 규칙만 추가하십시오. 결과는 나열된 측정값을 포함합니다; 다른 규정은 아직 평가되지 않은 상태입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez uniquement des règles dont vous avez vérifié la source et l'applicabilité. Les résultats couvrent les mesures énumérées ; d'autres réglementations restent non évaluées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie nur Regeln hinzu, deren Quelle und Anwendbarkeit Sie überprüft haben. Die Ergebnisse decken die aufgeführten Messungen ab; andere Vorschriften bleiben unbewertet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue solo reglas cuya fuente y aplicabilidad haya comprobado. Los resultados cubren las mediciones enumeradas; otras regulaciones siguen sin ser evaluadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione apenas regras cuja origem e aplicabilidade você verificou. Os resultados cobrem as medidas listadas; outros regulamentos permanecem sem avaliação."
          }
        }
      }
    },
