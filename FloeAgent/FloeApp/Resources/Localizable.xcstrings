    "chat.conversation_batch_management_view.the_selected_task_is_still_running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected task is still running. Archiving stops execution first; it can be restored from the archive later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选任务仍在运行。归档会先停止执行，之后可从归档区恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選任務仍在執行。歸檔會先停止執行，之後可從歸檔區恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたタスクはまだ実行中です。 アーカイブはまず実行を停止し、後でアーカイブから復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 작업이 아직 실행 중입니다. 보관은 먼저 실행을 중단하고, 나중에 보관소에서 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche sélectionnée est toujours en cours d'exécution. L'archivage arrête d'abord l'exécution ; il peut être restauré à partir de l'archive plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Aufgabe wird noch ausgeführt. Die Archivierung stoppt zuerst die Ausführung; sie kann später aus dem Archiv wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea seleccionada sigue en ejecución. El archivo detiene la ejecución primero; se puede restaurar desde el archivo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa selecionada ainda está em execução. O arquivamento interrompe a execução primeiro; ele pode ser restaurado a partir do arquivo mais tarde."
          }
        }
      }
    },
    "chat.conversation_batch_management_view.the_task_and_its_private_workspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task and its private workspace will be deleted; shared project files are kept. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务及其私有工作区将被删除，共享项目文件保留。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務及其私有工作區將被刪除，共享專案檔案保留。此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクとそのプライベートワークスペースは削除され、共有されたプロジェクトファイルは保持されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업과 해당 작업 공간은 삭제되며, 공유된 프로젝트 파일은 유지됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche et son espace de travail privé seront supprimés ; les fichiers de projet partagés sont conservés. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe und ihr privater Arbeitsbereich werden gelöscht; freigegebene Projektdateien bleiben erhalten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea y su espacio de trabajo privado se eliminarán; los archivos de proyecto compartidos se mantendrán. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa e seu espaço de trabalho privado serão excluídos; os arquivos de projeto compartilhados são mantidos. Isso não pode ser desfeito."
          }
        }
      }
    },
