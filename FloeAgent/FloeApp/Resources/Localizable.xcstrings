    "cad.versions.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes only the “%@” checkpoint. The current design and external project files are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会删除“%@”检查点。当前设计和外部工程文件不会被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除“%@”檢查點。當前設計和外部工程檔案不會被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより「%@」チェックポイントのみが削除されます。 現在のデザインおよび外部プロジェクトファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 “%@” 체크포인트만 제거합니다. 현재 디자인 및 외부 프로젝트 파일은 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement le point de contrôle \"%@\". La conception actuelle et les fichiers du projet externe ne sont pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird nur der Kontrollpunkt \"%@\" entfernt. Das aktuelle Design und die externen Projektdateien werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina solo el punto de control \"%@\". El diseño actual y los archivos del proyecto externo no se modifican."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove apenas o ponto de verificação “%@”. O design atual e os arquivos de projeto externo não são alterados."
          }
        }
      }
    },
