    "shortcuts.schedule.run.error.environment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The schedule's execution environment is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
