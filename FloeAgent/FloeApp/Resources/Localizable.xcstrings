    "notes.notes_agent_tools.applying_a_proposal_requires_a_proposalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying a proposal requires a proposalID and a UI-confirmed grantID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用提案需要 proposalID 和界面确认 grantID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用提案需要 proposalID 和介面確認 grantID。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案を申請するには、proposalID と UI が確認した grantID が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안을 적용하려면 proposalID와 UI에서 확인된 grantID가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application d'une proposition nécessite un identifiant de proposition et un identifiant de subvention confirmé par l'interface utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beantragung eines Vorschlags erfordert eine Vorschlags-ID und eine über die Benutzeroberfläche bestätigte Grant-ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación de una propuesta requiere un ID de propuesta y un ID de subvención confirmado por la interfaz de usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aplicação de uma proposta requer um ID de proposta e um ID de concessão confirmado pela interface do usuário."
          }
        }
      }
    },
    "notes.notes_agent_tools.before_modifying_office_body_text_read": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before modifying Office body text, read the fields with notes.read section=officeFields and pass the returned sha256."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 Office 正文前请先用 notes.read section=officeFields 读取字段，并传入返回的 sha256。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改 Office 正文前請先用 notes.read section=officeFields 讀取欄位，並傳入返回的 sha256。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Office の本文テキストを変更する前に、notes.read section=officeFields のフィールドを読み、返される sha256 を渡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 본문 텍스트를 수정하기 전에, notes.read section=officeFields 로 필드를 읽고 반환된 sha256을 전달하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de modifier le texte du corps d'Office, lisez les champs avec notes.read section=officeFields et passez le sha256 retourné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor Sie den Office-Text ändern, lesen Sie die Felder mit notes.read section=officeFields und übergeben Sie die zurückgegebene sha256."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de modificar el texto del cuerpo de Office, lea los campos con notes.read section=officeFields y pase el sha256 devuelto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de modificar o texto do corpo do Office, leia os campos com notes.read section=officeFields e passe o sha256 retornado."
          }
        }
      }
    },
