    "app.bilingual.c36355ce2e12b2f0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法保存；编辑副本已保留，未写回原文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving is unavailable right now. Your editing copy was retained; nothing was written back to the original file."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法儲存；編輯副本已保留，未寫回原檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、保存は利用できません。 編集コピーは保持されました；元のファイルに書き戻されたものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 저장이 불가능합니다. 귀하의 편집본이 보관되었습니다; 원본 파일에 다시 기록되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'est pas disponible pour le moment. Votre copie d'édition a été conservée ; rien n'a été réécrit dans le fichier original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern ist derzeit nicht verfügbar. Ihre bearbeitete Kopie wurde beibehalten; nichts wurde in die Originaldatei zurückgeschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro no está disponible en este momento. Su copia de edición se retuvo; no se escribió nada en el archivo original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O salvamento não está disponível no momento. Sua cópia de edição foi mantida; nada foi gravado de volta no arquivo original."
          }
        }
      }
    },
