    "settings.privacy.clear.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both operations ask for confirmation and report exactly what was deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两项操作均需二次确认，并如实回显删除数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩項操作均需二次確認，並如實回顯刪除數量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の操作は確認を求め、削除された内容を正確に報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 작업 모두 확인을 요청하고 정확히 삭제된 내용을 보고합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux opérations demandent une confirmation et rapportent exactement ce qui a été supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Operationen bitten um Bestätigung und berichten genau, was gelöscht wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas operaciones piden confirmación e informan exactamente de lo que se eliminó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas as operações pedem confirmação e relatam exatamente o que foi excluído."
          }
        }
      }
    },
