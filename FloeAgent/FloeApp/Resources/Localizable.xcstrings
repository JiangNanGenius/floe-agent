    "app.bilingual.6e7486805848bd3f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此任务已关闭联网，无法下载缺少的排版内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network access is disabled for this task; missing typesetting resources cannot be downloaded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此任務已關閉聯網，無法下載缺少的排版內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このタスクではネットワークアクセスが無効になっています。欠落している組版リソースはダウンロードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업에 대한 네트워크 접근이 비활성화되었습니다; 누락된 조판 리소스를 다운로드할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au réseau est désactivé pour cette tâche ; les ressources de composition manquantes ne peuvent pas être téléchargées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Netzwerkzugriff ist für diese Aufgabe deaktiviert; fehlende Satzressourcen können nicht heruntergeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la red está desactivado para esta tarea; no se pueden descargar los recursos de composición tipográfica que faltan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à rede está desativado para esta tarefa; os recursos de composição de digitação ausentes não podem ser baixados."
          }
        }
      }
    },
