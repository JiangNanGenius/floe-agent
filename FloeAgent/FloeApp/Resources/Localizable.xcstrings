          }
        }
      }
    },
    "app.bilingual.2350926e71a67de5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取前会先把当前进度保存为安全检查点；若恢复失败，该检查点仍会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current progress is captured as a safety checkpoint first. If restore fails, that checkpoint remains."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取前會先把當前進度儲存為安全檢查點；若恢復失敗，該檢查點仍會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の進捗はまず安全チェックポイントとして記録されます。 復元が失敗した場合、そのチェックポイントは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 진행 상황은 먼저 안전 체크포인트로 기록됩니다. 복원이 실패하면 해당 체크포인트가 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression actuelle est d'abord capturée comme un point de contrôle de sécurité. Si la restauration échoue, ce point de contrôle reste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Fortschritt wird zuerst als Sicherheitskontrollpunkt erfasst. Wenn die Wiederherstellung fehlschlägt, bleibt dieser Kontrollpunkt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso actual se captura primero como un punto de control de seguridad. Si la restauración falla, ese punto de control permanece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso atual é capturado primeiro como um ponto de verificação de segurança. Se a restauração falhar, esse ponto de verificação permanecerá."
          }
        }
      }
    },
    "app.bilingual.36852b8f890a97e9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
