    "app.bilingual.c78e6fb8e4e5ab2a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开状态为未发布时只生成工程导出，不构成公开发布、公开源码提供或法律结论。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While unpublished this only produces an engineering export; it is not a public release, public source offer or legal conclusion."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開狀態為未釋出時只生成工程匯出，不構成公開發布、公開原始碼提供或法律結論。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未公開ではありますが、これはエンジニアリングの輸出に過ぎず、公開リリース、公開ソースオファー、または法的結論ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개이지만, 이는 엔지니어링 내보내기일 뿐이며, 공개 릴리스, 공개 소스 제안 또는 법적 결론이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien qu'il ne soit pas publié, cela ne produit qu'une exportation d'ingénierie ; il ne s'agit pas d'une publication publique, d'une offre de source publique ou d'une conclusion juridique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während dies nicht veröffentlicht wird, führt dies nur zu einem technischen Export; es handelt sich nicht um eine öffentliche Veröffentlichung, kein öffentliches Quellenangebot oder eine rechtliche Schlussfolgerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si bien no se ha publicado, esto solo produce una exportación de ingeniería; no es un comunicado público, una oferta de fuente pública o una conclusión legal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Embora não publicado, isso produz apenas uma exportação de engenharia; não é um lançamento público, oferta de fonte pública ou conclusão legal."
          }
        }
      }
    },
