    "settings.files_settings_view.find_all_workspaces_by_project_or": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find all workspaces by project or chat, then browse, preview and manage their files, including archived chats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按项目或聊天查找所有工作区，浏览、预览和管理其中的文件，包含已归档聊天。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按專案或聊天查詢所有工作區，瀏覽、預覽和管理其中的檔案，包含已歸檔聊天。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトまたはチャットごとにすべてのワークスペースを検索し、アーカイブされたチャットを含むファイルを閲覧、プレビュー、管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 또는 채팅별로 모든 작업 공간을 찾은 다음, 보관된 채팅을 포함한 파일을 탐색하고 미리 보기하며 관리하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez tous les espaces de travail par projet ou chat, puis parcourez, prévisualisez et gérez leurs fichiers, y compris les chats archivés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie alle Arbeitsbereiche nach Projekt oder Chat, durchsuchen, sehen Sie sich eine Vorschau an und verwalten Sie ihre Dateien, einschließlich archivierter Chats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre todos los espacios de trabajo por proyecto o chat, luego navegue, previsualice y administre sus archivos, incluidos los chats archivados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre todos os espaços de trabalho por projeto ou bate-papo, depois navegue, visualize e gerencie seus arquivos, incluindo bate-papos arquivados."
          }
        }
      }
    },
    "settings.files_settings_view.only_the_workspace_record_is_removed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the workspace record is removed, not the external folder or its contents."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只移除工作区记录，不会删除外部文件夹或其中内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只移除工作區記錄，不會刪除外部資料夾或其中內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部フォルダーやその内容は削除されませんが、ワークスペースのレコードのみが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간 레코드만 삭제되고 외부 폴더와 그 내용은 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l'enregistrement de l'espace de travail est supprimé, pas le dossier externe ou son contenu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Arbeitsbereichsdatensatz wird entfernt, nicht der externe Ordner oder sein Inhalt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se elimina el registro del espacio de trabajo, no la carpeta externa o su contenido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas o registro do espaço de trabalho é removido, não a pasta externa ou seu conteúdo."
          }
        }
      }
    },
