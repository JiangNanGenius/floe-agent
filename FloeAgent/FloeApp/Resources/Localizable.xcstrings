    "workspace.workspace_canvas_view.private_canvases_are_saved_independently_move": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private canvases are saved independently. Move assets to a workspace or export them later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私人画布独立保存；素材可稍后移动到工作区或导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私人畫布獨立儲存；素材可稍後移動到工作區或匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートキャンバスは個別に保存されます。 アセットをワークスペースに移動するか、後でエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비공개 캔버스는 독립적으로 저장됩니다. 자산을 작업 공간으로 이동하거나 나중에 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les toiles privées sont sauvegardées indépendamment. Déplacez les ressources vers un espace de travail ou exportez-les plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Leinwände werden unabhängig voneinander gespeichert. Verschieben Sie Assets in einen Arbeitsbereich oder exportieren Sie sie später."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lienzos privados se guardan de forma independiente. Mover activos a un espacio de trabajo o exportarlos más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Telas privadas são salvas de forma independente. Mova os ativos para um espaço de trabalho ou exporte-os mais tarde."
          }
        }
      }
    },
