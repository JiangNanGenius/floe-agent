    "voice.local.audition.mixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let’s review today’s plan. 先整理 Office 文档，再检查 Apple Pencil 的书写效果。The meeting starts at 10:30, and the budget is 128 dollars. 没问题，我们按这个顺序继续。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们先看一下今天的安排。Please open the Office document, 然后检查 Apple Pencil 的书写效果。会议是 10:30，预算是 128 dollars。没问题，let’s continue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們先看一下今天的安排。Please open the Office document, 然後檢查 Apple Pencil 的書寫效果。會議是 10:30，預算是 128 dollars。沒問題，let’s continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日の計画を見直しましょう。 まず Office の文書を整理し、次に Apple Pencil の書き込み効果を確認してください。 会議は10時30分に始まり、予算は128ドルです。 問題ありません。この順序で続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 계획을 검토해 봅시다. 먼저 Office 문서를 정리하고, Apple Pencil의 작성 효과를 확인하십시오. 회의는 10시 30분에 시작하며, 예산은 128달러입니다. 문제 없습니다, 이 순서대로 진행하겠습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinons le plan d'aujourd'hui. 先整理 Office 文档，再检查 Apple Pencil 的书写效果。 La réunion commence à 10 h 30 et le budget est de 128 dollars. 没问题，我们按这个顺序继续。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie uns den heutigen Plan überprüfen. 先整理 Büro 文档，再检查 Apple Pencil 的书写效果。 Das Treffen beginnt um 10:30 Uhr und das Budget beträgt 128 Dollar. 没问题，我们按这个顺序继续。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisemos el plan de hoy. 先整理 Oficina 文档，再检查 Apple Pencil 的书写效果。 La reunión comienza a las 10:30, y el presupuesto es de 128 dólares. 没问题，我们按这个顺序继续。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos rever o plano de hoje. 先整理 Escritório 文档，再检查 Apple Pencil 的书写效果。 A reunião começa às 10:30, e o orçamento é de 128 dólares. 没问题,我们按这个顺序继续。"
          }
        }
      }
    },
