    "notes.note_export_selection.at_most_pages_can_be_exported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most %@ pages can be exported at a time; export in batches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多导出 %@ 页，请分批导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次最多匯出 %@ 頁，請分批匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度にエクスポートできるページは最大%@です。バッチでエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 %@ 페이지는 한 번에 내보낼 수 있으며, 일괄적으로 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au plus, les pages %@ peuvent être exportées à la fois ; exportez par lots."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-Seiten können höchstens auf einmal exportiert werden; Export in Stapeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A lo sumo, las páginas %@ se pueden exportar a la vez; exportar en lotes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo, as páginas %@ podem ser exportadas de uma vez; exportação em lotes."
          }
        }
      }
    },
    "notes.note_export_selection.only_note_documents_can_be_exported": {
      "extractionState": "manual",
