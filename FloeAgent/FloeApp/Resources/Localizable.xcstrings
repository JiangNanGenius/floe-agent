    "mail.error.authenticationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication failed. Check the password or reconnect the selected account in Mail settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认证失败，请检查密码，或在邮件设置中重新连接所选账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "認證失敗，請檢查密碼，或在郵件設定中重新連線所選賬戶。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証に失敗しました。 メール設定でパスワードを確認するか、選択したアカウントを再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증에 실패했습니다. 메일 설정에서 비밀번호를 확인하거나 선택한 계정을 다시 연결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'authentification a échoué. Vérifiez le mot de passe ou reconnectez le compte sélectionné dans les réglages Mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizierung fehlgeschlagen. Überprüfen Sie das Passwort oder verbinden Sie den ausgewählten Account in den Mail-Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticación fallida. Comprueba la contraseña o vuelve a conectar la cuenta seleccionada en la configuración de Mail."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na autenticação. Verifique a senha ou reconecte a conta selecionada nas configurações do Mail."
          }
        }
      }
    },
