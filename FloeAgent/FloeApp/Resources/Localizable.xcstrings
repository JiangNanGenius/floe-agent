    "app.bilingual.330695eaf9290b18": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会用这个引擎创建真实的起始文件。没有识别依据时，运行和构建保持关闭，直到工程出现可识别标记。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real starter files will be created with this engine. Without recognized evidence, run and build stay closed until a marker appears."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會用這個引擎建立真實的起始檔案。沒有識別依據時，執行和構建保持關閉，直到工程出現可識別標記。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンで実際のスターターファイルが作成されます。 認められた証拠がない限り、ランとビルドはマーカーが現れるまで閉じたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 스타터 파일은 이 엔진으로 생성됩니다. 인정된 증거가 없으면, 런과 빌드는 마커가 나타날 때까지 닫힌 상태를 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De vrais fichiers de démarrage seront créés avec ce moteur. Sans preuve reconnue, la course et la construction restent fermées jusqu'à ce qu'un marqueur apparaisse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte Starterdateien werden mit dieser Engine erstellt. Laufen Sie ohne erkannte Beweise und bleiben Sie geschlossen, bis eine Markierung erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se crearán archivos de inicio reales con este motor. Sin evidencia reconocida, ejecute y construya cerrado hasta que aparezca un marcador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos iniciais reais serão criados com este mecanismo. Sem evidências reconhecidas, execute e construa permaneça fechado até que um marcador apareça."
          }
        }
      }
    },
    "app.bilingual.b84dbde8edcb8a21": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前文件里没有识别到这个引擎的依据。选择会保存为手动未验证；检查、读取、编辑和历史保持可用，运行和构建保持关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No marker for this engine was recognized in these files. The choice is saved as manual/unverified; inspect, read, edit and history stay available, while run and build stay closed."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前檔案裡沒有識別到這個引擎的依據。選擇會儲存為手動未驗證；檢查、讀取、編輯和歷史保持可用，執行和構建保持關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルでは、このエンジンのマーカーは認識されませんでした。 選択は手動/未検証として保存されます；検査、読み取り、編集、履歴は利用可能なままで、実行とビルドは閉じたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일에서는 이 엔진에 대한 마커가 인식되지 않았습니다. 선택은 수동/미확인으로 저장됩니다; 검사, 읽기, 편집 및 기록은 계속 사용할 수 있으며, 실행 및 빌드는 닫힌 상태로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun marqueur pour ce moteur n'a été reconnu dans ces fichiers. Le choix est enregistré comme manuel/non vérifié ; inspecter, lire, modifier et l'historique reste disponible, tandis que l'exécution et la construction restent fermées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Dateien wurde kein Marker für diese Engine erkannt. Die Auswahl wird als manuell/unverifiziert gespeichert; inspizieren, lesen, bearbeiten und der Verlauf bleiben verfügbar, während der Lauf und der Build geschlossen bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoció ninguna marca para este motor en estos archivos. La opción se guarda como manual/no verificada; inspeccionar, leer, editar y el historial permanecer disponible, mientras que ejecutar y construir permanecer cerrado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum marcador para este motor foi reconhecido nesses arquivos. A escolha é salva como manual/não verificada; inspecionar, ler, editar e o histórico permanece disponível, enquanto a execução e a compilação permanecem fechadas."
          }
        }
      }
    },
