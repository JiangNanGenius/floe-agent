    "app.bilingual.2d21087fd920c9af": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制已保存的盘、模型和设置。打印文件可在新工程中重新生成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy saved plates, models and settings. Generate print files again in the new project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製已儲存的盤、模型和設定。列印檔案可在新工程中重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたプレート、モデル、設定をコピーしてください。 新しいプロジェクトで印刷ファイルを再度生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 플레이트, 모델 및 설정을 복사합니다. 새 프로젝트에서 인쇄 파일을 다시 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiez les plaques, les modèles et les paramètres enregistrés. Générez à nouveau des fichiers d'impression dans le nouveau projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie gespeicherte Platten, Modelle und Einstellungen. Generieren Sie im neuen Projekt erneut Druckdateien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia las placas, modelos y ajustes guardados. Genere archivos de impresión de nuevo en el nuevo proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie placas, modelos e configurações salvas. Gere arquivos de impressão novamente no novo projeto."
          }
        }
      }
    },
