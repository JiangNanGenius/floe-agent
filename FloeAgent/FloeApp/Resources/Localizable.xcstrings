    "packages.node.policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic follows the owning project’s packageManager and lockfile; conflicts are shown before installation. An explicit choice applies to this environment. Uses the bundled CLI version and preserves project files."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动遵循所属项目的 packageManager 和锁文件，冲突时会先提示。手动选择只应用于本环境。使用 App 内置的管理器版本，保留项目文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動遵循所屬專案的 packageManager 和鎖檔案，衝突時會先提示。手動選擇只應用於本環境。使用 App 內建的管理器版本，保留專案檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic は所有プロジェクトの packageManager と lockfile に従い、競合はインストール前に表示されます。 この環境には明示的な選択が適用されます。 バンドルされたCLIバージョンを使用し、プロジェクトファイルを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 소유 프로젝트의 packageManager와 lockfile을 따르며, 충돌은 설치 전에 표시됩니다. 이 환경에는 명시적인 선택이 적용됩니다. 번들된 CLI 버전을 사용하고 프로젝트 파일을 보존합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique suit le packageManager et le fichier de verrouillage du projet propriétaire ; les conflits sont affichés avant l'installation. Un choix explicite s'applique à cet environnement. Utilise la version CLI fournie et préserve les fichiers de projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch folgt dem PaketManager und der Sperrdatei des Eigentümerprojekts; Konflikte werden vor der Installation angezeigt. Eine explizite Wahl gilt für diese Umgebung. Verwendet die gebündelte CLI-Version und bewahrt Projektdateien auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic sigue el packageManager y el lockfile del proyecto propietario; los conflictos se muestran antes de la instalación. Una elección explícita se aplica a este entorno. Utiliza la versión de CLI incluida y conserva los archivos del proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático segue o packageManager e o lockfile do projeto proprietário; os conflitos são mostrados antes da instalação. Uma escolha explícita se aplica a este ambiente. Usa a versão CLI incluída e preserva os arquivos do projeto."
          }
        }
      }
    },
    "packages.registry.policy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source applies to this environment for manual, Shell and Agent installations. Use a public HTTPS registry or Python Simple index. Keep credentials out of the URL. Changing the source keeps installed files and applies to the next transaction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此源用于当前环境的手动、Shell 和 Agent 安装。请填写公开的 HTTPS 仓库或 Python Simple 索引地址，勿在网址中放入凭据。修改不会删除现有依赖，下次安装时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此源用於當前環境的手動、Shell 和 Agent 安裝。請填寫公開的 HTTPS 倉庫或 Python Simple 索引地址，勿在網址中放入憑據。修改不會刪除現有依賴，下次安裝時生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースは、手動、シェル、およびエージェントのインストール環境に適用されます。 公開の HTTPS レジストリまたは Python Simple インデックスを使用してください。 URL に資格情報を含めないようにしてください。 ソースを変更すると、インストールされたファイルが保持され、次の取引に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스는 수동, 셸 및 에이전트 설치에 대해 이 환경에 적용됩니다. 공개 HTTPS 레지스트리 또는 Python Simple 인덱스를 사용하십시오. URL에 자격 증명을 보관하십시오. 소스를 변경하면 설치된 파일이 유지되며 다음 거래에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source s'applique à cet environnement pour les installations manuelles, Shell et Agent. Utilisez un registre HTTPS public ou un index simple Python. Gardez les informations d'identification hors de l'URL. La modification de la source conserve les fichiers installés et s'applique à la prochaine transaction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle gilt für diese Umgebung für manuelle, Shell- und Agent-Installationen. Verwenden Sie eine öffentliche HTTPS-Registrierung oder einen Python Simple-Index. Halten Sie Anmeldeinformationen von der URL fern. Das Ändern der Quelle behält installierte Dateien bei und wird auf die nächste Transaktion angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente se aplica a este entorno para instalaciones manuales, de Shell y de agente. Utilice un registro público HTTPS o un índice Python Simple. Mantenga las credenciales fuera de la URL. Cambiar la fuente mantiene los archivos instalados y se aplica a la siguiente transacción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fonte se aplica a este ambiente para instalações manuais, Shell e Agent. Use um registro público HTTPS ou um índice Python Simple. Mantenha as credenciais fora da URL. Alterar a fonte mantém os arquivos instalados e se aplica à próxima transação."
          }
        }
      }
    },
