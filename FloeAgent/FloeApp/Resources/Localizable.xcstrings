    "app.bilingual.182526d6e6ee3995": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曲线预览最多显示 12 条曲线并按需抽样时间点，导出包含完整结果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chart preview: up to 12 series with sampled time points. Export includes the full results."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "曲線預覽最多顯示 12 條曲線並按需抽樣時間點，匯出包含完整結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャートプレビュー：サンプリングされた時間点を含む最大12シリーズ エクスポートには完全な結果が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트 미리보기: 샘플링된 시간 포인트가 포함된 최대 12개 시리즈. 내보내기에는 전체 결과가 포함됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du graphique : jusqu'à 12 séries avec des points de temps échantillonnés. L'exportation comprend les résultats complets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
