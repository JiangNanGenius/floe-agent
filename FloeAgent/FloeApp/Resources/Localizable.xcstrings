    "app.git_hub_source_card.this_saved_read_could_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此读取结果无法恢复。请让助手重新读取，原任务仍然保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved read could not be restored. Ask the assistant to read it again; the original task is preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此讀取結果無法恢復。請讓助手重新讀取，原任務仍然保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存された読み取りは復元できませんでした。 アシスタントに再度読んでもらうよう依頼してください；元のタスクは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장된 읽기를 복원할 수 없습니다. 조교에게 다시 읽어 달라고 요청하십시오; 원래 작업은 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette lecture enregistrée n'a pas pu être restaurée. Demandez à l'assistant de le relire ; la tâche d'origine est préservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese gespeicherte Lektüre konnte nicht wiederhergestellt werden. Bitten Sie den Assistenten, es noch einmal zu lesen; die ursprüngliche Aufgabe bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lectura guardada no se pudo restaurar. Pídale al asistente que lo lea de nuevo; la tarea original se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta leitura salva não pôde ser restaurada. Peça ao assistente para lê-lo novamente; a tarefa original está preservada."
          }
        }
      }
    },
    "app.git_hub_source_card.could_not_open_collaboration_retry": {
