          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ao vivo está temporariamente indisponível; pedaços descobertos serão transcritos mais tarde. A gravação não é afetada."
          }
        }
      }
