    "app.bilingual.d8e51f19f1a2633": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先使用云端模型。关闭后仍可明确指定图乐园。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud models take priority. You can still explicitly request Image Playground when off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "優先使用雲端模型。關閉後仍可明確指定圖樂園。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドモデルが優先されます。 オフの場合でも、Image Playground を明示的にリクエストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 모델이 우선됩니다. 꺼져 있는 경우에도 Image Playground를 명시적으로 요청할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles de cloud sont prioritaires. Vous pouvez toujours demander explicitement Image Playground lorsque vous êtes désactivé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Modelle haben Vorrang. Sie können Image Playground weiterhin explizit anfordern, wenn Sie ausgeschaltet sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos en la nube tienen prioridad. Todavía puedes solicitar explícitamente Image Playground cuando estés apagado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de nuvem têm prioridade. Você ainda pode solicitar explicitamente o Image Playground quando estiver desligado."
          }
        }
      }
    },
    "app.bilingual.e98f7f5b860c1071": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查客户端 ID 和申请的权限。"
          }
        },
        "en": {
          "stringUnit": {
