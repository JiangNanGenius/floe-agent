        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique aux voix locales. Les voix du cloud gardent des liens complets."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für lokale Stimmen. Cloud-Stimmen behalten vollständige Links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
