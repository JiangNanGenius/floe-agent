          "stringUnit": {
            "state": "translated",
            "value": "Search is unavailable. Check the connection or retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索暂不可用，请检查连接或重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
