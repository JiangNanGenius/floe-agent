    "providers.video_provider_adapter.the_provider_returned_unknown_the_task": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider returned UNKNOWN: the task does not exist or its status is unknown (task_id queries are valid for 24 hours; after that this status is returned)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商返回 UNKNOWN：任务不存在或状态未知（task_id 查询有效期 24 小时，超时后即为该状态）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商返回 UNKNOWN：任務不存在或狀態未知（task_id 查詢有效期 24 小時，超時後即為該狀態）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーは UNKNOWN を返しました: タスクは存在しないか、ステータスが不明です（task_id のクエリは 24 時間有効です。その後はこのステータスが返されます）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자가 “UNKNOWN”을 반환했습니다: 작업이 존재하지 않거나 상태가 알 수 없습니다 (task_id 쿼리는 24시간 동안 유효하며, 그 이후에는 이 상태가 반환됩니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé UNKNOWN : la tâche n'existe pas ou son statut est inconnu (les requêtes task_id sont valides pendant 24 heures ; après cela, ce statut est renvoyé)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat UNKNOWN zurückgegeben: Die Aufgabe existiert nicht oder ihr Status ist unbekannt (task_id-Abfragen sind 24 Stunden lang gültig; danach wird dieser Status zurückgegeben)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor devolvió UNKNOWN: la tarea no existe o su estado es desconocido (las consultas de task_id son válidas durante 24 horas; después de eso, este estado se devuelve)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor retornou DESCONHECIDO: a tarefa não existe ou seu status é desconhecido (as consultas task_id são válidas por 24 horas; depois disso, esse status é retornado)."
          }
        }
      }
    },
