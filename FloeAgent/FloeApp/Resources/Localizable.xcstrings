    "app.background_run_coordinator.is_due_soon_ios_may": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 即将到执行时间。iOS 可能不会唤醒应用；打开 Floe 以确保执行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is due soon. iOS may not wake the app; open Floe to make sure it runs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 即將到執行時間。iOS 可能不會喚醒應用；開啟 Floe 以確保執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はまもなく期限です。 iOS はアプリをウェイクアップしない可能性があります。動作を確認するために Floe を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 곧 마감됩니다. iOS는 앱을 깨우지 않을 수 있습니다; 실행을 확인하려면 Floe를 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est bientôt dû. iOS peut ne pas réveiller l'application ; ouvrez Floe pour vous assurer qu'elle fonctionne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bald fällig. iOS kann die App nicht wecken; öffnen Sie Floe, um sicherzustellen, dass sie ausgeführt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence pronto. iOS puede no activar la aplicación; abra Floe para asegurarse de que se ejecuta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence em breve. iOS pode não ativar o aplicativo; abra Floe para garantir que ele funcione."
          }
        }
      }
    },
    "app.background_run_coordinator.the_scheduled_task_is_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
