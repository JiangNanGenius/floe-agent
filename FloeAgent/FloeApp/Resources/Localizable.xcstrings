    "providers.capability_migration.changed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ changed since this review; reload and review the current state."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在本次查看后已更改；请重新加载并查看当前状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在本次檢視後已更改；請重新載入並檢視當前狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのレビュー以降に変更されました。再読み込みして現在の状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 이 검토 이후 변경되었습니다; 새로 고침하고 현재 상태를 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a changé depuis cet examen ; rechargez et vérifiez l'état actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich seit dieser Überprüfung geändert; neu laden und den aktuellen Zustand überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha cambiado desde esta revisión; vuelva a cargar y revise el estado actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mudou desde esta revisão; recarregue e revise o estado atual."
          }
        }
      }
    },
