          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formes et les conteneurs deviennent des éléments de contour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Formen und Behälter werden zu Umrisselementen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las formas y los contenedores se convierten en elementos de contorno."
          }
