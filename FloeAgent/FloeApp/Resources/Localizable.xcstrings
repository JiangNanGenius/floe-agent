    "cad.scene.placementDependency": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Later model features depend on this placement. Edit those features before moving the group."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后续模型特征依赖此位置。移动群组前请先编辑这些特征。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後續模型特徵依賴此位置。移動群組前請先編輯這些特徵。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後期モデルの機能はこの配置に依存します。 グループを移動する前に、それらの機能を編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후속 모델 기능은 이 배치에 따라 달라집니다. 그룹을 이동하기 전에 해당 기능들을 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les caractéristiques ultérieures du modèle dépendent de ce placement. Modifiez ces fonctionnalités avant de déplacer le groupe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spätere Modellmerkmale hängen von dieser Platzierung ab. Bearbeiten Sie diese Funktionen, bevor Sie die Gruppe verschieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las características posteriores del modelo dependen de esta ubicación. Edita esas características antes de mover el grupo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos do modelo posterior dependem desse posicionamento. Edite esses recursos antes de mover o grupo."
          }
        }
      }
    },
