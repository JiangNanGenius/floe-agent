        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成/編集は画像を生成し、ビジョンはモデルが画像を読み取ることを可能にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성/편집은 이미지를 생성합니다; 비전은 모델이 이미지를 읽을 수 있게 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Génération/édition produire des images ; la vision permet au modèle de lire des images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
