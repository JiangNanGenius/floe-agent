          "stringUnit": {
            "state": "translated",
            "value": "選択されたツールは現在、Apple Intelligenceモデルに渡すことができません。ツールの数を減らして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 도구를 현재 Apple Intelligence 모델에 전달할 수 없습니다; 도구 수를 줄이고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils sélectionnés ne peuvent actuellement pas être remis au modèle Apple Intelligence ; réduisez le nombre d'outils et réessayez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählten Werkzeuge können derzeit nicht an das Modell Apple Intelligence übergeben werden; reduzieren Sie die Anzahl der Werkzeuge und versuchen Sie es erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas seleccionadas no se pueden entregar actualmente al modelo Apple Intelligence; reduzca el número de herramientas e inténtelo de nuevo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas selecionadas não podem ser entregues atualmente ao modelo Apple Intelligence; reduza o número de ferramentas e tente novamente"
          }
        }
      }
    },
    "localmodels.apple_foundation_model_runtime.the_system_model_does_not_yet": {
      "extractionState": "manual",
