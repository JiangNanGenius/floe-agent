    "cad.textureImport.error.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The material changed during import. Choose the images again to keep your latest edits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入期间材质已更改。请重新选择图片，以保留最新编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入期間材質已更改。請重新選擇圖片，以保留最新編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート中に素材が変更されました。 画像を再度選択して、最新の編集を保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수입 과정에서 재료가 변경되었습니다. 최신 편집을 유지하려면 이미지를 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le matériel a changé pendant l'importation. Choisissez à nouveau les images pour conserver vos dernières modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Material hat sich beim Import geändert. Wählen Sie die Bilder erneut aus, um Ihre neuesten Änderungen zu behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El material cambió durante la importación. Elija las imágenes de nuevo para mantener sus últimas ediciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O material mudou durante a importação. Escolha as imagens novamente para manter suas últimas edições."
          }
        }
      }
    },
