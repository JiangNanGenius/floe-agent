    "settings.sync.secrets.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys use iCloud Keychain only when the master switch and that provider's own Keychain switch are both enabled. SSH and VNC credentials always stay on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有总开关和对应供应商的钥匙串开关都开启时，API Key 才会使用 iCloud 钥匙串。SSH 与 VNC 凭据始终只保存在本机。"
          }
        }
      }
    },
