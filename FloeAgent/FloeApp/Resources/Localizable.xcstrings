            "state": "translated",
            "value": "手记提案存储不可用：无法创建 %@ 目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手記提案儲存不可用：無法建立 %@ 目錄。"
          }
