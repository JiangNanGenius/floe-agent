    "app.execution_environment_view.this_stops_terminals_web_services": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将关闭 %@ 个终端、%@ 个网页服务及此环境的端口监听。磁盘和转发规则保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stops %@ terminals, %@ web services and this environment's listeners. Disk and forwarding rules are retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將關閉 %@ 個終端、%@ 個網頁服務及此環境的埠監聽。磁碟和轉發規則保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、%@ ターミナル、%@ ウェブサービス、およびこの環境のリスナーが停止されます。 ディスクおよび転送ルールは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 %@ 터미널, %@ 웹 서비스 및 이 환경의 리스너를 차단합니다. 디스크 및 포워딩 규칙이 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela arrête les terminaux %@, les services Web %@ et les auditeurs de cet environnement. Les règles de disque et de transfert sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden %@-Terminals, %@-Webdienste und die Hörer dieser Umgebung gestoppt. Festplatten- und Weiterleitungsregeln bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto detiene los terminales %@, los servicios web %@ y los oyentes de este entorno. Se conservan las reglas de disco y reenvío."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso impede os terminais %@, os serviços da web %@ e os ouvintes deste ambiente. As regras de disco e encaminhamento são mantidas."
          }
        }
      }
    },
    "app.bilingual.a39244436cb7e455": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟机未能停止，数据已保留，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The virtual machine did not stop. Data was retained; retry stopping."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "虛擬機器未能停止，資料已保留，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想マシンは停止しませんでした。 データは保持されました。再試行は停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 머신이 멈추지 않았습니다. 데이터가 보존되었습니다; 재시도 중지되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La machine virtuelle ne s'est pas arrêtée. Les données ont été conservées ; essayez à nouveau d'arrêter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die virtuelle Maschine hat nicht aufgehört. Die Daten wurden gespeichert; versuchen Sie erneut, zu stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máquina virtual no se detuvo. Los datos se retuvieron; intente detenerse de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máquina virtual não parou. Os dados foram retidos; tente novamente parando."
          }
        }
      }
    },
