    "settings.settings_root_view.conversion_happens_only_when_you_tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion happens only when you tap “Understand & organize” or accept a “Convert to card” suggestion; original handwriting is never replaced automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你点“理解并整理”或接受“转为卡片”建议时才会转换，原始手写不会被自动替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你點“理解並整理”或接受“轉為卡片”建議時才會轉換，原始手寫不會被自動替換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換は「Understand & organize」をタップするか「Convert to card」の提案を受諾した場合にのみ行われ、元の手書き文字は自動的に置き換えられることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환은 “Understand & organize”를 탭하거나 “Convert to card” 제안을 수락할 때만 발생합니다; 원본 손글씨는 자동으로 교체되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversion ne se produit que lorsque vous appuyez sur \"Comprendre et organiser\" ou acceptez une suggestion \"Convertir en carte\" ; l'écriture originale n'est jamais remplacée automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konvertierung erfolgt nur, wenn Sie auf \"Verstehen & Organisieren\" tippen oder einen Vorschlag \"In Karte umwandeln\" annehmen; die ursprüngliche Handschrift wird nie automatisch ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversión solo ocurre cuando tocas \"Entender y organizar\" o aceptas una sugerencia de \"Convertir a tarjeta\"; la escritura original nunca se reemplaza automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversão só acontece quando você toca em \"Entender e organizar\" ou aceita uma sugestão de \"Converter para cartão\"; a caligrafia original nunca é substituída automaticamente."
          }
        }
      }
    },
