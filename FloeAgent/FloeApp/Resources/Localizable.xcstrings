        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存於鑰匙串，絕不寫入資料庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンにのみ保存され、データベースには保存されません。"
          }
