        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed tasks stay selected so you can retry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败的任务会保持选中，可直接重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
