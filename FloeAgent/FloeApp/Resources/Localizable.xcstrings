    "app.bilingual.83a7a583015fb4f3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入图片或绘制内容，再向画布外扩展。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import an image or draw content, then expand beyond its canvas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入圖片或繪製內容，再向畫布外擴充套件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像または描画コンテンツをインポートし、キャンバスを超えて展開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 가져오거나 콘텐츠를 그린 다음, 캔버스를 넘어 확장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez une image ou dessinez du contenu, puis développez-la au-delà de sa toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie ein Bild oder zeichnen Sie Inhalte und erweitern Sie sie dann über die Leinwand hinaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa una imagen o dibuja contenido, luego expande más allá de su lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
