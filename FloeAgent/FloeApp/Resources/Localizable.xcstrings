    "app.bilingual.c76f19b5295c2bb4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统浏览器只影响你亲自点击的链接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system-browser option affects links you tap yourself."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統瀏覽器隻影響你親自點選的連結。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムブラウザのオプションは、あなたが自分でタップしたリンクに影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 브라우저 옵션은 직접 탭하는 링크에 영향을 미칩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'option navigateur système affecte les liens que vous appuyez vous-même."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Systembrowser-Option beeinflusst Links, auf die Sie selbst tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción del navegador del sistema afecta a los enlaces que usted mismo toca."
