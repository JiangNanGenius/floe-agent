    "workspace.workspace_canvas_view.recognize_content_and_relationships_first_then": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recognize content and relationships first, then generate editable nodes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先识别内容与关系，再生成可编辑节点"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先識別內容與關係，再生成可編輯節點"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずコンテンツとリレーションシップを認識し、次に編集可能なノードを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 콘텐츠와 관계를 인식한 다음, 편집 가능한 노드를 생성합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaissez d'abord le contenu et les relations, puis générez des nœuds modifiables"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkennen Sie zuerst Inhalte und Beziehungen und generieren Sie dann bearbeitbare Knoten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero reconoce el contenido y las relaciones, luego genera nodos editables"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconheça conteúdo e relacionamentos primeiro, depois gere nós editáveis"
          }
        }
      }
    },
