    "cad.recovery.item.missingDamagedPreview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The damaged document's saved preview image is missing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "损坏文档中已保存的预览图缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "損壞文件中已儲存的預覽圖缺失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "破損した文書の保存されたプレビュー画像が見つかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손상된 문서의 저장된 미리보기 이미지가 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'image d'aperçu enregistrée du document endommagé est manquante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Vorschaubild des beschädigten Dokuments fehlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta la imagen de vista previa guardada del documento dañado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A imagem de visualização salva do documento danificado está faltando."
          }
        }
      }
    },
    "cad.recovery.notice.previousNewerSchema": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save was written by a newer app version. The copy opens read-only here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此保存由较新的应用版本写入。副本在此版本中以只读方式打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存由較新的應用版本寫入。副本在此版本中以只讀方式開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブは新しいバージョンのアプリによって作成されました。 このコピーはここで読み取り専用に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장은 최신 앱 버전으로 작성되었습니다. 복사본이 여기서 읽기 전용으로 열립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde a été écrite par une version plus récente de l'application. La copie s'ouvre en lecture seule ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicherstand wurde von einer neueren App-Version geschrieben. Die Kopie wird hier schreibgeschützt geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guardado fue escrito por una versión más reciente de la aplicación. La copia se abre de solo lectura aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvamento foi escrito por uma versão mais recente do aplicativo. A cópia abre somente leitura aqui."
          }
        }
      }
    },
    "cad.recovery.notice.previousReadOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save uses features this version can't edit. The copy opens read-only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此保存使用了此版本无法编辑的功能。副本将以只读方式打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存使用了此版本無法編輯的功能。副本將以只讀方式開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブは、このバージョンでは編集できない機能を使用しています。 コピーは読み取り専用で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장은 이 버전에서 편집할 수 없는 기능을 사용합니다. 복사본이 읽기 전용으로 열립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde utilise des fonctionnalités que cette version ne peut pas modifier. La copie s'ouvre en lecture seule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicher verwendet Funktionen, die diese Version nicht bearbeiten kann. Die Kopie wird schreibgeschützt geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guardado utiliza características que esta versión no puede editar. La copia se abre de solo lectura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvamento usa recursos que esta versão não pode editar. A cópia abre somente leitura."
          }
        }
      }
    },
    "cad.recovery.notice.manifestCountsDiffer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved counts in the previous manifest differ from its records; the counts shown here come from the verified records."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次清单中记录的数量与其记录不一致；此处显示的数量来自已验证的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次清單中記錄的數量與其記錄不一致；此處顯示的數量來自已驗證的記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のマニフェストに保存されたカウントはその記録と異なります。ここに表示されているカウントは、検証済みのレコードから取得されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 매니페스트에 저장된 카운트는 해당 레코드와 다르며, 여기 표시된 카운트는 검증된 레코드에서 온 것입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les comptes enregistrés dans le manifeste précédent diffèrent de ses enregistrements ; les comptes indiqués ici proviennent des enregistrements vérifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Zählungen im vorherigen Manifest unterscheiden sich von den Datensätzen; die hier angezeigten Zählungen stammen aus den verifizierten Datensätzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recuentos guardados en el manifiesto anterior difieren de sus registros; los recuentos que se muestran aquí provienen de los registros verificados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As contagens salvas no manifesto anterior diferem de seus registros; as contagens mostradas aqui vêm dos registros verificados."
          }
        }
      }
    },
    "cad.recovery.notice.unclaimedResources": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d unreferenced resource files are copied as-is."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %d 个未被引用的资源文件会原样复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另有 %d 個未被引用的資原始檔會原樣複製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 参照されていないリソースファイルはそのままコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 참조되지 않은 리소스 파일은 그대로 복사됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de ressources non référencés %d sont copiés tels quels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d nicht referenzierte Ressourcendateien werden so kopiert, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de recursos no referenciados de %d se copian tal como están."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de recursos não referenciados %d são copiados como estão."
          }
        }
      }
    },
    "cad.recovery.notice.noPreviewImage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save has no stored viewport preview."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此保存没有存储视口预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存沒有儲存視口預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブには保存されたビューポートプレビューがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장에는 저장된 뷰포트 미리보기가 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n'a pas d'aperçu de la fenêtre d'affichage stocké."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Speicher hat keine gespeicherte Ansichtsfenstervorschau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este guardado no tiene vista previa de la ventana gráfica almacenada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este salvamento não tem visualização de janela de visualização armazenada."
          }
        }
      }
    },
    "cad.recovery.notice.unrecognizedFields": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This save contains fields this version doesn't recognize. They are copied without changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此保存包含此版本无法识别的字段；它们会被原样复制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此儲存包含此版本無法識別的欄位；它們會被原樣複製。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセーブには、このバージョンが認識しないフィールドが含まれています。 それらは変更せずにコピーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 저장에는 이 버전이 인식하지 못하는 필드가 포함되어 있습니다. 그들은 변경 없이 복사됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde contient des champs que cette version ne reconnaît pas. Ils sont copiés sans modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Speicherung enthält Felder, die diese Version nicht erkennt. Sie werden ohne Änderungen kopiert."
          }
        },
        "es": {
          "stringUnit": {
