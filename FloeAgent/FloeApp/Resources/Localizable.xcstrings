    "cad.ui.export.obj.preflight.mtl": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some viewers show only base color and opacity; metallic, roughness, normal and emissive maps use the extended MTL format, and scalar maps may be read as sRGB where MTL has no colorspace field."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分查看器只显示基础色和不透明度；金属度、粗糙度、法线和自发光贴图使用扩展 MTL 格式；MTL 没有色彩空间字段，标量贴图可能被当作 sRGB 读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分檢視器只顯示基礎色和不透明度；金屬度、粗糙度、法線和自發光貼圖使用擴充套件 MTL 格式；MTL 沒有色彩空間欄位，標量貼圖可能被當作 sRGB 讀取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のビューアはベースカラーと不透明度のみを表示します；メタリック、ラフネス、ノーマル、エミッシブマップは拡張MTL形式を使用し、スカラー地図はSRGBとして読み取られることがありますが、MTLには色空間フィールドがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 뷰어는 기본 색상과 불투명만 표시하고, 메탈릭, 거칠기, 노멀 및 방출 맵은 확장된 MTL 형식을 사용하며, MTL에 색공간 필드가 없는 경우 스칼라 맵은 sRGB로 읽을 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains téléspectateurs n'affichent que la couleur de base et l'opacité ; les cartes métalliques, de rugosité, normales et émissives utilisent le format MTL étendu, et les cartes scalaires peuvent être lues en sRGB où MTL n'a pas de champ d'espace colorimétrique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Betrachter zeigen nur Grundfarbe und Deckkraft an; Metall-, Rauheits-, Normal- und Emissionskarten verwenden das erweiterte MTL-Format, und skalare Karten können als sRGB gelesen werden, wobei MTL kein Farbraumfeld hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos espectadores muestran solo el color base y la opacidad; los mapas metálicos, rugosos, normales y emisivos utilizan el formato MTL extendido, y los mapas escalares se pueden leer como sRGB donde MTL no tiene campo de espacio de color."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns espectadores mostram apenas cor base e opacidade; mapas metálicos, rugosos, normais e emissivos usam o formato MTL estendido, e os mapas escalares podem ser lidos como sRGB, onde MTL não tem campo de espaço de cores."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.faceFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some face materials couldn't be resolved and use the body material instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分面材质无法解析，已改用实体材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分面材質無法解析，已改用實體材質。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のフェイス素材は解決できず、代わりにボディ素材を使用しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 얼굴 재료는 해결되지 않아 대신 본체 재료를 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains matériaux de visage n'ont pas pu être résolus et utiliser le matériau du corps à la place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Gesichtsmaterialien konnten nicht gelöst werden und stattdessen das Körpermaterial verwendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos materiales faciales no se pudieron resolver y usar el material corporal en su lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns materiais faciais não puderam ser resolvidos e usar o material corporal em vez disso."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.uvGenerated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some textures use an automatic projection because the body has no UVs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分贴图使用了自动投影，因为实体没有 UV。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分貼圖使用了自動投影，因為實體沒有 UV。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のテクスチャは、ボディにUVがないため、自動投影を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 텍스처는 몸에 UV가 없기 때문에 자동 투영을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines textures utilisent une projection automatique parce que le corps n'a pas d'UV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Texturen verwenden eine automatische Projektion, da der Körper keine UV-Strahlen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas texturas utilizan una proyección automática porque el cuerpo no tiene rayos UV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas texturas usam uma projeção automática porque o corpo não tem UVs."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.alphaBaked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base transparency is stored in the opacity map so MTL viewers apply it once."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基础透明度已写入不透明度贴图，避免 MTL 查看器重复应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基礎透明度已寫入不透明度貼圖，避免 MTL 檢視器重複應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースの透明度は不透明度マップに保存されているため、MTLビューアはそれを一度だけ適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 투명도는 불투명도 맵에 저장되므로 MTL 뷰어가 한 번만 적용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transparence de base est stockée dans la carte d'opacité afin que les téléspectateurs MTL l'appliquent une fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Basistransparenz wird in der Deckkraftkarte gespeichert, so dass MTL-Zuschauer sie einmal anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transparencia de la base se almacena en el mapa de opacidad, por lo que los espectadores de MTL la aplican una vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transparência da base é armazenada no mapa de opacidade para que os visualizadores MTL a apliquem uma vez."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.normalized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some images were normalized to match OBJ color and row conventions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分图片已按 OBJ 的颜色和行方向约定转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分圖片已按 OBJ 的顏色和行方向約定轉換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつかの画像は、OBJ の色と行の規則に合わせて正規化されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 이미지가 OBJ 색상 및 행 규칙에 맞게 정규화되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines images ont été normalisées pour correspondre aux conventions de couleur et de ligne OBJ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Bilder wurden normalisiert, um OBJ-Farbe und Zeilenkonventionen zu entsprechen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas imágenes se normalizaron para que coincidan con las convenciones de color y fila de OBJ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas imagens foram normalizadas para corresponder às convenções de cores e linhas da OBJ."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.opacitySemantics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewers differ on whether the opacity map uses luminance or alpha; this bundle writes the complete mask in both RGB and alpha, with the authored opacity baked in."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不同查看器读取不透明度贴图时，有的取亮度，有的取 Alpha；此包会在 RGB 与 Alpha 中写入相同的最终遮罩，并已烘焙作者设定的不透明度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不同檢視器讀取不透明度貼圖時，有的取亮度，有的取 Alpha；此包會在 RGB 與 Alpha 中寫入相同的最終遮罩，並已烘焙作者設定的不透明度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視聴者は不透明度マップが輝度を使用するかアルファを使用するかで意見が異なります。このバンドルはRGBとアルファの両方で完全なマスクを書き込み、作成された不透明度が組み込まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시청자들은 불투명도 맵이 휘도 또는 알파를 사용하는지에 대해 의견이 다릅니다; 이 번들은 전체 마스크를 RGB와 알파 두 가지로 기록하며, 작성자가 만든 불투명도가 내장되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléspectateurs diffèrent sur le fait que la carte d'opacité utilise la luminance ou l'alpha ; cet ensemble écrit le masque complet à la fois en RVB et en alpha, avec l'opacité d'auteur intégrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zuschauer unterscheiden sich darin, ob die Deckkraftkarte Leuchtdichte oder Alpha verwendet; dieses Paket schreibt die komplette Maske sowohl in RGB als auch in Alpha, wobei die geschriebene Deckkraft eingebrannt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espectadores difieren en si el mapa de opacidad utiliza luminancia o alfa; este paquete escribe la máscara completa tanto en RGB como en alfa, con la opacidad de autor incorporada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os espectadores diferem sobre se o mapa de opacidade usa luminância ou alfa; este pacote escreve a máscara completa em RGB e alfa, com a opacidade criada."
          }
        }
      }
    },
    "cad.ui.export.obj.warning.emissiveUnused": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An emissive image is ignored because the material has no emission."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质没有自发光，因此忽略自发光贴图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質沒有自發光，因此忽略自發光貼圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エミッシブ画像は、素材に発光がないため無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방출 이미지는 해당 물질에 방출이 없기 때문에 무시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image émissive est ignorée parce que le matériau n'a pas d'émission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Emissionsbild wird ignoriert, weil das Material keine Emission hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen emisiva se ignora porque el material no tiene emisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem emissiva é ignorada porque o material não tem emissão."
          }
        }
      }
    },
    "cad.error.objBundle.missingTexture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material image is missing. Reapply it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质图片缺失。请重新应用图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質圖片缺失。請重新應用圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材画像が欠落しています。 再度適用して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재질 이미지가 없습니다. 다시 적용하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image matérielle est manquante. Réappliquez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein materielles Bild fehlt. Wenden Sie es erneut an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta una imagen material. Vuelve a aplicarlo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem material está faltando. Reaplique e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.identityMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material image no longer matches its saved version. Reapply it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质图片与已保存版本不一致。请重新应用图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質圖片與已儲存版本不一致。請重新應用圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアル画像が保存されたバージョンと一致しなくなりました。 再度適用して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재질 이미지가 더 이상 저장된 버전과 일치하지 않습니다. 다시 적용하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image matérielle ne correspond plus à sa version enregistrée. Réappliquez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Materialbild stimmt nicht mehr mit seiner gespeicherten Version überein. Wenden Sie es erneut an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen material ya no coincide con su versión guardada. Vuelve a aplicarlo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem de material não corresponde mais à sua versão salva. Reaplique e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.invalidTexture": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material image can't be read. Replace it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取材质图片。请更换图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取材質圖片。請更換圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアル画像は読み取れません。 置き換えて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재질 이미지를 읽을 수 없습니다. 교체하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image matérielle ne peut pas être lue. Remplacez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein materielles Bild kann nicht gelesen werden. Ersetzen Sie es und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer una imagen material. Reemplázalo e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem material não pode ser lida. Substitua-o e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.tooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material image is too large. Reduce it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质图片过大。请缩小图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質圖片過大。請縮小圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材画像は大きすぎます。 減らして、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재질 이미지가 너무 큽니다. 줄이고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image matérielle est trop grande. Réduisez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein materielles Bild ist zu groß. Reduzieren Sie es und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen material es demasiado grande. Reduzca y vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem material é muito grande. Reduza e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.imageOrientation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material image has camera rotation that OBJ can't preserve. Remove the rotation and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质图片带有 OBJ 无法保留的相机旋转信息。请移除旋转后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質圖片帶有 OBJ 無法保留的相機旋轉資訊。請移除旋轉後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マテリアル画像には、OBJが保持できないカメラ回転があります。 回転を削除して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재질 이미지에는 OBJ가 보존할 수 없는 카메라 회전이 있습니다. 회전을 제거하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image matérielle a une rotation de la caméra qu'OBJ ne peut pas préserver. Retirez la rotation et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Materialbild hat eine Kameradrehung, die OBJ nicht beibehalten kann. Entfernen Sie die Drehung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una imagen material tiene rotación de cámara que OBJ no puede preservar. Retire la rotación e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem de material tem rotação de câmera que a OBJ não consegue preservar. Remova a rotação e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.normalColorSpace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The normal map must use linear color values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "法线贴图必须使用线性颜色值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "法線貼圖必須使用線性顏色值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法線マップは線形カラー値を使用しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노멀 맵은 선형 색상 값을 사용해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte normale doit utiliser des valeurs de couleur linéaires."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die normale Karte muss lineare Farbwerte verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa normal debe usar valores de color lineales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa normal deve usar valores de cores lineares."
          }
        }
      }
    },
    "cad.error.objBundle.emissionStrength": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emission strength above 1 can't be written to OBJ. Lower it to 1 or less, or export GLB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将大于 1 的自发光强度写入 OBJ。请将其降到 1 或以下，或导出 GLB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將大於 1 的自發光強度寫入 OBJ。請將其降到 1 或以下，或匯出 GLB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "放射強度が1を超える場合、OBJに書き出すことはできません。 1以下に下げるか、GLBをエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방출 강도가 1을 초과하는 경우 OBJ에 기록할 수 없습니다. 1 이하로 낮추시거나 GLB를 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La force d'émission supérieure à 1 ne peut pas être écrite en OBJ. Réduisez-le à 1 ou moins, ou exportez GLB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Emissionsstärke über 1 kann nicht an OBJ geschrieben werden. Senken Sie es auf 1 oder weniger oder exportieren Sie GLB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuerza de emisión por encima de 1 no se puede escribir a OBJ. Bájelo a 1 o menos, o exporte GLB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A força de emissão acima de 1 não pode ser escrita para OBJ. Diminua para 1 ou menos, ou exporte GLB."
          }
        }
      }
    },
    "cad.error.objBundle.meshUVTransform": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesh UV transform can't be written to OBJ. Choose a planar or box projection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OBJ 无法写入网格 UV 变换。请选择平面或盒式投影后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OBJ 無法寫入網格 UV 變換。請選擇平面或盒式投影后重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッシュのUV変換はOBJに書き出すことができません。 平面投影またはボックス投影を選択し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시 UV 변환은 OBJ에 쓸 수 없습니다. 평면 또는 박스 투영을 선택하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une transformation UV à mailles ne peut pas être écrite en OBJ. Choisissez une projection planaire ou en boîte et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Netz-UV-Transformation kann nicht in OBJ geschrieben werden. Wählen Sie eine Planar- oder Kastenprojektion und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transformación UV de malla no se puede escribir en OBJ. Elija una proyección planar o de caja e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transformação UV de malha não pode ser escrita para OBJ. Escolha uma projeção plana ou de caixa e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.missingUVs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A textured material has no usable UV mapping. Choose a projection in Material and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带贴图的材质没有可用的 UV 映射。请在材质中选择投影后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "帶貼圖的材質沒有可用的 UV 對映。請在材質中選擇投影后重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テクスチャ素材には使用可能なUVマッピングがありません。 Materialで投影を選択し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스처가 있는 재료는 사용 가능한 UV 매핑이 없습니다. Material에서 투영을 선택하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un matériau texturé n'a pas de cartographie UV utilisable. Choisissez une projection dans Matériel et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein strukturiertes Material hat keine verwendbare UV-Mapping. Wählen Sie eine Projektion in Material und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un material texturizado no tiene un mapeo UV utilizable. Elija una proyección en Material e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um material texturizado não tem mapeamento UV utilizável. Escolha uma projeção em Material e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.ambiguousMetadata": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material has conflicting image records. Reapply its images and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质的图片记录冲突。请重新应用图片后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質的圖片記錄衝突。請重新應用圖片後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材には画像記録が矛盾しています。 画像を再度適用し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료에 상충되는 이미지 레코드가 있습니다. 이미지를 다시 적용하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un matériel a des enregistrements d'images contradictoires. Réappliquez ses images et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Material hat widersprüchliche Bildaufzeichnungen. Wenden Sie die Bilder erneut an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un material tiene registros de imágenes conflictivos. Vuelva a aplicar sus imágenes e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um material tem registros de imagem conflitantes. Reaplique suas imagens e tente novamente."
          }
        }
      }
    },
    "cad.error.objBundle.invalidMaterial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A material has settings outside the supported range. Check it and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "材质设置超出支持范围。请检查后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "材質設定超出支援範圍。請檢查後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ある素材には、サポート範囲外の設定があります。 確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료에 지원 범위 외의 설정이 있습니다. 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un matériau a des paramètres en dehors de la plage prise en charge. Vérifiez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
