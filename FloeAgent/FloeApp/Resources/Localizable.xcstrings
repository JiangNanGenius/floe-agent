        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportación de malla. Los sólidos exactos, el historial de edición y las anotaciones no están incluidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação de malha. Sólidos exatos, histórico de edição e anotações não estão incluídos."
          }
        }
      }
    },
    "cad.export.formatLoss.meshFlat": {
