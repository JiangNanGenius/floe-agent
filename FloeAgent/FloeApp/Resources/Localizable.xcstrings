    "workspace.file_tree_view.cad_needs_local_workspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD documents can only be created in a local workspace (not cloud or network)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD 文档只能在本地工作区中创建（不支持云或网络工作区）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD 文件只能在本地工作區中建立（不支援雲或網路工作區）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD ドキュメントは、ローカルワークスペース（クラウドやネットワークではなく）でのみ作成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD 문서는 로컬 워크스페이스에서만 생성할 수 있습니다(클라우드나 네트워크가 아닙니다)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents CAD ne peuvent être créés que dans un espace de travail local (pas dans le cloud ou le réseau)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD-Dokumente können nur in einem lokalen Arbeitsbereich (nicht in der Cloud oder im Netzwerk) erstellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos CAD solo se pueden crear en un espacio de trabajo local (no en la nube ni en la red)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos CAD só podem ser criados em um espaço de trabalho local (não em nuvem ou rede)."
          }
        }
      }
    },
