    "app.bilingual.6f0059a99425504a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车削轴为模型 Z 轴，半径从 X/Y 原点量起。请在生成刀路前检查车削轮廓与装夹方向。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning uses the model Z axis, with radii measured from the X/Y origin. Check the turning profile and clamping direction before generating toolpaths."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "車削軸為模型 Z 軸，半徑從 X/Y 原點量起。請在生成刀路前檢查車削輪廓與裝夾方向。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurningはモデルZ軸を使用し、半径はX/Y原点から測定されます。 ツールパスを生成する前に、旋削プロファイルとクランプ方向を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "턴은 모델 Z축을 사용하며, 반지는 X/Y 원점에서 측정됩니다. 툴패스를 생성하기 전에 선삭 프로파일과 클램핑 방향을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning utilise l'axe Z du modèle, avec des rayons mesurés à partir de l'origine X/Y. Vérifiez le profil de rotation et la direction de serrage avant de générer des chemins d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Drehen verwendet die Modell-Z-Achse, wobei die Radien vom X/Y-Ursprung gemessen werden. Überprüfen Sie das Drehprofil und die Klemmrichtung, bevor Sie Werkzeugwege erzeugen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El giro utiliza el eje Z del modelo, con radios medidos desde el origen X/Y. Compruebe el perfil de giro y la dirección de sujeción antes de generar trayectorias de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O torneamento usa o eixo Z do modelo, com raios medidos a partir da origem X/Y. Verifique o perfil de giro e a direção de fixação antes de gerar caminhos de ferramentas."
          }
        }
      }
    },
