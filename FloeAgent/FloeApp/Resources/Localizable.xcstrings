    "app.bilingual.eb59a10418fca3ba": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建尚未确认停止，请重试取消。项目仍保持打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build has not confirmed stopping. Retry Cancel; the project stays open."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構建尚未確認停止，請重試取消。專案仍保持開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは停止が確認されていません。 再試行 キャンセル; プロジェクトは開いたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드가 중지를 확인하지 않았습니다. 재시도 취소; 프로젝트는 계속 열려 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La construction n'a pas confirmé l'arrêt. Réessayer Annuler ; le projet reste ouvert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build hat das Stoppen nicht bestätigt. Erneut versuchen Abbrechen; das Projekt bleibt offen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La construcción no ha confirmado la detención. Vuelve a intentar Cancelar; el proyecto permanece abierto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação não confirmou a parada. Tente novamente Cancelar; o projeto permanece aberto."
          }
        }
      }
    },
    "app.bilingual.99a7a580c1caf654": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "构建尚未确认停止，请重试关闭或取消构建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build has not confirmed stopping. Retry Close or Cancel build."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "構建尚未確認停止，請重試關閉或取消構建。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは停止が確認されていません。 「Close」または「Cancel build」を再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드가 중지를 확인하지 않았습니다. 다시 시도하십시오 닫기 또는 빌드 취소"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La construction n'a pas confirmé l'arrêt. Réessayez de fermer ou d'annuler la version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build hat das Stoppen nicht bestätigt. Versuchen Sie es erneut. Schließen oder Abbrechen des Builds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La construcción no ha confirmado la detención. Vuelva a intentar Cerrar o Cancelar la compilación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação não confirmou a parada. Tente novamente Fechar ou Cancelar a compilação."
          }
        }
      }
    },
    "app.bilingual.f04e4312b091a7a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先允许为 CI 上传本次保存版本，或改选本地/源代码路线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow uploading this saved revision for CI, or choose a local/source route."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先允許為 CI 上傳本次儲存版本，或改選本地/原始碼路線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存されたリビジョンのCIへのアップロードを許可するか、ローカル/ソースルートを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CI에 대해 이 저장된 리비전을 업로드하도록 허용하거나, 로컬/소스 경로를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez le téléchargement de cette révision enregistrée pour CI, ou choisissez un itinéraire local/source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie das Hochladen dieser gespeicherten Revision für CI oder wählen Sie eine lokale/Quellenroute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir la carga de esta revisión guardada para CI, o elija una ruta local/fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o upload desta revisão salva para CI ou escolha uma rota local/fonte."
          }
        }
      }
    },
