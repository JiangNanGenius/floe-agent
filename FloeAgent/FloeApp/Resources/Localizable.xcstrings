    "cad.building.error.buildingGeometryWasChangedInCADRestore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building geometry was changed in CAD. Restore its building features before changing these dimensions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建筑几何已在 CAD 中修改，请先恢复相应建筑特征，再更改这些尺寸。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建築幾何已在 CAD 中修改，請先恢復相應建築特徵，再更改這些尺寸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CADで建物の形状が変更されました。 これらの寸法を変更する前に、その建築特徴を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD에서 건물 형상이 변경되었습니다. 이 치수를 변경하기 전에 건물 특징을 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La géométrie du bâtiment a été modifiée en CAO. Restaurer les caractéristiques de son bâtiment avant de modifier ces dimensions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebäudegeometrie wurde in CAD geändert. Stellen Sie die Gebäudemerkmale wieder her, bevor Sie diese Abmessungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La geometría del edificio se cambió en CAD. Restaure las características de su edificio antes de cambiar estas dimensiones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geometria do edifício foi alterada em CAD. Restaure seus recursos de construção antes de alterar essas dimensões."
          }
        }
      }
    },
    "cad.building.error.buildingFeaturesHaveBeenInterleavedWithOther": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building features have been interleaved with other CAD features. Restore their history order before editing the building."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建筑特征与其他 CAD 特征交错，请先恢复其历史顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建築特徵與其他 CAD 特徵交錯，請先恢復其歷史順序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "建築機能は他のCAD機能と組み込まれています。 建物を編集する前に、履歴の順序を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "건물 기능이 다른 CAD 기능과 교차되었습니다. 건물을 편집하기 전에 그들의 기록 순서를 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités de construction ont été entrelacées avec d'autres fonctionnalités CAD. Restaurez leur ordre d'historique avant de modifier le bâtiment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gebäudemerkmale wurden mit anderen CAD-Funktionen verschachtelt. Stellen Sie die Reihenfolge ihres Verlaufs wieder her, bevor Sie das Gebäude bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las características de construcción se han entrelazado con otras características de CAD. Restaurar su orden de historial antes de editar el edificio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos de construção foram intercalados com outros recursos do CAD. Restaure a ordem do histórico antes de editar o edifício."
          }
        }
      }
    },
    "cad.building.error.aBuildingFeatureIdentityConflictsWithAnother": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A building feature identity conflicts with another feature."
