    "workspace.workspace_canvas_view.search_for_material_organize_the_selection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for material, organize the selection, or generate images and videos directly. Prompts, configurations and results stay on the canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索资料、整理选中内容，或直接生成图片和视频。提示词、配置与结果会留在画布上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋資料、整理選中內容，或直接生成圖片和影片。提示詞、配置與結果會留在畫布上。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材を検索し、選択範囲を整理し、または画像や動画を直接生成してください。 プロンプト、設定、結果はキャンバス上に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료를 검색하고, 선택을 정리하거나, 이미지와 비디오를 직접 생성하십시오. 프롬프트, 설정 및 결과가 캔버스에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez du matériel, organisez la sélection ou générez directement des images et des vidéos. Les invites, les configurations et les résultats restent sur la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie nach Material, organisieren Sie die Auswahl oder erstellen Sie Bilder und Videos direkt. Eingabeaufforderungen, Konfigurationen und Ergebnisse bleiben auf der Leinwand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque material, organice la selección o genere imágenes y vídeos directamente. Las indicaciones, configuraciones y resultados se quedan en el lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise material, organize a seleção ou gere imagens e vídeos diretamente. Prompts, configurações e resultados permanecem na tela."
