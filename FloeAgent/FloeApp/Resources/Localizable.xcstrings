    "cad.merge.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare two copies from a shared design version, then choose what to merge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从共同的设计版本比较两个副本，再选择要合并的改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從共同的設計版本比較兩個副本，再選擇要合併的改動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されたデザインバージョンから2つのコピーを比較し、統合する対象を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 디자인 버전에서 두 복사본을 비교한 후, 병합할 항목을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez deux copies d'une version de conception partagée, puis choisissez ce qu'il faut fusionner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie zwei Kopien einer gemeinsamen Designversion und wählen Sie dann aus, was zusammengeführt werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare dos copias de una versión de diseño compartido, luego elija qué fusionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare duas cópias de uma versão de design compartilhada e escolha o que mesclar."
          }
        }
      }
    },
    "cad.merge.invalidHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feature history is not valid."
