    "settings.apple_capabilities_settings_view.the_switches_here_only_decide_whether": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The switches here only decide whether Floe exposes capabilities to the model and do not replace iOS permissions. System permissions, local paths, Face ID and Home data are not synced across devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的开关只决定 Floe 是否向模型提供能力，不会替代 iOS 权限。系统权限、本机路径、Face ID 和 Home 数据不会跨设备同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡的開關只決定 Floe 是否向模型提供能力，不會替代 iOS 許可權。系統許可權、本機路徑、Face ID 和 Home 資料不會跨裝置同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにあるスイッチは、Floe がモデルに対して機能を公開するかどうかのみを決定し、iOS の権限を置き換えるものではありません。 システム権限、ローカルパス、Face ID、ホームデータはデバイス間で同期されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기의 스위치는 Floe가 모델에 기능을 노출하는지 여부를 결정할 뿐이며 iOS 권한을 대체하지 않습니다. 시스템 권한, 로컬 경로, Face ID 및 홈 데이터가 기기 간에 동기화되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commutateurs ici ne décident que si Floe expose les capacités du modèle et ne remplacent pas les autorisations iOS. Les autorisations système, les chemins locaux, Face ID et les données Home ne sont pas synchronisés entre les appareils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schalter entscheiden hier nur, ob Floe Funktionen für das Modell verfügbar macht, und ersetzen nicht die iOS-Berechtigungen. Systemberechtigungen, lokale Pfade, Face ID und Home-Daten werden nicht geräteübergreifend synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los interruptores aquí solo deciden si Floe expone las capacidades del modelo y no reemplazan los permisos iOS. Los permisos del sistema, las rutas locales, Face ID y los datos de Home no se sincronizan entre dispositivos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os switches aqui só decidem se o Floe expõe os recursos do modelo e não substituem as permissões do iOS. Permissões do sistema, caminhos locais, dados do Face ID e Home não são sincronizados entre os dispositivos."
          }
        }
      }
    },
