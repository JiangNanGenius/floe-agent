      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote run timed out and the SSH connection was closed; the remote process exit and cleanup trap are not confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程运行超时，已断开 SSH 连接；无法确认远端进程是否退出或清理陷阱是否运行。"
          }
