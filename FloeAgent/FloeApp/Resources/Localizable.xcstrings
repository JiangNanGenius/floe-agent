        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result may have expired. Confirm billing before generating again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果可能已过期，可确认计费后重新生成"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果可能已過期，可確認計費後重新生成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果が期限切れになっている可能性があります。 再度生成する前に、請求内容をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과가 만료되었을 수 있습니다. 다시 생성하기 전에 청구를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat a peut-être expiré. Confirmez la facturation avant de générer à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis ist möglicherweise abgelaufen. Bestätigen Sie die Abrechnung, bevor Sie sie erneut generieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado puede haber caducado. Confirme la facturación antes de volver a generarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado pode ter expirado. Confirme o faturamento antes de gerar novamente."
          }
        }
      }
    },
