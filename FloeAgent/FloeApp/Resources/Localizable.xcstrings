    "envmgr.empty_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a workspace, or run a local tool in a conversation, and its environment appears here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开工作区，或在会话中运行本地工具后，对应环境会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟工作區，或在會話中執行本地工具後，對應環境會出現在這裡。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースを開くか、会話内でローカルツールを実行すると、その環境がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 열거나 대화 중에 로컬 도구를 실행하면 해당 환경이 여기 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un espace de travail, ou exécutez un outil local dans une conversation, et son environnement apparaît ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie einen Arbeitsbereich oder führen Sie ein lokales Tool in einer Unterhaltung aus, und seine Umgebung wird hier angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra un espacio de trabajo o ejecute una herramienta local en una conversación, y su entorno aparecerá aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um espaço de trabalho ou execute uma ferramenta local em uma conversa, e seu ambiente aparecerá aqui."
          }
        }
      }
    },
