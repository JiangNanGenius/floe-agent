    "app.bilingual.d641e2c557d11f10": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次可编辑最多 20,000 个字符。相交注释和测量质量值会失效，原件保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit up to 20,000 symbols per range. Overlapping annotations and quality measurements are invalidated; originals are retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次可編輯最多 20,000 個字元。相交註釋和測量質量值會失效，原件保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲ごとに最大20,000文字まで編集できます。 重複する注釈および品質測定は無効となり、原本は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위당 최대 20,000개의 기호를 편집합니다. 겹치는 주석 및 품질 측정은 무효화되며, 원본은 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez jusqu'à 20 000 symboles par plage. Les annotations qui se chevauchent et les mesures de qualité sont invalidées ; les originaux sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeiten Sie bis zu 20.000 Symbole pro Bereich. Überlappende Anmerkungen und Qualitätsmessungen werden ungültig; Originale bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita hasta 20.000 símbolos por rango. Las anotaciones superpuestas y las mediciones de calidad se invalidan; los originales se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edite até 20.000 símbolos por intervalo. Anotações sobrepostas e medições de qualidade são invalidadas; os originais são mantidos."
          }
        }
      }
    },
    "app.bilingual.56ff3d7968222e2e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此记录"
          }
        },
        "en": {
