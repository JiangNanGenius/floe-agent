    "cad.error.faceSourceUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original shape could not be reopened. Check the earlier steps and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新打开原始形状，请检查先前的步骤后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新開啟原始形狀，請檢查先前的步驟後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の形状を再度開くことができませんでした。 以前の手順を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 형태를 다시 열 수 없습니다. 이전 단계를 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme originale n'a pas pu être rouverte. Vérifiez les étapes précédentes et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Form konnte nicht wieder geöffnet werden. Überprüfen Sie die vorherigen Schritte und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma original no se pudo volver a abrir. Comprueba los pasos anteriores e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma original não pôde ser reaberta. Verifique as etapas anteriores e tente novamente."
          }
        }
      }
    },
    "cad.error.shellCurvedNeedsSolid": {
