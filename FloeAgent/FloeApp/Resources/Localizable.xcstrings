          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête cette course exacte ; les courses ultérieures ne sont pas affectées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt genau diesen Lauf; spätere Läufe sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene esta carrera exacta; las carreras posteriores no se ven afectadas."
