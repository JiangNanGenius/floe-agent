        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が中断されました。再試行する前にファイルをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊어졌습니다; 재시도하기 전에 파일을 확인하십시오."
