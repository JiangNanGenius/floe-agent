    "app.bilingual.b940b7fe539a2ced": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试听不会更改工程。应用音色后自动保存，可撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auditioning does not change the project. Applying a preset saves automatically and can be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試聽不會更改工程。應用音色後自動儲存，可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディションはプロジェクトを変更しません。 プリセットを適用すると自動的に保存され、元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디션은 프로젝트를 변경하지 않습니다. 프리셋을 적용하면 자동으로 저장되며 취소할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audition ne change pas le projet. L'application d'un préréglage enregistre automatiquement et peut être défaite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Vorsprechen ändert nichts am Projekt. Das Anwenden einer Voreinstellung wird automatisch gespeichert und kann rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La audición no cambia el proyecto. La aplicación de un preajuste se guarda automáticamente y se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A audição não muda o projeto. Aplicar uma predefinição salva automaticamente e pode ser desfeito."
          }
        }
      }
    },
