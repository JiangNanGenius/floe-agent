    "cad.workbench.assembly.newSubassemblyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Place parts inside it afterwards; the subassembly keeps its own local mates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后再放入零件；子装配会保留自己的局部配合。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後再放入零件；子裝配會保留自己的區域性配合。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後、部品を内部に配置してください；サブアセンブリは独自のローカルメイトを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 후에 부품을 그 안에 배치하십시오; 서브 어셈블리는 자체 로컬 메이트를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez les pièces à l'intérieur par la suite ; le sous-ensemble garde ses propres compagnons locaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie danach Teile hinein; die Unterbaugruppe behält ihre eigenen lokalen Partner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque las piezas dentro de él después; el subconjunto mantiene sus propios compañeros locales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque as peças dentro dele depois; a submontagem mantém seus próprios companheiros locais."
          }
        }
      }
    },
