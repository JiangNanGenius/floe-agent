    "app.bilingual.792ac8fd16c80bba": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用大写字母、数字和下划线，并以字母开头，例如 API_BASE_URL。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uppercase letters, numbers and underscores; start with a letter. Example: API_BASE_URL."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用大寫字母、數字和下劃線，並以字母開頭，例如 API_BASE_URL。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大文字、数字、アンダースコアを使用してください。文字から始めてください。 例: API_BASE_URL."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대문자, 숫자 및 밑줄을 사용하십시오; 문자부터 시작하십시오. 예시: API_BASE_URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des lettres majuscules, des chiffres et des traits de soulignement ; commencez par une lettre. Exemple : API_BASE_URL."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Großbuchstaben, Zahlen und Unterstriche; beginnen Sie mit einem Buchstaben. Beispiel: API_BASE_URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letras mayúsculas, números y guiones bajos; comience con una letra. Ejemplo: API_BASE_URL."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letras maiúsculas, números e sublinhados; comece com uma letra. Exemplo: API_BASE_URL."
          }
        }
      }
    },
