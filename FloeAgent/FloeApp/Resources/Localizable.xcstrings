    "mail.settings.remove_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes local settings and credentials only. Mail on the server is not deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅移除本机配置和凭据，不删除服务器邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅移除本機配置和憑據，不刪除伺服器郵件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル設定と認証情報のみを削除します。 サーバー上のメールは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 설정 및 자격 증명만 제거합니다. 서버의 메일이 삭제되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime uniquement les paramètres locaux et les informations d'identification. Le courrier sur le serveur n'est pas supprimé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt nur lokale Einstellungen und Anmeldeinformationen. E-Mails auf dem Server werden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina solo la configuración local y las credenciales. El correo en el servidor no se elimina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove apenas configurações e credenciais locais. O e-mail no servidor não é excluído."
          }
        }
      }
    },
    "mail.settings.test": {
