    "background.pip_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Picture-in-Picture is not enabled in this version: choosing it uses a regular background task instead, which can resume the work when you return."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未启用状态画中画：选择画中画时会改用普通后台任务，并可在返回时恢复工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本未啟用狀態畫中畫：選擇畫中畫時會改用普通後臺任務，並可在返回時恢復工作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンではステータス・ピクチャー・イン・ピクチャーは有効になっておらず、選択すると通常のバックグラウンドタスクが使用され、戻ってきた際に作業を再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전에서는 상태 화면 내 화면이 활성화되어 있지 않으며, 이를 선택하면 대신 일반 백그라운드 작업을 사용하고, 돌아오면 작업을 재개할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le statut Picture-in-Picture n'est pas activé dans cette version : en le choisissant, il utilise plutôt une tâche d'arrière-plan régulière, qui peut reprendre le travail à votre retour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status Picture-in-Picture ist in dieser Version nicht aktiviert: Wenn Sie es auswählen, verwenden Sie stattdessen eine normale Hintergrundaufgabe, die die Arbeit fortsetzen kann, wenn Sie zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado Picture-in-Picture no está habilitado en esta versión: elegirlo utiliza una tarea de fondo normal, que puede reanudar el trabajo cuando regrese."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status Picture-in-Picture não está ativado nesta versão: escolhê-lo usa uma tarefa em segundo plano regular, que pode retomar o trabalho quando você retornar."
          }
        }
      }
    },
    "background.run.cancelled_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task stopped; its checkpoint is preserved and it can be restarted or resumed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务已停止，检查点已保留，可重新开始或继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務已停止，檢查點已保留，可重新開始或繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクは停止しました。そのチェックポイントは保持され、再起動または再開が可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 중단되었습니다; 체크포인트가 유지되며 재시작하거나 재개할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche s'est arrêtée ; son point de contrôle est préservé et elle peut être redémarrée ou reprise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe wurde gestoppt; ihr Kontrollpunkt bleibt erhalten und kann neu gestartet oder fortgesetzt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea se detuvo; su punto de control se conserva y se puede reiniciar o reanudar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa parou; seu ponto de verificação é preservado e pode ser reiniciado ou retomado."
          }
        }
      }
    },
    "background.run.failure_body": {
      "localizations": {
        "en": {
