    "cad.workbench.assembly.sourceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The instance places the chosen body; “Independent copy” duplicates it instead of sharing it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实例放置所选实体；“独立副本”会复制该实体而不是共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例項放置所選實體；“獨立副本”會複製該實體而不是共享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスタンスは選択されたボディを配置します。「Independent copy」は共有する代わりにそれを複製します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인스턴스는 선택된 본문을 배치합니다; “Independent copy”는 공유하지 않고 복제합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'instance place le corps choisi ; \"Copie indépendante\" le duplique au lieu de le partager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Instanz platziert den ausgewählten Körper; \"Unabhängige Kopie\" dupliziert ihn, anstatt ihn zu teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instancia coloca el cuerpo elegido; \"Copia independiente\" lo duplica en lugar de compartirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instância coloca o corpo escolhido; “Cópia independente” o duplica em vez de compartilhá-lo."
          }
        }
      }
    },
