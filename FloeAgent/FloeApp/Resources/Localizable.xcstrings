    "app.bilingual.874d9381d35d32b4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立预研宿主；尚未接入主 App。工业精度、双主轴和多刀塔分别记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Independent research host; main App integration, industrial accuracy, dual spindles and multiple turrets are separate milestones."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨立預研宿主；尚未接入主 App。工業精度、雙主軸和多刀塔分別記錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した研究ホスト；主要なアプリ統合、産業用精度、デュアルスピンドルと複数タレットは別々のマイルストーンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립 연구 호스트; 주요 앱 통합, 산업용 정확도, 듀얼 스핀들 및 다중 터렛은 별개의 이정표입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôte de recherche indépendant ; intégration de l'application principale, précision industrielle, double broches et tourelles multiples sont des jalons distincts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unabhängiger Forschungsgeber; Haupt-App-Integration, industrielle Genauigkeit, zwei Spindeln und mehrere Türme sind separate Meilensteine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfitrión de investigación independiente; integración de la aplicación principal, precisión industrial, husillos dobles y múltiples torretas son hitos separados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfitrião de pesquisa independente; integração de aplicativos principais, precisão industrial, fusos duplos e várias torres são marcos separados."
          }
        }
      }
    },
