      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import wall centre lines from a DWG/DXF plan, or draw a wall."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 DWG／DXF 平面图导入墙中心线，或直接绘制墙体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
