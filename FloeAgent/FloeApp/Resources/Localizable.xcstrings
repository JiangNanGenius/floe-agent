          "stringUnit": {
            "state": "translated",
            "value": "Use dimensões de construção finitas e positivas em milímetros."
          }
        }
      }
    },
    "cad.building.error.aFloorRoofOrSpaceNeedsTwo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A floor, roof or space needs two opposite rectangle corners."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "楼板、屋顶或空间需要矩形的两个对角点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "樓板、屋頂或空間需要矩形的兩個對角點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床、屋根、または空間には、2つの対向する長方形の角が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥, 지붕 또는 공간은 두 개의 반대쪽 직사각형 모서리가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un sol, un toit ou un espace a besoin de deux coins rectangulaires opposés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Boden, Dach oder Raum benötigt zwei gegenüberliegende rechteckige Ecken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piso, techo o espacio necesita dos esquinas rectangulares opuestas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um piso, telhado ou espaço precisa de dois cantos retangulares opostos."
          }
        }
      }
    },
    "cad.building.error.use264StairSteps": {
      "localizations": {
        "en": {
