    "app.bilingual.a4ea4f30e5a6e1af": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些工具各自保存机床或分析设置，不会替换当前 CAD 模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These tools save their own machine or analysis setup and do not replace the current CAD model."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些工具各自儲存機床或分析設定，不會替換當前 CAD 模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのツールは独自のマシンまたは分析設定を保存し、現在の CAD モデルを置き換えるものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 도구들은 자체 기계 또는 분석 설정을 저장하며 현재 CAD 모델을 대체하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces outils enregistrent leur propre machine ou configuration d'analyse et ne remplacent pas le modèle actuel CAD."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tools speichern ihre eigene Maschinen- oder Analyseeinrichtung und ersetzen nicht das aktuelle CAD-Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas herramientas guardan su propia máquina o configuración de análisis y no reemplazan el modelo actual de CAD."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas ferramentas salvam sua própria configuração de máquina ou análise e não substituem o modelo atual do CAD."
          }
        }
      }
    },
