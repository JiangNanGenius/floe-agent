    "app.bilingual.33848164285ac71b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入带四面体体网格的配置可分析自己的工件。表面 STL 不会自动变成体网格。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a setup with a tetrahedral volume mesh to analyze your own part. A surface STL is not automatically converted into a volume mesh."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入帶四面體體網格的配置可分析自己的工件。表面 STL 不會自動變成體網格。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テトラヘドラルボリュームメッシュを備えたセットアップをインポートし、ご自身の部品を解析してください。 表面STLは自動的にボリュームメッシュに変換されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 파트를 분석하기 위해 사면체 부피 메쉬가 포함된 설정을 가져오십시오. 표면 STL은 자동으로 볼륨 메시로 변환되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez une configuration avec un maillage de volume tétraédrique pour analyser votre propre pièce. Un STL de surface n'est pas automatiquement converti en maille de volume."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie ein Setup mit einem tetraedrischen Volume Mesh, um Ihr eigenes Teil zu analysieren. Ein Oberflächen-STL wird nicht automatisch in ein Volumennetz umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe una configuración con una malla de volumen tetraédrica para analizar su propia parte. Un STL de superficie no se convierte automáticamente en una malla de volumen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma configuração com uma malha de volume tetraédrica para analisar sua própria parte. Um STL de superfície não é automaticamente convertido em uma malha de volume."
          }
        }
      }
    },
