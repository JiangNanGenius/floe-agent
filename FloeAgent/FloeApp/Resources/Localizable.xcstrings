    "app.bilingual.3a463ade065a034c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前引擎是手动选择，没有识别依据。请在工程设置中确认识别到的引擎后再运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine is a manual choice without recognized evidence. Confirm a recognized engine in project setup before running."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前引擎是手動選擇，沒有識別依據。請在工程設定中確認識別到的引擎後再執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンジンは、認められた証拠のない手動選択です。 実行する前に、プロジェクト設定で認識されたエンジンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔진은 인정된 증거가 없는 수동 선택입니다. 실행하기 전에 프로젝트 설정에서 인식된 엔진을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur est un choix manuel sans preuve reconnue. Confirmez un moteur reconnu dans la configuration du projet avant de l'exécuter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Motor ist eine manuelle Auswahl ohne erkennbare Beweise. Bestätigen Sie eine erkannte Engine in der Projekteinrichtung, bevor Sie sie ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor es una elección manual sin evidencia reconocida. Confirme un motor reconocido en la configuración del proyecto antes de ejecutarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor é uma escolha manual sem evidências reconhecidas. Confirme um mecanismo reconhecido na configuração do projeto antes de executar."
          }
        }
      }
    },
    "app.bilingual.d4a5865879a523fd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有确认可运行的游戏目录和引擎。请在工程设置中选择或导入后再运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No runnable game folder and engine are confirmed. Choose or import one in project setup before running."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有確認可執行的遊戲目錄和引擎。請在工程設定中選擇或匯入後再執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行可能なゲームフォルダーおよびエンジンは確認されていません。 実行する前に、プロジェクト設定で選択するかインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 가능한 게임 폴더와 엔진이 확인되지 않았습니다. 실행하기 전에 프로젝트 설정에서 하나를 선택하거나 가져오십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier de jeu exécutable et moteur n'est confirmé. Choisissez ou importez-en un dans la configuration du projet avant l'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein auslaufbarer Spielordner und keine Engine sind bestätigt. Wählen oder importieren Sie eines in der Projekteinrichtung, bevor Sie es ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se confirma ninguna carpeta de juego ejecutable ni motor. Elija o importe uno en la configuración del proyecto antes de ejecutarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pasta e mecanismo de jogo executáveis são confirmados. Escolha ou importe um na configuração do projeto antes de executar."
          }
        }
      }
    },
