            "state": "translated",
            "value": "O resultado do download do provedor foi um arquivo vazio."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_provider_reported_completion_but_returned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider reported completion but returned no downloadable video URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商报告完成，但没有返回可下载的视频地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商報告完成，但沒有返回可下載的影片地址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーは完了を報告しましたが、ダウンロード可能な動画のURLは返されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자는 완료를 보고했지만 다운로드 가능한 비디오 URL을 반환하지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a signalé l'achèvement, mais n'a renvoyé aucune URL vidéo téléchargeable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter meldete den Abschluss, gab aber keine herunterladbare Video-URL zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor informó de la finalización, pero no devolvió ninguna URL de vídeo descargable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor relatou a conclusão, mas não retornou nenhum URL de vídeo para download."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_provider_returned_an_insecure_download": {
      "extractionState": "manual",
