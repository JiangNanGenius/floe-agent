    "design.owner.generate_original_revision_unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original owner revision of this generation could not be read, so the retained result cannot be bound automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此次生成的原始所有者修订，无法自动绑定已保留的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此次生成的原始所有者修訂，無法自動繫結已保留的結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この世代の元の所有者リビジョンを読み取ることができなかったため、保持された結果は自動的にバインドできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세대의 원본 소유자 리비전을 읽을 수 없으므로, 보존된 결과를 자동으로 바인딩할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La révision du propriétaire d'origine de cette génération n'a pas pu être lue, de sorte que le résultat conservé ne peut pas être lié automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ursprüngliche Eigentümerrevision dieser Generation konnte nicht gelesen werden, daher kann das beibehaltene Ergebnis nicht automatisch gebunden werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión del propietario original de esta generación no se pudo leer, por lo que el resultado retenido no se puede encuadernar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão original do proprietário desta geração não pôde ser lida, portanto, o resultado retido não pode ser vinculado automaticamente."
          }
        }
      }
    },
