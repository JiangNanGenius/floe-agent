    "settings.data_management_view.vm_disk_capacity_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparent size mixes disk images and other files; it is not the configured guest capacity, and guest-used space is only measurable inside the running guest."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表面大小混合了磁盘镜像与其他文件，并非客户机配置容量；客户机已用空间只能在客户机运行时测量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "表面大小混合了磁碟映象與其他檔案，並非客戶機配置容量；客戶機已用空間只能在客戶機執行時測量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見かけ上のサイズはディスクイメージと他のファイルが混在しており、設定されたゲスト容量ではなく、ゲストが使用するスペースは実行中のゲスト内部でのみ測定可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면 크기가 디스크 이미지와 기타 파일을 혼합합니다; 이는 구성된 게스트 용량이 아니며, 게스트 사용 공간은 실행 중인 게스트 내부에서만 측정 가능합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille apparente mélange les images de disque et d'autres fichiers ; ce n'est pas la capacité d'invité configurée, et l'espace utilisé par l'invité n'est mesurable qu'à l'intérieur de l'invité en cours d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die scheinbare Größe mischt Disk-Images und andere Dateien; es ist nicht die konfigurierte Gastkapazität, und der vom Gast genutzte Speicherplatz ist nur im laufenden Gast messbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño aparente mezcla imágenes de disco y otros archivos; no es la capacidad de invitado configurada, y el espacio utilizado por el invitado solo es medible dentro del invitado en ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho aparente mistura imagens de disco e outros arquivos; não é a capacidade do convidado configurada, e o espaço usado pelo convidado só é mensurável dentro do convidado em execução."
          }
        }
      }
    },
