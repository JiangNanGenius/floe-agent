    "websearch.volcengine.error.dataProConflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing MCP connection at the reserved DataPro identity has different settings. Rename or remove it before enabling professional datasets."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预留的专业数据集 MCP 标识已被其他连接占用且配置不同。请先重命名或移除该连接再开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預留的專業資料集 MCP 標識已被其他連線佔用且配置不同。請先重新命名或移除該連線再開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約されたDataPro IDにある既存のMCP接続は、設定が異なります。 プロフェッショナルデータセットを有効にする前に、名前を変更するか削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 DataPro ID에 있는 기존 MCP 연결은 설정이 다릅니다. 전문 데이터 세트를 활성화하기 전에 이름을 바꾸거나 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une connexion MCP existante à l'identité DataPro réservée a des paramètres différents. Renommez-le ou supprimez-le avant d'activer les ensembles de données professionnels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine bestehende MCP-Verbindung an der reservierten DataPro-Identität hat andere Einstellungen. Umbenennen oder entfernen Sie es, bevor Sie professionelle Datensätze aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conexión MCP existente en la identidad reservada de DataPro tiene diferentes configuraciones. Renombrarlo o eliminarlo antes de habilitar los conjuntos de datos profesionales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conexão MCP existente na identidade DataPro reservada tem configurações diferentes. Renomee ou remova-o antes de habilitar conjuntos de dados profissionais."
          }
        }
      }
    },
