    "localmodels.local_model_catalog.the_download_failed_the_security_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download failed the security check; installation was stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容未通过安全检查，已停止安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載內容未透過安全檢查，已停止安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードはセキュリティチェックに失敗し、インストールは停止されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 보안 검사를 통과하지 못했으며, 설치가 중단되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement a échoué au contrôle de sécurité ; l'installation a été arrêtée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download hat die Sicherheitsüberprüfung nicht bestanden; die Installation wurde gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no pasó la comprobación de seguridad; la instalación se detuvo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download falhou na verificação de segurança; a instalação foi interrompida."
          }
        }
      }
    },
    "localmodels.local_model_catalog.the_downloaded_model_files_are_incomplete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded model files are incomplete or incompatible; delete them and download again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的模型文件不完整或不兼容，请删除后重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載的模型檔案不完整或不相容，請刪除後重新下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたモデルファイルは不完全または互換性がありません。削除して、再度ダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델 파일이 불완전하거나 호환되지 않습니다; 파일을 삭제하고 다시 다운로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de modèle téléchargés sont incomplets ou incompatibles ; supprimez-les et téléchargez-les à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heruntergeladenen Modelldateien sind unvollständig oder nicht kompatibel; löschen Sie sie und laden Sie sie erneut herunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del modelo descargados están incompletos o son incompatibles; elimínelos y descárguelos de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do modelo baixados estão incompletos ou incompatíveis; exclua-os e baixe-os novamente."
          }
        }
      }
    },
    "localmodels.local_model_catalog.the_downloaded_model_files_cannot_be": {
