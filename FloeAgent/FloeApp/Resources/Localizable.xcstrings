    "cad.versions.outcome.restoredBranch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored “%@” at revision %d and created the branch checkpoint “%@”. The previous design is saved as a recovery version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复“%@”，修订 %d，并创建分支检查点“%@”。之前的设计已保存为恢复版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢復“%@”，修訂 %d，並建立分支檢查點“%@”。之前的設計已儲存為恢復版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リビジョン %2$d で “%1$@” を復元し、ブランチチェックポイント “%3$@” を作成しました。 以前のデザインはリカバリ版として保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”를 %d 개정에서 복원하고 분기 체크포인트 “%@”를 생성했습니다. 이전 디자인은 복구 버전으로 저장됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration de \"%@\" à la révision %d et créé le point de contrôle de la branche \"%@\". La conception précédente est enregistrée en tant que version de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellung von \"%@\" bei Revision %d und Erstellung des Zweig-Checkpoints \"%@\". Das vorherige Design wird als Wiederherstellungsversion gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauró \"%@\" en la revisión %d y creó el punto de control de la rama \"%@\". El diseño anterior se guarda como una versión de recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurou “%@” na revisão %d e criou o ponto de verificação da filial “%@”. O design anterior é salvo como uma versão de recuperação."
          }
        }
      }
    },
    "cad.versions.error.branch": {
