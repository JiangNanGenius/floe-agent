    "cad.paint.bakeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computes mesh occlusion with hemisphere rays and multiplies it into the current color texture. GLB carries the resulting color image. Repeating the bake darkens the existing result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以半球射线计算网格遮蔽，并乘入当前颜色纹理。GLB 保留结果图像；重复烘焙会进一步加深已有结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以半球射線計算網格遮蔽，並乘入當前顏色紋理。GLB 保留結果影象；重複烘焙會進一步加深已有結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半球光線によるメッシュオクルージョンを計算し、現在の色テクスチャに乗算します。 GLBは結果として得られたカラー画像を保持します。 焼成を繰り返すと、既存の結果が暗くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반구 광선을 사용하여 메쉬 오클루전을 계산하고 이를 현재 색상 텍스처로 곱합니다. GLB는 결과 컬러 이미지를 제공합니다. 베이킹을 반복하면 기존 결과가 어두워집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcule l'occlusion du maillage avec les rayons de l'hémisphère et la multiplie dans la texture de couleur actuelle. GLB porte l'image couleur résultante. Répéter la cuisson assombrit le résultat existant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechnet den Netzverschluss mit Hemisphärenstrahlen und multipliziert sie in die aktuelle Farbstruktur. GLB trägt das resultierende Farbbild. Die Wiederholung des Backens verdunkelt das bestehende Ergebnis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula la oclusión de la malla con los rayos hemisféricos y la multiplica en la textura de color actual. GLB lleva la imagen en color resultante. Repetir el horneado oscurece el resultado existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Calcula a oclusão da malha com raios hemisférios e a multiplica na textura de cor atual. O GLB carrega a imagem colorida resultante. Repetir o cozimento escurece o resultado existente."
          }
        }
      }
    },
    "cad.paint.bakeBudget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AO baking supports textures up to 256 × 256 pixels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AO 烘焙支持最大 256 × 256 像素纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AO 烘焙支援最大 256 × 256 畫素紋理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AOベーキングは、最大256×256ピクセルのテクスチャをサポートしています。"
          }
        },
        "ko": {
