    "app.bilingual.9bcfef91f35691bc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留模型坐标。文件不含可靠单位时按上方选择换算。OBJ 需已三角化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model coordinates are preserved. The selected unit controls conversion. OBJ faces must be triangulated."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留模型座標。檔案不含可靠單位時按上方選擇換算。OBJ 需已三角化。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの座標は保存されています。 選択されたユニットは変換を制御します。 OBJ の面は三角測量しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 좌표가 보존됩니다. 선택된 단위는 변환을 제어합니다. OBJ 면은 삼각측광이어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coordonnées du modèle sont conservées. L'unité sélectionnée contrôle la conversion. Les visages OBJ doivent être triangulés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellkoordinaten bleiben erhalten. Das ausgewählte Gerät steuert die Konvertierung. OBJ-Seiten müssen trianguliert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las coordenadas del modelo se conservan. La unidad seleccionada controla la conversión. Las caras de OBJ deben estar trianguladas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As coordenadas do modelo são preservadas. A unidade selecionada controla a conversão. Os rostos OBJ devem ser triangulares."
          }
        }
      }
    },
