    "cad.hole.circleHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position and diameter come from the placement circle. Edit that circle to move or resize the hole."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置与孔径由定位圆决定。编辑该圆即可移动或调整孔。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置與孔徑由定位圓決定。編輯該圓即可移動或調整孔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置と直径は配置円から来ます。 その円を編集して、穴を移動またはサイズ変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치와 직경은 배치 원에서 비롯됩니다. 그 원을 편집하여 구멍을 이동하거나 크기를 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position et le diamètre proviennent du cercle de placement. Modifiez ce cercle pour déplacer ou redimensionner le trou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Position und Durchmesser kommen aus dem Platzierungskreis. Bearbeiten Sie diesen Kreis, um das Loch zu verschieben oder die Größe zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición y el diámetro vienen del círculo de colocación. Edite ese círculo para mover o cambiar el tamaño del agujero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A posição e o diâmetro vêm do círculo de colocação. Edite esse círculo para mover ou redimensionar o buraco."
          }
        }
      }
    },
