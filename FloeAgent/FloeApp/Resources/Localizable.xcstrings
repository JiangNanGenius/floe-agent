    "hosts.host_editor_view.ble_serial_uses_the_device_s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE serial uses the device's public GATT services; classic Bluetooth SPP only works with vendor-enabled MFi accessories."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE 串口使用设备公开的 GATT 服务；传统蓝牙 SPP 仅适用于厂商开放的 MFi 配件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE 串列埠使用裝置公開的 GATT 服務；傳統藍芽 SPP 僅適用於廠商開放的 MFi 配件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BLEシリアルはデバイスのパブリックGATTサービスを使用します；クラシックBluetooth SPPはベンダー対応のMFiアクセサリでのみ動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BLE 시리얼은 장치의 공용 GATT 서비스를 사용합니다; 클래식 Bluetooth SPP는 공급업체가 지원되는 MFi 액세서리와만 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La série BLE utilise les services publics du GATT de l'appareil ; le Bluetooth SPP classique ne fonctionne qu'avec les accessoires MFi compatibles avec le fournisseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die BLE-Serie nutzt die öffentlichen GATT-Dienste des Geräts; der klassische Bluetooth SPP funktioniert nur mit herstellerfähigem MFi-Zubehör."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La serie BLE utiliza los servicios públicos de GATT del dispositivo; el clásico Bluetooth SPP solo funciona con accesorios MFi habilitados para el proveedor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A série BLE usa os serviços públicos do GATT do dispositivo; o clássico Bluetooth SPP só funciona com acessórios MFi habilitados pelo fornecedor."
          }
        }
      }
    },
