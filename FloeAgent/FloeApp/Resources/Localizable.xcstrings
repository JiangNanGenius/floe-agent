    "app.game_runtime_resource_registry.the_source_accompaniment_catalog_is": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对应源码目录未随 App 打包，无法验证当前发布状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source-accompaniment catalog is not bundled, so its publication state cannot be verified."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對應原始碼目錄未隨 App 打包，無法驗證當前釋出狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソース付随カタログはバンドルされていないため、その出版状態を検証できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 동반 카탈로그가 번들되지 않아 해당 출판 상태를 확인할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue d'accompagnement source n'est pas groupé, de sorte que son état de publication ne peut pas être vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Quellbegleitungskatalog ist nicht gebündelt, so dass sein Veröffentlichungsstatus nicht überprüft werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo de acompañamiento de fuentes no está incluido, por lo que su estado de publicación no se puede verificar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O catálogo de acompanhamento de origem não é agrupado, portanto, seu estado de publicação não pode ser verificado."
          }
        }
      }
    },
    "app.game_runtime_resource_registry.install_and_verify_the_base": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先安装并验证该引擎的基础运行资源，才能导入用户重建组件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install and verify the base runtime resources before importing a user-rebuilt component."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先安裝並驗證該引擎的基礎執行資源，才能匯入使用者重建元件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが再構築したコンポーネントをインポートする前に、ベースランタイムリソースをインストールし、検証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 재구축 컴포넌트를 가져오기 전에 기본 런타임 리소스를 설치하고 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez et vérifiez les ressources d'exécution de base avant d'importer un composant reconstruit par l'utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren und überprüfen Sie die Basis-Laufzeitressourcen, bevor Sie eine vom Benutzer neu erstellte Komponente importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale y verifique los recursos de tiempo de ejecución base antes de importar un componente reconstruido por el usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale e verifique os recursos de tempo de execução base antes de importar um componente reconstruído pelo usuário."
          }
        }
      }
    },
