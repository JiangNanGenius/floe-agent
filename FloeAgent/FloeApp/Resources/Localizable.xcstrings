    "cad.datum.hingeHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The plane rotates about this in-plane axis through the source face anchor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平面绕穿过来源面锚点的该平面内轴旋转。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "平面繞穿過來源面錨點的該平面內軸旋轉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平面は、ソースフェイスアンカーを介して、このインプレーン軸を中心に回転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평면은 원본 면 앵커를 통해 이 평면 내 축을 중심으로 회전합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan tourne autour de cet axe dans le plan à travers l'ancre de la face de la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ebene dreht sich um diese In-Plane-Achse durch den Quellflächenanker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plano gira alrededor de este eje en el plano a través del anclaje de la cara de la fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gira em torno deste eixo no plano através da âncora da face da fonte."
          }
        }
      }
    },
