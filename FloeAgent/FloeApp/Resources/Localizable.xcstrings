    "design.owner.creative_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request (goal, audience and requested output type) is saved before any material exists. Generate the first result with the existing media tools, then continue with feedback and candidates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何素材生成之前，先保存需求（目标、受众和请求的输出类型）。请用现有媒体工具生成首个结果，然后继续反馈与候选流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何素材生成之前，先儲存需求（目標、受眾和請求的輸出型別）。請用現有媒體工具生成首個結果，然後繼續反饋與候選流程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエスト（目標、対象者、要求された出力タイプ）は、資料が存在する前に保存されます。 既存のメディアツールで最初の結果を生成し、その後、フィードバックと候補者を続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청(목적, 대상 및 요청된 출력 유형)은 자료가 존재하기 전에 저장됩니다. 기존 미디어 도구를 사용하여 첫 번째 결과를 생성한 후, 피드백 및 후보를 계속 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La demande (cible, public et type de sortie demandé) est enregistrée avant que tout matériel n'existe. Générez le premier résultat avec les outils médias existants, puis continuez avec les commentaires et les candidats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anforderung (Ziel, Zielgruppe und angeforderter Ausgabetyp) wird gespeichert, bevor Material vorhanden ist. Generieren Sie das erste Ergebnis mit den vorhandenen Medientools und fahren Sie dann mit Feedback und Kandidaten fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud (destino, audiencia y tipo de salida solicitado) se guarda antes de que exista cualquier material. Genere el primer resultado con las herramientas de medios existentes, luego continúe con comentarios y candidatos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação (meta, público e tipo de saída solicitado) é salva antes que qualquer material exista. Gere o primeiro resultado com as ferramentas de mídia existentes e, em seguida, continue com feedback e candidatos."
          }
        }
      }
    },
