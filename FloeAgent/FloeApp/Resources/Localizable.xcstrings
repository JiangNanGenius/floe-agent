    "app.bilingual.40ff7b245a6657be": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相交 A/C 转台运动链。刀具需要量规长度；超出可达范围会报告错误。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the intersecting A/C table chain. Tools require a gauge length; unreachable poses report an error."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相交 A/C 轉檯運動鏈。刀具需要量規長度；超出可達範圍會報告錯誤。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交差するA/Cテーブルチェーンを使用します。 ツールはゲージの長さが必要です；到達できないポーズはエラーを報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교차하는 A/C 테이블 체인을 사용합니다. 도구는 게이지 길이가 필요합니다; 도달할 수 없는 자세는 오류를 보고합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la chaîne de table A/C qui se croise. Les outils nécessitent une longueur de jauge ; les poses inaccessibles signalent une erreur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die sich kreuzende A/C-Tischkette. Werkzeuge erfordern eine Messlänge; unerreichbare Posen melden einen Fehler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la cadena de la mesa de aire acondicionado que se cruza. Las herramientas requieren una longitud de calibre; las poses inalcanzables informan de un error."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a cadeia de mesa A/C que se cruza. As ferramentas exigem um comprimento de medidor; poses inacessíveis relatam um erro."
          }
        }
      }
    },
    "app.bilingual.292cc60fccce0b5c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换类型会关闭不兼容工序。刀具和工序设置仍保留，可继续调整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing type disables incompatible operations. Tool and operation settings remain available to edit."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換型別會關閉不相容工序。刀具和工序設定仍保留，可繼續調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイプを変更すると、互換性のない操作が無効になります。 ツールと操作設定は引き続き編集可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유형을 변경하면 호환되지 않는 작업이 비활성화됩니다. 도구 및 작업 설정은 여전히 편집할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification du type désactive les opérations incompatibles. Les paramètres de l'outil et de fonctionnement restent disponibles pour la modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ändern des Typs deaktiviert inkompatible Vorgänge. Werkzeug- und Betriebseinstellungen können weiterhin bearbeitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiar el tipo desactiva las operaciones incompatibles. La configuración de la herramienta y la operación permanece disponible para editar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterar o tipo desativa operações incompatíveis. As configurações de ferramenta e operação permanecem disponíveis para edição."
          }
        }
      }
    },
