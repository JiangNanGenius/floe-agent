    "app.bilingual.a8b9756f9e62261c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已有连接中的密码或密钥。首次连接会要求确认主机指纹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the existing connection's password or key. The first connection asks you to verify its fingerprint."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已有連線中的密碼或金鑰。首次連線會要求確認主機指紋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の接続のパスワードまたはキーを使用します。 最初の接続は、指紋の確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 연결의 비밀번호 또는 키를 사용합니다. 첫 번째 연결이 지문을 확인하도록 요청합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le mot de passe ou la clé de la connexion existante. La première connexion vous demande de vérifier son empreinte digitale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet das Passwort oder den Schlüssel der bestehenden Verbindung. Die erste Verbindung fordert Sie auf, ihren Fingerabdruck zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza la contraseña o clave de la conexión existente. La primera conexión te pide que verifiques su huella digital."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa a senha ou chave da conexão existente. A primeira conexão pede que você verifique sua impressão digital."
          }
        }
      }
    },
