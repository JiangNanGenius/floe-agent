    "execution.node_package_manager_policy.enter_an_npm_package_name_optionally": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter an npm package name, optionally with an @version range; paths or Git URLs are not accepted"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入 npm 包名，可附加 @版本范围；不接受路径或 Git URL"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入 npm 包名，可附加 @版本範圍；不接受路徑或 Git URL"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Npm パッケージ名を入力してください。オプションで @version 範囲を指定してください。パスや Git URL は受け付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Npm 패키지 이름을 입력하십시오. 선택적으로 @version 범위를 포함하십시오; 경로나 Git URL은 허용되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un nom de paquet npm, éventuellement avec une plage @version ; les chemins ou les URL Git ne sont pas acceptés"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen npm-Paketnamen ein, optional mit einem @version-Bereich; Pfade oder Git-URLs werden nicht akzeptiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca un nombre de paquete npm, opcionalmente con un rango @version; no se aceptan rutas ni URL de Git"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um nome de pacote npm, opcionalmente com um intervalo @version; caminhos ou URLs Git não são aceitos"
          }
        }
      }
    },
    "execution.node_package_manager_policy.in_managed_environments_use_npm_pnpm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In managed environments use npm/pnpm install or remove; project lock files are not rewritten here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受管理环境请使用 npm/pnpm install 或 remove；项目锁文件不会在这里改写"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受管理環境請使用 npm/pnpm install 或 remove；專案鎖檔案不會在這裡改寫"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理された環境では、npm/pnpm を使用してインストールまたは削除してください。プロジェクトロックファイルはここで書き直されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리된 환경에서는 npm/pnpm을 사용하거나 설치하거나 제거하십시오; 프로젝트 잠금 파일은 여기서 다시 작성되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les environnements gérés, utilisez npm/pnpm install ou remove ; les fichiers de verrouillage du projet ne sont pas réécrits ici"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie in verwalteten Umgebungen npm/pnpm installieren oder entfernen; Projektsperrdateien werden hier nicht neu geschrieben"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En entornos administrados, use npm/pnpm para instalar o eliminar; los archivos de bloqueo del proyecto no se reescriben aquí"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em ambientes gerenciados, use npm/pnpm install ou remove; os arquivos de bloqueio do projeto não são reescritos aqui"
          }
        }
      }
    },
    "execution.node_package_manager_policy.install_location_and_scripts_are_managed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install location and scripts are managed by the environment; this command option is not supported"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装位置和安装脚本由环境管理；不支持此命令选项"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝位置和安裝指令碼由環境管理；不支援此命令選項"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール場所とスクリプトは環境によって管理されています。このコマンドオプションはサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 위치와 스크립트는 환경에 의해 관리됩니다; 이 명령 옵션은 지원되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement d'installation et les scripts sont gérés par l'environnement ; cette option de commande n'est pas prise en charge"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationsstandort und Skripte werden von der Umgebung verwaltet; diese Befehlsoption wird nicht unterstützt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación de instalación y los scripts son administrados por el entorno; esta opción de comando no es compatible"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O local de instalação e os scripts são gerenciados pelo ambiente; esta opção de comando não é suportada"
          }
        }
      }
    },
