    "engineering.review.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes the visible viewport, parsed geometry and text, source hashes, and missing-resource information. Partial renderings do not establish engineering compliance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附上当前画面、解析到的几何与文字、文件版本和缺失资源。局部预览不能替代工程验收。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附上當前畫面、解析到的幾何與文字、檔案版本和缺失資源。區域性預覽不能替代工程驗收。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "可視ビューポート、解析されたジオメトリとテキスト、ソースハッシュ、および欠落リソース情報を含みます。 部分的なレンダリングはエンジニアリングコンプライアンスを確立しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보이는 뷰포트, 파싱된 기하학 및 텍스트, 소스 해시, 그리고 누락된 리소스 정보를 포함합니다. 부분 렌더링은 엔지니어링 규정 준수를 입증하지 못합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprend la fenêtre d'affichage visible, la géométrie et le texte analyse, les hachages source et les informations sur les ressources manquantes. Les rendus partiels n'établissent pas la conformité technique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält das sichtbare Ansichtsfenster, geparste Geometrie und Text, Quell-Hashes und fehlende Ressourceninformationen. Teilweise Renderings stellen keine technische Konformität her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye la ventana gráfica visible, la geometría y el texto analizados, los hashes de origen y la información de recursos que faltan. Las representaciones parciales no establecen el cumplimiento de la ingeniería."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui a janela de visualização visível, geometria e texto analisados, hashes de origem e informações de recursos ausentes. Renderizações parciais não estabelecem conformidade com a engenharia."
          }
        }
      }
    },
