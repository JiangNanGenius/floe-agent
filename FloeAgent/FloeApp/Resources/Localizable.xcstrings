    "setup.features.connections.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable web search, Apple capabilities, remote devices, or standard MCP servers only for the workflows you use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需启用联网搜索、Apple 能力、远程设备或标准 MCP，模型会在任务中组合使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按需啟用聯網搜尋、Apple 能力、遠端裝置或標準 MCP，模型會在任務中組合使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用しているワークフローに対してのみ、ウェブ検索、Apple の機能、リモートデバイス、または標準の MCP サーバーを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검색, Apple 기능, 원격 장치 또는 표준 MCP 서버를 사용하는 워크플로에만 활성화하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la recherche Web, les capacités Apple, les appareils distants ou les serveurs MCP standard uniquement pour les flux de travail que vous utilisez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Websuche, Apple-Funktionen, Remote-Geräte oder Standard-MCP-Server nur für die von Ihnen verwendeten Workflows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite la búsqueda web, las capacidades de Apple, los dispositivos remotos o los servidores estándar MCP solo para los flujos de trabajo que utiliza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite a pesquisa na web, recursos da Apple, dispositivos remotos ou servidores MCP padrão apenas para os fluxos de trabalho que você usa."
          }
        }
      }
    },
    "setup.features.connections.title": {
