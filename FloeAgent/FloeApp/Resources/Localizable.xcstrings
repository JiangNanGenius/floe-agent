    "app.bilingual.bc40cbe448cecf36": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复的终态记录不会自动重新派发；进行中的 CI 句柄只在本进程有效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restored terminal records are not re-dispatched; in-flight CI handles are process-local."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢復的終態記錄不會自動重新派發；進行中的 CI 控制代碼只在本程序有效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元された端末レコードは再ディスパッチされません；インフライトCIハンドルはプロセスローカルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원된 터미널 레코드는 다시 전송되지 않으며, 인‐플라이트 CI 핸들은 프로세스 로컬입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements de terminaux restaurés ne sont pas réexpédiés ; les poignées CI en vol sont locales."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellte Terminaldatensätze werden nicht erneut versandt; Inflight-CI-Handles sind prozesslokal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros de la terminal restaurados no se vuelven a enviar; los controladores de CI en vuelo son locales para el proceso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros de terminais restaurados não são reenviados; os identificadores de CI em voo são locais de processo."
          }
        }
      }
    },
