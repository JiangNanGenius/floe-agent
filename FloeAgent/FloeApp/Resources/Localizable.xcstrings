    "workspace.creative_asset_ingestion_service.the_asset_url_is_not_secure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The asset URL is not secure. Only public HTTPS images are supported; local or private networks cannot be accessed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "素材网址不安全。仅支持公开 HTTPS 图片，不能访问本机或私有网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "素材網址不安全。僅支援公開 HTTPS 圖片，不能訪問本機或私有網路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アセットURLは安全ではありません。 公共のHTTPSイメージのみがサポートされており、ローカルまたはプライベートネットワークへのアクセスはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산 URL이 안전하지 않습니다. 공용 HTTPS 이미지만 지원됩니다; 로컬 또는 사설 네트워크는 접근할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL de l'actif n'est pas sécurisée. Seules les images publiques HTTPS sont prises en charge ; les réseaux locaux ou privés ne sont pas accessibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Asset-URL ist nicht sicher. Nur öffentliche HTTPS-Images werden unterstützt; auf lokale oder private Netzwerke kann nicht zugegriffen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del activo no es segura. Solo se admiten imágenes públicas de HTTPS; no se puede acceder a las redes locales o privadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL do ativo não é segura. Somente imagens públicas HTTPS são suportadas; redes locais ou privadas não podem ser acessadas."
          }
        }
      }
    },
    "workspace.creative_asset_ingestion_service.the_download_is_not_a_supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download is not a supported image, or its dimensions exceed the safety limit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载内容不是受支持的图片，或图片尺寸超过安全限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載內容不是受支援的圖片，或圖片尺寸超過安全限制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードはサポート対象の画像ではないか、サイズが安全限界を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 지원되는 이미지가 아니거나, 그 크기가 안전 제한을 초과했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n'est pas une image prise en charge, ou ses dimensions dépassent la limite de sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download ist kein unterstütztes Bild oder seine Abmessungen überschreiten das Sicherheitslimit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no es una imagen compatible, o sus dimensiones exceden el límite de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não é uma imagem suportada, ou suas dimensões excedem o limite de segurança."
          }
        }
      }
    },
    "workspace.creative_asset_ingestion_service.the_image_server_returned_no_usable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image server returned no usable image response."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片服务器没有返回可用的图片响应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片伺服器沒有返回可用的圖片響應。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イメージサーバーは使用可能な画像応答を返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 서버가 사용 가능한 이미지 응답을 반환하지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur d'images n'a renvoyé aucune réponse d'image utilisable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildserver gab keine verwendbare Bildantwort zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de imágenes no devolvió ninguna respuesta de imagen utilizable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de imagens não retornou nenhuma resposta de imagem utilizável."
          }
        }
      }
    },
    "workspace.creative_asset_ingestion_service.the_reference_asset_has_not_been": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference asset has not been downloaded to this device; reimport it before generating."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考素材尚未下载到本机，请重新导入后再生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考素材尚未下載到本機，請重新匯入後再生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照アセットはこのデバイスにダウンロードされていません。生成する前に再インポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 자산이 이 장치에 다운로드되지 않았습니다; 생성하기 전에 다시 가져오십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'actif de référence n'a pas été téléchargé sur cet appareil ; réimportez-le avant de générer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Referenz-Asset wurde nicht auf dieses Gerät heruntergeladen; importieren Sie es erneut, bevor Sie es generieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El activo de referencia no se ha descargado en este dispositivo; vuelva a importarlo antes de generarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ativo de referência não foi baixado para este dispositivo; importe-o novamente antes de gerar."
          }
        }
      }
    },
    "workspace.creative_asset_ingestion_service.the_reference_image_exceeds_20_mib": {
