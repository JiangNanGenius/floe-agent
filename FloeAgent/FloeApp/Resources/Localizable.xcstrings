    "workspace.i_d_e_language_run_view.stop_was_requested_for_this_remote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop was requested for this remote run; the remote process exit, the SSH client close and the staging cleanup are not confirmed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求停止本次远程运行；无法确认远端进程是否退出、SSH 客户端是否关闭或暂存目录是否已清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已請求停止本次遠端執行；無法確認遠端程序是否退出、SSH 客戶端是否關閉或暫存目錄是否已清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリモート実行では停止が要求されました；リモートプロセスの終了、SSH クライアントのクローズ、およびステージングのクリーンアップは確認されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원격 실행에 대해 중지 요청이 있었습니다; 원격 프로세스 종료, SSH 클라이언트 종료 및 스테이징 정리가 확인되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'arrêt a été demandé pour cette exécution à distance ; la sortie du processus à distance, la fermeture du client SSH et le nettoyage de la mise en scène ne sont pas confirmés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Remote-Auslauf wurde ein Stopp angefordert; der Remote-Prozess beenden, das Schließen des SSH-Clients und die Staging-Bereinigung werden nicht bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitó la parada para esta ejecución remota; la salida del proceso remoto, el cierre del cliente SSH y la limpieza de la puesta en escena no están confirmados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A parada foi solicitada para esta execução remota; a saída do processo remoto, o fechamento do cliente SSH e a limpeza do staging não são confirmados."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.stopped_this_local_run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopped this local run"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
