            "value": "セーブが変更されました。 リストを更新して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장이 변경되었습니다. 목록을 새로 고치고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde a changé. Actualisez la liste et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern hat sich geändert. Aktualisieren Sie die Liste und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El guardado cambió. Actualiza la lista e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O salvamento mudou. Atualize a lista e tente novamente."
          }
        }
      }
    },
