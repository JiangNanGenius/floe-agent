    "app.bilingual.19c7aa59de56cbb6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "候选不会自动替换项目；导入后作为新图层或片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidates never replace the project automatically; import them as a new layer or clip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "候選不會自動替換專案；匯入後作為新圖層或片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "候補者はプロジェクトを自動的に置き換えることはありません。新しいレイヤーまたはクリップとしてインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후보자는 프로젝트를 자동으로 교체하지 않으며, 새 레이어나 클립으로 가져옵니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les candidats ne remplacent jamais le projet automatiquement ; importez-les en tant que nouveau calque ou clip."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidaten ersetzen das Projekt niemals automatisch; importieren Sie sie als neue Ebene oder Clip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los candidatos nunca reemplazan el proyecto automáticamente; los importan como una nueva capa o clip."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os candidatos nunca substituem o projeto automaticamente; importe-os como uma nova camada ou clipe."
          }
        }
      }
    },
