    "notes.notes_answer_save_sheet.keeps_ai_source_and_original_material": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps AI source and original material references. Inserted content can be undone; the new organized note can be moved to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 AI 来源与原资料引用。插入内容可以撤销；新建的整理手记可以移到回收站。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 AI 來源與原資料引用。插入內容可以撤銷；新建的整理手記可以移到回收站。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIのソースとオリジナル素材の参照を保持します。 挿入されたコンテンツは元に戻すことができます；新しい整理されたメモはゴミ箱に移動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 소스와 원본 자료에 대한 참조를 유지합니다. 삽입된 내용은 되돌릴 수 있으며, 새로 정리된 메모는 휴지통으로 이동할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve la source d'IA et les références matérielles originales. Le contenu inséré peut être annuler ; la nouvelle note organisée peut être déplacée vers la corbeille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält KI-Quellen- und Originalmaterialreferenzen. Eingefügte Inhalte können rückgängig gemacht werden; die neue organisierte Notiz kann in den Papierkorb verschoben werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene la fuente de IA y las referencias de material original. El contenido insertado se puede deshacer; la nueva nota organizada se puede mover a la Papelera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém referências de fonte de IA e materiais originais. O conteúdo inserido pode ser desfeito; a nova nota organizada pode ser movida para o Lixo."
          }
        }
      }
    },
