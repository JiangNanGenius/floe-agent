    "app.bilingual.4f1271e6ea59eb4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将移除此配置中的取值或绑定，共享凭据和技能文件会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its value or binding will be removed from this configuration. Shared credentials and skill files are kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將移除此配置中的取值或繫結，共享憑據和技能檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この構成からその値またはバインディングが削除されます。 共有された認証情報とスキルファイルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 값 또는 바인딩은 이 구성에서 제거됩니다. 공유된 자격 증명 및 스킬 파일이 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa valeur ou sa liaison sera supprimée de cette configuration. Les informations d'identification partagées et les fichiers de compétences sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Wert oder seine Bindung wird aus dieser Konfiguration entfernt. Gemeinsame Anmeldedaten und Skill-Dateien werden aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su valor o enlace se eliminará de esta configuración. Las credenciales compartidas y los archivos de habilidades se guardan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu valor ou ligação será removido desta configuração. As credenciais compartilhadas e os arquivos de habilidades são mantidos."
          }
        }
      }
    },
