    "cad.material.error.faceGone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That face no longer exists. Reselect it in the viewport."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该面已不存在。请在视口中重新选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該面已不存在。請在視口中重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その顔はもう存在しません。 ビューポートで再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 얼굴은 더 이상 존재하지 않습니다. 뷰포트에서 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce visage n'existe plus. Sélectionnez-le à l'afficher dans la fenêtre d'affichage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gesicht existiert nicht mehr. Wählen Sie es im Ansichtsfenster erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa cara ya no existe. Vuelve a seleccionarlo en la ventana gráfica."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse rosto não existe mais. Selecione-o novamente na janela de visualização."
          }
        }
      }
    },
    "cad.material.error.faceRangeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't apply a material to this face. Rebuild the model or select the whole body."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法为此面应用材质。请重建模型，或选择整个实体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法為此面應用材質。請重建模型，或選擇整個實體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この顔に素材を適用できません。 モデルを再構築するか、全体を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 얼굴에 재료를 적용할 수 없습니다. 모델을 재구성하거나 전체 본문을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne peux pas appliquer de matériau sur ce visage. Reconstruisez le modèle ou sélectionnez tout le corps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann kein Material auf dieses Gesicht auftragen. Bauen Sie das Modell neu auf oder wählen Sie den gesamten Körper aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede aplicar un material a esta cara. Reconstruye el modelo o selecciona todo el cuerpo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível aplicar um material neste rosto. Reconstrua o modelo ou selecione o corpo inteiro."
          }
        }
      }
    },
    "cad.material.error.faceRebuilt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model changed and that face could no longer be identified. Reselect it in the viewport."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
