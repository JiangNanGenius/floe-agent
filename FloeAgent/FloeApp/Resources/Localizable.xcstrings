    "localmodels.apple_foundation_model_runtime.the_apple_intelligence_model_can_process": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple Intelligence model can process at most four images at a time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 模型每次最多处理四张图片"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 模型每次最多處理四張圖片"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceモデルは、一度に最大4枚の画像を処理できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 모델은 한 번에 최대 네 개의 이미지를 처리할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle Apple Intelligence peut traiter au plus quatre images à la fois"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell Apple Intelligence kann höchstens vier Bilder auf einmal verarbeiten"
