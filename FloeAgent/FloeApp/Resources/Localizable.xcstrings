        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A otimização não foi concluída ou seu resultado detalhado não foi registrado. Os dados foram mantidos; envie um relatório de diagnóstico."
          }
        }
      }
    },
    "app.storage_optimization_service.the_environment_changed_during_checking": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境正在变化，尚未优化。请等待环境准备完成后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment changed during checking. Wait for preparation to finish, then try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境正在變化，尚未最佳化。請等待環境準備完成後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検査中に環境が変わりました。 準備が完了するまで待ってから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사 중에 환경이 변경되었습니다. 준비가 끝날 때까지 기다린 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement a changé pendant la vérification. Attendez que la préparation soit terminée, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung hat sich während der Überprüfung geändert. Warten Sie, bis die Vorbereitung abgeschlossen ist, und versuchen Sie es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno cambió durante la comprobación. Espera a que termine la preparación, luego inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente mudou durante a verificação. Aguarde a preparação terminar e tente novamente."
          }
        }
      }
    },
    "app.storage_optimization_service.the_environment_could_not_be": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未完成环境清点，尚未优化。请稍后重试；若仍失败，请上传反馈日志。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment could not be fully checked, so optimization has not started. Try again later; if it keeps failing, send a diagnostic report."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫未完成環境清點，尚未最佳化。請稍後重試；若仍失敗，請上傳反饋日誌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境を完全にチェックできなかったため、最適化は開始されていません。 後ほど再度お試しください。もし失敗が続く場合は、診断レポートを送信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경을 완전히 확인할 수 없었으므로 최적화가 시작되지 않았습니다. 나중에 다시 시도하십시오; 계속 실패하면 진단 보고서를 보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement n'a pas pu être entièrement vérifié, donc l'optimisation n'a pas commencé. Réessayez plus tard ; si cela continue d'échouer, envoyez un rapport de diagnostic."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung konnte nicht vollständig überprüft werden, so dass die Optimierung nicht gestartet wurde. Versuchen Sie es später noch einmal. Wenn es weiterhin fehlschlägt, senden Sie einen Diagnosebericht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno no se pudo comprobar completamente, por lo que la optimización no ha comenzado. Inténtalo de nuevo más tarde; si sigue fallando, envía un informe de diagnóstico."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente não pôde ser totalmente verificado, então a otimização não foi iniciada. Tente novamente mais tarde; se continuar falhando, envie um relatório de diagnóstico."
          }
        }
      }
    },
