            "value": "Nenhum resultado de geração pronta retido foi encontrado para esta solicitação."
          }
        }
      }
    },
    "design.owner.generate_ready_to_bind": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A generated result is ready; generate again to bind it without a new provider call."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已生成的素材已就绪；再次点击生成即可绑定，不会重新调用服务商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已生成的素材已就緒；再次點選生成即可繫結，不會重新呼叫服務商。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成された結果が準備できました。新しいプロバイダー呼び出しなしでバインドするために、再度生成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 결과가 준비되었습니다; 새로운 제공자 호출 없이 다시 생성하여 바인딩하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un résultat généré est prêt ; générez-le à nouveau pour le lier sans un nouvel appel de fournisseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein generiertes Ergebnis ist fertig; generieren Sie es erneut, um es ohne einen neuen Anbieteraufruf zu binden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resultado generado está listo; genere de nuevo para vincularlo sin una nueva llamada de proveedor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um resultado gerado está pronto; gere novamente para vinculá-lo sem uma nova chamada de provedor."
          }
        }
      }
    },
    "design.owner.generate_result_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The generated result for this request is no longer available on this device (its record or file was removed). Bind is not offered from the stale identity."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此请求的生成结果已不在本机（记录或文件已被移除）。不会用旧记录冒充可绑定的结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此請求的生成結果已不在本機（記錄或檔案已被移除）。不會用舊記錄冒充可繫結的結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストの生成された結果は、このデバイスでは利用できなくなりました（そのレコードまたはファイルは削除されました）。 Bind は古いアイデンティティから提供されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청에 대한 생성된 결과는 이 장치에서 더 이상 확인할 수 없습니다(기록 또는 파일이 삭제되었습니다). Bind는 오래된 아이덴티티에서 제공되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat généré pour cette demande n'est plus disponible sur cet appareil (son enregistrement ou son fichier a été supprimé). La liaison n'est pas offerte à partir de l'identité rusée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das generierte Ergebnis für diese Anfrage ist auf diesem Gerät nicht mehr verfügbar (sein Datensatz oder seine Datei wurde entfernt). Bind wird nicht von der abgestabenen Identität angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado generado para esta solicitud ya no está disponible en este dispositivo (se eliminó su registro o archivo). Bind no se ofrece a partir de la identidad rancia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado gerado para esta solicitação não está mais disponível neste dispositivo (seu registro ou arquivo foi removido). A Ligação não é oferecida a partir da identidade animoleta."
          }
        }
      }
    },
    "design.owner.generate_result_not_missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded result still resolves on this device; nothing was changed."
          }
