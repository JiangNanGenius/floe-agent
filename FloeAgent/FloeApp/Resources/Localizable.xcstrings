    },
    "app.bilingual.be15c2abbd3f69b7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复未完成，原件和恢复资料均已保留。请重新打开工程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoration is incomplete. The originals and recovery data were retained. Reopen the project."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復未完成，原件和恢復資料均已保留。請重新開啟工程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修復が完了しています。 原本と復旧データは保持されました。 プロジェクトを再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원이 완료되지 않았습니다. 원본과 복구 데이터가 보존되었습니다. 프로젝트를 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration est incomplète. Les originaux et les données de récupération ont été conservés. Rouvrir le projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Restaurierung ist unvollständig. Die Originale und Wiederherstellungsdaten wurden beibehalten. Öffnen Sie das Projekt erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauración está incompleta. Se conservaron los originales y los datos de recuperación. Vuelva a abrir el proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A restauração está incompleta. Os originais e os dados de recuperação foram retidos. Reabra o projeto."
          }
        }
      }
    },
