    "app.floe_agent_app.the_task_private_workspace_and_temporary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task, private workspace and temporary credentials will be deleted. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、私有工作区和临时凭据将被删除，此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務、私有工作區和臨時憑據將被刪除，此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、プライベートワークスペース、および一時的な認証情報は削除されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 개인 작업 공간 및 임시 자격 증명이 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche, l'espace de travail privé et les informations d'identification temporaires seront supprimés. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe, der private Arbeitsbereich und die temporären Anmeldeinformationen werden gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea, el espacio de trabajo privado y las credenciales temporales se eliminarán. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa, o espaço de trabalho privado e as credenciais temporárias serão excluídos. Isso não pode ser desfeito."
          }
        }
      }
    },
    "app.floe_agent_app.the_workspace_could_not_be_mounted": {
