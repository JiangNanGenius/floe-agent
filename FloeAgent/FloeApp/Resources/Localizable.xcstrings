            "value": "업데이트를 저장할 수 없습니다. 현재 디자인을 검토하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la mise à jour. Passez en revue la conception actuelle et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update konnte nicht gespeichert werden. Überprüfen Sie das aktuelle Design und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la actualización. Revisa el diseño actual y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a atualização. Revise o design atual e tente novamente."
          }
        }
      }
    },
    "app.bilingual.6fea9ddcf8cf636a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刀路较多，请先在工序列表中缩小显示范围。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many toolpaths are visible. Narrow the display using the operation list, then select a path."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刀路較多，請先在工序列表中縮小顯示範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "多くのツールパスが見えます。 操作リストを使用して表示を絞り、次にパスを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "많은 툴패스가 표시됩니다. 작업 목록을 사용하여 화면을 좁힌 다음 경로를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De nombreux chemins d'outils sont visibles. Affinez l'affichage à l'aide de la liste d'opérations, puis sélectionnez un chemin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Werkzeugpfade sind sichtbar. Verengen Sie die Anzeige mithilfe der Operationsliste, und wählen Sie dann einen Pfad aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muchas rutas de herramientas son visibles. Reduzca la pantalla usando la lista de operaciones y, a continuación, seleccione una ruta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitos caminhos de ferramentas são visíveis. Limite a tela usando a lista de operações e, em seguida, selecione um caminho."
          }
        }
      }
    },
    "app.bilingual.2388ba94a6d91849": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到干涉或间隙不足，已暂停。请查看检查详情。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused for interference or insufficient clearance. Review the check details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢測到干涉或間隙不足，已暫停。請檢視檢查詳情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "干渉またはクリアランス不足のため、一時停止しました。 チェックの詳細をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간섭 또는 충분한 여유가 없을 경우 일시 정지되었습니다. 검사 세부 정보를 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mis en pause en raison d'interférences ou d'un dégagement insuffisant. Vérifiez les détails de la vérification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgrund von Störungen oder unzureichendem Abstand pausiert. Überprüfen Sie die Scheckdetails."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado por interferencia o espacio libre insuficiente. Revisa los detalles del cheque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado por interferência ou folga insuficiente. Revise os detalhes da verificação."
          }
        }
      }
    },
