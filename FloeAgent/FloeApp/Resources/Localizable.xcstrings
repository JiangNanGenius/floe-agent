    "app.bilingual.362ff75a3e88678f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅本地工程导出；不会上传、发布或创建公开源码提供。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local engineering export only; nothing is uploaded, published or offered publicly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅本地工程匯出；不會上傳、釋出或建立公開原始碼提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルエンジニアリングの輸出のみです；何もアップロード、公開、または公に提供しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지 엔지니어링 수출 전용이며, 업로드되거나 공개되거나 공개적으로 제공되는 것이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation d'ingénierie locale uniquement ; rien n'est téléchargé, publié ou offert publiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lokaler Engineering-Export; nichts wird hochgeladen, veröffentlicht oder öffentlich angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo exportación de ingeniería local; nada se carga, se publica ni se ofrece públicamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas exportação de engenharia local; nada é carregado, publicado ou oferecido publicamente."
          }
        }
      }
    },
