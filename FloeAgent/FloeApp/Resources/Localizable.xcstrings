    "design.owner.error.restructure_confirmation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restructuring needs your confirmation of what must be preserved before anything changes. Nothing was modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重构需要先确认必须保留的内容才会执行修改，目前未做任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重構需要先確認必須保留的內容才會執行修改，目前未做任何更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストラクチャリングは、何も変更される前に、何が保存されなければならないかについて、あなたの確認が必要です。 何も変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구조조정은 어떤 것이 변경되기 전에 보존해야 할 사항에 대한 귀하의 확인이 필요합니다. 수정된 것이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restructuration nécessite votre confirmation de ce qui doit être préservé avant que quoi que ce soit ne change. Rien n'a été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umstrukturierung erfordert Ihre Bestätigung dessen, was beibehalten werden muss, bevor sich etwas ändert. Es wurde nichts geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reestructuración necesita su confirmación de lo que debe preservarse antes de que algo cambie. No se modificó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reestruturação precisa da sua confirmação do que deve ser preservado antes que qualquer coisa mude. Nada foi modificado."
          }
        }
      }
    },
