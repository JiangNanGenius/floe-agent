    "shortcuts.run.find.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find visible task runs by task title, then choose the exact run to inspect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按任务标题查找运行记录，再选择需要查看的那一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按任務標題查詢執行記錄，再選擇需要檢視的那一次。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクタイトルで表示されているタスク実行を検索し、検査する正確な実行を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 제목별로 보이는 작업 실행을 찾은 다음, 검사할 정확한 실행을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des tâches visibles par titre de tâche, puis choisissez l'exécution exacte à inspecter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suchen Sie sichtbare Aufgabenläufe nach Aufgabentitel und wählen Sie dann den genauen Lauf aus, der überprüft werden soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentre las ejecuciones de tareas visibles por el título de la tarea y, a continuación, elija la ejecución exacta para inspeccionar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre execuções de tarefas visíveis pelo título da tarefa e, em seguida, escolha a execução exata para inspecionar."
          }
        }
      }
    },
