    "app.bilingual.e6e782110e40df85": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该图层使用画笔蒙版，边缘由画笔硬度决定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This layer uses a painted mask; edge softness follows brush hardness."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該圖層使用畫筆蒙版，邊緣由畫筆硬度決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイヤーは塗装されたマスクを使用しています；エッジの柔らかさはブラシの硬さに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이어는 페인팅된 마스크를 사용합니다; 가장자리 부드러움은 브러시 경도에 따라 변합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette couche utilise un masque peint ; la douceur du bord suit la dureté du pinceau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Schicht verwendet eine bemalte Maske; Kantenweichheit folgt Pinselhärte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta capa utiliza una máscara pintada; la suavidad del borde sigue a la dureza del pincel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta camada usa uma máscara pintada; a suavidade da borda segue a dureza do pincel."
          }
        }
      }
    },
    "app.bilingual.c672fa5e916885dd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该图层蒙版保留创建时的羽化，与当前选区羽化相互独立。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This layer mask keeps the feather it was created with, independent of the current selection."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該圖層蒙版保留建立時的羽化，與當前選區羽化相互獨立。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレイヤーマスクは、作成に使用されたフェザーを保持し、現在の選択とは独立しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레이어 마스크는 현재 선택과 무관하게 생성된 깃털을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce masque de couche garde la plume avec laquelle il a été créé, indépendante de la sélection actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ebenenmaske hält die Feder, mit der sie erstellt wurde, unabhängig von der aktuellen Auswahl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máscara de capa mantiene la pluma con la que fue creada, independiente de la selección actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta máscara de camada mantém a pena com a qual foi criada, independente da seleção atual."
          }
        }
      }
    },
