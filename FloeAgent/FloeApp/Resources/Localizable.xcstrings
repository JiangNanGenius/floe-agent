        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 가장자리는 이 평면에 평행합니다 — 선이 아니라 점으로 투사됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce bord est parallèle à ce plan - il se projette vers un point, pas une ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kante ist parallel zu dieser Ebene - sie projiziert sich zu einem Punkt, nicht zu einer Linie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese borde es paralelo a este plano: se proyecta a un punto, no a una línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa borda é paralela a este plano — ela se projeta para um ponto, não para uma linha."
          }
        }
      }
    },
