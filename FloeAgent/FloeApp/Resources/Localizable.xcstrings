    "platform.background_run_coordinator.the_environment_stopped_the_background_run": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment stopped; the background-run preference is retained and applies again after restart"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境已停止；后台运行偏好保留，重新启动后继续生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境已停止；後臺執行偏好保留，重新啟動後繼續生效"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境が停止しました。バックグラウンド実行の設定は保持され、再起動後に再度適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경이 중단되었습니다; 백그라운드 실행 기본 설정이 유지되며 재시작 후 다시 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement s'est arrêté ; la préférence d'exécution en arrière-plan est conservée et s'applique à nouveau après le redémarrage"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung wurde gestoppt; die Background-Run-Präferenz wird beibehalten und gilt nach dem Neustart erneut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno se detuvo; la preferencia de ejecución en segundo plano se mantiene y se aplica de nuevo después del reinicio"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente parou; a preferência de execução em segundo plano é mantida e aplicada novamente após o reinício"
          }
        }
      }
    },
