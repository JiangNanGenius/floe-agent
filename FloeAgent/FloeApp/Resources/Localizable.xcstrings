    "workspace.file_tree_view.and_all_of_its_contents_will": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and all of its contents will be deleted recursively. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将递归删除“%@”及其中的全部内容，此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將遞迴刪除“%@”及其中的全部內容，此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」およびそのすべてのコンテンツは再帰的に削除されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와 그 모든 내용은 재귀적으로 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et tout son contenu seront supprimés de manière récursive. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" und alle seine Inhalte werden rekursiv gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y todo su contenido se eliminarán de forma recursiva. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e todo o seu conteúdo serão excluídos recursivamente. Isso não pode ser desfeito."
          }
        }
      }
    },
