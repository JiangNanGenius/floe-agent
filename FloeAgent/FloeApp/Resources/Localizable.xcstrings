          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "npm 暂存目录缺少恢复记录；保留文件，请检查环境"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
