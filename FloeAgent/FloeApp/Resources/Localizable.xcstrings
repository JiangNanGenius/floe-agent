          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez ou annulez d'abord l'édition de l'esquisse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden oder brechen Sie zuerst die Bearbeitung der Skizze ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o cancela la edición del boceto primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine ou cancele a edição do esboço primeiro."
          }
        }
      }
    },
    "cad.variable.changed": {
