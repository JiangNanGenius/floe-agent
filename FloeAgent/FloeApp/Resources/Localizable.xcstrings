    "app.bilingual.d7dd5ae940198154": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动修改或撤销会让提案过期；过期提案必须重新生成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual edits or undo make a proposal stale; stale proposals must be prepared again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動修改或撤銷會讓提案過期；過期提案必須重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動での編集や元に戻すと、提案が陳腐になります。陳腐な提案は再度作成しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 편집이나 실행 취소는 제안을 진하게 만들며, 오래된 제안서는 다시 준비해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications manuelles ou l'annulation rendent une proposition émassée ; les propositions rassisées doivent être préparées à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle Bearbeitungen oder Rückgängigmachungen machen einen Vorschlag abgestanden; abgestandene Vorschläge müssen erneut vorbereitet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ediciones manuales o deshacer hacen que una propuesta esté ranta; las propuestas oxtas deben prepararse de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edições manuais ou desfazer tornam uma proposta velha; propostas aniquadas devem ser preparadas novamente."
          }
        }
      }
    },
    "app.bilingual.d37571031c885c26": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭视图不会丢弃任务；重新打开后仍可恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the view does not drop jobs; they recover when reopened."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉檢視不會丟棄任務；重新開啟後仍可恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューを閉じてもジョブは削除されません。再開した際にジョブは復元されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰를 닫아도 작업이 감소하지 않으며, 다시 열면 복구됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fermeture de la vue ne fait pas tomber les emplois ; ils récupèrent lorsqu'ils sont rouverts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Schließen der Ansicht lässt keine Arbeitsplätze fallen; sie erholen sich, wenn sie wieder geöffnet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar la vista no deja caer los trabajos; se recuperan cuando se vuelven a abrir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar a visualização não deixa cair os empregos; eles se recuperam quando reabertos."
          }
        }
      }
    },
