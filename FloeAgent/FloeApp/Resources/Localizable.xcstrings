    "cad.datum.editRejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change the reference plane. Check its source, offset and dependent sketches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更改基准面，请检查来源、偏移值及依赖它的草图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更改基準面，請檢查來源、偏移值及依賴它的草圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照平面を変更できませんでした。 ソース、オフセット、従属スケッチを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 평면을 변경할 수 없습니다. 소스, 오프셋 및 종속 스케치를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer le plan de référence. Vérifiez sa source, son décalage et ses croquis dépendants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Referenzebene konnte nicht geändert werden. Überprüfen Sie die Quelle, den Versatz und die abhängigen Skizzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cambiar el avión de referencia. Compruebe su fuente, offset y bocetos dependientes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar o plano de referência. Verifique sua fonte, deslocamento e esboços dependentes."
          }
        }
      }
    },
    "cad.datum.finishCurrentEdit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish the current edit and reopen the document if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束当前编辑，必要时重新打开文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先結束當前編輯，必要時重新開啟文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の編集を完了し、必要に応じて文書を再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 편집을 완료하고 필요하면 문서를 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l'édition actuelle et rouvrez le document si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die aktuelle Bearbeitung ab und öffnen Sie das Dokument bei Bedarf erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalice la edición actual y vuelva a abrir el documento si es necesario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua a edição atual e reabra o documento, se necessário."
          }
        }
      }
    },
