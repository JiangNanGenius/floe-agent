    "workspace.file_inspector_view.passwords_are_written_only_to_keychain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords are written only to Keychain; mount configs, sync, logs and model context store only credential references."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码只写入 Keychain；挂载配置、同步、日志和模型上下文只保存凭据引用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼只寫入 Keychain；掛載配置、同步、日誌和模型上下文只儲存憑據引用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードはキーチェーンにのみ書き込まれます；マウント設定、同期、ログ、モデルコンテキストは認証情報参照のみを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호는 키체인에만 기록됩니다; 마운트 구성, 동기화, 로그 및 모델 컨텍스트는 자격 증명 참조만 저장합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de passe sont écrits uniquement sur le trousseau ; les configurations de montage, la synchronisation, les journaux et le contexte du modèle stockent uniquement les références d'informations d'identification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwörter werden nur in den Schlüsselbund geschrieben; Mount-Konfigurationen, Synchronisierung, Protokolle und Modellkontext speichern nur Anmeldeinformationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las contraseñas se escriben solo en el llavero; las configuraciones de montaje, la sincronización, los registros y el contexto del modelo almacenan solo referencias de credenciales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As senhas são escritas apenas para o Keychain; configurações de montagem, sincronização, registros e contexto de modelo armazenam apenas referências de credenciais."
          }
        }
      }
    },
