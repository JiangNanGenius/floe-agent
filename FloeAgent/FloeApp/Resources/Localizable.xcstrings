    "notes.note_edit.the_central_topic_cannot_be_deleted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The central topic cannot be deleted; rename it or clear its branches."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能删除中心主题；可以重命名或清空其分支。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不能刪除中心主題；可以重新命名或清空其分支。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中心トピックは削除できません。名前を変更するか、ブランチを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중심 주제는 삭제할 수 없습니다; 이름을 바꾸거나 분기를 삭제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sujet central ne peut pas être supprimé ; renommez-le ou effacez ses branches."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das zentrale Thema kann nicht gelöscht werden; benennen Sie es um oder löschen Sie seine Zweige."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tema central no se puede eliminar; renombrarlo o borrar sus ramas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tópico central não pode ser excluído; renomeá-lo ou limpar suas ramificações."
          }
        }
      }
    },
