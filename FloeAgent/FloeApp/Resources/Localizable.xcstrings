    "canvas.onboarding.ai.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small AI field edits only the selected node. It refines content and compatible settings without opening Canvas Assistant or starting a task."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节点下方的小 AI 输入框只修改当前节点：整理内容和兼容参数，不打开画布助手，也不自动执行任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "節點下方的小 AI 輸入框只修改當前節點：整理內容和相容引數，不開啟畫布助手，也不自動執行任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなAIフィールドは、選択されたノードのみを編集します。 Canvas Assistant を開いたりタスクを開始したりせずに、コンテンツと対応設定を洗練させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 AI 필드는 선택된 노드만 편집합니다. Canvas Assistant를 열거나 작업을 시작하지 않고도 콘텐츠와 호환되는 설정을 정교화합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le petit champ d'IA n'édite que le nœud sélectionné. Il affine le contenu et les paramètres compatibles sans ouvrir Canvas Assistant ni démarrer une tâche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kleine KI-Feld bearbeitet nur den ausgewählten Knoten. Es verfeinert Inhalte und kompatible Einstellungen, ohne den Canvas Assistant zu öffnen oder eine Aufgabe zu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pequeño campo de IA edita solo el nodo seleccionado. Refina el contenido y la configuración compatible sin abrir Canvas Assistant o iniciar una tarea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pequeno campo AI edita apenas o nó selecionado. Ele refina o conteúdo e as configurações compatíveis sem abrir o Canvas Assistant ou iniciar uma tarefa."
          }
        }
      }
    },
    "canvas.onboarding.ai.title": {
      "localizations": {
        "en": {
          "stringUnit": {
