          "stringUnit": {
            "state": "translated",
            "value": "O servidor rejeitou a operação ou não a suporta."
          }
        }
      }
    },
    "mail.error.responseTooLarge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response exceeds the safety limit; narrow the request."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应超过安全上限，请缩小请求范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "響應超過安全上限，請縮小請求範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答が安全限界を超えています；リクエストを絞り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 안전 한도를 초과합니다; 요청을 좁히십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse dépasse la limite de sécurité ; restreindre la demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort überschreitet das Sicherheitslimit; schränken Sie die Anfrage ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta supera el límite de seguridad; limitar la solicitud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta excede o limite de segurança; limite a solicitação."
          }
        }
      }
    },
