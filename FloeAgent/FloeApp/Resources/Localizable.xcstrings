    "environment.capabilities.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build has no verified signed catalog, so no artifact can be downloaded or installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建没有经过验证的签名目录，无法下载或安装任何产物。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此構建沒有經過驗證的簽名目錄，無法下載或安裝任何產物。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドには検証済みの署名済みカタログが存在しないため、アーティファクトをダウンロードしたりインストールしたりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드에는 검증된 서명된 카탈로그가 없기 때문에 아티팩트를 다운로드하거나 설치할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version n'a pas de catalogue signé vérifié, donc aucun artefact ne peut être téléchargé ou installé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Build hat keinen verifizierten signierten Katalog, so dass kein Artefakt heruntergeladen oder installiert werden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilación no tiene un catálogo firmado verificado, por lo que no se puede descargar ni instalar ningún artefacto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta compilação não tem um catálogo assinado verificado, portanto, nenhum artefato pode ser baixado ou instalado."
          }
        }
      }
    },
