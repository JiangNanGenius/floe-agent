    "shortcuts.schedule.run.error.event_driven": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That Floe schedule runs after another task succeeds and has no time-based run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 Floe 日程在另一个任务成功后运行，没有按时间触发的运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該 Floe 日程在另一個任務成功後執行，沒有按時間觸發的執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その Floe スケジュールは、別のタスクが成功した後に実行され、時間ベースの実行はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 Floe 일정은 다른 작업이 성공한 후에 실행되며 시간 기반 실행이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce calendrier Floe s'exécute après le succès d'une autre tâche et n'a pas d'exécution basée sur le temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Floe-Zeitplan wird ausgeführt, nachdem eine andere Aufgabe erfolgreich ist und keine zeitbasierte Ausführung hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese horario de Floe se ejecuta después de que otra tarea tiene éxito y no tiene una ejecución basada en el tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse cronograma Floe é executado após o sucesso de outra tarefa e não tem execução baseada no tempo."
          }
        }
      }
    },
