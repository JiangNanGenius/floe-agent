    "share.intake.deferred_busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft is busy. Finish or cancel the current send, then try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "草稿正在使用中，请完成或取消当前发送后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
