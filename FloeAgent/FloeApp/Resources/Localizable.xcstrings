    "cad.mechanical.gearLimits": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-depth external gear, zero backlash and profile shift. Circular root transition; no cutter undercut or manufacturing quality grade."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全齿高外齿轮，零侧隙、零变位。采用圆弧齿根过渡，不包含刀具根切或制造精度等级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "全齒高外齒輪，零側隙、零變位。採用圓弧齒根過渡，不包含刀具根切或製造精度等級。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルデプス外部ギア、ゼロバックラッシュ、プロファイルシフト。 円形ルート遷移；カッターのアンダーカットや製造品質グレードはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 깊이 외부 기어, 제로 백래시 및 프로파일 시프트. 원형 뿌리 전환; 커터 언더컷이나 제조 품질 등급이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engrenage externe à pleine profondeur, zéro contre-coup et changement de profil. Transition circulaire de la racine ; pas de sous-dépouille de coupe ou de qualité de fabrication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externes Getriebe mit voller Tiefe, keine Gegenreaktion und Profilverschiebung. Kreisförmiger Wurzelübergang; kein Cutter-Unterschnitt oder Fertigungsqualität."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Engranaje externo de profundidad completa, cero contragolpes y cambio de perfil. Transición de raíz circular; sin corte inferior o grado de calidad de fabricación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Engrenagem externa de profundidade total, zero reação e mudança de perfil. Transição de raiz circular; sem corte inferior ou grau de qualidade de fabricação."
          }
        }
      }
    },
