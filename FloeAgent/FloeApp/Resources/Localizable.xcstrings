    "execution.runtime_rebuild.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download and verify a fresh Linux environment. The old environment, its software and data will be retained. Running work will stop; software must be installed again in the new environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并校验新的 Linux 环境。旧环境及其中的软件和资料会保留；运行中的任务会停止，新环境需要重新安装软件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並校驗新的 Linux 環境。舊環境及其中的軟體和資料會保留；執行中的任務會停止，新環境需要重新安裝軟體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Linux 環境をダウンロードし、検証してください。 旧環境、そのソフトウェアおよびデータは保持されます。 作業の実行は停止します。ソフトウェアは新しい環境に再度インストールする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 Linux 환경을 다운로드하고 확인하십시오. 구 환경과 그 소프트웨어 및 데이터는 보존됩니다. 작업이 중단됩니다; 소프트웨어를 새 환경에 다시 설치해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez et vérifiez un nouvel environnement Linux. L'ancien environnement, son logiciel et ses données seront conservés. Le travail en cours d'exécution s'arrêtera ; le logiciel doit être réinstallé dans le nouvel environnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie eine neue Linux-Umgebung herunter und verifizieren Sie sie. Die alte Umgebung, ihre Software und Daten werden beibehalten. Die laufende Arbeit wird beendet; die Software muss in der neuen Umgebung erneut installiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargue y verifique un nuevo entorno Linux. El entorno antiguo, su software y sus datos se conservarán. El trabajo en ejecución se detendrá; el software debe instalarse de nuevo en el nuevo entorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe e verifique um novo ambiente Linux. O ambiente antigo, seu software e dados serão mantidos. O trabalho em execução será interrompido; o software deve ser instalado novamente no novo ambiente."
          }
        }
      }
    },
