    "app.bilingual.f037804945113762": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每点为 [距刀尖的轴向距离, 半径]。正方向朝主轴；同一轴向位置可表示台阶。刀杆由切削刃末端延伸到首点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each point is [axial distance from tool tip, radius], positive toward the spindle. Equal axial positions describe shoulders. The shank runs from the cutting-edge end to the first point."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每點為 [距刀尖的軸向距離, 半徑]。正方向朝主軸；同一軸向位置可表示臺階。刀杆由切削刃末端延伸到首點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各点は[工具先端からの軸距離、半径]で、スピンドルに対して正です。 等軸位置は肩を表します。 シャンクは最先端端から第一点まで伸びています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 점은 [툴 팁으로부터의 축거리, 반경]이며, 스핀들을 향한 양의 방향입니다. 동등한 축 위치는 어깨를 설명합니다. 샹크는 최첨단 끝에서 첫 번째 지점까지 이어집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque point est [distance axiale de la pointe de l'outil, rayon], positif vers la broche. Des positions axiales égales décrivent les épaules. La tige va de l'extrémité tranchante au premier point."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Punkt ist [axialer Abstand zur Werkzeugspitze, Radius], positiv zur Spindel hin. Gleiche axiale Positionen beschreiben die Schultern. Der Schaft verläuft vom Schneidende bis zum ersten Punkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada punto es [distancia axial desde la punta de la herramienta, radio], positivo hacia el husillo. Las posiciones axiales iguales describen los hombros. El vástago va desde el extremo de la punta hasta el primer punto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada ponto é [distância axial da ponta da ferramenta, raio], positivo em direção ao fuso. Posições axiais iguais descrevem os ombros. A haste vai da extremidade de ponta até o primeiro ponto."
          }
        }
      }
