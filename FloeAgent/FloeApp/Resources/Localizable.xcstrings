    "providers.save.saved_local_sync_pending.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your configuration is committed locally. The iCloud upload failed and can be retried; no data was lost."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已在本机提交完成。iCloud 上传失败，可重试；数据没有丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已在本機提交完成。iCloud 上傳失敗，可重試；資料沒有丟失。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の設定はローカルでコミットされています。 iCloud のアップロードが失敗し、再トライできます。データは失われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 구성은 로컬에 커밋됩니다. iCloud 업로드가 실패했으며 다시 시도할 수 있습니다; 데이터가 손실되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre configuration est validée localement. Le téléchargement iCloud a échoué et peut être réessayé ; aucune donnée n'a été perdue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Konfiguration ist lokal festgelegt. Der iCloud-Upload ist fehlgeschlagen und kann erneut versucht werden. Es sind keine Daten verloren gegangen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su configuración se compromete localmente. La carga de iCloud falló y se puede volver a intentar; no se perdieron datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua configuração é confirmada localmente. O upload do iCloud falhou e pode ser tentado novamente; nenhum dado foi perdido."
          }
        }
      }
    },
