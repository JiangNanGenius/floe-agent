          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écraser cette sauvegarde ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Speicherstand überschreiben?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
