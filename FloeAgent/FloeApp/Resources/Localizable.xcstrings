    "cad.versions.error.compareStale": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document or version changed since the first page. Start the comparison again; no mixed revision was returned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档或版本在第一页之后已更改。请重新开始比较；未返回混合修订。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件或版本在第一頁之後已更改。請重新開始比較；未返回混合修訂。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書またはバージョンは、最初のページ以降に変更されています。 比較を再度開始してください；混合リビジョンは返されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 또는 버전이 첫 페이지 이후로 변경되었습니다. 비교를 다시 시작하십시오; 혼합된 수정본이 반환되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document ou la version a changé depuis la première page. Recommencer la comparaison ; aucune révision mixte n'a été renvoyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument oder die Version hat sich seit der ersten Seite geändert. Starten Sie den Vergleich erneut; es wurde keine gemischte Revision zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento o versión cambió desde la primera página. Comience la comparación de nuevo; no se devolvió ninguna revisión mixta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento ou versão mudou desde a primeira página. Comece a comparação novamente; nenhuma revisão mista foi retornada."
          }
        }
      }
    },
    "cad.versions.error.comparePinsRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetching a later comparison page requires the identity pins from the first page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取后续比较页需要第一页返回的标识信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獲取後續比較頁需要第一頁返回的標識資訊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後の比較ページを取得するには、最初のページのアイデンティティピンが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후속 비교 페이지를 가져오려면 첫 번째 페이지의 아이덴티티 핀이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération d'une page de comparaison ultérieure nécessite les épingles d'identité de la première page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine spätere Vergleichsseite abzurufen, sind die Identitäts-Pins von der ersten Seite erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda de una página de comparación posterior requiere los pines de identidad de la primera página."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A buscar uma página de comparação posterior requer os pinos de identidade da primeira página."
          }
        }
      }
    },
