    "settings.sync.master.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master switch controls all cross-device sync. Turning it off moves configured provider keys to this device's local Keychain and pauses CloudKit traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总开关控制全部跨设备同步。关闭后，已配置的供应商密钥会迁移到本机钥匙串，同时暂停 CloudKit 网络同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "總開關控制全部跨裝置同步。關閉後，已配置的供應商金鑰會遷移到本機鑰匙串，同時暫停 CloudKit 網路同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスタースイッチはすべてのデバイス間同期を制御します。 オフにすると、設定されたプロバイダーキーがこのデバイスのローカルキーチェーンに移動し、CloudKit のトラフィックが一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마스터 스위치는 모든 장치 간 동기화를 제어합니다. 이를 끄면 구성된 제공자 키가 이 장치의 로컬 키체인으로 이동하고 CloudKit 트래픽이 일시 중지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le commutateur principal contrôle toute la synchronisation inter-appareils. En le désactivant, déplace les clés du fournisseur configurées vers le trousseau local de cet appareil et met en pause le trafic CloudKit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hauptschalter steuert die gesamte geräteübergreifende Synchronisierung. Das Ausschalten verschiebt konfigurierte Anbieterschlüssel in den lokalen Schlüsselbund dieses Geräts und pausiert den CloudKit-Verkehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El interruptor maestro controla toda la sincronización entre dispositivos. Apagarlo mueve las claves de proveedor configuradas al llavero local de este dispositivo y pausa el tráfico de CloudKit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O interruptor mestre controla toda a sincronização entre dispositivos. Desligá-lo move as chaves do provedor configuradas para o Chaveiro local deste dispositivo e pausa o tráfego do CloudKit."
          }
        }
      }
    },
