    "cad.physics.stale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed. Configure and simulate the proxies again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源对象已变更。请重新配置并仿真碰撞代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "源物件已變更。請重新配置並模擬碰撞代理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースが変更されました。 プロキシを再度設定し、シミュレートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스가 변경되었습니다. 프록시를 다시 구성하고 시뮬레이션하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source a changé. Configurez et simulez à nouveau les proxys."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle hat sich geändert. Konfigurieren und simulieren Sie die Proxys erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente cambió. Configure y simule los proxies de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte mudou. Configure e simule os proxies novamente."
          }
        }
      }
    },
    "cad.physics.cancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulation was cancelled. No new cache was applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仿真已取消，未应用新缓存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬已取消，未應用新快取。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレーションはキャンセルされました。 新しいキャッシュは適用されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이션이 취소되었습니다. 새로운 캐시가 적용되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulation a été annulée. Aucun nouveau cache n'a été appliqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Simulation wurde abgebrochen. Es wurde kein neuer Cache angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulación fue cancelada. No se aplicó ninguna caché nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulação foi cancelada. Nenhum novo cache foi aplicado."
          }
        }
      }
    },
    "cad.physics.budget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This simulation exceeded its limits. Reduce its duration or contacts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仿真超出限制，请缩短时长或减少接触。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模擬超出限制，請縮短時長或減少接觸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このシミュレーションは限界を超えました。 期間や接触を減らす。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시뮬레이션은 한계를 초과했습니다. 그 지속 시간이나 접촉을 줄이십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette simulation a dépassé ses limites. Réduisez sa durée ou ses contacts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Simulation hat ihre Grenzen überschritten. Reduzieren Sie die Dauer oder die Kontakte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta simulación superó sus límites. Reduzca su duración o contactos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta simulação excedeu seus limites. Reduza sua duração ou contatos."
          }
        }
      }
    },
    "cad.physics.contact": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These contacts could not be resolved within the supported scope."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前支持范围无法求解这些接触。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前支援範圍無法求解這些接觸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの連絡先は、サポートされている範囲内で解決できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 연락처는 지원되는 범위 내에서 해결될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces contacts n'ont pas pu être résolus dans la portée prise en charge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kontakte konnten nicht innerhalb des unterstützten Bereichs aufgelöst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos contactos no se pudieron resolver dentro del alcance admitido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses contatos não puderam ser resolvidos dentro do escopo suportado."
          }
        }
      }
    },
    "cad.physics.busy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A simulation is finishing. Wait for it to stop before starting another."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一项仿真正在结束，请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一項模擬正在結束，請稍後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレーションが終了しています。 別のものを開始する前に、停止するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시뮬레이션이 마무리되고 있습니다. 다른 것을 시작하기 전에 그것이 멈출 때까지 기다리세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une simulation se termine. Attendez qu'il s'arrête avant d'en commencer un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Simulation wird abgeschlossen. Warten Sie, bis es aufhört, bevor Sie ein anderes starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una simulación está terminando. Espera a que se detenga antes de comenzar otro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma simulação está terminando. Espere até que pare antes de começar outro."
          }
        }
      }
    },
