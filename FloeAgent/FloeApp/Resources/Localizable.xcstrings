    "skills.review.scripts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contains scripts. iOS keeps them as visible source; remote execution still requires per-run approval."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含脚本。iOS 仅将其作为可见源码保存；远程执行仍需逐次审批。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包含指令碼。iOS 僅將其作為可見原始碼儲存；遠端執行仍需逐次審批。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトが含まれています。 iOSはそれらを可視ソースとして保持します；リモート実行は依然として実行ごとの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트가 포함되어 있습니다. iOS는 이를 보이는 소스로 유지합니다; 원격 실행은 여전히 실행당 승인이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contient des scripts. iOS les conserve comme source visible ; l'exécution à distance nécessite toujours une approbation par exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Skripte. iOS behält sie als sichtbare Quelle bei; die Remote-Ausführung erfordert weiterhin eine Genehmigung pro Lauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contiene scripts. iOS los mantiene como fuente visible; la ejecución remota aún requiere aprobación por ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contém scripts. iOS os mantém como fonte visível; a execução remota ainda requer aprovação por execução."
          }
        }
      }
    },
