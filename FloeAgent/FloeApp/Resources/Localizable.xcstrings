    "app.bilingual.e95bd2134a501470": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下次打开此网站时使用桌面版。AI 下次操作此网站时会使用较宽的固定页面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the desktop version on the next navigation and a wider fixed page the next time AI works on this site."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下次開啟此網站時使用桌面版。AI 下次操作此網站時會使用較寬的固定頁面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のナビゲーションではデスクトップ版を使用し、次にAIがこのサイトで動作するときは、より広い固定ページをご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 탐색 시 데스크톱 버전을 사용하고, AI가 이 사이트에서 다음에 작동할 때는 더 넓은 고정 페이지를 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la version de bureau sur la prochaine navigation et une page fixe plus large la prochaine fois que l'IA fonctionnera sur ce site."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie die Desktop-Version bei der nächsten Navigation und eine breitere feste Seite, wenn KI das nächste Mal auf dieser Website funktioniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice la versión de escritorio en la próxima navegación y una página fija más amplia la próxima vez que la IA funcione en este sitio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a versão desktop na próxima navegação e uma página fixa mais ampla na próxima vez que a IA funcionar neste site."
          }
        }
      }
    },
