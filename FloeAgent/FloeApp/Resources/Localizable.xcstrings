    "setup.features.safety.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Automatic approval reviews each concrete action. Offline local approval stays restricted, and system safety boundaries always remain enforced." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "自动审批会审核每个具体动作；离线本地审批保持受限，系统安全边界始终生效。" } }
      }
    },
