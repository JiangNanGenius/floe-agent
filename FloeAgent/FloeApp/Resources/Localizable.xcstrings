      }
    },
    "app.bilingual.a01f0f991224f6aa": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整设置包含轴链、工位、同步、预算和低频字段。厂商扩展保存在各对象的参数记录中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The complete setup includes axis chains, stations, synchronization, budgets and uncommon fields. Keep vendor extensions in each owner's parameter record."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整設定包含軸鏈、工位、同步、預算和低頻欄位。廠商擴充套件儲存在各物件的引數記錄中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なセットアップには、軸チェーン、ステーション、同期、予算、そして珍しいフィールドが含まれます。 各所有者のパラメータレコードにベンダー拡張を保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 설정에는 축 체인, 스테이션, 동기화, 예산 및 이례적인 필드가 포함됩니다. 각 소유자의 매개변수 기록에 벤더 확장을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration complète comprend les chaînes d'axes, les stations, la synchronisation, les budgets et les champs inhabituels. Conservez les extensions du fournisseur dans l'enregistrement des paramètres de chaque propriétaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das komplette Setup umfasst Achsenketten, Stationen, Synchronisation, Budgets und ungewöhnliche Felder. Behalten Sie Anbietererweiterungen im Parameterdatensatz jedes Eigentümers bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración completa incluye cadenas de ejes, estaciones, sincronización, presupuestos y campos poco comunes. Mantenga las extensiones del proveedor en el registro de parámetros de cada propietario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração completa inclui cadeias de eixos, estações, sincronização, orçamentos e campos incomuns. Mantenha as extensões do fornecedor no registro de parâmetros de cada proprietário."
          }
        }
      }
    },
