    "remote.conversation_center.the_history_changed_during_compaction_so": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history changed during compaction, so the old summary was not applied; please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩期间历史发生变化，未应用旧摘要，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "壓縮期間歷史發生變化，未應用舊摘要，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮中に履歴が変更されたため、古い要約は適用されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "압축 중에 기록이 변경되어 이전 요약이 적용되지 않았습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'historique a changé pendant le compactage, donc l'ancien résumé n'a pas été appliqué ; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf hat sich während der Verdichtung geändert, so dass die alte Zusammenfassung nicht angewendet wurde; bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial cambió durante la compactación, por lo que el resumen anterior no se aplicó; por favor, inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico mudou durante a compactação, então o resumo antigo não foi aplicado; tente novamente."
          }
        }
      }
    },
    "remote.conversation_center.the_history_is_short_enough_no": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The history is short enough; no compaction needed and the original records are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史较短，无需压缩；原始记录未改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史較短，無需壓縮；原始記錄未改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歴史は十分に短く、圧縮は不要で、元の記録は変更されていません。"
