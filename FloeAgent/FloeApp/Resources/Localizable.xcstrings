    "app.bilingual.7dba89492c8bdc2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加工设置已改变，请取消后重新打开毛坯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machining settings changed. Cancel and reopen stock setup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加工設定已改變，請取消後重新開啟毛坯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械加工設定が変更されました。 在庫設定をキャンセルし、再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가공 설정이 변경되었습니다. 주식 설정을 취소하고 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres d'usinage ont changé. Annuler et rouvrir la configuration du stock."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitungseinstellungen geändert. Abbrechen und erneutes Öffnen des Lagerkonfigurats."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de mecanizado ha cambiado. Cancelar y volver a abrir la configuración de existencias."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de usinagem foram alteradas. Cancelar e reabrir a configuração do estoque."
          }
        }
      }
    },
    "app.bilingual.7635c8dbcc544213": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前计算或模型检查完成，再应用修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current calculation or model check before applying changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待當前計算或模型檢查完成，再應用修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を適用する前に、現在の計算またはモデルチェックが完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 적용하기 전에 현재 계산이나 모델 검사를 기다리십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez le calcul actuel ou la vérification du modèle avant d'appliquer les modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie auf die aktuelle Berechnung oder Modellprüfung, bevor Sie Änderungen vornehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere el cálculo actual o la comprobación del modelo antes de aplicar los cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde o cálculo atual ou a verificação do modelo antes de aplicar as alterações."
          }
        }
      }
    },
