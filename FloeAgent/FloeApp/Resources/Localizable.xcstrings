        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次釋放 %@。工作區、文件、模型、字型、附件、資料庫和憑據未被刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の清掃 %@. ワークスペース、ドキュメント、モデル、フォント、添付ファイル、データベース、および認証情報は削除されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 정리 %@. 워크스페이스, 문서, 모델, 글꼴, 첨부 파일, 데이터베이스 및 자격 증명이 삭제되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dernier nettoyage %@. Les espaces de travail, les documents, les modèles, les polices, les pièces jointes, les bases de données et les informations d'identification n'ont pas été supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Letzte Bereinigung %@. Arbeitsbereiche, Dokumente, Modelle, Schriftarten, Anhänge, Datenbanken und Anmeldeinformationen wurden nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Última limpieza %@. Los espacios de trabajo, documentos, modelos, fuentes, archivos adjuntos, bases de datos y credenciales no se eliminaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Última limpeza %@. Espaços de trabalho, documentos, modelos, fontes, anexos, bancos de dados e credenciais não foram excluídos."
          }
        }
      }
    },
