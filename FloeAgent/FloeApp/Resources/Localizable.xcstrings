        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weitere Runde wartet auf Hintergrundarbeiten. Setzen Sie das Ziel fort, nachdem es abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra ronda está esperando el trabajo de fondo. Reanude el objetivo después de que termine."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra rodada está aguardando o trabalho de fundo. Retome a Meta depois que ela terminar."
          }
        }
      }
    },
