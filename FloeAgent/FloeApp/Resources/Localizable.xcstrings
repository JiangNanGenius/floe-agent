        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後點按直邊、平面或圓柱面並按“應用”。該軸會持續跟隨該來源。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に、直線エッジ、平らな面、または丸い面をタップし、Apply を押してください。 軸はその情報源に従い続けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그런 다음 직선 가장자리, 평평한 면 또는 둥근 면을 탭하고 적용을 누르십시오. 축은 그 출처를 계속 따라가고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez ensuite sur un bord droit, une face plate ou une face ronde et appuyez sur Appliquer. L'axe continue de suivre cette source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie dann auf eine gerade Kante, eine flache oder eine runde Seite und drücken Sie auf \"Anwenden\". Die Achse folgt weiterhin dieser Quelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A continuación, pulsa un borde recto, una cara plana o una cara redonda y pulsa Aplicar. El eje sigue siguiendo esa fuente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em seguida, toque em uma borda reta, uma face plana ou uma face redonda e pressione Aplicar. O eixo continua seguindo essa fonte."
          }
        }
      }
    },
    "cad.datum.axisFromPlanes": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Axis from Two Planes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由两平面创建轴"
          }
        },
        "zh-Hant": {
