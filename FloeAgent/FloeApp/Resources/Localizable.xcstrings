    "settings.apple_capabilities_settings_view.create_and_manage_floe_automations_that": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and manage Floe automations that the system schedules on a best-effort basis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建和管理系统尽力调度的 Floe 自动任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立和管理系統盡力排程的 Floe 自動任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムがベストエフォートでスケジュールするFloeオートメーションを作成し、管理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 최선의 노력을 다해 예약하는 Floe 자동화를 생성하고 관리하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez et gérez les automatisations Floe que le système planifie sur la base des meilleurs efforts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen und verwalten Sie Floe-Automatisierungen, die das System auf Best-effort-Basis plant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree y gestione las automatizaciones Floe que el sistema programa en función del mejor esfuerzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie e gerencie as automações Floe que o sistema programa com base no melhor esforço."
          }
        }
      }
    },
