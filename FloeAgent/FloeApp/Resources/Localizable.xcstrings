    "providers.auxiliary_models_view.lets_the_model_choose_configured_providers": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the model choose configured providers, image models and parameters per task. The presets below are preferences and fallbacks; when off, the specified model is used."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许模型按任务选择已配置的供应商、图像模型和参数。下方预设作为优先选择和备选；关闭后使用指定模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許模型按任務選擇已配置的供應商、影象模型和引數。下方預設作為優先選擇和備選；關閉後使用指定模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがタスクごとに設定されたプロバイダー、画像モデル、およびパラメータを選択できるようにします。 以下のプリセットは設定とフォールバックです。オフの場合は、指定されたモデルが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 작업당 구성된 제공자, 이미지 모델 및 매개변수를 선택하도록 합니다. 아래 프리셋은 기본 설정 및 대체 설정이며, 끄면 지정된 모델이 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet au modèle de choisir des fournisseurs configurés, des modèles d'image et des paramètres par tâche. Les préréglages ci-dessous sont des préférences et des replis ; lorsqu'ils sont désactivés, le modèle spécifié est utilisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt das Modell konfigurierte Anbieter, Bildmodelle und Parameter pro Aufgabe auswählen. Die folgenden Voreinstellungen sind Einstellungen und Fallbacks; wenn sie ausgeschaltet sind, wird das angegebene Modell verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite al modelo elegir proveedores configurados, modelos de imagen y parámetros por tarea. Los ajustes preestablecidos a continuación son preferencias y respaldos; cuando están apagados, se utiliza el modelo especificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que o modelo escolha provedores configurados, modelos de imagem e parâmetros por tarefa. As predefinições abaixo são preferências e fallbacks; quando desligado, o modelo especificado é usado."
          }
        }
      }
    },
    "providers.auxiliary_models_view.package_review": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Package review"
          }
        },
        "zh-Hans": {
