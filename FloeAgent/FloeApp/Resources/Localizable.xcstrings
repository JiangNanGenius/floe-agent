            "state": "translated",
            "value": "請選擇影片或圖片片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画または画像クリップを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 또는 이미지 클립을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une vidéo ou un clip d'image."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Video- oder Bildclip aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un clip de vídeo o imagen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um clipe de vídeo ou imagem."
          }
        }
      }
    },
    "app.bilingual.b020325442703c69": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动片段或左右边界，也可在下方输入时间。波纹操作仅影响当前轨道。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a clip or its trim handles, or enter times below. Ripple edits affect the current track."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動片段或左右邊界，也可在下方輸入時間。波紋操作僅影響當前軌道。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップまたはそのトリムハンドルをドラッグするか、以下に時間を入力してください。 リップルの編集は現在のトラックに影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립이나 해당 트림 핸들을 끌어다 놓거나 아래에 시간을 입력하십시오. 리플 편집은 현재 트랙에 영향을 미칩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un clip ou ses poignées de garniture, ou entrez les temps ci-dessous. Les modifications d'ondulation affectent la piste actuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Clip oder seine Trimmgriffe, oder geben Sie die Zeiten unten ein. Ripple-Bearbeitungen beeinflussen die aktuelle Spur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un clip o sus asas de recorte, o introduzca los tiempos a continuación. Las ediciones onduladas afectan a la pista actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um clipe ou suas alças de corte ou insira os horários abaixo. As edições Ripple afetam a faixa atual."
          }
        }
      }
    },
