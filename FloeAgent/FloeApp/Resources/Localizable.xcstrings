    "envmgr.layer_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software is looked up by layer; installing only changes the selected environment. Each environment owns its software, data and lifecycle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件按层查找，安装只写入所选环境。每个环境独立管理自己的软件、数据和生命周期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "軟體按層查詢，安裝只寫入所選環境。每個環境獨立管理自己的軟體、資料和生命週期。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェアはレイヤーごとに検索され、インストールは選択された環境のみを変更します。 各環境はそれぞれのソフトウェア、データ、そしてライフサイクルを所有しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어는 레이어별로 조회되며, 설치는 선택된 환경만 변경합니다. 각 환경은 자체 소프트웨어, 데이터 및 라이프사이클을 소유합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le logiciel est recherché par couche ; l'installation ne fait que modifier l'environnement sélectionné. Chaque environnement possède son logiciel, ses données et son cycle de vie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software wird nach Ebenen nachgeschlagen; die Installation ändert nur die ausgewählte Umgebung. Jede Umgebung besitzt ihre Software, Daten und ihren Lebenszyklus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El software se busca por capa; la instalación solo cambia el entorno seleccionado. Cada entorno es dueño de su software, datos y ciclo de vida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O software é pesquisado por camada; a instalação altera apenas o ambiente selecionado. Cada ambiente possui seu software, dados e ciclo de vida."
          }
        }
      }
    },
