    "app.bilingual.bb2848192649b953": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前构建未包含本地说话人识别。已配置服务返回的说话人仍会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local speaker recognition is not included in this build. Speaker labels returned by your service are retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前構建未包含本地說話人識別。已配置服務返回的說話人仍會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドにはローカルスピーカー認識は含まれていません。 貴社のサービスから返却されたスピーカーラベルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지 화자 인식은 이 빌드에 포함되어 있지 않습니다. 귀하의 서비스에서 반환된 스피커 라벨은 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance des orateurs locaux n'est pas incluse dans cette version. Les étiquettes des haut-parleurs retournées par votre service sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Sprechererkennung ist in diesem Build nicht enthalten. Lautsprecheretiketten, die von Ihrem Service zurückgegeben werden, bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de oradores locales no está incluido en esta compilación. Las etiquetas de los altavoces devueltas por su servicio se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento do alto-falante local não está incluído nesta compilação. As etiquetas dos alto-falantes devolvidas pelo seu serviço são mantidas."
          }
        }
      }
    },
    "app.bilingual.3b64d87c1691757a": {
      "extractionState": "manual",
