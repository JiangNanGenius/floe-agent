            "value": "동일한 Office 필드는 한 번에 두 번 수정할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même champ Office ne peut pas être modifié deux fois dans un lot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Office-Feld kann nicht zweimal in einem Stapel geändert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo campo de Office no se puede modificar dos veces en un lote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo campo do Office não pode ser modificado duas vezes em um lote."
          }
        }
      }
    },
