    "cad.ui.export.numericTextNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measurement lines are included. Numeric values are not drawn into the image or video; they remain in the overlay list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像或视频包含测量引导线，但不会绘制数值文字；数值保留在叠加层列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影象或影片包含測量引導線，但不會繪製數值文字；數值保留在疊加層列表中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "測定ラインが含まれています。 数値は画像や動画に描画されません。オーバーレイリストに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "측정선이 포함되어 있습니다. 숫자 값은 이미지나 비디오에 그려지지 않으며, 오버레이 목록에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes de mesure sont incluses. Les valeurs numériques ne sont pas dessinées dans l'image ou la vidéo ; elles restent dans la liste de superposition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messlinien sind enthalten. Numerische Werte werden nicht in das Bild oder Video gezogen; sie bleiben in der Overlay-Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas de medición están incluidas. Los valores numéricos no se dibujan en la imagen o el vídeo; permanecen en la lista de superposiciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas de medição estão incluídas. Valores numéricos não são desenhados na imagem ou no vídeo; eles permanecem na lista de sobreposições."
          }
        }
      }
    },
