    "setup.features.safety.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic approval reviews each concrete action. Offline local approval stays restricted, and system safety boundaries always remain enforced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动审批会审核每个具体动作；离线本地审批保持受限，系统安全边界始终生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動審批會稽核每個具體動作；離線本地審批保持受限，系統安全邊界始終生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動承認は各具体的なアクションをレビューします。 オフラインのローカル承認は制限されたままであり、システムの安全境界は常に適用されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 승인은 각 구체적인 행동을 검토합니다. 오프라인 로컬 승인은 제한된 상태를 유지하고, 시스템 안전 경계는 항상 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approbation automatique examine chaque action concrète. L'approbation locale hors ligne reste restreinte, et les limites de sécurité du système restent toujours appliquées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Genehmigung überprüft jede konkrete Aktion. Die lokale Offline-Genehmigung bleibt eingeschränkt, und die Systemsicherheitsgrenzen bleiben immer durchgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación automática revisa cada acción concreta. La aprobación local fuera de línea permanece restringida, y los límites de seguridad del sistema siempre se aplican."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação automática revisa cada ação concreta. A aprovação local offline permanece restrita e os limites de segurança do sistema sempre permanecem aplicados."
          }
        }
      }
    },
    "setup.features.safety.title": {
      "extractionState": "manual",
      "localizations": {
