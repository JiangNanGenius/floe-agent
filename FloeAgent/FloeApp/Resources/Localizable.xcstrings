    "runtime.content_update.addendum_header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remotely updated guidance (declarative content). Fixed safety, permission and tool rules always take precedence and cannot be updated remotely:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可远程更新的指导内容（声明性内容）。固定安全、权限与工具规则始终优先，且不能远程更新："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可遠端更新的指導內容（宣告性內容）。固定安全、許可權與工具規則始終優先，且不能遠端更新："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートで更新されたガイダンス（宣言的コンテンツ） 固定された安全、権限、ツールのルールは常に優先され、リモートで更新できません："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격으로 업데이트된 안내(선언적 내용). 고정된 안전, 권한 및 도구 규칙은 항상 우선하며 원격으로 업데이트할 수 없습니다:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conseils mis à jour à distance (contenu déclaratif). Les règles de sécurité, d'autorisation et d'outils fixes prévalent toujours et ne peuvent pas être mises à jour à distance :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Update Guidance (Deklarativinhalt). Feste Sicherheits-, Berechtigungs- und Werkzeugregeln haben immer Vorrang und können nicht aus der Ferne aktualisiert werden:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guía actualizada de forma remota (contenido declarativo). Las reglas fijas de seguridad, permiso y herramienta siempre tienen prioridad y no se pueden actualizar de forma remota:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientação atualizada remotamente (conteúdo declarativo). As regras fixas de segurança, permissão e ferramenta sempre têm precedência e não podem ser atualizadas remotamente:"
          }
        }
      }
    },
