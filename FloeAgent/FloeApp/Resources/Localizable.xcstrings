    "portforward.host_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fixed iPad port must be between %1$lld and %2$lld, or leave it blank for automatic assignment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定 iPad 端口必须在 %1$lld–%2$lld 之间，或留空使用自动分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
