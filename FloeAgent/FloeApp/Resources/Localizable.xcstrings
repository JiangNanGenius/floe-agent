    "app.app_environment.background_task_still_running_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long-running task has been executing for 10 minutes and will continue. You can check its progress or stop it at any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个长时任务已执行 10 分钟，将继续执行；可随时查看进度或停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個長時任務已執行 10 分鐘，將繼續執行；可隨時檢視進度或停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長時間実行されているタスクが10分間実行されており、引き続き実行されます。 進行状況を確認することも、いつでも停止することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오랫동안 실행되는 작업이 10분 동안 실행되고 있으며 계속될 것입니다. 진행 상황을 확인하거나 언제든지 중지할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche de longue date est en cours d'exécution depuis 10 minutes et se poursuivra. Vous pouvez vérifier sa progression ou l'arrêter à tout moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine lang laufende Aufgabe wird seit 10 Minuten ausgeführt und wird fortgesetzt. Sie können den Fortschritt jederzeit überprüfen oder stoppen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea de larga duración se ha ejecutado durante 10 minutos y continuará. Puedes comprobar su progreso o detenerlo en cualquier momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa de longa duração está em execução há 10 minutos e continuará. Você pode verificar seu progresso ou pará-lo a qualquer momento."
          }
        }
      }
    },
