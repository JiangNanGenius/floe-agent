    "feedback.error.update_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version is outdated. Update Floe Agent, then try uploading diagnostics again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前软件版本过旧，请更新 Floe Agent 后再上传诊断报告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前軟體版本過舊，請更新 Floe Agent 後再上傳診斷報告。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのバージョンは古くなっています。 Floeエージェントを更新し、診断結果を再度アップロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 버전은 오래되었습니다. Floe 에이전트를 업데이트한 후, 진단을 다시 업로드해 보십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de l'application est obsolète. Mettez à jour l'agent Floe, puis essayez à nouveau de télécharger les diagnostics."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version ist veraltet. Aktualisieren Sie den Floe-Agent, und versuchen Sie dann erneut, Diagnosen hochzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de la aplicación está desactualizada. Actualice Floe Agent y, a continuación, intente cargar los diagnósticos de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do aplicativo está desatualizada. Atualize o Agente Floe e tente fazer upload de diagnósticos novamente."
          }
        }
      }
    },
