    "chat.thread_detail_view_model.continues_the_original_task_and_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continues the original task and message without creating a duplicate; completed tool steps are reused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续原任务和原消息，不会新建重复任务；已经完成的工具步骤会被复用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續原任務和原訊息，不會新建重複任務；已經完成的工具步驟會被複用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重複を作らずに元のタスクとメッセージを続行し、完了したツールステップは再利用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 작업과 메시지를 중복 없이 계속 진행하며, 완료된 도구 단계는 재사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue la tâche et le message d'origine sans créer de doublon ; les étapes d'outil terminées sont réutilisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die ursprüngliche Aufgabe und Nachricht fort, ohne ein Duplikat zu erstellen; abgeschlossene Werkzeugschritte werden wiederverwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa la tarea y el mensaje originales sin crear un duplicado; se reutilizan los pasos de la herramienta completados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a tarefa e a mensagem originais sem criar uma duplicata; as etapas da ferramenta concluída são reutilizadas."
          }
        }
      }
    },
