          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューはプログラムの座標を使用します。 在庫、工具組立、機械チェーンは提供されていません；取り外し、衝突、加工時間は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기는 프로그램 좌표를 사용합니다. 재고, 공구 조립 및 기계 체인이 제공되지 않으며, 제거, 충돌 및 가공 시간은 제공되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu utilise les coordonnées du programme. Le stock, l'ensemble d'outils et la chaîne de la machine ne sont pas fournis ; le temps d'enlèvement, de collision et d'usinage ne sont pas disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau verwendet Programmkoordinaten. Lagerbestand, Werkzeugbaugruppe und Maschinenkette werden nicht mitgeliefert; Entfernungs-, Kollisions- und Bearbeitungszeit sind nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa utiliza las coordenadas del programa. No se suministran existencias, ensamblaje de herramientas y cadena de máquinas; el tiempo de eliminación, colisión y mecanizado no está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização usa as coordenadas do programa. Estoque, conjunto de ferramentas e cadeia de máquinas não são fornecidos; tempo de remoção, colisão e usinagem não estão disponíveis."
          }
        }
      }
    },
