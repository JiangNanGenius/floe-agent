    "settings.git_hub_settings_view.the_connection_completes_automatically_after_authorization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection completes automatically after authorization; Floe checks status at the interval GitHub returns."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后会自动完成连接；Floe 按 GitHub 返回的间隔检查状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "授權後會自動完成連線；Floe 按 GitHub 返回的間隔檢查狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は認可後に自動的に完了します；Floe は GitHub が戻る間隔でステータスを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결은 인증 후 자동으로 완료됩니다; Floe는 GitHub가 돌아오는 간격마다 상태를 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion se termine automatiquement après l'autorisation ; Floe vérifie l'état à l'intervalle GitHub revient."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung wird nach der Autorisierung automatisch abgeschlossen; Floe prüft den Status im Intervall, in dem GitHub zurückkehrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión se completa automáticamente después de la autorización; Floe comprueba el estado en el intervalo GitHub regresa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão é concluída automaticamente após a autorização; Floe verifica o status no intervalo que GitHub retorna."
          }
        }
      }
    },
