    "app.bilingual.82bb0607add46558": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取样色会变为透明，显示下方轨道或画布背景。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key color becomes transparent, revealing the tracks or canvas below."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取樣色會變為透明，顯示下方軌道或畫布背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーカラーが透明になり、下のトラックやキャンバスが現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심 색상이 투명해져 아래의 트랙이나 캔버스를 드러냅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur clé devient transparente, révélant les pistes ou la toile ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüsselfarbe wird transparent und zeigt die Spuren oder Leinwand darunter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color clave se vuelve transparente, revelando las pistas o el lienzo a continuación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cor principal se torna transparente, revelando as faixas ou tela abaixo."
          }
        }
      }
    },
