    "hosts.host_editor_view.device_type_is_informational_only_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device type is informational only; the protocol configuration determines available capabilities. The Floe daemon is not installed unless remote execution is enabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备类型仅供参考；协议配置决定可用能力。未启用远端执行时不会安装 Floe 守护程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置型別僅供參考；協議配置決定可用能力。未啟用遠端執行時不會安裝 Floe 守護程式。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスタイプは情報提供のみです；プロトコル設定が利用可能な機能を決定します。 Floe デーモンは、リモート実行が有効になっていない限りインストールされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치 유형은 정보 전용이며, 프로토콜 구성에 따라 사용 가능한 기능이 결정됩니다. Floe 데몬은 원격 실행이 활성화되지 않으면 설치되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type d'appareil est informatique uniquement ; la configuration du protocole détermine les capacités disponibles. Le démon Floe n'est pas installé à moins que l'exécution à distance ne soit activée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gerätetyp dient nur zu Informationsfunktionen; die Protokollkonfiguration bestimmt die verfügbaren Funktionen. Der Floe-Daemon ist nicht installiert, es sei denn, die Remote-Ausführung ist aktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de dispositivo es solo informativo; la configuración del protocolo determina las capacidades disponibles. El demonio Floe no está instalado a menos que la ejecución remota esté habilitada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tipo de dispositivo é apenas informativo; a configuração do protocolo determina os recursos disponíveis. O daemon Floe não está instalado a menos que a execução remota esteja habilitada."
          }
        }
      }
    },
