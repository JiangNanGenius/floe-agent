    "app.bilingual.3f4a44ae22c1297d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先结束当前录制或处理，再试听。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish recording or processing before auditioning."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先結束當前錄製或處理，再試聽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディションの前に、録音または処理を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디션을 보기 전에 녹음 또는 처리를 완료하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez l'enregistrement ou le traitement avant l'audition."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die Aufnahme oder Verarbeitung vor dem Vorsprechen ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la grabación o el procesamiento antes de la audición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine de gravar ou processar antes de fazer o teste."
          }
        }
      }
    },
    "app.bilingual.2c7552787acbbbac": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伴奏未能开始，录制仍将继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accompaniment could not start. Recording continues without it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伴奏未能開始，錄製仍將繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同行が開始できませんでした。 録音はそれなしで続行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동행을 시작할 수 없습니다. 녹음이 그것 없이 계속됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accompagnement n'a pas pu démarrer. L'enregistrement continue sans lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Begleitung konnte nicht gestartet werden. Die Aufnahme wird ohne sie fortgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acompañamiento no pudo comenzar. La grabación continúa sin ella."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acompanhamento não pôde começar. A gravação continua sem ela."
          }
        }
      }
    },
    "app.bilingual.1a1d8a70f23e199d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容太短，已改为单次录制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project is too short, so a single take was recorded instead."
          }
