    "cad.workbench.drawing.fitIncompatible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 fits apply to a diameter or a length, not a radius or an angle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 配合适用于直径或长度，不适用于半径或角度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 配合適用於直徑或長度，不適用於半徑或角度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 の適合は、半径や角度ではなく、直径または長さに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 피팅은 반지름이나 각도가 아니라 직경이나 길이에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ajustements ISO 286 s'appliquent à un diamètre ou à une longueur, pas à un rayon ou à un angle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 passt auf einen Durchmesser oder eine Länge, nicht auf einen Radius oder einen Winkel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ISO 286 se ajusta a un diámetro o una longitud, no a un radio o un ángulo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ajustes ISO 286 se aplicam a um diâmetro ou comprimento, não a um raio ou ângulo."
          }
        }
      }
    },
