    "app.bilingual.7f59c03e83657b4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联网刷新目录后才能搜索和安装元件。已有设计不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the catalogue to search and install parts. Existing designs are unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯網重新整理目錄後才能搜尋和安裝元件。已有設計不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログを更新して、部品を検索し、インストールしてください。 既存のデザインは影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그를 새로 고쳐 부품을 검색하고 설치하십시오. 기존 디자인은 영향을 받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualisez le catalogue pour rechercher et installer des pièces. Les conceptions existantes ne sont pas affectées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie den Katalog, um Teile zu suchen und zu installieren. Bestehende Designs sind nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza el catálogo para buscar e instalar piezas. Los diseños existentes no se ven afectados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize o catálogo para pesquisar e instalar peças. Os projetos existentes não são afetados."
          }
        }
      }
    },
