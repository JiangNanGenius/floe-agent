    "app.bilingual.e30158b8c971e928": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在现有“源代码管理”设置中登录；此处不会保存令牌。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in through the existing Source Control settings first; no token is stored here."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在現有“原始碼管理”設定中登入；此處不會儲存令牌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、既存のソースコントロール設定からサインインしてください。ここにはトークンが保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 기존 소스 제어 설정을 통해 로그인하십시오; 여기에는 토큰이 저장되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous d'abord via les paramètres de contrôle de source existants ; aucun jeton n'est stocké ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melden Sie sich zuerst über die vorhandenen Source-Control-Einstellungen an; hier ist kein Token gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero inicie sesión a través de la configuración de control de código fuente existente; aquí no se almacena ningún token."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça login através das configurações de Controle de Fonte existentes primeiro; nenhum token é armazenado aqui."
          }
        }
      }
    },
