    "workspace.text_file_editor_view.local_execution_uses_posix_sh_convert": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local execution uses POSIX sh; convert bash, zsh and fish scripts first, or run them on a remote host."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地运行使用 POSIX sh；bash、zsh、fish 脚本请先转换，或在远程主机运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地執行使用 POSIX sh；bash、zsh、fish 指令碼請先轉換，或在遠端主機執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル実行は POSIX sh を使用します。まず bash、zsh、fish スクリプトを変換するか、リモートホストで実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 실행은 POSIX sh를 사용합니다; 먼저 bash, zsh 및 fish 스크립트를 변환하거나 원격 호스트에서 실행합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution locale utilise POSIX sh ; convertissez d'abord les scripts bash, zsh et fish, ou exécutez-les sur un hôte distant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die lokale Ausführung verwendet POSIX sh; konvertieren Sie zuerst bash-, zsh- und fish-Skripte oder führen Sie sie auf einem Remote-Host aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
