    "settings.storage_optimization.file_change_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files can share storage, so this value is not the amount freed on the device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件可能共享存储，此项不等于设备释放量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案可能共享儲存，此項不等於裝置釋放量。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはストレージを共有できるため、この値はデバイス上で解放された量ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 저장소를 공유할 수 있으므로, 이 값은 장치에서 확보된 금액이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers peuvent partager le stockage, donc cette valeur n'est pas la quantité libérée sur l'appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien können den Speicher gemeinsam nutzen, daher ist dieser Wert nicht die Menge, die auf dem Gerät freigegeben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos pueden compartir almacenamiento, por lo que este valor no es la cantidad liberada en el dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos podem compartilhar armazenamento, portanto, esse valor não é a quantidade liberada no dispositivo."
          }
        }
      }
    },
    "settings.storage_optimization.guest_unchanged": {
