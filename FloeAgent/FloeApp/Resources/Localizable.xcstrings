    "app.bilingual.19280e6766de9dad": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到兼容的串口通道。请确认设备支持低功耗蓝牙串口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible serial channel was found. Check that the device supports BLE serial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到相容的串列埠通道。請確認裝置支援低功耗藍芽串列埠。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性のあるシリアルチャンネルが見つかりませんでした。 デバイスがBLEシリアルに対応しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환 가능한 시리얼 채널을 찾을 수 없습니다. 장치가 BLE 시리얼을 지원하는지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun canal série compatible n'a été trouvé. Vérifiez que l'appareil prend en charge la série BLE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein kompatibler serieller Kanal gefunden. Überprüfen Sie, ob das Gerät die BLE-Serie unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún canal serie compatible. Compruebe que el dispositivo sea compatible con el número de serie BLE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum canal serial compatível foi encontrado. Verifique se o dispositivo suporta série BLE."
          }
        }
      }
    },
    "app.bilingual.46a7a8f62f4ed14d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备正在连接或断开，请稍后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device is busy connecting or disconnecting. Try again shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置正在連線或斷開，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスは接続中または切断中です。 すぐにもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치가 연결 중이거나 연결을 끊는 중입니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil est occupé à se connecter ou à se déconnecter. Réessayez sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät ist mit dem Verbinden oder Trennen beschäftigt. Versuchen Sie es in Kürze erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo está ocupado conectándose o desconectándose. Inténtalo de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo está ocupado conectando ou desconectando. Tente novamente em breve."
          }
        }
      }
    },
    "app.bilingual.efb3f2cd8c9118b4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备未响应。请靠近设备并重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device did not respond. Move closer and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置未響應。請靠近裝置並重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが応答しませんでした。 近づいて、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장치가 응답하지 않았습니다. 가까이 다가가서 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil n'a pas répondu. Rapprochez-vous et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät reagierte nicht. Bewegen Sie sich näher und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo no respondió. Acércate y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo não respondeu. Aproxime-se e tente novamente."
          }
        }
      }
    },
    "app.bilingual.c046c6b4699a20a1": {
      "extractionState": "manual",
      "localizations": {
