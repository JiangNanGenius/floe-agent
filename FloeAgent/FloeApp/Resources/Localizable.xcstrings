    "environment.tools.routes.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only direct bundled commands and installed signed artifacts run on device. Remote-limited tools need a paired host with the tool on PATH; unsupported entries are never installed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有内置直接命令与已安装的签名产物可在本机运行。远程限定需要配对主机且对端 PATH 中存在该工具；不支持的项目不会被安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有內建直接命令與已安裝的簽名產物可在本機執行。遠端限定需要配對主機且對端 PATH 中存在該工具；不支援的專案不會被安裝。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上で実行されるのは、直接バンドルされたコマンドとインストールされた署名付きアーティファクトのみです。 リモート限定ツールは、PATH上のツールとペアになったホストが必要です；サポートされていないエントリは決してインストールされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 번들된 명령과 설치된 서명된 아티팩트만 기기에서 실행됩니다. 원격 제한 도구는 PATH에 있는 도구와 페어링된 호스트가 필요합니다; 지원되지 않는 항목은 절대 설치되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les commandes directes groupées et les artefacts signés installés s'exécutent sur l'appareil. Les outils limités à distance ont besoin d'un hôte jumelé avec l'outil sur PATH ; les entrées non prises en charge ne sont jamais installées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät werden nur direkte gebündelte Befehle und installierte signierte Artefakte ausgeführt. Remote-beschränkte Tools benötigen einen gekoppelten Host mit dem Tool auf PATH; nicht unterstützte Einträge werden niemals installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo los comandos directos y los artefactos firmados instalados se ejecutan en el dispositivo. Las herramientas remotas limitadas necesitan un host emparejado con la herramienta en PATH; las entradas no compatibles nunca se instalan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente comandos diretos agrupados e artefatos assinados instalados são executados no dispositivo. Ferramentas limitadas remotamente precisam de um host emparelhado com a ferramenta no PATH; entradas não suportadas nunca são instaladas."
          }
        }
      }
    },
