    "chat.approval_card_view.this_creates_a_skill_saved_to": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates a skill saved to the skill library, available to all tasks afterward. Approving confirms the save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作会创建一个技能并保存到技能库，之后对所有任务可用。批准即确认保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會建立一個技能並儲存到技能庫，之後對所有任務可用。批准即確認儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、スキルがスキルライブラリに保存され、以降のすべてのタスクで利用可能になります。 承認により保存が確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 스킬 라이브러리에 저장된 스킬을 생성하며, 이후 모든 작업에서 사용할 수 있습니다. 승인하면 저장이 확인됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela crée une compétence enregistrée dans la bibliothèque de compétences, disponible pour toutes les tâches par la suite. L'approbation confirme la sauvegarde."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird ein Skill erstellt, der in der Skill-Bibliothek gespeichert wird und danach für alle Aufgaben verfügbar ist. Die Genehmigung bestätigt die Speicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto crea una habilidad guardada en la biblioteca de habilidades, disponible para todas las tareas después. La aprobación confirma el guardado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso cria uma habilidade salva na biblioteca de habilidades, disponível para todas as tarefas depois. A aprovação confirma o salvamento."
          }
        }
      }
    },
