    "settings.sync.configuration.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs providers, model settings, defaults, and onboarding preferences through your private CloudKit database. Changes made while paused stay on this device and are queued for later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你的私有 CloudKit 数据库同步供应商、模型设置、默认选择和向导偏好。暂停期间的更改保留在本机，并会排队等待以后同步。"
          }
        }
      }
    },
    "settings.sync.configuration.header": {
      "extractionState": "manual",
