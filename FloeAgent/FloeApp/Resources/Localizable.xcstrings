    "app.bilingual.972b6f905ceace24": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里管理已收集的存档。停止游戏后更新列表；导入或恢复的存档在下次运行时使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the collected saves. The list updates after stopping. Imported or restored saves are used on the next run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡管理已收集的存檔。停止遊戲後更新列表；匯入或恢復的存檔在下次執行時使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは収集されたセーブです。 リストは停止後に更新されます。 インポートまたは復元されたセーブは、次回の実行時に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 수집된 저장입니다. 목록은 멈춘 후에 업데이트됩니다. 다음 실행 시 가져온 또는 복원된 저장이 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les sauvegardes collectées. La liste se met à jour après l'arrêt. Les sauvegardes importées ou restaurées sont utilisées lors de l'exécution suivante."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind die gesammelten Speichern. Die Liste wird nach dem Stoppen aktualisiert. Importierte oder wiederhergestellte Speicherstände werden beim nächsten Lauf verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son los guardados recogidos. La lista se actualiza después de detenerse. Los guardados importados o restaurados se utilizan en la siguiente ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes são os salvamentos coletados. A lista é atualizada após a interrupção. Salvamentos importados ou restaurados são usados na próxima execução."
          }
        }
      }
    },
