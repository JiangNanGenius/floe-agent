          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup überschreitet das Größenlimit (64 MB für den In-Memory-Export, 2 GB für den Dateiexport)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad supera el límite de tamaño (64 MB para la exportación en memoria, 2 GB para la exportación de archivos)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup excede o limite de tamanho (64 MB para exportação na memória, 2 GB para exportação de arquivos)."
          }
