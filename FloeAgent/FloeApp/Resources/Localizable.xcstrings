    "cad.error.shellNoGeometry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shell produced no geometry — try a thinner wall."
          }
        },
        "zh-Hans": {
