    "cad.mesh.error.closed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document closed while the mesh operation ran; nothing was applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格操作进行时文档已关闭；没有应用任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格操作進行時文件已關閉；沒有應用任何更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッシュ操作が実行されている間、ドキュメントが閉じました。何も適用されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시 작업이 실행되는 동안 문서가 닫혔으며, 아무 것도 적용되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document s'est fermé pendant que l'opération de maillage était en cours d'en cours d'application ; rien n'a été appliqué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde geschlossen, während der Mesh-Vorgang lief; es wurde nichts angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento se cerró mientras se realizaba la operación de malla; no se aplicó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento fechou enquanto a operação de malha era executada; nada foi aplicado."
          }
        }
      }
    },
