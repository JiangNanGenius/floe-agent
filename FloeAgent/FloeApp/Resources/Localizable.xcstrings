    "cad.uv.pickEdge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate the view, then tap an edge to mark or clear a seam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旋转视图后，点选边来标记或清除接缝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旋轉檢視後，點選邊來標記或清除接縫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューを回転させ、エッジをタップして継ぎ目をマーキングまたはクリアしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰를 회전한 다음, 가장자리를 탭하여 이음새를 표시하거나 비워 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites pivoter la vue, puis appuyez sur un bord pour marquer ou effacer une coute."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie die Ansicht und tippen Sie dann auf einen Rand, um eine Naht zu markieren oder zu löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gira la vista y, a continuación, pulsa un borde para marcar o borrar una costa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire a vista e, em seguida, toque em uma borda para marcar ou limpar uma costura."
          }
        }
      }
    },
    "cad.uv.pickIsland": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap islands to select them, then apply a move, rotation or scale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选 UV 岛，再应用移动、旋转或缩放。"
          }
        },
        "zh-Hant": {
