    "notes.notes_linked_mind_maps.the_mind_map_is_saved_independently": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mind map is saved independently and also appears in the Notes mind map list. Unlinking or deleting this document does not delete the mind map."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导图独立保存，也会出现在手记的导图列表中。解除关联或删除这份文档，不会删除导图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導圖獨立儲存，也會出現在手記的導圖列表中。解除關聯或刪除這份文件，不會刪除導圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マインドマップは独立して保存され、Notes のマインドマップリストにも表示されます。 この文書のリンクを解除または削除しても、マインドマップは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마인드맵은 독립적으로 저장되며 Notes 마인드맵 목록에도 표시됩니다. 이 문서를 연결 해제하거나 삭제해도 마인드맵은 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La carte mentale est enregistrée indépendamment et apparaît également dans la liste de la carte mentale Notes. Le fait de dissocier ou de supprimer ce document ne supprime pas la carte mentale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mindmap wird unabhängig voneinander gespeichert und erscheint auch in der Mindmap-Liste \"Notizen\". Wenn Sie die Verknüpfung oder das Löschen dieses Dokuments aufhen, wird die Mind Map nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapa mental se guarda de forma independiente y también aparece en la lista de mapas mentales de Notas. Desvincular o eliminar este documento no elimina el mapa mental."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapa mental é salvo de forma independente e também aparece na lista do mapa mental Notas. Desvincular ou excluir este documento não exclui o mapa mental."
          }
        }
      }
    },
