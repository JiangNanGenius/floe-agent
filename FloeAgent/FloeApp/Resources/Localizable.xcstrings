    "cad.versions.recovery.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes only the unpublished checkpoint “%@”. The current design, visible versions and external project files are not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会删除未发布的检查点“%@”。当前设计、可见版本和外部工程文件均不会被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除未釋出的檢查點“%@”。當前設計、可見版本和外部工程檔案均不會被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、未公開のチェックポイント「%@」のみが削除されます。 現在のデザイン、表示されているバージョン、および外部プロジェクトファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 미공개 체크포인트 “%@”만 제거합니다. 현재 디자인, 보이는 버전 및 외부 프로젝트 파일은 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement le point de contrôle non publié \"%@\". La conception actuelle, les versions visibles et les fichiers de projet externes ne sont pas modifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird nur der unveröffentlichte Checkpoint \"%@\" entfernt. Das aktuelle Design, die sichtbaren Versionen und die externen Projektdateien werden nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina solo el punto de control no publicado \"%@\". El diseño actual, las versiones visibles y los archivos de proyecto externos no se modifican."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove apenas o ponto de verificação não publicado “%@”. O design atual, as versões visíveis e os arquivos de projeto externos não são alterados."
          }
        }
      }
    },
    "cad.versions.recovery.outcome.recovered": {
