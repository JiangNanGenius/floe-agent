    "memory.memory_view.you_organize_confirmed_long_term_personalization": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You organize confirmed long-term personalization memories, outputting only a stable document without dates or temporary task status, and never inferring sensitive facts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你负责整理已确认的长期个性化记忆，只输出不含日期和临时任务状态的稳定文档正文，不推断敏感事实。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你負責整理已確認的長期個性化記憶，只輸出不含日期和臨時任務狀態的穩定文件正文，不推斷敏感事實。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みの長期パーソナライズ記憶を整理し、日付や一時的なタスクステータスのない安定した文書のみを出力し、機密事実を推測しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하는 확인된 장기 개인화 기억을 정리하고, 날짜나 임시 작업 상태 없이 안정적인 문서만 출력하며, 민감한 사실을 추론하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous organisez des souvenirs de personnalisation confirmés à long terme, en ne produisant qu'un document stable sans dates ni statut de tâche temporaire, et en ne inférant jamais de faits sensibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie organisieren bestätigte Langzeit-Personalisierungsspeicher, geben nur ein stabiles Dokument ohne Daten oder temporären Aufgabenstatus aus und schließen niemals sensible Fakten ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizas recuerdos de personalización confirmados a largo plazo, produciendo solo un documento estable sin fechas o estado temporal de la tarea, y nunca infiriendo hechos delicados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você organiza memórias de personalização confirmadas de longo prazo, produzindo apenas um documento estável sem datas ou status de tarefa temporária, e nunca inferindo fatos sensíveis."
          }
        }
      }
    },
