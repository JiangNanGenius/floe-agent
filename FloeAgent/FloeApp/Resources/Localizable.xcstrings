    "shortcuts.intent.send_to_floe.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send text to Floe Agent for processing (summaries, analysis, etc.)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把文字发给 Floe Agent 处理（总结、分析等）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把文字發給 Floe Agent 處理（總結、分析等）"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floeエージェントにテキストを送信し、処理（要約、分析等）してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 에이전트에게 텍스트를 보내어 처리(요약, 분석 등)를 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez du texte à l'agent Floe pour traitement (résumés, analyse, etc.)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senden Sie Text an Floe Agent zur Bearbeitung (Zusammenfassungen, Analysen usw.)."
