    "app.bilingual.e9c7beffbb4abcae": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通浏览继续使用设备上现有的网站数据。只有你明确点击删除时才会清除 Cookie 和登录状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinary browsing keeps the website data already on this device. Cookies and login state are cleared only when you explicitly delete them."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "普通瀏覽繼續使用裝置上現有的網站資料。只有你明確點選刪除時才會清除 Cookie 和登入狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の閲覧は、このデバイスにすでに保存されているウェブサイトデータを保持します。 クッキーとログイン状態は、明示的に削除した場合にのみクリアされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 브라우징은 이미 이 장치에 웹사이트 데이터를 보관합니다. 쿠키와 로그인 상태는 명시적으로 삭제할 경우에만 초기화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La navigation ordinaire conserve les données du site Web déjà sur cet appareil. Les cookies et l'état de connexion ne sont effacés que lorsque vous les supprimez explicitement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Normales Surfen speichert die Website-Daten bereits auf diesem Gerät. Cookies und Anmeldestatus werden nur gelöscht, wenn Sie sie explizit löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La navegación ordinaria mantiene los datos del sitio web ya en este dispositivo. Las cookies y el estado de inicio de sesión se borran solo cuando las eliminas explícitamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A navegação comum mantém os dados do site já neste dispositivo. Os cookies e o estado de login são apagados somente quando você os exclui explicitamente."
          }
        }
      }
    },
