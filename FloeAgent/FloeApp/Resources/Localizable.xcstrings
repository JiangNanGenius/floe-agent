    "settings.privacy.keychain.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys and host credentials live only in Keychain. The settings center shows whether they are configured — never the values."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 与主机凭证只存于钥匙串。设置中心仅显示是否已配置，绝不回显内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key 與主機憑證只存於鑰匙串。設定中心僅顯示是否已配置，絕不回顯內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーとホストの認証情報は、キーチェーンにのみあります。 設定センターはそれらが構成されているかどうかを示します—決して値ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키와 호스트 자격 증명은 키체인에만 있습니다. 설정 센터는 설정이 구성되어 있는지 여부를 표시하며, 값은 절대 표시하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API et les informations d'identification de l'hôte sont en direct uniquement dans le trousseau. Le centre de paramètres indique s'ils sont configurés - jamais les valeurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel und Host-Anmeldeinformationen sind nur im Schlüsselbund verfügbar. Das Einstellungscenter zeigt an, ob sie konfiguriert sind - niemals die Werte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API y las credenciales de host solo están activas en el llavero. El centro de configuración muestra si están configurados, nunca los valores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves API e as credenciais do host estão ativas apenas no Keychain. O centro de configurações mostra se eles estão configurados — nunca os valores."
          }
        }
      }
    },
