    "app.bilingual.7e59f600e97cb1c3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择原内容在新画布中的位置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where the existing content sits in the new canvas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇原內容在新畫布中的位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいキャンバスで既存のコンテンツが配置される位置を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 캔버스에서 기존 콘텐츠가 배치되는 위치를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où se trouve le contenu existant dans la nouvelle toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie aus, wo sich der vorhandene Inhalt in der neuen Leinwand befindet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija dónde se encuentra el contenido existente en el nuevo lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde o conteúdo existente fica na nova tela."
          }
        }
      }
    },
    "app.bilingual.aa68c3b60feb34db": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽高须为 1–16384 像素，总像素不超过 6400 万。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–16384 pixels per edge, up to 64 megapixels total."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寬高須為 1–16384 畫素，總畫素不超過 6400 萬。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジごとに1〜16384ピクセルを使用し、合計で最大64メガピクセルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 가장자리당 1–16384픽셀을 사용하고, 총 64메가픽셀까지 가능합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1 à 16384 pixels par bord, jusqu'à 64 mégapixels au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie 1–16384 Pixel pro Kante, insgesamt bis zu 64 Megapixel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa entre 1 y 16384 píxeles por borde, hasta 64 megapíxeles en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–16384 pixels por borda, até 64 megapixels no total."
          }
        }
      }
    },
