        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 디자인을 저장하면 나중에 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce design afin de pouvoir le restaurer plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie dieses Design, damit Sie es später wiederherstellen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este diseño para que puedas restaurarlo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve este design para que você possa restaurá-lo mais tarde."
          }
        }
      }
    },
    "cad.versions.help.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How versions and Undo work"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本与撤销的工作方式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本與撤銷的工作方式"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンと元に戻すの仕組み"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 및 실행 취소 작동 방식"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment fonctionnent les versions et Annuler"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Versionen und Rückgängig funktionieren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo funcionan las versiones y Deshacer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como funcionam as versões e Desfazer"
          }
        }
      }
    },
    "cad.versions.help.undo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Undo and Redo cover edits in this open editing session only. They are not saved, and they do not reach across closing and reopening the document."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销和重做仅覆盖当前打开的编辑会话，不会被保存，也不会跨越关闭并重新打开文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷和重做僅覆蓋當前開啟的編輯會話，不會被儲存，也不會跨越關閉並重新開啟文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオープン編集セッションでのみ、カバーの編集を取り消し、やり直してください。 それらは保存されず、文書を閉じて再度開く際にも届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 공개 편집 세션에서만 커버 편집을 실행 취소하고 다시 실행하십시오. 그것들은 저장되지 않았으며, 문서를 닫고 다시 열 때도 도달하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler et refaire les modifications de couverture dans cette session d'édition ouverte uniquement. Ils ne sont pas enregistrés, et ils n'atteignent pas la fermeture et la réouverture du document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover-Bearbeitungen nur in dieser offenen Bearbeitungssitzung rückgängig machen und rückgängig machen. Sie werden nicht gespeichert und erreichen das Schließen und Wiedereröffnen des Dokuments nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deshacer y rehacer ediciones de portada solo en esta sesión de edición abierta. No se guardan, y no llegan a través del cierre y reapertura del documento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfazer e refazer edições de capa somente nesta sessão de edição aberta. Eles não são salvos e não alcançam o fechamento e a reabertura do documento."
          }
        }
      }
    },
    "cad.versions.help.checkpoint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating a named version saves any pending edits first, then stores one complete checkpoint. It does not add an Undo step and is not an automatic copy of every CAD edit."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建命名版本会先保存待定编辑，再存储一个完整检查点。它不会增加撤销步骤，也不是每次 CAD 编辑的自动副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立命名版本會先儲存待定編輯，再儲存一個完整檢查點。它不會增加撤銷步驟，也不是每次 CAD 編輯的自動副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きバージョンを作成すると、まず保留中の編集を保存し、次に完全なチェックポイントを1つ保存します。 元に戻すステップは追加せず、すべての CAD 編集の自動コピーではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명명된 버전을 생성하면 먼저 보류 중인 편집을 저장하고, 그 다음 하나의 전체 체크포인트를 저장합니다. 실행 취소 단계가 추가되지 않으며, 모든 CAD 편집이 자동으로 복사되는 것이 아닙니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La création d'une version nommée enregistre d'abord toutes les modifications en attente, puis stocke un point de contrôle complet. Il n'ajoute pas d'étape Annuler et n'est pas une copie automatique de chaque modification CAD."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Erstellen einer benannten Version werden zunächst alle ausstehenden Änderungen gespeichert und dann ein vollständiger Kontrollpunkt gespeichert. Es fügt keinen Rückgängig-Schritt hinzu und ist keine automatische Kopie jeder CAD-Bearbeitung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La creación de una versión con nombre guarda primero cualquier edición pendiente y luego almacena un punto de control completo. No añade un paso para deshacer y no es una copia automática de cada edición de CAD."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A criação de uma versão nomeada salva quaisquer edições pendentes primeiro e, em seguida, armazena um ponto de verificação completo. Não adiciona uma etapa de Desfazer e não é uma cópia automática de todas as edições do CAD."
          }
        }
      }
    },
    "cad.versions.help.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring a version starts a new Undo boundary. The document from just before the restore is saved as a recovery version, so you can return to it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复版本会开启新的撤销边界。恢复前的文档会保存为恢复版本，你可以回到该状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復版本會開啟新的撤銷邊界。恢復前的文件會儲存為恢復版本，你可以回到該狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンを復元すると、新しいUndo境界が開始されます。 復元直前のドキュメントはリカバリ版として保存されますので、再度参照できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전을 복원하면 새로운 실행 취소 경계가 시작됩니다. 복원 직전의 문서는 복구 버전으로 저장되므로, 해당 문서로 돌아가실 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration d'une version démarre une nouvelle limite d' UndoUndo. Le document juste avant la restauration est enregistré en tant que version de récupération, afin que vous puissiez y revenir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellen einer Version beginnt eine neue Rückgängig-Grenze. Das Dokument von kurz vor der Wiederherstellung wird als Wiederherstellungsversion gespeichert, so dass Sie darauf zurückkommen können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar una versión inicia un nuevo límite de deshacer. El documento de justo antes de la restauración se guarda como una versión de recuperación, para que pueda volver a él."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar uma versão inicia um novo limite de Desfazer. O documento de pouco antes da restauração é salvo como uma versão de recuperação, para que você possa retornar a ele."
          }
        }
      }
    },
    "cad.versions.help.contents": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A version includes geometry and B-rep/mesh data, materials and embedded textures, assembly, drawings, presentation and animation state. External part-reference files are not copied or deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本包含几何与 B-rep/网格数据、材质与内嵌贴图、装配、图纸、演示和动画状态。外部零件引用文件不会被复制或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本包含幾何與 B-rep/網格資料、材質與內嵌貼圖、裝配、圖紙、演示和動畫狀態。外部零件引用檔案不會被複制或刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョンには、ジオメトリおよびB-rep/メッシュデータ、マテリアルと埋め込みテクスチャ、アセンブリ、図面、プレゼンテーション、アニメーション状態が含まれます。 外部部品参照ファイルはコピーも削除もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전에는 기하학 및 B-rep/메시 데이터, 재료 및 삽입 텍스처, 어셈블리, 도면, 프레젠테이션 및 애니메이션 상태가 포함됩니다. 외부 부품 참조 파일은 복사되거나 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version comprend des données géométriques et B-rep/mesh, les matériaux et les textures intégrées, l'assemblage, les dessins, la présentation et l'état de l'animation. Les fichiers de référence de pièces externes ne sont ni copiés ni supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Version enthält Geometrie- und B-Rep/Mesh-Daten, Materialien und eingebettete Texturen, Baugruppen, Zeichnungen, Präsentations- und Animationsstatus. Externe Teilereferenzdateien werden nicht kopiert oder gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión incluye datos de geometría y B-rep/mesh, materiales y texturas incrustadas, ensamblaje, dibujos, presentación y estado de animación. Los archivos de referencia de piezas externas no se copian ni se eliminan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão inclui dados de geometria e B-rep/mesh, materiais e texturas incorporadas, montagem, desenhos, apresentação e estado de animação. Os arquivos de referência de peças externas não são copiados ou excluídos."
          }
        }
      }
    },
    "cad.versions.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document is read-only. You can list and compare versions, but not create, restore or delete them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档为只读。你可以列出和比较版本，但不能创建、恢复或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件為只讀。你可以列出和比較版本，但不能建立、恢復或刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は読み取り専用です。 バージョンを一覧表示および比較できますが、作成、復元、削除はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 읽기 전용입니다. 버전을 나열하고 비교할 수 있지만, 생성, 복원 또는 삭제는 할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document est en lecture seule. Vous pouvez lister et comparer les versions, mais pas les créer, les restaurer ou les supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument ist schreibgeschützt. Sie können Versionen auflisten und vergleichen, aber nicht erstellen, wiederherstellen oder löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento es de solo lectura. Puede enumerar y comparar versiones, pero no crearlas, restaurarlas o eliminarlas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento é somente leitura. Você pode listar e comparar versões, mas não criá-las, restaurá-las ou excluí-las."
          }
        }
      }
    },
