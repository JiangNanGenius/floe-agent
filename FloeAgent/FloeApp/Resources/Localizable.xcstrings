    "notification.unreachable.environment.deleted_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This environment may have been deleted; the execution environment list is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境可能已被删除，已为你打开执行环境列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該環境可能已被刪除，已為你開啟執行環境列表。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境は削除された可能性があります；実行環境リストは開いています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경이 삭제되었을 수 있습니다; 실행 환경 목록이 열려 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet environnement a peut-être été supprimé ; la liste des environnements d'exécution est ouverte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Umgebung wurde möglicherweise gelöscht; die Liste der Ausführungsumgebung ist geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entorno puede haber sido eliminado; la lista de entornos de ejecución está abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ambiente pode ter sido excluído; a lista de ambientes de execução está aberta."
          }
        }
      }
    },
    "notification.unreachable.environment.stopped_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This environment is not running; the execution environment list is open so you can start it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境当前未运行，已打开执行环境列表，可重新启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該環境當前未執行，已開啟執行環境列表，可重新啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境は実行されていません。実行環境リストは開いているので、再度開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경은 실행 중이 아니며, 실행 환경 목록이 열려 있으므로 다시 시작할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet environnement ne fonctionne pas ; la liste des environnements d'exécution est ouverte afin que vous puissiez la recommencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Umgebung wird nicht ausgeführt; die Liste der Ausführungsumgebungen ist geöffnet, so dass Sie sie erneut starten können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este entorno no se está ejecutando; la lista de entornos de ejecución está abierta para que pueda iniciarla de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ambiente não está em execução; a lista de ambientes de execução está aberta para que você possa iniciá-la novamente."
          }
        }
      }
    },
