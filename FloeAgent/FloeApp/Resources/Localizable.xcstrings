    "app.bilingual.ae163b210448df48": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他配置使用的共享凭据和独立应用数据会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared credentials used elsewhere and data in separate apps are kept."
          }
