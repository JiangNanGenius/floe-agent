          "stringUnit": {
            "state": "translated",
            "value": "보조 시각을 사용할 수 없습니다; 기기 내 텍스트 인식을 사용하여 가독성 있는 콘텐츠를 정리했습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vision auxiliaire n'est pas disponible ; la reconnaissance de texte sur l'appareil a été utilisée pour organiser le contenu lisible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Hilfssicht ist nicht verfügbar; die Texterkennung auf dem Gerät wurde verwendet, um lesbare Inhalte zu organisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La visión auxiliar no está disponible; el reconocimiento de texto en el dispositivo se utilizó para organizar el contenido legible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visão auxiliar não está disponível; o reconhecimento de texto no dispositivo foi usado para organizar o conteúdo legível."
          }
        }
      }
    },
