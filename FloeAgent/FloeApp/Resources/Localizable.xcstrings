        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatted content replaces the selected strokes; it can still be undone after applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式化内容会替换所选笔迹；应用后仍可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "格式化內容會替換所選筆跡；應用後仍可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書式設定されたコンテンツは選択されたストロークを置き換えますが、適用後でも元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포맷된 콘텐츠는 선택된 스트로크를 대체합니다; 적용한 후에도 여전히 되돌릴 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu formaté remplace les traits sélectionnés ; il peut toujours être défait après l'application."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der formatierte Inhalt ersetzt die ausgewählten Striche; er kann nach der Anwendung immer noch rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido formateado reemplaza los trazos seleccionados; todavía se puede deshacer después de aplicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O conteúdo formatado substitui os traços selecionados; ele ainda pode ser desfeito após a aplicação."
          }
        }
      }
    },
