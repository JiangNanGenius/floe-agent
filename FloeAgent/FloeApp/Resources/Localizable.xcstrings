    "app.workspace_canvas_view.the_video_was_exported_the": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频已导出；原画布或节点已改变，请从素材库插入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The video was exported; the canvas or node changed, so insert it from the material library."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影片已匯出；原畫布或節點已改變，請從素材庫插入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオがエクスポートされました。キャンバスまたはノードが変更されたので、マテリアルライブラリから挿入してください。"
