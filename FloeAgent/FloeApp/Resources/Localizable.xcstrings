    "app.bilingual.d18ea8c9bd962119": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长期目标已暂停，本轮继续执行。可用输入框的停止按钮结束本轮。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-term advancement is paused; this round continues. Use Stop in the composer to end this round."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "長期目標已暫停，本輪繼續執行。可用輸入框的停止按鈕結束本輪。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長期的な進展は一時停止されており、このラウンドは継続しています。 コンポーザーで「Stop」を使用してこのラウンドを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장기적인 진전이 일시 중단되었습니다; 이번 라운드는 계속됩니다. 컴포저에서 “Stop”을 사용하여 이 라운드를 종료하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'avancement à long terme est en pause ; ce tour se poursuit. Utilisez Stop dans le compositeur pour terminer ce tour."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langfristige Fortschritte werden pausiert; diese Runde geht weiter. Verwenden Sie Stop im Composer, um diese Runde zu beenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El avance a largo plazo está en pausa; esta ronda continúa. Usa Stop en el compositor para terminar esta ronda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O avanço de longo prazo está em pausa; esta rodada continua. Use Stop no compositor para terminar esta rodada."
          }
        }
      }
    },
