    "app.bilingual.6a0865213d01423d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若文件已有新的修改，将保留新内容并停止恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the file has newer edits, they are kept and restoration stops."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若檔案已有新的修改，將保留新內容並停止恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルに新しい編集がある場合、それらは保持され、復元は停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일에 최신 편집이 있는 경우, 해당 편집은 유지되며 복원은 중단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le fichier a de nouvelles modifications, elles sont conservées et la restauration s'arrête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Datei neuere Änderungen enthält, werden diese beibehalten und die Wiederherstellung wird gestoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el archivo tiene ediciones más recientes, se mantienen y la restauración se detiene."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o arquivo tiver edições mais recentes, elas serão mantidas e a restauração será interrompida."
          }
        }
      }
    },
