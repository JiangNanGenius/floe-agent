          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento requer sua senha de edição. Digite-o no editor."
          }
        }
      }
    },
    "app.bilingual.6894667248911dcc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器尚未确认可编辑状态；若仍只读，请稍后重试或解除文档限制。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor has not confirmed an editable state yet; retry shortly, or remove the document restriction."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器尚未確認可編輯狀態；若仍只讀，請稍後重試或解除文件限制。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタはまだ編集可能な状態を確認していません。すぐに再試行するか、ドキュメントの制限を解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집자가 아직 편집 가능한 상태를 확인하지 않았습니다; 곧 다시 시도하시거나 문서 제한을 해제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur n'a pas encore confirmé un état modifiable ; réessayez sous peu, ou supprimez la restriction du document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Redakteur hat einen bearbeitbaren Status noch nicht bestätigt; versuchen Sie es in Kürze erneut oder entfernen Sie die Dokumentbeschränkung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor aún no ha confirmado un estado editable; vuelva a intentarlo en breve o elimine la restricción del documento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor ainda não confirmou um estado editável; tente novamente em breve ou remova a restrição do documento."
          }
        }
      }
    },
    "app.bilingual.c396e2f27d951a29": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器以只读模式打开，无法安全进入编辑。可重试；若仍只读，请解除文档限制后重新打开。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor opened read-only and could not safely switch to edit. Retry, or remove the document restriction and reopen."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器以只讀模式開啟，無法安全進入編輯。可重試；若仍只讀，請解除文件限制後重新開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタは読み取り専用を開き、編集に安全に切り替えることができませんでした。 再試行するか、ドキュメントの制限を解除して再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기가 읽기 전용으로 전환되어 안전하게 편집으로 전환할 수 없었습니다. 다시 시도하거나 문서 제한을 해제하고 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur s'est ouvert en lecture seule et n'a pas pu passer en toute sécurité à l'édition. Réessayez ou supprimez la restriction du document et rouvrez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor öffnete schreibgeschützt und konnte nicht sicher zur Bearbeitung wechseln. Versuchen Sie es erneut, oder entfernen Sie die Dokumentenbeschränkung und öffnen Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor abrió de solo lectura y no pudo cambiar de forma segura a editar. Vuelve a intentarlo o elimina la restricción del documento y vuelve a abrirla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor abriu somente leitura e não conseguiu mudar com segurança para editar. Tente novamente ou remova a restrição do documento e reabra."
          }
        }
      }
    },
    "app.bilingual.3e9237b67f81094f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次批量编辑未能恢复，已暂停保存以保护文档。请重新打开文档（丢弃未验证的编辑副本）后再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous command batch could not be restored, so saving is paused to protect the document. Reopen the document to discard the unverified working copy, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次批次編輯未能恢復，已暫停儲存以保護文件。請重新開啟文件（丟棄未驗證的編輯副本）後再試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のコマンドバッチは復元できませんでしたので、文書を保護するために保存が一時停止されています。 文書を再度開いて、未検証の作業コピーを破棄し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 명령 배치를 복원할 수 없었으므로 문서를 보호하기 위해 저장이 일시 중지되었습니다. 문서를 다시 열어 검증되지 않은 작업 복사본을 폐기한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lot de commandes précédent n'a pas pu être restauré, l'enregistrement est donc mis en pause pour protéger le document. Rouvrez le document pour supprimer la copie de travail non vérifiée, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein vorheriger Befehlsstapel konnte nicht wiederhergestellt werden, daher wird das Speichern pausiert, um das Dokument zu schützen. Öffnen Sie das Dokument erneut, um die unverifizierte Arbeitskopie zu verwerfen, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar un lote de comandos anterior, por lo que el guardado se pausa para proteger el documento. Vuelva a abrir el documento para descartar la copia de trabajo no verificada, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lote de comandos anterior não pôde ser restaurado, portanto, o salvamento é pausado para proteger o documento. Reabra o documento para descartar a cópia de trabalho não verificada e tente novamente."
          }
        }
      }
    },
    "app.bilingual.a8656f60e88744ee": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档已变化，请让助手重新准备修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed. Ask the assistant to prepare the edit again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已變化，請讓助手重新準備修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書が変更されました。 アシスタントに再度編集の準備を依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 변경되었습니다. 조수에게 다시 편집을 준비해 달라고 요청하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé. Demandez à l'assistant de préparer à nouveau la modification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument hat sich geändert. Bitten Sie den Assistenten, die Bearbeitung erneut vorzubereiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió. Pida al asistente que prepare la edición de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou. Peça ao assistente para preparar a edição novamente."
          }
        }
      }
    },
    "app.bilingual.a3d7c239a753ecb7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批次前快照已不可用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pre-batch snapshot is no longer available."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次前快照已不可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前バッチスナップショットは利用できなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 배치 스냅샷을 더 이상 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'instantané pré-lot n'est plus disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Snapshot vor dem Batch ist nicht mehr verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instantánea previa al lote ya no está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instantâneo pré-lote não está mais disponível."
          }
        }
      }
    },
    "app.bilingual.25e49b5f8a6785a4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档在该批次之后又发生了变化，未自动撤销以避免覆盖后续编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed after this batch, so it was not reverted automatically to avoid overwriting later work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在該批次之後又發生了變化，未自動撤銷以避免覆蓋後續編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバッチの後に文書が変更されたため、後の作業を上書きしないように自動的に元に戻されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 배치 이후에 문서가 변경되어, 이후 작업을 덮어쓰는 것을 방지하기 위해 자동으로 되돌리지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé après ce lot, il n'a donc pas été rétabli automatiquement pour éviter d'écraser le travail ultérieur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde nach diesem Stapel geändert, so dass es nicht automatisch zurückgesetzt wurde, um ein Überschreiben späterer Arbeiten zu vermeiden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió después de este lote, por lo que no se revirtió automáticamente para evitar la sobreescritura del trabajo posterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou após este lote, portanto, não foi revertido automaticamente para evitar a substituição do trabalho posterior."
          }
        }
      }
    },
    "app.bilingual.b81f81b8ccc74e17": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑器有未保存的修改，无法撤销该批次；请先保存或放弃这些修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor has unsaved changes; save or discard them before reverting the batch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯器有未儲存的修改，無法撤銷該批次；請先儲存或放棄這些修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタに未保存の変更があります。バッチを元に戻す前に、保存するか破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기에 저장되지 않은 변경 사항이 있습니다; 배치를 되돌리기 전에 저장하거나 삭제하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'éditeur a des modifications non enregistrées ; enregistrez-les ou rejetez-les avant de revenir au lot."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Editor hat nicht gespeicherte Änderungen; speichern oder verwerfen Sie sie, bevor Sie den Stapel zurücksetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El editor tiene cambios no guardados; guárdelos o deséchelos antes de revertir el lote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O editor não tem alterações salvas; salve-as ou descarte-as antes de reverter o lote."
          }
        }
      }
    },
    "app.bilingual.9515b6e58f3ad32a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档引擎未能在限定时间内启动；编辑副本已保留。请稍后重试，若仍失败请重启应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document engine did not start in time. Your edits were retained. Retry shortly, or restart the app if it keeps failing."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件引擎未能在限定時間內啟動；編輯副本已保留。請稍後重試，若仍失敗請重啟應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントエンジンが時間通りに起動しませんでした。 ご編集は保持されました。 すぐに再試行してください、またはアプリが失敗し続ける場合は再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 엔진이 제때 시작되지 않았습니다. 귀하의 편집이 보존되었습니다. 잠시 후 다시 시도하시거나, 계속 실패할 경우 앱을 재시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de document n'a pas démarré à temps. Vos modifications ont été conservées. Réessayez sous peu ou redémarrez l'application si elle continue d'échouer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumenten-Engine startete nicht rechtzeitig. Ihre Bearbeitungen wurden beibehalten. Versuchen Sie es in Kürze erneut oder starten Sie die App neu, wenn sie immer wieder fehlschlägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de documentos no se inició a tiempo. Tus ediciones fueron retenidas. Vuelva a intentarlo en breve o reinicie la aplicación si sigue fallando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de documentos não começou a tempo. Suas edições foram retidas. Tente novamente em breve ou reinicie o aplicativo se ele continuar falhando."
          }
        }
      }
    },
    "app.bilingual.14b6e14d5a1447e4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档保存未能在限定时间内完成；编辑副本已保留，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document did not finish saving in time. Your edits were retained; please retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件儲存未能在限定時間內完成；編輯副本已保留，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書は時間内に保存が完了しませんでした。 編集が保持されました。再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 제때 저장을 완료하지 못했습니다. 귀하의 편집이 유지되었습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document n'a pas fini d'enregistrer à temps. Vos modifications ont été conservées ; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Speichern des Dokuments wurde nicht rechtzeitig abgeschlossen. Ihre Änderungen wurden beibehalten; bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento no terminó de guardarse a tiempo. Sus ediciones fueron retenidas; por favor, inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento não terminou de salvar a tempo. Suas edições foram retidas; por favor, tente novamente."
          }
        }
      }
    },
    "app.bilingual.b0cdcbb328340cd5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档已变化，修改已保留。请重新打开后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed. Your edits were retained; reopen it and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已變化，修改已保留。請重新開啟後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書が変更されました。 編集が保持されました。再度開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 변경되었습니다. 귀하의 편집이 보존되었습니다; 다시 열고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé. Vos modifications ont été conservées ; rouvrez-le et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument hat sich geändert. Ihre Bearbeitungen wurden beibehalten; öffnen Sie sie erneut und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió. Sus ediciones fueron retenidas; vuelva a abrirlo e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou. Suas edições foram retidas; reabra e tente novamente."
          }
        }
      }
    },
    "app.bilingual.ae8f5d2eb49b69ef": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文档需要编辑密码，请在编辑器中输入。未保存任何更改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document requires its edit password. Enter it in the editor; nothing was saved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該文件需要編輯密碼，請在編輯器中輸入。未儲存任何更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書には編集パスワードが必要です。 エディタに入力してください；何も保存されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 편집 비밀번호가 필요합니다. 편집기에 입력하십시오; 저장된 것이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document nécessite son mot de passe de modification. Entrez-le dans l'éditeur ; rien n'a été enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument erfordert sein Bearbeitungspasswort. Geben Sie es in den Editor ein; nichts wurde gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento requiere su contraseña de edición. Introdígalo en el editor; no se guardó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento requer sua senha de edição. Digite-o no editor; nada foi salvo."
          }
        }
      }
    },
    "app.bilingual.4c718420681fe540": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能启用编辑，修改已保留。请在文档中重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Editing could not be enabled. Your edits were retained; try again in the document."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能啟用編輯，修改已保留。請在文件中重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集を有効にできませんでした。 編集は保持されました。文書内で再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집을 활성화할 수 없습니다. 귀하의 편집이 보존되었습니다; 문서에서 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'édition n'a pas pu être activée. Vos modifications ont été conservées ; réessayez dans le document."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bearbeitung konnte nicht aktiviert werden. Ihre Änderungen wurden beibehalten; versuchen Sie es erneut im Dokument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo habilitar la edición. Sus ediciones se conservaron; inténtelo de nuevo en el documento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A edição não pôde ser ativada. Suas edições foram mantidas; tente novamente no documento."
          }
        }
      }
    },
    "app.bilingual.4f79dcd2651342a3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档正忙，请稍后重试打印。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document is busy. Try printing again shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件正忙，請稍後重試列印。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書は忙しいです。 すぐにもう一度印刷してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 바쁩니다. 잠시 후에 다시 인쇄해 보십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document est occupé. Essayez d'imprimer à nouveau sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument ist besetzt. Versuchen Sie in Kürze erneut zu drucken."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento está ocupado. Intenta imprimir de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento está ocupado. Tente imprimir novamente em breve."
          }
        }
      }
    },
    "app.bilingual.8889e592e6e3cae9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档已被文档引擎关闭；编辑副本已保留，可在“保留的文档”中恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document engine closed the document. Your editing copies were retained and can be recovered under Retained Documents."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已被文件引擎關閉；編輯副本已保留，可在“保留的文件”中恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントエンジンがドキュメントを閉じました。 編集したコピーは保存されており、保存された文書の下で復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 엔진이 문서를 닫았습니다. 귀하의 편집본이 보관되었으며 보관 문서에 따라 복구될 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de document a fermé le document. Vos copies d'édition ont été conservées et peuvent être récupérées sous Documents conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumenten-Engine hat das Dokument geschlossen. Ihre bearbeiteten Kopien wurden beibehalten und können unter \"Behaltene Dokumente\" wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de documentos cerró el documento. Sus copias de edición se conservaron y se pueden recuperar en Documentos Retenidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de documentos fechou o documento. Suas cópias de edição foram retidas e podem ser recuperadas em Documentos Retidos."
          }
        }
      }
    },
    "app.bilingual.9c739676f8ae90d3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档引擎未在限定时间内完成关闭；编辑副本已保留，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document engine did not finish closing in time. Your document copies were retained; please retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件引擎未在限定時間內完成關閉；編輯副本已保留，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントエンジンは、時間内にクローズを完了しませんでした。 お客様の文書のコピーは保存されました。再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 엔진이 제때 마감을 마치지 못했습니다. 귀하의 문서 사본이 보관되었습니다; 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de document n'a pas fini de fermer à temps. Vos copies de documents ont été conservées ; veuillez réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumenten-Engine wurde nicht rechtzeitig geschlossen. Ihre Dokumentkopien wurden aufbewahrt; bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de documentos no terminó de cerrarse a tiempo. Se conservaron las copias de su documento; por favor, inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de documentos não terminou de fechar a tempo. Suas cópias de documentos foram retidas; por favor, tente novamente."
          }
        }
      }
    },
    "app.bilingual.66ac1899170a0eb3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档已在其他位置更改，编辑副本已保留。请重新打开后继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document changed elsewhere. Your editing copy was retained. Reopen it to continue."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已在其他位置更改，編輯副本已保留。請重新開啟後繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書が他の場所で変更されました。 お客様の編集コピーは保存されました。 続行するには再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서가 다른 곳에서 변경되었습니다. 귀하의 편집본이 보관되었습니다. 계속하려면 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé ailleurs. Votre copie d'édition a été conservée. Rouvrez-le pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde an anderer Stelle geändert. Ihre Bearbeitungskopie wurde beibehalten. Öffnen Sie es erneut, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió a otro lugar. Su copia de edición fue retenida. Vuelve a abrirlo para continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou em outro lugar. Sua cópia de edição foi mantida. Reabra-o para continuar."
          }
        }
      }
    },
    "app.bilingual.6062452a8f569c63": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档已在其他位置打开，请先关闭原来的编辑窗口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
