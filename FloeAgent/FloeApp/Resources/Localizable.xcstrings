    "chat.notice.output_truncated.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider sent more text than this model's local output buffer (received %d bytes, buffer %d bytes). The saved reply keeps the received prefix. The model's configured limit was not changed and the request was not retried."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提供方返回的文字超过该模型的本地输出缓冲（已接收 %d 字节，缓冲上限 %d 字节）。已保存收到的前缀内容；模型的输出上限未被改动，也不会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提供方返回的文字超過該模型的本地輸出緩衝（已接收 %d 位元組，緩衝上限 %d 位元組）。已儲存收到的字首內容；模型的輸出上限未被改動，也不會自動重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーは、このモデルのローカル出力バッファ（受信した %d バイト、バッファ %d バイト）よりも多くのテキストを送信しました。 保存された返信は受信したプレフィックスを保持します。 モデルの設定された上限は変更されず、リクエストは再トライされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자는 이 모델의 로컬 출력 버퍼보다 더 많은 텍스트를 전송했습니다 (수신된 %d 바이트, 버퍼 %d 바이트). 저장된 회신은 수신된 접두사를 유지합니다. 모델의 설정된 제한은 변경되지 않았으며 요청은 재시도되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a envoyé plus de texte que le tampon de sortie local de ce modèle (octets %d reçus, octets de tampon %d). La réponse enregistrée conserve le préfixe reçu. La limite configurée du modèle n'a pas été modifiée et la demande n'a pas été réessyée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat mehr Text gesendet als der lokale Ausgabepuffer dieses Modells (%d-Bytes empfangen, %d-Bytes). Die gespeicherte Antwort behält das empfangene Präfix bei. Das konfigurierte Limit des Modells wurde nicht geändert und die Anfrage wurde nicht erneut versucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor envió más texto que el búfer de salida local de este modelo (recibió bytes %d, búfer %d bytes). La respuesta guardada mantiene el prefijo recibido. El límite configurado del modelo no se cambió y la solicitud no se reintó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor enviou mais texto do que o buffer de saída local deste modelo (bytes %d recebidos, bytes de buffer %d). A resposta salva mantém o prefixo recebido. O limite configurado do modelo não foi alterado e a solicitação não foi tentada novamente."
          }
        }
      }
    },
    "chat.notice.output_truncated.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
