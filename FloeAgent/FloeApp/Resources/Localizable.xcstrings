    "cad.animation.export.frames.foregroundNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Floe open until the frames are ready. If interrupted, start the export again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持 Floe 打开，直到帧准备完成。如果中断，请重新开始导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請保持 Floe 開啟，直到幀準備完成。如果中斷，請重新開始匯出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームが準備できるまで、Floe を開いたままにしてください。 中断された場合は、エクスポートを再度開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임이 준비될 때까지 Floe를 열어 두십시오. 중단된 경우, 내보내기를 다시 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez Floe ouvert jusqu'à ce que les cadres soient prêts. Si vous êtes interrompu, redémarrez l'exportation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie Floe geöffnet, bis die Frames fertig sind. Wenn Sie unterbrochen werden, starten Sie den Export erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga Floe abierto hasta que los marcos estén listos. Si se interrumpe, inicie la exportación de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o Floe aberto até que os quadros estejam prontos. Se interrompido, inicie a exportação novamente."
          }
        }
      }
    },
