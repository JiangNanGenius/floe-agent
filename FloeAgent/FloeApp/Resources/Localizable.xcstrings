    "setup.features.workspaces.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a folder into a private workspace, or connect a remote agent for durable cloud tasks, files, and hosted previews."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件夹导入私有工作区，或连接远端代理来持续执行云任务、传输文件并托管预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將資料夾匯入私有工作區，或連線遠端代理來持續執行雲任務、傳輸檔案並託管預覽。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーをプライベートワークスペースにインポートするか、リモートエージェントを接続して、永続的なクラウドタスク、ファイル、ホストされたプレビューをご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 개인 작업 공간에 가져오거나 원격 에이전트를 연결하여 지속적인 클라우드 작업, 파일 및 호스팅 미리보기를 수행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un dossier dans un espace de travail privé ou connectez un agent distant pour des tâches, des fichiers et des aperçus hébergés durables dans le cloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie einen Ordner in einen privaten Arbeitsbereich oder verbinden Sie einen Remote-Agenten für dauerhafte Cloud-Aufgaben, Dateien und gehostete Vorschauen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe una carpeta a un espacio de trabajo privado o conecte un agente remoto para tareas duraderas en la nube, archivos y vistas previas alojadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe uma pasta para um espaço de trabalho privado ou conecte um agente remoto para tarefas duráveis na nuvem, arquivos e visualizações hospedadas."
          }
        }
      }
    },
