        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "또 다른 라운드가 배경 작업을 기다리고 있습니다. 완료된 후 목표를 재개하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre tour attend des travaux de base. Reprenez l'objectif une fois qu'il est terminé."
          }
