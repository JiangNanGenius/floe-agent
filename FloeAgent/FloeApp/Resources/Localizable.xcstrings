    "cad.physics.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sphere collision proxies and one static ground plane. No friction or spin. Mass, restitution and velocity apply to all selected proxies."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用球形碰撞代理和一个静态地面，不计算摩擦或自转。质量、恢复系数和初速度会应用到全部所选代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用球形碰撞代理和一個靜態地面，不計算摩擦或自轉。質量、恢復係數和初速度會應用到全部所選代理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "球面衝突プロキシと1つの静的グラウンドプレーン。 摩擦やスピンはありません。 質量、回復、速度は、選択されたすべてのプロキシに適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구체 충돌 프록시와 하나의 정적 접지면. 마찰이나 회전이 없습니다. 질량, 복원 및 속도는 선택된 모든 프록시에 적용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxys de collision de sphère et un plan de terre statique. Pas de friction ni de rotation. La masse, la restitution et la vitesse s'appliquent à tous les proxys sélectionnés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kugel-Kollisions-Proxies und eine statische Bodenebene. Keine Reibung oder Drehung. Masse, Restitution und Geschwindigkeit gelten für alle ausgewählten Proxys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxies de colisión de esfera y un plano de tierra estático. Sin fricción ni giro. La masa, la restitución y la velocidad se aplican a todos los proxies seleccionados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxies de colisão de esferas e um plano de aterramento estático. Sem atrito ou rotação. Massa, restituição e velocidade se aplicam a todos os proxies selecionados."
          }
        }
      }
    },
    "cad.physics.noInstances": {
      "localizations": {
