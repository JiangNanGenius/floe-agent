    "Check the previous action before continuing. Its result is unknown.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the previous action before continuing. Its result is unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先核对上一次操作的结果，再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先核對上一次操作的結果，再繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に、前の操作を確認してください。 その結果は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 이전 작업을 확인하십시오. 그 결과는 알 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l'action précédente avant de continuer. Son résultat est inconnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die vorherige Aktion, bevor Sie fortfahren. Sein Ergebnis ist unbekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compruebe la acción anterior antes de continuar. Su resultado es desconocido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a ação anterior antes de continuar. Seu resultado é desconhecido."
          }
        }
      }
    },
    "Keep this task running before continuing its subagent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this task running before continuing its subagent."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先启动此任务，再继续子任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先啟動此任務，再繼續子任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブエージェントを続行する前に、このタスクを実行し続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하위 에이전트를 계속 진행하기 전에 이 작업을 계속 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez cette tâche en cours d'exécution avant de continuer son sous-agent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie diese Aufgabe laufen, bevor Sie ihren Sub-Agenten fortsetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga esta tarea ejecutándose antes de continuar con su subagente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha esta tarefa em execução antes de continuar seu subagente."
          }
        }
      }
    },
    "Subagents cannot be restored in a temporary chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagents cannot be restored in a temporary chat."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时对话不能恢复子任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "臨時對話不能恢復子任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブエージェントは一時的なチャットで復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서브 에이전트는 임시 채팅에서 복원될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sous-agents ne peuvent pas être restaurés dans un chat temporaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unteragenten können in einem temporären Chat nicht wiederhergestellt werden."
