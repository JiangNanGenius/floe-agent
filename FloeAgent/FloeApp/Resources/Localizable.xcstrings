        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file assistant changed. Reopen the file and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案助手已改變，請重新開啟檔案後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルアシスタントが変更されました。 ファイルを再度開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 도우미가 변경되었습니다. 파일을 다시 열고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'assistant de fichier a changé. Rouvrez le fichier et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dateiassistent hat sich geändert. Öffnen Sie die Datei erneut und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente de archivos cambió. Vuelve a abrir el archivo e inténtalo de nuevo."
