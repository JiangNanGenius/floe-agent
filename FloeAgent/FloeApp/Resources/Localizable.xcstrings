    "cad.rig.timeline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay and frame/video export use the Present timeline. GLB includes this part’s authored skin, shape keys and animation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在展示时间轴中回放或导出帧和视频。GLB 包含此部件的骨骼、形态键与已创作动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在展示時間軸中回放或匯出幀和影片。GLB 包含此部件的骨骼、形態鍵與已創作動畫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リプレイおよびフレーム/ビデオのエクスポートは、現在のタイムラインを使用します。 GLB には、このパートの作者スキン、シェイプキー、アニメーションが含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 및 프레임/비디오 내보내기는 현재 타임라인을 사용합니다. GLB는 이 파트의 작성된 스킨, 쉐이프 키 및 애니메이션을 포함합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relecture et exportation d'images/vidéos utilisent la chronologie Present. GLB comprend la peau, les touches de forme et l'animation de cette partie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay und Frame/Video-Export verwenden die Present-Timeline. GLB enthält die von diesem Teil verfasste Haut, Formtasten und Animationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La repetición y la exportación de fotogramas/vídeos utilizan la línea de tiempo Present. GLB incluye la piel de autor de esta parte, las teclas de forma y la animación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Replay e exportação de quadro/vídeo usam a linha do tempo Presente. O GLB inclui a pele de autoria desta parte, as teclas de forma e a animação."
          }
        }
      }
    },
