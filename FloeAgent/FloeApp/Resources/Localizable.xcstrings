            "state": "translated",
            "value": "可合併新的資料內容，並保留已有手工修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいソースコンテンツは、手動での編集を保持したままマージできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 원본 콘텐츠는 수동 편집을 유지하면서 병합할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau contenu source peut être fusionné tout en préservant les modifications manuelles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Quellinhalte können zusammengeführt werden, während manuelle Bearbeitungen beibehalten werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo contenido de origen se puede fusionar mientras se conservan las ediciones manuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo conteúdo de origem pode ser mesclado enquanto preserva as edições manuais."
          }
        }
      }
    },
    "app.bilingual.cd89e379287236e6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些内容在两边都被修改。冲突处保留当前内容，另一版本另存为可恢复副本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content changed in both versions. Keep current values at conflicts and save the other version as a recovery copy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有些內容在兩邊都被修改。衝突處保留當前內容，另一版本另存為可恢復副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のバージョンでいくつかのコンテンツが変更されました。 競合時に現在の値を保持し、他のバージョンはリカバリコピーとして保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 버전 모두에서 일부 내용이 변경되었습니다. 충돌 시 현재 값을 유지하고 다른 버전을 복구 복사본으로 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains contenus ont changé dans les deux versions. Conservez les valeurs actuelles aux conflits et enregistrez l'autre version en tant que copie de récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Inhalte haben sich in beiden Versionen geändert. Behalten Sie die aktuellen Werte bei Konflikten bei und speichern Sie die andere Version als Wiederherstellungskopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos contenidos cambiaron en ambas versiones. Mantenga los valores actuales en los conflictos y guarde la otra versión como una copia de recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algum conteúdo mudou em ambas as versões. Mantenha os valores atuais em conflitos e salve a outra versão como uma cópia de recuperação."
          }
        }
      }
    },
