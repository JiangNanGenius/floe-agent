    "app.bilingual.837306ae865a08e9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境已重建，请确认新的运行位置，或新建助手会话。旧资料已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux was rebuilt. Confirm the new task location or start a new assistant session. Previous data was kept."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境已重建，請確認新的執行位置，或新建助手會話。舊資料已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linuxは再建されました。 新しいタスクの場所を確認するか、新しいアシスタントセッションを開始してください。 以前のデータは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux가 재건되었습니다. 새 작업 위치를 확인하거나 새로운 어시스턴트 세션을 시작하십시오. 이전 데이터는 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux a été reconstruit. Confirmez le nouvel emplacement de la tâche ou démarrez une nouvelle session d'assistant. Les données précédentes ont été conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux wurde umgebaut. Bestätigen Sie den neuen Aufgabenstandort oder starten Sie eine neue Assistentensitzung. Frühere Daten wurden gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux fue reconstruido. Confirma la nueva ubicación de la tarea o inicia una nueva sesión de asistente. Se conservaron los datos anteriores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux foi reconstruído. Confirme o novo local da tarefa ou inicie uma nova sessão de assistente. Os dados anteriores foram mantidos."
          }
        }
      }
    },
    "app.bilingual.e8f1a67f891f2ea7": {
