    "workspace.workspace_canvas_view.the_number_of_reference_images_exceeds": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of reference images exceeds the selected model's capability. Remove extra inputs or use a model that supports more reference images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考图数量超过所选模型能力。请移除多余输入，或更换支持更多参考图的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參考圖數量超過所選模型能力。請移除多餘輸入，或更換支援更多參考圖的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照画像の数が選択されたモデルの能力を超えています。 余分な入力を削除するか、より多くの参照画像をサポートするモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 이미지 수가 선택된 모델의 용량을 초과합니다. 추가 입력을 제거하거나 더 많은 참조 이미지를 지원하는 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre d'images de référence dépasse la capacité du modèle sélectionné. Supprimez les entrées supplémentaires ou utilisez un modèle qui prend en charge plus d'images de référence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzahl der Referenzbilder übersteigt die Kapazität des ausgewählten Modells. Entfernen Sie zusätzliche Eingaben oder verwenden Sie ein Modell, das mehr Referenzbilder unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El número de imágenes de referencia excede la capacidad del modelo seleccionado. Elimine las entradas adicionales o use un modelo que admita más imágenes de referencia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O número de imagens de referência excede a capacidade do modelo selecionado. Remova entradas extras ou use um modelo que suporte mais imagens de referência."
          }
        }
      }
    },
