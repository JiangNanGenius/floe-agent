    "workspace.canvas_backup_package.native_cad_duplicate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup lists the same CAD package twice; it was refused."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份中重复列出同一 CAD 文档，已拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份中重複列出同一 CAD 文件，已拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップには同じ CAD パッケージが2回記載されており、却下されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 동일한 CAD 패키지가 두 번 나열되어 있으며, 거부되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde répertorie le même paquet CAD deux fois ; il a été refusé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Backup listet das gleiche CAD-Paket zweimal auf; es wurde abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad enumera el mismo paquete CAD dos veces; fue rechazado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup lista o mesmo pacote CAD duas vezes; foi recusado."
          }
        }
      }
    },
