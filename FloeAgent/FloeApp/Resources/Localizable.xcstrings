          "stringUnit": {
            "state": "translated",
            "value": "オープンサーフェス；ここでのSTEPエクスポートは閉じたソリッドのみを書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 표면; 여기서 STEP 내보내기는 닫힌 솔리드만 기록합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surface ouverte ; l'exportation STEP ici n'écrit que des solides fermés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Oberfläche; STEP Export hier schreibt nur geschlossene Körper."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superficie abierta; la exportación STEP aquí escribe solo sólidos cerrados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Superfície aberta; STEP export aqui escreve apenas sólidos fechados."
          }
        }
      }
    },
    "cad.export.reason.meshOnlyIges": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesh-only; IGES export needs an exact solid or surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅网格；IGES 导出需要精确实体或曲面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅網格；IGES 匯出需要精確實體或曲面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッシュのみ；IGESエクスポートには正確なソリッドまたはサーフェスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시 전용; IGES 내보내기에는 정확한 솔리드 또는 표면이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maille uniquement ; l'exportation IGES nécessite un solide ou une surface exacte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Mesh; IGES-Export benötigt einen exakten Feststoff oder eine Oberfläche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo malla; la exportación de IGES necesita un sólido o una superficie exacta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente malha; a exportação IGES precisa de um sólido ou superfície exato."
          }
        }
      }
    },
    "cad.export.formatLoss.exactNoMaterials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exact geometry only: this file does not keep materials, history, PMI, part names or assembly hierarchy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留精确几何：此文件不保留材质、历史、PMI、零件名称或装配层级。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保留精確幾何：此檔案不保留材質、歷史、PMI、零件名稱或裝配層級。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確なジオメトリのみ：このファイルは材料、履歴、PMI、部品名、またはアセンブリ階層を保持しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 기하학만: 이 파일은 재료, 이력, PMI, 부품명 또는 조립 계층 구조를 보관하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géométrie exacte uniquement : ce fichier ne conserve pas les matériaux, l'historique, le PMI, les noms de pièces ou la hiérarchie d'assemblage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur exakte Geometrie: Diese Datei enthält keine Materialien, Verlauf, PMI, Teilenamen oder Baugruppenhierarchie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo geometría exacta: este archivo no guarda materiales, historial, PMI, nombres de piezas o jerarquía de ensamblaje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas geometria exata: este arquivo não mantém materiais, histórico, PMI, nomes de peças ou hierarquia de montagem."
          }
        }
      }
    },
