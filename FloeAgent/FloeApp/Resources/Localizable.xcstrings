    "app.bilingual.306bed97f411e43b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅生成新边缘。原图层、文字和透明区域会保留，可撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate only new margins. Original layers, text and transparency stay editable; the expansion can be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅生成新邊緣。原圖層、文字和透明區域會保留，可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいマージンのみを生成してください。 元のレイヤー、テキスト、透明度は編集可能なままです；拡張は元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 마진만 생성하십시오. 원본 레이어, 텍스트 및 투명도는 편집이 가능하며, 확장은 되돌릴 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générez uniquement de nouvelles marges. Les couches originales, le texte et la transparence restent modifiables ; l'extension peut être annuler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur neue Ränder generieren. Originalebenen, Text und Transparenz bleiben bearbeitbar; die Erweiterung kann rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Genere solo nuevos márgenes. Las capas originales, el texto y la transparencia sien siendo editables; la expansión se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere apenas novas margens. As camadas originais, o texto e a transparência permanecem editáveis; a expansão pode ser desfeita."
          }
        }
      }
    },
    "app.bilingual.eb0cb598b337fe21": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请扩大至少一边，不缩小原画面；单边不超过 8192 像素，总像素不超过 800 万。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expand at least one edge without shrinking the original, up to 8192 pixels per edge and 8 megapixels total."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請擴大至少一邊，不縮小原畫面；單邊不超過 8192 畫素，總畫素不超過 800 萬。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のエッジを縮小せずに、少なくとも1つのエッジを拡張し、エッジあたり最大8192ピクセル、合計で8メガピクセルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본을 축소하지 않고 최소 하나의 가장자리를 확장하여, 가장자리당 최대 8192픽셀, 총 8메가픽셀입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Développez au moins un bord sans réduire l'original, jusqu'à 8192 pixels par bord et 8 mégapixels au total."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erweitern Sie mindestens eine Kante, ohne das Original zu verkleinern, bis zu 8192 Pixel pro Kante und insgesamt 8 Megapixel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplíe al menos un borde sin reducir el original, hasta 8192 píxeles por borde y 8 megapíxeles en total."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanda pelo menos uma borda sem encolher a original, até 8192 pixels por borda e 8 megapixels no total."
          }
        }
      }
    },
