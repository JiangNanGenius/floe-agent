    "app.bilingual.68a2158d96688a0a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 应用，Esc 取消；方向键微调，Shift 加速。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter applies, Esc cancels. Arrow keys nudge; Shift moves faster."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 應用，Esc 取消；方向鍵微調，Shift 加速。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter が適用され、Esc はキャンセルされます。 矢印キーで軽く押すと、Shiftキーで操作が速くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter가 적용됩니다, Esc가 취소됩니다. 화살표 키를 눌러 움직이면 Shift가 더 빠르게 움직입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrée s'applique, Esc annule. Les touches fléchées se bousclent ; Shift se déplace plus vite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter gilt, Esc storniert. Pfeiltasten stoßen; Umschalt bewegt sich schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter aplica, Esc cancela. Las teclas de flecha se empujan; Shift se mueve más rápido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter aplica-se, Esc cancela. As teclas de seta cutucam; Shift se move mais rápido."
          }
        }
      }
    },
    "app.bilingual.8023a18c93a68623": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
