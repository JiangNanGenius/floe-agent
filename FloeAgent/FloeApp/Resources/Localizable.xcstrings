      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing import is unavailable. Reopen this work and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法导入图纸。请重新打开作品后再试。"
