    "app.bilingual.73cbf9ff2527d15a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea 只接受工作表名称或序号，不能搭配单元格区域或 sheets 选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea accepts only a sheet name or index, never a cell range or sheets."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea 只接受工作表名稱或序號，不能搭配單元格區域或 sheets 選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea はシート名またはインデックスのみを受け付け、セル範囲やシートは決して受け付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea는 시트 이름이나 인덱스만 허용하고, 셀 범위나 시트는 절대 허용하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "usePrintArea n'accepte qu'un nom de feuille ou un index, jamais une plage de cellules ou des feuilles."
          }
        },
        "de": {
          "stringUnit": {
