          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントIDと要求された権限を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트 ID와 요청된 권한을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
