    "settings.exec.runtimes.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No runtime inventory yet; probe results appear after loading."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未读取到运行时；加载后会显示真实探测结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未讀取到執行時；載入後會顯示真實探測結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ランタイムインベントリはまだありません。プローブ結果はロード後に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런타임 인벤토리가 아직 없습니다; 로딩 후에 프로브 결과가 표시됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'inventaire d'exécution ; les résultats de la sonde apparaissent après le chargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Laufzeitbestand; Sondenergebnisse werden nach dem Laden angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay inventario de tiempo de ejecución; los resultados de la sonda aparecen después de la carga."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum inventário de tempo de execução ainda; os resultados da sonda aparecem após o carregamento."
          }
        }
      }
    },
