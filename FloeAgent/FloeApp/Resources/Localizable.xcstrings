            "value": "시스템 메일 작성기를 입력합니다; 전송은 항상 사용자가 확인합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit le compositeur de courrier du système ; l'envoi est toujours confirmé par l'utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt den System-Mail-Komponier; das Senden wird immer vom Benutzer bestätigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llena el compositor de correo del sistema; el envío siempre es confirmado por el usuario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche o compositor de e-mail do sistema; o envio é sempre confirmado pelo usuário."
          }
        }
      }
    },
    "settings.apple_capabilities_settings_view.find_create_and_modify_calendar_events": {
