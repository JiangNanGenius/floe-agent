    "app.engineering_review_sheet.applied_and_saved_the_open": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已应用并保存；当前图纸窗口还有未保存的手工修改，未强行刷新。请先保存或放弃这些修改，再重新打开图纸查看最新结果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied and saved; the open drawing has unsaved manual edits and was not force-reloaded. Save or discard them, then reopen the drawing to see the result."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已應用並儲存；當前圖紙視窗還有未儲存的手工修改，未強行重新整理。請先儲存或放棄這些修改，再重新開啟圖紙檢視最新結果。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用され、保存されました；開いている図面には未保存の手動編集があり、強制リロードされていません。 保存するか破棄し、その後描画を再度開いて結果をご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용 및 저장되었습니다; 열린 도면에는 저장되지 않은 수동 편집이 있으며 강제 재로드되지 않았습니다. 저장하거나 삭제한 다음, 그림을 다시 열어 결과를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué et enregistré ; le dessin ouvert n'a pas de modifications manuelles enregistrées et n'a pas été rechargé de force. Enregistrez-les ou jetez-les, puis rouvrez le dessin pour voir le résultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angewendet und gespeichert; die offene Zeichnung hat nicht gespeicherte manuelle Bearbeitungen und wurde nicht zwangsneu geladen. Speichern oder verwerfen Sie sie, und öffnen Sie die Zeichnung erneut, um das Ergebnis zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado y guardado; el dibujo abierto tiene ediciones manuales no guardadas y no se recargó a la fuerza. Guárdalos o deséchalos, luego vuelve a abrir el dibujo para ver el resultado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado e salvo; o desenho aberto não tem edições manuais salvas e não foi recarregado à força. Salve-os ou descarte-os e, em seguida, reabra o desenho para ver o resultado."
          }
        }
      }
    },
    "app.engineering_review_sheet.applied_and_saved_the_open_2": {
