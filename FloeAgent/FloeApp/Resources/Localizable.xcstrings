    "cad.sculpt.conversionNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable mesh conversion to prepare this solid; Undo can restore it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用网格转换后可准备此实体，可通过撤销恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用網格轉換後可準備此實體，可透過撤銷恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッシュ変換を有効にしてこのソリッドを準備してください。元に戻すと復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시 변환을 활성화하여 이 솔리드를 준비하십시오; 실행 취소하면 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer la conversion de maillage pour préparer ce solide ; Annuler peut le restaurer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie die Mesh-Konvertierung, um diesen Festkörper vorzubereiten; Rückgängig kann ihn wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite la conversión de malla para preparar este sólido; Deshacer puede restaurarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilite a conversão de malha para preparar este sólido; Desfazer pode restaurá-lo."
          }
        }
      }
    },
    "cad.sculpt.empty": {
      "extractionState": "manual",
      "localizations": {
