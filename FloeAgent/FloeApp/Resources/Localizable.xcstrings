    "workspace.i_d_e_language_run_view.could_not_probe_the_remote_executable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not probe the remote executable; no run command was sent"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法探测远端可执行文件，未发送运行命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法探測遠端可執行檔案，未傳送執行命令"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート実行ファイルをプローブできませんでした。run コマンドは送信されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 실행 파일을 탐색할 수 없습니다; 실행 명령이 전송되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de sonder l'exécutable distant ; aucune commande d'exécution n'a été envoyée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausführbare Remote-Datei konnte nicht untersucht werden; es wurde kein Run-Befehl gesendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo sondear el ejecutable remoto; no se envió ningún comando de ejecución"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível sondar o executável remoto; nenhum comando de execução foi enviado"
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.could_not_resolve_this_workspace_s": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
