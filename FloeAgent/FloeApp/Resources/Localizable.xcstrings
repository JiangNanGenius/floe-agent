    "execution.shared.stop_first": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU changes apply while running. Stop active projects before changing memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 可在运行时调整；更改内存前请先停止正在运行的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 可在執行時調整；更改記憶體前請先停止正在執行的專案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPUの変更は実行中に適用されます。 メモリを変更する前に、アクティブなプロジェクトを停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 변경은 실행 중에 적용됩니다. 메모리를 변경하기 전에 활성 프로젝트를 중지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications du processeur s'appliquent pendant l'exécution. Arrêtez les projets actifs avant de changer la mémoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU-Änderungen gelten während des Betriebs. Stoppen Sie aktive Projekte, bevor Sie den Speicher wechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de la CPU se aplican durante la ejecución. Detenga los proyectos activos antes de cambiar la memoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações na CPU se aplicam durante a execução. Pare os projetos ativos antes de mudar a memória."
          }
        }
      }
    },
    "execution.shared.detail": {
      "localizations": {
        "en": {
