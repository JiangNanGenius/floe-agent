    "notes.notes_agent_tools.the_new_version_could_not_be": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new version could not be confirmed after the Office save; the original file is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 保存后无法确认新版本；原文件保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Office 儲存後無法確認新版本；原檔案保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Office の保存後に新しいバージョンを確認できませんでした。元のファイルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Office가 저장한 후 새 버전을 확인할 수 없으며, 원본 파일은 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle version n'a pas pu être confirmée après l'enregistrement Office ; le fichier d'origine est inchangé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Version konnte nach dem Office-Speicher nicht bestätigt werden; die Originaldatei ist unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la nueva versión después de guardar Office; el archivo original no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova versão não pôde ser confirmada após o salvamento do Office; o arquivo original não foi alterado."
          }
        }
      }
    },
