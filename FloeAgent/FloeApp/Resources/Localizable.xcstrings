      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下初始尺寸是研究示例，请按所用刀具填写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Initial dimensions are a research example. Enter the dimensions of the tool in use."
