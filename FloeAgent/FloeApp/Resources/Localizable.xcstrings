    },
    "mail.settings.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use passwords or select a connected Google/Microsoft account for IMAP + SMTP. Password accounts also support POP3. Credentials stay in this device’s secure storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "IMAP＋SMTP 可使用密码或已连接的 Google／Microsoft 账户。密码账户也支持 POP3。凭据仅存本机安全存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "IMAP＋SMTP 可使用密碼或已連線的 Google／Microsoft 賬戶。密碼賬戶也支援 POP3。憑據僅存本機安全儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードを使用するか、IMAP と SMTP 用の接続された Google/Microsoft アカウントを選択してください。 Password アカウントは POP3 もサポートしています。 認証情報はこのデバイスの安全なストレージに保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호를 사용하거나 IMAP + SMTP에 연결된 Google/Microsoft 계정을 선택하십시오. 비밀번호 계정도 POP3를 지원합니다. 자격 증명은 이 장치의 보안 저장소에 보관됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des mots de passe ou sélectionnez un compte Google/Microsoft connecté pour IMAP + SMTP. Les comptes de mot de passe prennent également en charge POP3. Les informations d'identification restent dans le stockage sécurisé de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Passwörter oder wählen Sie ein verbundenes Google/Microsoft-Konto für IMAP + SMTP aus. Kennwortkonten unterstützen auch POP3. Anmeldeinformationen verbleiben im sicheren Speicher dieses Geräts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice contraseñas o seleccione una cuenta de Google/Microsoft conectada para IMAP + SMTP. Las cuentas de contraseña también admiten POP3. Las credenciales se quedan en el almacenamiento seguro de este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use senhas ou selecione uma conta Google/Microsoft conectada para IMAP + SMTP. As contas de senha também suportam POP3. As credenciais permanecem no armazenamento seguro deste dispositivo."
          }
        }
      }
    },
