    "app.bilingual.273311e2646f0656": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要参考网格；采样缺面或姿态不可达会停止并保留错误。侧刃策略的适用范围见能力详情。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a reference mesh. Missing sampled surfaces or unreachable poses stop with an explicit error. Swarf applicability is listed in capability details."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要參考網格；取樣缺面或姿態不可達會停止並保留錯誤。側刃策略的適用範圍見能力詳情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照メッシュが必要です。 サンプリングされたサーフェスが欠如している、または到達不可能なポーズは、明示的なエラーで停止します。 スワーフの適用範囲は、機能詳細に記載されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참조 메시가 필요합니다. 샘플링된 표면이 누락되었거나 도달할 수 없는 포즈는 명시적인 오류로 중단됩니다. Swarf 적용 가능성은 기능 세부 정보에 나열되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite un maillage de référence. Les surfaces échantillonnées manquantes ou les poses inaccessibles s'arrêtent avec une erreur explicite. L'applicabilité de l'éperon est indiquée dans les détails de la capacité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert ein Referenznetz. Fehlende beprobte Oberflächen oder unerreichbare Posen stoppen mit einem expliziten Fehler. Die Anwendbarkeit von Swarf ist in den Fähigkeitsdetails aufgeführt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere una malla de referencia. Las superficies muestreadas faltantes o las poses inalcanzables se detienen con un error explícito. La aplicabilidad de Swarf se enumera en los detalles de la capacidad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer uma malha de referência. Superfícies amostradas ausentes ou poses inacessíveis param com um erro explícito. A aplicabilidade do Swarf está listada nos detalhes da capacidade."
          }
        }
      }
    },
