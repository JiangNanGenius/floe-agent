          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间内容发生了变化。你的修改已保存在可重新打开的独立手记副本中。请对照两个版本，再决定是否将修改应用到原件。"
          }
        }
      }
    },
