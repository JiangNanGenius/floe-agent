        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 서버가 성공적으로 인증되었습니다. 메일이 전송되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux serveurs se sont authentifiés avec succès. Aucun courrier n'a été envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Server wurden erfolgreich authentifiziert. Es wurde keine E-Mail gesendet."
