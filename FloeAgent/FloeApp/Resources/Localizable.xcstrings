          "stringUnit": {
            "state": "translated",
            "value": "빌드 또는 체크 파일이 변경되었습니다. 계속하기 전에 프로젝트를 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de construction ou de vérification ont changé. Passez en revue le projet avant de continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build- oder Prüfdateien haben sich geändert. Überprüfen Sie das Projekt, bevor Sie fortfahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de compilación o comprobación han cambiado. Revise el proyecto antes de continuar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos de compilação ou verificação foram alterados. Revise o projeto antes de continuar."
          }
        }
      }
    },
