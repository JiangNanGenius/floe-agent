    },
    "app.bilingual.112d13ebbd0006a8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先完成或停止当前操作，再执行计划。"
          }
        },
        "en": {
