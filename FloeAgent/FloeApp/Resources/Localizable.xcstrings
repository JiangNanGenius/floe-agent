            "state": "translated",
            "value": "令牌保存在现有凭据库，仅用于此主机。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is kept in the existing vault and used only for this host."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌儲存在現有憑據庫，僅用於此主機。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンは既存のボールトに保持され、このホスト専用に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "토큰은 기존 금고에 보관되며 이 호스트에만 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeton est conservé dans le coffre-fort existant et utilisé uniquement pour cet hôte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird im vorhandenen Tresor aufbewahrt und nur für diesen Host verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El token se mantiene en la bóveda existente y se utiliza solo para este host."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O token é mantido no cofre existente e usado apenas para este host."
          }
        }
      }
    },
