      }
    },
    "cad.text.rebuild_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This text conflicts with an existing feature. Check the sketch and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字与已有模型冲突，请检查草图后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文字與已有模型衝突，請檢查草圖後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストは既存の機能と競合しています。 スケッチを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 텍스트는 기존 기능과 충돌합니다. 스케치를 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte entre en conflit avec une fonctionnalité existante. Vérifiez le croquis et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text steht im Widerspruch zu einer vorhandenen Funktion. Überprüfen Sie die Skizze und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto entra en conflicto con una característica existente. Revisa el boceto e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este texto entra em conflito com um recurso existente. Verifique o esboço e tente novamente."
          }
        }
      }
    },
