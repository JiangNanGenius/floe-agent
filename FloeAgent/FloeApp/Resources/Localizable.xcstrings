    "settings.internal_prompts.sections.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed prompt package yet; the app's built-in prompts stay active."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装提示词内容包；应用内置提示词保持生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安裝提示詞內容包；應用內建提示詞保持生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだプロンプトパッケージがインストールされていません；アプリの組み込みプロンプトはアクティブなままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 프롬프트 패키지가 설치되지 않았으며, 앱에 내장된 프롬프트는 계속 활성화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun paquet d'invites n'a encore été installé ; les invites intégrées de l'application restent actives."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein installiertes Eingabeaufforderungspaket; die integrierten Eingabeaufforderungen der App bleiben aktiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha instalado el paquete de indicaciones; las indicaciones integradas de la aplicación se mantienen activas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum pacote de prompt instalado ainda; os prompts integrados do aplicativo permanecem ativos."
          }
        }
      }
    },
    "settings.internal_prompts.sections.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These sections are signed data reviewed here for transparency. They are not injected as system prompts by this screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些章节是经签名验证的数据，仅在此透明展示；本页不会将其注入为系统提示词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些章節是經簽名驗證的資料，僅在此透明展示；本頁不會將其注入為系統提示詞。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのセクションは、透明性のためにここで確認された署名済みデータです。 それらはこの画面のシステムプロンプトとして注入されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 섹션들은 투명성을 위해 여기에서 검토된 서명된 데이터입니다. 이 화면에 의해 시스템 프롬프트가 삽입되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sections sont des données signées examinées ici pour plus de transparence. Ils ne sont pas injectés comme le demande le système par cet écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei diesen Abschnitten handelt es sich um signierte Daten, die hier aus Gründen der Transparenz überprüft werden. Sie werden nicht als Systemaufforderung durch diesen Bildschirm injiziert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas secciones son datos firmados revisados aquí para mayor transparencia. No se inyectan como lo indica el sistema en esta pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas seções são dados assinados revisados aqui para transparência. Eles não são injetados como o sistema solicita nesta tela."
          }
        }
      }
    },
    "settings.internal_prompts.sections.footer.built_in": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the compiled built-in sections — exactly what the runtime uses while no signed prompts package is installed. They ship with the app and are never downloaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以上为应用内置段落，即未安装签名提示词内容包时运行时所使用的内容。它们随应用发布，从不经网络下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以上為應用內建段落，即未安裝簽名提示詞內容包時執行時所使用的內容。它們隨應用釋出，從不經網路下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらはコンパイルされた組み込みセクションであり、署名付きプロンプトパッケージがインストールされていない状態でランタイムが使用するものと正確に同じです。 それらはアプリに同梱されており、決してダウンロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것들은 컴파일된 내장 섹션이며, 서명된 프롬프트 패키지가 설치되지 않은 상태에서 런타임이 정확히 사용하는 섹션입니다. 그들은 앱과 함께 배송되며 절대 다운로드되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les sections intégrées compilées - exactement ce que le runtime utilise alors qu'aucun paquet d'invites signées n'est installé. Ils sont expédiés avec l'application et ne sont jamais téléchargés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind die kompilierten integrierten Abschnitte - genau das, was die Laufzeit verwendet, während kein signiertes Eingabeaufforderungspaket installiert ist. Sie werden mit der App ausgeliefert und nie heruntergeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son las secciones integradas compiladas, exactamente lo que utiliza el tiempo de ejecución mientras no se instala ningún paquete de indicaciones firmadas. Se envían con la aplicación y nunca se descargan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as seções integradas compiladas — exatamente o que o tempo de execução usa enquanto nenhum pacote de prompts assinados é instalado. Eles são enviados com o aplicativo e nunca são baixados."
          }
        }
      }
    },
