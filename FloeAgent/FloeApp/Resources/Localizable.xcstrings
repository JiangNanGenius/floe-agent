    "app.bilingual.37fb2f205badcf43": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只上传当前项目的源码快照到所选仓库；不包含令牌、签名或本机路径。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads only this project's source snapshot to the selected repository; no token, signing identity or local path is included."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只上傳當前專案的原始碼快照到所選倉庫；不包含令牌、簽名或本機路徑。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトのソーススナップショットのみを選択されたリポジトリにアップロードします。トークン、署名ID、ローカルパスは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 저장소에 이 프로젝트의 소스 스냅샷만 업로드합니다; 토큰, 서명 식별자 또는 로컬 경로는 포함되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne télécharge que l'instantané source de ce projet dans le référentiel sélectionné ; aucun jeton, identité de signature ou chemin local n'est inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt nur den Quell-Snapshot dieses Projekts in das ausgewählte Repository hoch; es ist kein Token, keine Signaturidentität oder kein lokaler Pfad enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga solo la instantánea de origen de este proyecto en el repositorio seleccionado; no se incluye ningún token, identidad de firma o ruta local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega apenas o instantâneo de origem deste projeto para o repositório selecionado; nenhum token, identidade de assinatura ou caminho local está incluído."
          }
        }
      }
    },
