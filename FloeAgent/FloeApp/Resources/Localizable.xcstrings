    "app.bilingual.1a738b68e28d1e9b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目已被其他操作更新，本次修改未写入磁盘。更改仍保留在内存中：可撤销/重做后再次保存，或放弃本次更改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project was changed by another operation, so these edits were not written. Your changes are still in memory — undo/redo and save again, or discard this session."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案已被其他操作更新，本次修改未寫入磁碟。更改仍保留在記憶體中：可撤銷/重做後再次儲存，或放棄本次更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトは別の操作によって変更されたため、これらの編集は書き込まれませんでした。 変更はまだメモリに残っています — 取り消し/やり直して再度保存するか、このセッションを破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트가 다른 작업에 의해 변경되었으므로 이러한 편집은 작성되지 않았습니다. 귀하의 변경 사항은 아직 메모리에 남아 있습니다 — 되돌리거나 다시 저장하거나, 이 세션을 폐기하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet a été modifié par une autre opération, donc ces modifications n'ont pas été écrites. Vos modifications sont toujours en mémoire - annuler/refaire et enregistrer à nouveau, ou rejeter cette session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt wurde durch eine andere Operation geändert, so dass diese Änderungen nicht geschrieben wurden. Ihre Änderungen sind immer noch im Speicher - rückgängig machen/wiederholen und erneut speichern oder diese Sitzung verwerfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto fue cambiado por otra operación, por lo que estas ediciones no se escribieron. Sus cambios todavía están en la memoria: deshacer/rehacer y guardar de nuevo, o descartar esta sesión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto foi alterado por outra operação, então essas edições não foram escritas. Suas alterações ainda estão na memória — desfazer/refazer e salvar novamente, ou descartar esta sessão."
          }
        }
      }
    },
    "app.bilingual.b4e90adc3c494de2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败：项目文件无法写入。修改仍保留在内存中，请检查存储空间与权限后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save failed: the project file could not be written. Your changes are still in memory; check storage space and permissions, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗：專案檔案無法寫入。修改仍保留在記憶體中，請檢查儲存空間與許可權後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました：プロジェクトファイルを書き出すことができませんでした。 変更はまだメモリに残っています。ストレージ容量と権限を確認し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장에 실패했습니다: 프로젝트 파일을 쓸 수 없습니다. 귀하의 변경 사항은 아직 메모리에 남아 있습니다; 저장 공간과 권한을 확인한 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'écriture : le fichier du projet n'a pas pu être écrit. Vos modifications sont toujours en mémoire ; vérifiez l'espace de stockage et les autorisations, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern fehlgeschlagen: Die Projektdatei konnte nicht geschrieben werden. Ihre Änderungen befinden sich noch im Speicher. Überprüfen Sie den Speicherplatz und die Berechtigungen, und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado fallido: no se pudo escribir el archivo del proyecto. Sus cambios aún están en la memoria; compruebe el espacio de almacenamiento y los permisos, luego vuelva a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no salvamento: o arquivo do projeto não pôde ser gravado. Suas alterações ainda estão na memória; verifique o espaço de armazenamento e as permissões e tente novamente."
          }
        }
      }
    },
