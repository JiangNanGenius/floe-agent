    "execution.environment_language_package_service.installation_timed_out_reload_dependencies_and": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation timed out; reload dependencies and retry.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装超时，重新读取依赖后可重试。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝超時，重新讀取依賴後可重試。\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールがタイムアウトしました。依存関係を再読み込みし、再試行してください。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치가 시간 초과되었습니다; 종속성을 다시 로드하고 다시 시도하십시오.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation a dépassé le délai d'exécution ; rechargez les dépendances et réessayez.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation ist abgelaufen; Abhängigkeiten werden neu geladen und erneut versucht.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instalación se agaró el tiempo de espera; vuelva a cargar las dependencias y vuelva a intentarlo.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A instalação expirou; recarregue as dependências e tente novamente.\n"
          }
        }
      }
    },
    "execution.environment_language_package_service.pip_timed_out_the_dependency_transaction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pip timed out; the dependency transaction is recoverable.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pip 超时；依赖事务可恢复。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "pip 超時；依賴事務可恢復。\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip がタイムアウトしました；依存関係のトランザクションは復旧可能です。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip이 시간 초과되었습니다; 의존성 트랜잭션을 복구할 수 있습니다.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip a dépassé le délai d'attente ; la transaction de dépendance est récupérable.\n"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip ist ausgezeitet; die Abhängigkeitstransaktion ist erstattungsfähig.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip se agotó el tiempo de espera; la transacción de dependencia es recuperable.\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pip tempo esgotado; a transação de dependência é recuperável.\n"
          }
        }
      }
    },
    "execution.environment_language_package_service.pnpm_was_not_found_in_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pnpm was not found in the guest; install pnpm in the guest or use npm instead"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "guest 中尚未发现 pnpm；请在 guest 中安装 pnpm 或改用 npm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "guest 中尚未發現 pnpm；請在 guest 中安裝 pnpm 或改用 npm"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲストに pnpm が見つかりませんでした。ゲストに pnpm をインストールするか、代わりに npm を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게스트에서 pnpm을 찾을 수 없습니다; 게스트에 pnpm을 설치하거나 대신 npm을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pnpm n'a pas été trouvé dans l'invité ; installez pnpm dans l'invité ou utilisez npm à la place"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pnpm wurde im Gast nicht gefunden; installieren Sie pnpm im Gast oder verwenden Sie stattdessen npm"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pnpm no se encontró en el invitado; instale pnpm en el invitado o use npm en su lugar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pnpm não foi encontrado no convidado; instale pnpm no convidado ou use npm em vez disso"
          }
        }
      }
    },
    "execution.environment_language_package_service.the_current_environment_uses_the_native": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current environment uses the native compatibility backend; switch to the Linux backend before installing/running Node dependencies"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前环境使用 native 兼容后端；切换到 Linux 后端后才能安装/运行 Node 依赖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前環境使用 native 相容後端；切換到 Linux 後端後才能安裝/執行 Node 依賴"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の環境はネイティブの互換性バックエンドを使用しています。Node の依存関係をインストール/実行する前に、Linux バックエンドに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 환경은 네이티브 호환성 백엔드를 사용합니다; Node 종속성을 설치/런행하기 전에 Linux 백엔드로 전환하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement actuel utilise le backend de compatibilité natif ; passez au backend Linux avant d'installer/exécuter les dépendances Node"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Umgebung verwendet das native Kompatibilitäts-Backend; wechseln Sie zum Linux-Backend, bevor Sie Knotenabhängigkeiten installieren/auslaufen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno actual utiliza el backend de compatibilidad nativa; cambie al backend Linux antes de instalar/ejecutar dependencias de Node"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente atual usa o back-end de compatibilidade nativo; mude para o back-end Linux antes de instalar/executar dependências do Node"
          }
        }
      }
    },
