    "composer.op.error.reference_failed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ failed: the file reference is stale or unreadable. Please choose the file again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@失败：文件引用已失效或内容不可读，请重新选择该文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@失敗：檔案引用已失效或內容不可讀，請重新選擇該檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が失敗しました: ファイル参照が古いか、読めません。 もう一度ファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 실패: 파일 참조가 오래되었거나 읽을 수 없습니다. 파일을 다시 선택해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de %@ : la référence du fichier est radite ou illisible. Veuillez choisir à nouveau le fichier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fehlgeschlagen: Die Dateireferenz ist vergänglich oder unlesbar. Bitte wählen Sie die Datei erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ falló: la referencia del archivo está destastuada o es ilegible. Por favor, elija el archivo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ falhou: a referência do arquivo está desatuada ou ilelegível. Por favor, escolha o arquivo novamente."
          }
        }
      }
    },
