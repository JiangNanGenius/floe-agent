    "design.panel.unsaved_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved edits; they are kept while the panel refreshes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有未保存的修改；面板刷新时会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有未儲存的修改；面板重新整理時會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されていない編集があります。パネルが更新される間、それらは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 편집이 있습니다; 패널이 새로 고침되는 동안 해당 편집이 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des modifications non enregistrées ; elles sont conservées pendant que le panneau se rafraîchit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben nicht gespeicherte Änderungen; sie werden beibehalten, während das Panel aktualisiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes ediciones no guardadas; se mantienen mientras el panel se actualiza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem edições não salvas; elas são mantidas enquanto o painel é atualizado."
          }
        }
      }
    },
