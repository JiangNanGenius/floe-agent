    "workspace.i_d_e_language_run_view.the_guest_in_this_environment_is": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The guest in this environment is running with %@ cores, which differs from the requested %@; this request was rejected without restarting or changing the running guest. Stop the guest first, then start it at the new shape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该环境的客户机正在以 %@ 个内核运行，与请求的 %@ 个内核不一致；已拒绝本次请求，未重启或改变正在运行的客户机。请先停止该客户机，再以新形状启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該環境的客戶機正在以 %@ 個核心執行，與請求的 %@ 個核心不一致；已拒絕本次請求，未重啟或改變正在執行的客戶機。請先停止該客戶機，再以新形狀啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この環境のゲストは %@ コアで実行されており、要求された %@ とは異なります。このリクエストは再起動や実行中のゲストの変更を行わずに拒否されました。 まずゲストを止め、次に新しい形で開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 환경의 게스트가 %@ 코어와 함께 실행되고 있으며, 이는 요청된 %@와 다릅니다; 이 요청은 재시작하거나 실행 중인 게스트를 변경하지 않고 거부되었습니다. 게스트를 먼저 중지한 다음, 새로운 형태에서 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invité de cet environnement fonctionne avec des cœurs %@, ce qui diffère du %@ demandé ; cette demande a été rejetée sans redémarrer ou modifier l'invité en cours d'exécution. Arrêtez d'abord l'invité, puis démarrez-le à la nouvelle forme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Gast in dieser Umgebung wird mit %@-Kernen ausgeführt, was sich von den angeforderten %@ unterscheidet. Diese Anforderung wurde abgelehnt, ohne dass der laufende Gast neu gestartet oder geändert wurde. Stoppen Sie zuerst den Gast und starten Sie ihn dann in der neuen Form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El invitado en este entorno se está ejecutando con núcleos %@, que difiere del %@ solicitado; esta solicitud fue rechazada sin reiniciar o cambiar el invitado en ejecución. Detén al invitado primero, luego comienza en la nueva forma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O convidado neste ambiente está em execução com núcleos %@, que difere do %@ solicitado; esta solicitação foi rejeitada sem reiniciar ou alterar o convidado em execução. Pare o convidado primeiro, depois inicie-o na nova forma."
          }
        }
      }
    },
    "workspace.i_d_e_language_run_view.the_host_did_not_acknowledge_the": {
      "extractionState": "manual",
      "localizations": {
