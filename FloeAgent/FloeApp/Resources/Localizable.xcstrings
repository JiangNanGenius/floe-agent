      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored only in Keychain, never in the database."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅存储于钥匙串，绝不写入数据库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅儲存於鑰匙串，絕不寫入資料庫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーチェーンにのみ保存され、データベースには保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키체인에만 저장되며, 데이터베이스에는 절대 저장되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stocké uniquement dans Keychain, jamais dans la base de données."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur im Schlüsselbund gespeichert, niemals in der Datenbank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenado solo en Keychain, nunca en la base de datos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armazenado apenas no Keychain, nunca no banco de dados."
          }
        }
      }
    },
