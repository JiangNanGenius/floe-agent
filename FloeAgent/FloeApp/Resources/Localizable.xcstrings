    "app.bilingual.7dc00c1e213ad198": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是由你明确关联的自定义组合，不代表已核定的厂商型号。原符号、封装和来源会完整保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is an explicitly assigned custom combination, not a qualified manufacturer part. Original geometry and sources are preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是由你明確關聯的自定義組合，不代表已核定的廠商型號。原符號、封裝和來源會完整保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、明確に割り当てられたカスタム組み合わせであり、認定されたメーカー部品ではありません。 元のジオメトリと資料は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이는 명시적으로 할당된 맞춤형 조합이며, 자격을 갖춘 제조업체 부품이 아닙니다. 원본 기하학과 자료가 보존되어 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'une combinaison personnalisée explicitement assignée, et non d'une pièce de fabricant qualifié. La géométrie et les sources originales sont préservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine explizit zugewiesene benutzerdefinierte Kombination, kein Teil eines qualifizierten Herstellers. Ursprüngliche Geometrie und Quellen sind erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una combinación personalizada asignada explícitamente, no una pieza de fabricante calificado. Se conservan la geometría y las fuentes originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma combinação personalizada explicitamente atribuída, não uma peça de fabricante qualificada. A geometria e as fontes originais são preservadas."
          }
        }
      }
    },
