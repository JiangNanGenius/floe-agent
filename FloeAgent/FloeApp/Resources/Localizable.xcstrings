    "app.bilingual.260d4f755ab8b67e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始音频保留并静音，新增人声与伴奏两条音轨；此操作可撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original stays in place (muted) and two new tracks — vocals and accompaniment — are added. You can undo this."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始音訊保留並靜音，新增人聲與伴奏兩條音軌；此操作可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルはそのまま（ミュート）で、ボーカルと伴奏という2つの新しいトラックが追加されます。 これを元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 제자리에 유지되고(음소거된) 두 개의 새로운 트랙—보컬과 반주—이 추가됩니다. 이것을 취소하실 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original reste en place (en sourdine) et deux nouvelles pistes - voix et accompagnement - sont ajoutées. Vous pouvez annuler ceci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original bleibt an Ort und Stelle (gedämpft) und zwei neue Tracks - Gesang und Begleitung - werden hinzugefügt. Sie können dies rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original permanece en su lugar (sin silenciado) y se añaden dos nuevas pistas, vocales y acompañamiento. Puedes deshacer esto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original permanece no lugar (silenciado) e duas novas faixas — vocais e acompanhamento — são adicionadas. Você pode desfazer isso."
          }
        }
      }
    },
    "app.bilingual.8711dfb818d1da7f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用时会直接处理此视频片段的原声区间。"
