            "state": "translated",
            "value": "The host or sign-in method changed. Re-enter the key after applying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务地址或登录方式已变更，应用后需要重新填写密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務地址或登入方式已變更，應用後需要重新填寫金鑰。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストまたはサインイン方法が変更されました。 適用後にキーを再入力してください。"
