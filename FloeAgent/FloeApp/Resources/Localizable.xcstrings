    "cad.material.mapping.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapping changes how textures are sampled; it never changes the model geometry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "映射只改变纹理取样方式，不会改变模型几何。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對映只改變紋理取樣方式，不會改變模型幾何。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マッピングはテクスチャのサンプリング方法を変更し、モデルのジオメトリは決して変更しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매핑은 텍스처가 샘플링되는 방식을 변경합니다; 모델 기하학은 절대 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mappage change la façon dont les textures sont échantillonnées ; il ne change jamais la géométrie du modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zuordnung ändert die Art und Weise, wie Texturen abgetastet werden; es ändert nie die Modellgeometrie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mapeo cambia la forma en que se muestrean las texturas; nunca cambia la geometría del modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapeamento muda a forma como as texturas são amostradas; nunca altera a geometria do modelo."
          }
        }
      }
    },
