    "shortcuts.run.error.files.not_ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are available after the task finishes successfully. Wait for it, or turn on partial results."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务成功结束后才有文件可用。请等待运行完成，或打开“包含部分结果”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務成功結束後才有檔案可用。請等待執行完成，或開啟“包含部分結果”。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクが正常に完了した後、ファイルは利用可能です。 お待ちください、または部分結果を有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 성공적으로 완료된 후에 파일을 사용할 수 있습니다. 기다리시거나, 부분 결과를 켜십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont disponibles une fois la tâche terminée avec succès. Attendez-le, ou activez les résultats partiels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien sind verfügbar, nachdem die Aufgabe erfolgreich abgeschlossen wurde. Warten Sie darauf oder aktivieren Sie Teilergebnisse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos están disponibles después de que la tarea se completa con éxito. Espéralo o activa los resultados parciales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos estão disponíveis depois que a tarefa é concluída com sucesso. Aguarde por isso ou ative os resultados parciais."
          }
        }
      }
    },
    "shortcuts.run.error.files.service": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
