    "websearch.providers.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search uses the first available provider and can query several providers concurrently in Deep mode. Keys are stored in Keychain; provider preferences sync through iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会优先使用可用供应商，深度模式可并发查询多个供应商。密钥存入钥匙串，供应商偏好通过 iCloud 同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會優先使用可用供應商，深度模式可併發查詢多個供應商。金鑰存入鑰匙串，供應商偏好透過 iCloud 同步。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Search は最初に利用可能なプロバイダーを使用し、Deep モードで複数のプロバイダーを同時にクエリできます。 キーはキーチェーンに保存され、プロバイダーの設定はiCloudを通じて同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Search는 첫 번째 사용 가능한 공급자를 사용하며, Deep 모드에서 여러 공급자를 동시에 조회할 수 있습니다. 키는 키체인에 저장되며, 제공업체 환경설정은 iCloud를 통해 동기화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche utilise le premier fournisseur disponible et peut interroger plusieurs fournisseurs simultanément en mode profond. Les clés sont stockées dans le trousseau ; les préférences du fournisseur se synchronisent via iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche verwendet den ersten verfügbaren Anbieter und kann mehrere Anbieter gleichzeitig im Deep-Modus abfragen. Schlüssel werden im Schlüsselbund gespeichert; die Präferenzen des Anbieters werden über iCloud synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda utiliza el primer proveedor disponible y puede consultar a varios proveedores simultáneamente en modo profundo. Las claves se almacenan en el llavero; las preferencias del proveedor se sincronizan a través de iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pesquisa usa o primeiro provedor disponível e pode consultar vários provedores simultaneamente no modo Deep. As chaves são armazenadas no Chaveiro; as preferências do provedor são sincronizadas pelo iCloud."
          }
        }
      }
    },
