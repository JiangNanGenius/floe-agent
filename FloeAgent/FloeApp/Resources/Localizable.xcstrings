        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以下初始尺寸是研究示例，請按所用刀具填寫。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期次元は研究例です。 使用中のツールの寸法を入力してください。"
