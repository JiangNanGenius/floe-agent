    "app.bilingual.dcd75566e022b227": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先补齐模型中无法转换的零件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolve parts that cannot be converted before machining."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先補齊模型中無法轉換的零件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "加工前に変換できない部品を解決する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가공하기 전에 변환할 수 없는 부품을 해결하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résoudre les pièces qui ne peuvent pas être converties avant l'usinage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile lösen, die vor der Bearbeitung nicht umgebaut werden können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuelva las piezas que no se pueden convertir antes del mecanizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolva peças que não podem ser convertidas antes da usinagem."
          }
        }
      }
    },
    "app.bilingual.a3bc42ef42315db9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在 CAD 中添加实体，再重新准备模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a solid in CAD, then prepare the model again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先在 CAD 中新增實體，再重新準備模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CADにソリッドを追加し、モデルを再度準備してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CAD에 솔리드를 추가하고, 모델을 다시 준비하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un solide dans CAD, puis préparez à nouveau le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Feststoff in CAD hinzu und bereiten Sie dann das Modell erneut vor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue un sólido en CAD, luego prepare el modelo nuevamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione um sólido em CAD e, em seguida, prepare o modelo novamente."
          }
        }
      }
    },
    "app.bilingual.c9acc7155cd26b57": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加工需要完整模型。请检查模型中的零件后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Machining needs the complete model. Check the document's parts and try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加工需要完整模型。請檢查模型中的零件後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械加工には完全なモデルが必要です。 文書の部分を確認し、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가공에는 완전한 모델이 필요합니다. 문서의 부분을 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'usinage nécessite le modèle complet. Vérifiez les parties du document et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bearbeitung benötigt das komplette Modell. Überprüfen Sie die Teile des Dokuments und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mecanizado necesita el modelo completo. Comprueba las partes del documento e inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A usinagem precisa do modelo completo. Verifique as partes do documento e tente novamente."
          }
        }
      }
    },
    "app.bilingual.503e57dde042acf8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前模型没有立体厚度，请先完成实体建模。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model has no 3D thickness. Finish the solid model first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前模型沒有立體厚度，請先完成實體建模。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルには3Dの厚さがありません。 まず、ソリッドモデルを完成させてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델에는 3D 두께가 없습니다. 먼저 솔리드 모델을 완성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n'a pas d'épaisseur 3D. Terminez d'abord le modèle solide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell hat keine 3D-Dicke. Beende zuerst das feste Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo no tiene grosor 3D. Termina primero el modelo sólido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo não tem espessura 3D. Termine o modelo sólido primeiro."
          }
        }
      }
    },
