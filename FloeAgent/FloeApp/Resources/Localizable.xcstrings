        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envíe texto al agente Floe para su procesamiento (resúmenes, análisis, etc.)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie texto para o Agente Floe para processamento (resumos, análise, etc.)."
          }
        }
