    "chat.conversation_list_view.the_task_generated_content_private_workspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task, generated content, private workspace and attachment references will be permanently deleted; Floe-hosted cloud workspaces are also cleaned up and enter a pending queue while offline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、生成内容、私有工作区和附件引用将被永久删除；Floe 托管的云工作区也会清理，离线时进入待处理队列。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務、生成內容、私有工作區和附件引用將被永久刪除；Floe 託管的雲工作區也會清理，離線時進入待處理佇列。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、生成されたコンテンツ、プライベートワークスペース、および添付ファイルの参照は永久に削除されます；Floeがホストするクラウドワークスペースもクリーンアップされ、オフライン時に保留キューに入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 생성된 콘텐츠, 개인 작업 공간 및 첨부 파일 참조는 영구적으로 삭제됩니다; Floe가 호스팅하는 클라우드 작업 공간도 정리되어 오프라인 상태에서 대기 중인 대기열에 들어갑니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche, le contenu généré, l'espace de travail privé et les références de pièce jointe seront définitivement supprimés ; les espaces de travail en nuage hébergés par Floe sont également nettoyés et entrent dans une file d'attente en attente hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe, der generierte Inhalt, der private Arbeitsbereich und die Anhangsreferenzen werden dauerhaft gelöscht; Floe-gehostete Cloud-Arbeitsbereiche werden ebenfalls bereinigt und betreten eine ausstehende Warteschlange, während sie offline sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea, el contenido generado, el espacio de trabajo privado y las referencias de archivo adjunto se eliminarán permanentemente; los espacios de trabajo en la nube alojados en Floe también se limpian y entran en una cola pendiente mientras están fuera de línea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa, o conteúdo gerado, o espaço de trabalho privado e as referências de anexo serão excluídos permanentemente; os espaços de trabalho em nuvem hospedados por Floe também são limpos e entram em uma fila pendente enquanto estiverem offline."
          }
        }
      }
    },
    "chat.conversation_list_view.the_task_generated_content_private_workspace_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task, generated content, private workspace and attachment references will be permanently deleted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、生成内容、私有工作区和附件引用将被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務、生成內容、私有工作區和附件引用將被永久刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、生成されたコンテンツ、プライベートワークスペース、および添付ファイルの参照は永久に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 생성된 콘텐츠, 개인 작업 공간 및 첨부 파일 참조는 영구적으로 삭제됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche, le contenu généré, l'espace de travail privé et les références des pièces jointes seront définitivement supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgaben, die generierten Inhalte, die privaten Arbeitsbereiche und die Anhängereferenzen werden dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea, el contenido generado, el espacio de trabajo privado y las referencias de archivos adjuntos se eliminarán permanentemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa, o conteúdo gerado, o espaço de trabalho privado e as referências de anexo serão excluídos permanentemente."
          }
        }
      }
    },
    "chat.conversation_list_view.the_task_private_workspace_and_temporary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The task, private workspace and temporary credentials will be deleted; cloud workspaces created by Floe are cleaned up immediately, or queued for automatic cleanup while offline. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务、私有工作区和临时凭据将被删除；由 Floe 创建的云工作区会立即清理，离线时会排队后自动清理。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任務、私有工作區和臨時憑據將被刪除；由 Floe 建立的雲工作區會立即清理，離線時會排隊後自動清理。此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスク、プライベートワークスペース、および一時的な認証情報は削除されます；Floe が作成したクラウドワークスペースは直ちにクリーンアップされるか、オフライン時に自動的にクリーンアップされるようにキューに入れられます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업, 개인 작업 공간 및 임시 자격 증명은 삭제됩니다; Floe에 의해 생성된 클라우드 작업 공간은 즉시 정리되며, 오프라인 상태에서는 자동 정리를 위해 대기열에 배치됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La tâche, l'espace de travail privé et les informations d'identification temporaires seront supprimés ; les espaces de travail en nuage créés par Floe sont immédiatement nettoyés ou mis en file d'attente pour un nettoyage automatique hors ligne. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgabe, der private Arbeitsbereich und die temporären Anmeldeinformationen werden gelöscht; Cloud-Arbeitsbereiche, die von Floe erstellt wurden, werden sofort bereinigt oder für die automatische Bereinigung in die Warteschlange gestellt, während sie offline sind. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarea, el espacio de trabajo privado y las credenciales temporales se eliminarán; los espacios de trabajo en la nube creados por Floe se limpian inmediatamente o se ponen en cola para la limpieza automática mientras están fuera de línea. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tarefa, o espaço de trabalho privado e as credenciais temporárias serão excluídos; os espaços de trabalho em nuvem criados por Floe são limpos imediatamente ou enfileirados para limpeza automática enquanto estiverem offline. Isso não pode ser desfeito."
          }
        }
      }
    },
