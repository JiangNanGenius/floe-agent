    "notes.engineering.tooLarge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The drawing exceeds the 20 MB preview limit. The original file has been preserved; export it and open it in professional software."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工程图超过 20 MB 的预览上限。原文件已保留，请导出后使用专业软件打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工程圖超過 20 MB 的預覽上限。原檔案已保留，請匯出後使用專業軟體開啟。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この図面は20 MBのプレビュー上限を超えています。 元のファイルは保存されています。エクスポートして、プロフェッショナルなソフトウェアで開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림이 20 MB 미리보기 제한을 초과했습니다. 원본 파일이 보존되었습니다; 내보내어 전문 소프트웨어에서 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin dépasse la limite d'aperçu de 20 Mo. Le fichier original a été conservé ; exportez-le et ouvrez-le dans un logiciel professionnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeichnung überschreitet das Vorschaulimit von 20 MB. Die Originaldatei wurde erhalten; exportieren Sie sie und öffnen Sie sie in professioneller Software."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo supera el límite de vista previa de 20 MB. El archivo original se ha conservado; expórtelo y ábralo en un software profesional."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho excede o limite de visualização de 20 MB. O arquivo original foi preservado; exporte-o e abra-o em software profissional."
          }
        }
      }
    },
