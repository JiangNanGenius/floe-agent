    "design.owner.error.moved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source changed since it was frozen. Compare, create a variant, or regenerate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源在冻结后发生了变化。请对比、创建分支或重新生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來源在凍結後發生了變化。請對比、建立分支或重新生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
