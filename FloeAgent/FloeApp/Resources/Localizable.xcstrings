    },
    "cad.building.error.aProjectRuleNeedsAPositiveLimit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project rule needs a positive limit, clause and HTTPS source."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则需要正数限值、条款和 HTTPS 来源网址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "規則需要正數限值、條款和 HTTPS 來源網址。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトルールには、正のリミット、条項、そして HTTPS ソースが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 규칙에는 양의 제한, 절 및 HTTPS 소스가 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
