    "app.bilingual.216be0f18acd2bdf": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入音频后，即可载入 A／B 盘、设置 Cue 和制作混音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import audio to load decks A and B, set cues and create a mix."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入音訊後，即可載入 A／B 盤、設定 Cue 和製作混音。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオをロードデッキAとBにインポートし、キューを設定してミックスを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 가져와 덱 A와 B를 로드하고, 신호를 설정한 뒤 믹스를 생성합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez l'audio pour charger les platines A et B, définir des indices et créer un mix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie Audio, um die Decks A und B zu laden, Cues zu setzen und einen Mix zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa audio para cargar las cubiertas A y B, establecer señales y crear una mezcla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe áudio para carregar os decks A e B, defina dicas e crie uma mixagem."
          }
        }
      }
    },
