    "app.bilingual.da18b9a972eba83b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置可用的图像或视频模型；Floe 不会自动切换服务商。请在设置中配置模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No enabled image or video model is configured; Floe never switches providers automatically. Configure a model in Settings."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置可用的影象或影片模型；Floe 不會自動切換服務商。請在設定中配置模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な画像または動画モデルが設定されていません；Floeはプロバイダーを自動的に切り替えることはありません。 設定でモデルを構成する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 이미지 또는 비디오 모델이 구성되지 않았습니다; Floe는 공급자를 자동으로 전환하지 않습니다. 설정에서 모델을 구성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle d'image ou de vidéo activé n'est configuré ; Floe ne change jamais de fournisseur automatiquement. Configurez un modèle dans Paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein aktiviertes Bild- oder Videomodell konfiguriert; Floe wechselt nie automatisch den Anbieter. Konfigurieren Sie ein Modell in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha configurado ninguna imagen o modelo de vídeo habilitado; Floe nunca cambia de proveedor automáticamente. Configura un modelo en Ajustes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo de imagem ou vídeo ativado está configurado; Floe nunca muda de provedor automaticamente. Configure um modelo em Configurações."
          }
        }
      }
    },
