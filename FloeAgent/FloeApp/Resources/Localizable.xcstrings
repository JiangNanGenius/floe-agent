    "composer.local.switch.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is currently loaded. Next time you use an on-device model it will be released first and %@ will load; running tasks are not interrupted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前已加载 %@。下次使用本机模型时会先释放它，再加载 %@；正在执行的任务不会被中断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前已載入 %@。下次使用本機模型時會先釋放它，再載入 %@；正在執行的任務不會被中斷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は現在ロードされています。 次回、オンデバイスモデルをご使用になる場合は、まずリリースされ、%@ がロードされます。実行中のタスクは中断されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@가 현재 로드되었습니다. 다음에 온‐디바이스 모델을 사용할 때는 먼저 릴리스되며 %@가 로드됩니다; 실행 중인 작업은 중단되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est actuellement chargé. La prochaine fois que vous utiliserez un modèle sur l'appareil, il sera publié en premier et %@ se chargera ; les tâches en cours d'exécution ne sont pas interrompues."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird derzeit geladen. Wenn Sie das nächste Mal ein On-Device-Modell verwenden, wird es zuerst freigegeben und %@ wird geladen; laufende Aufgaben werden nicht unterbrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está actualmente cargado. La próxima vez que use un modelo en el dispositivo, se lanzará primero y %@ se cargará; las tareas en ejecución no se interrumpen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está carregado no momento. Na próxima vez que você usar um modelo no dispositivo, ele será lançado primeiro e o %@ será carregado; as tarefas em execução não são interrompidas."
          }
        }
      }
    },
