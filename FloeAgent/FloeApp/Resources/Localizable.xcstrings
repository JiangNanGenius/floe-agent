    "app.bilingual.cf945efb1c8457ef": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该步骤的资源、联锁和低频设置保存在完整配置中。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resources, interlocks and uncommon settings for this step are retained in the complete setup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該步驟的資源、聯鎖和低頻設定儲存在完整配置中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このステップのリソース、インターロック、および珍しい設定は、完全なセットアップに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계에 대한 리소스, 인터록 및 일반적인 설정은 전체 설정에 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les ressources, les verrouillages et les paramètres inhabituels pour cette étape sont conservés dans la configuration complète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ressourcen, Verriegelungen und ungewöhnliche Einstellungen für diesen Schritt bleiben im gesamten Setup erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recursos, los enclavamientos y la configuración poco común para este paso se conservan en la configuración completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recursos, bloqueios e configurações incomuns para esta etapa são mantidos na configuração completa."
          }
        }
      }
    },
