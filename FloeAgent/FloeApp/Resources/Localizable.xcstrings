          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie das Spiel, um einen nativen Speicher zu erfassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el juego para capturar un guardado nativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o jogo para capturar um salvamento nativo."
          }
        }
      }
    },
    "app.bilingual.b81df36c8d2e6f3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏已重新启动，请为新运行重新打开存档管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game restarted. Reopen save management for the new run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲已重新啟動，請為新執行重新開啟存檔管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームが再開されました。 新しい実行の保存管理を再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임이 재시작되었습니다. 새 실행에 대한 저장 관리를 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu a redémarré. Rouvrir la gestion de la sauvegarde pour la nouvelle exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel wurde neu gestartet. Wiedereröffnung der Speicherverwaltung für den neuen Lauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego se reinició. Vuelva a abrir la gestión de guardados para la nueva ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo foi reiniciado. Reabrir o gerenciamento de salvamento para a nova execução."
          }
        }
      }
    },
    "app.bilingual.f2e01fdc3c132079": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎不提供原生状态快照；游戏自带的存档仍可正常使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine doesn't expose native snapshots. Its own in-game saves still work."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎不提供原生狀態快照；遊戲自帶的存檔仍可正常使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンはネイティブスナップショットを公開しません。 それ自身のゲーム内セーブは依然として機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔진은 네이티브 스냅샷을 노출하지 않습니다. 그 자체의 게임 내 저장은 여전히 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur n'expose pas les instantanés natifs. Ses propres sauvegardes dans le jeu fonctionnent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine zeigt keine nativen Schnappschüsse an. Seine eigenen In-Game-Speicher funktionieren immer noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor no expone instantáneas nativas. Sus propias paradas en el juego siguen funcionando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo não expõe instantâneos nativos. Seus próprios salvamentos no jogo ainda funcionam."
          }
        }
      }
    },
    "app.bilingual.d309b870618016ac": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在游戏运行且支持状态快照时，才能读取或覆盖存档。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load and overwrite are available while this game is running and supports snapshots."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在遊戲執行且支援狀態快照時，才能讀取或覆蓋存檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームが実行中はロードと上書きが利用可能で、スナップショットもサポートしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임이 실행되는 동안 로드와 덮어쓰기가 가능하며 스냅샷을 지원합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chargement et l'écrasement sont disponibles pendant que ce jeu est en cours d'exécution et prend en charge les instantanés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden und Überschreiben sind verfügbar, während dieses Spiel läuft und unterstützt Snapshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargar y sobrescribir están disponibles mientras este juego se está ejecutando y admite instantáneas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregar e substituir estão disponíveis enquanto este jogo está em execução e suporta instantâneos."
          }
        }
      }
    },
    "app.bilingual.c3afbc567e9f1c5a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
