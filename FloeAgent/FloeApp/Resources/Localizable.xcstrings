          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行位置與任務已儲存的環境不一致。請檢查任務設定後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解決された環境がこのタスクの保存された場所と一致しません。 再試行する前にタスク設定を確認してください。"
