    "home.draft_task_permissions_sheet.deletion_payments_credentials_uploads_and_catastrophic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion, payments, credentials, uploads and catastrophic commands remain under mandatory protection."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除、付款、凭据、上传和灾难性命令仍受强制保护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除、付款、憑據、上傳和災難性命令仍受強制保護。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デレーション、支払い、認証情報、アップロード、そして壊滅的なコマンドは、引き続き強制的に保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제, 결제, 자격 증명, 업로드 및 재앙적인 명령은 여전히 강제 보호 하에 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression, les paiements, les informations d'identification, les téléchargements et les commandes catastrophiques restent sous protection obligatoire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschungen, Zahlungen, Anmeldeinformationen, Uploads und katastrophale Befehle bleiben unter obligatorischem Schutz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación, los pagos, las credenciales, las cargas y los comandos catastróficos permanecen bajo protección obligatoria."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclusão, pagamentos, credenciais, uploads e comandos catastróficos permanecem sob proteção obrigatória."
          }
        }
      }
    },
    "home.draft_task_permissions_sheet.low_risk_actions_are_approved_automatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Low-risk actions are approved automatically; sensitive actions still ask."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低风险自动批准，敏感操作仍会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "低風險自動批准，敏感操作仍會詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低リスクのアクションは自動的に承認されますが、機密性の高いアクションは依然として承認を求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위험도가 낮은 작업은 자동으로 승인되며, 민감한 작업은 여전히 승인됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions à faible risque sont approuvées automatiquement ; les actions sensibles demandent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktionen mit geringem Risiko werden automatisch genehmigt; sensible Aktionen fragen immer noch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de bajo riesgo se aprueban automáticamente; las acciones sensibles aún preguntan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ações de baixo risco são aprovadas automaticamente; ações sensíveis ainda pedem."
          }
        }
      }
    },
