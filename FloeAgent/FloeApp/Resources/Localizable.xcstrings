    "settings.data_management_view.cleanup_cache_containers_reason": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Caches directory as a whole is never a cleanup candidate; user data inside it stays registered as retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches 目录整体永不作为清理对象；其中的用户数据已注册为保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches 目錄整體永不作為清理物件；其中的使用者資料已註冊為保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches ディレクトリ全体は決してクリーンアップの対象ではなく、その中のユーザーデータは保持されたまま登録されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches 디렉터리 전체는 절대 정리 대상이 아니며, 그 안의 사용자 데이터는 보관된 상태로 등록됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire Caches dans son ensemble n'est jamais un candidat au nettoyage ; les données utilisateur qu'il contient restent enregistrées comme conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Caches-Verzeichnis als Ganzes ist niemals ein Bereinigungskandidat; die darin enthaltenen Benutzerdaten bleiben als gespeichert registriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio Caches en su conjunto nunca es un candidato de limpieza; los datos del usuario dentro de él permanecen registrados como retenidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório Caches como um todo nunca é um candidato a limpeza; os dados do usuário dentro dele permanecem registrados como retidos."
          }
        }
      }
    },
