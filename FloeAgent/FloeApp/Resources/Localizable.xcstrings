    "app.bilingual.d15c37055c64ebc2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力、体力、压力及任意节点约束均可通过完整配置导入和保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Concentrated forces, body forces, pressure and arbitrary nodal constraints can be imported and saved in the complete setup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力、體力、壓力及任意節點約束均可透過完整配置匯入和儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中力、体力、圧力、任意の結節制約は、完全なセットアップにインポートして保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중된 힘, 몸 힘, 압력 및 임의의 노달 제약은 전체 설정에 가져와 저장할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les forces concentrées, les forces corporelles, la pression et les contraintes nodales arbitraires peuvent être importées et enregistrées dans la configuration complète."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konzentrierte Kräfte, Körperkräfte, Druck und willkürliche Knotenbeschränkungen können importiert und im kompletten Setup gespeichert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuerzas concentradas, las fuerzas del cuerpo, la presión y las restricciones ganglionales arbitrarias se pueden importar y guardar en la configuración completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forças concentradas, forças corporais, pressão e restrições nodais arbitrárias podem ser importadas e salvas na configuração completa."
          }
        }
      }
    },
