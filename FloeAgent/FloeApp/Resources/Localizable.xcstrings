    "settings.general.agent_mode.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model approval and full control fall back to asking you every time until their decision channels land."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在模型审批与完全控制的决策通道落地前，两者均回退为每次都询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在模型審批與完全控制的決策通道落地前，兩者均回退為每次都詢問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデル承認と完全な管理は、決定チャンネルが決定するまで、毎回あなたに問い合わせることに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 승인 및 전면 제어는 그들의 결정 채널이 도착할 때까지 매번 귀하에게 요청하는 방식으로 되돌아가게 됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'approbation du modèle et le contrôle total se résoutent à vous demander à chaque fois jusqu'à ce que leurs canaux de décision atterrissent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Modellgenehmigung und die volle Kontrolle gehen auf die Frage zurück, bis ihre Entscheidungskanäle landen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación del modelo y el control total se remuelen a preguntarte cada vez hasta que aterricen sus canales de decisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação do modelo e o controle total voltam a perguntar a você todas as vezes até que seus canais de decisão cheguem."
          }
        }
      }
    },
