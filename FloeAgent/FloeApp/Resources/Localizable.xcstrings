    "app.bilingual.e9eaf77057ca72b8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此位置创建视频工作区。请确认文件夹可离线访问并重试，或改用本机工作区。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot create the video workspace here. Make the folder available offline and retry, or use a local workspace."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在此位置建立影片工作區。請確認資料夾可離線訪問並重試，或改用本機工作區。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではビデオワークスペースを作成できません。 フォルダーをオフラインで利用可能にして再試行するか、ローカルのワークスペースを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 비디오 작업 공간을 만들 수 없습니다. 폴더를 오프라인에서 사용할 수 있게 만든 뒤 다시 시도하거나, 로컬 작업 공간을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de créer l'espace de travail vidéo ici. Rendez le dossier disponible hors ligne et réessayez, ou utilisez un espace de travail local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Videobereich kann hier nicht erstellt werden. Machen Sie den Ordner offline verfügbar und versuchen Sie es erneut, oder verwenden Sie einen lokalen Arbeitsbereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede crear el espacio de trabajo de vídeo aquí. Haga que la carpeta esté disponible sin conexión y vuelva a intentarlo, o utilice un espacio de trabajo local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível criar o espaço de trabalho de vídeo aqui. Disponibilize a pasta offline e tente novamente, ou use um espaço de trabalho local."
          }
        }
      }
    },
    "app.bilingual.eb95156ca706a478": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在此位置创建视频工程。请确认文件夹可离线访问并重试，或改用本机工作区。"
