    "settings.environment_language_packages_view.installation_writes_only_to_the_currently": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation writes only to the currently selected environment. The task continues after you leave this page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装只写入当前选择的环境。离开此页面后任务会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝只寫入當前選擇的環境。離開此頁面後任務會繼續。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールは現在選択されている環境にのみ書き込みます。 このページを離れた後もタスクは続行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치는 현재 선택된 환경에만 기록됩니다. 이 페이지를 떠난 후에도 작업이 계속됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installation écrit uniquement dans l'environnement actuellement sélectionné. La tâche se poursuit après avoir quitté cette page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation schreibt nur in die aktuell ausgewählte Umgebung. Die Aufgabe wird fortgesetzt, nachdem Sie diese Seite verlassen haben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
