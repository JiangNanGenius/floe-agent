    "memory.memory_view.only_the_single_shown_suggestion_is": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the single shown suggestion is applied; deletion syncs to other devices and cannot be automatically restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会应用这一条已显示的建议；删除会同步到其他设备，无法自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會應用這一條已顯示的建議；刪除會同步到其他裝置，無法自動恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示された単一の提案のみが適用されます；削除は他のデバイスと同期され、自動的に復元することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 단일 제안만 적용됩니다; 삭제는 다른 기기와 동기화되며 자동으로 복원될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la suggestion unique affichée est appliquée ; la suppression se synchronise avec d'autres appareils et ne peut pas être restaurée automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nur der einzelne angezeigte Vorschlag angewendet; das Löschen wird mit anderen Geräten synchronisiert und kann nicht automatisch wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se aplica la única sugerencia que se muestra; la eliminación se sincroniza con otros dispositivos y no se puede restaurar automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente a única sugestão mostrada é aplicada; a exclusão sincroniza com outros dispositivos e não pode ser restaurada automaticamente."
          }
        }
      }
    },
    "memory.memory_view.organization_complete_scanned_cleaned_automatically_pending": {
