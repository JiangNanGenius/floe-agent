    },
    "conversations.remote_video_tools.veo_reference_images_require_durationseconds_8": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo reference images require durationSeconds=8, or omit the parameter to use the provider default."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo 参考图要求 durationSeconds=8，或省略该参数使用供应商默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo 參考圖要求 durationSeconds=8，或省略該引數使用供應商預設值。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo参照画像は durationSeconds=8 が必要です。または、パラメータを省略してプロバイダーのデフォルトを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo 참조 이미지에는 durationSeconds=8이 필요하거나, 매개변수를 생략하면 제공자 기본값을 사용할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images de référence Veo nécessitent durationSeconds=8, ou omettez le paramètre pour utiliser la valeur par défaut du fournisseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Veo-Referenz-Images erfordern durationSeconds=8, oder lassen Sie den Parameter weg, um den Standardanbieter zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes de referencia de Veo requieren durationSeconds=8, u omitir el parámetro para usar el predeterminado del proveedor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As imagens de referência Veo requerem durationSeconds=8 ou omitir o parâmetro para usar o padrão do provedor."
          }
        }
      }
    },
    "core.canvas_copy_fork_planner.drawing_drafts_take_mb_files_over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawing drafts take %@ MB (%@ files), over the %@ MB budget; unapplied drafts were kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图纸草稿占用 %@ MB（%@ 份），超过 %@ MB 预算；未应用的草稿已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖紙草稿佔用 %@ MB（%@ 份），超過 %@ MB 預算；未應用的草稿已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面草案は %@ MB（%@ ファイル）を %@ MB 予算上回って受け取り、未適用の草稿は保管されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도면 초안은 %@ MB(%@ 파일)를 %@ MB 예산보다 초과하며, 미적용 초안은 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les brouillons de dessin prennent %@ MB (fichiers %@), sur le budget %@ MB ; les brouillons non appliqués ont été conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnungsentwürfe nehmen %@ MB (%@-Dateien) über das %@ MB-Budget; nicht angewendete Entwürfe wurden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los borradores de dibujo toman %@ MB (archivos %@), sobre el presupuesto %@ MB; los borradores no aplicados se conservaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os rascunhos de desenho levam %@ MB (arquivos %@), sobre o orçamento %@ MB; rascunhos não aplicados foram mantidos."
          }
        }
      }
    },
    "core.canvas_copy_fork_planner.no_bindable_editing_project_the_export": {
