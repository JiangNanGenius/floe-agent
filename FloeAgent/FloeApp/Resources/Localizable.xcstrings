    "settings.internal_prompts.fixed_rules.header": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed rules owned by app code"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由应用代码固定的规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由應用程式碼固定的規則"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリコードが所有する固定ルール"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 코드가 소유한 고정 규칙"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles fixes appartenant au code de l'application"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Regeln im Besitz von App-Code"
          }
        },
        "es": {
          "stringUnit": {
