      }
    },
    "app.bilingual.2a7416e7a57e9489": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已请求停止内置 Linux 清理脚本；未开始新的清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop was requested for the bundled Linux cleanup script; no new cleanup was started."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
