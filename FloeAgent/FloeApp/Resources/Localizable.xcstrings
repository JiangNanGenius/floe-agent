            "value": "現在のノートを保存または閉じ、次にNotesからインポートされたドキュメントを開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 메모를 저장하거나 닫은 다음, 노트에서 가져온 문서를 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ou fermez la note actuelle, puis ouvrez le document importé à partir de Notes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern oder schließen Sie die aktuelle Notiz, und öffnen Sie dann das importierte Dokument aus Notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o cierre la nota actual y, a continuación, abra el documento importado desde Notas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
