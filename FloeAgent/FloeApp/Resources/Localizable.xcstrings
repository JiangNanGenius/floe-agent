    "app.bilingual.c4e2d3e0032d5fc5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剩余材料跟随当前刀具位置逐步更新。刀片、刀具使用计算时的尺寸；通用机壳外形不参与碰撞检查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remaining stock follows the current tool position. Insert and cutter dimensions come from the calculation; generic machine housings do not enter collision checks."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剩餘材料跟隨當前刀具位置逐步更新。刀片、刀具使用計算時的尺寸；通用機殼外形不參與碰撞檢查。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの在庫は現在のツールポジションに従います。 インサートとカッターの寸法は計算から算出されます；一般的な機械ハウジングは衝突チェックに入力されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 재고는 현재 툴 포지션을 따릅니다. 인서트와 커터 치수는 계산에 따라 산출되며, 일반 기계 하우징은 충돌 검사에 들어가지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stock restant suit la position actuelle de l'outil. Les dimensions de l'insert et du cutter proviennent du calcul ; les boîtiers de machine génériques n'entrent pas dans les contrôles de collision."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der verbleibende Bestand folgt der aktuellen Werkzeugposition. Die Abmessungen des Einsatzes und des Cutters ergeben sich aus der Berechnung; generische Maschinengehäuse werden nicht in Kollisionsprüfungen eingegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El stock restante sigue la posición actual de la herramienta. Las dimensiones del inserto y del cortador vienen del cálculo; las carcasas genéricas de la máquina no entran en las comprobaciones de colisión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estoque restante segue a posição atual da ferramenta. As dimensões da inserção e do cortador vêm do cálculo; caixas de máquinas genéricas não entram em verificações de colisão."
          }
        }
      }
    },
    "app.bilingual.94a940b5c5ae5be3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份历史续加工结果只保留了工序阶段；缺少初始余料记录，当前不能逐步去料。请从原加工项目重新生成仿真。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This legacy continuation retains operation stages without its initial material checkpoint. Generate simulation again from the original machining project for progressive removal."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這份歷史續加工結果只保留了工序階段；缺少初始餘料記錄，當前不能逐步去料。請從原加工專案重新生成模擬。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレガシー継続は、初期のマテリアルチェックポイントなしで操作段階を保持します。 元の加工プロジェクトからシミュレーションを再度生成し、段階的に除去します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레거시 연속은 초기 물질 체크포인트 없이 운영 단계를 유지합니다. 점진적 제거를 위해 원래 가공 프로젝트에서 시뮬레이션을 다시 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette continuation héritée conserve les étapes de fonctionnement sans son point de contrôle matériel initial. Générez à nouveau une simulation à partir du projet d'usinage d'origine pour une suppression progressive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese ältere Fortsetzung behält die Betriebsstufen ohne ihren anfänglichen Materialkontrollpunkt bei. Generieren Sie erneut eine Simulation aus dem ursprünglichen Bearbeitungsprojekt für eine schrittweise Entfernung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta continuación heredada conserva las etapas de operación sin su punto de control de material inicial. Genere la simulación de nuevo a partir del proyecto de mecanizado original para la eliminación progresiva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta continuação legada mantém os estágios de operação sem seu ponto de verificação de material inicial. Gere a simulação novamente a partir do projeto de usinagem original para remoção progressiva."
          }
        }
      }
    },
    "app.bilingual.6892999f3c7c9348": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正常切削接触会去料；快移或退刀碰到余料会报告风险。检查使用离散采样，未配置的车刀刀杆、夹持与机床部件仍需补齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cutting contact removes stock; rapid or retract contact reports a risk. Checks are sampled; unconfigured turning holders, workholding and machine bodies remain uncovered."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正常切削接觸會去料；快移或退刀碰到餘料會報告風險。檢查使用離散取樣，未配置的車刀刀杆、夾持與機床部件仍需補齊。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断接触は在庫を除去し、急速またはリトラクト接触はリスクを報告します。 チェックはサンプリングされ、未設定の旋削ホルダー、ワークホールディング、機械本体は未確認のままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절단 접점은 재고를 제거합니다; 급속 또는 수축 접점은 위험을 보고합니다. 검사는 샘플링되며, 구성되지 않은 선반 홀더와 작업 고정물 및 기계 본체는 여전히 드러나지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contact de coupe supprime le stock ; le contact rapide ou rétracté rapporte un risque. Les contrôles sont échantillonnés ; les supports tournants non configurés, le support de travail et les corps de machine restent non couverts."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schnittkontakt entfernt den Bestand; der schnelle oder einziehbare Kontakt meldet ein Risiko. Die Schecks werden beprobt; nicht konfigurierte Drehhalter, Arbeitshalte und Maschinenkörper bleiben unbedeckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contacto de corte elimina el stock; el contacto rápido o retráctil informa un riesgo. Los cheques se muestrean; los soportes de torneado no configurados, la sujeción de trabajo y los cuerpos de las máquinas permanecen descubiertos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contato de corte remove o estoque; o contato rápido ou de retração relata um risco. Os cheques são amostrados; suportes de giro não configurados, suportes de trabalho e corpos de máquinas permanecem descobertos."
          }
        }
      }
    },
