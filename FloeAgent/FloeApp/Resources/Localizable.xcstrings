        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토리지 블록을 공유할 수 있는 파일의 사용량을 측정했습니다; 공유 블록은 이미 위의 전체에 한 번 계산됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisation mesurée des fichiers qui peuvent partager des blocs de stockage ; les blocs partagés sont déjà comptés une fois dans le total ci-dessus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemessene Nutzung von Dateien, die Speicherblöcke gemeinsam nutzen können; freigegebene Blöcke werden bereits einmal in der obigen Gesamtsumme gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso medido de archivos que pueden compartir bloques de almacenamiento; los bloques compartidos ya se cuentan una vez en el total anterior."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso medido de arquivos que podem compartilhar blocos de armazenamento; blocos compartilhados já são contados uma vez no total acima."
          }
        }
      }
    },
    "app.data_management_view.files_that_may_share_storage": {
