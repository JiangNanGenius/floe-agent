    "cad.datum.pickUnsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That pick has no exact source for this reference. Tap a straight edge or a flat face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选择没有可用于此参考的精确来源。请点按直边或平面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該選擇沒有可用於此參考的精確來源。請點按直邊或平面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その選択にはこの参照の正確な出典がありません。 直線のエッジまたは平らな面をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 선택은 이 참조에 대한 정확한 출처가 없습니다. 직선 모서리 또는 평평한 면을 탭하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce choix n'a pas de source exacte pour cette référence. Appuyez sur un bord droit ou un visage plat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl hat keine genaue Quelle für diese Referenz. Tippen Sie auf eine gerade Kante oder ein flaches Gesicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa selección no tiene una fuente exacta para esta referencia. Toque un borde recto o una cara plana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa escolha não tem fonte exata para esta referência. Toque em uma borda reta ou em uma face plana."
          }
        }
      }
    },
