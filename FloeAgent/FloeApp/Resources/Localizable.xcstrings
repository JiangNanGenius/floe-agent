        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates cannot be checked right now; installed plugins remain usable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法检查更新，已安装的插件仍可使用。"
