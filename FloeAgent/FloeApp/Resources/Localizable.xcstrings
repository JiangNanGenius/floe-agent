    "app.bilingual.1fad8041eea00527": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的源码管理属于打开此面板时的工作区。当前已切换到其他工作区，为避免提交或暂存错误的仓库，本面板已锁定。请重新打开该工作区的 IDE。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source-control panel belongs to the workspace it was opened for. The app is now on a different workspace, so the panel is locked to avoid staging or committing the wrong repository. Reopen the IDE for that workspace."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的原始碼管理屬於開啟此面板時的工作區。當前已切換到其他工作區，為避擴音交或暫存錯誤的倉庫，本面板已鎖定。請重新開啟該工作區的 IDE。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースコントロールパネルは、開かれたワークスペースに属しています。 アプリは現在別のワークスペースにあるため、ステージングや誤ったリポジトリのコミットを防ぐためにパネルはロックされています。 そのワークスペース用に IDE を再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스 제어 패널은 열려 있는 작업 공간에 속합니다. 앱이 현재 다른 작업 공간에 있어, 잘못된 저장소를 스테이징하거나 커밋하는 것을 방지하기 위해 패널이 잠겨 있습니다. 해당 작업 공간에 대해 IDE를 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce panneau de contrôle source appartient à l'espace de travail pour lequel il a été ouvert. L'application est maintenant sur un espace de travail différent, de sorte que le panneau est verrouillé pour éviter la mise en scène ou la validation du mauvais référentiel. Rouvrez le IDE pour cet espace de travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Quell-Kontrollfeld gehört zu dem Arbeitsbereich, für den es geöffnet wurde. Die App befindet sich jetzt in einem anderen Arbeitsbereich, daher ist das Panel gesperrt, um eine Staging-Staging oder die Verpflichtung des falschen Repositorys zu vermeiden. Öffnen Sie den IDE für diesen Arbeitsbereich erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este panel de control de origen pertenece al espacio de trabajo para el que se abrió. La aplicación ahora está en un espacio de trabajo diferente, por lo que el panel está bloqueado para evitar la puesta en escena o la confirmación del repositorio incorrecto. Vuelva a abrir el IDE para ese espacio de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este painel de controle de origem pertence ao espaço de trabalho para o qual foi aberto. O aplicativo agora está em um espaço de trabalho diferente, então o painel está bloqueado para evitar a preparação ou a confirmação do repositório errado. Reabra o IDE para esse espaço de trabalho."
          }
        }
      }
    },
