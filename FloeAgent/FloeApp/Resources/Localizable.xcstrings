    "cad.workbench.drawing.keepLinkedFeature": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked feature and measurement stay unchanged; edit only the text, position or tolerance here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联特征与测量值保持不变；此处仅编辑文字、位置或公差。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關聯特徵與測量值保持不變；此處僅編輯文字、位置或公差。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクされた機能と測定は変更されません。ここではテキスト、位置、または許容範囲のみを編集してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 기능과 측정값은 변함이 없으며, 여기에서는 텍스트, 위치 또는 허용오차만 편집하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caractéristique et la mesure liées restent inchangées ; modifiez uniquement le texte, la position ou la tolérance ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verknüpfte Merkmal und die Messung bleiben unverändert; bearbeiten Sie hier nur den Text, die Position oder die Toleranz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La característica vinculada y la medición se mantienen sin cambios; edite solo el texto, la posición o la tolerancia aquí."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso vinculado e a medição permanecem inalterados; edite apenas o texto, a posição ou a tolerância aqui."
          }
        }
      }
    },
    "cad.workbench.drawing.keepHoleSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the current linked face"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留当前关联面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留當前關聯面"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のリンクされた顔を保持してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 연결된 얼굴을 유지하십시오"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le visage lié actuel"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behalten Sie das aktuelle verknüpfte Gesicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la cara vinculada actual"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o rosto vinculado atual"
          }
        }
      }
    },
    "cad.workbench.drawing.keepLinkedSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The existing linked face is kept. Choosing another face would re-bind this callout."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将保留现有孔面；选择其他面会重新绑定此标注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將保留現有孔面；選擇其他面會重新繫結此標註。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のリンクされた顔は保持されています。 別の顔を選択すると、この呼び出しが再バインドされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존에 연결된 얼굴은 유지됩니다. 다른 얼굴을 선택하면 이 콜아웃이 다시 바인드됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le visage lié existant est conservé. Choisir un autre visage relierait cet appel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vorhandene verknüpfte Gesicht bleibt erhalten. Wenn Sie ein anderes Gesicht wählen, wird dieser Ruf neu gebunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene la cara vinculada existente. Elegir otra cara volvería a unir esta llamada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rosto vinculado existente é mantido. Escolher outro rosto re-ligaria este apelo."
          }
        }
      }
    },
    "cad.workbench.drawing.noLinkedSource": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This annotation has no linked source; a thread or counterbore callout needs a live hole face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标注没有关联来源；螺纹或沉孔标注需要一个有效的孔面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此標註沒有關聯來源；螺紋或沉孔標註需要一個有效的孔面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアノテーションにはリンクされたソースがありません；スレッドまたはカウンターボアコールアウトにはライブホールフェイスが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주석에는 연결된 소스가 없으며, 스레드 또는 카운터보어 콜아웃은 실제 구멍 면이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette annotation n'a pas de source liée ; un appel de fil ou de contre-alésage a besoin d'une face de trou vivant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmerkung hat keine verknüpfte Quelle; ein Thread- oder Counterbore-Callout benötigt ein Live-Loch-Face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta anotación no tiene una fuente vinculada; una llamada de hilo o contraorificio necesita una cara de agujero vivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta anotação não tem fonte vinculada; uma chamada de thread ou counterhole precisa de uma face de furo vivo."
          }
        }
      }
    },
    "cad.workbench.drawing.weldSize": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
