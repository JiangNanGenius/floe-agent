    "cad.modelImport.sourceChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file changed during import. Open it again to import the latest version."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件在导入过程中已更改，请重新打开以导入最新内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案在匯入過程中已更改，請重新開啟以匯入最新內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート中にソースファイルが変更されました。 もう一度開いて、最新バージョンをインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 파일이 가져오기 중에 변경되었습니다. 다시 열어 최신 버전을 가져오세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier source a changé pendant l'importation. Ouvrez-le à nouveau pour importer la dernière version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldatei wurde während des Imports geändert. Öffnen Sie es erneut, um die neueste Version zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo fuente cambió durante la importación. Ábrelo de nuevo para importar la última versión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de origem foi alterado durante a importação. Abra-o novamente para importar a versão mais recente."
          }
        }
      }
    },
    "cad.modelImport.missingResources": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some referenced materials or textures are missing. Place them beside the OBJ file, then open the model again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分引用的材质或纹理缺失。请将它们放在 OBJ 文件旁，再重新打开模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分引用的材質或紋理缺失。請將它們放在 OBJ 檔案旁，再重新開啟模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照されている素材やテクスチャが一部欠落しています。 OBJファイルの横に配置し、モデルを再度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 참조된 자료 또는 텍스처가 누락되었습니다. OBJ 파일 옆에 배치한 다음, 모델을 다시 열어 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains matériaux ou textures référencés sont manquants. Placez-les à côté du fichier OBJ, puis ouvrez à nouveau le modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige referenzierte Materialien oder Texturen fehlen. Legen Sie sie neben die OBJ-Datei und öffnen Sie dann das Modell erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Faltan algunos materiales o texturas de referencia. Colóquelos al lado del archivo OBJ y, a continuación, vuelva a abrir el modelo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns materiais ou texturas referenciados estão faltando. Coloque-os ao lado do arquivo OBJ e, em seguida, abra o modelo novamente."
          }
        }
      }
    },
    "cad.modelImport.recoveryRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model has an existing working copy that needs recovery. Open its .floecad document from Files to review the recoverable save."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型的已有工作副本需要恢复。请从文件列表打开对应的 .floecad 文档，查看可恢复的保存版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型的已有工作副本需要恢復。請從檔案列表開啟對應的 .floecad 文件，檢視可恢復的儲存版本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルには、復元が必要な既存の作業コピーがあります。 Files から .floecad ドキュメントを開き、復元可能なセーブを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델에는 복구가 필요한 기존 작업 복사본이 있습니다. 파일에서 .floecad 문서를 열어 복구 가능한 저장을 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle a une copie de travail existante qui doit être récupérée. Ouvrez son document .floecad à partir de Fichiers pour examiner la sauvegarde récupérable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell verfügt über eine vorhandene Arbeitskopie, die wiederhergestellt werden muss. Öffnen Sie das .floecad-Dokument aus Dateien, um die wiederherstellbare Speicherung zu überprüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo tiene una copia de trabajo existente que necesita recuperación. Abra su documento .floecad desde Archivos para revisar el guardado recuperable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo tem uma cópia de trabalho existente que precisa de recuperação. Abra seu documento .floecad em Arquivos para revisar o salvamento recuperável."
          }
        }
      }
    },
    "cad.mesh.recognition.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple recognition currently supports boxes aligned to the model axes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简单特征识别目前支持与模型坐标轴对齐的长方体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡單特徵識別目前支援與模型座標軸對齊的長方體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シンプル認識は現在、モデル軸に整列したボックスをサポートしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
