    "cad.datum.axisFromPointsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The axis runs through both points and follows either one when it moves."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该轴通过这两个点，并在任一点移动时跟随。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該軸透過這兩個點，並在任一點移動時跟隨。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軸は両方の点を走り、移動する際にどちらか一方に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축은 두 점을 통과하며 움직일 때 어느 하나를 따라갑니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'axe traverse les deux points et suit l'un ou l'autre lorsqu'il se déplace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Achse verläuft durch beide Punkte und folgt jedem, wenn sie sich bewegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El eje pasa por ambos puntos y sigue a cualquiera de ellos cuando se mueve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O eixo passa por ambos os pontos e segue qualquer um deles quando se move."
          }
        }
      }
    },
