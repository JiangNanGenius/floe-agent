        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格操作进行时文档已发生变化；没有应用任何更改。请在当前实体上重新运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網格操作進行時文件已發生變化；沒有應用任何更改。請在當前實體上重新執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッシュ操作が実行されている間に文書が変更されましたが、何も適用されませんでした。 現在のボディで再度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시 작업이 실행되는 동안 문서가 변경되었으며, 아무 것도 적용되지 않았습니다. 현재 본체에서 다시 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé pendant l'opération de maillage ; rien n'a été appliqué. Exécutez-le à nouveau sur les corps actuels."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument wurde geändert, während der Mesh-Vorgang lief; es wurde nichts angewendet. Führen Sie es erneut auf den aktuellen Körpern aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió mientras se realizaba la operación de malla; no se aplicó nada. Vuelve a ejecutarlo en los cuerpos actuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O documento mudou enquanto a operação de malha era executada; nada foi aplicado. Execute-o novamente nos corpos atuais."
          }
        }
      }
    },
