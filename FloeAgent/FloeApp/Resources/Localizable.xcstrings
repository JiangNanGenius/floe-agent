    "app.bilingual.c77c5d7f50a3e9db": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无可用的已存凭据，可以填写新凭据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible saved credentials. You can enter a new one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫無可用的已存憑據，可以填寫新憑據。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "互換性のある保存された認証情報がありません。 新しいものを入力できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환 가능한 저장된 자격 증명이 없습니다. 새 것을 입력하실 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information d'identification enregistrée compatible. Vous pouvez en saisir un nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine kompatiblen gespeicherten Anmeldeinformationen. Sie können ein neues eingeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay credenciales guardadas compatibles. Puedes introducir uno nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma credencial salva compatível. Você pode inserir um novo."
          }
        }
      }
    },
    "app.bilingual.6ecf7359fe1db856": {
