    "app.bilingual.dafa7d3bc5c26d44": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在 Apple 功能设置中打开提醒事项。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Reminders in Apple capabilities first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 Apple 功能設定中開啟提醒事項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、Apple の機能でリマインダーを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Apple 기능에서 알림을 활성화하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez d'abord les rappels dans les capacités Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie zuerst Erinnerungen in den Apple-Funktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Habilitar recordatorios en las capacidades de Apple primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative os Lembretes nos recursos da Apple primeiro."
          }
        }
      }
    },
    "app.bilingual.735a76ac9a2569d6": {
      "extractionState": "manual",
