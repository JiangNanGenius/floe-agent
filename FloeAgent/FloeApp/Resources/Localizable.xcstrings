          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭预览或切换任务不会停止 Node.js 和 Python 服务。iOS 进入后台后可能暂停执行；重新打开 Floe 后，请重启仍需使用的服务。"
          }
