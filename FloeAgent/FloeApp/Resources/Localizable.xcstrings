    "chat.thread_detail_view_model.failed_to_read_task_data_choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Failed to read task data. Choose the attachment again or reopen the task; the failure stage was recorded in the diagnostic logs (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取任务数据失败。请重新选择附件或重新打开任务；诊断日志已记录失败阶段（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取任務資料失敗。請重新選擇附件或重新開啟任務；診斷日誌已記錄失敗階段（%@）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクデータの読み取りに失敗しました。 添付ファイルを再度選択するか、タスクを再度開いてください；障害ステージは診断ログ（%@）に記録されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 데이터를 읽지 못했습니다. 첨부 파일을 다시 선택하거나 작업을 다시 열어 주세요; 실패 단계가 진단 로그에 기록되었습니다 (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la lecture des données de la tâche. Choisissez à nouveau la pièce jointe ou rouvrez la tâche ; l'étape de l'échec a été enregistrée dans les journaux de diagnostic (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehler beim Lesen der Aufgabendaten. Wählen Sie den Anhang erneut aus oder öffnen Sie die Aufgabe erneut. Die Fehlerphase wurde in den Diagnoseprotokollen (%@) aufgezeichnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer los datos de la tarea. Vuelve a elegir el archivo adjunto o vuelve a abrir la tarea; la etapa de fallo se registró en los registros de diagnóstico (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao ler os dados da tarefa. Escolha o anexo novamente ou reabra a tarefa; o estágio de falha foi registrado nos registros de diagnóstico (%@)."
          }
        }
      }
    },
    "chat.thread_detail_view_model.media_task_status_is_temporarily_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media task status is temporarily unavailable; try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体任务状态暂时无法读取，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "媒體任務狀態暫時無法讀取，請稍後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアタスクのステータスは一時的に利用できません。後ほど再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 작업 상태가 일시적으로 이용할 수 없습니다; 나중에 다시 시도해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état de la tâche multimédia est temporairement indisponible ; réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Medienaufgabenstatus ist vorübergehend nicht verfügbar; versuchen Sie es später noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de la tarea multimedia no está disponible temporalmente; inténtelo de nuevo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status da tarefa de mídia está temporariamente indisponível; tente novamente mais tarde."
          }
        }
      }
    },
