    "app.bilingual.275ccd175619c73f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先绕经过坐标原点的轴旋转，再平移。导入原件会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate around an axis through the coordinate origin, then translate. Original imported data is retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先繞經過座標原點的軸旋轉，再平移。匯入原件會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "座標原点に沿って軸の周りを回転し、次に平行移動してください。 インポートされた元のデータは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌표 원점을 기준으로 축을 중심으로 회전한 다음, 변환하십시오. 원본 가져온 데이터가 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tournez autour d'un axe à travers l'origine des coordonnées, puis traduisez. Les données importées d'origine sont conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drehen Sie sich um eine Achse durch den Koordinatenursprung und übersetzen Sie dann. Importierte Originaldaten werden beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire alrededor de un eje a través del origen de la coordenada, luego traduzca. Los datos importados originales se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gire em torno de um eixo através da origem da coordenada e, em seguida, traduza. Os dados originais importados são mantidos."
          }
        }
      }
    },
    "app.bilingual.590619d38295fdea": {
