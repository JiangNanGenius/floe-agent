    "cad.export.formatLoss.step": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Geometry only. Edit history, annotations, part names and assembly structure are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅保留几何，不包含建模历史、标注、零件名称和装配结构。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅保留幾何，不包含建模歷史、標註、零件名稱和裝配結構。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジオメトリのみ。 編集履歴、注釈、部品名、およびアセンブリ構造は含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기하학만. 편집 기록, 주석, 부품 이름 및 어셈블리 구조는 포함되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Géométrie uniquement. L'historique des modifications, les annotations, les noms des pièces et la structure d'assemblage ne sont pas inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Geometrie. Bearbeitungsverlauf, Anmerkungen, Teilenamen und Baugruppenstruktur sind nicht enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo geometría. El historial de edición, las anotaciones, los nombres de las piezas y la estructura de ensamblaje no están incluidos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas geometria. Histórico de edição, anotações, nomes de peças e estrutura de montagem não estão incluídos."
          }
        }
      }
    },
    "cad.export.formatLoss.mesh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesh export. Exact solids, edit history and annotations are not included."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网格导出不包含精确实体、建模历史和标注。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
