    "exec.packages.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review each layer's dependencies and sizes, install or remove packages, stop and resume environments, and save templates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看每层依赖与容量，安装或卸载软件包，停止、恢复环境，以及保存模板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視每層依賴與容量，安裝或解除安裝軟體包，停止、恢復環境，以及儲存模板。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各レイヤーの依存関係とサイズを確認し、パッケージをインストールまたは削除し、環境の停止と再開を行い、テンプレートを保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 레이어의 종속성 및 크기를 검토하고, 패키지를 설치하거나 제거하며, 환경을 중지하고 재개하며, 템플릿을 저장합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinez les dépendances et la taille de chaque couche, installez ou supprimez des packages, arrêtez et reprenez les environnements et enregistrez les modèles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Abhängigkeiten und Größen jeder Ebene, installieren oder entfernen Sie Pakete, stoppen und setzen Sie Umgebungen und speichern Sie Vorlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise las dependencias y tamaños de cada capa, instale o elimine paquetes, detenga y reanude los entornos y guarde las plantillas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as dependências e tamanhos de cada camada, instale ou remova pacotes, pare e retome ambientes e salve modelos."
          }
        }
      }
    },
    "exec.vcpu.label": {
      "localizations": {
