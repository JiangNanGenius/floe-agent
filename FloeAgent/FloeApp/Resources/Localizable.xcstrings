    "app.bilingual.647a262da69c98a6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次启用显示的是演示数值，请按实际刀具、材料和机床填写。时间未包含空移、加减速、主轴升降速和换刀。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-time values are for demonstration. Enter values for the actual tool, material and machine. Time excludes rapid links, acceleration, spindle transients and tool changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次啟用顯示的是演示數值，請按實際刀具、材料和機床填寫。時間未包含空移、加減速、主軸升降速和換刀。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初回の値はデモンストレーション用です。 実際の工具、材料、機械の値を入力してください。 時間には、急速なリンク、加速、スピンドルトランジェント、ツールチェンジは除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 번째 값은 시연용입니다. 실제 도구, 재료 및 기계에 대한 값을 입력하십시오. 시간은 급속 링크, 가속, 스핀들 과도 및 공구 교체를 제외합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs de la première fois sont pour la démonstration. Entrez les valeurs pour l'outil, le matériau et la machine réels. Le temps exclut les liaisons rapides, l'accélération, les transitoires de broche et les changements d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte des ersten Mals sind für die Demonstration. Geben Sie die Werte für das eigentliche Werkzeug, das Material und die Maschine ein. Zeit schließt schnelle Verbindungen, Beschleunigung, Spindeltransienten und Werkzeugwechsel aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores de la primera vez son para demostración. Introduzca los valores para la herramienta, el material y la máquina reales. El tiempo excluye los enlaces rápidos, la aceleración, los transitorios del husillo y los cambios de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os valores da primeira vez são para demonstração. Insira os valores para a ferramenta, material e máquina reais. O tempo exclui ligações rápidas, aceleração, transientes de fuso e mudanças de ferramentas."
          }
        }
      }
    },
