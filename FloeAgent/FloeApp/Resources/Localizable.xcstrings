    "workspace.office_document_editor_view.the_attachment_insertion_did_not_finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The attachment insertion did not finish and the document may be partially modified. Check the current document first and undo if needed before retrying; the edited copy was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附件插入未能完成，文档可能已有部分修改。请先检查当前文档，必要时撤销后再试；编辑副本已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附件插入未能完成，文件可能已有部分修改。請先檢查當前文件，必要時撤銷後再試；編輯副本已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルの挿入が完了しておらず、文書が部分的に変更されている可能性があります。 まず現在の文書を確認し、必要に応じて再試行する前に元に戻す。編集したコピーは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첨부 파일 삽입이 완료되지 않았으며 문서가 부분적으로 수정될 수 있습니다. 현재 문서를 먼저 확인하고, 필요하면 다시 시도하기 전에 되돌리십시오; 편집된 사본은 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'insertion de la pièce jointe n'est pas terminée et le document peut être partiellement modifié. Vérifiez d'abord le document actuel et résouvez-le si nécessaire avant de réessayer ; la copie modifiée a été conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Einfügen des Anhangs wurde nicht abgeschlossen und das Dokument kann teilweise geändert werden. Überprüfen Sie zuerst das aktuelle Dokument und machen Sie es bei Bedarf rückgängig, bevor Sie es erneut versuchen; die bearbeitete Kopie wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inserción del archivo adjunto no terminó y el documento puede modificarse parcialmente. Compruebe primero el documento actual y deshálalo si es necesario antes de volver a intentarlo; la copia editada se guardó."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A inserção do anexo não foi concluída e o documento pode ser parcialmente modificado. Verifique o documento atual primeiro e desfaço, se necessário, antes de tentar novamente; a cópia editada foi mantida."
          }
        }
      }
    },
    "workspace.office_document_editor_view.the_document_engine_could_not_open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document engine could not open the preview in time; the original file was not modified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档引擎未能在限定时间内打开预览；原文件未被修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件引擎未能在限定時間內開啟預覽；原檔案未被修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドキュメントエンジンはプレビューを時間内に開くことができませんでした；元のファイルは変更されていませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 엔진이 미리 보기를 제때 열 수 없었습니다; 원본 파일은 수정되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de document n'a pas pu ouvrir l'aperçu à temps ; le fichier original n'a pas été modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumenten-Engine konnte die Vorschau nicht rechtzeitig öffnen; die Originaldatei wurde nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de documentos no pudo abrir la vista previa a tiempo; el archivo original no fue modificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de documentos não conseguiu abrir a visualização a tempo; o arquivo original não foi modificado."
          }
        }
      }
    },
    "workspace.office_document_editor_view.the_document_engine_could_not_open_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The document engine could not open the editing copy in time; the editing copy was kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文档引擎未能在限定时间内打开编辑副本；编辑副本已保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件引擎未能在限定時間內開啟編輯副本；編輯副本已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文書エンジンは編集コピーを時間内に開くことができませんでした；編集コピーは保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문서 엔진이 편집본을 제때 열 수 없었으며, 편집본은 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de document n'a pas pu ouvrir la copie d'édition à temps ; la copie d'édition a été conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dokumenten-Engine konnte die Bearbeitungskopie nicht rechtzeitig öffnen; die Bearbeitungskopie wurde beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor de documentos no pudo abrir la copia de edición a tiempo; la copia de edición se mantuvo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mecanismo de documentos não conseguiu abrir a cópia de edição a tempo; a cópia de edição foi mantida."
          }
        }
      }
    },
    "workspace.office_document_editor_view.this_edit_still_matches_the_original": {
