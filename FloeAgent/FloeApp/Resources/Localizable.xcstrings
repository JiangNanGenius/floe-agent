    "settings.data_management_view.syncs_only_when_both_the_master": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncs only when both the master switch and the canvas's own switch are on. Turning sync off does not delete cloud copies; permanently deleting assets queues them for release, subject to confirmed CloudKit deletion."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总开关和画布自身开关都开启时才会同步。关闭同步不会删除云端副本；永久删除素材会进入待释放队列，并以 CloudKit 删除确认结果为准。"
          }
        }
