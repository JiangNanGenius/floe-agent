    "notes.notes_agent_tools.the_application_support_directory_is_inaccessible": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The application support directory is inaccessible, so notes proposal storage is unavailable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法访问应用支持目录，手记提案存储不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法訪問應用支援目錄，手記提案儲存不可用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーションサポートディレクトリにアクセスできないため、ノート提案の保存が利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애플리케이션 지원 디렉터리에 접근할 수 없으므로 메모 제안 저장을 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le répertoire de support de l'application est inaccessible, donc le stockage de la proposition de notes n'est pas disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anwendungsunterstützungsverzeichnis ist nicht zugänglich, daher ist der Notizvorschlagsspeicher nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El directorio de soporte de la aplicación es inaccesible, por lo que el almacenamiento de la propuesta de notas no está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretório de suporte do aplicativo está inacessível, portanto, o armazenamento de propostas de notas não está disponível."
          }
        }
      }
    },
