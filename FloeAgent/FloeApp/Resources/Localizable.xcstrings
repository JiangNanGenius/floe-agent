    "workspace.canvas_backup_package.the_backup_exceeds_the_size_limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup exceeds the size limit (64 MB for in-memory export, 2 GB for file export)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份超过大小限制（内存导出 64 MB，文件导出 2 GB）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份超過大小限制（記憶體匯出 64 MB，檔案匯出 2 GB）。"
