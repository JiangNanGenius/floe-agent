            "value": "O modelo Apple Intelligence está indisponível no momento: %@"
          }
        }
      }
    },
    "localmodels.local_provider_adapter.the_current_local_model_supports_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current local model supports text only; images are first converted to workspace text files via system OCR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前本地模型仅支持文字；图片会先通过系统 OCR 转成工作区文字文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前本地模型僅支援文字；圖片會先透過系統 OCR 轉成工作區文字檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のローカルモデルはテキストのみをサポートしており、画像はまずシステムOCRを使用してワークスペースのテキストファイルに変換されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 로컬 모델은 텍스트만 지원합니다; 이미지는 먼저 시스템 OCR을 통해 작업 공간 텍스트 파일로 변환됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local actuel ne prend en charge que le texte ; les images sont d'abord converties en fichiers texte de l'espace de travail via l'OCR du système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle lokale Modell unterstützt nur Text; Bilder werden zunächst über System-OCR in Workspace-Textdateien umgewandelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo local actual solo admite texto; las imágenes se convierten primero en archivos de texto del espacio de trabajo a través del OCR del sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo local atual suporta apenas texto; as imagens são primeiro convertidas em arquivos de texto do espaço de trabalho via OCR do sistema."
          }
        }
      }
    },
    "localmodels.local_provider_adapter.the_local_model_produced_no_output": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model produced no output for too long (stage: %@, waited %@ sec). Stopping this generation was requested; retry after the model finishes winding down."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型长时间没有输出（阶段：%@，已等待 %@ 秒）。已请求停止本次生成；模型完成收尾后可重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型長時間沒有輸出（階段：%@，已等待 %@ 秒）。已請求停止本次生成；模型完成收尾後可重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルは長時間にわたり出力を出さなかった（ステージ：%@、待機 %@ 秒）。 この世代の停止が要請されました；モデルが終了した後に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델이 너무 오랫동안 출력을 하지 않았습니다 (단계: %@, 대기 %@ 초). 이 세대를 중단하도록 요청되었습니다; 모델이 종료된 후 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local n'a pas produit de sortie pendant trop longtemps (étape : %@, a attendu %@ sec). L'arrêt de cette génération a été demandé ; réessayez après la fin de la fin de la fin du modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Modell erzeugte zu lange keine Ausgabe (Stufe: %@, wartete %@ sec). Es wurde darum gebeten, diese Generation zu stoppen; versuchen Sie es erneut, nachdem das Modell fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo local no produjo salida durante demasiado tiempo (etapa: %@, esperó %@ segundo). Se solicitó detener esta generación; vuelva a intentarlo después de que el modelo termine de terminar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo local não produziu saída por muito tempo (estágio: %@, esperou %@ segundo). A interrupção desta geração foi solicitada; tente novamente depois que o modelo terminar de terminar."
          }
        }
      }
    },
    "localmodels.local_provider_adapter.the_local_model_produced_no_valid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model produced no valid tool call. Try again, or switch to a cloud model for this action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型没有形成有效的工具调用。请重试，或切换到云端模型完成这项操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型沒有形成有效的工具呼叫。請重試，或切換到雲端模型完成這項操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルは有効なツール呼び出しを生成しませんでした。 もう一度お試しください、またはこのアクションのクラウドモデルに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델이 유효한 도구 호출을 생성하지 않았습니다. 다시 시도하시거나, 이 작업에 대해 클라우드 모델로 전환하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local n'a pas produit d'appel d'outil valide. Réessayez ou passez à un modèle cloud pour cette action."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Modell erzeugte keinen gültigen Werkzeugaufruf. Versuchen Sie es erneut oder wechseln Sie für diese Aktion zu einem Cloud-Modell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo local no produjo ninguna llamada de herramienta válida. Inténtalo de nuevo o cambia a un modelo de nube para esta acción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo local não produziu nenhuma chamada de ferramenta válida. Tente novamente ou mude para um modelo de nuvem para esta ação."
          }
        }
      }
    },
    "localmodels.local_provider_adapter.this_local_model_has_not_been": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This local model has not been downloaded; download it in settings first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个本地模型尚未下载，请先在设置中下载"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個本地模型尚未下載，請先在設定中下載"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このローカルモデルはまだダウンロードされていません。まず設定からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 로컬 모델은 다운로드되지 않았습니다; 먼저 설정에서 다운로드하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle local n'a pas été téléchargé ; téléchargez-le d'abord dans les paramètres"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses lokale Modell wurde nicht heruntergeladen; laden Sie es zuerst in den Einstellungen herunter"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo local no se ha descargado; descárguelo primero en la configuración"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo local não foi baixado; baixe-o nas configurações primeiro"
          }
        }
      }
    },
    "localmodels.local_provider_adapter.this_model_version_is_not_supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model version is not supported yet; choose an available model from the local model list"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个模型版本暂不受支持，请在本地模型列表中选择可用型号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個模型版本暫不受支援，請在本地模型列表中選擇可用型號"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルバージョンはまだサポートされていません。ローカルモデルリストから利用可能なモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델 버전은 아직 지원되지 않습니다; 로컬 모델 목록에서 사용 가능한 모델을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de modèle n'est pas encore prise en charge ; choisissez un modèle disponible dans la liste des modèles locaux"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Modellversion wird noch nicht unterstützt; wählen Sie ein verfügbares Modell aus der lokalen Modellliste"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
