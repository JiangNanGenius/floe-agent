    "providers.waiting_secret.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration synced but the API key has not synced yet. Re-enter it to use now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已同步，但 API 密钥尚未同步。可重新输入以立即使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置已同步，但 API 金鑰尚未同步。可重新輸入以立即使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定は同期されましたが、APIキーはまだ同期されていません。 今すぐ使用するために再入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성은 동기화되었지만 API 키가 아직 동기화되지 않았습니다. 지금 사용하려면 다시 입력하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration a été synchronisée, mais la touche API n'a pas encore été synchronisée. Rentrez-le pour l'utiliser maintenant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration wurde synchronisiert, aber die API-Taste wurde noch nicht synchronisiert. Geben Sie es erneut ein, um es jetzt zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración sincronizada, pero la tecla API aún no se ha sincronizado. Vuelve a introducirlo para usarlo ahora."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuração sincronizada, mas a tecla API ainda não foi sincronizada. Digite-o novamente para usar agora."
          }
        }
      }
    },
