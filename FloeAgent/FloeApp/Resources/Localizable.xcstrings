    "settings.privacy.clear_history.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes all conversations, runs and saved approvals from this device. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本设备上的全部对话、运行记录与已保存授权。此操作不可撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除本裝置上的全部對話、執行記錄與已儲存授權。此操作不可撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスからすべての会話、実行、保存された承認を削除します。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 모든 대화, 실행 및 저장된 승인을 삭제합니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les conversations, exécute et approuve les approbations enregistrées de cet appareil. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht alle Unterhaltungen, Ausläufe und gespeicherte Genehmigungen von diesem Gerät. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todas las conversaciones, ejecuta y aprobaciones guardadas de este dispositivo. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui todas as conversas, execuções e aprovações salvas deste dispositivo. Isso não pode ser desfeito."
          }
        }
      }
    },
