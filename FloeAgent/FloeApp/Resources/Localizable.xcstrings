            "state": "translated",
            "value": "顯示前 5,000 個原子，可選擇鏈縮小範圍。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の5,000個の原子を表示しています。 チェーンを選択してビューを絞り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 5,000개의 원자를 보여줍니다. 보기를 좁히려면 체인을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Montrant les 5 000 premiers atomes. Sélectionnez une chaîne pour affiner la vue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die ersten 5.000 Atome. Wählen Sie eine Zeichenfolge aus, um die Ansicht einzugrenzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando los primeros 5.000 átomos. Seleccione una cadena para reducir la vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os primeiros 5.000 átomos. Selecione uma cadeia para restringir a visualização."
          }
        }
      }
    },
