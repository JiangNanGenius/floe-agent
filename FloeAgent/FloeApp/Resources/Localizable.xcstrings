          "stringUnit": {
            "state": "translated",
            "value": "檔案在第 %@ 位元組處無法解碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは %@ バイトでデコードできませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 바이트 %@에서 디코딩할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être décodé à l'octet %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht bei Byte %@ dekodiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se pudo decodificar en el byte %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pôde ser decodificado no byte %@."
          }
        }
      }
    },
    "app.text_reader_view.the_file_s_own_encoding": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件自带的编码标记与所选编码（%@）不一致；请改用自动或匹配的编码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file's own encoding mark does not match the selected encoding (%@). Choose Auto or the matching encoding."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案自帶的編碼標記與所選編碼（%@）不一致；請改用自動或匹配的編碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル自身のエンコーディングマークが、選択されたエンコーディング（%@）と一致しません。 Auto または該当するエンコーディングを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 자체의 인코딩 마크가 선택한 인코딩(%@)과 일치하지 않습니다. 자동 또는 일치하는 인코딩을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La marque d'encodage du fichier ne correspond pas à l'encodage sélectionné (%@). Choisissez Auto ou l'encodage correspondant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das eigene Codierungszeichen der Datei stimmt nicht mit der ausgewählten Codierung überein (%@). Wählen Sie Auto oder die passende Codierung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La propia marca de codificación del archivo no coincide con la codificación seleccionada (%@). Elija Auto o la codificación correspondiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A própria marca de codificação do arquivo não corresponde à codificação selecionada (%@). Escolha Automático ou a codificação correspondente."
          }
        }
      }
    },
    "app.text_reader_view.the_selected_encoding_could_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选编码（%@）无法完整解码此文件；未显示替换字符。可改用自动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected encoding (%@) could not decode the whole file; no replacement characters were shown. Try Auto."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選編碼（%@）無法完整解碼此檔案；未顯示替換字元。可改用自動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたエンコーディング（%@）は、ファイル全体をデコードできませんでした。置換文字は表示されませんでした。 オートをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 인코딩(%@)은 전체 파일을 디코딩할 수 없으며, 교체 문자가 표시되지 않았습니다. 자동을 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encodage sélectionné (%@) n'a pas pu décoder l'ensemble du fichier ; aucun caractère de remplacement n'a été affiché. Essayez Auto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgewählte Codierung (%@) konnte die gesamte Datei nicht entschlüsseln; es wurden keine Ersatzzeichen angezeigt. Versuchen Sie Auto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La codificación seleccionada (%@) no pudo decodificar todo el archivo; no se mostraron caracteres de reemplazo. Prueba Auto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A codificação selecionada (%@) não pôde decodificar todo o arquivo; nenhum caractere de substituição foi mostrado. Tente Auto."
          }
        }
      }
    },
