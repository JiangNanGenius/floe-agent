    "cad.mesh.faceted.scope": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert a small closed mesh or sew exact sheets into a solid. Complex scans may need simplification or manual reconstruction."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将较小的闭合网格或缝合后的精确片体转换为实体。复杂扫描件可先简化或人工重建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將較小的閉合網格或縫合後的精確片體轉換為實體。複雜掃描件可先簡化或人工重建。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな閉じたメッシュを変換するか、同じシートを縫い合わせて実体にしてください。 複雑なスキャンは、簡略化または手動での再構築が必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 폐쇄 메쉬를 변환하거나 정확한 시트를 꿰매어 고체로 만드십시오. 복잡한 스캔은 단순화 또는 수동 재구성이 필요할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez une petite maille fermée ou cousez des feuilles exactes en un solide. Les scans complexes peuvent nécessiter une simplification ou une reconstruction manuelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandeln Sie ein kleines geschlossenes Netz oder nähen Sie exakte Blätter in ein festes. Komplexe Scans müssen möglicherweise vereinfacht oder manuell rekonstruiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierta una pequeña malla cerrada o coser hojas exactas en una sólida. Los escaneos complejos pueden necesitar simplificación o reconstrucción manual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Converta uma pequena malha fechada ou costure folhas exatas em um sólido. Varredas complexas podem precisar de simplificação ou reconstrução manual."
          }
        }
      }
    },
