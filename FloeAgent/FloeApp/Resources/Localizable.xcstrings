    "app.engineering_review_sheet.the_open_drawing_has_unsaved": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前图纸窗口有未保存的手工修改，已暂缓应用该提案。请先保存或放弃这些修改；保存后若提示图纸已变化，请让助手重新生成提案。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The open drawing has unsaved manual edits, so this proposal was NOT applied. Save or discard them first; if the drawing changed, ask the assistant to propose again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前圖紙視窗有未儲存的手工修改，已暫緩應用該提案。請先儲存或放棄這些修改；儲存後若提示圖紙已變化，請讓助手重新生成提案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープン図面には保存されていない手動編集があるため、この提案は適用されませんでした。 まず保存するか破棄してください。図が変わった場合は、アシスタントに再度提案を依頼してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 도면에 저장되지 않은 수동 편집이 있어 이 제안은 적용되지 않았습니다. 먼저 저장하거나 폐기하십시오; 도면이 변경된 경우, 조수에게 다시 제안하도록 요청하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dessin ouvert a des modifications manuelles non enregistrées, donc cette proposition n'a PAS été appliquée. Enregistrez-les ou jetez-les d'abord ; si le dessin a changé, demandez à l'assistant de proposer à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die offene Zeichnung hat nicht gespeicherte manuelle Bearbeitungen, so dass dieser Vorschlag NICHT angewendet wurde. Speichern oder verwerfen Sie sie zuerst; wenn sich die Zeichnung geändert hat, bitten Sie den Assistenten, erneut einen Vorschlag zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dibujo abierto tiene ediciones manuales no guardadas, por lo que esta propuesta NO se aplicó. Guárdalos o deséchalos primero; si el dibujo ha cambiado, pídele al asistente que vuelva a proponerles matrimonio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desenho aberto tem edições manuais não salvas, então esta proposta NÃO foi aplicada. Salve-os ou descarte-os primeiro; se o desenho mudou, peça ao assistente para propor novamente."
          }
        }
      }
    },
    "app.engineering_review_sheet.the_decision_record_could_not": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法持久化本次应用记录，已取消应用（磁盘未改动）：%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decision record could not be persisted, so the apply was cancelled (disk unchanged): %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法持久化本次應用記錄，已取消應用（磁碟未改動）：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決定レコードを永続化できなかったため、適用はキャンセルされました（ディスクは変更されていません）: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결정 레코드를 지속할 수 없어 적용이 취소되었습니다(디스크는 변경되지 않음): %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement de la décision n'a pas pu être conservé, donc l'application a été annulée (disque inchangé) : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entscheidungsdatensatz konnte nicht beibehalten werden, daher wurde der Antrag abgebrochen (Datenträger unverändert): %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo persistir el registro de decisión, por lo que la solicitud se canceló (disco sin cambios): %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro de decisão não pôde ser persistido, então a inscrição foi cancelada (disco inalterado): %@"
          }
        }
      }
    },
