    "template.parallel_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This workspace already had an environment; this one is separate, and existing conversations keep using the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该工作区已有环境；此环境相互独立，现有会话仍使用原环境。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該工作區已有環境；此環境相互獨立，現有會話仍使用原環境。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このワークスペースにはすでに環境がありましたが、こちらは別個で、既存の会話は元のものを使用し続けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간은 이미 환경이 있었으며, 이 환경은 별도이고 기존 대화는 원본을 계속 사용하고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet espace de travail avait déjà un environnement ; celui-ci est séparé, et les conversations existantes continuent d'utiliser l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Arbeitsbereich hatte bereits eine Umgebung; diese ist separat, und bestehende Gespräche verwenden weiterhin das Original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espacio de trabajo ya tenía un entorno; este es independiente, y las conversaciones existentes siguen usando el original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este espaço de trabalho já tinha um ambiente; este é separado, e as conversas existentes continuam usando o original."
          }
        }
      }
    },
    "template.pin_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new environment keeps the exact template version above. If this workspace already has an environment, it keeps its own version and data unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新环境固定使用上述模板版本；若该工作区已有环境，原有环境的版本和数据保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新環境固定使用上述模板版本；若該工作區已有環境，原有環境的版本和資料保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい環境は、上記の正確なテンプレートバージョンを保持します。 このワークスペースにすでに環境がある場合、独自のバージョンとデータは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 환경은 위의 정확한 템플릿 버전을 유지합니다. 이 작업 공간에 이미 환경이 있는 경우, 자체 버전과 데이터를 그대로 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouvel environnement conserve la version exacte du modèle ci-dessus. Si cet espace de travail dispose déjà d'un environnement, il conserve sa propre version et ses données inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Umgebung behält die genaue Vorlagenversion oben bei. Wenn dieser Arbeitsbereich bereits über eine Umgebung verfügt, bleiben seine eigene Version und Daten unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo entorno mantiene la versión exacta de la plantilla anterior. Si este espacio de trabajo ya tiene un entorno, mantiene su propia versión y datos sin cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo ambiente mantém a versão exata do modelo acima. Se este espaço de trabalho já tiver um ambiente, ele mantém sua própria versão e dados inalterados."
          }
        }
      }
    },
