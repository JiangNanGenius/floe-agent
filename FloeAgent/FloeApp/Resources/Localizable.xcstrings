        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평평한 얼굴을 탭하십시오 — 여기에서는 평면 얼굴만 다시 선택할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
