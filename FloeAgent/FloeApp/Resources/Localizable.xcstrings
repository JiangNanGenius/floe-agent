    "app.file_preview_view.will_be_deleted_from_this": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将从当前工作区删除，此操作不能撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” will be deleted from this workspace. This cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”將從當前工作區刪除，此操作不能撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はこのワークスペースから削除されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”는 이 작업 공간에서 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé de cet espace de travail. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" wird aus diesem Arbeitsbereich gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se eliminará de este espacio de trabajo. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” será excluído deste espaço de trabalho. Isso não pode ser desfeito."
          }
        }
      }
    },
    "app.bilingual.9962d448024a75b4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区不可用，无法编辑。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace is unavailable, so editing is unavailable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前工作區不可用，無法編輯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースが利用できないため、編集できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 공간을 사용할 수 없으므로 편집을 사용할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
