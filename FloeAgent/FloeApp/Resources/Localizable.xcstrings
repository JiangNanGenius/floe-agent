    "core.heavy_runtime_arbiter.a_task_is_still_using_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A task is still using the local model, so the Linux environment cannot start until it is released; finish that task and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型仍被某个任务占用，无法在释放前启动 Linux 环境；请结束该任务后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型仍被某個任務佔用，無法在釋放前啟動 Linux 環境；請結束該任務後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクはまだローカルモデルを使用しているため、Linux 環境はリリースされるまで起動できません。そのタスクを完了し、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 아직 로컬 모델을 사용하고 있으므로 Linux 환경이 해제될 때까지 시작할 수 없습니다; 해당 작업을 완료하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche utilise toujours le modèle local, donc l'environnement Linux ne peut pas démarrer tant qu'il n'est pas libéré ; terminez cette tâche et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe verwendet weiterhin das lokale Modell, daher kann die Linux-Umgebung nicht gestartet werden, bis sie freigegeben wird. Beenden Sie diese Aufgabe und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea sigue utilizando el modelo local, por lo que el entorno Linux no puede iniciarse hasta que se libere; termine esa tarea e inténtelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa ainda está usando o modelo local, então o ambiente Linux não pode começar até que seja liberado; termine essa tarefa e tente novamente."
          }
        }
      }
    },
    "core.heavy_runtime_arbiter.the_linux_environment_did_not_stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux environment did not stop in time, so this local model request was canceled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境未能在预期时间内停止，已取消本次本地模型请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境未能在預期時間內停止，已取消本次本地模型請求。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境は時間内に停止しなかったため、このローカルモデルのリクエストはキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경이 제때 중단되지 않아 이 로컬 모델 요청이 취소되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement Linux ne s'est pas arrêté à temps, donc cette demande de modèle local a été annulée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung wurde nicht rechtzeitig gestoppt, daher wurde diese lokale Modellanforderung abgebrochen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno Linux no se detuvo a tiempo, por lo que se canceló esta solicitud de modelo local."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux não parou a tempo, então esta solicitação de modelo local foi cancelada."
          }
        }
      }
    },
    "core.heavy_runtime_arbiter.the_local_model_needs_the_running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model needs the running Linux environment stopped first, but that action cannot be confirmed right now."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型需要先停止正在运行的 Linux 环境，但当前无法确认该操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型需要先停止正在執行的 Linux 環境，但當前無法確認該操作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルでは、まず実行中のLinux環境を停止する必要がありますが、その操作は現在確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델은 먼저 실행 중인 Linux 환경을 중지해야 하지만, 해당 작업은 현재 확인할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle local a besoin que l'environnement en cours d'exécution Linux soit arrêté en premier, mais cette action ne peut pas être confirmée pour le moment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Modell muss zuerst die laufende Linux-Umgebung stoppen, aber diese Aktion kann jetzt nicht bestätigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo local necesita que el entorno Linux en ejecución se detenga primero, pero esa acción no se puede confirmar en este momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo local precisa que o ambiente Linux em execução seja interrompido primeiro, mas essa ação não pode ser confirmada agora."
          }
        }
      }
    },
    "core.heavy_runtime_arbiter.the_local_model_run_was_canceled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model run was canceled: the Linux environment is still running and the two cannot run at the same time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型已取消：Linux 环境仍在运行，两者不能同时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地模型已取消：Linux 環境仍在執行，兩者不能同時使用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルモデルの実行はキャンセルされました：Linux 環境はまだ実行中であり、両者を同時に実行することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 모델 실행이 취소되었습니다: Linux 환경은 여전히 실행 중이며 두 환경은 동시에 실행될 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exécution du modèle local a été annulée : l'environnement Linux est toujours en cours d'exécution et les deux ne peuvent pas fonctionner en même temps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Modelllauf wurde abgebrochen: Die Linux-Umgebung läuft immer noch und die beiden können nicht gleichzeitig ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ejecución del modelo local se canceló: el entorno Linux sigue funcionando y los dos no pueden ejecutarse al mismo tiempo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução do modelo local foi cancelada: o ambiente Linux ainda está em execução e os dois não podem ser executados ao mesmo tempo."
          }
        }
      }
    },
