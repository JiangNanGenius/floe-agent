          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この選択は、正確に1つの解析面と一致しません。 単一の平面を再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 선택은 정확히 하나의 분석 면과 일치하지 않습니다. 단일 평면 면을 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection ne correspond pas exactement à un visage analytique. Réélectionnez une seule face plane."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auswahl entspricht nicht genau einem analytischen Gesicht. Wählen Sie eine einzelne planare Fläche erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta selección no coincide exactamente con una cara analítica. Vuelva a seleccionar una sola cara plana."
