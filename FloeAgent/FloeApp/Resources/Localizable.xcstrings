    "settings.sync.master.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master switch controls all cross-device sync. Turning it off moves configured provider keys to this device's local Keychain and pauses CloudKit traffic."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总开关控制全部跨设备同步。关闭后，已配置的供应商密钥会迁移到本机钥匙串，同时暂停 CloudKit 网络同步。"
          }
        }
      }
    },
    "settings.sync.master.header": {
