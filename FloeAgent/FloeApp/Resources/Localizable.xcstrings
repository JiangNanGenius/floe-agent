    "model.reasoning.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe maps this setting to each provider's native reasoning controls. Automatic preserves the provider default; unsupported fields are omitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 会按供应商协议转换该设置。自动会保留供应商默认行为；不支持的参数不会发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 會按供應商協議轉換該設定。自動會保留供應商預設行為；不支援的引數不會傳送。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe はこの設定を各プロバイダーのネイティブな推論コントロールにマッピングします。 自動的にプロバイダーのデフォルトを保持し、サポートされていないフィールドは省略されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe는 이 설정을 각 제공자의 기본 추론 제어에 매핑합니다. 자동으로 제공자 기본값을 보존하고, 지원되지 않는 필드는 생략됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe mappe ce paramètre aux contrôles de raisonnement natifs de chaque fournisseur. Automatique préserve la valeur par défaut du fournisseur ; les champs non pris en charge sont omis."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe ordnet diese Einstellung den nativen Argumentationssteuerelementen jedes Anbieters zu. Automatisch bleibt die Standardeinstellung des Anbieters erhalten; nicht unterstützte Felder werden weggelassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe asigna esta configuración a los controles de razonamiento nativos de cada proveedor. Automáticamente conserva el valor predeterminado del proveedor; se omiten los campos no compatibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Floe mapeia essa configuração para os controles de raciocínio nativos de cada provedor. Automático preserva o padrão do provedor; campos não suportados são omitidos."
          }
        }
      }
    },
