    "settings.apple_capabilities_settings_view.browse_the_web_structurally_use_screenshot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse the web structurally; use screenshot vision only when information is insufficient."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结构化浏览网页；信息不足时才使用截图视觉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結構化瀏覽網頁；資訊不足時才使用截圖視覺。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブを構造的に閲覧し、情報が不十分な場合にのみスクリーンショットビジョンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹을 구조적으로 탐색하십시오; 정보가 충분하지 않을 경우에만 스크린샷을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez le Web de manière structurelle ; n'utilisez la vision de la capture d'écran que lorsque les informations sont insuffisantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfen Sie strukturell im Internet; verwenden Sie die Screenshot-Vision nur, wenn die Informationen nicht ausreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue por la web estructuralmente; use la visión de captura de pantalla solo cuando la información sea insuficiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue na web estruturalmente; use a visão da captura de tela apenas quando as informações forem insuficientes."
          }
        }
      }
    },
