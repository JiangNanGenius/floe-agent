    "auxiliary.vision.reasoning.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default for faster image inspection. When enabled, Floe explicitly requests the provider's lowest reasoning level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭以加快识图；开启后会显式请求供应商支持的最低思考强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉以加快識圖；開啟後會顯式請求供應商支援的最低思考強度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像検査を高速化するために、デフォルトでオフにしています。 有効にすると、Floe はプロバイダーの最低推論レベルを明示的に要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 검사를 더 빠르게 하려면 기본적으로 꺼져 있습니다. 활성화되면 Floe는 공급자의 가장 낮은 추론 수준을 명시적으로 요청합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déserrvié par défaut pour une inspection plus rapide de l'image. Lorsqu'il est activé, Floe demande explicitement le niveau de raisonnement le plus bas du fournisseur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus für eine schnellere Bildprüfung. Wenn aktiviert, fordert Floe explizit die niedrigste Argumentationsstufe des Anbieters an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto para una inspección de imagen más rápida. Cuando se habilita, Floe solicita explícitamente el nivel de razonamiento más bajo del proveedor."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por padrão para uma inspeção de imagem mais rápida. Quando ativado, Floe solicita explicitamente o nível de raciocínio mais baixo do provedor."
          }
        }
      }
    },
