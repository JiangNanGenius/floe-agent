    "app.bilingual.94900390e52359bf": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一轮仍在执行或停止中，请稍后继续目标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another round is running or stopping. Resume the Goal shortly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一輪仍在執行或停止中，請稍後繼續目標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のラウンドが実行中または停止しています。 まもなく目標を再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 라운드가 진행 중이거나 중단됩니다. 곧 목표를 재개하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre tour est en cours d'exécution ou en arrêt. Reprenez l'objectif sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weitere Runde läuft oder stoppt. Setzen Sie das Ziel in Kürze fort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra ronda está corriendo o deteniéndose. Reanudar el objetivo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra rodada está correndo ou parando. Retome a Meta em breve."
          }
        }
      }
    },
    "app.bilingual.6a4dea32e74e159e": {
      "extractionState": "manual",
      "localizations": {
