    "environment.capabilities.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One reviewed catalog of signed WASI commands. Install downloads the SHA-256-pinned artifact and verifies it before the command can run. Python, Node and Debian packages each keep their own entry."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是审核过的签名 WASI 命令目录。安装会下载固定 SHA-256 的产物并校验通过后才可运行。Python、Node 与 Debian 软件包各自使用独立入口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是稽核過的簽名 WASI 命令目錄。安裝會下載固定 SHA-256 的產物並校驗透過後才可執行。Python、Node 與 Debian 軟體包各自使用獨立入口。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名されたWASIコマンドのカタログを1つレビューしました。 Install は SHA-256 ピン留めされたアーティファクトをダウンロードし、コマンドが実行できる前に検証します。 Python、Node および Debian パッケージはそれぞれ独自のエントリを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 WASI 명령어 카탈로그를 검토했습니다. Install은 SHA-256 고정된 아티팩트를 다운로드하고 명령이 실행되기 전에 이를 검증합니다. Python, Node 및 Debian 패키지는 각각 자체 항목을 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un catalogue examiné de commandes WASI signées. Install télécharge l'artefact épinglé SHA-256 et le vérifie avant que la commande ne puisse s'exécuter. Les paquets Python, Node et Debian conservent chacun leur propre entrée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein überprüfter Katalog mit signierten WASI-Befehlen. Install lädt das SHA-256-angeheftete Artefakt herunter und überprüft es, bevor der Befehl ausgeführt werden kann. Die Pakete Python, Node und Debian behalten jeweils ihren eigenen Eintrag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un catálogo revisado de comandos WASI firmados. Install descarga el artefacto anclado SHA-256 y lo verifica antes de que el comando pueda ejecutarse. Los paquetes Python, Node y Debian mantienen cada uno su propia entrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um catálogo revisado de comandos WASI assinados. O Install baixa o artefato fixado SHA-256 e o verifica antes que o comando possa ser executado. Os pacotes Python, Node e Debian mantêm sua própria entrada."
          }
        }
      }
    },
