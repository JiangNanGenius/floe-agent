    "workspace.workspace_center.cannot_re_open_the_external_workspace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot re-open the external workspace (security-scoped access failed): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法重新访问外部工作区（安全作用域授权失败）：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新訪問外部工作區（安全作用域授權失敗）：%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部ワークスペースを再開できません（セキュリティスコープのアクセスに失敗しました）：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 작업 공간을 다시 열 수 없습니다(보안 범위 접근 실패): %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de rouvrir l'espace de travail externe (échec de l'accès à la portée de sécurité) : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Externer Arbeitsbereich kann nicht erneut geöffnet werden (Sicherheitszugriff fehlgeschlagen): %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede volver a abrir el espacio de trabajo externo (falló el acceso al ámbito de seguridad): %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível reabrir o espaço de trabalho externo (falha no acesso do escopo de segurança): %@"
          }
        }
      }
    },
    "workspace.workspace_center.delete_or_move_out_the_tasks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete or move out the tasks in this workspace first"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先删除或移出这个工作区中的任务"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先刪除或移出這個工作區中的任務"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、このワークスペースのタスクを削除または移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업 공간에서 작업을 먼저 삭제하거나 이동하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez ou déplacez d'abord les tâches de cet espace de travail"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen oder verschieben Sie zuerst die Aufgaben in diesem Arbeitsbereich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimine o mueva las tareas en este espacio de trabajo primero"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua ou mova as tarefas neste espaço de trabalho primeiro"
          }
        }
      }
    },
