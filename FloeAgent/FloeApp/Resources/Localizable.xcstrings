          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine gültige Bodenhöhe und Höhe in Millimetern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una elevación y altura válidas del piso en milímetros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma elevação e altura válidas do piso em milímetros."
          }
        }
      }
    },
    "cad.building.error.useFinitePositiveBuildingDimensionsInMillimetres": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use finite, positive building dimensions in millimetres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
