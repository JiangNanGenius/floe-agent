    "settings.data_management_view.cleans_only_rebuildable_caches_in_floe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleans only rebuildable caches in Floe's sandbox and temporary files left more than an hour ago; it never deletes workspaces, documents, models, fonts, attachments, databases or credentials."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只清理 Floe 沙盒中的可重建缓存，以及一小时前遗留的临时文件；不会删除工作区、文档、模型、字体、附件、数据库或凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只清理 Floe 沙盒中的可重建快取，以及一小時前遺留的臨時檔案；不會刪除工作區、文件、模型、字型、附件、資料庫或憑據。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe のサンドボックス内の再構築可能なキャッシュと、1時間以上前に残された一時ファイルのみをクリーンし、ワークスペース、ドキュメント、モデル、フォント、添付ファイル、データベース、認証情報は決して削除しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe의 샌드박스에 있는 재구성 가능한 캐시와 1시간 이상 전에 남겨진 임시 파일만 정리합니다; 작업 공간, 문서, 모델, 글꼴, 첨부 파일, 데이터베이스 또는 자격 증명은 절대 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nettoie uniquement les caches reconstructibles dans le bac à sable de Floe et les fichiers temporaires laissés il y a plus d'une heure ; il ne supprime jamais les espaces de travail, les documents, les modèles, les polices, les pièces jointes, les bases de données ou les informations d'identification."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereinigt nur wiederherstellbare Caches in der Sandbox von Floe und temporäre Dateien, die vor mehr als einer Stunde zurückgelassen wurden; es löscht niemals Arbeitsbereiche, Dokumente, Modelle, Schriftarten, Anhänge, Datenbanken oder Anmeldeinformationen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpia solo cachés reconstruibles en la caja de arena de Floe y archivos temporales dejados hace más de una hora; nunca elimina espacios de trabajo, documentos, modelos, fuentes, archivos adjuntos, bases de datos o credenciales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpa apenas caches reconstruíveis na sandbox do Floe e arquivos temporários deixados há mais de uma hora; nunca exclui espaços de trabalho, documentos, modelos, fontes, anexos, bancos de dados ou credenciais."
          }
        }
      }
    },
