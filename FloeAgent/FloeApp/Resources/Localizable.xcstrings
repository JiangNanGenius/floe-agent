            "value": "このサービスのツールをご利用になるには、接続してください。 Canvas のアクセスは別途有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서비스의 도구를 사용하려면 연결하십시오. Canvas 접근은 별도로 활성화할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous pour utiliser les outils de ce service. L'accès à Canvas peut être activé séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie sich, um die Tools dieses Dienstes zu nutzen. Der Canvas-Zugriff kann separat aktiviert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate para usar las herramientas de este servicio. El acceso al lienzo se puede habilitar por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte-se para usar as ferramentas deste serviço. O acesso ao Canvas pode ser ativado separadamente."
          }
        }
      }
    },
