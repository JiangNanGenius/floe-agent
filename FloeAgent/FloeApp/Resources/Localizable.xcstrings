    "cad.loftSurface.boundaryHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directions follow section order. Curvature is perpendicular to the direction. Use two to four evenly spaced parallel sections."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方向沿截面顺序，曲率垂直于方向。使用二至四个等距平行截面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方向沿截面順序，曲率垂直於方向。使用二至四個等距平行截面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指示はセクションの順序に従ってください。 曲率は方向に対して垂直です。 2〜4つの等間隔の平行セクションを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지시는 섹션 순서를 따르십시오. 곡률은 방향에 수직입니다. 두 개에서 네 개의 고르게 배치된 평행 구간을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les instructions suivent l'ordre de la section. La courbure est perpendiculaire à la direction. Utilisez deux à quatre sections parallèles régulièrement espacées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anweisungen folgen Abschnittsreihenfolge. Die Krümmung ist senkrecht zur Richtung. Verwenden Sie zwei bis vier gleichmäßig verteilte parallele Abschnitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las instrucciones siguen el orden de la sección. La curvatura es perpendicular a la dirección. Utilice de dos a cuatro secciones paralelas espaciadas uniformemente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As instruções seguem a ordem da seção. A curvatura é perpendicular à direção. Use duas a quatro seções paralelas uniformemente espaçadas."
          }
        }
      }
    },
