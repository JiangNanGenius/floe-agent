    "diagnostics.logging.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records the selected level and higher. Changes apply immediately; enabling debug does not upload logs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录所选等级及更严重的日志，即时生效。开启调试不会自动上传日志。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄所選等級及更嚴重的日誌，即時生效。開啟除錯不會自動上傳日誌。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたレベル以上を記録します。 変更は直ちに適用されます。デバッグを有効にしてもログはアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 레벨 및 그 이상을 기록합니다. 변경 사항이 즉시 적용됩니다; 디버그를 활성화하면 로그가 업로드되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le niveau sélectionné et supérieur. Les modifications s'appliquent immédiatement ; l'activation du débogage ne télécharge pas les journaux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet die ausgewählte Stufe und höher auf. Änderungen gelten sofort; das Aktivieren des Debugs lädt keine Protokolle hoch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el nivel seleccionado y superior. Los cambios se aplican inmediatamente; habilitar la depuración no carga los registros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o nível selecionado e superior. As alterações se aplicam imediatamente; a ativação da depuração não carrega registros."
          }
        }
      }
    },
