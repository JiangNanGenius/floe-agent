        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 6개의 이미지를 선택하시고, 각각 최대 64 MB 및 총 128 MB를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
