    "app.bilingual.2c9168cdd2ebbc9c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认当前运行盘，请保留旧环境并重建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current runtime disk could not be verified. Retain it and rebuild the environment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認當前執行盤，請保留舊環境並重建。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のランタイムディスクを検証できませんでした。 それを保持し、環境を再構築してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 런타임 디스크를 확인할 수 없습니다. 그것을 유지하고 환경을 재건하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque d'exécution actuel n'a pas pu être vérifié. Conservez-le et reconstruisez l'environnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Laufzeit-Festplatte konnte nicht überprüft werden. Behalten Sie es und bauen Sie die Umwelt wieder auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el disco de tiempo de ejecución actual. Reténgalo y reconstruya el medio ambiente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de tempo de execução atual não pôde ser verificado. Mantenha-o e reconstrua o ambiente."
          }
        }
      }
    },
    "app.bilingual.79aead1c317b1883": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境已变化，请重新检查后确认。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment changed. Check it and confirm again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境已變化，請重新檢查後確認。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境が変わりました。 ご確認の上、再度ご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경이 변했습니다. 확인하고 다시 확인해 주세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement a changé. Vérifiez-le et confirmez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung hat sich verändert. Überprüfen Sie es und bestätigen Sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno cambió. Compruébalo y confirma de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente mudou. Verifique e confirme novamente."
          }
        }
      }
    },
    "app.bilingual.40b528b559d78345": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前运行盘已缺失，无法保留其中的内容。工作区文件会保留；新环境需要重新安装软件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current runtime disk is missing, so its contents cannot be retained. Workspace files are kept; reinstall software in the new environment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前執行盤已缺失，無法保留其中的內容。工作區檔案會保留；新環境需要重新安裝軟體。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のランタイムディスクが欠落しているため、その内容を保持できません。 ワークスペースのファイルは保持されますので、新しい環境でソフトウェアを再インストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 런타임 디스크가 없으므로 그 내용을 보존할 수 없습니다. Workspace 파일은 보관됩니다; 새로운 환경에서 소프트웨어를 다시 설치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque d'exécution actuel est manquant, de sorte que son contenu ne peut pas être conservé. Les fichiers de l'espace de travail sont conservés ; réinstallez le logiciel dans le nouvel environnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Laufzeitdiskette fehlt, daher kann ihr Inhalt nicht beibehalten werden. Arbeitsbereichsdateien werden aufbewahrt; installieren Sie die Software in der neuen Umgebung neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el disco de tiempo de ejecución actual, por lo que no se puede conservar su contenido. Los archivos del espacio de trabajo se mantienen; reinstale el software en el nuevo entorno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco de tempo de execução atual está ausente, portanto, seu conteúdo não pode ser mantido. Os arquivos do espaço de trabalho são mantidos; reinstale o software no novo ambiente."
          }
        }
      }
    },
    "app.linux_image_install_card.older_environment_identified_component_upgrade": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别旧环境（对应 %@ 组件），可升级至 %@。旧运行盘和资料会保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older environment identified (%@ component). Upgrade to %@; the old runtime disk and data are retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已識別舊環境（對應 %@ 元件），可升級至 %@。舊執行盤和資料會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い環境が特定されました（%@ コンポーネント）。 %@にアップグレードしてください；古いランタイムディスクとデータは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 환경이 확인되었습니다 (%@ 구성 요소). %@로 업그레이드하십시오; 기존 런타임 디스크와 데이터는 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environnement plus ancien identifié (composant %@). Mise à niveau vers %@ ; l'ancien disque d'exécution et les données sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Umgebung identifiziert (%@-Komponente). Upgrade auf %@; die alte Laufzeitfestplatte und die Daten bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entorno más antiguo identificado (componente %@). Actualice a %@; el antiguo disco de tiempo de ejecución y los datos se conservan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiente mais antigo identificado (componente %@). Atualize para %@; o disco de tempo de execução antigo e os dados são mantidos."
          }
        }
      }
    },
