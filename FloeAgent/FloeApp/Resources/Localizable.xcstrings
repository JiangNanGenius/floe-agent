    "hosts.host_list_view.creates_a_device_specific_certificate_over": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a device-specific certificate over verified SSH; the private key is kept only on this device. Daily tasks then use mTLS and SSH is for recovery only."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过已验证 SSH 创建本设备专属证书；私钥只保存在本设备。之后日常任务走 mTLS，SSH 仅用于救援。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過已驗證 SSH 建立本裝置專屬證書；私鑰只儲存在本裝置。之後日常任務走 mTLS，SSH 僅用於救援。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みの SSH 上でデバイス固有の証明書を作成します；プライベートキーはこのデバイスにのみ保持されます。 日常のタスクでは、mTLS を使用し、SSH はリカバリ専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 SSH를 통해 장치 전용 인증서를 생성합니다; 개인 키는 이 장치에만 보관됩니다. 일일 작업은 mTLS를 사용하고 SSH는 복구 전용입니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un certificat spécifique à l'appareil sur SSH vérifié ; la clé privée n'est conservée que sur cet appareil. Les tâches quotidiennes utilisent ensuite mTLS et SSH est uniquement pour la récupération."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein gerätespezifisches Zertifikat über verifizierte SSH; der private Schlüssel wird nur auf diesem Gerät gespeichert. Tägliche Aufgaben verwenden dann mTLS und SSH dient nur zur Wiederherstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un certificado específico del dispositivo sobre SSH verificado; la clave privada se mantiene solo en este dispositivo. Las tareas diarias luego usan mTLS y SSH es solo para recuperación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um certificado específico do dispositivo sobre o SSH verificado; a chave privada é mantida apenas neste dispositivo. As tarefas diárias usam mTLS e SSH são apenas para recuperação."
          }
        }
      }
    },
