          "stringUnit": {
            "state": "translated",
            "value": "請先選擇已註冊的工作流，或安裝 Floe 模板到預設分支。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、登録されたワークフローを選択するか、デフォルトブランチに Floe テンプレートをインストールしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등록된 워크플로를 선택하거나 기본 브랜치에 Floe 템플릿을 먼저 설치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un flux de travail enregistré ou installez d'abord le modèle Floe sur la branche par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen registrierten Workflow aus oder installieren Sie zuerst die Floe-Vorlage auf dem Standardzweig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un flujo de trabajo registrado o instale primero la plantilla Floe en la rama predeterminada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um fluxo de trabalho registrado ou instale o modelo Floe na filial padrão primeiro."
          }
        }
      }
    },
    "app.bilingual.5d62155b0431595b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区文件服务不可用，无法发布云端快照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace file service is unavailable, so the cloud snapshot cannot be published."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前工作區檔案服務不可用，無法釋出雲端快照。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワークスペースのファイルサービスが利用できないため、クラウドスナップショットを公開できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워크스페이스 파일 서비스를 사용할 수 없으므로 클라우드 스냅샷을 게시할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de fichiers de l'espace de travail n'est pas disponible, de sorte que l'instantané cloud ne peut pas être publié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Workspace-Dateidienst ist nicht verfügbar, daher kann der Cloud-Snapshot nicht veröffentlicht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de archivos del espacio de trabajo no está disponible, por lo que la instantánea de la nube no se puede publicar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de arquivo do espaço de trabalho não está disponível, portanto, o instantâneo da nuvem não pode ser publicado."
          }
        }
      }
    },
