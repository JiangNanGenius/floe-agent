    "edit.conflict.notesApplyHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These excerpts show text only. Open each version to check handwriting, images and layout. Applying your changes affects the original edited objects; unrelated content is retained. The recovery copy stays available."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只显示文字摘要；请打开版本检查笔迹、图片和布局。应用修改会替换本次编辑涉及的内容，其余内容保留。恢复副本仍然保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡只顯示文字摘要；請開啟版本檢查筆跡、圖片和佈局。應用修改會替換本次編輯涉及的內容，其餘內容保留。恢復副本仍然保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの抜粋はテキストのみを示しています。 各バージョンを開いて、手書き、画像、レイアウトを確認してください。 変更を適用すると、元の編集されたオブジェクトに影響し、無関係なコンテンツは保持されます。 リカバリコピーは利用可能なままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 발췌는 텍스트만 표시합니다. 각 버전을 열어 손글씨, 이미지 및 레이아웃을 확인하십시오. 변경 사항을 적용하면 원본 편집된 객체에 영향을 미치며, 관련 없는 콘텐츠는 유지됩니다. 복구 복사본은 계속 제공됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces extraits ne montrent que du texte. Ouvrez chaque version pour vérifier l'écriture, les images et la mise en page. L'application de vos modifications affecte les objets modifiés originaux ; le contenu non lié est conservé. La copie de récupération reste disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Auszüge zeigen nur Text. Öffnen Sie jede Version, um Handschrift, Bilder und Layout zu überprüfen. Das Anwenden Ihrer Änderungen wirkt sich auf die ursprünglich bearbeiteten Objekte aus; nicht verwandte Inhalte bleiben erhalten. Die Wiederherstellungskopie bleibt verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos extractos solo muestran texto. Abra cada versión para comprobar la letra, las imágenes y el diseño. La aplicación de sus cambios afecta a los objetos editados originales; se conserva el contenido no relacionado. La copia de recuperación permanece disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses trechos mostram apenas texto. Abra cada versão para verificar a caligrafia, imagens e layout. A aplicação de suas alterações afeta os objetos editados originais; o conteúdo não relacionado é retido. A cópia de recuperação permanece disponível."
          }
        }
      }
    },
    "edit.conflict.notesCopy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovered edit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑恢复副本"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯恢復副本"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元された編集"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구된 편집"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Édition récupérée"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellte Bearbeitung"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edición recuperada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Edição recuperada"
          }
        }
      }
    },
    "edit.conflict.notesCopyChanged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery copy has been edited again. Keep both versions and continue in that copy; the older reviewed changes were not applied."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复副本已有新的编辑。请保留两个版本，在副本中继续；本次没有将旧的审阅结果应用到原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復副本已有新的編輯。請保留兩個版本，在副本中繼續；本次沒有將舊的審閱結果應用到原件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーコピーが再度編集されました。 両方のバージョンを保持し、そのコピーで続行してください；以前のレビューされた変更は適用されていませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 복사본이 다시 편집되었습니다. 두 버전을 유지하고 해당 복사본에서 계속 진행하십시오; 이전에 검토된 변경 사항은 적용되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La copie de récupération a été modifiée à nouveau. Conservez les deux versions et continuez dans cette copie ; les modifications révisées plus anciennes n'ont pas été appliquées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungskopie wurde erneut bearbeitet. Behalten Sie beide Versionen bei und fahren Sie in dieser Kopie fort; die älteren überprüften Änderungen wurden nicht angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de recuperación ha sido editada de nuevo. Mantenga ambas versiones y continúe en esa copia; los cambios revisados más antiguos no se aplicaron."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cópia de recuperação foi editada novamente. Mantenha ambas as versões e continue nessa cópia; as alterações revisadas mais antigas não foram aplicadas."
          }
        }
      }
    },
    "edit.conflict.notesPreserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This content changed during editing. Your changes are preserved in a separate, reopenable Notes document. Review both versions before applying your changes to the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间内容发生了变化。你的修改已保存在可重新打开的独立手记副本中。请对照两个版本，再决定是否将修改应用到原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間內容發生了變化。你的修改已儲存在可重新開啟的獨立手記副本中。請對照兩個版本，再決定是否將修改應用到原件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコンテンツは編集中に変更されました。 変更は、別個の再利用可能なNotesドキュメントに保存されます。 元のバージョンに変更を適用する前に、両方のバージョンをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 콘텐츠는 편집 중에 변경되었습니다. 귀하의 변경 사항은 별도의 재열 수 있는 Notes 문서에 보존됩니다. 원본에 변경 사항을 적용하기 전에 두 버전을 모두 검토하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contenu a changé pendant l'édition. Vos modifications sont conservées dans un document Notes distinct et réouvrable. Vérifiez les deux versions avant d'appliquer vos modifications à l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Inhalt hat sich während der Bearbeitung geändert. Ihre Änderungen werden in einem separaten, wiederzugänglichen Notizendokument aufbewahrt. Überprüfen Sie beide Versionen, bevor Sie Ihre Änderungen auf das Original anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contenido cambió durante la edición. Sus cambios se conservan en un documento de Notas separado y reabrible. Revise ambas versiones antes de aplicar sus cambios al original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este conteúdo foi alterado durante a edição. Suas alterações são preservadas em um documento de Notas separado e que pode ser reaberto. Revise ambas as versões antes de aplicar suas alterações ao original."
          }
        }
      }
    },
    "edit.conflict.notesReview": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review conflicting edits"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看编辑冲突"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視編輯衝突"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矛盾する編集を確認してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상충되는 편집 검토"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner les modifications contradictoires"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widersprüchliche Änderungen überprüfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar ediciones conflictivas"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar edições conflitantes"
          }
        }
      }
    },
    "edit.conflict.notesReviewUpdated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original changed again. The review has been refreshed; compare the latest version before applying your changes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件又有新的修改。审阅内容已刷新，请对照最新版本后再应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原件又有新的修改。審閱內容已重新整理，請對照最新版本後再應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のものが変更されました。 レビューが更新されました。変更を適用する前に、最新バージョンを比較してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본이 다시 변경되었습니다. 검토가 새로 고쳐졌습니다; 변경 사항을 적용하기 전에 최신 버전을 비교하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original a encore changé. L'examen a été actualisé ; comparez la dernière version avant d'appliquer vos modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original hat sich wieder geändert. Die Bewertung wurde aktualisiert; vergleichen Sie die neueste Version, bevor Sie Ihre Änderungen anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original cambió de nuevo. La revisión se ha actualizado; compare la última versión antes de aplicar sus cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original mudou novamente. A revisão foi atualizada; compare a versão mais recente antes de aplicar suas alterações."
          }
        }
      }
    },
    "edit.conflict.officeExplanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document changed while you were editing. Open either version to compare it, or export both. Office formatting, images and document structure are retained; versions are not automatically combined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑期间原文档已被修改。可分别打开两个版本对照，或导出保留。Office 的格式、图片及文档结构都会保留，不自动拼合两个文档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯期間原文件已被修改。可分別開啟兩個版本對照，或匯出保留。Office 的格式、圖片及文件結構都會保留，不自動拼合兩個文件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は、あなたが編集している間に変更されました。 どちらかのバージョンを開いて比較するか、両方をエクスポートしてください。 Office の書式設定、画像、文書構造は保持されますが、バージョンは自動的に統合されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 편집 중에 변경되었습니다. 두 버전을 열어 비교하거나, 두 버전을 모두 내보내십시오. Office 형식, 이미지 및 문서 구조는 유지되며, 버전은 자동으로 결합되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document a changé pendant que vous étiez en train de modifier. Ouvrez l'une ou l'autre version pour la comparer, ou exportez les deux. Le formatage Office, les images et la structure du document sont conservés ; les versions ne sont pas automatiquement combinées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument wurde während der Bearbeitung geändert. Öffnen Sie eine der beiden Versionen, um sie zu vergleichen, oder exportieren Sie beide. Office-Formatierung, Bilder und Dokumentstruktur bleiben erhalten; Versionen werden nicht automatisch kombiniert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento cambió mientras estabas editando. Abra cualquiera de las versiones para compararla, o exporte ambas. El formato de Office, las imágenes y la estructura de documentos se conservan; las versiones no se combinan automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento mudou enquanto você estava editando. Abra qualquer uma das versões para compará-la ou exporte ambas. A formatação do Office, as imagens e a estrutura do documento são mantidas; as versões não são combinadas automaticamente."
          }
        }
      }
    },
    "edit.conflict.officeRetained": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original and your recoverable draft stay intact. Exporting a version does not resolve or overwrite the original."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原文件和你的编辑草稿均保留。导出版本不会覆盖原文件，也不会将冲突标为已解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原檔案和你的編輯草稿均保留。匯出版本不會覆蓋原檔案，也不會將衝突標為已解決。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原本と復元可能なドラフトはそのまま保持されます。 バージョンをエクスポートしても、元のバージョンは解決されたり上書きされたりしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본과 복구 가능한 초안은 그대로 유지됩니다. 버전을 내보내는 것은 원본을 해결하거나 덮어쓰지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'original et votre brouillon récupérable restent intacts. L'exportation d'une version ne résout pas ou n'écrase pas l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Original und Ihr wiederherstellbarer Entwurf bleiben intakt. Das Exportieren einer Version löst oder überschreibt das Original nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El original y su borrador recuperable permanecen intactos. Exportar una versión no resuelve ni sobrescribe el original."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O original e seu rascunho recuperável permanecem intactos. Exportar uma versão não resolve ou substitui o original."
          }
        }
      }
    },
