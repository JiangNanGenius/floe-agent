    "app.bilingual.ae73867fe4b7b796": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输未完成，请检查连接、权限和文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer did not finish; check the connection, permissions and files"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "傳輸未完成，請檢查連線、許可權和檔案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が完了しませんでした。接続、権限、およびファイルを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 완료되지 않았습니다; 연결, 권한 및 파일을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert n'est pas terminé ; vérifiez la connexion, les autorisations et les fichiers"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wurde nicht abgeschlossen; überprüfen Sie die Verbindung, Berechtigungen und Dateien"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia no se ha terminado; compruebe la conexión, los permisos y los archivos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência não foi concluída; verifique a conexão, permissões e arquivos"
          }
        }
      }
    },
