        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송을 대기할 수 없습니다. 파일을 선택하고 폴더와 권한을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de faire la file d'attente pour le transfert. Sélectionnez les fichiers et vérifiez les dossiers et les autorisations."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überweisung kann nicht in die Warteschlange gestellt werden. Wählen Sie Dateien aus und überprüfen Sie die Ordner und Berechtigungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede hacer cola para la transferencia. Seleccione los archivos y compruebe las carpetas y los permisos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível enfileirar a transferência. Selecione os arquivos e verifique as pastas e permissões."
          }
        }
      }
    },
