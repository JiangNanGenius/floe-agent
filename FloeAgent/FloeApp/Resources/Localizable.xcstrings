    "settings.data_management_view.fonts_installed_here_are_available_globally": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonts installed here are available globally to all Floe workspaces and document flows. Due to Apple platform limits, they are not silently installed for other apps outside Floe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里安装的字体会全局提供给 Floe 的所有工作区和文档流程。由于 Apple 平台限制，它们不会被静默安装给 Floe 以外的其他 App。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡安裝的字型會全域性提供給 Floe 的所有工作區和文件流程。由於 Apple 平臺限制，它們不會被靜默安裝給 Floe 以外的其他 App。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにインストールされたフォントは、すべての Floe ワークスペースおよびドキュメントフローでグローバルに利用可能です。 Apple のプラットフォーム制限により、Floe 以外の他のアプリにはそれらが静かにインストールされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 설치된 글꼴은 모든 Floe 워크스페이스와 문서 흐름에서 전역적으로 사용할 수 있습니다. Apple 플랫폼 제한으로 인해, Floe 외부의 다른 앱에 대해서는 조용히 설치되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les polices installées ici sont disponibles globalement pour tous les espaces de travail et les flux de documents Floe. En raison des limites de la plate-forme Apple, ils ne sont pas installés en silence pour d'autres applications en dehors de Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier installierte Schriftarten sind weltweit für alle Floe-Arbeitsbereiche und Dokumentabläufe verfügbar. Aufgrund von Apple-Plattformbeschränkungen werden sie nicht stillschweigend für andere Apps außerhalb von Floe installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes instaladas aquí están disponibles globalmente para todos los espacios de trabajo Floe y flujos de documentos. Debido a los límites de la plataforma de Apple, no se instalan silenciosamente para otras aplicaciones fuera de Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes instaladas aqui estão disponíveis globalmente para todos os espaços de trabalho Floe e fluxos de documentos. Devido aos limites da plataforma da Apple, eles não são instalados silenciosamente para outros aplicativos fora do Floe."
          }
        }
      }
    },
