    "packages.source.unsigned.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows a missing signature only for this source. Invalid signatures and mismatched checksums still fail."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅允许此源缺少签名。签名无效或文件摘要不符仍会报错。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅允許此源缺少簽名。簽名無效或檔案摘要不符仍會報錯。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースに対して欠落した署名のみを許可します。 無効な署名や不一致のチェックサムは依然として失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스에만 누락된 서명을 허용합니다. 유효하지 않은 서명과 일치하지 않는 체크섬은 여전히 실패합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise une signature manquante uniquement pour cette source. Les signatures non valides et les sommes de contrôle dépareillées échouent toujours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubt eine fehlende Signatur nur für diese Quelle. Ungültige Signaturen und nicht übereinstimmende Prüfsummen schlagen immer noch fehl."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que falte una firma solo para esta fuente. Las firmas no válidas y las sumas de comprobación que no coinciden siguen fallando."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite uma assinatura ausente apenas para esta fonte. Assinaturas inválidas e somas de verificação incompatíveis ainda falham."
          }
        }
      }
    },
