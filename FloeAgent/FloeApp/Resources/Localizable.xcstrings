      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法载入这一页，请重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page couldn't be loaded. Try again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法載入這一頁，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページを読み込めませんでした。 もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지를 로드할 수 없습니다. 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n'a pas pu être chargée. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite konnte nicht geladen werden. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar esta página. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página não pôde ser carregada. Tente novamente."
          }
        }
      }
    },
