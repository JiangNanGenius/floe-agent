    "workspace.canvas3_d_director_view.after_selecting_an_object_adjust_position": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After selecting an object, adjust position, rotation, size and material in the properties bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择对象后在属性栏调整位置、旋转、尺寸与材质。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇物件後在屬性欄調整位置、旋轉、尺寸與材質。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オブジェクトを選択した後、プロパティバーで位置、回転、サイズ、素材を調整してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "객체를 선택한 후, 속성 표시줄에서 위치, 회전, 크기 및 재질을 조정하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après avoir sélectionné un objet, ajustez la position, la rotation, la taille et le matériau dans la barre des propriétés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdem Sie ein Objekt ausgewählt haben, passen Sie Position, Drehung, Größe und Material in der Eigenschaftsleiste an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de seleccionar un objeto, ajuste la posición, la rotación, el tamaño y el material en la barra de propiedades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de selecionar um objeto, ajuste a posição, rotação, tamanho e material na barra de propriedades."
          }
        }
      }
    },
