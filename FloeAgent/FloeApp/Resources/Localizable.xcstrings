    "chat.temporary.banner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded from history; ending it or switching away discards it immediately, even mid-reply. The provider still processes content under its own policy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存到历史；结束或切换到其他会话会立即丢弃（即使正在回复中）；模型提供方仍按其政策处理内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不儲存到歷史；結束或切換到其他會話會立即丟棄（即使正在回覆中）；模型提供方仍按其政策處理內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歴史から除外されます；それを終了したり、切り替えたりすると、即座に、たとえ返信の途中でも破棄されます。 プロバイダーは依然として自社の方針に従ってコンテンツを処理しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "역사에서 제외되었습니다; 종료하거나 전환하면 즉시, 심지어 답변 중간에도 버려집니다. 제공자는 여전히 자체 정책에 따라 콘텐츠를 처리합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclu de l'histoire ; le terminer ou le changer le rejette immédiatement, même au milieu de la réponse. Le fournisseur traite toujours le contenu selon sa propre politique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus der Geschichte ausgeschlossen; wenn man sie beendet oder wegwechselt, wird sie sofort verworfen, sogar in der Mitte der Reply. Der Anbieter verarbeitet Inhalte weiterhin unter seiner eigenen Richtlinie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluido de la historia; terminarlo o cambiarlo lo descarta inmediatamente, incluso a mitad de respuesta. El proveedor sigue procesando el contenido bajo su propia política."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluído da história; encerrá-lo ou mudar o descarta imediatamente, mesmo no meio da resposta. O provedor ainda processa o conteúdo sob sua própria política."
          }
        }
      }
    },
