          "stringUnit": {
            "state": "translated",
            "value": "녹음이 아직 준비 중입니다. 잠시 후에 다시 떠나 보세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement est toujours en préparation. Essayez de repartir sous peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wird noch vorbereitet. Versuchen Sie, in Kürze erneut zu gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación aún se está preparando. Intenta salir de nuevo en breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação ainda está em preparação. Tente sair novamente em breve."
          }
        }
      }
    },
    "app.bilingual.2cb5d151fdd5d5c9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音尚未结束，请稍后重试。原文件已保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording has not finished yet. Try again shortly. The original is preserved."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音尚未結束，請稍後重試。原檔案已保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はまだ完了していません。 すぐにもう一度お試しください。 原本は保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 아직 끝나지 않았습니다. 잠시 후 다시 시도해 주세요. 원본이 보존되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'est pas encore terminé. Réessayez sous peu. L'original est préservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme ist noch nicht abgeschlossen. Versuchen Sie es in Kürze erneut. Das Original ist erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación aún no ha terminado. Inténtalo de nuevo en breve. El original se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação ainda não terminou. Tente novamente em breve. O original está preservado."
          }
        }
      }
    },
    "app.bilingual.5b40593935e2993f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法播放整段录音。请重试，或展开查看原始片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full recording cannot be played right now. Retry or open its original parts."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時無法播放整段錄音。請重試，或展開檢視原始片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、完全な録音を再生できません。 再試行するか、元の部品を開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 녹음은 현재 재생할 수 없습니다. 다시 시도하거나 원본 부품을 열어 보십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement complet ne peut pas être lu pour le moment. Réessayez ou ouvrez ses pièces d'origine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Aufnahme kann derzeit nicht abgespielt werden. Versuchen Sie es erneut oder öffnen Sie die Originalteile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación completa no se puede reproducir en este momento. Vuelva a intentar o abra sus partes originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação completa não pode ser reproduzida agora. Tente novamente ou abra suas peças originais."
          }
        }
      }
    },
    "app.bilingual.e196ae0ddbf46c5a": {
