    "providers.capability_migration.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review changes to saved models, including capabilities and context length. Nothing changes until you apply."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看已保存模型的能力和上下文长度变化，确认后再应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視已儲存模型的能力和上下文長度變化，確認後再應用。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたモデルの変更を、機能やコンテキストの長さを含めて確認してください。 応募するまで何も変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모델에 대한 변경 사항(기능 및 컨텍스트 길이 포함)을 검토하십시오. 지원하기 전까지는 아무것도 변하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner les modifications apportées aux modèles enregistrés, y compris les capacités et la longueur du contexte. Rien ne change jusqu'à ce que vous postuliez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Änderungen an gespeicherten Modellen, einschließlich Funktionen und Kontextlänge. Nichts ändert sich, bis Sie sich bewerben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise los cambios en los modelos guardados, incluidas las capacidades y la longitud del contexto. Nada cambia hasta que solicitas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise as alterações nos modelos salvos, incluindo recursos e duração do contexto. Nada muda até você se inscrever."
          }
        }
      }
    },
