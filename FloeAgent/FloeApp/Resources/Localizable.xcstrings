    "workspace.workspace_canvas_view.the_canvas_changed_retry_with_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The canvas changed; retry with the latest content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画布已发生变化，请根据最新内容重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "畫布已發生變化，請根據最新內容重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスが変更されました。最新のコンテンツで再試行してください。"
