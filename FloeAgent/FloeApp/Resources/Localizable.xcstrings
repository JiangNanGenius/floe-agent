    "cad.building.error.returnHistoryToTheLatestFeatureBefore": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return history to the latest feature before editing the building."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将历史回到最新特征，再编辑建筑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將歷史回到最新特徵，再編輯建築。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "建物を編集する前に、履歴を最新の機能に戻してください。"
          }
        },
        "ko": {
          "stringUnit": {
