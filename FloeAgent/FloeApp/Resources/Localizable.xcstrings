    "settings.permissions.grants.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvals you chose to remember for a project, host or run. Revoking takes effect immediately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择记住的项目、主机或任务级授权。撤销立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇記住的專案、主機或任務級授權。撤銷立即生效。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト、ホスト、または実行のために記憶することを選択した承認。 取り消しは直ちに有効となります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트, 호스트 또는 실행에 대해 기억하도록 선택한 승인 취소는 즉시 효력이 발생합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approbations dont vous avez choisi de vous souvenir pour un projet, un hôte ou une exécution. La révocation prend effet immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmigungen, die Sie für ein Projekt, einen Gastgeber oder einen Lauf in Erinnerung haben. Der Widerruf wird sofort wirksam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobaciones que elegiste recordar para un proyecto, anfitrión o ejecución. La revocación entra en vigor inmediatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovações que você escolheu lembrar para um projeto, host ou execução. A revogação ensa em vigor imediatamente."
          }
        }
      }
    },
