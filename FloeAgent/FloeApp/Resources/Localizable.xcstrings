    "workspace.i_d_e_language_run_view.the_selected_guest_core_count_cannot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected guest core count cannot be delivered; the run was blocked before any guest start (an explicit dual-core request is never silently run on one hart)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选的客户机内核数无法交付，已在启动前阻止运行（不会以 1 核静默替代 2 核）"
          }
        }
      }
