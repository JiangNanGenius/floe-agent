    "model.limits.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context is required. Maximum output may be left blank to use the provider default, and cannot exceed context when set."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文长度必须填写；最大输出可留空并使用供应商默认值，填写时不能超过上下文长度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文長度必須填寫；最大輸出可留空並使用供應商預設值，填寫時不能超過上下文長度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストが必要です。 最大出力は、プロバイダーのデフォルトを使用するために空白のままにしても、設定時にコンテキストを超えることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문맥이 필요합니다. 최대 출력은 제공자 기본값을 사용하기 위해 비워둘 수 있으며, 설정 시 컨텍스트를 초과할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte est requis. La sortie maximale peut être laissée vide pour utiliser la valeur par défaut du fournisseur et ne peut pas dépasser le contexte lorsqu'elle est définie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontext ist erforderlich. Die maximale Ausgabe kann leer bleiben, um den Standardwert des Anbieters zu verwenden, und kann den Kontext nicht überschreiten, wenn er eingestellt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere contexto. La salida máxima puede dejarse en blanco para usar el valor predeterminado del proveedor, y no puede exceder el contexto cuando se establece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contexto é necessário. A saída máxima pode ser deixada em branco para usar o padrão do provedor e não pode exceder o contexto quando definido."
          }
        }
      }
    },
