    "app.bilingual.e0af5f76b6fab84a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件或工作区已改变，请重新选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file or workspace changed. Select it again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案或工作區已改變，請重新選擇。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルまたはワークスペースが変更されました。 もう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 또는 작업 공간이 변경되었습니다. 다시 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ou l'espace de travail a changé. Sélectionnez-le à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei oder der Arbeitsbereich hat sich geändert. Wählen Sie es erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo o espacio de trabajo cambió. Selecciónelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo ou espaço de trabalho mudou. Selecione-o novamente."
          }
        }
      }
    },
    "app.bilingual.1d694a11c49319eb": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存并关闭正在使用这个文件的编辑器，再删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save and close editors using this file before deleting it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先儲存並關閉正在使用這個檔案的編輯器，再刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを使用してエディタを保存し、削除する前に閉じてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하기 전에 이 파일을 사용하여 편집기를 저장하고 닫으세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez et fermez les éditeurs à l'aide de ce fichier avant de le supprimer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern und schließen Sie Editoren mit dieser Datei, bevor Sie sie löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde y cierre los editores usando este archivo antes de eliminarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve e feche editores usando este arquivo antes de excluí-lo."
          }
        }
      }
    },
