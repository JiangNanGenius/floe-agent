    "app.bilingual.6186a9fd8d5737c0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只调整引出线图形。网络由连线和标签决定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This adjusts the entry drawing. Wires and labels determine the net."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡只調整引出線圖形。網路由連線和標籤決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これによりエントリー図面が調整されます。 ワイヤーとラベルがネットを決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 입장 도면을 조정합니다. 전선과 라벨이 그물을 결정합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ajuste le dessin d'entrée. Les fils et les étiquettes déterminent le filet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Eingangszeichnung angepasst. Drähte und Etiketten bestimmen das Netz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ajusta el dibujo de entrada. Los cables y las etiquetas determinan la red."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ajusta o desenho de entrada. Fios e rótulos determinam a rede."
          }
        }
      }
    },
