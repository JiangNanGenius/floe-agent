            "value": "Sélectionnez une poutre et entrez son matériau, ses supports et sa charge avant l'analyse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Balken aus und geben Sie sein Material, seine Stützen und seine Ladung vor der Analyse ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione una viga e introduzca su material, soportes y carga antes del análisis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
