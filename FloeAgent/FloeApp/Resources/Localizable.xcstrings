    "workspace.workspace_canvas_view.tap_connection_points_to_create_relationships": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap connection points to create relationships; move or zoom the canvas with two fingers"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按连接点创建关系；双指移动或缩放画布"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按連線點建立關係；雙指移動或縮放畫布"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続ポイントをタップして関係を作成し、2本指でキャンバスを移動またはズームしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 지점을 탭하여 관계를 생성하십시오; 두 손가락으로 캔버스를 이동하거나 확대하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur les points de connexion pour créer des relations ; déplacez ou zoomez sur la toile avec deux doigts"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf Verbindungspunkte, um Beziehungen zu erstellen; bewegen oder zoomen Sie die Leinwand mit zwei Fingern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque los puntos de conexión para crear relaciones; mueva o amplíe el lienzo con dos dedos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em pontos de conexão para criar relacionamentos; mova ou amplie a tela com dois dedos"
          }
        }
      }
    },
    "workspace.workspace_canvas_view.tap_or_drag_nodes_with_one": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag nodes with one finger, drag empty space to move the canvas; pinch with two fingers to move or zoom anytime"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单指点选或拖动节点，拖动空白处移动画布；双指可随时移动或缩放"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單指點選或拖動節點，拖動空白處移動畫布；雙指可隨時移動或縮放"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片指でノードをタップまたはドラッグし、空白をドラッグするとキャンバスを移動できます。2本指でピンチすると、いつでも移動またはズームできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 손가락으로 노드를 탭하거나 드래그하고, 빈 공간을 드래그하여 캔버스를 이동하십시오; 두 손가락으로 핀치하면 언제든지 이동하거나 확대할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez ou faites glisser les nœuds avec un doigt, faites glisser l'espace vide pour déplacer la toile ; pincez avec deux doigts pour déplacer ou zoomer à tout moment"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen oder ziehen Sie Knoten mit einem Finger, ziehen Sie den leeren Raum, um die Leinwand zu bewegen; kneifen Sie mit zwei Fingern, um sich jederzeit zu bewegen oder zu zoomen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque o arrastre los nodos con un dedo, arrastre el espacio vacío para mover el lienzo; pellizque con dos dedos para mover o hacer zoom en cualquier momento"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque ou arraste os nós com um dedo, arraste o espaço vazio para mover a tela; aperte com dois dedos para mover ou ampliar a qualquer momento"
          }
        }
      }
    },
    "workspace.workspace_canvas_view.tap_or_drag_to_move_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap or drag to move the current canvas viewport"
          }
        },
        "zh-Hans": {
