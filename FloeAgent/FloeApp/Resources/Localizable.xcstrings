    "app.bilingual.a5f622b91fb4fd6c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按采样刀位检查已设置的夹具及快移穿料；刀杆、刀柄的覆盖见各工序详情。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configured fixtures and rapid-through-stock checked at sampled poses; see each operation for shank and holder coverage."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按取樣刀位檢查已設定的夾具及快移穿料；刀杆、刀柄的覆蓋見各工序詳情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定された治具とラピッドスルーストックは、サンプリングされた姿勢で点検されました；各操作でシャンクとホルダーのカバレッジをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플링된 자세에서 구성된 고정구와 급속 관통 스톡을 점검합니다; 각 작업을 확인하여 샹크와 홀더 커버리지를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appareils configurés et stock rapide vérifiés aux poses échantillonnées ; voir chaque opération pour la couverture de la tige et du support."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurierte Vorrichtungen und Rapid-Through-Lagerbestand an den beprobten Posen überprüft; siehe jede Operation für die Abdeckung von Schaft und Halter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesorios configurados y stock rápido comprobados en las poses muestreadas; consulte cada operación para la cobertura de la caña y el soporte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Luminárias configuradas e estoque rápido verificados em poses amostradas; veja cada operação para cobertura de haste e suporte."
          }
        }
      }
    },
    "app.bilingual.bb2fca8db9a5474a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未执行碰撞查询，请设置夹具或刀具总成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No collision queries were performed. Configure fixtures or a tool assembly."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未執行碰撞查詢，請設定夾具或刀具總成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "衝突クエリは実行されませんでした。 フィクスチャまたはツールアセンブリを設定する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충돌 쿼리가 수행되지 않았습니다. 고정 장치 또는 도구 어셈블리를 구성합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune requête de collision n'a été effectuée. Configurez les appareils ou un ensemble d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine Kollisionsabfragen durchgeführt. Konfigurieren Sie Vorrichtungen oder eine Werkzeugbaugruppe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se realizaron consultas de colisión. Configurar los accesorios o un conjunto de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma consulta de colisão foi realizada. Configure acessórios ou um conjunto de ferramentas."
          }
        }
      }
    },
    "app.bilingual.77cedf62f45733a7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按采样姿态检查已设置的总成、夹具及近似剩余材料。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configured assembly, fixtures and approximate stock checked at sampled poses."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按取樣姿態檢查已設定的總成、夾具及近似剩餘材料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定された組立、治具、および概算在庫は、サンプルされた姿勢で確認されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성된 조립, 고정물 및 대략적인 재고는 샘플링된 포즈에서 확인되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assemblage configuré, accessoires et stock approximatif vérifiés sur les poses échantillonnées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurierte Montage, Vorrichtungen und ungefährer Lagerbestand in den gemusterten Posen überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensamblaje configurado, accesorios y stock aproximado comprobado en las poses muestreadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Montagem configurada, acessórios e estoque aproximado verificados em poses amostradas."
          }
        }
      }
    },
    "app.bilingual.5655f6d5bd924bee": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅检查切削部分与盒形夹具。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the cutting part and box fixtures are checked."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前僅檢查切削部分與盒形夾具。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切断部とボックスフィクスチャのみがチェックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절단 부위와 박스 고정물만 확인되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les pièces de coupe et les accessoires de la boîte sont vérifiés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Schneidteil- und Kastenvorrichtungen werden überprüft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se comprueban la parte de corte y los accesorios de la caja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente as peças de corte e os acessórios da caixa são verificados."
          }
        }
      }
    },
    "app.bilingual.259251da9468188c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "车削型线，沿模型 Z 轴"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning profile along the model Z axis"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "車削型線，沿模型 Z 軸"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのZ軸に沿ってプロファイルを回転させる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 Z축을 따라 프로파일을 회전합니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil de tournage le long de l'axe Z du modèle"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil entlang der Modell-Z-Achse drehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Girar el perfil a lo largo del eje Z del modelo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil de rotação ao longo do eixo Z do modelo"
          }
        }
      }
    },
    "app.bilingual.e80b55a0beb84b56": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "初始型线为模型绕 Z 轴的径向外包络，请确认它适用于当前车削工件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The initial profile is the model's radial envelope about Z. Check that it describes the intended turned part."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "初始型線為模型繞 Z 軸的徑向外包絡，請確認它適用於當前車削工件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初期プロファイルは、モデルのZに関する放射状エンベロープです。 それが意図した回転部品を記述しているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초기 프로파일은 Z에 대한 모델의 방사형 엔벨로프입니다. 의도된 회전 부품을 설명하는지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil initial est l'enveloppe radiale du modèle autour de Z. Vérifiez qu'il décrit la pièce retournée prévue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anfangsprofil ist die radiale Hülle des Modells um Z. Überprüfen Sie, ob das beabsichtigte gedrehte Teil beschrieben wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil inicial es la envolvente radial del modelo sobre Z. Compruebe que describe la parte que se pretende girar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil inicial é o envelope radial do modelo sobre Z. Verifique se ele descreve a peça virada pretendida."
          }
        }
      }
    },
    "app.bilingual.259a4e65a879d061": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Z 顺序设置半径；同一 Z 的点可表达台阶。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set radii in Z order. Equal Z values can define a shoulder."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Z 順序設定半徑；同一 Z 的點可表達臺階。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径をZ順に設定してください。 等しいZ値は肩を定義できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반지를 Z 순서대로 설정하십시오. Z 값이 동일하면 어깨를 정의할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglez les rayons dans l'ordre Z. Des valeurs Z égales peuvent définir une épaule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie die Radien in der Reihenfolge Z ein. Gleiche Z-Werte können eine Schulter definieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer radios en orden Z. Los valores de Z iguales pueden definir un hombro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina os raios em ordem Z. Valores Z iguais podem definir um ombro."
          }
        }
      }
    },
