          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invites rédigées par l'utilisateur ; jamais traitées comme un cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Benutzern verfasste Eingabeaufforderungen; nie als Cache behandelt."
