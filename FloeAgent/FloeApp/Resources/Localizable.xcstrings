    "providers.auxiliary_models_view.used_for_memory_organization_user_profiles": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for memory organization, user profiles, skill extraction and automatic titles. Vision understanding, images and video use their own models below."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于记忆整理、用户画像、技能提炼与自动标题。视觉理解、图片和视频使用下方各自的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於記憶整理、使用者畫像、技能提煉與自動標題。視覺理解、圖片和影片使用下方各自的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリの整理、ユーザープロファイル、スキル抽出、および自動タイトルに使用されます。 ビジョン理解、画像、動画は、以下の独自のモデルを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 조직, 사용자 프로필, 스킬 추출 및 자동 타이틀에 사용됩니다. 비전 이해, 이미지 및 비디오는 아래에서 자체 모델을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour l'organisation de la mémoire, les profils d'utilisateurs, l'extraction des compétences et les titres automatiques. La compréhension de la vision, les images et la vidéo utilisent leurs propres modèles ci-dessous."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für Speicherorganisation, Benutzerprofile, Skill-Extraktion und automatische Titel verwendet. Visionsverständnis, Bilder und Videos verwenden ihre eigenen Modelle unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se utiliza para la organización de la memoria, los perfiles de usuario, la extracción de habilidades y los títulos automáticos. La comprensión de la visión, las imágenes y el vídeo utilizan sus propios modelos a continuación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para organização de memória, perfis de usuário, extração de habilidades e títulos automáticos. A compreensão da visão, imagens e vídeos usam seus próprios modelos abaixo."
          }
        }
      }
    },
