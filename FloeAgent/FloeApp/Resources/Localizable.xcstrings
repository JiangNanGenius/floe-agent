    "platform.background_run_coordinator.submission_was_interrupted_before_the_provider": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submission was interrupted before the provider task ID was saved; whether the provider accepted it is unknown. It is not resubmitted automatically; check the provider console before retrying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交在保存供应商任务 ID 之前中断；供应商是否已受理未知。不会自动重复提交，请核对供应商控制台后再决定是否重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交在儲存供應商任務 ID 之前中斷；供應商是否已受理未知。不會自動重複提交，請核對供應商控制檯後再決定是否重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのタスクIDが保存される前に送信が中断されました；プロバイダーがそれを受け入れたかどうかは不明です。 自動的に再提出されませんので、再試行する前にプロバイダーコンソールをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출이 제공자 작업 ID가 저장되기 전에 중단되었습니다; 제공자가 이를 수락했는지는 알 수 없습니다. 자동으로 재제출되지 않습니다; 재시도하기 전에 제공자 콘솔을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La soumission a été interrompue avant que l'ID de la tâche du fournisseur ne soit enregistré ; on ne sait pas si le fournisseur l'a accepté. Il n'est pas soumis à nouveau automatiquement ; vérifiez la console du fournisseur avant de réessayer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einreichung wurde unterbrochen, bevor die Aufgaben-ID des Anbieters gespeichert wurde; ob der Anbieter sie akzeptiert hat, ist unbekannt. Es wird nicht automatisch erneut eingereicht; überprüfen Sie die Anbieterkonsole, bevor Sie es erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío se interrumpió antes de que se guardara el ID de la tarea del proveedor; se desconoce si el proveedor lo aceptó. No se vuelve a enviar automáticamente; compruebe la consola del proveedor antes de volver a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio foi interrompido antes que o ID da tarefa do provedor fosse salvo; não se sabe se o provedor aceitou. Não é reenviado automaticamente; verifique o console do provedor antes de tentar novamente."
          }
        }
      }
    },
    "platform.background_run_coordinator.task_is_running": {
      "extractionState": "manual",
