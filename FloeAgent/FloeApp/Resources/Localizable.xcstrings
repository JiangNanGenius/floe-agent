    "app.bilingual.4739914ee7dd85c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别文本编码，为避免乱码没有显示内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text encoding could not be recognized, so nothing was decoded."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法識別文字編碼，為避免亂碼沒有顯示內容。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストエンコーディングが認識できなかったため、何もデコードされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 인코딩을 인식할 수 없어 아무것도 디코딩되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encodage du texte n'a pas pu être reconnu, donc rien n'a été décodé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Textkodierung konnte nicht erkannt werden, so dass nichts dekodiert wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reconocer la codificación de texto, por lo que no se decodificó nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A codificação de texto não pôde ser reconhecida, então nada foi decodificado."
          }
        }
      }
    },
