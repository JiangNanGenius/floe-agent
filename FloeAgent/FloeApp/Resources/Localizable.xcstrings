    "app.bilingual.3415b83133d5270d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端仍在处理；稍后可用“继续并保存”恢复，不会重复创建付费任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud is still working. Use “Continue and save” later; no duplicate paid job is created."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雲端仍在處理；稍後可用“繼續並儲存”恢復，不會重複建立付費任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドはまだ稼働しています。 「Continue and save」を後で使用してください。重複した有料ジョブは作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드가 여전히 작동하고 있습니다. “Continue and save”를 나중에 사용하십시오; 중복된 유료 작업이 생성되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cloud fonctionne toujours. Utilisez \"Continuer et enregistrer\" plus tard ; aucune tâche payée en double n'est créée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud funktioniert immer noch. Verwenden Sie später \"Weiter und speichern\"; es wird kein doppelter bezahlter Auftrag erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nube sigue funcionando. Utilice \"Continuar y guardar\" más tarde; no se crea ningún trabajo pagado duplicado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nuvem ainda está funcionando. Use \"Continuar e salvar\" mais tarde; nenhum trabalho pago duplicado é criado."
          }
        }
      }
    },
