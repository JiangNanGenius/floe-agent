    "shortcuts.intent.schedule_task.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the task to Floe's background scheduling; iOS decides when the system wakes it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把任务加入 Floe 的后台调度；系统唤醒时间由 iOS 决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把任務加入 Floe 的後臺排程；系統喚醒時間由 iOS 決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクを Floe のバックグラウンドスケジューリングに追加してください；iOS がシステムが起動する時期を決定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 Floe의 백그라운드 스케줄링에 추가하십시오; iOS가 시스템이 언제 깨우는지를 결정합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez la tâche à la planification en arrière-plan de Floe ; iOS décide quand le système la réveille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie die Aufgabe zur Hintergrundplanung von Floe hinzu; iOS entscheidet, wann das System sie aufweckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue la tarea a la programación en segundo plano de Floe; iOS decide cuándo el sistema la activa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a tarefa ao agendamento em segundo plano do Floe; iOS decide quando o sistema a desperta."
          }
        }
      }
    },
