    "settings.privacy_security_view.the_device_has_no_usable_authentication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device has no usable authentication configured."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备未设置可用的身份验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置未設定可用的身份驗證。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスには利用可能な認証が設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 장치에 사용 가능한 인증이 구성되어 있지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
