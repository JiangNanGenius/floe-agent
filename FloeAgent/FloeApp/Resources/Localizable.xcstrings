    "app.bilingual.85882c32b4821ab1": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入完整的 ws:// 或 wss:// 地址；端口须为 1–65535，地址中不能包含用户名、密码或 # 片段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a complete ws:// or wss:// address. Ports must be 1–65535; remove any username, password or # fragment."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入完整的 ws:// 或 wss:// 地址；埠須為 1–65535，地址中不能包含使用者名稱、密碼或 # 片段。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な ws:// または wss:// アドレスを入力してください。 ポートは1〜65535である必要があります；ユーザー名、パスワード、または # フラグメントは削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 ws:// 또는 wss:// 주소를 입력하십시오. 포트는 1–65535이어야 하며, 사용자 이름, 비밀번호 또는 # 조각을 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez une adresse ws:// ou wss:// complète. Les ports doivent être 1–65535 ; supprimez tout nom d'utilisateur, mot de passe ou # fragment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine vollständige ws://- oder wss://-Adresse ein. Die Ports müssen 1–65535 sein; entfernen Sie jeden Benutzernamen, jedes Passwort oder jedes #-Fragment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca una dirección ws:// o wss:// completa. Los puertos deben ser 1–65535; elimine cualquier nombre de usuario, contraseña o fragmento #."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um endereço ws:// ou wss:// completo. As portas devem ser 1–65535; remova qualquer nome de usuário, senha ou # fragmento."
          }
        }
      }
    },
