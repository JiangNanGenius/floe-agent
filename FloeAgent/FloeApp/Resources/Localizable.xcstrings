    "app.bilingual.bd29704dd893fed0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编译在 GitHub 的 Linux/macOS 运行器上进行；产物是云端编译结果，不能作为 iOS 可执行文件在本机安装或运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The build runs on GitHub's Linux/macOS runner; the artifact is a cloud build output and cannot be installed or run as an iOS binary on this device."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編譯在 GitHub 的 Linux/macOS 執行器上進行；產物是雲端編譯結果，不能作為 iOS 可執行檔案在本機安裝或執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドは GitHub の Linux/macOS ランナー上で実行されます。アーティファクトはクラウドビルド出力であり、このデバイス上で iOS バイナリとしてインストールしたり実行したりすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빌드는 GitHub의 Linux/macOS 러너에서 실행됩니다; 해당 아티팩트는 클라우드 빌드 출력이며 이 장치에서 iOS 바이너리로 설치하거나 실행할 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La construction s'exécute sur le coureur Linux/macOS de GitHub ; l'artefact est une sortie de construction en nuage et ne peut pas être installé ou exécuté en tant que binaire iOS sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Build läuft auf dem Linux/macOS-Läufer von GitHub; das Artefakt ist eine Cloud-Build-Ausgabe und kann nicht als iOS-Binärdatei auf diesem Gerät installiert oder ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compilación se ejecuta en el corredor Linux/macOS de GitHub; el artefacto es una salida de compilación en la nube y no se puede instalar ni ejecutar como binario iOS en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compilação é executada no corredor Linux/macOS do GitHub; o artefato é uma saída de compilação em nuvem e não pode ser instalado ou executado como um binário iOS neste dispositivo."
          }
        }
      }
    },
    "app.bilingual.d97f3aa477428ac3": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编译产物写入运行专属临时目录，运行后由该次运行清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compiled output goes to a run-owned temporary directory and is cleaned up by this run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編譯產物寫入執行專屬臨時目錄，執行後由該次執行清理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパイルされた出力は実行が所有する一時ディレクトリに保存され、この実行によってクリーンアップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컴파일된 출력은 런이 소유한 임시 디렉터리로 이동하며, 이 실행에 의해 정리됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie compilée va dans un répertoire temporaire appartenant à l'exécution et est nettoyée par cette exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kompilierte Ausgabe wird in ein temporäres Verzeichnis im Besitz des Laufs weitergeleitet und durch diese Ausführung bereinigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida compilada va a un directorio temporal propiedad de la ejecución y se limpia con esta ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída compilada vai para um diretório temporário de propriedade da execução e é limpa por essa execução."
          }
        }
      }
    },
