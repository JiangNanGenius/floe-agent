          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo não tem autenticação utilizável configurada."
          }
        }
      }
    },
    "settings.privacy_security_view.when_on_biometrics_are_preferred_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, biometrics are preferred; the device passcode is used only when biometrics are unavailable or disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启时优先显示生物识别；设备不支持或关闭后才使用设备密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟時優先顯示生物識別；裝置不支援或關閉後才使用裝置密碼。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンの場合、バイオメトリクスが推奨されます；デバイスのパスコードは、バイオメトリクスが利用できない、または無効化されている場合にのみ使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜져 있을 때는 생체 인식이 선호되며, 장치 비밀번호는 생체 인식이 없거나 비활성화된 경우에만 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'elle est activée, la biométrie est préférable ; le code d'accès de l'appareil n'est utilisé que lorsque la biométrie est indisponible ou désactivée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Biometrie aktiviert ist, wird bevorzugt; der Gerätepasscode wird nur verwendet, wenn die Biometrie nicht verfügbar oder deaktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está encendido, se prefiere la biometría; el código de acceso del dispositivo se utiliza solo cuando la biometría no está disponible o está desactivada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, a biometria é preferida; a senha do dispositivo é usada apenas quando a biometria está indisponível ou desativada."
          }
        }
      }
    },
