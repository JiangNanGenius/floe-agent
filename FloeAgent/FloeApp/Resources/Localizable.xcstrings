    "app.bilingual.aaa672918e92784": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转写服务配置或凭据不可用，未覆盖的片段将稍后继续转写；原录音不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live transcription is unavailable because its service configuration or credential was rejected; uncovered chunks will be transcribed later. The recording is unaffected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實時轉寫服務配置或憑據不可用，未覆蓋的片段將稍後繼續轉寫；原錄音不受影響。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ文字起こしは、サービス設定または認証情報が拒否されたため利用できません。未公開のチャンクは後ほど文字起こしされます。 録音は影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 전사는 서비스 구성 또는 자격 증명이 거부되어 사용할 수 없으며, 숨겨진 청크는 나중에 전사될 예정입니다. 녹음은 영향을 받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct n'est pas disponible car sa configuration de service ou ses informations d'identification ont été rejetées ; les morceaux découverts seront transcrits plus tard. L'enregistrement n'est pas affecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Transkription ist nicht verfügbar, da die Dienstkonfiguration oder die Anmeldeinformationen abgelehnt wurden; unbedeckte Teile werden später transkribiert. Die Aufzeichnung ist nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción en vivo no está disponible porque su configuración de servicio o credenciales fue rechazada; los fragmentos descubiertos se transcribirán más tarde. La grabación no se ve afectada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição ao vivo não está disponível porque sua configuração de serviço ou credencial foi rejeitada; pedaços descobertos serão transcritos posteriormente. A gravação não é afetada."
          }
        }
      }
    },
    "app.bilingual.ea8cc4d364bbe433": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时转写暂时不可用，未覆盖的片段将稍后继续转写；原录音不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live transcription is temporarily unavailable; uncovered chunks will be transcribed later. The recording is unaffected."
          }
