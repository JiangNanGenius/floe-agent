    "settings.sync_settings_view.api_keys_saved_ssh_vnc_keys": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API keys, saved SSH/VNC keys and website passwords sync only through iCloud Keychain. Temporary task and project credentials are never uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key、已保存 SSH/VNC 密钥和网页密码仅通过 iCloud Keychain 同步。任务和项目临时凭据永不上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key、已儲存 SSH/VNC 金鑰和網頁密碼僅透過 iCloud Keychain 同步。任務和專案臨時憑據永不上傳。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキー、保存されたSSH/VNCキー、およびウェブサイトのパスワードは、iCloudキーチェーンを通じてのみ同期されます。 一時的なタスクとプロジェクトの認証情報は決してアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키, 저장된 SSH/VNC 키와 웹사이트 비밀번호는 iCloud 키체인을 통해서만 동기화됩니다. 임시 작업 및 프로젝트 자격 증명은 절대 업로드되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clés API, clés SSH/VNC enregistrées et les mots de passe du site Web sont synchronisés uniquement via le trousseau iCloud. Les informations d'identification temporaires des tâches et du projet ne sont jamais téléchargées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel, gespeicherte SSH/VNC-Schlüssel und Website-Passwörter werden nur über iCloud-Schlüsselanhänger synchronisiert. Temporäre Aufgaben- und Projektdaten werden nie hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claves API, claves SSH/VNC guardadas y las contraseñas del sitio web se sincronizan solo a través del llavero de iCloud. Las credenciales temporales de tareas y proyectos nunca se cargan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves API, chaves SSH/VNC salvas e as senhas do site são sincronizadas apenas através das Chaves do iCloud. As credenciais temporárias de tarefas e projetos nunca são carregadas."
          }
        }
      }
    },
    "settings.sync_settings_view.off_by_default_enabling_requires_device": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Enabling requires device-identity verification; non-exportable device keys remain only on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。启用需要验证设备身份；不可导出的设备密钥仍只存在于当前设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。啟用需要驗證裝置身份；不可匯出的裝置金鑰仍只存在於當前裝置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでオフです。 有効化にはデバイス認証が必要です；エクスポートできないデバイスキーはこのデバイスにのみ残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 꺼져 있습니다. 활성화하려면 장치 신원 확인이 필요합니다; 수출이 불가능한 장치 키는 이 장치에만 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déshusté par défaut. L'activation nécessite une vérification de l'identité de l'appareil ; les clés d'appareil non exportables ne restent que sur cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Die Aktivierung erfordert eine Überprüfung der Geräteidentität; nicht exportierbare Geräteschlüssel bleiben nur auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. La habilitación requiere verificación de identidad del dispositivo; las claves de dispositivo no exportables permanecen solo en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligado por padrão. A ativação requer verificação de identidade do dispositivo; as chaves de dispositivo não exportáveis permanecem apenas neste dispositivo."
          }
        }
      }
    },
