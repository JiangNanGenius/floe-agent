          "stringUnit": {
            "state": "translated",
            "value": "A execução foi interrompida. Continue a partir do progresso salvo."
          }
        }
      }
    },
    "app.bilingual.99e2030b6f56eb08": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮已请求停止，但长期目标暂停状态未能保存。请刷新后重试暂停目标。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This round was asked to stop, but the long-term Goal pause could not be saved. Refresh and pause the Goal again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本輪已請求停止，但長期目標暫停狀態未能儲存。請重新整理後重試暫停目標。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このラウンドは停止を求められましたが、長期的な目標の一時停止は保存できませんでした。 目標を再度リフレッシュし、一時停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 라운드는 중단을 요청받았지만, 장기 목표 일시 중단을 구할 수 없었습니다. 목표를 다시 새로 고침하고 일시 정지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On a demandé à ce tour de s'arrêter, mais la pause du but à long terme n'a pas pu être sauvée. Actualisez et mettez à nouveau l'objectif en pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Runde wurde aufgefordert, zu stoppen, aber die langfristige Zielpause konnte nicht gespeichert werden. Aktualisieren und pausieren Sie das Ziel erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pidió que esta ronda se detuviera, pero no se pudo salvar la pausa de la meta a largo plazo. Actualiza y pausa el objetivo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rodada foi solicitada a parar, mas a pausa do Gol de longo prazo não pôde ser salva. Atualize e pause a Meta novamente."
          }
        }
      }
    },
