    "app.bilingual.e54f91c8639a2ac5": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择工序可跳到起点。播放、单步和进度拖动都使用当前工件的刀路。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an operation to jump to its start. Playback, stepping and scrubbing use this workpiece’s toolpaths."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇工序可跳到起點。播放、單步和進度拖動都使用當前工件的刀路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始にジャンプする操作を選択してください。 再生、ステッピング、スクラブは、このワークピースのツールパスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작으로 이동할 작업을 선택하십시오. 재생, 스테핑 및 스크러빙은 이 작업물의 툴패스를 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une opération pour passer à son départ. La lecture, la marche et le nettoyage utilisent les chemins d'outils de cette pièce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Operation aus, um zu ihrem Start zu springen. Spielen, Treten und Schrubben nutzen die Werkzeugwege dieses Werkstücks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione una operación para saltar a su inicio. El juego, el piso y el fregado utilizan los caminos de la herramienta de esta pieza de trabajo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma operação para pular para o seu início. Reproduzir, pisar e esfregar usam os caminhos da ferramenta desta peça de trabalho."
          }
        }
      }
    },
