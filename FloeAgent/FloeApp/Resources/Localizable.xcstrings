          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le document a changé, de sorte que la dernière position de lecture n'a pas été restaurée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dokument hat sich geändert, so dass die letzte Leseposition nicht wiederhergestellt wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El documento cambió, por lo que no se restableció la última posición de lectura."
          }
