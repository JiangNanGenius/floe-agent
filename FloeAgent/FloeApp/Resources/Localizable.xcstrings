    "settings.licenses.note.clipper2_vendor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 provides polygon clipping and offsetting for PCB geometry and media exchange, with its full Boost Software License 1.0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 为 PCB 几何与媒体交换提供多边形裁剪和偏移运算，并随附完整 Boost Software License 1.0 许可。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 為 PCB 幾何與媒體交換提供多邊形裁剪和偏移運算，並隨附完整 Boost Software License 1.0 許可。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 は、PCB のジオメトリおよびメディア交換に対してポリゴンのクリッピングとオフセットを提供し、フル Boost Software License 1.0 を備えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1은 PCB 기하학 및 미디어 교환에 대한 폴리곤 클리핑 및 오프셋을 제공하며, 전체 Boost 소프트웨어 라이선스 1.0을 보유하고 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 fournit un détourage et une compensation de polygones pour la géométrie PCB et l'échange de médias, avec sa licence complète du logiciel Boost 1.0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 bietet Polygon-Clipping und Offseting für PCB-Geometrie und Medienaustausch mit seiner vollständigen Boost Software License 1.0."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clipper2 2.0.1 proporciona recorte y compensación de polígonos para la geometría PCB e intercambio de medios, con su licencia completa de software Boost 1.0."
          }
        },
        "pt-BR": {
