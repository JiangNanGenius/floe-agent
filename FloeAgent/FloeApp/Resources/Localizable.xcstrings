    "app.bilingual.b6cce5c35b5bf3e4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建跟踪远端的新本地分支，不覆盖已有分支或未提交的修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new local branch tracking this remote. Existing branches and uncommitted changes are never replaced."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立跟蹤遠端的新本地分支，不覆蓋已有分支或未提交的修改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリモートを追跡する新しいローカルブランチを作成してください。 既存のブランチおよび未コミットの変更は決して置き換えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원격을 추적하는 새로운 로컬 지점을 생성하십시오. 기존 브랜치와 커밋되지 않은 변경 사항은 절대 교체되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez une nouvelle succursale locale pour suivre cette télécommande. Les branches existantes et les changements non engagés ne sont jamais remplacés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen Sie eine neue lokale Filiale, die diese Fernbedienung verfolgt. Bestehende Zweige und nicht festgelegte Änderungen werden niemals ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cree una nueva sucursal local que rastree este control remoto. Las ramas existentes y los cambios no comprometidos nunca se reemplazan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma nova filial local rastreando este controle remoto. Filiais existentes e alterações não comprometidas nunca são substituídas."
          }
        }
      }
    },
