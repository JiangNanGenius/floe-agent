    "providers.image_provider_adapter.supports_up_to_reference_images_are": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ supports up to %@ reference images; %@ are present. Remove reference images explicitly connected to the generation node, or use a model that supports more."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ 最多支持 %@ 张参考图；当前有 %@ 张。请减少明确连接到生成节点的参考图，或改用支持更多参考图的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ 最多支援 %@ 張參考圖；當前有 %@ 張。請減少明確連線到生成節點的參考圖，或改用支援更多參考圖的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@は最大%@参照画像をサポートしています；%@が存在します。 生成ノードに明示的に接続された参照画像を削除するか、より多くをサポートするモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@는 최대 %@ 참조 이미지를 지원합니다; %@가 존재합니다. 생성 노드에 명시적으로 연결된 참조 이미지를 제거하거나, 더 많은 기능을 지원하는 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ prend en charge jusqu'à des images de référence %@ ; %@ sont présents. Supprimez les images de référence explicitement connectées au nœud de génération, ou utilisez un modèle qui prend en charge plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ unterstützt bis zu %@ Referenzbilder; %@ sind vorhanden. Entfernen Sie Referenzbilder, die explizit mit dem Generationsknoten verbunden sind, oder verwenden Sie ein Modell, das mehr unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ admite imágenes de referencia de hasta %@; %@ están presentes. Elimine las imágenes de referencia explícitamente conectadas al nodo de generación, o utilice un modelo que admita más."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@ suporta até imagens de referência %@; %@ estão presentes. Remova imagens de referência explicitamente conectadas ao nó de geração ou use um modelo que suporte mais."
          }
        }
      }
    },
    "providers.image_provider_adapter.the_current_model_can_generate_at": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current %@ model can generate at most %@ images at a time; this request asks for %@. Reduce the count or use a model that supports multiple images."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 当前模型单次最多生成 %@ 张图片；当前请求 %@ 张。请减少生成数量，或改用支持多图输出的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 當前模型單次最多生成 %@ 張圖片；當前請求 %@ 張。請減少生成數量，或改用支援多圖輸出的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の %@ モデルは、一度に最大 %@ 画像を生成できます。このリクエストは %@ を要求しています。 カウントを減らすか、複数画像に対応したモデルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 %@ 모델은 한 번에 최대 %@ 이미지를 생성할 수 있으며, 이 요청은 %@를 요구합니다. 카운트를 줄이거나 여러 이미지를 지원하는 모델을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle actuel %@ peut générer au plus des images %@ à la fois ; cette demande demande %@. Réduisez le nombre ou utilisez un modèle qui prend en charge plusieurs images."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle %@-Modell kann höchstens %@-Bilder auf einmal erzeugen; diese Anfrage fragt nach %@. Reduzieren Sie die Anzahl oder verwenden Sie ein Modell, das mehrere Bilder unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo actual de %@ puede generar como máximo imágenes %@ a la vez; esta solicitud solicita %@. Reduzca el recuento o use un modelo que admita múltiples imágenes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo atual %@ pode gerar no máximo imagens %@ por vez; esta solicitação solicita %@. Reduza a contagem ou use um modelo que suporte várias imagens."
          }
        }
      }
    },
