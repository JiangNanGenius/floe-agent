    "cad.recovery.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This document can't be opened. Review the last verified save before restoring it as a new copy. The damaged document is not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文档无法打开。请先查看上次已验证的保存，再将其恢复为新副本。损坏的文档不会被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件無法開啟。請先檢視上次已驗證的儲存，再將其恢復為新副本。損壞的文件不會被更改。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この文書は開くことができません。 新しいコピーとして復元する前に、最後に検証されたセーブ内容をご確認ください。 損傷した文書は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문서는 열 수 없습니다. 새 사본으로 복원하기 전에 마지막으로 검증된 저장본을 검토하십시오. 손상된 문서는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce document ne peut pas être ouvert. Vérifiez la dernière sauvegarde vérifiée avant de la restaurer en tant que nouvelle copie. Le document endommagé n'est pas modifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Dokument kann nicht geöffnet werden. Überprüfen Sie den zuletzt verifizierten Speicherstand, bevor Sie ihn als neue Kopie wiederherstellen. Das beschädigte Dokument wird nicht geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento no se puede abrir. Revise el último guardado verificado antes de restaurarlo como una nueva copia. El documento dañado no se ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este documento não pode ser aberto. Revise o último salvamento verificado antes de restaurá-lo como uma nova cópia. O documento danificado não foi alterado."
          }
        }
      }
    },
