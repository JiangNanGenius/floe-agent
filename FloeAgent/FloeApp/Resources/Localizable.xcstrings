    "cad.material.error.ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That face is not unique (%d candidates). Reselect a distinct face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该面不唯一（%d 个候选）。请重新选择不同的面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該面不唯一（%d 個候選）。請重新選擇不同的面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その顔はユニークではありません（%d候補）。 異なる顔を再選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 얼굴은 독특하지 않습니다 (%d 후보). 고유한 얼굴을 다시 선택하십시오."
          }
        },
        "fr": {
