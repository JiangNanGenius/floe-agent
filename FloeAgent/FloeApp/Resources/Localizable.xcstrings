    "app.bilingual.bd320180e9151fc0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动移动画布，双指缩放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to move the canvas; pinch to zoom."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動移動畫布，雙指縮放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスをドラッグして移動し、ピンチでズームしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 이동하려면 드래그하고, 확대하려면 핀치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour déplacer la toile ; pincez pour zoomer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Leinwand zu bewegen; kneifen, um zu zoomen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para mover el lienzo; pellizque para hacer zoom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mover a tela; aperte para ampliar."
          }
        }
      }
    },
