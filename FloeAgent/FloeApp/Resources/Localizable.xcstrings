    "app.bilingual.91c36a47feaf3aa2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按画布选择相近颜色的连续区域。容差与选区模式在工具选项栏中调整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the canvas to select a connected area of similar color. Tolerance and selection mode live in the tool options bar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按畫布選擇相近顏色的連續區域。容差與選區模式在工具選項欄中調整。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスをタップして、同じ色の接続された領域を選択してください。 許容モードと選択モードはツールのオプションバーにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 탭하여 비슷한 색상의 연결된 영역을 선택하십시오. 공차 및 선택 모드는 도구 옵션 막대에 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le canevas pour sélectionner une zone connectée de couleur similaire. La tolérance et le mode de sélection sont en direct dans la barre d'options d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Leinwand, um einen verbundenen Bereich mit ähnlicher Farbe auszuwählen. Toleranz und Auswahlmodus sind in der Werkzeugleiste enthalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el lienzo para seleccionar un área conectada de color similar. La tolerancia y el modo de selección se encuentran en la barra de opciones de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tela para selecionar uma área conectada de cor semelhante. O modo de tolerância e seleção está ativo na barra de opções de ferramentas."
          }
        }
      }
    },
    "app.bilingual.1a62efc57831efb8": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
