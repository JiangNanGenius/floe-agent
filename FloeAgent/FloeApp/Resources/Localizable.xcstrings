    "feedback.logs.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs contain app version, capability states and recent lifecycle events. API keys, credentials and token-shaped values are removed before upload."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志包含版本、能力状态与近期生命周期事件；API Key、凭据和令牌形态内容会在上传前移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日誌包含版本、能力狀態與近期生命週期事件；API Key、憑據和令牌形態內容會在上傳前移除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログにはアプリのバージョン、機能状態、および最近のライフサイクルイベントが含まれます。 API のキー、認証情報、トークン形状の値は、アップロード前に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그에는 앱 버전, 기능 상태 및 최근 라이프사이클 이벤트가 포함됩니다. API 키, 자격 증명 및 토큰 모양 값은 업로드 전에 제거됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les journaux contiennent la version de l'application, les états de capacité et les événements récents du cycle de vie. Les clés API, les informations d'identification et les valeurs en forme de jeton sont supprimées avant le téléchargement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolle enthalten App-Versionen, Funktionsstatus und aktuelle Lebenszyklusereignisse. API-Schlüssel, Anmeldeinformationen und tokenförmige Werte werden vor dem Hochladen entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
