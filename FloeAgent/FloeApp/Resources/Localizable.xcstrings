      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刀片形状、旋转和工序选择会保存并用于生成刀路。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert shape, rotation and operation selection are saved and used when generating toolpaths."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刀片形狀、旋轉和工序選擇會儲存並用於生成刀路。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "挿入形状、回転、操作選択は保存され、ツールパスを生成する際に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삽입 형태, 회전 및 작업 선택은 툴패스를 생성할 때 저장되어 사용됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La forme de l'insertion, la rotation et la sélection d'opération sont enregistrées et utilisées lors de la génération de chemins d'outils."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfügeform, Drehung und Operationsauswahl werden gespeichert und bei der Erzeugung von Werkzeugpfaden verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La forma de inserción, la rotación y la selección de operación se guardan y utilizan al generar rutas de herramientas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserir forma, rotação e seleção de operação são salvos e usados ao gerar caminhos de ferramentas."
          }
        }
      }
    },
