    "notes.notes_knowledge_picker.read_only_by_default_modifications_still": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read-only by default. Modifications still use Floe's tool permissions and approval settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认只读。修改仍使用 Floe 的工具权限与审批设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設只讀。修改仍使用 Floe 的工具許可權與審批設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは読み取り専用です。 変更は引き続き Floe のツール権限と承認設定を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 읽기 전용입니다. 수정은 여전히 Floe의 도구 권한 및 승인 설정을 사용합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecture seule par défaut. Les modifications utilisent toujours les autorisations d'outil et les paramètres d'approbation de Floe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig schreibgeschützt. Änderungen verwenden weiterhin die Werkzeugberechtigungen und Genehmigungseinstellungen von Floe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura por defecto. Las modificaciones aún utilizan los permisos de herramienta y la configuración de aprobación de Floe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente leitura por padrão. As modificações ainda usam as permissões de ferramenta e as configurações de aprovação do Floe."
          }
        }
      }
    },
