    "cad.paint.previewBudget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The painting preview supports up to 10,000 triangles. Simplify a copy first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制预览最多支持 10,000 个三角形，请先简化一个副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繪製預覽最多支援 10,000 個三角形，請先簡化一個副本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "絵画プレビューは最大10,000個の三角形に対応しています。 まず、コピーを簡略化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림 미리보기는 최대 10,000개의 삼각형을 지원합니다. 먼저 복사본을 간소화하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu de la peinture prend en charge jusqu'à 10 000 triangles. Simplifiez d'abord une copie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Gemäldevorschau unterstützt bis zu 10.000 Dreiecke. Vereinfachen Sie zuerst eine Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa de la pintura admite hasta 10.000 triángulos. Simplifique una copia primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização da pintura suporta até 10.000 triângulos. Simplifique uma cópia primeiro."
          }
        }
      }
    },
    "cad.paint.strokeHelp": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw on the surface. Each stroke is one undoable edit. The brush stays inside the touched UV island."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在表面拖动绘制，每笔均可单独撤销，笔刷仅作用于触及的 UV 岛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在表面拖動繪製，每筆均可單獨撤銷，筆刷僅作用於觸及的 UV 島。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表面に描いてください。 各ストロークは1つの元に戻すことができる編集です。 ブラシは触れたUVアイランド内にとどまります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표면에 그리세요. 각 획은 하나의 취소 가능한 편집입니다. 브러시는 접촉한 UV 섬 안에 남아 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez sur la surface. Chaque trait est une modification irréparable. La brosse reste à l'intérieur de l'îlot UV touché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichne auf die Oberfläche. Jeder Strich ist eine unaussambare Bearbeitung. Die Bürste bleibt in der berührten UV-Insel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja en la superficie. Cada golpe es una edición que no se puede hacer. El cepillo permanece dentro de la isla UV tocada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe na superfície. Cada traço é uma edição desfatível. A escova permanece dentro da ilha UV tocada."
          }
        }
      }
    },
