    "app.bilingual.9fdf2e63f89a7621": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此工程已有文件。要重新导入，请先新建一个空白游戏工程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This project already contains files. Create a new empty game project to import again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工程已有檔案。要重新匯入，請先新建一個空白遊戲工程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトにはすでにファイルが含まれています。 再度インポートするために、新しい空のゲームプロジェクトを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트에는 이미 파일이 포함되어 있습니다. 다시 가져오기 위해 새로운 빈 게임 프로젝트를 생성하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce projet contient déjà des fichiers. Créez un nouveau projet de jeu vide à importer à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Projekt enthält bereits Dateien. Erstellen Sie ein neues leeres Spielprojekt, um es erneut zu importieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto ya contiene archivos. Crea un nuevo proyecto de juego vacío para importarlo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
