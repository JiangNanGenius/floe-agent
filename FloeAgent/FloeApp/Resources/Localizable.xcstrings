    "app.bilingual.64b13a089e8f957d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件仍在更改。请等保存或同步完成后再运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Game files are still changing. Wait for saving or syncing to finish, then run again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲檔案仍在更改。請等儲存或同步完成後再執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームファイルはまだ変更されています。 保存または同期が完了するまで待ってから、再度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 파일이 아직 변경되고 있습니다. 저장 또는 동기화가 완료될 때까지 기다린 후, 다시 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de jeu sont toujours en train de changer. Attendez que l'enregistrement ou la synchronisation soit terminé, puis exécutez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldateien ändern sich immer noch. Warten Sie, bis das Speichern oder Synchronisieren abgeschlossen ist, und führen Sie dann erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos del juego siguen cambiando. Espere a que termine el guardado o la sincronización, luego vuelva a ejecutarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos do jogo ainda estão mudando. Aguarde o salvamento ou a sincronização terminar e, em seguida, execute novamente."
          }
        }
      }
    },
    "app.bilingual.39e251daada03a8c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校验游戏文件时发现内容不一致。请在工程文件中检查最近的修改，再重新运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some game files did not match the saved project. Check recent changes in Project Files and run again."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校驗遊戲檔案時發現內容不一致。請在工程檔案中檢查最近的修改，再重新執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のゲームファイルが保存されたプロジェクトと一致しませんでした。 プロジェクトファイルの最近の変更を確認し、再度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 게임 파일이 저장된 프로젝트와 일치하지 않았습니다. 프로젝트 파일에서 최근 변경 사항을 확인하고 다시 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers de jeu ne correspondaient pas au projet enregistré. Vérifiez les modifications récentes dans les fichiers du projet et exécutez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Spieldateien stimmten nicht mit dem gespeicherten Projekt überein. Überprüfen Sie die letzten Änderungen in den Projektdateien und führen Sie sie erneut aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos archivos del juego no coincidían con el proyecto guardado. Compruebe los cambios recientes en los archivos del proyecto y vuelva a ejecutarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos do jogo não correspondem ao projeto salvo. Verifique as alterações recentes nos Arquivos do Projeto e execute novamente."
          }
        }
      }
    },
    "app.bilingual.3dc6c11af08d6de": {
