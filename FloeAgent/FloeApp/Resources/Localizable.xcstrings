          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden oder stoppen Sie den aktuellen Vorgang, bevor Sie den Plan ausführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalite o detenga la operación actual antes de ejecutar el plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua ou interrompa a operação atual antes de executar o plano."
          }
        }
      }
    },
