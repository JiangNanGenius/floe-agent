    "canvas.native.debuggerRunStale": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该运行的结果已过期。请重新运行流程后再放置新输出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This run’s results are stale. Rerun the flow, then place the new outputs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該執行的結果已過期。請重新執行流程後再放置新輸出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このランの結果は陳腐です。 フローを再実行し、次に新しい出力を配置してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 실행의 결과는 오래되었습니다. 흐름을 다시 실행한 다음, 새로운 출력을 배치하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats de cette course sont rassis. Réexécuter le flux, puis placer les nouvelles sorties."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse dieses Laufs sind abgestabt. Den Ablauf erneut ausführen und dann die neuen Ausgänge platzieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de esta carrera son rantos. Vuelva a ejecutar el flujo, luego coloque las nuevas salidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados desta corrida estão desatuos. Reexecute o fluxo e, em seguida, coloque as novas saídas."
          }
        }
      }
    },
