          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Axe de deux plans"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achse aus zwei Ebenen"
          }
        },
        "es": {
