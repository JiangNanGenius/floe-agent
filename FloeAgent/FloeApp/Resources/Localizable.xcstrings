    "app.bilingual.6dc476e6bc4ca630": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音色保存在此乐谱中，普通播放和加入编曲使用相同音色。内置音色为合成音色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds are saved in this score and used for both playback and arrangement audio. Built-in sounds are synthesized."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音色儲存在此樂譜中，普通播放和加入編曲使用相同音色。內建音色為合成音色。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音はこのスコアに保存され、再生とアレンジ音声の両方に使用されます。 内蔵音は合成されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 이 악보에 저장되며 재생 및 편곡 오디오 모두에 사용됩니다. 내장된 사운드가 합성됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sons sont enregistrés dans cette partition et utilisés à la fois pour la lecture et l'arrangement audio. Les sons intégrés sont synthétisés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds werden in dieser Partitur gespeichert und sowohl für die Wiedergabe als auch für das Arrangement von Audio verwendet. Eingebaute Sounds werden synthetisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sonidos se guardan en esta partitura y se utilizan tanto para la reproducción como para la disposición del audio. Los sonidos incorporados se sintetizan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os sons são salvos nesta pontuação e usados tanto para reprodução quanto para arranjo de áudio. Os sons embutidos são sintetizados."
          }
        }
      }
    },
