    "app.bilingual.f4bf05df6d94ae24": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成通用坐标程序并回读核对。连接和退刀会加入轨迹预览；上机前仍需匹配控制器、刀补与机床行程。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generate and verify a generic coordinate program. Added links and retracts appear in the preview; controller, tool offsets and machine travel still require setup."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "生成通用座標程式並回讀核對。連線和退刀會加入軌跡預覽；上機前仍需匹配控制器、刀補與機床行程。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "汎用座標プログラムを生成し、検証してください。 プレビューに追加されたリンクとリトラクトが表示されます；コントローラ、ツールオフセット、機械の移動はまだ設定が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반적인 좌표 프로그램을 생성하고 검증하십시오. 추가된 링크와 철회가 미리보기에 표시됩니다; 컨트롤러, 툴 오프셋 및 기계 이동은 여전히 설정이 필요합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Générer et vérifier un programme de coordonnées générique. Des liens et des rétractations ajoutés apparaissent dans l'aperçu ; le contrôleur, les décalages d'outils et le déplacement de la machine doivent encore être configurés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Generieren und verifizieren Sie ein generisches Koordinatenprogramm. Hinzugefügte Links und Rückzuge erscheinen in der Vorschau; Controller, Werkzeugversätze und Maschinenweg müssen noch eingerichtet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Generar y verificar un programa de coordenadas genérico. Los enlaces y retracciones añadidos aparecen en la vista previa; el controlador, los desplazamientos de herramientas y el viaje de la máquina aún requieren configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gere e verifique um programa de coordenadas genérico. Links e retrações adicionados aparecem na visualização; controlador, deslocamentos de ferramentas e viagem da máquina ainda exigem configuração."
          }
        }
      }
    },
