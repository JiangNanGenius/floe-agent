    "platform.background_run_coordinator.the_app_exited_and_the_linux": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app exited and the Linux environment stopped; reopen to restart and continue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已退出，Linux 环境已停止；打开后可重新启动并继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用已退出，Linux 環境已停止；開啟後可重新啟動並繼續"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが終了し、Linux 環境が停止しました。再起動して続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 종료되고 Linux 환경이 중지되었습니다; 다시 열어 재시작하고 계속하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application a quitté et l'environnement Linux s'est arrêté ; rouvrir pour redémarrer et continuer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde beendet und die Linux-Umgebung wurde gestoppt; öffnen Sie erneut, um neu zu starten und fortzufahren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación salió y el entorno Linux se detuvo; vuelva a abrir para reiniciar y continuar"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo saiu e o ambiente Linux parou; reabra para reiniciar e continuar"
          }
        }
      }
    },
    "platform.background_run_coordinator.the_conversation_workspace_is_currently_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation workspace is currently unavailable; the result was kept in the asset library (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话工作区当前不可用；结果保留在素材库（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話工作區當前不可用；結果保留在素材庫（%@）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話ワークスペースは現在利用できません。結果はアセットライブラリ（%@）に保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 작업 공간은 현재 사용할 수 없으며, 결과는 자산 라이브러리(%@)에 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'espace de travail de conversation n'est actuellement pas disponible ; le résultat a été conservé dans la bibliothèque d'actifs (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Arbeitsbereich für Unterhaltung ist derzeit nicht verfügbar; das Ergebnis wurde in der Asset-Bibliothek (%@) aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de trabajo de conversación no está disponible actualmente; el resultado se mantuvo en la biblioteca de activos (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O espaço de trabalho de conversação está indisponível no momento; o resultado foi mantido na biblioteca de ativos (%@)."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_download_exceeds_the_byte_limit": {
      "extractionState": "manual",
