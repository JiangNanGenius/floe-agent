    "app.bilingual.3659015e071535a2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未确认游戏停止，请重试关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game has not confirmed stopping. Retry Close."
          }
        },
        "zh-Hant": {
