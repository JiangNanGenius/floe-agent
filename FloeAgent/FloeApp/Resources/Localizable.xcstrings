    "app.personal_recently_deleted_view.and_all_its_contents_will": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其中所有内容都将被永久删除。此操作无法撤销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” and all its contents will be permanently deleted. This cannot be undone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其中所有內容都將被永久刪除。此操作無法撤銷。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」およびそのすべてのコンテンツは永久に削除されます。 これは元に戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”와 그 모든 내용은 영구적으로 삭제됩니다. 이것은 되돌릴 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" et tout son contenu seront définitivement supprimés. Cela ne peut pas être défait."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" und alle seine Inhalte werden dauerhaft gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" y todo su contenido se eliminarán permanentemente. Esto no se puede deshacer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” e todo o seu conteúdo serão excluídos permanentemente. Isso não pode ser desfeito."
          }
        }
      }
    },
