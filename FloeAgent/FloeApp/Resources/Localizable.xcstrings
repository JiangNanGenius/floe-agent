    "app.bilingual.efb7ff65049e4aea": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前引擎是手动选择，没有识别依据。请先在工程设置中确认识别到的引擎。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current engine is a manual choice without recognized evidence. Confirm a recognized engine in project setup first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當前引擎是手動選擇，沒有識別依據。請先在工程設定中確認識別到的引擎。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のエンジンは、認められた証拠がない手作業の選択です。 まず、プロジェクト設定で認識されたエンジンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 엔진은 인정된 증거가 없는 수동 선택입니다. 먼저 프로젝트 설정에서 인식된 엔진을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur actuel est un choix manuel sans preuve reconnue. Confirmez d'abord un moteur reconnu dans la configuration du projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Motor ist eine manuelle Wahl ohne anerkannte Beweise. Bestätigen Sie zuerst eine erkannte Engine in der Projekteinrichtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor actual es una elección manual sin evidencia reconocida. Confirme primero un motor reconocido en la configuración del proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O motor atual é uma escolha manual sem evidências reconhecidas. Confirme primeiro um mecanismo reconhecido na configuração do projeto."
          }
        }
      }
    },
    "app.bilingual.a732b129e4b6fe9b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在工程设置中确认可运行的游戏目录和引擎，再构建。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm a runnable game folder and engine in project setup before building."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在工程設定中確認可執行的遊戲目錄和引擎，再構建。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビルドする前に、プロジェクト設定で実行可能なゲームフォルダーとエンジンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빌드하기 전에 프로젝트 설정에서 실행 가능한 게임 폴더와 엔진을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez un dossier de jeu et un moteur exécutables dans la configuration du projet avant de construire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie vor dem Erstellen einen auslaufbaren Spielordner und eine Engine in der Projekteinrichtung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme una carpeta de juego ejecutable y un motor en la configuración del proyecto antes de construir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme uma pasta de jogo executável e um mecanismo na configuração do projeto antes de construir."
          }
        }
      }
    },
