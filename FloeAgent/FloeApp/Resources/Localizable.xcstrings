    "execution.node_package_manager_policy.the_project_requires_this_environment_supports": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project requires %@. This environment supports npm / pnpm; make an explicit choice. The original project lock file is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目要求 %@。本环境支持 npm / pnpm，请明确选择；原项目锁文件会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案要求 %@。本環境支援 npm / pnpm，請明確選擇；原專案鎖檔案會保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロジェクトには%@が必要です。 この環境は npm / pnpm をサポートしています。明示的な選択をしてください。 元のプロジェクトロックファイルは保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로젝트는 %@가 필요합니다. 이 환경은 npm / pnpm을 지원합니다; 명시적으로 선택하십시오. 원본 프로젝트 잠금 파일이 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet nécessite %@. Cet environnement prend en charge npm / pnpm ; faites un choix explicite. Le fichier de verrouillage du projet original est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Projekt erfordert %@. Diese Umgebung unterstützt npm / pnpm; treffen Sie eine explizite Wahl. Die ursprüngliche Projektsperrdatei wird beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto requiere %@. Este entorno admite npm / pnpm; haga una elección explícita. Se conserva el archivo de bloqueo original del proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto requer %@. Este ambiente suporta npm / pnpm; faça uma escolha explícita. O arquivo de bloqueio original do projeto é mantido."
          }
        }
      }
    },
    "execution.node_package_manager_policy.the_project_s_packagemanager_conflicts_with": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The project's packageManager conflicts with its lock file. Fix the project, or explicitly choose npm / pnpm for this environment; installation does not rewrite the project lock file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目的 packageManager 与锁文件冲突。请整理项目，或明确选择本环境使用的 npm / pnpm；环境安装不会改写项目锁文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案的 packageManager 與鎖檔案衝突。請整理專案，或明確選擇本環境使用的 npm / pnpm；環境安裝不會改寫專案鎖檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトの packageManager がロックファイルと競合しています。 プロジェクトを修正するか、この環境では npm / pnpm を明示的に選択してください；インストールはプロジェクトロックファイルを書き換えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트의 packageManager가 잠금 파일과 충돌합니다. 프로젝트를 수정하거나 이 환경에 대해 npm / pnpm을 명시적으로 선택하십시오; 설치는 프로젝트 잠금 파일을 다시 쓰지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le packageManager du projet entre en conflit avec son fichier de verrouillage. Corrigez le projet, ou choisissez explicitement npm / pnpm pour cet environnement ; l'installation ne réécrit pas le fichier de verrouillage du projet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der packageManager des Projekts kollidiert mit seiner Sperrdatei. Beheben Sie das Projekt oder wählen Sie explizit npm / pnpm für diese Umgebung; die Installation schreibt die Projektsperrdatei nicht neu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El packageManager del proyecto entra en conflicto con su archivo de bloqueo. Arregle el proyecto, o elija explícitamente npm / pnpm para este entorno; la instalación no reescribe el archivo de bloqueo del proyecto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O packageManager do projeto entra em conflito com seu arquivo de bloqueio. Corrija o projeto ou escolha explicitamente npm / pnpm para este ambiente; a instalação não reescreve o arquivo de bloqueio do projeto."
          }
        }
      }
    },
