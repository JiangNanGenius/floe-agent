    "settings.sync.saved_credentials.error.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d saved credentials aren't available on this device. Retry later or save them again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机有 %d 个凭据暂不可用。请稍后重试，或重新保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機有 %d 個憑據暫不可用。請稍後重試，或重新儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d の保存された認証情報はこのデバイスでは利用できません。 後で再試行するか、再度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 저장된 자격 증명은 이 기기에서 사용할 수 없습니다. 나중에 다시 시도하거나 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations d'identification enregistrées %d ne sont pas disponibles sur cet appareil. Réessayez plus tard ou enregistrez-les à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d gespeicherte Anmeldedaten sind auf diesem Gerät nicht verfügbar. Versuchen Sie es später noch einmal oder speichern Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales guardadas de %d no están disponibles en este dispositivo. Vuelve a intentarlo más tarde o guárdalos de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais salvas %d não estão disponíveis neste dispositivo. Tente novamente mais tarde ou salve-os novamente."
          }
        }
      }
    },
