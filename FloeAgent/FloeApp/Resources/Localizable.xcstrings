    "settings.sync.saved_credentials.auth_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't verify your identity. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成身份验证，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成身份驗證，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認ができませんでした。 もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신원을 확인할 수 없습니다. 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier votre identité. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Identität konnte nicht bestätigt werden. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar tu identidad. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar sua identidade. Tente novamente."
          }
        }
      }
    },
    "settings.sync.saved_credentials.error.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't update synchronization for %d saved credentials. Existing copies were kept. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 个已保存凭据未能完成同步设置，原有副本已保留。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %d 個已儲存憑據未能完成同步設定，原有副本已保留。請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d の保存された認証情報の同期を更新できませんでした。 既存のコピーは保管されました。 もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 저장된 자격 증명에 대한 동기화를 업데이트할 수 없습니다. 기존 사본은 보관되었습니다. 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour la synchronisation pour les informations d'identification enregistrées %d. Les copies existantes ont été conservées. Réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung für die gespeicherten Anmeldeinformationen von %d konnte nicht aktualisiert werden. Vorhandene Kopien wurden aufbewahrt. Versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar la sincronización de %d credenciales guardadas. Se conservaron las copias existentes. Inténtalo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar a sincronização para as credenciais salvas %d. As cópias existentes foram mantidas. Tente novamente."
          }
        }
      }
    },
