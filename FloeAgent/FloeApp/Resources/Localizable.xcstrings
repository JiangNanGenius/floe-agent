    "workspace.workspace_canvas_view.the_selected_image_model_supports_up": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected image model supports up to %@ reference images; the current context contains %@. Remove extra inputs or change the model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片模型最多支持 %@ 张参考图；当前上下文包含 %@ 张。请移除多余输入，或更换模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選圖片模型最多支援 %@ 張參考圖；當前上下文包含 %@ 張。請移除多餘輸入，或更換模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された画像モデルは最大%@参照画像をサポートしています；現在のコンテキストには%@が含まれています。 余分な入力を削除するか、モデルを変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택된 이미지 모델은 최대 %@ 참조 이미지를 지원합니다; 현재 컨텍스트에는 %@가 포함되어 있습니다. 추가 입력을 제거하거나 모델을 변경하십시오."
          }
        },
        "fr": {
