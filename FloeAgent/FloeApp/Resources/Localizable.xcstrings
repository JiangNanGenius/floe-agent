    "settings.diagnostics.logs.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Redacted on write and retained in a bounded local crash-recovery buffer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入时自动脱敏，并保存在有容量上限的本地崩溃恢复缓冲区中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "寫入時自動脫敏，並儲存在有容量上限的本地崩潰恢復緩衝區中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み時に破棄され、限定されたローカルクラッシュリカバリバッファに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기 시에 편집되어 제한된 로컬 충돌 복구 버퍼에 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigé à l'écriture et conservé dans un tampon de récupération de crash local délimité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Schreiben redigiert und in einem begrenzten lokalen Absturzwiederherungspuffer aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redactado en la escritura y retenido en un búfer de recuperación de fallos local limitado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redigido na gravação e retido em um buffer de recuperação de falhas local limitado."
          }
        }
      }
    },
