    "cad.textureImport.error.budget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These textures exceed the 64 MB image memory budget. Choose smaller conversion sizes or remove unused maps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些贴图超过 64 MB 图像内存预算。请选择更小的转换尺寸，或移除不用的贴图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些貼圖超過 64 MB 影象記憶體預算。請選擇更小的轉換尺寸，或移除不用的貼圖。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのテクスチャは64 MBの画像メモリ予算を超えています。 変換サイズを小さくするか、未使用のマップを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이러한 텍스처는 64 MB 이미지 메모리 예산을 초과합니다. 더 작은 변환 크기를 선택하거나 사용되지 않은 지도를 제거하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces textures dépassent le budget de mémoire d'image de 64 Mo. Choisissez des tailles de conversion plus petites ou supprimez les cartes inutilisées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Texturen überschreiten das Bildspeicherbudget von 64 MB. Wählen Sie kleinere Konvertierungsgrößen oder entfernen Sie unbenutzte Karten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas texturas superan el presupuesto de memoria de imagen de 64 MB. Elija tamaños de conversión más pequeños o elimine los mapas no utilizados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essas texturas excedem o orçamento de memória de imagem de 64 MB. Escolha tamanhos de conversão menores ou remova mapas não utilizados."
          }
        }
      }
    },
    "cad.textureImport.error.encoded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The converted PNG is larger than 8 MB. Choose a smaller size; no texture has been replaced."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换后的 PNG 超过 8 MB。请选择更小尺寸；现有贴图未替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉換後的 PNG 超過 8 MB。請選擇更小尺寸；現有貼圖未替換。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換されたPNGは8 MBを超えています。 小さいサイズを選択してください；テクスチャは置き換えられていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환된 PNG는 8 MB보다 큽니다. 더 작은 크기를 선택하십시오; 텍스처가 교체되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PNG converti est supérieur à 8 Mo. Choisissez une taille plus petite ; aucune texture n'a été remplacée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der konvertierte PNG ist größer als 8 MB. Wählen Sie eine kleinere Größe; es wurde keine Textur ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PNG convertido tiene más de 8 MB. Elija un tamaño más pequeño; no se ha reemplazado ninguna textura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PNG convertido é maior que 8 MB. Escolha um tamanho menor; nenhuma textura foi substituída."
          }
        }
      }
    },
    "cad.textureImport.error.convert": {
      "localizations": {
        "en": {
