      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件超过预览大小限制，仍可存储或分享。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file exceeds the preview limit. You can still save or share it."
