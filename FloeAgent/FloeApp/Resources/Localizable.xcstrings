    "canvas.generation.save_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving only configures the task. Start it explicitly from the task card."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存只会配置任务；请回到任务卡片明确点击开始生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存只會配置任務；請回到任務卡片明確點選開始生成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存はタスクのみを構成します。 タスクカードから明示的に開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장은 작업만 구성합니다. 작업 카드에서 명시적으로 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde ne fait que configurer la tâche. Commencez-le explicitement à partir de la carte de tâche."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Speichern konfiguriert die Aufgabe. Starten Sie es explizit von der Aufgabenkarte aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar solo configura la tarea. Comience explícitamente desde la tarjeta de tareas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar apenas configura a tarefa. Inicie-o explicitamente a partir do cartão de tarefas."
          }
        }
      }
    },
