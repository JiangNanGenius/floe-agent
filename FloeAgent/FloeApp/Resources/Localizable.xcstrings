    "app.linux_cache_cleanup_text.the_previous_linux_cleanup_job": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次 Linux 清理任务的结果未知或未完成。请先查看该任务的实际结果，确认后再决定是否重试；本次没有自动重放。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous Linux cleanup job has an unknown or incomplete outcome. Inspect its actual result before deciding whether to retry; this call did not replay it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次 Linux 清理任務的結果未知或未完成。請先檢視該任務的實際結果，確認後再決定是否重試；本次沒有自動重放。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の Linux クリーンアップジョブは、結果が不明または不完全です。 再試行するかどうか判断する前に、実際の結果を検査してください。この呼び出しでは再生されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 Linux 정리 작업은 결과를 알 수 없거나 불완전합니다. 재시도 여부를 결정하기 전에 실제 결과를 확인하십시오; 이 호출은 재생되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le précédent travail de nettoyage Linux a un résultat inconnu ou incomplet. Inspectez son résultat réel avant de décider de réessayer ou non ; cet appel ne l'a pas rejoué."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorherige Linux-Bereinigungsauftrag hat ein unbekanntes oder unvollständiges Ergebnis. Überprüfen Sie das tatsächliche Ergebnis, bevor Sie entscheiden, ob Sie es erneut versuchen; dieser Anruf hat es nicht wiederholt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo de limpieza anterior de Linux tiene un resultado desconocido o incompleto. Inspeccione su resultado real antes de decidir si volver a intentarlo; esta llamada no lo volvió a reproducir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho de limpeza anterior Linux tem um resultado desconhecido ou incompleto. Inspecione seu resultado real antes de decidir se deve tentar novamente; esta chamada não o repetiu."
          }
        }
      }
    },
    "app.linux_cache_cleanup_text.another_cleanup_task_is_already": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个清理任务已经在同一个 Linux 环境中运行；本次没有重复启动。请等待该任务结束，或在原任务中停止它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another cleanup task is already running in the same Linux environment; no duplicate was started. Wait for it to finish, or stop it in its owning task."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個清理任務已經在同一個 Linux 環境中執行；本次沒有重複啟動。請等待該任務結束，或在原任務中停止它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ Linux 環境で別のクリーンアップタスクがすでに実行されています。重複は開始されていません。 それが完了するまでお待ちください、またはそれが所有するタスクで停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 정리 작업이 이미 동일한 Linux 환경에서 실행 중이며, 중복 작업이 시작되지 않았습니다. 그것이 완료될 때까지 기다리거나, 자신의 작업을 중단하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre tâche de nettoyage est déjà en cours d'exécution dans le même environnement Linux ; aucun doublon n'a été lancé. Attendez qu'il se termine, ou arrêtez-le dans sa tâche de possession."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine weitere Bereinigungsaufgabe wird bereits in derselben Linux-Umgebung ausgeführt; es wurde kein Duplikat gestartet. Warten Sie, bis es fertig ist, oder stoppen Sie es in seiner eigenen Aufgabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra tarea de limpieza ya se está ejecutando en el mismo entorno Linux; no se inició ningún duplicado. Espera a que termine, o deténgalo en su tarea propia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outra tarefa de limpeza já está em execução no mesmo ambiente Linux; nenhuma duplicata foi iniciada. Espere que ele termine, ou pare-o em sua tarefa própria."
          }
        }
      }
    },
    "app.linux_cache_cleanup_text.open_settings_execution_environments_inspect": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开 设置 → 执行环境，检查或修复共享 Linux 环境后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings > Execution Environments, inspect or repair the shared Linux environment, then retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟 設定 → 執行環境，檢查或修復共享 Linux 環境後重試。"
