    "hosts.vnc.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a direct VNC connection or protect it with a verified SSH tunnel."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接连接 VNC，也可通过已验证的 SSH 隧道保护连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可直接連線 VNC，也可透過已驗證的 SSH 隧道保護連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接のVNC接続を使用するか、検証済みのSSHトンネルで保護してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 VNC 연결을 사용하거나 검증된 SSH 터널로 보호하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une connexion directe VNC ou protégez-la avec un tunnel SSH vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine direkte VNC-Verbindung oder schützen Sie sie mit einem verifizierten SSH-Tunnel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una conexión directa VNC o protéjala con un túnel SSH verificado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma conexão direta VNC ou proteja-a com um túnel SSH verificado."
          }
        }
      }
    },
