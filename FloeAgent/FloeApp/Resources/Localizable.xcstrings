    "remote.conversation_center.the_context_is_being_compacted_send": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The context is being compacted; send again when it finishes. Your input was not discarded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文正在压缩，请完成后再发送；输入内容未丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文正在壓縮，請完成後再傳送；輸入內容未丟棄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストが圧縮されています。完了したら再送してください。 入力は破棄されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트가 압축되고 있습니다; 완료되면 다시 보내 주세요. 귀하의 입력은 폐기되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contexte est en cours de compactage ; envoyez-le à nouveau lorsqu'il est terminé. Votre entrée n'a pas été supprimée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontext wird verdichtet; senden Sie ihn erneut, wenn er fertig ist. Ihre Eingabe wurde nicht verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contexto se está compactando; envíelo de nuevo cuando termine. Su entrada no fue descartada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O contexto está sendo compactado; envie novamente quando terminar. Sua entrada não foi descartada."
          }
        }
      }
    },
