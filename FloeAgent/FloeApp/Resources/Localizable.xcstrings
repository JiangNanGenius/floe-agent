    "app.bilingual.5584148b23b4a22d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "方料使用刀具库中的特征 CAM；车削与原单趟铣槽会关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Box stock uses feature CAM from the tool library; turning and the original single-pass slot will be disabled."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "方料使用刀具庫中的特徵 CAM；車削與原單趟銑槽會關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックスストックはツールライブラリから機能CAMを使用します；回転および元のシングルパススロットは無効化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Box stock은 도구 라이브러리의 기능 CAM을 사용합니다; 회전하면 원래의 단일 패스 슬롯이 비활성화됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stock de la boîte utilise la fonctionnalité CAM de la bibliothèque d'outils ; la rotation et l'emplacement d'origine à passage unique seront désactivés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Box Stock verwendet Feature CAM aus der Werkzeugbibliothek; Drehen und der ursprüngliche Single-Pass-Steckplatz wird deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Box stock utiliza la función CAM de la biblioteca de herramientas; girar y la ranura original de un solo paso se desactivará."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O estoque de caixa usa o recurso CAM da biblioteca de ferramentas; girando e o slot original de passagem única será desativado."
          }
        }
      }
    },
