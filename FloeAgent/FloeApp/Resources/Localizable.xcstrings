    "app.bilingual.501124442bb6fa77": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未导入兼容的本地模型。模型需符合本 App 的波形分离合同（manifest/contract/model.mlmodelc）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible local model yet. A model must match this App's waveform separation bundle contract (manifest/contract/model.mlmodelc)."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未匯入相容的本地模型。模型需符合本 App 的波形分離合同（manifest/contract/model.mlmodelc）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ互換性のあるローカルモデルはありません。 モデルはこのアプリの波形分離バンドル契約（manifest/contract/model.mlmodelc）と一致しなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 호환 가능한 로컬 모델이 없습니다. 모델은 이 앱의 파형 분리 번들 계약(manifest/contract/model.mlmodelc)과 일치해야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de modèle local compatible. Un modèle doit correspondre au contrat de faisceau de séparation de forme d'onde de cette application (manifest/contract/model.mlmodelc)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein kompatibles lokales Modell. Ein Modell muss mit dem Waveform-Separations-Bundle-Vertrag dieser App übereinstimmen (manifest/contract/model.mlmodelc)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay un modelo local compatible. Un modelo debe coincidir con el contrato del paquete de separación de forma de onda de esta aplicación (manifest/contract/model.mlmodelc)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há modelo local compatível. Um modelo deve corresponder ao contrato de pacote de separação de forma de onda deste aplicativo (manifest/contract/model.mlmodelc)."
          }
