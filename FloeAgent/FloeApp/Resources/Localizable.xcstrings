          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Gerät ist keine verwendbare Authentifizierung konfiguriert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
