    "canvas.scene_migration.unsupported.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was changed. The original scene stays on the node and remains editable only as a read-only preview until the listed values are fixed:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有做任何修改。原始场景仍保留在节点中，仅在下方列出的值修复前保持只读预览："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有做任何修改。原始場景仍保留在節點中，僅在下方列出的值修復前保持只讀預覽："
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も変更されませんでした。 元のシーンはノード上に残り、リストされた値が固定されるまで、読み取り専用プレビューとしてのみ編集可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 변경되지 않았습니다. 원본 장면은 노드에 남아 있으며, 나열된 값이 수정될 때까지 읽기 전용 미리보기로만 편집될 수 있습니다:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été changé. La scène originale reste sur le nœud et reste modifiable uniquement en tant qu'aperçu en lecture seule jusqu'à ce que les valeurs répertoriées soient corrigées :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts geändert. Die Originalszene bleibt auf dem Knoten und bleibt nur als schreibgeschützte Vorschau bearbeitbar, bis die aufgeführten Werte festgelegt sind:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cambió nada. La escena original permanece en el nodo y permanece editable solo como una vista previa de solo lectura hasta que se fijen los valores enumerados:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi alterado. A cena original permanece no nó e permanece editável apenas como uma visualização somente leitura até que os valores listados sejam corrigidos:"
          }
        }
      }
    },
