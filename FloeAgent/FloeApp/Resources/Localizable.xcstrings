          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates können derzeit nicht überprüft werden; installierte Plugins bleiben verwendbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
