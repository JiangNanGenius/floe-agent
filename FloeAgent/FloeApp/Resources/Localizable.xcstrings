    "hosts.host_list_view.installs_the_daemon_matching_the_current": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installs the daemon matching the current Floe version over verified SSH; a failed update rolls back automatically."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将通过已验证的 SSH 安装与当前 Floe 版本配套的守护程序；更新失败会自动回滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將透過已驗證的 SSH 安裝與當前 Floe 版本配套的守護程式；更新失敗會自動回滾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みの SSH 上で、現在の Floe バージョンに一致するデーモンをインストールします；失敗したアップデートは自動的にロールバックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 SSH 위에 현재 Floe 버전과 일치하는 데몬을 설치합니다; 실패한 업데이트는 자동으로 롤백됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installe le démon correspondant à la version actuelle de Floe sur SSH vérifié ; une mise à jour défaillante revient automatiquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert den Daemon, der der aktuellen Floe-Version entspricht, über verifizierte SSH; ein fehlgeschlagenes Update wird automatisch zurückgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala el demonio que coincide con la versión actual de Floe sobre SSH verificado; una actualización fallida se retite automáticamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala o daemon que corresponde à versão atual do Floe sobre o SSH verificado; uma atualização com falha é revertida automaticamente."
          }
        }
      }
    },
