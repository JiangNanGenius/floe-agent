    "app.bilingual.4772e40d52da877a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择画布顶层可见、未锁定的图片、文字或图形图层。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a visible, unlocked image, text, or shape layer at the top level of the canvas."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇畫布頂層可見、未鎖定的圖片、文字或圖形圖層。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスの最上位レベルにある、表示可能でアンロックされた画像、テキスト、またはシェイプレイヤーを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 상단 레벨에서 보이는 잠금 해제된 이미지, 텍스트 또는 도형 레이어를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une image, un texte ou un calque de forme visible et déverrouillé au niveau supérieur de la toile."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine sichtbare, entsperrte Bild-, Text- oder Formebene auf der obersten Ebene der Leinwand aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione una capa de imagen, texto o forma visible y desbloqueada en el nivel superior del lienzo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma imagem visível e desbloqueada, texto ou camada de forma no nível superior da tela."
          }
        }
      }
    },
    "app.bilingual.18565530f6cf1268": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先读取变形范围，再应用四个控制点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the transform bounds before applying four control points."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先讀取變形範圍，再應用四個控制點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4つの制御点を適用する前に、変換境界をお読みください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변환 범위를 읽은 후 네 개의 제어점을 적용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez les limites de transformation avant d'appliquer quatre points de contrôle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen Sie die Transformationsgrenzen, bevor Sie vier Kontrollpunkte anwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lea los límites de transformación antes de aplicar cuatro puntos de control."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia os limites de transformação antes de aplicar quatro pontos de controle."
          }
        }
      }
    },
    "app.bilingual.de42ea0185852594": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制点不能交叉或重合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the control points apart without crossing edges."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制點不能交叉或重合。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制御点は、境界が交差しないように分離してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 지점을 겹치지 않도록 간격을 유지하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les points de contrôle séparés sans croiser les bords."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Kontrollpunkte auseinander, ohne die Kanten zu kreuzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga los puntos de control separados sin cruzar los bordes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha os pontos de controle separados sem cruzar as bordas."
          }
        }
      }
    },
    "app.bilingual.cd4acc6cfdd4894a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法预览此变形，请调整控制点后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not preview this transform. Adjust the control points and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法預覽此變形，請調整控制點後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変換をプレビューできませんでした。 コントロールポイントを調整し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변환을 미리 볼 수 없습니다. 제어점을 조정하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de prévisualiser cette transformation. Ajustez les points de contrôle et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Transformation konnte nicht in der Vorschau angezeigt werden. Passen Sie die Kontrollpunkte an und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo previsualizar esta transformación. Ajusta los puntos de control y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível visualizar esta transformação. Ajuste os pontos de controle e tente novamente."
          }
        }
      }
    },
    "app.bilingual.d2b495fa08bc6f6a": {
      "extractionState": "manual",
