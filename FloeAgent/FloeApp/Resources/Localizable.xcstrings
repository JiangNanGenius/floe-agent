    "app.bilingual.b6237b60c8d19c7": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数无效，请检查后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the parameters and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "引數無效，請檢查後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメータを確認し、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매개변수를 확인하고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les paramètres et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die Parameter und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba los parámetros y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique os parâmetros e tente novamente."
          }
        }
      }
    },
    "app.bilingual.e6b2b107bca55ca9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查字幕样式。纵向位置应在 0–1，字号应在 0–512；也可使用完整字幕样式设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the caption style. Vertical position must be 0–1 and font size 0–512; use the complete caption style settings for other changes."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請檢查字幕樣式。縱向位置應在 0–1，字號應在 0–512；也可使用完整字幕樣式設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプションのスタイルを確認してください。 垂直位置は0–1で、フォントサイズは0–512である必要があります。その他の変更については、完全なキャプションスタイル設定を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡션 스타일을 확인하십시오. 수직 위치는 0–1이어야 하며 글꼴 크기는 0–512이어야 합니다; 기타 변경을 위해 전체 캡션 스타일 설정을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le style de légende. La position verticale doit être de 0 à 1 et la taille de police de 0 à 512 ; utilisez les paramètres complets de style de légende pour d'autres modifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie den Untertitelstil. Die vertikale Position muss 0–1 und die Schriftgröße 0–512 sein; verwenden Sie die vollständigen Untertitelstileinstellungen für andere Änderungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba el estilo de pie de foto. La posición vertical debe ser 0–1 y el tamaño de fuente 0–512; use la configuración completa del estilo de subtítulos para otros cambios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o estilo da legenda. A posição vertical deve ser 0–1 e o tamanho da fonte 0–512; use as configurações completas do estilo de legenda para outras alterações."
          }
        }
      }
    },
    "app.bilingual.cc94810c6e3e6211": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导出，请等待完成或先取消。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An export is running. Wait for it or cancel it first."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在匯出，請等待完成或先取消。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートが実行中です。 それを待つか、先にキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기가 실행 중입니다. 기다리시거나 먼저 취소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exportation est en cours. Attendez-le ou annulez-le d'abord."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Export wird ausgeführt. Warten Sie darauf oder stornieren Sie es zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está ejecutando una exportación. Espéralo o cancélalo primero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma exportação está em execução. Espere ou cancele primeiro."
          }
        }
      }
    },
    "app.bilingual.6284e56ddb7bbcc9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未生成导出文件，请打开详细信息后重试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No export file was produced. Open the details and retry."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未生成匯出檔案，請開啟詳細資訊後重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートファイルは作成されませんでした。 詳細を開いて、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기 파일이 생성되지 않았습니다. 세부 정보를 열고 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier d'exportation n'a été produit. Ouvrez les détails et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Exportdatei erstellt. Öffnen Sie die Details und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se produjo un archivo de exportación. Abre los detalles y vuelve a intentarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo de exportação foi produzido. Abra os detalhes e tente novamente."
          }
        }
      }
    },
    "app.bilingual.2eaf999b9d6f6ac6": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先提取此视频的音频，再选择音频片段进行人声分离。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract this video's audio first, then select the audio clip for voice separation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先提取此影片的音訊，再選擇音訊片段進行人聲分離。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずこのビデオの音声を抽出し、次に音声分離用の音声クリップを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이 비디오의 오디오를 추출한 다음, 음성 분리를 위해 오디오 클립을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrayez d'abord l'audio de cette vidéo, puis sélectionnez le clip audio pour la séparation de la voix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahieren Sie zuerst den Ton dieses Videos, und wählen Sie dann den Audioclip für die Sprachtrennung aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraiga primero el audio de este vídeo, luego seleccione el clip de audio para la separación de voz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraia o áudio deste vídeo primeiro e, em seguida, selecione o clipe de áudio para separação de voz."
          }
        }
      }
    },
