    "app.bilingual.91c5f6ebf6ae5582": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工位必须与实际刀具一致。多刀加工需拆成带换位步骤的工序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The station must match the actual tool. Split multiple tools into jobs with explicit indexing steps."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工位必須與實際刀具一致。多刀加工需拆成帶換位步驟的工序。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステーションは実際のツールと一致しなければなりません。 複数のツールを、明示的なインデックス手順でジョブに分割します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스테이션은 실제 도구와 일치해야 합니다. 여러 도구를 명시적인 인덱싱 단계와 함께 작업으로 분할하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La station doit correspondre à l'outil réel. Divisez plusieurs outils en tâches avec des étapes d'indexation explicites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Station muss mit dem eigentlichen Werkzeug übereinstimmen. Teilen Sie mehrere Tools mit expliziten Indizierungsschritten in Jobs auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estación debe coincidir con la herramienta real. Divida varias herramientas en trabajos con pasos de indexación explícitos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A estação deve corresponder à ferramenta real. Divida várias ferramentas em trabalhos com etapas de indexação explícitas."
          }
        }
      }
    },
