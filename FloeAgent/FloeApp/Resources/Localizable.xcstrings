        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exported image failed re-read verification; please try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出的图片未通过重新读取校验，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出的圖片未透過重新讀取校驗，請重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
