    "app.bilingual.3ed8361746364bbb": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加后可在配置页填写内容；秘密凭据可选择已存凭据或填写新凭据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After adding, enter the value on the configuration page. For a secret, choose a saved credential or enter a new one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增後可在配置頁填寫內容；秘密憑據可選擇已存憑據或填寫新憑據。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加後、設定ページに値を入力してください。 シークレットの場合は、保存された認証情報を選択するか、新しいものを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 후, 구성 페이지에 값을 입력하십시오. 비밀을 위해 저장된 자격 증명을 선택하거나 새 자격 증명을 입력하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après l'ajout, entrez la valeur sur la page de configuration. Pour un secret, choisissez un identifiant enregistré ou entrez-en un nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie nach dem Hinzufügen den Wert auf der Konfigurationsseite ein. Wählen Sie für ein Geheimnis einen gespeicherten Anmeldedaten oder geben Sie einen neuen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de añadir, introduzca el valor en la página de configuración. Para un secreto, elija una credencial guardada o introduzca una nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois de adicionar, insira o valor na página de configuração. Para um segredo, escolha uma credencial salva ou insira uma nova."
          }
        }
      }
    },
