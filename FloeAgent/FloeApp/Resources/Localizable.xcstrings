    "app.bilingual.5322f0e56c572d2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次分析最长两分钟；原视频始终保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze up to two minutes at a time. Your original video is preserved."
          }
        },
        "zh-Hant": {
