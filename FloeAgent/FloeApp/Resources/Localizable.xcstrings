    "app.bilingual.93da142a297c08ee": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按画布选择相近颜色的区域。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the canvas to select a similar color region."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按畫布選擇相近顏色的區域。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスをタップして、類似した色の領域を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스를 탭하여 유사한 색상 영역을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la toile pour sélectionner une région de couleur similaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf die Leinwand, um einen ähnlichen Farbbereich auszuwählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el lienzo para seleccionar una región de color similar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque na tela para selecionar uma região de cor semelhante."
          }
        }
      }
    },
