    },
    "app.bilingual.2b8d6acff290547b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录需要复核，不能安装。原始内容仍保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record requires review and cannot be installed. Its original content is retained."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此記錄需要複核，不能安裝。原始內容仍保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレコードはレビューが必要で、インストールできません。 元の内容は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레코드는 검토가 필요하며 설치할 수 없습니다. 원본 내용이 보존됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement nécessite un examen et ne peut pas être installé. Son contenu original est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz muss überprüft werden und kann nicht installiert werden. Der ursprüngliche Inhalt bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro requiere revisión y no se puede instalar. Su contenido original se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro requer revisão e não pode ser instalado. Seu conteúdo original é mantido."
          }
        }
      }
    },
    "app.bilingual.99813d70c4c4a3c4": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此记录尚无本机安装适配，原始记录仍可下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This record has no native install adapter yet. Its original remains downloadable."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此記錄尚無本機安裝適配，原始記錄仍可下載。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このレコードにはまだネイティブインストールアダプタがありません。 オリジナルはダウンロード可能なままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 레코드에는 아직 기본 설치 어댑터가 없습니다. 원본은 여전히 다운로드 가능합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet enregistrement n'a pas encore d'adaptateur d'installation natif. Son original reste téléchargeable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Datensatz hat noch keinen nativen Installationsadapter. Das Original kann weiterhin heruntergeladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro aún no tiene un adaptador de instalación nativo. Su original sigue siendo descargable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registro ainda não tem um adaptador de instalação nativo. Seu original permanece para download."
          }
        }
      }
    },
    "app.bilingual.22518c209f41674a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机元件库已达到容量上限，请先停用不用的库。已有库未改变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native library reached its capacity limit. Disable an unused library first; existing libraries are unchanged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機元件庫已達到容量上限，請先停用不用的庫。已有庫未改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブライブラリは容量上限に達しました。 まず未使用のライブラリを無効にしてください；既存のライブラリは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브 도서관이 용량 제한에 도달했습니다. 먼저 사용되지 않은 라이브러리를 비활성화하십시오; 기존 라이브러리는 변경되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque native a atteint sa limite de capacité. Désactivez d'abord une bibliothèque inutilisée ; les bibliothèques existantes sont inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Bibliothek hat ihr Kapazitätslimit erreicht. Deaktivieren Sie zuerst eine ungenutzte Bibliothek; vorhandene Bibliotheken sind unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca nativa alcanzó su límite de capacidad. Deshabicte primero una biblioteca no utilizada; las bibliotecas existentes no han cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A biblioteca nativa atingiu seu limite de capacidade. Desative uma biblioteca não utilizada primeiro; as bibliotecas existentes permanecem inalteradas."
          }
        }
      }
    },
    "app.bilingual.750178bf8c34b625": {
