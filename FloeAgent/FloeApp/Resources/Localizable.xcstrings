          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração está temporariamente indisponível. Suas configurações salvas são mantidas."
          }
        }
      }
    },
    "app.bilingual.79d78fa63d2c5503": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
