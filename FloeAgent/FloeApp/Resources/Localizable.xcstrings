    "app.bilingual.3e9ba1507516ff3a": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边长不是内切圆直径。二维刀形用于型线计算；名义刀尖半径固定 0.4 mm，尚无刀尖半径补偿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge length differs from inscribed-circle diameter. The 2D insert shapes profile planning; the nominal nose remains 0.4 mm without nose-radius compensation."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊長不是內切圓直徑。二維刀形用於型線計算；名義刀尖半徑固定 0.4 mm，尚無刀尖半徑補償。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジの長さは内接円の直径と異なります。 2Dインサート形状のプロファイル計画；名目上のノーズはノーズ半径補正なしで0.4 mmのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장자리 길이는 내접 원의 직경과 다릅니다. 2D 삽입 형상 프로파일 계획; 명목상의 코는 코-라디우스 보정 없이 0.4 mm를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La longueur du bord diffère du diamètre du cercle inscrit. L'insert 2D forme la planification du profil ; le nez nominal reste 0,4 mm sans compensation de rayon de nez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kantenlänge unterscheidet sich vom Durchmesser des eingeschriebenen Kreises. Der 2D-Einsatz bildet die Profilplanung; die nominale Nase verbleibt 0,4 mm ohne Nasenradius-Kompensation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La longitud del borde difiere del diámetro del círculo inscrito. El inserto 2D da forma a la planificación del perfil; la nariz nominal permanece a 0,4 mm sin compensación por radio de la nariz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comprimento da borda difere do diâmetro do círculo inscrito. A inserção 2D molda o planejamento do perfil; o nariz nominal permanece 0,4 mm sem compensação do raio do nariz."
          }
        }
      }
    },
