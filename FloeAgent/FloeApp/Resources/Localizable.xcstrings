    "notes.notes_root_view.try_other_keywords_scans_and_handwriting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try other keywords. Scans and handwriting must be recognized before they become text-searchable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试其他关键词。扫描件和手写内容需要识别后才能按文字搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試試其他關鍵詞。掃描件和手寫內容需要識別後才能按文字搜尋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のキーワードをお試しください。 スキャンと手書き文字は、テキスト検索可能になる前に認識されなければなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 키워드를 시도해 보세요. 스캔본과 손글씨는 텍스트 검색이 가능해지기 전에 인식되어야 합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez d'autres mots-clés. Les scans et l'écriture manuscrite doivent être reconnus avant qu'ils ne deviennent consultables par texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Probieren Sie andere Schlüsselwörter aus. Scans und Handschrift müssen erkannt werden, bevor sie textdurchsuchbar werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otras palabras clave. Los escaneos y la escritura a mano deben ser reconocidos antes de que se puedan buscar en texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outras palavras-chave. Digitalizações e caligrafia devem ser reconhecidas antes que se tornem pesquisáveis por texto."
          }
        }
      }
    },
