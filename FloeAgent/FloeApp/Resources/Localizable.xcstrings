    "workspace.empty.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder from Files or iCloud Drive to let the agent read and edit it safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“文件”或 iCloud Drive 添加一个文件夹，让 Agent 安全地读写它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從“檔案”或 iCloud Drive 新增一個資料夾，讓 Agent 安全地讀寫它。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Files または iCloud Drive からフォルダーを追加し、エージェントが安全に読み取りおよび編集できるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Files 또는 iCloud Drive에서 폴더를 추가하여 에이전트가 안전하게 읽고 편집할 수 있도록 하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier à partir de Fichiers ou d'iCloud Drive pour laisser l'agent le lire et le modifier en toute sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie einen Ordner aus Dateien oder iCloud Drive hinzu, damit der Agent ihn sicher lesen und bearbeiten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue una carpeta desde Archivos o iCloud Drive para que el agente la lea y edite de forma segura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pasta do Arquivos ou do iCloud Drive para que o agente a leia e edite com segurança."
          }
        }
      }
    },
