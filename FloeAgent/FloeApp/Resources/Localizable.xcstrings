    "app.bilingual.8c0d5aafd74f839c": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原声音调随速度改变。独立音轨可单独调整速度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-audio pitch follows speed. Independent audio clips can be retimed separately."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原聲音調隨速度改變。獨立音軌可單獨調整速度。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースオーディオのピッチは速度に従います。 独立した音声クリップは個別にリタイミングできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 오디오 피치는 속도에 따라갑니다. 독립적인 오디오 클립은 별도로 재타이머를 할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La hauteur audio source suit la vitesse. Les clips audio indépendants peuvent être rééclipsés séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tonhöhe mit Quellaudio folgt der Geschwindigkeit. Unabhängige Audioclips können separat remediert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tono de audio de origen sigue la velocidad. Los clips de audio independientes se pueden reproducir por separado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tom de áudio de origem segue a velocidade. Clipes de áudio independentes podem ser reproduzidos separadamente."
          }
        }
      }
    },
