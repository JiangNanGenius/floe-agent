    "app.bilingual.5d80ac216562236": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将存入此技能配置的钥匙串，也可以通过对话提供。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved in Keychain for this skill configuration. You can also provide it in chat."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將存入此技能配置的鑰匙串，也可以透過對話提供。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキル設定のキーチェーンに保存されました。 チャットでもご提供いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스킬 구성을 위해 키체인에 저장되었습니다. 채팅에서도 제공하실 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré dans Keychain pour cette configuration de compétences. Vous pouvez également le fournir dans le chat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Skill-Konfiguration im Schlüsselbund gespeichert. Sie können es auch im Chat bereitstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado en el llavero para esta configuración de habilidad. También puedes proporcionarlo en el chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo no Keychain para esta configuração de habilidade. Você também pode fornecê-lo no chat."
          }
        }
      }
    },
