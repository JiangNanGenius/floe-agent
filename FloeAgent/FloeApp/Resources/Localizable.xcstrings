        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종속성이 준비되지 않았습니다. 대상에 대한 도구, 연결 및 설치 권한을 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépendances ne sont pas prêtes. Vérifiez les outils, la connectivité et les autorisations d'installation sur la cible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abhängigkeiten sind nicht bereit. Überprüfen Sie die Tools, die Konnektivitäts- und Installationsberechtigungen für das Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las dependencias no están listas. Compruebe las herramientas, la conectividad y los permisos de instalación en el objetivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As dependências não estão prontas. Verifique ferramentas, conectividade e permissões de instalação no alvo."
          }
        }
      }
    },
    "app.bilingual.3056f3eb52c59501": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标上的准备结果尚未确认，原运行位置未变。请取消迁移后检查目标状态。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination preparation has an unknown result. The original location is unchanged. Cancel the move and check the destination."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標上的準備結果尚未確認，原執行位置未變。請取消遷移後檢查目標狀態。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目的地の準備には未知の結果があります。 元の場所は変更されていません。 移動をキャンセルし、目的地を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목적지 준비 결과가 알 수 없습니다. 원래 위치는 변경되지 않았습니다. 이동을 취소하고 목적지를 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La préparation de la destination a un résultat inconnu. L'emplacement d'origine est inchangé. Annulez le déménagement et vérifiez la destination."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielvorbereitung hat ein unbekanntes Ergebnis. Der ursprüngliche Standort ist unverändert. Stornieren Sie den Umzug und überprüfen Sie das Ziel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preparación del destino tiene un resultado desconocido. La ubicación original no ha cambiado. Cancela el movimiento y comprueba el destino."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A preparação do destino tem um resultado desconhecido. A localização original não mudou. Cancele a mudança e verifique o destino."
          }
        }
      }
    },
