    "app.bilingual.baa7a94d48efac3d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形顶点 UV；留空使用圆"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rectangle UV vertices; empty uses circle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形頂點 UV；留空使用圓"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矩形のUV頂点；空は円を使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직사각형 UV 정점; 빈칸은 원을 사용합니다"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommets UV rectangulaires ; cercle d'utilisation vide"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechteck-UV-Scheitelpunkte; leerer verwendet Kreis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vértices UV rectangulares; círculo de usos vacíos"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vértices UV retangulares; círculo de uso vazio"
          }
        }
      }
    },
    "app.bilingual.e35fc069318ccbb9": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非空矩形顶点会替代圆形特征；圆参数会保留。仅支持圆形及轴对齐矩形，其他多边形会明确拒绝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonempty rectangle vertices override the circular feature; circle settings are retained. Supports circles and axis-aligned rectangles; other polygons are rejected."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非空矩形頂點會替代圓形特徵；圓引數會保留。僅支援圓形及軸對齊矩形，其他多邊形會明確拒絕。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空でない矩形の頂点は円形機能を上書きし、円設定は保持されます。 円と軸揃えの長方形をサポートし、他の多角形は除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비어 있지 않은 직사각형 정점은 원형 특징을 무시하고, 원형 설정은 유지됩니다. 원과 축에 맞춘 사각형을 지원합니다; 다른 다각형은 거부됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sommets rectangulaires non vides remplacent la caractéristique circulaire ; les paramètres du cercle sont conservés. Prend en charge les cercles et les rectangles alignés par les axes ; d'autres polygones sont rejetés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht leere Rechteckige Scheitelpunkte überschreiben das kreisförmige Merkmal; die Kreiseinstellungen bleiben erhalten. Unterstützt Kreise und achsenbündige Rechtecke; andere Polygone werden abgelehnt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los vértices rectangulares no vacíos anulan la función circular; se conservan los ajustes circulares. Admite círculos y rectángulos alineados por ejes; otros polígonos son rechazados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vértices retangulares não vazios substituem o recurso circular; as configurações de círculo são mantidas. Suporta círculos e retângulos alinhados por eixo; outros polígonos são rejeitados."
          }
        }
      }
    },
