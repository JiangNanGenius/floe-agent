    "app.bilingual.5a939f13f8e8694b": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仓库放在当前项目文件夹中，完成后加入项目列表。现有文件不会被覆盖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The repository is placed inside the current project folder and added to Projects when complete. Existing files are never replaced."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "倉庫放在當前專案資料夾中，完成後加入專案列表。現有檔案不會被覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリは現在のプロジェクトフォルダー内に配置され、完了するとプロジェクトに追加されます。 既存のファイルは決して置き換えられません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소는 현재 프로젝트 폴더 안에 배치되며, 완료되면 프로젝트에 추가됩니다. 기존 파일은 절대 교체되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le référentiel est placé dans le dossier du projet actuel et ajouté aux projets une fois terminé. Les fichiers existants ne sont jamais remplacés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Repository wird im aktuellen Projektordner abgelegt und nach Abschluss zu Projekten hinzugefügt. Vorhandene Dateien werden nie ersetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El repositorio se coloca dentro de la carpeta del proyecto actual y se agrega a Proyectos cuando se completa. Los archivos existentes nunca se reemplazan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O repositório é colocado dentro da pasta do projeto atual e adicionado aos Projetos quando concluído. Os arquivos existentes nunca são substituídos."
          }
        }
      }
    },
