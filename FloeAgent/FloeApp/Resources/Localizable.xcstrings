            "value": "O destino já existe; nada foi substituído."
          }
        }
      }
    },
    "app.bilingual.4a703c1a3e6d5d9e": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取源码包失败，请确认文件仍可访问。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source bundle could not be read. Confirm it is still accessible."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取原始碼包失敗，請確認檔案仍可訪問。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースバンドルを読み取ることができませんでした。 まだアクセス可能であることをご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스 번들을 읽을 수 없습니다. 여전히 접근 가능한지 확인하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet source n'a pas pu être lu. Vérifiez qu'il est toujours accessible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Quellpaket konnte nicht gelesen werden. Vergewissern Sie sich, dass es noch zugänglich ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el paquete de origen. Confirme que todavía está disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote de origem não pôde ser lido. Confirme se ainda está acessível."
          }
        }
      }
    },
