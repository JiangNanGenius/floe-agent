    "environment.backend.distribution_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No downloadable Floe Linux image is published yet; only a locally built, verified image can be imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未发布可下载的 Floe Linux 镜像；目前只能导入本地构建并通过校验的镜像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未釋出可下載的 Floe Linux 映象；目前只能匯入本地構建並透過校驗的映象。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロード可能な Floe Linux イメージはまだ公開されていません。ローカルにビルドされ、検証されたイメージのみをインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드 가능한 Floe Linux 이미지가 아직 게시되지 않았으며, 로컬에서 제작된 검증된 이미지만 가져올 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune image téléchargeable Floe Linux n'est encore publiée ; seule une image vérifiée construite localement peut être importée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde noch kein herunterladbares Floe Linux-Bild veröffentlicht; nur ein lokal erstelltes, verifiziertes Bild kann importiert werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no se ha publicado ninguna imagen descargable de Floe Linux; solo se puede importar una imagen verificada construida localmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma imagem Floe Linux para download foi publicada ainda; apenas uma imagem verificada e construída localmente pode ser importada."
          }
        }
      }
    },
