    "canvas.onboarding.run.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save task settings first, then press Start Generation on the task card. The task and artifact cards show progress and retry in place."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先保存任务配置，再在任务卡点击开始生成；任务卡和产物卡都会显示进度，并支持原位重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先儲存任務配置，再在任務卡點選開始生成；任務卡和產物卡都會顯示進度，並支援原位重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずタスク設定を保存し、次にタスクカードで「Start Generation」を押してください。 タスクカードとアーティファクトカードは、進行状況と再試行を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 작업 설정을 저장한 다음, 작업 카드에서 시작 생성 버튼을 누르십시오. 작업 및 아티팩트 카드는 진행 상황을 표시하고 제자리에서 재시도합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez d'abord les paramètres de la tâche, puis appuyez sur Démarrer la génération sur la carte de tâche. Les cartes de tâche et d'artefact montrent la progression et réessayez en place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie zuerst die Aufgabeneinstellungen, und drücken Sie dann auf der Aufgabenkarte die Startgenerierung. Die Aufgaben- und Artefaktkarten zeigen den Fortschritt und versuchen es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde primero la configuración de la tarea y, a continuación, pulse Start Generation en la tarjeta de tareas. Las tarjetas de tareas y artefactos muestran el progreso y vuelve a intentarlo en su lugar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve as configurações da tarefa primeiro e pressione Iniciar Geração no cartão de tarefas. Os cartões de tarefa e artefato mostram o progresso e tentam novamente no lugar."
          }
        }
      }
    },
