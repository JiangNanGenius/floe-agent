    "composer.local.confirm.message.apple": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Apple system model currently supports text chat and Apple device capabilities only. Attached images are first summarized by your configured image-assist model; when none is available, the system's image text recognition is used and its limits are stated. Floe tools such as web, Python, browser, SSH, cloud workspaces and Git are unavailable with this model."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 系统模型目前只支持文字聊天和 Apple 设备能力。附图会先由已配置的辅助读图模型生成图片摘要；没有可用辅助模型时使用系统的图片文字识别，并明确说明限制。此模型下不能使用网页、Python、浏览器、SSH、云工作区、Git 等 Floe 工具。"
          }
        }
      }
    },
    "composer.local.confirm.message.mlx": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device models work with text only and cannot see images on their own. Attached images are first summarized by your configured image-assist model; when none is available, the system's image text recognition is used and its limits are stated. They suit search, reading files, PDF text and local computation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机模型只处理文字，本身不识别图片。发送的图片会先由已配置的辅助读图模型生成图片摘要；没有可用辅助模型时，会使用系统的图片文字识别，并说明可识别的范围。它适合搜索、读取文件、处理 PDF 文字和本地计算。"
          }
        }
      }
    },
    "composer.local.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to an on-device model?"
