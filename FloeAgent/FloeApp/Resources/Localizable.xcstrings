    "app.bilingual.6c1862c0362e9b3f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿焊盘中心周围逐点绘制，最后点完成"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw around the pad center point by point, then Finish"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿焊盤中心周圍逐點繪製，最後點完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッドの中心を点ごとに描いてから、仕上げてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패드 중심을 한 점 한 점 그리시고, 그 후 마무리하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez autour du centre du tampon point par point, puis terminez"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie Punkt für Punkt um die Mitte des Pads, dann beenden Sie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja alrededor del centro de la almohadilla punto por punto, luego termina"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe ao redor do centro da almofada ponto por ponto, depois termine"
          }
        }
      }
    },
    "app.bilingual.8418f2a75f4cd3df": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点选引出端，再继续连线"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the entry tip, then continue the wire"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選引出端，再繼續連線"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリーチップを選択し、次にワイヤーを続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진입 팁을 선택한 다음, 와이어를 계속 진행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la pointe d'entrée, puis continuez le fil"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Eingabespitze und setzen Sie dann den Draht fort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la punta de entrada, luego continúe con el cable"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a ponta de entrada e, em seguida, continue o fio"
          }
        }
      }
    },
    "app.bilingual.ed660416cc37577": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续点按连线；取消放弃本次展开"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue the wire; cancel to discard this unfold"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續點按連線；取消放棄本次展開"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワイヤーを続行し、キャンセルしてこの展開を破棄してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "와이어를 계속하십시오; 이 전개를 버리려면 취소하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez le fil ; annulez pour rejeter ce déploiement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzen Sie den Draht fort; brechen Sie ab, um diese Entfaltung zu verwerfen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa el cable; cancela para descartar este despliegue"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue o fio; cancele para descartar este desdobramento"
          }
        }
      }
    },
    "app.bilingual.f77e1de281c4c266": {
