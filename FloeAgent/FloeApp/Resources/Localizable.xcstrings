    "settings.general_settings_view.when_automatic_recognition_has_no_result": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When automatic recognition has no result, explicitly choose the language in use."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别无结果时，请明确选择正在使用的语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動識別無結果時，請明確選擇正在使用的語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動認識で結果が得られない場合は、使用している言語を明示的に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 인식에 결과가 없을 경우, 사용 중인 언어를 명시적으로 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque la reconnaissance automatique n'a aucun résultat, choisissez explicitement la langue utilisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die automatische Erkennung kein Ergebnis hat, wählen Sie explizit die verwendete Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando el reconocimiento automático no tiene resultado, elija explícitamente el idioma en uso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o reconhecimento automático não tiver resultado, escolha explicitamente o idioma em uso."
          }
        }
      }
    },
    "settings.general_settings_view.when_on_an_extra_self_check": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, an extra self-check runs without calling tools; CONFIRM is not shown when everything is correct, and a corrected version is appended if issues are found."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后会额外进行一次不调用工具的自检；确认无误时不会显示 CONFIRM，发现问题时会追加修正版。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟後會額外進行一次不呼叫工具的自檢；確認無誤時不會顯示 CONFIRM，發現問題時會追加修正版。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンの場合、ツールを呼び出さずに追加の自己チェックが実行されます；すべてが正しいときに CONFIRM は表示されず、問題が見つかった場合は修正されたバージョンが付加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜진 경우, 도구를 호출하지 않고 추가 자체 검사가 실행됩니다; 모든 것이 올바른 경우 CONFIRM이 표시되지 않으며, 문제가 발견되면 수정된 버전이 추가됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'il est en cours d'exécution, une auto-vérification supplémentaire s'exécute sans appeler les outils ; CONFIRMER n'est pas affiché lorsque tout est correct, et une version corrigée est ajoutée si des problèmes sont trouvés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert ist, läuft eine zusätzliche Selbstprüfung, ohne die Tools aufzurufen; CONFIRM wird nicht angezeigt, wenn alles korrekt ist, und eine korrigierte Version wird angehängt, wenn Probleme gefunden werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está encendido, se ejecuta una autocomprobación adicional sin llamar a las herramientas; CONFIRMAR no se muestra cuando todo está correcto, y se agrega una versión corregida si se encuentran problemas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ligado, uma autoverificação extra é executada sem chamar ferramentas; CONFIRMAR não é mostrado quando tudo está correto, e uma versão corrigida é anexada se forem encontrados problemas."
          }
        }
      }
    },
