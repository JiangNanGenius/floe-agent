    "screenshare.guide.systemStop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Control Center, tap Screen Recording, then Stop Broadcast. Floe has not confirmed that sharing stopped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请打开控制中心，点击屏幕录制并停止广播。Floe 尚未确认共享已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請開啟控制中心，點選螢幕錄製並停止廣播。Floe 尚未確認共享已停止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールセンターを開き、画面録画をタップし、次に放送を停止してください。 Floeは、共有が停止したことを確認していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 센터를 열고, 화면 녹화를 탭한 다음, 방송을 중지하십시오. Floe는 공유가 중단되었음을 확인하지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez le Centre de contrôle, appuyez sur Enregistrement d'écran, puis sur Arrêter la diffusion. Floe n'a pas confirmé que le partage a cessé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie das Kontrollzentrum, tippen Sie auf Bildschirmaufnahme und dann auf Übertragung stoppen. Floe hat nicht bestätigt, dass die Freigabe beendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra el Centro de control, toque Grabación de pantalla y, a continuación, Detener transmisión. Floe no ha confirmado que se haya detenido el uso compartido."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a Central de Controle, toque em Gravação de Tela e depois em Parar Transmissão. Floe não confirmou que o compartilhamento parou."
          }
        }
      }
    },
    "screenshare.guide.restartShare": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Screen Recording in Control Center, then share again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在控制中心停止屏幕录制，再重新共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在控制中心停止螢幕錄製，再重新共享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントロールセンターで画面録画を停止し、再度共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제어 센터에서 화면 녹화를 중지한 후 다시 공유하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez l'enregistrement d'écran dans le centre de contrôle, puis partagez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie die Bildschirmaufnahme im Kontrollzentrum und teilen Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenga la grabación de pantalla en el Centro de control y, a continuación, vuelva a compartir."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompa a Gravação da Tela na Central de Controle e compartilhe novamente."
          }
        }
      }
    },
