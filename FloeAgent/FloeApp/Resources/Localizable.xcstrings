            "state": "translated",
            "value": "Choisissez une image à cadre unique. Les pages et les cadres d'animation ne seront pas supprimés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Einzelbildbild. Seiten und Animationsrahmen werden nicht verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una imagen de un solo fotograma. Las páginas y los fotogramas de animación no se descartarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
