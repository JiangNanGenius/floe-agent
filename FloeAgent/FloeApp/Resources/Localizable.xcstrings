    "mail.error.tlsFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS verification failed; insecure fallback is disabled."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密连接验证失败，不会降级为明文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密連線驗證失敗，不會降級為明文。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS検証に失敗しました；安全でないフォールバックは無効化されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS 검증에 실패했습니다; 보안이 취약한 폴백이 비활성화되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification TLS a échoué ; le repli non sécurisé est désactivé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TLS-Verifizierung fehlgeschlagen; unsicherer Fallback ist deaktiviert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La verificación de TLS falló; el respaldo inseguro está deshabilitado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na verificação do TLS; o fallback inseguro está desativado."
          }
        }
      }
    },
