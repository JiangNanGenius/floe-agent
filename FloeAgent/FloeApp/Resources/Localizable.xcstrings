    "app.bilingual.7622ec70a2d9460f": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待当前存档操作完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current save operation to finish."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請等待當前存檔操作完成。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の保存操作が完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 저장 작업이 완료될 때까지 기다리십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez que l'opération de sauvegarde en cours soit terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis der aktuelle Speichervorgang abgeschlossen ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere a que finalice la operación de guardado actual."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da operação de salvamento atual."
          }
        }
      }
    },
    "app.bilingual.2c368f0edff5f5a0": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎无法捕获原生状态，请使用游戏自带的存档。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine can't capture native state. Use its own in-game saves."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此引擎無法捕獲原生狀態，請使用遊戲自帶的存檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエンジンはネイティブ状態を取得できません。 独自のゲーム内セーブを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 엔진은 네이티브 상태를 포착할 수 없습니다. 자체 게임 내 저장을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur ne peut pas capturer l'état natif. Utilisez ses propres sauvegardes en jeu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine kann den nativen Zustand nicht erfassen. Verwenden Sie Ihre eigenen In-Game-Speicher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor no puede capturar el estado nativo. Usa tus propios guardados en el juego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este mecanismo não pode capturar o estado nativo. Use seus próprios salvamentos no jogo."
          }
        }
      }
    },
    "app.bilingual.a404db1db888672": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏运行已变化，请为新运行重新打开存档管理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game run changed. Reopen save management for the new run."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲執行已變化，請為新執行重新開啟存檔管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームの実行が変更されました。 新しい実行の保存管理を再開してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 실행이 변경되었습니다. 새 실행에 대한 저장 관리를 다시 엽니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La course du jeu a changé. Rouvrir la gestion de la sauvegarde pour la nouvelle exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spiellauf hat sich geändert. Wiedereröffnung der Speicherverwaltung für den neuen Lauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carrera del juego cambió. Vuelva a abrir la gestión de guardados para la nueva ejecución."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A execução do jogo mudou. Reabrir o gerenciamento de salvamento para a nova execução."
          }
        }
      }
    },
    "app.bilingual.ba2b46a00bfc8324": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏无法捕获快照；当前进度未改变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game couldn't capture a snapshot. Your progress is unchanged."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲無法捕獲快照；當前進度未改變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはスナップショットを取得できませんでした。 進捗は変わっておりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 스냅샷을 캡처하지 못했습니다. 귀하의 진행 상황은 변함이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n'a pas pu capturer un instantané. Vos progrès sont inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel konnte keinen Schnappschuss aufnehmen. Ihr Fortschritt ist unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no pudo capturar una instantánea. Tu progreso no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não conseguiu capturar um instantâneo. Seu progresso está inalterado."
          }
        }
      }
    },
    "app.bilingual.edd23a49507f17ab": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏无法恢复该存档；当前进度已保留在安全检查点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game couldn't restore that save. Your progress was kept in the safety checkpoint."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲無法恢復該存檔；當前進度已保留在安全檢查點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームはそのセーブデータを復元できませんでした。 お客様の進捗は安全チェックポイントで保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 해당 저장을 복원할 수 없었습니다. 귀하의 진행 상황은 안전 체크포인트에 보관되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu n'a pas pu restaurer cette sauvegarde. Votre progression a été conservée au point de contrôle de sécurité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel konnte diesen Speicher nicht wiederherstellen. Ihr Fortschritt wurde in der Sicherheitskontrolle aufbewahrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no pudo restaurar ese guardado. Su progreso se mantuvo en el punto de control de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não conseguiu restaurar esse salvamento. Seu progresso foi mantido no ponto de verificação de segurança."
          }
        }
      }
    },
