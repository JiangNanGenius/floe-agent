    "model.reasoning.omit_parameters.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No thinking controls are sent. Whether and how much the model thinks follows the service’s defaults."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不发送任何思考控制参数，是否思考及思考深度由服务默认设置决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不傳送任何思考控制引數，是否思考及思考深度由服務預設設定決定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "思考コントロールは送信されません。 モデルがサービスのデフォルトに従っているかどうか、またその考えの量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생각 제어가 전송되지 않습니다. 모델이 서비스 기본값을 따르는지 여부와 그 정도."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contrôle de réflexion n'est envoyé. Si et dans quelle mesure le modèle pense suivre les valeurs par défaut du service."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden keine Gedankenkontrollen gesendet. Ob und wie viel das Modell denkt, dass es den Standardeinstellungen des Dienstes folgt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envían controles de pensamiento. Si y cuánto cree que el modelo sigue los valores predeterminados del servicio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum controle de pensamento é enviado. Se e quanto o modelo acha que segue os padrões do serviço."
          }
        }
      }
    },
