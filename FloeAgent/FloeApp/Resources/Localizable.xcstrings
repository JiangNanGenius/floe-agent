    },
    "app.bilingual.880a84c5cfc15659": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次渲染已中断，输入已保留，可重新开始。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendering was interrupted. Its input is preserved; start a new render."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次渲染已中斷，輸入已保留，可重新開始。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダリングが中断されました。 入力は保持されています。新しいレンダーを開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더링이 중단되었습니다. 입력이 보존됩니다; 새 렌더를 시작하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rendu a été interrompu. Son entrée est préservée ; démarrez un nouveau rendu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Rendering wurde unterbrochen. Seine Eingabe bleibt erhalten; starten Sie ein neues Rendering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La representación fue interrumpida. Su entrada se conserva; inicie un nuevo renderizado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A renderização foi interrompida. Sua entrada é preservada; inicie uma nova renderização."
          }
        }
      }
    },
    "app.bilingual.a3d28e93d6b496fc": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染器未返回完整图像，请重试或减小尺寸。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The renderer did not return a complete image. Try again or choose a smaller size."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "渲染器未返回完整影象，請重試或減小尺寸。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダラーは完全な画像を返しませんでした。 もう一度お試しになるか、より小さいサイズをお選びください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더러가 전체 이미지를 반환하지 않았습니다. 다시 시도하거나 더 작은 크기를 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de rendu n'a pas renvoyé une image complète. Réessayez ou choisissez une taille plus petite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Renderer hat kein vollständiges Bild zurückgegeben. Versuchen Sie es erneut oder wählen Sie eine kleinere Größe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El renderizador no devolvió una imagen completa. Inténtalo de nuevo o elige una talla más pequeña."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O renderizador não retornou uma imagem completa. Tente novamente ou escolha um tamanho menor."
          }
        }
      }
    },
