    "cad.sculpt.entryHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an editable polygon mesh without face textures. Apple Pencil pressure controls the brush; two fingers move the view."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用没有面纹理的可编辑多边形网格。Apple Pencil 笔压控制笔刷，双指移动视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用沒有面紋理的可編輯多邊形網格。Apple Pencil 筆壓控制筆刷，雙指移動檢視。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔のテクスチャを使用せずに、編集可能なポリゴンメッシュを使用してください。 Apple Pencil の圧力がブラシを制御し、2本の指でビューを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼굴 텍스처 없이 편집 가능한 폴리곤 메쉬를 사용하십시오. Apple Pencil 압력이 브러시를 제어합니다; 두 손가락으로 뷰를 이동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un maillage polygonal modifiable sans textures de visage. La pression Apple Pencil contrôle la brosse ; deux doigts déplacent la vue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie ein bearbeitbares Polygonnetz ohne Gesichtstexturen. Der Druck von Apple Pencil steuert die Bürste; zwei Finger bewegen die Ansicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice una malla polígono editable sin texturas de cara. La presión de Apple Pencil controla el cepillo; dos dedos mueven la vista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma malha de polígono editável sem texturas de rosto. A pressão do Apple Pencil controla o pincel; dois dedos movem a visão."
          }
        }
      }
    },
    "cad.sculpt.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't apply the stroke. Your mesh is unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能应用笔刷。网格保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能應用筆刷。網格保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストロークを適用できませんでした。 お使いのメッシュは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트로크를 적용할 수 없었습니다. 귀하의 메시는 변경되지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'appliquer le trait. Votre maillage est inchangé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte den Schlaganfall nicht anwenden. Ihr Netz ist unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude aplicar el golpe. Su malla no ha cambiado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível aplicar o golpe. Sua malha está inalterada."
          }
        }
      }
    },
    "cad.sculpt.saveFailed": {
