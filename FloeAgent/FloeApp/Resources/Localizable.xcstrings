    "app.bilingual.da34b2ac64fe3d66": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Office 文件的已保存 PDF 导出不可用。请导出原始文件或 .floenote。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A saved PDF export is not available for this Office file. Export the original or a .floenote archive instead."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Office 檔案的已儲存 PDF 匯出不可用。請匯出原始檔案或 .floenote。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Office ファイルでは、保存された PDF エクスポートは利用できません。 代わりに、オリジナルまたは .floenote アーカイブをエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Office 파일에 대해 저장된 PDF 내보내기를 사용할 수 없습니다. 원본 또는 .floenote 아카이브를 대신 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une exportation PDF enregistrée n'est pas disponible pour ce fichier Office. Exportez plutôt l'original ou une archive .floenote."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein gespeicherter PDF-Export ist für diese Office-Datei nicht verfügbar. Exportieren Sie stattdessen das Original oder ein .floenote-Archiv."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una exportación PDF guardada no está disponible para este archivo de Office. En su lugar, exporte el original o un archivo .floenote."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma exportação PDF salva não está disponível para este arquivo do Office. Em vez disso, exporte o original ou um arquivo .floenote."
          }
        }
      }
    },
