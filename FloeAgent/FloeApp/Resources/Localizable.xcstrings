    "app.bilingual.1009721b65ee0a0d": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此凭据已用于其他绑定，卸载此技能不会删除共享凭据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This credential is already used by another binding. Removing this skill will not delete the shared credential."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此憑據已用於其他繫結，解除安裝此技能不會刪除共享憑據。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この認証情報はすでに別のバインディングで使用されています。 このスキルを削除しても、共有された認証情報は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자격 증명은 이미 다른 바인딩에 의해 사용되고 있습니다. 이 스킬을 제거해도 공유 자격 증명은 삭제되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette information d'identification est déjà utilisée par une autre liaison. La suppression de cette compétence ne supprimera pas les informations d'identification partagées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldeinformationen werden bereits von einer anderen Bindung verwendet. Wenn Sie diesen Skill entfernen, werden die freigegebenen Anmeldeinformationen nicht gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta credencial ya está siendo utilizada por otro enlace. Eliminar esta habilidad no eliminará la credencial compartida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta credencial já é usada por outra ligação. Remover essa habilidade não excluirá a credencial compartilhada."
          }
        }
      }
    },
