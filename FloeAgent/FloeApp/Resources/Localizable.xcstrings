        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스가 변경되었습니다; 최신 콘텐츠로 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
