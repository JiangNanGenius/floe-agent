    "app.bilingual.babf1712166f87c2": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交后任务会持久化；关闭视图不会丢弃任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The submitted job is durable; closing the view does not drop it."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交後任務會持久化；關閉檢視不會丟棄任務。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提出されたジョブは耐久性があります。ビューを閉じてもドロップしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제출된 작업은 내구성이 뛰어나며, 뷰를 닫아도 해당 작업이 중단되지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail soumis est durable ; la fermeture de la vue ne la laisse pas tomber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingereichte Auftrag ist langlebig; das Schließen der Ansicht lässt ihn nicht fallen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo enviado es duradero; cerrar la vista no lo deja caer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho enviado é durável; fechar a visualização não o deixa cair."
          }
        }
      }
    },
    "app.bilingual.a9f2b4203ab2f582": {
