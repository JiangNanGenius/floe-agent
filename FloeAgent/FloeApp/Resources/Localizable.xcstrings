    "settings.remote.hosts.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Host keys and fingerprints are managed from the Hosts tab when connecting."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主机密钥与指纹在连接时于“主机”页管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主機金鑰與指紋在連線時於“主機”頁管理。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストキーとフィンガープリントは、接続時にホストタブから管理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 키와 지문은 연결 시 호스트 탭에서 관리됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés d'hôte et les empreintes digitales sont gérées à partir de l'onglet Hôtes lors de la connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Host-Schlüssel und Fingerabdrücke werden über die Registerkarte \"Hosts\" bei der Verbindung verwaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de host y las huellas dactilares se gestionan desde la pestaña Hosts al conectarse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves e as impressões digitais do host são gerenciadas na guia Hosts ao se conectar."
          }
        }
      }
    },
