    "cad.material.faceRange.missing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has saved face materials that can't be shown on this shape. Reassign them in Material."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中保存的面材质无法在此形状上显示。请在“材质”中重新指定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 中儲存的面材質無法在此形狀上顯示。請在“材質”中重新指定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は、この形状では表示できないフェイス素材を保存しました。 Materialでそれらを再割り当てしてください。"
          }
