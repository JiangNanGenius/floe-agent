    "notes.mindmap.addChild.help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a child topic under the selection and start naming it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在选中主题下新增子节点并直接命名"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在選中主題下新增子節點並直接命名"
