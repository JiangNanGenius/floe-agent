          "stringUnit": {
            "state": "translated",
            "value": "Après vérification des mémoires existantes, les doublons et le contenu expiré sont traités automatiquement. Vous pouvez consulter le résultat de chaque organisation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
