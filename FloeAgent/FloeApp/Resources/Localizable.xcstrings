    "settings.data_management_view.caches_regenerated_on_demand": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cached data that Floe regenerates on demand; active downloads and recent work are skipped."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 可按需重新生成的缓存；正在进行的下载和最近的工作会被跳过。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe 可按需重新生成的快取；正在進行的下載和最近的工作會被跳過。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe がオンデマンドで再生成するキャッシュデータです。アクティブなダウンロードや最近の作業はスキップされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Floe가 필요에 따라 재생성하는 캐시된 데이터이며, 활성 다운로드와 최근 작업은 건너뛰어집니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données mises en cache que Floe régénère à la demande ; les téléchargements actifs et les travaux récents sont ignorés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischengespeicherte Daten, die Floe bei Bedarf regeneriert; aktive Downloads und aktuelle Arbeiten werden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos en caché que Floe regenera bajo demanda; se omiten las descargas activas y el trabajo reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados em cache que Floe regenera sob demanda; downloads ativos e trabalhos recentes são ignorados."
          }
        }
      }
    },
