    "environment.packages.linux.required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Linux environment is available on this device. apt/dpkg manage Debian packages only inside a Floe Linux environment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机没有可用的 Linux 环境。apt/dpkg 只在 Floe Linux 环境内管理 Debian 软件包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機沒有可用的 Linux 環境。apt/dpkg 只在 Floe Linux 環境內管理 Debian 軟體包。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは Linux 環境が利用できません。apt/dpkg は Floe Linux 環境内でのみ Debian パッケージを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서는 Linux 환경을 사용할 수 없습니다. apt/dpkg는 Floe Linux 환경 내에서만 Debian 패키지를 관리합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun environnement Linux n'est disponible sur cet appareil. apt/dpkg gère les paquets Debian uniquement à l'intérieur d'un environnement Floe Linux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Linux-Umgebung verfügbar. apt/dpkg verwaltet Debian-Pakete nur innerhalb einer Floe Linux-Umgebung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay un entorno Linux disponible en este dispositivo. apt/dpkg administra paquetes Debian solo dentro de un entorno Floe Linux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ambiente Linux está disponível neste dispositivo. apt/dpkg gerencia pacotes Debian apenas dentro de um ambiente Floe Linux."
          }
        }
      }
    },
    "environment.packages.linux.split": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, Node and signed WASI commands keep their own entries above; apt never installs them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Python、Node 与签名 WASI 命令保留上方各自的独立入口；apt 不会安装它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Python、Node 與簽名 WASI 命令保留上方各自的獨立入口；apt 不會安裝它們。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Python、Node、および署名付きWASIコマンドは、上記に独自のエントリを保持します；aptはそれらを決してインストールしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, Node 및 서명된 WASI 명령은 위에 자체 항목을 보관합니다; apt는 이를 절대 설치하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes Python, Node et WASI signées conservent leurs propres entrées au-dessus ; apt ne les installe jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, Node und signierte WASI-Befehle behalten ihre eigenen Einträge oben; apt installiert sie nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, Node y los comandos WASI firmados mantienen sus propias entradas arriba; apt nunca los instala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Python, Node e comandos WASI assinados mantêm suas próprias entradas acima; apt nunca os instala."
          }
        }
      }
    },
