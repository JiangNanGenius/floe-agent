    "feedback.entry.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the problem and upload a redacted diagnostic log, or export it for manual sharing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述问题并上传脱敏诊断日志，也可以导出后手动分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述問題並上傳脫敏診斷日誌，也可以匯出後手動分享。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を記述し、削除された診断ログをアップロードするか、手動で共有するためにエクスポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제를 설명하고 편집된 진단 로그를 업로드하거나 수동으로 공유하기 위해 내보내십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez le problème et téléchargez un journal de diagnostic expurgé, ou exportez-le pour un partage manuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie das Problem und laden Sie ein überarbeitetes Diagnoseprotokoll hoch oder exportieren Sie es zur manuellen Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describa el problema y cargue un registro de diagnóstico redactado, o expórtelo para compartirlo manualmente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva o problema e carregue um registro de diagnóstico redigido ou exporte-o para compartilhamento manual."
          }
        }
      }
    },
