    "background.linux.disk_preserved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. The disk is preserved and it can be started again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。磁盘已保留，可再次启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。磁碟已保留，可再次啟動。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. ディスクは保存されており、再度起動できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. 디스크가 보존되어 다시 시작할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Le disque est conservé et il peut être recommencé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Die Festplatte bleibt erhalten und kann erneut gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ El disco se conserva y se puede iniciar de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ O disco é preservado e pode ser iniciado novamente."
          }
        }
      }
    },
    "background.linux.service_environment_gone_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The environment is no longer running; the managed service stopped with it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境已不再运行，托管服务随之终止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "環境已不再執行，託管服務隨之終止。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "環境はもはや稼働していません。管理サービスはそれとともに停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환경이 더 이상 실행 중이 아니며, 관리 서비스가 중단되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement ne fonctionne plus ; le service géré s'est arrêté avec lui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umgebung läuft nicht mehr; der verwaltete Dienst hat damit aufgehört."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno ya no está funcionando; el servicio administrado se detuvo con él."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente não está mais funcionando; o serviço gerenciado parou com ele."
          }
        }
      }
    },
    "background.linux.service_exited_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The background service exited unexpectedly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务异常退出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "後臺服務異常退出。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドサービスが予期せず終了しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 서비스가 예기치 않게 종료되었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'arrière-plan a quitté de manière inattendue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Hintergrunddienst wurde unerwartet beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio en segundo plano salió inesperadamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço em segundo plano saiu inesperadamente."
          }
        }
      }
    },
    "background.linux.service_unexpected_stop_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service stopped without a stop request. The guest protocol reports liveness only, so the exit reason is unknown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务在未收到停止指令时终止；客户机协议只报告存活状态，无法得知退出原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服務在未收到停止指令時終止；客戶機協議只報告存活狀態，無法得知退出原因。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サービスは停止要求なしで停止しました。 ゲストプロトコルはライブネスのみを報告しますので、終了理由は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스가 정지 요청 없이 중단되었습니다. 게스트 프로토콜은 실시간만 보고하므로 종료 사유는 알 수 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service s'est arrêté sans demande d'arrêt. Le protocole invité ne signale que la vie, donc la raison de la sortie est inconnue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst wurde ohne Stoppanfrage eingestellt. Das Gastprotokoll meldet nur Lebendigkeit, daher ist der Ausgangsgrund unbekannt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio se detuvo sin una solicitud de parada. El protocolo de invitado solo informa de la vivacidad, por lo que se desconoce el motivo de la salida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço parou sem uma solicitação de parada. O protocolo do convidado relata apenas a vivacidade, então o motivo da saída é desconhecido."
          }
        }
      }
    },
    "background.linux.stop_detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; the environment stopped safely and flushed its disk. The background-running preference is preserved."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@；环境已安全停止并刷新磁盘，后台运行偏好保留"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@；環境已安全停止並重新整理磁碟，後臺執行偏好保留"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; 環境は安全に停止し、ディスクをフラッシュしました。 バックグラウンド実行の設定は保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; 환경이 안전하게 멈추고 디스크를 플러시했습니다. 백그라운드 실행 기본 설정이 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ; l'environnement s'est arrêté en toute sécurité et a vidé son disque. La préférence d'exécution en arrière-plan est préservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; die Umgebung blieb sicher stehen und spülte ihre Festplatte. Die Hintergrundlaufpräferenz bleibt erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; el entorno se detuvo de forma segura y limpió su disco. Se conserva la preferencia de ejecución en segundo plano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@; o ambiente parou com segurança e lavou seu disco. A preferência de execução em segundo plano é preservada."
          }
        }
      }
    },
