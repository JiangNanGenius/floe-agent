    "app.bilingual.93ccda1cbd4b73bd": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原件已改变，请重新选择元件后定位。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original changed. Select the component again before locating it."
          }
        },
