    "settings.data_management_view.unregistered_scratch_retention": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No component has registered a cleanup lease with a live owner probe, so this is retained."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无组件注册带实时所有者探测的清理租约，因此保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無元件註冊帶實時所有者探測的清理租約，因此保留。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いかなるコンポーネントも、ライブオーナープローブ付きのクリーンアップリースを登録していないため、これが保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 구성 요소도 실시간 소유자 탐색이 포함된 정리 임대를 등록하지 않아, 이는 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun composant n'a enregistré un bail de nettoyage avec une sonde de propriétaire en direct, donc cela est conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Komponente hat einen Bereinigungsleasing mit einer lebenden Eigentümersonde registriert, daher wird diese beibehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún componente ha registrado un contrato de arrendamiento de limpieza con una sonda de propietario en vivo, por lo que esto se conserva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum componente registrou um contrato de locação de limpeza com uma sonda de proprietário ao vivo, portanto, isso é mantido."
          }
        }
      }
    },
