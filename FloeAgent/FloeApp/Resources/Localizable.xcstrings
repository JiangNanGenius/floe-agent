    "cad.loftSurface.noInputs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw open curves on two sketch planes, or select an exact surface."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在两个草图平面绘制开放曲线，或选择精确曲面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在兩個草圖平面繪製開放曲線，或選擇精確曲面。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つのスケッチ平面上に開いた曲線を描くか、正確な面を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 개의 스케치 평면에 열린 곡선을 그리거나, 정확한 표면을 선택하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez des courbes ouvertes sur deux plans de croquis, ou sélectionnez une surface exacte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnen Sie offene Kurven auf zwei Skizzenebenen oder wählen Sie eine exakte Oberfläche aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja curvas abiertas en dos planos de boceto, o selecciona una superficie exacta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe curvas abertas em dois planos de esboço ou selecione uma superfície exata."
          }
        }
      }
    },
    "cad.loftSurface.planarHelp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills closed planar openings. Other boundaries are left unchanged if the operation fails."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填补闭合的平面开口；若失败，原曲面保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "填補閉合的平面開口；若失敗，原曲面保持不變。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた平面開口部を埋めます。 操作が失敗した場合、他の境界は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫힌 평면 개구부를 채웁니다. 다른 경계는 작업이 실패할 경우 그대로 유지됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit les ouvertures planes fermées. Les autres limites sont laissées inchangées si l'opération échoue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt geschlossene planare Öffnungen. Andere Grenzen bleiben unverändert, wenn der Vorgang fehlschlägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llena las aberturas planas cerradas. Otros límites se dejan sin cambios si la operación falla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche aberturas planares fechadas. Outros limites são deixados inalterados se a operação falhar."
          }
        }
      }
    },
    "cad.loftSurface.requireClosed": {
      "extractionState": "manual",
