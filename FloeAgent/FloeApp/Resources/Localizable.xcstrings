    "exec.linux.allow_background": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow background running"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许后台运行"
          }
        }
      }
    },
    "exec.linux.background_note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When on, leaving Floe asks the system for background time through a continued-processing task and prepares a Picture-in-Picture status. Closing Picture-in-Picture safely stops the virtual machine and refreshes its disk, but this preference stays on. The system may still end the environment when it reclaims Floe; the disk is kept and it can be started again next time. Unlimited background running is not guaranteed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启后，离开 Floe 时会通过持续处理任务向系统申请后台时间，并准备状态画中画；关闭画中画会安全停止虚拟机并刷新磁盘，但保留此开关。系统回收 Floe 后环境仍可能停止（磁盘保留），下次可重新启动。不保证无限后台运行。"
          }
        }
      }
    },
    "exec.linux.background_section": {
      "localizations": {
