    "documents.office_native_save_validation.the_slide_chart_data_was_not": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The slide chart data was not fully saved; an edited copy was kept and the original file was not overwritten."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幻灯片图表的数据未完整保存，已保留编辑副本，原文件未被覆盖。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幻燈片圖表的資料未完整儲存，已保留編輯副本，原檔案未被覆蓋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スライドチャートのデータは完全に保存されませんでした；編集されたコピーが保持され、元のファイルは上書きされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬라이드 차트 데이터가 완전히 저장되지 않았으며, 편집된 사본이 보관되었고 원본 파일이 덮어쓰여지지 않았습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données du diagramme de diapositives n'ont pas été entièrement enregistrées ; une copie modifiée a été conservée et le fichier original n'a pas été écrasé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Foliendiagrammdaten wurden nicht vollständig gespeichert; eine bearbeitete Kopie wurde beibehalten und die Originaldatei wurde nicht überschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de la tabla de diapositivas no se guardaron por completo; se mantuvo una copia editada y el archivo original no se sobrescribió."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados do gráfico de slides não foram totalmente salvos; uma cópia editada foi mantida e o arquivo original não foi substituído."
          }
        }
      }
    },
    "documents.office_opening_policy.an_edited_copy_was_kept_retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An edited copy was kept: retry the preview, or restore from “Kept documents”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑副本已保留：可重试预览，或从“保留的文档”恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯副本已保留：可重試預覽，或從“保留的文件”恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集されたコピーが保持されました：プレビューを再試行するか、“Kept documents”から復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집된 사본이 보관되었습니다: 미리보기를 다시 시도하거나 “보관된 문서”에서 복원하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une copie modifiée a été conservée : réessayez l'aperçu ou restaurez à partir de \"Documents conservés\"."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine bearbeitete Kopie wurde beibehalten: Versuchen Sie die Vorschau erneut oder stellen Sie sie aus \"Aufbehaltene Dokumente\" wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantuvo una copia editada: vuelva a intentar la vista previa o restaurar desde \"Documentos guardados\"."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma cópia editada foi mantida: tente novamente a visualização ou restaure de \"Documentos mantidos\"."
          }
        }
      }
    },
    "documents.office_opening_policy.an_edited_copy_was_kept_retry_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
