    "cad.datum.threePointHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick three existing sketch points. The first is the plane origin; the plane follows those entities."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择三个现有草图点。第一个点为平面原点；平面会随这些实体更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇三個現有草圖點。第一個點為平面原點；平面會隨這些實體更新。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のスケッチポイントを3つ選んでください。 最初は平面の原点であり、平面はそれらのエンティティに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 스케치 포인트 세 개를 선택하십시오. 첫 번째는 평면 원점이며, 평면은 그 엔터티들을 따릅니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez trois points de croquis existants. Le premier est l'origine du plan ; l'avion suit ces entités."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie drei vorhandene Skizzenpunkte aus. Die erste ist der Ursprung der Ebene; die Ebene folgt diesen Entitäten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tres puntos de boceto existentes. El primero es el origen del plano; el plano sigue a esas entidades."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha três pontos de esboço existentes. A primeira é a origem do plano; o plano segue essas entidades."
          }
        }
      }
    },
