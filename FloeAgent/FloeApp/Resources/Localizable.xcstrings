          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova as peças aninhadas pela hierarquia de montagem primeiro."
          }
        }
      }
    },
    "cad.scene.definitionScope": {
      "localizations": {
        "en": {
          "stringUnit": {
