    "background.schedule.pending_notification.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is due but Floe has not run it yet. Open Floe to run it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已到执行时间，但尚未运行。打开 Floe 立即执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已到執行時間，但尚未執行。開啟 Floe 立即執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は期限がありますが、Floe はまだ実行されていません。 Floe を開いて実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@는 마감이지만 Floe는 아직 실행되지 않았습니다. Floe를 열어 실행하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est dû, mais Floe ne l'a pas encore exécuté. Ouvrez Floe pour l'exécuter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist fällig, aber Floe hat es noch nicht ausgeführt. Öffnen Sie Floe, um es auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vence, pero Floe aún no lo ha ejecutado. Abre Floe para ejecutarlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é devido, mas Floe ainda não o executou. Abra Floe para executá-lo."
          }
        }
      }
    },
