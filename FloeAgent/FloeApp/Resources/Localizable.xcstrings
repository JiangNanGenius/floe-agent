    "app.bilingual.addb408fc0aa6583": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除的存档会保留到该列表达到上限，可随时恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted saves remain recoverable until this list fills."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除的存檔會保留到該列表達到上限，可隨時恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除されたセーブは、このリストが満杯になるまで復元可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 저장은 이 목록이 채워질 때까지 복구할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes supprimées restent récupérables jusqu'à ce que cette liste soit remplie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Speicherstände bleiben wiederherstellbar, bis diese Liste gefüllt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los guardados eliminados siguen siendo recuperables hasta que se llene esta lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os salvamentos excluídos permanecem recuperáveis até que esta lista seja preenchida."
          }
        }
      }
    },
