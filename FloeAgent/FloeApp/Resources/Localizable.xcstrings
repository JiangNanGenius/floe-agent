        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 로컬 네트워크 주소를 찾을 수 없습니다; 표시된 주소는 이 iPad에서만 작동합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune adresse de réseau local n'a encore été trouvée ; l'adresse indiquée ne fonctionne que sur cet iPad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine lokale Netzwerkadresse gefunden; die angezeigte Adresse funktioniert nur auf diesem iPad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha encontrado ninguna dirección de red local; la dirección que se muestra solo funciona en este iPad."
