    "providers.model_discovery.subscription_catalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a model from the catalog or enter its ID. This plan does not provide a model listing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从目录选择模型或填写模型 ID。此套餐不提供模型列表查询。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從目錄選擇模型或填寫模型 ID。此套餐不提供模型列表查詢。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カタログからモデルを選択するか、そのIDを入力してください。 このプランはモデル一覧を提供していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그에서 모델을 선택하거나 해당 ID를 입력하십시오. 이 계획은 모델 목록을 제공하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle dans le catalogue ou entrez son identifiant. Ce plan ne fournit pas de liste de modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Modell aus dem Katalog oder geben Sie dessen ID ein. Dieser Plan bietet keine Modellliste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija un modelo del catálogo o introduzca su ID. Este plan no proporciona una lista de modelos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um modelo do catálogo ou insira seu ID. Este plano não fornece uma lista de modelos."
          }
        }
      }
    },
    "providers.model_editor.reasoning.deepseek_medium_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek supports low/high/max natively; its API accepts medium as a compatibility alias and maps it to high, so there is no native medium tier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 原生支持 low/high/max；其 API 接受 medium 作为兼容别名并映射为 high，没有原生 medium 档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek 原生支援 low/high/max；其 API 接受 medium 作為相容別名並對映為 high，沒有原生 medium 檔。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek はロー/ハイ/マックスをネイティブにサポートしており、その API は medium を互換性エイリアスとして受け入れ、high にマッピングするため、ネイティブの medium 階層は存在しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek는 low/high/max를 기본적으로 지원합니다; 해당 API는 중간을 호환성 별칭으로 받아 high에 매핑하므로 기본 중간 등급이 없습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek prend en charge low/high/max nativement ; son API accepte le médium comme alias de compatibilité et le mappe à haut, il n'y a donc pas de niveau moyen natif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek unterstützt niedrig/hoch/max nativ; sein API akzeptiert Medium als Kompatibilitäts-Alias und ordnet es hoch zu, so dass es keine native mittlere Stufe gibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek admite bajo/alto/máximo de forma nativa; su API acepta medio como alias de compatibilidad y lo asigna a alto, por lo que no hay un nivel medio nativo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DeepSeek suporta baixo/alto/máximo nativamente; seu API aceita meio como um alias de compatibilidade e o mapeia para alto, portanto, não há nível de meio nativo."
          }
        }
      }
    },
