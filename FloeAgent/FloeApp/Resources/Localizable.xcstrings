          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DWG/DXF プランから壁の中心線をインポートするか、壁を描画してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DWG/DXF 도면에서 벽 중앙선을 가져오거나, 벽을 그리십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
