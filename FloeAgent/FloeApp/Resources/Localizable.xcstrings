            "value": "Charger cette sauvegarde ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Speicher laden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cargar este guardado?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
