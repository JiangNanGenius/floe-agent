    "cad.scene.assemblyParent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move nested parts through the assembly hierarchy first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在装配层级中移动嵌套零件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在裝配層級中移動巢狀零件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず、アセンブリ階層で入れ子になった部品を移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 중첩된 부품을 조립 계층 구조를 통해 이동하십시오."
