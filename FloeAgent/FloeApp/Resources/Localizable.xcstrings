    "cad.material.library.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applying a material copies it into this document. Editing or deleting a library entry never changes models that already use it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用材质会将其复制到当前文档。编辑或删除库记录不会改变已使用它的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用材質會將其複製到當前文件。編輯或刪除庫記錄不會改變已使用它的模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素材を適用すると、この文書にコピーされます。 ライブラリエントリを編集したり削除したりしても、すでにそれを使用しているモデルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자료를 적용하면 이 문서에 복사됩니다. 라이브러리 항목을 편집하거나 삭제하는 것은 이미 이를 사용하고 있는 모델을 전혀 변경하지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
