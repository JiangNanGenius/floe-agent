    "cad.mesh.voxel.budgetError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use larger voxels or a larger deviation limit to fit the reconstruction budget."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请增大体素尺寸或偏差上限，以满足重建预算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請增大體素尺寸或偏差上限，以滿足重建預算。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再構築予算に合わせて、より大きなボクセルまたはより大きな偏差上限を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재구성 예산에 맞추기 위해 더 큰 복셀이나 더 큰 편차 제한을 사용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des voxels plus grands ou une limite d'écart plus importante pour s'adapter au budget de reconstruction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie größere Voxel oder ein größeres Abweichungslimit, um das Rekonstruktionsbudget anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice vóxeles más grandes o un límite de desviación más grande para ajustarse al presupuesto de reconstrucción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use voxels maiores ou um limite de desvio maior para caber no orçamento de reconstrução."
          }
        }
      }
    },
    "cad.mesh.voxel.distanceError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result exceeds the deviation limit. Try smaller voxels."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
