          "stringUnit": {
            "state": "translated",
            "value": "A proposta expirou (o documento tem uma versão mais recente) e não foi aplicada."
          }
        }
      }
    },
    "notes.notes_document_editor.this_match_is_in_office_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This match is in Office body text or a deleted page and cannot be located on a page."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该匹配位于 Office 正文或已删除页面，无法在页面中定位。"
