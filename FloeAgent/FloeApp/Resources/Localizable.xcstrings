        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 전사는 일시적으로 이용할 수 없으며, 숨겨진 청크는 나중에 전사될 예정입니다. 녹음은 영향을 받지 않습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription en direct est temporairement indisponible ; les morceaux découverts seront transcrits plus tard. L'enregistrement n'est pas affecté."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Transkription ist vorübergehend nicht verfügbar; unbedeckte Chunks werden später transkribiert. Die Aufzeichnung ist nicht betroffen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
