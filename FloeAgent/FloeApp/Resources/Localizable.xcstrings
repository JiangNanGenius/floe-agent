          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation de maillage. Les solides exacts, l'historique des modifications et les annotations ne sont pas inclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesh-Export. Genaue Festkörper, Bearbeitungsverlauf und Anmerkungen sind nicht enthalten."
