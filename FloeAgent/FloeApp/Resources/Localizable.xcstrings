    "template.summary.dev_document": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in Basic, plus git, network diagnostics, the C/C++ toolchain, pandas and a document-ready Python stack (pinned python-pptx/pdfplumber wheels)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在基础模板上加入 git、网络诊断、C/C++ 构建链、pandas 与文档处理 Python 栈（含固定版本 python-pptx/pdfplumber）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在基礎模板上加入 git、網路診斷、C/C++ 構建鏈、pandas 與文件處理 Python 棧（含固定版本 python-pptx/pdfplumber）。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic のすべてに加えて、git、ネットワーク診断、C/C++ ツールチェーン、pandas、そしてドキュメント対応の Python スタック（pinned python-pptx/pdfplumber ホイール）です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic에 포함된 모든 것, git, 네트워크 진단, C/C++ 툴체인, pandas 및 문서 준비가 된 Python 스택(고정된 python-pptx/pdfplumber 휠)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout en Basic, plus git, diagnostics réseau, la chaîne d'outils C/C++, pandas et une pile Python prête pour les documents (roues python-pptx/pdf plombier épinglée)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles in Basic, plus Git, Netzwerkdiagnose, die C/C++-Toolchain, Pandas und ein dokumentenfertiger Python-Stack (gepinntete Python-pptx/pdfPlumber-Räder)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo en Basic, además de git, diagnósticos de red, la cadena de herramientas C/C++, pandas y una pila Python lista para documentos (ruedas python-pptx/pdfplumber ancladas)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo em Básico, além de git, diagnósticos de rede, a cadeia de ferramentas C/C++, pandas e uma pilha Python pronta para documentos (rodas python-pptx/pdfplumber wheels fixadas)."
          }
        }
      }
    },
