    "platform.background_run_coordinator.the_image_service_should_return_images": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image service should return %@ images but returned %@; partial results were not saved. Retry from the configuration node."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片服务应返回 %@ 张图片，但实际返回 %@ 张；本次没有保存部分结果，请从配置节点重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片服務應返回 %@ 張圖片，但實際返回 %@ 張；本次沒有儲存部分結果，請從配置節點重試。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像サービスは %@ 画像を返すはずですが、%@ が返されました。部分的な結果は保存されませんでした。 設定ノードから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지 서비스는 %@ 이미지를 반환해야 하지만 %@를 반환했으며, 부분 결과가 저장되지 않았습니다. 구성 노드에서 다시 시도하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d'image devait renvoyer des images %@ mais a renvoyé %@ ; les résultats partiels n'ont pas été enregistrés. Réessayez à partir du nœud de configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bilddienst sollte %@-Bilder zurückgeben, aber %@ zurückgeben; Teilergebnisse wurden nicht gespeichert. Versuchen Sie es erneut vom Konfigurationsknoten aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de imágenes debería devolver imágenes %@, pero devolvió %@; los resultados parciales no se guardaron. Vuelva a intentarlo desde el nodo de configuración."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de imagem deve retornar imagens %@, mas retornou %@; os resultados parciais não foram salvos. Tente novamente a partir do nó de configuração."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_linux_environment_keeps_running_the": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Linux environment keeps running; the status Picture in Picture reappears when you return to the background."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 环境继续运行；返回后台时状态画中画会重新出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境繼續執行；返回後臺時狀態畫中畫會重新出現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 環境は稼働し続け、バックグラウンドに戻ると「Picture in Picture」ステータスが再表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 환경이 계속 실행되고 있으며, 백그라운드로 돌아가면 Picture in Picture 상태가 다시 나타납니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'environnement Linux continue de fonctionner ; l'état Image dans Image réapparaît lorsque vous revenez à l'arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Linux-Umgebung läuft weiter; der Status Bild in Bild erscheint wieder, wenn Sie in den Hintergrund zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno Linux sigue funcionando; el estado Imagen en Imagen reaparece cuando vuelves al fondo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente Linux continua em execução; o status Picture in Picture reaparece quando você retorna ao plano de fundo."
          }
        }
      }
    },
    "platform.background_run_coordinator.the_provider_download_result_was_an": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The provider download result was an empty file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "供应商下载结果为空文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "供應商下載結果為空檔案。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロバイダーのダウンロード結果は空のファイルでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제공자 다운로드 결과는 빈 파일이었습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
