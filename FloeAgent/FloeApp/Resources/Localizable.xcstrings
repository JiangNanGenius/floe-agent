    "cad.ui.save.failedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving failed — recent changes may not be stored. (%@) The document stays open; free storage or fix access, then save again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存失败——最近的更改可能尚未写入磁盘。（%@）文档仍保持打开；请释放存储空间或修复访问权限后再次保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存失敗——最近的更改可能尚未寫入磁碟。（%@）文件仍保持開啟；請釋放儲存空間或修復訪問許可權後再次儲存。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存に失敗しました — 最近の変更が保存されない可能性があります。 (%@) ドキュメントは開いたままです；空きストレージまたはアクセスを修正し、再度保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장에 실패했습니다 — 최근 변경 사항이 저장되지 않을 수 있습니다. (%@) 문서가 열려 있는 상태를 유지합니다; 저장을 자유롭게 하거나 접근을 수정한 뒤 다시 저장하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'enregistrement - les modifications récentes peuvent ne pas être stockées. (%@) Le document reste ouvert ; stockage gratuit ou accès fixe, puis sauvegarde à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern fehlgeschlagen – die letzten Änderungen werden möglicherweise nicht gespeichert. (%@) Das Dokument bleibt offen; freier Speicher oder Fix-Zugriff, dann erneut speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el guardado: es posible que los cambios recientes no se almacenen. (%@) El documento permanece abierto; almacenamiento libre o acceso fijo, luego guárdelo de nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no salvamento — alterações recentes podem não ser armazenadas. (%@) O documento permanece aberto; armazenamento livre ou acesso fixo, depois salve novamente."
          }
        }
      }
    },
