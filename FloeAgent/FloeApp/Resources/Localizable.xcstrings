    "cad.workbench.assembly.emptyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a body in the viewport and tap “Place instance”; constraints are solved against the placed instances."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在视口中选择一个实体并点按“放置实例”；约束将针对已放置的实例求解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在視口中選擇一個實體並點按“放置例項”；約束將針對已放置的例項求解。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューポートで本文を選択し、「Place instance」をタップしてください。制約は配置されたインスタンスに対して解決されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰포트에서 본문을 선택하고 “Place instance”을 탭하십시오; 배치된 인스턴스에 대한 제약이 해결됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un corps dans la fenêtre d'affichage et appuyez sur \"Place instance\" ; les contraintes sont résolues par rapport aux instances placées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Körper im Ansichtsfenster aus und tippen Sie auf \"Instanz platzieren\"; Einschränkungen werden gegen die platzierten Instanzen gelöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un cuerpo en la ventana gráfica y toque \"Colocar instancia\"; las restricciones se resuelven contra las instancias colocadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um corpo na janela de visualização e toque em “Colocar instância”; as restrições são resolvidas em relação às instâncias colocadas."
          }
        }
      }
    },
