    "help.settings.memory_availability": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享运行环境准备好后才显示内存选项；调低内存会等待当前项目关闭。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory options appear after the shared runtime is ready. Lower limits wait for current projects to close."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共享執行環境準備好後才顯示記憶體選項；調低記憶體會等待當前專案關閉。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリオプションは、共有ランタイムが準備完了した後に表示されます。 下限は現在のプロジェクトが完了するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유 런타임이 준비된 후에 메모리 옵션이 표시됩니다. 하한은 현재 프로젝트가 종료될 때까지 기다립니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options de mémoire apparaissent une fois que l'exécution partagée est prête. Les limites inférieures attendent la fermeture des projets en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Speicheroptionen werden angezeigt, nachdem die gemeinsam genutzte Laufzeit bereit ist. Die unteren Grenzen warten auf die Schließung aktueller Projekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones de memoria aparecen después de que el tiempo de ejecución compartido esté listo. Los límites inferiores esperan a que se cierren los proyectos actuales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As opções de memória aparecem depois que o tempo de execução compartilhado estiver pronto. Os limites mais baixos aguardam o fechamento dos projetos atuais."
          }
        }
      }
    },
