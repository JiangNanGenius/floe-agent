    "settings.general.language.restart_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your work, then quit and reopen Floe to apply the language to every screen."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先保存当前工作，再退出并重新打开 Floe，使所有界面完整切换语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先儲存當前工作，再退出並重新開啟 Floe，使所有介面完整切換語言。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業を保存し、終了してFloeを再度開いて、すべての画面に言語を適用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 저장한 후 종료하고 Floe를 다시 열어 모든 화면에 언어를 적용하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre travail, puis quittez et rouvrez Floe pour appliquer la langue à chaque écran."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie Ihre Arbeit, beenden Sie dann und öffnen Sie Floe erneut, um die Sprache auf jeden Bildschirm anzuwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde su trabajo, luego salga y vuelva a abrir Floe para aplicar el idioma a cada pantalla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve seu trabalho, depois saia e reabra o Floe para aplicar o idioma a todas as telas."
          }
        }
      }
    },
