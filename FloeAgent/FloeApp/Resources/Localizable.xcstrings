    "home.task_schedule_sheet.ios_wakes_the_app_based_on": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS wakes the app based on available system resources; the estimated time is not a minute-level guarantee, and Task Center always shows the most recent actual run time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会按系统资源尽力唤醒；预计时间不是分钟级保证，任务中心会同时显示最近实际执行时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 會按系統資源盡力喚醒；預計時間不是分鐘級保證，任務中心會同時顯示最近實際執行時間。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS は、利用可能なシステムリソースに基づいてアプリを起動します。推定時間は分単位の保証ではなく、タスクセンターは常に最新の実際の実行時間を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 사용 가능한 시스템 리소스를 기반으로 앱을 깨우며, 예상 시간은 분당 보장되지 않으며, 작업 센터는 항상 가장 최근 실제 실행 시간을 표시합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS réveille l'application en fonction des ressources système disponibles ; le temps estimé n'est pas une garantie de niveau minute, et le centre des tâches affiche toujours le temps d'exécution réel le plus récent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS weckt die App basierend auf verfügbaren Systemressourcen; die geschätzte Zeit ist keine Garantie auf Minutenebene, und das Task Center zeigt immer die letzte tatsächliche Laufzeit an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS activa la aplicación en función de los recursos disponibles del sistema; el tiempo estimado no es una garantía de nivel de minuto, y el Centro de Tareas siempre muestra el tiempo de ejecución real más reciente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS ativa o aplicativo com base nos recursos do sistema disponíveis; o tempo estimado não é uma garantia de nível de minuto, e o Centro de Tarefas sempre mostra o tempo de execução real mais recente."
          }
        }
      }
    },
