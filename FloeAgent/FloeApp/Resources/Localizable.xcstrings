    "notes.notes_agent_tools.this_page_has_no_usable_default": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page has no usable default text position; add a new page with addPage first, or provide an explicit frame for the text."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此页面没有可用的默认文字位置；请先 addPage 新建页面，或为该文字提供显式 frame。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此頁面沒有可用的預設文字位置；請先 addPage 新建頁面，或為該文字提供顯式 frame。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページには利用可能なデフォルトのテキスト位置がありません。まず addPage で新しいページを追加するか、テキストの明示的なフレームを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지에는 사용 가능한 기본 텍스트 위치가 없습니다; 먼저 addPage를 사용하여 새 페이지를 추가하거나 텍스트에 대한 명시적인 프레임을 제공하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n'a pas de position de texte par défaut utilisable ; ajoutez d'abord une nouvelle page avec addPage, ou fournissez un cadre explicite pour le texte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite hat keine verwendbare Standardtextposition; fügen Sie zuerst eine neue Seite mit addPage hinzu oder geben Sie einen expliziten Rahmen für den Text an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no tiene una posición de texto predeterminada utilizable; agregue una nueva página con addPage primero, o proporcione un marco explícito para el texto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página não tem posição de texto padrão utilizável; adicione uma nova página com addPage primeiro ou forneça um quadro explícito para o texto."
          }
        }
      }
    },
