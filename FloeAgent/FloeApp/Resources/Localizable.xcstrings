    "canvas.onboarding.connect.detail": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a node port to another node. Targets snap into place; release on empty space to create and connect a new node."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从节点连接点拖向另一个节点即可磁吸连接；拖到空白处可快速新建并自动连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從節點連線點拖向另一個節點即可磁吸連線；拖到空白處可快速新建並自動連線。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ノードポートを別のノードにドラッグしてください。 ターゲットが位置にスナップし、空き領域でリリースして新しいノードを作成し、接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노드 포트를 다른 노드로 끌어다 놓으십시오. 목표물을 제자리에 스냅하고, 빈 공간에 놓아 새로운 노드를 생성하고 연결합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un port de nœud vers un autre nœud. Les cibles s'enclenchent en place ; relâchez sur un espace vide pour créer et connecter un nouveau nœud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie einen Knotenport auf einen anderen Knoten. Ziele werden einrasten; auf leeres Feld freigeben, um einen neuen Knoten zu erstellen und zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un puerto de nodo a otro nodo. Los objetivos encajan en su lugar; suéltelos en un espacio vacío para crear y conectar un nuevo nodo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma porta de nó para outro nó. Os alvos se encaixam no lugar; solte no espaço vazio para criar e conectar um novo nó."
          }
        }
      }
    },
    "canvas.onboarding.connect.title": {
