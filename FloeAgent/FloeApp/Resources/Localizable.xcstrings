    "feedback.problem.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include what you were doing, what happened, and whether it happens every time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请写明当时在做什么、发生了什么，以及是否每次都能复现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請寫明當時在做什麼、發生了什麼，以及是否每次都能復現。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが何をしていたか、何が起こったか、そしてそれが毎回起こるかどうかを含めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신이 하고 있던 일, 무슨 일이 있었는지, 그리고 그것이 매번 일어나는지 여부를 포함하십시오."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluez ce que vous faisiez, ce qui s'est passé et si cela se produit à chaque fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie an, was Sie getan haben, was passiert ist und ob es jedes Mal passiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye lo que estabas haciendo, lo que pasó y si sucede cada vez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua o que você estava fazendo, o que aconteceu e se isso acontece todas as vezes."
          }
        }
      }
    },
    "feedback.problem.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: I tapped the microphone, granted access, and the app closed immediately…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：点击麦克风并授权后，App 立即退出……"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：點選麥克風並授權後，App 立即退出……"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例えば、マイクをタップし、アクセスを許可すると、アプリがすぐに閉じました..."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예를 들어: 마이크를 탭하고 접근 권한을 부여했으며, 앱이 즉시 종료되었습니다..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par exemple : j'ai tapé sur le microphone, j'ai accordé l'accès, et l'application s'est fermée immédiatement..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Beispiel: Ich habe auf das Mikrofon getippt, Zugriff gewährt und die App wurde sofort geschlossen..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por ejemplo: toqué el micrófono, se me concedió acceso y la aplicación se cerró inmediatamente..."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo: toquei no microfone, concedi acesso e o aplicativo fechou imediatamente..."
          }
        }
      }
    },
