    "chat.task_management.archive_stops_running_work": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiving stops the selected tasks' own running work first; they can be restored from the archive later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档会先停止所选任务自身正在运行的工作；之后可从归档区恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歸檔會先停止所選任務自身正在執行的工作；之後可從歸檔區恢復。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブは、選択されたタスクの実行中の作業をまず停止し、後でアーカイブから復元することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아카이브는 먼저 선택된 작업의 실행 중인 작업을 중지하고, 나중에 아카이브에서 복원할 수 있습니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivage arrête d'abord le travail en cours d'exécution des tâches sélectionnées ; ils peuvent être restaurés à partir de l'archive plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Archivierung stoppt zuerst die eigene laufende Arbeit der ausgewählten Aufgaben; sie können später aus dem Archiv wiederhergestellt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo detiene primero el propio trabajo en ejecución de las tareas seleccionadas; se pueden restaurar desde el archivo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivamento interrompe primeiro o próprio trabalho em execução das tarefas selecionadas; elas podem ser restauradas do arquivo posteriormente."
          }
        }
      }
    },
    "chat.task_management.cancelled_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch stopped. Unprocessed tasks stay selected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止批量操作，未处理的任务保持选中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止批次操作，未處理的任務保持選中。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッチが停止しました。 未処理のタスクは選択されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배치가 중단되었습니다. 처리되지 않은 작업은 선택된 상태를 유지합니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lot s'est arrêté. Les tâches non traitées restent sélectionnées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch gestoppt. Nicht verarbeitete Aufgaben bleiben ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El lote se detuvo. Las tareas no procesadas se mantienen seleccionadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lote parou. Tarefas não processadas permanecem selecionadas."
          }
        }
      }
    },
    "chat.task_management.delete_stops_running_work": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting stops the selected tasks' own running work first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除会先停止所选任务自身正在运行的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除會先停止所選任務自身正在執行的工作。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除すると、選択されたタスクの実行中の作業がまず停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제하면 선택한 작업의 자체 작업이 먼저 중단됩니다."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression arrête d'abord le travail en cours d'exécution des tâches sélectionnées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen stoppt zuerst die eigene laufende Arbeit der ausgewählten Aufgaben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La eliminación detiene primero el propio trabajo en ejecución de las tareas seleccionadas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exclusão interrompe o próprio trabalho em execução das tarefas selecionadas primeiro."
          }
        }
      }
    },
    "chat.task_management.failure_busy": {
      "extractionState": "manual",
      "localizations": {
