			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Optional feedback diagnostics attach the full MetricKit
			     MXMetricPayload (launch time, hang rate, energy use, disk
