<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="${applicationId}.permission.LINUX_RUNTIME" android:protectionLevel="signature" />
    <uses-permission android:name="${applicationId}.permission.LINUX_RUNTIME" />
    <queries>
        <package android:name="com.floe.agent.runtime" />
        <package android:name="com.floe.agent.runtime.dev" />
        <package android:name="com.floe.agent.runtime.full" />
        <package android:name="com.floe.agent.runtime.full.dev" />
    </queries>
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- User-started, bounded network monitoring; never a background keepalive. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- G07: normal state permissions and explicit foreground Wi-Fi analysis.
         Location/Nearby permission requests happen only after the user's action. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- Android 17 (API 37) local-network reach for user-launched LOCAL
         MCP/provider hops (MAIN_ANDROID37_LAN_PERMISSION_DECISION_20261021).
         Runtime-requested only on API>=37 at an explicit user action;
         G07 Wi-Fi scan/location permissions are independently scoped below. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application android:name=".FloeApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Floe" android:allowBackup="false" android:supportsRtl="true"
        android:usesCleartextTraffic="false" android:enableOnBackInvokedCallback="true">
        <service
            android:name=".host.networkmonitor.NetworkMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="true" />
        <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          Lane 17: App-owned preview of ONE verified durable run-output PDF.
          Non-exported and default-process: launchable only from this app's
          own RunOutputPdfPreviewController with an opaque live-launch token
          (the Intent carries no path, digest or model text; the bytes are
          re-proven at staging by the owned egress before this screen exists,
          and the viewer resolves the token against the live owner-fenced
          launch record). Parsing happens ONLY in the module's isolated FD-only
          renderer service; printing goes through the module's accepted
          PrintManager seam. No new permission.
        -->
        <activity
            android:name=".host.output.RunOutputPdfPreviewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- G07.3A user-question notification reply. Exported=false: reached
             only by the explicit PendingIntent the question notification
             creates. The receiver carries identifiers/revisions only (never
             question text or an answer preview) and asks the live host for
             the same exact-once native settlement; without a live runtime it
             posts a neutral open-app reminder and fabricates nothing. -->
        <receiver
            android:name="com.floe.android.host.questions.UserQuestionReplyReceiver"
            android:exported="false" />
        <provider
            android:name="com.floe.android.notesplatform.NotesShareProvider"
            android:authorities="${applicationId}.notes.exports"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
