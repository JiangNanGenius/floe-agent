<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- GitHub distribution only; never merged into the Play application. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Explicit user-requested background automation setup. This only allows
         opening the system consent dialog; it never grants an exemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Scoped download lifecycle: a real dataSync foreground service keeps an
         in-progress APK download alive across screen lock/backgrounding. Both
         are normal (install-time) permissions, Full channel only. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phone-control target catalog (Full only): the device-access chooser
         lists installed launchable apps so the user can pick automation
         targets. Android 11+ package visibility returns nothing for a
         MAIN/LAUNCHER query without this explicit intent query, which is why
         the chooser was empty while hundreds of apps were installed. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- File viewers may have no launcher. This makes their installed
             package metadata discoverable for an explicit target lookup;
             it grants neither file access nor device-control permission. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
    <application>
        <receiver android:name="com.floe.android.host.officecomponent.OfficeComponentInstallReceiver" android:exported="false" />
        <receiver android:name="com.floe.android.host.officecomponent.OfficeComponentStopReceiver" android:exported="false" />
        <service android:name="com.floe.android.host.officecomponent.OfficeComponentDownloadService"
            android:exported="false" android:foregroundServiceType="dataSync" android:stopWithTask="false" />
        <receiver android:name="com.floe.android.host.cadcomponent.CadComponentInstallReceiver" android:exported="false" />
        <receiver android:name="com.floe.android.host.cadcomponent.CadComponentStopReceiver" android:exported="false" />
        <service android:name="com.floe.android.host.cadcomponent.CadComponentDownloadService"
            android:exported="false" android:foregroundServiceType="dataSync" android:stopWithTask="false" />
        <receiver android:name="com.floe.android.host.deviceaccess.PhoneAutomationReceiver" android:exported="false" />
        <!-- C06 Full-only root capture foreground owner. It is absent from the
             Play source set; the main host starts it only when the Full root
             backend is present. It contains no root implementation itself. -->
        <service
            android:name="com.floe.android.host.capture.root.RootPacketCaptureService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="user-initiated root packet capture that streams a pinned helper's native capture" />
        </service>
        <receiver android:name="com.floe.android.host.linux.RuntimeInstallReceiver" android:exported="false" />
        <!-- App self-update (same-package Full APK from the repository's
             Android release). Distinct receiver extras/state from the
             bundled-runtime child installer above. Not present in Play. -->
        <receiver android:name="com.floe.android.host.update.AppUpdateInstallReceiver" android:exported="false" />
        <!-- Inline wireless-pairing code reply. FULL only: reached exclusively
             by the explicit mutable RemoteInput PendingIntent created for the
             live pairing notification; never exported and never in Play. -->
        <receiver
            android:name="com.floe.android.host.deviceaccess.PairingCodeReceiver"
            android:exported="false" />
        <!-- Bounded, user-initiated inline-pairing handshake owner. FULL only:
             no Play manifest/resource/code path includes it. It has no command
             surface; the 60 s self-stop prevents any idle keep-alive. -->
        <service
            android:name="com.floe.android.host.deviceaccess.PairingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="bounded user-initiated wireless ADB pairing with inline code entry; no idle keep-alive" />
        </service>
        <service
            android:name="com.floe.android.host.update.AppUpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>
</manifest>
