    <string name="device_access_boundary_secrets">Password fields, secure windows and the lock screen are never read or filled.</string>
    <string name="device_access_boundary_actions">Actions are read back after they run; gestures are not replayed blindly.</string>
    <string name="device_access_boundary_screenshots">A screenshot is captured only when the task asks for the observed page.</string>

