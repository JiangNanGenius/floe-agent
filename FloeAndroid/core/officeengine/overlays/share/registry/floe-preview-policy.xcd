<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: MPL-2.0
     Floe read-only preview policy. Loaded by the pinned native xcsxcu layer;
     dependencies enforce ordering after the actual component schemas/data.
     No registrymodifications.xcu/user: layer is assumed. -->
<oor:data xmlns:oor="http://openoffice.org/2001/registry"
          xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <dependency file="main"/>
  <dependency file="calc"/>
  <dependency file="writer"/>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
    <node oor:name="Security"><node oor:name="Scripting">
      <prop oor:name="DisableMacrosExecution" oor:finalized="true"><value>true</value></prop>
      <prop oor:name="DisableActiveContent" oor:finalized="true"><value>true</value></prop>
      <prop oor:name="BlockUntrustedRefererLinks" oor:finalized="true"><value>true</value></prop>
    </node></node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Calc">
    <node oor:name="Content"><node oor:name="Update">
      <prop oor:name="Link" oor:finalized="true"><value>1</value></prop>
    </node></node>
  </oor:component-data>
  <oor:component-data oor:package="org.openoffice.Office" oor:name="Writer">
    <node oor:name="Content"><node oor:name="Update">
      <prop oor:name="Link" oor:finalized="true"><value>2</value></prop>
    </node></node>
  </oor:component-data>
</oor:data>
