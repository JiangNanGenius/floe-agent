<?xml version="1.0" encoding="utf-8"?>
<!--
  androidTest-only network security policy: default platform TLS trust and
  hostname validation remain fully in force (base-config cleartext denied);
  cleartext is permitted ONLY for the loopback fixture endpoints the
  instrumentation process itself binds. Scoped to the test APK; never part of
  the library main source set or the release AAR.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
