  "licenseFileSha256": "970c5b6a8b4e037101f28255965a75287afb671d761b55e73616ed3efcb77ff1",
  "licenseObservation": "Repository LICENSE is MIT (Copyright 2019 Megatron King). Upstream source file headers still carry GPLv3 text; both notices are retained and the exact source is vendored inside this repository to preserve source availability. This conflict is flagged to Main and not reinterpreted.",
  "subset": "Only the IPv4 TCP/UDP NIO forwarding path (ip/net/proxy/tunnel/gateway value and forwarding classes) is present. HTTP/SSL injection, UID dumper, sample app, service/base classes, JCenter/support/Guava/BouncyCastle dependencies and prebuilt JNI are excluded.",
  "excluded": [
    "netbare-injector",
    "netbare-sample",
    "netbare-core ssl/http/gateway-injection classes",
    "gradle wrapper/sample assets",
    ".git"
  ],
  "localPatches": [
    "Removed android.support annotations and UidDumper dependency from SessionProvider/forwarders (UID attribution is not used for authorization).",
    "Removed SSL whitelist exception handling from TcpProxyServer; no TLS MITM is present.",
    "TcpProxyServer binds preferred non-ephemeral proxy ports 25222-25225 before port 0 to avoid source-port misclassification.",
    "TcpProxyServer/UdpProxyServer close their selector/channel and provide a real stopAndJoin proof.",
    "ProxyServerForwarder gained releaseAndJoin; Tcp/Udp forwarders implement it.",
    "TcpVATunnel/UdpVATunnel use the upstream base VirtualGateway for direct forwarding instead of NetBareVirtualGateway injection policy.",
    "SessionTunnelFlow javadoc/import no longer references the excluded NetBareConfig."
  ],
