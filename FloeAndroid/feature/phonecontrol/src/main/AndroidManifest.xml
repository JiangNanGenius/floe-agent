<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launch visibility only: an authorized launch resolves MAIN/LAUNCHER.
         The home intent is needed to recognize the launcher package for
         global-navigation observations. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>
    <application>
        <!-- Exported only because the system must bind it. The signature-level
             BIND_ACCESSIBILITY_SERVICE permission prevents other apps from
             binding; there is no binder/provider API in this module. -->
        <service
            android:name="com.floe.android.phonecontrol.PhoneControlAccessibilityService"
            android:exported="true"
            android:label="@string/phonecontrol_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/floe_accessibility_service" />
        </service>
    </application>
</manifest>
