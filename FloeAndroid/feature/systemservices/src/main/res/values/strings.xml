    <string name="system_services_unavailable">System services are not available in this build.</string>
    <string name="system_services_intro">Floe reads these device capabilities only after you grant each system permission. Access is read-only, revocable in Android settings, and never runs in the background.</string>
    <string name="system_services_location">Location</string>
    <string name="system_services_location_detail">One current fix per request. No background tracking and no location history.</string>
    <string name="system_services_location_precise">Precise location allowed</string>
    <string name="system_services_location_approximate">Approximate location only</string>
    <string name="system_services_contacts">Contacts</string>
    <string name="system_services_contacts_detail">Read-only search of names, organizations, phone numbers and e-mail addresses. Floe never edits your contacts.</string>
    <string name="system_services_nfc">NFC</string>
    <string name="system_services_nfc_detail">Read one NDEF tag while the app is in the foreground. Writing, payment and secure-element access are not supported.</string>
