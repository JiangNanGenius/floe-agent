{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "channel",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "channel": {
      "const": "macos-original"
    },
    "entries": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "category",
          "version",
          "minimumAppVersion",
          "repository",
          "subdirectory",
          "commit",
          "license",
          "licensePath",
          "digest",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "minimumAppVersion": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "subdirectory": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "licensePath": {
            "type": "string"
          },
          "digest": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "zh-Hans"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1
              },
              "zh-Hans": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2048,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256",
                "bytes",
                "mode",
                "sourcePath"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16777216
                },
                "mode": {
                  "enum": [
                    "100644",
                    "100755"
                  ]
                },
                "sourcePath": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
