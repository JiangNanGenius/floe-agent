{
  "schemaVersion": 1,
  "id": "floe.search.providers",
  "version": "1.0.0",
  "entries": [
    {
      "presetID": "bocha",
      "adapterKind": "bochaWeb",
      "name": {
        "en": "Bocha Search",
        "zh-Hans": "博查搜索"
      },
      "blurb": {
        "en": "Clean web results with optional summaries.",
        "zh-Hans": "提供简洁的网页结果，可选摘要。"
      },
      "defaultEndpoint": "https://api.bochaai.com/v1/web-search",
      "endpointRequired": false,
      "credentialFields": [
        {
          "key": "apiKey",
          "required": true,
          "label": {
            "en": "API Key",
            "zh-Hans": "API 密钥"
          }
        }
      ],
      "optionFields": [
        {
          "key": "summaryEnabled",
          "kind": "bool",
          "defaultValue": "true",
          "label": {
            "en": "Summaries",
            "zh-Hans": "摘要"
          }
        }
      ],
      "authNote": {
        "en": "Bearer API key",
        "zh-Hans": "Bearer 密钥"
      }
    },
    {
      "presetID": "tencent-wsa",
