            "en": "SecretKey",
            "zh-Hans": "SecretKey"
          }
        }
      ],
      "optionFields": [],
      "authNote": {
        "en": "SecretId + SecretKey",
        "zh-Hans": "SecretId + SecretKey"
      }
    },
