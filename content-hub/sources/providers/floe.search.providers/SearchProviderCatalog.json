        "zh-Hans": "腾讯云网页搜索接口。"
      },
      "defaultEndpoint": "https://wsa.tencentcloudapi.com",
      "endpointRequired": false,
      "credentialFields": [
        {
          "key": "secretId",
          "required": true,
          "label": {
            "en": "SecretId",
            "zh-Hans": "SecretId"
          }
        },
        {
          "key": "secretKey",
          "required": true,
