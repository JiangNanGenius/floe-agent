+//! Floe DDI ABI v1. No spawned future may borrow foreign input/callback state.
+//! A scope is owned by one OS thread. The caller must end it on that thread,
+//! after every synchronous FFI call has returned, before freeing its context.
+use std::{cell::RefCell, ffi::c_void, future::Future, sync::atomic::{AtomicBool, Ordering}, time::{Duration, Instant}};
+use idevice::IdeviceError;
+
+pub const FLOE_DDI_ABI_VERSION: u32 = 1;
+pub const FLOE_DDI_DEFAULT_TIMEOUT_MS: u64 = 180_000;
+/// Fixed numeric phase vocabulary, never device strings or payload contents.
+pub type FloeDDIStageCallback = Option<extern "C" fn(u32, *mut c_void)>;
+pub type FloeDDICancelCallback = Option<extern "C" fn(*mut c_void) -> bool>;
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+#[derive(Clone, Copy)]
+struct Scope { deadline: Instant, cancel: FloeDDICancelCallback, stage: FloeDDIStageCallback, context: *mut c_void, last_stop: u32, read_only: bool }
+thread_local! { static SCOPE: RefCell<Option<Scope>> = const { RefCell::new(None) }; }
+
+#[unsafe(no_mangle)]
+pub extern "C" fn floe_ddi_abi_version() -> u32 { FLOE_DDI_ABI_VERSION }
+/// Returns 0 on success, 1 for busy/nested scope, 2 for invalid budget.
+/// Zero budget selects 180 seconds; nonzero budgets may only shorten it.
+/// # Safety
+/// Callbacks/context must stay valid until `floe_ddi_scope_end` returns. They
+/// execute synchronously on this thread and must be bounded and non-reentrant.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn floe_ddi_scope_begin(timeout_ms: u64, cancel: FloeDDICancelCallback,
+    stage: FloeDDIStageCallback, context: *mut c_void) -> u32 {
+    let ms = if timeout_ms == 0 { FLOE_DDI_DEFAULT_TIMEOUT_MS } else { timeout_ms };
+    if ms > FLOE_DDI_DEFAULT_TIMEOUT_MS { return 2; }
+    if ACTIVE.compare_exchange(false, true, Ordering::AcqRel, Ordering::Acquire).is_err() { return 1; }
+    SCOPE.with(|s| *s.borrow_mut() = Some(Scope { deadline: Instant::now() + Duration::from_millis(ms), cancel, stage, context, last_stop: 0, read_only: false }));
+    0
+}
+/// Returns 0, 1=deadline or 2=cancelled. Does not consume the scope.
+#[unsafe(no_mangle)]
+pub extern "C" fn floe_ddi_scope_stop_reason() -> u32 {
+    SCOPE.with(|s| s.borrow().map_or(0, |v| v.last_stop))
+}
+/// Switches the same exclusive scope to read-only reconciliation after all
+/// install futures returned/dropped. Callers MUST NOT issue mutations here.
+/// Ignores the Stop callback; at most 15 seconds for read-only service state.
+#[unsafe(no_mangle)]
+pub extern "C" fn floe_ddi_scope_reconcile() {
+    SCOPE.with(|s| { if let Some(v) = s.borrow_mut().as_mut() {
+        v.deadline = Instant::now() + Duration::from_secs(15); v.cancel = None; v.read_only = true;
+    }});
+}
+/// # Safety
+/// Must run on the begin thread after all scoped FFI calls returned. Calling
+/// from a callback, or concurrently with a scoped call, violates the ABI.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn floe_ddi_scope_end() {
+    let owned = SCOPE.with(|s| s.borrow_mut().take().is_some());
+    if owned { ACTIVE.store(false, Ordering::Release); }
+}
+pub fn is_active() -> bool { SCOPE.with(|s| s.borrow().is_some()) }
+pub fn mutation_allowed() -> bool {
+    SCOPE.with(|s| s.borrow().map_or(!ACTIVE.load(Ordering::Acquire), |v| !v.read_only))
+}
+pub fn stage(code: u32) {
+    let scope = SCOPE.with(|s| *s.borrow());
+    if let Some(s) = scope { if let Some(callback) = s.stage { callback(code, s.context); } }
+}
+
+/// The borrowed future is polled locally. Every exit drops it before block_on
+/// returns. No Tokio task owns foreign pointers. Cancellation does not roll
+/// back requests already sent to a device: reconcile, never blindly retry.
+pub fn run_sync_local_ddi<F, T>(future: F) -> Result<T, IdeviceError>
+where F: Future<Output = Result<T, IdeviceError>>, T: 'static {
+    let scope = SCOPE.with(|s| *s.borrow());
+    let Some(scope) = scope else {
+        if ACTIVE.load(Ordering::Acquire) { return Err(IdeviceError::Timeout); }
+        return crate::run_sync_local(future);
+    };
+    let (result, stop) = crate::run_sync_local(async {
+        // The future is dropped on this stack, including before cancellation
+        // or deadline result escapes the FFI boundary.
+        let mut future = Box::pin(future);
+        loop {
+            if scope.cancel.is_some_and(|f| f(scope.context)) { return (Err(IdeviceError::Timeout), 2); }
+            if Instant::now() >= scope.deadline { return (Err(IdeviceError::Timeout), 1); }
+            tokio::select! {
+                biased;
+                _ = tokio::time::sleep_until(tokio::time::Instant::from_std(scope.deadline)) => return (Err(IdeviceError::Timeout), 1),
+                _ = tokio::time::sleep(Duration::from_millis(25)) => {},
+                value = &mut future => return (value, 0),
+            }
+        }
+    });
+    if stop != 0 { SCOPE.with(|s| { if let Some(s) = s.borrow_mut().as_mut() { s.last_stop = stop; } }); }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, atomic::AtomicUsize, Mutex};
+    static SERIAL: Mutex<()> = Mutex::new(());
+    struct Context { cancel: AtomicBool, calls: AtomicUsize, dropped: Arc<AtomicBool> }
+    extern "C" fn cancel(p: *mut c_void) -> bool { unsafe { &*(p as *const Context) }.cancel.load(Ordering::Acquire) }
+    extern "C" fn callback(_: u32, p: *mut c_void) { unsafe { &*(p as *const Context) }.calls.fetch_add(1, Ordering::AcqRel); }
+    struct Pending { dropped: Arc<AtomicBool> }
+    impl Future for Pending {
+        type Output = Result<(), IdeviceError>;
+        fn poll(self: std::pin::Pin<&mut Self>, _: &mut std::task::Context<'_>) -> std::task::Poll<Self::Output> { stage(12); std::task::Poll::Pending }
+    }
+    impl Drop for Pending { fn drop(&mut self) { self.dropped.store(true, Ordering::Release); } }
+    fn context() -> Box<Context> { Box::new(Context { cancel: AtomicBool::new(false), calls: AtomicUsize::new(0), dropped: Arc::new(AtomicBool::new(false)) }) }
+    #[test]
+    fn stalled_native_stage_deadline_drops_before_context_release() {
+        let _serial=SERIAL.lock().unwrap(); let mut c=context(); let p=(&mut *c as *mut Context).cast();
+        assert_eq!(unsafe { floe_ddi_scope_begin(40, Some(cancel), Some(callback), p) }, 0);
+        let started=Instant::now(); assert!(run_sync_local_ddi(Pending { dropped:c.dropped.clone() }).is_err());
+        assert_eq!(floe_ddi_scope_stop_reason(),1); assert!(started.elapsed()<Duration::from_secs(1));
+        assert!(c.dropped.load(Ordering::Acquire)); assert!(c.calls.load(Ordering::Acquire)>0);
+        unsafe { floe_ddi_scope_end() }; let calls=c.calls.load(Ordering::Acquire); stage(10); assert_eq!(c.calls.load(Ordering::Acquire),calls);
+        drop(c); // No future or callback can retain p now.
+    }
+    #[test]
+    fn cancellation_while_pending_drops_before_return_and_never_parallel() {
+        let _serial=SERIAL.lock().unwrap(); let mut c=context(); let p=(&mut *c as *mut Context).cast();
+        assert_eq!(unsafe { floe_ddi_scope_begin(1000,Some(cancel),Some(callback),p) },0);
+        std::thread::scope(|s| {
+            let c=&c; s.spawn(move || { std::thread::sleep(Duration::from_millis(40)); c.cancel.store(true,Ordering::Release); });
+            let other=s.spawn(|| {
+                assert!(run_sync_local_ddi(async { panic!("parallel operation was polled"); #[allow(unreachable_code)] Ok(()) }).is_err());
+                assert!(!mutation_allowed());
+                unsafe { floe_ddi_scope_begin(20,None,None,std::ptr::null_mut()) }
+            });
+            assert!(run_sync_local_ddi(Pending{dropped:c.dropped.clone()}).is_err());
+            assert_eq!(other.join().unwrap(),1);
+        });
+        assert_eq!(floe_ddi_scope_stop_reason(),2); assert!(c.dropped.load(Ordering::Acquire));
+        unsafe { floe_ddi_scope_end() }; drop(c);
+        assert_eq!(unsafe { floe_ddi_scope_begin(10,None,None,std::ptr::null_mut()) },0); unsafe { floe_ddi_scope_end() };
+    }
+    #[test]
+    fn one_absolute_budget_across_stages_and_readonly_reconcile() {
+        let _serial=SERIAL.lock().unwrap();
+        assert_eq!(unsafe { floe_ddi_scope_begin(45,None,None,std::ptr::null_mut()) },0);
+        assert!(run_sync_local_ddi(async {tokio::time::sleep(Duration::from_millis(30)).await; Ok(())}).is_ok());
+        assert!(run_sync_local_ddi(async {tokio::time::sleep(Duration::from_millis(30)).await; Ok(())}).is_err());
+        assert_eq!(floe_ddi_scope_stop_reason(),1); floe_ddi_scope_reconcile(); assert!(!mutation_allowed());
+        assert!(run_sync_local_ddi(async {Ok(())}).is_ok()); unsafe { floe_ddi_scope_end() };
+    }
+    #[test]
+    fn stalled_transport_read_is_bounded_at_every_native_stage() {
+        use tokio::io::AsyncReadExt;
+        let _serial=SERIAL.lock().unwrap();
+        for phase in [1,2,3,10,11,12,13,14,20,21,22,23,24,30,31,40] {
+            let mut c=context(); let p=(&mut *c as *mut Context).cast();
+            assert_eq!(unsafe { floe_ddi_scope_begin(8,Some(cancel),Some(callback),p) },0);
+            let dropped=c.dropped.clone();
+            assert!(run_sync_local_ddi(async move {
+                let _lifetime=Pending { dropped };
+                let (mut reader, _stalled_peer)=tokio::io::duplex(8);
+                stage(phase);
+                let mut byte=[0u8;1]; reader.read_exact(&mut byte).await?;
+                Ok(())
+            }).is_err());
+            assert!(c.dropped.load(Ordering::Acquire)); assert_eq!(floe_ddi_scope_stop_reason(),1);
+            assert_eq!(c.calls.load(Ordering::Acquire),1); unsafe { floe_ddi_scope_end() };
+        }
+    }
+    #[test]
+    fn successful_future_dropped_before_callback_context_can_be_freed() {
+        let _serial=SERIAL.lock().unwrap(); let mut c=context(); let p=(&mut *c as *mut Context).cast();
+        assert_eq!(unsafe { floe_ddi_scope_begin(100,Some(cancel),Some(callback),p) },0);
+        let dropped=c.dropped.clone();
+        assert!(run_sync_local_ddi(async move { let _lifetime=Pending{dropped}; stage(31); Ok(()) }).is_ok());
+        assert!(c.dropped.load(Ordering::Acquire)); assert_eq!(floe_ddi_scope_stop_reason(),0);
+        unsafe { floe_ddi_scope_end() }; drop(c);
+        stage(31); // No context exists. A retained callback would be a UAF.
+    }
+
+}
