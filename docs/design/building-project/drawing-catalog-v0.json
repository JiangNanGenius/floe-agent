{
  "schemaVersion": 1,
  "status": "design-catalog-not-implemented-generators",
  "primaryWorkflow": "interior_renovation",
  "scopeNote": "Primary workflow priority; retains all previously confirmed architecture/structure/MEP requirements.",
  "generators": [
    "plan",
    "reflected_plan",
    "elevation",
    "section",
    "exploded",
    "part",
    "detail",
    "manual_detail",
    "schematic",
    "nesting",
    "labels",
    "schedule"
  ],
  "sharedContract": {
    "modelOwner": "existing Floe native drawing/model store",
    "sheetId": "stable UUID; printed numbering configurable per project",
    "scopes": [
      "project",
      "floor",
      "room",
      "run",
      "cabinet",
      "assembly",
      "part",
      "detail",
      "sheet"
    ],
    "sourceVersions": [
      "model",
      "records",
      "asset",
      "cabinet_assembly",
      "material_rule",
      "hardware_rule",
      "view_definition",
      "annotations"
    ],
    "annotations": "native linked dimensions, symbols, labels and manually authored details",
    "missingData": "draft with visible issues; missing manufacturing rules cannot be labelled production-verified",
    "batchExport": "one fixed input snapshot, PDF/DWG/DXF where actual format service supports it; explicit partial/failure status",
    "modelChange": "invalidate only affected derived views and schedules; retain authored annotations; unresolved anchors become visible issues",
    "independentCopies": "no writeback to building original"
  },
