          "lockfile": "references/requirements.lock.txt"
        },
        {
          "kind": "pip",
          "name": "requests",
          "version": "2.34.2",
          "purpose": "Optional dataset fetch step.",
          "required": false,
          "lockfile": "references/requirements.lock.txt"
        }
      ]
    }
  ]
}
